@Logic
script AttendanceUI extends Logic

	-- 출석 보상 팝업(ui/AttendanceGroup.ui) + 로비 출석 버튼(ui/TitleGroup.ui AttendanceButton) 컨트롤러.
	-- 상태(몇 칸 받았는지/오늘 받을 수 있는지)는 전부 AttendanceLogic이 서버에서 들고 있고, 여기는 보여주기만 한다.
	--   · 칸(Panel/Slots/Day1~7): 받은 칸 = 보상 이미지 숨김 + 체크 + "완료", 나머지 = 보상 이미지 + 수량
	--   · 오늘 받을 칸은 살짝 두근거리게(펄스) 해서 누를 곳을 알려준다
	--   · 수령 연출: 체크가 크게(위에서) 나타났다가 작아지며 내려앉는다(원근감 — 유저 지정)

	-- UI 바인딩 (UIBuilder가 UUID를 넣는다)
	property Entity popupGroup = "eede3908-ddfb-45d5-97a7-d7bf73774160"
	property ButtonComponent btnClose = "10fe71dd-610f-426d-987a-dc8ea6c4ea7c"
	property Entity slotsRoot = "56d4fa82-f84a-4a0d-9c15-cc5ef1391dad"
	property ButtonComponent lobbyButton = "b3516b28-fb89-43c0-adca-795b47b80883"
	property Entity lobbyRedDot = "98b7ed0e-df11-43d6-88c1-b6f32454738b"

	-- 체크 연출 값
	property number CheckStartScale = 1.9
	property number CheckStartOffsetY = 48
	property number CheckDropDuration = 0.3
	property number PulseAmplitude = 0.05
	property number PulseSpeed = 5.0

	-- 내부 상태
	property boolean _isOpen = false
	property boolean _lobbyTabVisible = true
	property integer _animatingDay = 0
	property integer _pulseTimerId = 0
	property number _pulseTime = 0
	property table _slotHandlers = {}
	property any _closeHandler = nil
	property any _lobbyHandler = nil
	-- 보상 비행(RewardFlyUI, 2026-09-15): 받는 순간 배지 숫자를 보류해두고, 팝업을 닫을 때 받은 칸에서 날아간다
	property boolean _claimPending = false
	-- 수령 번호표 — 타임아웃 타이머가 "자기 수령분"만 되돌리게 하는 용도
	property integer _claimSeq = 0
	property string _holdKind = ""
	property integer _holdAmount = 0
	property table _pendingFly = {}

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		if not isvalid(self.popupGroup) then return end
		self.popupGroup.Enable = false
		self._closeHandler = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, self.OnCloseClicked)
		self._lobbyHandler = self.lobbyButton.Entity:ConnectEvent(ButtonClickEvent, self.OnLobbyButtonClicked)
		self._slotHandlers = {}
		for i = 1, 7 do
			local capturedDay = i
			local slot = self:GetSlot(i)
			if isvalid(slot) then
				local h = slot:ConnectEvent(ButtonClickEvent, function() self:OnSlotClicked(capturedDay) end)
				table.insert(self._slotHandlers, { entity = slot, eventHandler = h })
			end
		end
		self:RefreshAll()
		log("AttendanceUI started")
	end

	@ExecSpace("ClientOnly")
	method Entity GetSlot(integer day)
		if not isvalid(self.slotsRoot) then return nil end
		return self.slotsRoot:GetChildByName("Day" .. tostring(day))
	end

	@ExecSpace("ClientOnly")
	method void OnLobbyButtonClicked()
		self:Open()
	end

	@ExecSpace("ClientOnly")
	method void Open()
		_AttendanceLogic:RequestRefresh()
		self:RefreshAll()
		self.popupGroup.Enable = true
		self._isOpen = true
		self:StartPulse()
		log("AttendanceUI: opened (claimed=" .. _AttendanceLogic:GetClaimedCount() .. " canClaim=" .. tostring(_AttendanceLogic:CanClaim()) .. ")")
	end

	@ExecSpace("ClientOnly")
	method void Close()
		self:FlyPendingRewards()
		self.popupGroup.Enable = false
		self._isOpen = false
		self:StopPulse()
	end

	@ExecSpace("ClientOnly")
	method void OnCloseClicked()
		self:Close()
	end

	@ExecSpace("ClientOnly")
	method void RefreshAll()
		-- 7칸 + 로비 버튼을 현재 동기화된 상태로 다시 그린다(수령 연출 중인 칸은 건드리지 않는다)
		if not isvalid(self.slotsRoot) then return end
		local claimed = _AttendanceLogic:GetClaimedCount()
		for i = 1, 7 do
			if i ~= self._animatingDay then
				self:ApplySlotState(i, i <= claimed)
			end
		end
		self:RefreshLobbyButton()
	end

	@ExecSpace("ClientOnly")
	method void ApplySlotState(integer day, boolean claimed)
		local slot = self:GetSlot(day)
		if not isvalid(slot) then return end
		local icon = slot:GetChildByName("RewardIcon")
		local amountText = slot:GetChildByName("AmountText")
		local check = slot:GetChildByName("Check")
		if isvalid(icon) then
			icon.SpriteGUIRendererComponent.ImageRUID = _AttendanceLogic:GetRewardIconRUID(day)
			icon.Enable = not claimed
		end
		if isvalid(amountText) then
			if claimed then
				amountText.TextGUIRendererComponent.Text = "완료"
			else
				amountText.TextGUIRendererComponent.Text = _AttendanceLogic:GetRewardAmountText(day)
			end
		end
		if isvalid(check) then
			check.Enable = claimed
			check.UITransformComponent.Scale = Vector3(1, 1, 1)
			check.UITransformComponent.anchoredPosition = Vector2(0, 0)
			check.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
		end
		slot.UITransformComponent.Scale = Vector3(1, 1, 1)
	end

	@ExecSpace("ClientOnly")
	method void RefreshLobbyButton()
		-- 7칸을 다 받으면 버튼 자체를 숨긴다(유저 지정). 로비의 다른 탭(상점/스킬 등)에서도 숨긴다
		if not isvalid(self.lobbyButton) then return end
		local show = self._lobbyTabVisible and not _AttendanceLogic:IsAllDone()
		self.lobbyButton.Entity.Enable = show
		if isvalid(self.lobbyRedDot) then
			self.lobbyRedDot.Enable = _AttendanceLogic:CanClaim()
		end
	end

	@ExecSpace("ClientOnly")
	method void SetLobbyTabVisible(boolean visible)
		-- TitleUI.ShowPanelOnly가 탭을 바꿀 때 부른다(인벤토리 버튼과 같은 규칙: 전투 탭에서만 보인다)
		self._lobbyTabVisible = visible
		self:RefreshLobbyButton()
	end

	@ExecSpace("ClientOnly")
	method void OnSlotClicked(integer day)
		local claimed = _AttendanceLogic:GetClaimedCount()
		if day ~= claimed + 1 then return end
		if _AttendanceLogic:CanClaim() then
			if self._claimPending then return end
			-- 서버 지급 Multicast가 배지 숫자를 바로 올리기 전에 보류 — 팝업을 닫고 아이콘이 도착할 때 오른다
			self._holdKind = _AttendanceLogic:GetRewardKind(day)
			self._holdAmount = _AttendanceLogic:GetRewardAmount(day)
			if self._holdKind == "gold" or self._holdKind == "diamond" then
				_RewardFlyUI:Hold(self._holdKind, self._holdAmount)
			end
			-- 서버가 거절하면 OnClaimed가 안 오므로 잠깐 뒤 보류를 푼다.
			-- ⚠ 콜백 안에서 self._holdKind/_holdAmount를 읽으면 안 된다 — 그 사이에 다음 수령 값으로
			-- 덮여 있으면 방금 받은 보상의 보류를 잘못 풀어버린다(숫자가 연출보다 먼저 올라감).
			-- 자기 수령분을 클로저로 잡아두고, 번호표가 바뀌었으면 아무것도 안 한다
			self._claimPending = true
			self._claimSeq = self._claimSeq + 1
			local seq = self._claimSeq
			local pendingKind = self._holdKind
			local pendingAmount = self._holdAmount
			_TimerService:SetTimerOnce(function()
				if self._claimSeq ~= seq then return end
				if not self._claimPending then return end
				self._claimPending = false
				if pendingKind == "gold" or pendingKind == "diamond" then
					_RewardFlyUI:Release(pendingKind, pendingAmount)
				end
			end, 2.0)
			_AttendanceLogic:RequestClaim()
		else
			_UIToast:ShowMessage("내일 다시 받을 수 있어요")
		end
	end

	@ExecSpace("Client")
	method void OnClaimed(integer day)
		-- AttendanceLogic.RequestClaim이 지급을 끝낸 뒤 호출 — 체크 도장 연출(보상은 팝업을 닫을 때 날아간다).
		-- 번호표를 올려서 이 수령의 타임아웃 타이머가 뒤늦게 보류를 풀어버리지 않게 한다
		self._claimPending = false
		self._claimSeq = self._claimSeq + 1
		if self._isOpen then
			table.insert(self._pendingFly, day)
			self:PlayClaimAnimation(day)
		else
			-- 받자마자 팝업을 닫아버린 경우 — 로비 출석 버튼 자리에서 바로 날린다
			self:FlyReward(day, _RewardFlyUI:GetLayerPosOf(self.lobbyButton.Entity, 0, 0), 0)
		end
	end

	@ExecSpace("ClientOnly")
	method void FlyReward(integer day, Vector2 fromPos, number delay)
		_RewardFlyUI:Fly(_AttendanceLogic:GetRewardKind(day), _AttendanceLogic:GetRewardAmount(day), _AttendanceLogic:GetRewardIconRUID(day), fromPos, delay)
	end

	@ExecSpace("ClientOnly")
	method void FlyPendingRewards()
		-- 팝업을 닫는 순간(끄기 직전) 이번에 받은 칸 자리에서 날린다
		local delay = 0
		for _, day in ipairs(self._pendingFly) do
			local slot = self:GetSlot(day)
			local src = Vector2(0, 0)
			if isvalid(slot) then src = _RewardFlyUI:GetLayerPosOf(slot, 0, 0) end
			self:FlyReward(day, src, delay)
			delay = delay + 0.3
		end
		self._pendingFly = {}
	end

	@ExecSpace("ClientOnly")
	method void PlayClaimAnimation(integer day)
		local slot = self:GetSlot(day)
		if not isvalid(slot) then return end
		local icon = slot:GetChildByName("RewardIcon")
		local amountText = slot:GetChildByName("AmountText")
		local check = slot:GetChildByName("Check")
		if not isvalid(check) then return end
		self._animatingDay = day
		slot.UITransformComponent.Scale = Vector3(1, 1, 1)
		if isvalid(icon) then icon.Enable = false end
		if isvalid(amountText) then amountText.TextGUIRendererComponent.Text = "완료" end

		local tr = check.UITransformComponent
		local sprite = check.SpriteGUIRendererComponent
		tr.Scale = Vector3(self.CheckStartScale, self.CheckStartScale, 1)
		tr.anchoredPosition = Vector2(0, self.CheckStartOffsetY)
		sprite.Color = Color(1, 1, 1, 0)
		check.Enable = true
		-- 가속하며 떨어지듯(QuadEaseIn) 크게 → 원래 크기, 위 → 제자리, 투명 → 불투명
		_TweenLogic:PlayTween(0.0, 1.0, self.CheckDropDuration, EaseType.QuadEaseIn, function(t)
			if not isvalid(check) then return end
			local s = self.CheckStartScale + (1.0 - self.CheckStartScale) * t
			tr.Scale = Vector3(s, s, 1)
			tr.anchoredPosition = Vector2(0, self.CheckStartOffsetY * (1.0 - t))
			local a = t * 1.6
			if a > 1 then a = 1 end
			sprite.Color = Color(1, 1, 1, a)
			if t >= 1.0 then
				-- 착지 반동 — 살짝 눌렸다가 원래 크기로
				_TweenLogic:ScaleTo(check, Vector2(0.9, 0.9), 0.06, EaseType.QuadEaseOut)
				_TimerService:SetTimerOnce(function()
					if not isvalid(check) then return end
					_TweenLogic:ScaleTo(check, Vector2(1, 1), 0.12, EaseType.BackEaseOut)
					self._animatingDay = 0
					self:RefreshAll()
				end, 0.06)
			end
		end)
		log("AttendanceUI: claim animation day " .. day)
	end

	@ExecSpace("ClientOnly")
	method void StartPulse()
		self:StopPulse()
		self._pulseTime = 0
		self._pulseTimerId = _TimerService:SetTimerRepeat(function()
			self._pulseTime = self._pulseTime + 1 / 30
			local target = 0
			if _AttendanceLogic:CanClaim() then target = _AttendanceLogic:GetClaimedCount() + 1 end
			for i = 1, 7 do
				local slot = self:GetSlot(i)
				if isvalid(slot) then
					local s = 1.0
					if i == target and i ~= self._animatingDay then
						s = 1.0 + self.PulseAmplitude * math.sin(self._pulseTime * self.PulseSpeed)
					end
					slot.UITransformComponent.Scale = Vector3(s, s, 1)
				end
			end
		end, 1 / 30)
	end

	@ExecSpace("ClientOnly")
	method void StopPulse()
		if self._pulseTimerId ~= 0 then
			_TimerService:ClearTimer(self._pulseTimerId)
			self._pulseTimerId = 0
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		self:StopPulse()
		if self._closeHandler then self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self._closeHandler) end
		if self._lobbyHandler then self.lobbyButton.Entity:DisconnectEvent(ButtonClickEvent, self._lobbyHandler) end
		for _, rec in ipairs(self._slotHandlers) do
			if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler) end
		end
		self._slotHandlers = {}
	end

end
