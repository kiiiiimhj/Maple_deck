@Logic
script EasterEggBonusLogic extends Logic

	-- 아이템이 나오는 터치/오브젝트 이스터에그가 보상을 줄 때 같이 굴리는 추가 보상(유저 지정 2026-09-18).
	--   · 5% — 버프 포션 3종(흡혈/크리티컬/파워) 중 1개 (BuffPotionLogic.ScheduleBuffPotion, 확정 지급형)
	--   · 5% — 다이아 5~10개 (DiamondDropLogic, 12시간 100개 상한 공유)
	-- 두 굴림은 서로 독립이라 한 번에 둘 다 나올 수도 있다. 원래 이스터에그 보상(포션/스킬/전용 아이템)은
	-- 그대로 두고 "덤"으로만 얹는다.
	--
	-- 각 이스터에그 Logic의 보상 지급 직후에 RollBonus()를 한 줄 호출하는 식으로 붙였다.
	-- 새 이스터에그를 만들 때도 같은 한 줄만 추가하면 된다.

	property number PotionChance = 0.05

	@ExecSpace("ServerOnly")
	method void RollBonus(Vector3 worldPos, number fallHeight, number groundWorldY)
		-- 이스터에그 보상 지급 시 호출 — 버프 포션/다이아를 각각 5%로 굴린다
		if _GameManager.GameOver then return end
		-- 업적: 이스터에그 발견 수(모든 이스터에그 보상 지점이 이 한 줄을 거친다)
		_AchievementLogic:OnEasterEgg()
		if _UtilLogic:RandomDouble() < self.PotionChance then
			local potionType = _UtilLogic:RandomIntegerRange(1, 3)
			_BuffPotionLogic:ScheduleBuffPotion(potionType, worldPos, fallHeight, groundWorldY, 1.0)
			log("EasterEggBonus: buff potion type=" .. potionType)
		end
		_DiamondDropLogic:TryDropDiamond(worldPos, fallHeight, groundWorldY, 1.0)
	end

end
