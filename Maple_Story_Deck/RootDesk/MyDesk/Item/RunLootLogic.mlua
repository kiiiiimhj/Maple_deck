@Logic
script RunLootLogic extends Logic

	-- 이번 판에 얻은 "점수 밖" 획득물(다이아 / 뽑기권 / 장비 / 강화 주문서) 기록 — 게임오버 결과창(GameOverUI)이
	-- 잡템 앞에 같이 보여준다(유저 지정 2026-09-30, 점수에는 안 들어간다).
	--   · 서버가 아이콘 단위로 세어 문자열 하나(@Sync Summary)로 내려보낸다. 형식: "아이콘RUID|개수;아이콘RUID|개수;..."(보여줄 순서)
	--   · 실제로 받은 것만 센다 — 인벤이 가득 차 버려진 장비/주문서는 안 센다(호출 위치가 지급 성공 뒤).
	--   · 다시하기/새 판(GameManager.RestartGame, StartGame 최초 시작)에서 비우고, 이어하기는 그대로 누적한다.
	--   · 새 획득 경로를 만들면 그 지급 지점에서 AddDiamond/AddTicket/AddGear/AddScroll 중 하나를 불러야 결과창에 나온다.

	@Sync property string Summary = ""

	-- 서버 전용: { icon, count, rank, seq } 목록. rank = 결과창 순서(다이아 1 → 뽑기권 2 → 장비 3 → 주문서 4)
	property table _entries = {}
	property integer _seq = 0

	@ExecSpace("ServerOnly")
	method void Reset()
		-- 새 판 시작 — 기록을 비운다
		self._entries = {}
		self._seq = 0
		self.Summary = ""
		log("RunLootLogic: reset")
	end

	@ExecSpace("ServerOnly")
	method void AddDiamond(string iconRUID, integer count)
		-- 판 도중 드롭으로 받은 다이아(DiamondDropLogic)
		self:AddEntry(iconRUID, count, 1)
	end

	@ExecSpace("ServerOnly")
	method void AddTicket(string iconRUID, integer count)
		-- 판 도중 받은 유물/스킬 뽑기권(PullTicketDropLogic, Map24 보물상자, Map04 잡템 NPC) — 아이콘이 달라 따로 묶인다
		self:AddEntry(iconRUID, count, 2)
	end

	@ExecSpace("ServerOnly")
	method void AddGear(string iconRUID)
		-- 인벤에 실제로 들어간 장비 1개(GameManager.GrantWeaponItemDrop) — 같은 종류·등급은 아이콘이 같아 한 칸에 묶인다
		self:AddEntry(iconRUID, 1, 3)
	end

	@ExecSpace("ServerOnly")
	method void AddScroll(string iconRUID)
		-- 인벤에 실제로 들어간 강화 주문서 1장(GameManager.GrantEnhanceScrollDrop)
		self:AddEntry(iconRUID, 1, 4)
	end

	@ExecSpace("ServerOnly")
	method void AddEntry(string iconRUID, integer count, integer rank)
		-- 같은 아이콘이면 개수만 더하고, 처음이면 새 칸을 만든 뒤 Summary를 다시 만든다
		if iconRUID == nil or iconRUID == "" or count <= 0 then return end
		local found = false
		for _, e in ipairs(self._entries) do
			if e.icon == iconRUID then
				e.count = e.count + count
				found = true
				break
			end
		end
		if not found then
			self._seq = self._seq + 1
			table.insert(self._entries, { icon = iconRUID, count = count, rank = rank, seq = self._seq })
			table.sort(self._entries, function(a, b)
				if a.rank ~= b.rank then return a.rank < b.rank end
				return a.seq < b.seq
			end)
		end
		local parts = {}
		for _, e in ipairs(self._entries) do
			table.insert(parts, e.icon .. "|" .. tostring(e.count))
		end
		self.Summary = table.concat(parts, ";")
		log("RunLootLogic: +" .. tostring(count) .. " rank=" .. tostring(rank) .. " kinds=" .. tostring(#self._entries))
	end

	method string GetSummary()
		-- 결과창이 읽는 접근자(다른 Logic의 필드를 직접 읽지 않게)
		return self.Summary
	end

end
