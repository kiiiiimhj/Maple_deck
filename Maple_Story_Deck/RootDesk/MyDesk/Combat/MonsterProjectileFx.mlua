    method any GetAttackTiming(string ruid)
        -- Native frames have different holds. Both the pose and the release use this same timeline.
        if self._T.attackTiming==nil then self._T.attackTiming={
            ["f57adecedc44465a8b39b67db33ff6c6"]={0.0714285714286,0.142857142857,0.214285714286,0.285714285714,0.357142857143,0.428571428571,0.5,0.571428571429,0.642857142857,0.714285714286,0.785714285714,0.857142857143,0.928571428571,1},
            ["a9e503154e3e4ad5ab0e9e7742dd53ec"]={0.158227848101,0.23417721519,0.310126582278,0.436708860759,0.512658227848,0.588607594937,0.683544303797,0.810126582278,1},
            ["55966425813d4fa1bea67ad1018dcfb5"]={0.158227848101,0.23417721519,0.310126582278,0.436708860759,0.512658227848,0.588607594937,0.683544303797,0.810126582278,1},
            ["992f9d470255469ca5bbe69d9551f790"]={0.158227848101,0.23417721519,0.310126582278,0.436708860759,0.512658227848,0.588607594937,0.683544303797,0.810126582278,1},
            ["d1dce4fdac0f4838b37af3c0fea8fd52"]={0.158227848101,0.23417721519,0.310126582278,0.436708860759,0.512658227848,0.588607594937,0.683544303797,0.810126582278,1},
            ["022330aea10449ac970a86ee17db8709"]={0.0344827586207,0.0689655172414,0.103448275862,0.137931034483,0.172413793103,0.206896551724,0.241379310345,0.275862068966,0.310344827586,0.344827586207,0.379310344828,0.413793103448,0.448275862069,0.48275862069,0.51724137931,0.551724137931,0.586206896552,0.620689655172,0.655172413793,0.689655172414,0.724137931034,0.758620689655,0.793103448276,0.827586206897,0.862068965517,0.896551724138,0.931034482759,0.965517241379,1},
            ["34f5598ceeb6477790d07275177e42f3"]={0.0769230769231,0.153846153846,0.230769230769,0.307692307692,0.384615384615,0.461538461538,0.538461538462,0.615384615385,0.692307692308,0.753846153846,0.815384615385,0.876923076923,0.938461538462,1},
            ["c9c73dc14a80445893d2baef34f31692"]={0.128571428571,0.214285714286,0.3,0.385714285714,0.471428571429,0.557142857143,0.685714285714,0.771428571429,0.857142857143,1},
        } end
        return self._T.attackTiming[ruid]
    end

    @ExecSpace("ServerOnly")
    method number GetWindup(MonsterAI ai, any profile)
        -- Ground-slam projectiles leave on the actual impact frame of the shared attack pose.
        if profile.windupSeconds~=nil then return profile.windupSeconds end
        local sequence=self:GetAttackSequence(ai._attackRUID)
        if profile.releaseFrame~=nil and sequence~=nil then
            local timing=self:GetAttackTiming(ai._attackRUID)
            return ai._attackDuration*(timing~=nil and timing[profile.releaseFrame] or profile.releaseFrame/#sequence)
        end
        return math.max(0.18,math.min(0.80,ai._attackDuration*profile.wind))
    end

    @ExecSpace("ClientOnly")
    method void StartSingleAttack(MonsterAI ai, string attack, string stand, number duration, integer generation)
        -- Keep the original attack lifetime and play every native frame exactly once.
        local sequence=self:GetAttackSequence(attack)
        if sequence==nil or not isvalid(ai) or not isvalid(ai.Entity) then return end
        if self._T.attackPoses==nil then self._T.attackPoses={} end
        ai._T.projectileAttackGeneration=generation
        table.insert(self._T.attackPoses,{ai=ai,attack=attack,frames=sequence,stand=stand,duration=math.max(.01,duration),
            generation=generation,age=0,zone=_MapManager.CurrentMapIndex,revision=self.RunRevision})
        ai:ApplyBodySprite(sequence[1])
    end

    @ExecSpace("ClientOnly")
    method void FinishAttackPose(any pose)
        -- Restore only the pose this generation owns; never overwrite hit or death animations.
        local ai=pose.ai
        if not isvalid(ai) or not isvalid(ai.Entity) or ai._transientSpriteGeneration~=pose.generation then return end
        if not ai._dead then ai:ApplyBodySprite(pose.stand) end
        ai._T.projectileAttackGeneration=nil
        ai._isPlayingTransientSprite=false ai._isPlayingAttackSprite=false
    end

    @ExecSpace("ClientOnly")
    method void UpdateAttackPoses(number delta)
        -- Manual body frames obey game pause and status freezes, and stop at the final frame.
        if self._T.attackPoses==nil then return end
        for i=#self._T.attackPoses,1,-1 do
            local pose=self._T.attackPoses[i] local ai=pose.ai
            local cancel=not isvalid(ai) or not isvalid(ai.Entity) or ai._dead or ai._transientSpriteGeneration~=pose.generation
            cancel=cancel or pose.zone~=_MapManager.CurrentMapIndex or pose.revision~=self.RunRevision or _GameManager.GameOver or not _GameManager.GameStarted or _MapManager.AwayOnSideMap
            if cancel then self:FinishAttackPose(pose) table.remove(self._T.attackPoses,i)
            elseif not _GameManager:IsGamePaused() and ai.Entity.SpriteRendererComponent.PlayRate>0 then
                pose.age=pose.age+delta
                local progress=pose.age/pose.duration local timing=self:GetAttackTiming(pose.attack)
                local frame=math.min(#pose.frames,1+math.floor(progress*#pose.frames))
                if timing~=nil then
                    frame=1
                    while frame<#pose.frames and progress>=timing[frame] do frame=frame+1 end
                end
                if ai.Entity.SpriteRendererComponent.SpriteRUID~=pose.frames[frame] then ai:ApplyBodySprite(pose.frames[frame]) end
                if pose.age>=pose.duration then self:FinishAttackPose(pose) table.remove(self._T.attackPoses,i) end
            end
        end
    end

    @ExecSpace("ServerOnly")
    method boolean Supports(MonsterAI ai)
        return isvalid(ai) and not ai._isBoss and not ai._isElite and self:GetProfile(ai._standRUID)~=nil
    end

    @ExecSpace("ServerOnly")
    method table GetCheatCases()
        -- Fixed preview order; appearance zone is separate from the player's current spawn zone.
        return {{12,3},{27,2},{46,2},{50,1},{51,2},{67,1},{65,2},{95,1},
            {104,1},{105,1},{106,1},{107,1},{111,2},{129,2},{138,1},{148,1},
            {155,2},{159,2},{164,2},{167,2},{169,2},{172,1},{175,2},{180,2},{176,2},{179,2}}
    end

    @ExecSpace("ServerOnly")
    method void ClearCheatMonster()
        -- Cancel only preview shots; regular combat projectiles keep their original timing.
        local e=self._T.cheatEntity
        self._T.cheatEntity=nil self._T.cheatZone=nil
        if self._shots~=nil then
            for i=#self._shots,1,-1 do
                if self._shots[i].cheat then
                    local id=self._shots[i].id table.remove(self._shots,i) self:CancelVisual(id)
                end
            end
        end
        if isvalid(e) then e:Destroy() end
    end

    @ExecSpace("Server")
    method void CheatRequestNextRanged()
        -- Maker-only RPC: one Y press replaces the preview with the next ranged species.
        if not Environment:IsMakerPlay() or not _CardManager.DebugMode then return end
        if not _GameManager.GameStarted or _GameManager.GameOver or _MapManager.AwayOnSideMap then return end
        if _GameManager:IsGamePaused() then return end
        local zone=_MapManager.CurrentMapIndex
        local map=_MonsterSpawner:GetZoneEntity(zone)
        if not isvalid(map) then return end
        local cases=self:GetCheatCases()
        local index=((self._T.cheatIndex or 0)%#cases)+1 local case=cases[index]
        self:ClearCheatMonster()
        local pos=_MonsterSpawner:GetSpawnPosition(zone,true,0,map)
        pos=Vector3(pos.x+1.4,pos.y,0)
        local e=_SpawnService:SpawnByModelId(_MonsterSpawner.MonsterModelId,"RangedPreview",_MonsterSpawner:ToLocalSpawnPos(map,pos),map)
        if not isvalid(e) then return end
        ---@type MonsterAI
        local ai=e:GetComponent("script.MonsterAI")
        if ai==nil then e:Destroy() return end
        ai:InitializeStats(case[1],1,false,case[2])
        if index==5 then ai:ReviveAsPhase2() end
        local profile=self:GetProfile(ai._standRUID)
        if profile==nil then e:Destroy() log_warning("RangedPreview: unsupported species "..index) return end
        if ai._isFlying then
            ai:RepositionFlyingCenter(pos.x,pos.y+1.1,zone)
            ai.FlyRangeX=1.2 ai.FlyingWanderMinY=-0.2 ai.FlyingWanderMaxY=0.2 ai._currentScale=1
        else
            _MonsterSpawner:UnregisterZoneMonster(ai._spawnZoneIndex,ai) ai:SetSpawnZone(zone)
            e.TransformComponent.Position=_MonsterSpawner:ToLocalSpawnPos(map,pos)
            ai._currentScale=ai._reachedScaleThreshold
        end
        ai.MonsterSprite=ai._standRUID ai:ApplyBodySprite(ai._standRUID)
        ai._reachedPlayer=true ai._paused=false ai._attackTimer=0.15 ai._accuracyDebuffPercent=0
        ai.MaxHp=1000000000 ai.CurrentHp=ai.MaxHp
        local size=ai._currentScale*ai._scaleMultiplier
        e.TransformComponent.Scale=Vector3(size,size,1)
        self._T.cheatEntity=e self._T.cheatZone=zone self._T.cheatIndex=index
        _UIToast:ShowMessage("[Y "..index.."/"..#cases.."] "..profile.name)
        log("RangedPreview: "..index.."/"..#cases.." "..profile.name.." zone="..zone)
    end

    @ExecSpace("ServerOnly")
    method void ResetForRun()
        -- New game and retry restart the preview cycle and discard its monster.
        self:ClearCheatMonster() self._T.cheatIndex=0
        self.RunRevision=self.RunRevision+1 self._shots={}
        self:ClearVisuals()
    end

    @ExecSpace("ServerOnly")
    method void QueueAttack(MonsterAI ai, number damage, boolean ignoreImmune)
        if not isvalid(ai) or not isvalid(ai.Entity) or ai._dead or _GameManager.GameOver then return end
        local profile=self:GetProfile(ai._standRUID)
        if profile==nil then return end
        local isCheat=self._T.cheatEntity==ai.Entity
        if isCheat then damage=0 end
        if self._shots==nil then self._shots={} end
        self._serial=self._serial+1
        local windup=self:GetWindup(ai,profile)
        local p=ai.Entity.TransformComponent.WorldPosition
        table.insert(self._shots,{id=self._serial,ai=ai,stand=ai._standRUID,zone=ai._spawnZoneIndex,revision=self.RunRevision,
            life=ai.ProjectileLifeRevision,age=0,windup=windup,flight=profile.flight,damage=damage,ignore=ignoreImmune,cheat=isCheat,
            released=false,origin=Vector2(p.x,p.y)})
        self:PrepareVisual(self._serial,ai.Entity,ai._standRUID,windup,ai._spawnZoneIndex,self.RunRevision,ai._attackRUID,ai._attackDuration,ai._attackSoundRUID)
    end

    method void OnUpdate(number delta)
        if self:IsClient() then self:UpdateAttackPoses(delta) self:UpdateVisuals(delta) return end
        if self._T.cheatZone~=nil and (self._T.cheatZone~=_MapManager.CurrentMapIndex or _GameManager.GameOver or not _GameManager.GameStarted or _MapManager.AwayOnSideMap) then
            self:ClearCheatMonster()
        end
        if self._shots==nil or self._T.serverUpdating then return end
        self._T.serverUpdating=true
        local shots=self._shots
        for i=#shots,1,-1 do
            if shots~=self._shots then break end
            local shot=shots[i]
            local cancel=shot.revision~=self.RunRevision or shot.zone~=_MapManager.CurrentMapIndex or _MapManager.AwayOnSideMap or _GameManager.GameOver or not _GameManager.GameStarted
            if not shot.released and (not isvalid(shot.ai) or not isvalid(shot.ai.Entity) or shot.ai._dead or shot.ai._standRUID~=shot.stand or shot.ai._spawnZoneIndex~=shot.zone or shot.ai.ProjectileLifeRevision~=shot.life) then cancel=true end
            if cancel then
                table.remove(shots,i) self:CancelVisual(shot.id)
            elseif not _GameManager:IsGamePaused() then
                shot.age=shot.age+delta
                if shot.age>=shot.windup then shot.released=true end
                if shot.age>=shot.windup+shot.flight then
                    table.remove(shots,i)
                    if shot.damage>0 then _GameManager:OnMonsterReached(shot.damage,shot.ignore,false,shot.origin,false) end
                end
            end
        end
        self._T.serverUpdating=false
    end

    @ExecSpace("ClientOnly")
    method any WarmFrames(string ruid)
        if ruid=="" then return {} end
        if self._T.frameMetrics==nil then self._T.frameMetrics={} end
        if self._T.frameMetrics[ruid]~=nil then return self._T.frameMetrics[ruid] end
        local frames={}
        for _,id in ipairs(self:GetFrameRUIDs(ruid)) do table.insert(frames,{ruid=id,metrics=_CardManager:GetSpriteMetrics(id)}) end
        self._T.frameMetrics[ruid]=frames
        return frames
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self._T.shots={} self._T.cancelled={} self._T.updating=false self._T.frameMetrics={} self._T.attackPoses={}
        self:GetAttackSequence("81d93653a2e042e5a15027ec9afa232d")
        local ids={} local seen={}
        for stand,p in pairs(self:GetProfiles()) do
            for _,ruid in ipairs({stand,p.projectile,p.hit,p.muzzleSprite or ""}) do
                if ruid~="" then for _,id in ipairs(self:GetFrameRUIDs(ruid)) do
                    if not seen[id] then seen[id]=true table.insert(ids,id) end
                end end
            end
        end
        for attack,frames in pairs(self._T.attackSequences or {}) do
            for _,id in ipairs(frames) do if not seen[id] then seen[id]=true table.insert(ids,id) end end
        end
        _ResourceService:PreloadAsync(ids,function()
            if not isvalid(self) then return end
            for stand,p in pairs(self:GetProfiles()) do
                _CardManager:GetSpriteMetrics(stand)
                if p.muzzleSprite~=nil then _CardManager:GetSpriteMetrics(p.muzzleSprite) end
                self:WarmFrames(p.projectile) self:WarmFrames(p.hit)
            end
            self._T.ready=true log("MonsterProjectile: 26 profiles preloaded")
        end)
    end

    @ExecSpace("Client")
    method void PrepareVisual(integer id, Entity source, string stand, number windup, integer zone, integer revision, string attack, number duration, string sfx)
        local p=self:GetProfile(stand)
        if p==nil then return end
        if self._T.shots==nil then self._T.shots={} end
        if self._T.cancelled==nil then self._T.cancelled={} end
        local body=_CardManager:GetSpriteMetrics(p.muzzleSprite or stand)
        local frames=self:WarmFrames(p.projectile) local hits=self:WarmFrames(p.hit)
        if revision~=self.RunRevision or self._T.cancelled[id] or zone~=_MapManager.CurrentMapIndex or not isvalid(source) then return end
        if p.releaseFrame~=nil and self:GetAttackSequence(attack)~=nil then
            ---@type MonsterAI
            local ai=source:GetComponent("script.MonsterAI")
            if isvalid(ai) then ai:PlayAttackPresentation(attack,stand,duration,sfx) end
        end
        if #self._T.shots>=24 then self:DestroyVisual(self._T.shots[1]) table.remove(self._T.shots,1) end
        table.insert(self._T.shots,{id=id,profile=p,source=source,body=body,frames=frames,hits=hits,windup=windup,flight=p.flight,
            zone=zone,revision=revision,age=0,fx=nil,ghosts={},fragments={},impact=nil})
    end

    @ExecSpace("ClientOnly")
    method Entity SpawnVisual(string ruid, Entity map, Vector3 pos, integer order)
        local fx=_SpawnService:SpawnByModelId("persistenteffect","MonsterProjectile",pos,map)
        if not isvalid(fx) then return nil end
        if fx.TransformComponent==nil or fx.SpriteRendererComponent==nil then fx:Destroy() return nil end
        fx.SpriteRendererComponent.SpriteRUID=ruid
        fx.SpriteRendererComponent.SortingLayer="UI" fx.SpriteRendererComponent.OrderInLayer=order
        return fx
    end

    @ExecSpace("ClientOnly")
    method void PlaceVisual(Entity fx, any metrics, Vector3 center, number scale, number rotation)
        if not isvalid(fx) or fx.TransformComponent==nil then return end
        local ox=(0.5-metrics.px)*math.max(0,metrics.w)*scale
        local oy=(0.5-metrics.py)*math.max(0,metrics.h)*scale
        local angle=rotation*math.pi/180 local c=math.cos(angle) local sn=math.sin(angle)
        fx.TransformComponent.Scale=Vector3(scale,scale,1) fx.TransformComponent.ZRotation=rotation
        fx.TransformComponent.WorldPosition=Vector3(center.x-ox*c+oy*sn,center.y-ox*sn-oy*c,center.z)
    end

    @ExecSpace("ClientOnly")
    method void DrawFrame(Entity fx, table frames, number time, number period, Vector3 center, number width, number rotation, any tint, number alpha, boolean once)
        if not isvalid(fx) or fx.SpriteRendererComponent==nil or #frames==0 then return end
        local step=math.floor(math.max(0,time)/math.max(0.01,period))
        local idx=once and math.min(#frames,1+step) or (1+step%#frames)
        local f=frames[idx] local r=fx.SpriteRendererComponent
        if r.SpriteRUID~=f.ruid then r.SpriteRUID=f.ruid end
        self:PlaceVisual(fx,f.metrics,center,width/math.max(0.01,f.metrics.w),rotation)
        r.Color=Color(tint[1],tint[2],tint[3],alpha)
    end

    @ExecSpace("ClientOnly")
    method void ReleaseVisual(any shot, Entity map)
        local p=shot.profile local tf=shot.source.TransformComponent local pos=tf.WorldPosition
        local sx=math.abs(tf.Scale.x) local sy=math.abs(tf.Scale.y) local body=shot.body
        local flipped=shot.source.SpriteRendererComponent.FlipX
        local xoff=((p.muzzleX or 0.5)-body.px)*body.w*sx
        if flipped then xoff=-xoff end
        shot.start=Vector3(pos.x+xoff,pos.y+(p.height-body.py)*body.h*sy,pos.z-0.3)
        -- 2026-10-06 유저 지정(스샷 회색 영역): 화면 가로 21~77%, 아래에서 26~84% 안의 한 점으로 날아와 터진다
        shot.targetScreen=Vector2(_UILogic.ScreenWidth*(0.211+_UtilLogic:RandomDouble()*0.56),_UILogic.ScreenHeight*(0.264+_UtilLogic:RandomDouble()*0.576))
        local endpoint=_UILogic:ScreenToWorldPosition(shot.targetScreen)
        local unit=_UILogic:ScreenToWorldPosition(Vector2(shot.targetScreen.x+1,shot.targetScreen.y))
        shot.unit=math.abs(unit.x-endpoint.x)
        shot.w1=shot.unit*math.min(_UILogic.ScreenHeight*p.width,_UILogic.ScreenWidth*0.25)
        shot.w0=math.max(shot.unit*16,math.min(body.w*sx*0.28,shot.w1*0.38))
        if p.impactNative and #shot.hits>0 then
            local maxWidth=.01
            for _,frame in ipairs(shot.hits) do maxWidth=math.max(maxWidth,frame.metrics.w) end
            shot.hitScale=shot.w1*.85/maxWidth
            local m=shot.hits[1].metrics
            shot.hitOffset=Vector2((.5-m.px)*m.w*shot.hitScale,(.5-m.py)*m.h*shot.hitScale)
        end
        shot.rotation=p.align and (math.deg(math.atan(endpoint.y-shot.start.y,endpoint.x-shot.start.x))+35) or 0
        shot.framePeriod=p.projectileOnce and shot.flight/#shot.frames or .08
        shot.fx=self:SpawnVisual(shot.frames[1].ruid,map,shot.start,92)
        for j=1,2 do shot.ghosts[j]=self:SpawnVisual(shot.frames[1].ruid,map,shot.start,92-j) end
    end

    @ExecSpace("ClientOnly")
    method void UpdateVisuals(number delta)
        if self._T.shots==nil or self._T.updating then return end
        self._T.updating=true
        local player=_UserService.LocalPlayer
        for i=#self._T.shots,1,-1 do
            local shot=self._T.shots[i] local p=shot.profile
            local cancel=not isvalid(player) or not isvalid(player.CurrentMap) or shot.revision~=self.RunRevision or shot.zone~=_MapManager.CurrentMapIndex or _MapManager.AwayOnSideMap or _GameManager.GameOver or not _GameManager.GameStarted
            if cancel then self:DestroyVisual(shot) table.remove(self._T.shots,i)
            elseif not _GameManager:IsGamePaused() then
                shot.age=shot.age+delta
                if shot.age>=shot.windup and not shot.released then
                    if not isvalid(shot.source) or not shot.source.Enable or shot.source.TransformComponent==nil or shot.source.SpriteRendererComponent==nil then
                        self:DestroyVisual(shot) table.remove(self._T.shots,i)
                    else shot.released=true self:ReleaseVisual(shot,player.CurrentMap) end
                end
                if isvalid(shot.fx) then
                    local time=shot.age-shot.windup local t=math.max(0,math.min(1,time/shot.flight))
                    local endpoint=_UILogic:ScreenToWorldPosition(shot.targetScreen)
                    local u=t^1.5 local projectileScale=p.projectileScale or 1 local width=(shot.w0+(shot.w1-shot.w0)*t^2.1)*projectileScale
                    local center=Vector3(shot.start.x+(endpoint.x-shot.start.x)*u,shot.start.y+(endpoint.y-shot.start.y)*u+math.sin(t*math.pi)*p.arc,shot.start.z)
                    local rotation=shot.rotation+p.spin*t
                    self:DrawFrame(shot.fx,shot.frames,time,shot.framePeriod,center,width,rotation,p.tint,1,p.projectileOnce==true)
                    for j,ghost in ipairs(shot.ghosts) do
                        local gt=math.max(0,t-j*0.075) local gu=gt^1.5
                        local gp=Vector3(shot.start.x+(endpoint.x-shot.start.x)*gu,shot.start.y+(endpoint.y-shot.start.y)*gu+math.sin(gt*math.pi)*p.arc,shot.start.z)
                        self:DrawFrame(ghost,shot.frames,math.max(0,time-j*0.04),shot.framePeriod,gp,(shot.w0+(shot.w1-shot.w0)*gt^2.1)*projectileScale,shot.rotation+p.spin*gt,p.tint,t<1 and (0.15-j*0.04) or 0,p.projectileOnce==true)
                    end
                    if t>=1 then
                        if not shot.impacted then
                            shot.impacted=true
                            if #shot.hits>0 then shot.impact=self:SpawnVisual(shot.hits[1].ruid,player.CurrentMap,center,94) end
                            for j=1,3 do
                                local f=self:SpawnVisual(shot.frames[1].ruid,player.CurrentMap,center,93)
                                table.insert(shot.fragments,{fx=f,angle=(j*2.094)+_UtilLogic:RandomDouble()*0.6})
                            end
                        end
                        local age=math.max(0,time-shot.flight) local fade=math.max(0,1-age/0.14)
                        self:DrawFrame(shot.fx,shot.frames,time,shot.framePeriod,center,width*(1+age*0.5),rotation,p.tint,fade,p.projectileOnce==true)
                        if isvalid(shot.impact) then
                            local count=#shot.hits local index=math.min(count,1+math.floor(age/p.impact*count))
                            local frame=shot.hits[index]
                            shot.impact.SpriteRendererComponent.SpriteRUID=frame.ruid
                            if p.impactNative then
                                -- Keep the animation's original anchor and scale. Re-centering each drip frame caused jumps.
                                shot.impact.TransformComponent.Scale=Vector3(shot.hitScale,shot.hitScale,1)
                                shot.impact.TransformComponent.WorldPosition=Vector3(center.x-shot.hitOffset.x,center.y-shot.hitOffset.y,center.z)
                                shot.impact.SpriteRendererComponent.Color=Color(p.tint[1],p.tint[2],p.tint[3],math.max(0,1-math.max(0,age-p.impact)/.12))
                            else
                                self:PlaceVisual(shot.impact,frame.metrics,center,shot.w1*0.85/math.max(.01,frame.metrics.w),0)
                                shot.impact.SpriteRendererComponent.Color=Color(p.tint[1],p.tint[2],p.tint[3],math.max(0,1-math.max(0,age-p.impact*.55)/(p.impact*.45)))
                            end
                        end
                        for j,f in ipairs(shot.fragments) do
                            local distance=shot.w1*age*1.15
                            local fp=Vector3(center.x+math.cos(f.angle)*distance,center.y+math.sin(f.angle)*distance-age*age*.7,center.z)
                            self:DrawFrame(f.fx,shot.frames,time,shot.framePeriod,fp,shot.w1*(.20-.08*math.min(1,age/.40)),rotation+j*60+age*160,p.tint,math.max(0,.6*(1-age/.40)),p.projectileOnce==true)
                        end
                        if age>=math.max(.42,p.impact+(p.impactNative and .12 or 0)) then self:DestroyVisual(shot) table.remove(self._T.shots,i) end
                    end
                end
            end
        end
        self._T.updating=false
    end

    @ExecSpace("ClientOnly")
    method void DestroyVisual(any shot)
        if isvalid(shot.fx) then shot.fx:Destroy() end
        if isvalid(shot.impact) then shot.impact:Destroy() end
        for _,ghost in ipairs(shot.ghosts) do if isvalid(ghost) then ghost:Destroy() end end
        for _,fragment in ipairs(shot.fragments) do if isvalid(fragment.fx) then fragment.fx:Destroy() end end
    end

    @ExecSpace("Client")
    method void CancelVisual(integer id)
        if self._T.cancelled==nil then self._T.cancelled={} end
        self._T.cancelled[id]=true
        if self._T.shots==nil then return end
        for i=#self._T.shots,1,-1 do if self._T.shots[i].id==id then self:DestroyVisual(self._T.shots[i]) table.remove(self._T.shots,i) end end
    end

    @ExecSpace("Client")
    method void ClearVisuals()
        if self._T.shots~=nil then for _,shot in ipairs(self._T.shots) do self:DestroyVisual(shot) end end
        self._T.shots={} self._T.cancelled={}
        for _,pose in ipairs(self._T.attackPoses or {}) do self:FinishAttackPose(pose) end
        self._T.attackPoses={}
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        self:ClearVisuals()
    end
end
