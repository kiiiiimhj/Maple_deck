@Logic
script DpsMeterLogic extends Logic

	-- 인게임 DPS 미터 집계(유저 지정 2026-09-17). 화면은 DpsMeterUI가 그린다.
	--
	-- 대미지 출처(어느 카드인지) 판정:
	--   · 몬스터 대미지는 전부 MonsterAI의 TakeDamage 계열 5개 진입점만 거친다.
	--   · CardManager의 모든 호출부(234곳)는 `_DpsMeterLogic:Tag(카드번호, 대상):TakeDamage(...)` 형태로 감싸 두었다.
	--     Tag가 "다음 한 번의 피격 출처"를 기록하고 대상을 그대로 돌려주므로, 바로 이어지는 TakeDamage가 같은 프레임에 소비한다.
	--     카드 번호는 그 호출이 들어 있는 스킬 함수 기준으로 정적으로 붙였다(쉐도우 파트너 복제 타격은 원본 스킬로 잡힌다).
	--   · 태그 없이 들어온 피격(소환물 등)은 카드 0("기타")으로 모아 총 DPS에만 반영한다.
	--
	-- DPS = 이번 판 누적 대미지 ÷ 이번 판 전투 시간(정지·게임오버 제외). 새 판(StartGame/RestartGame)에 초기화, 이어하기는 유지.
	-- 클라이언트엔 1초마다 @Sync 문자열 스냅샷("초|카드:대미지,카드:대미지,...")으로 내려준다.

	property number SnapshotInterval = 1.0

	@Sync
	property string Snapshot = ""

	property integer _pendingCard = 0
	property any _totals = nil
	property number _elapsed = 0
	property number _snapshotTimer = 0
	property boolean _dirty = false

	-- ── 주간 레이드용 "최고 구간 DPS"(유저 지정 2026-09-20) ────────────────────────
	-- 레이드는 판마다 그 판의 DPS를 보스 피해량에 더하는데, 누적 DPS(총대미지÷총시간)를 쓰면 화력이
	-- 약한 런 초반이 그대로 희석돼 "빌드를 잘 만들었는데 점수가 낮다"가 된다. 그래서 1초 버킷
	-- 링버퍼로 최근 PeakWindowSeconds(30초) 이동 평균을 재고, 그 최고치를 이번 판의 대표 DPS로 쓴다.
	-- 표본이 한 바퀴(30초) 차기 전에는 창이 덜 찬 상태라 값이 튀므로 누적 DPS를 대신 쓴다.
	property number PeakWindowSeconds = 30
	property any _buckets = nil
	property integer _bucketIdx = 1
	property number _bucketTimer = 0
	property number _peakDps = 0

	-- ── CardManager / MonsterAI 훅(서버에서만 불린다) ─────────────────────────────
	method any Tag(integer cardIdx, any target)
		-- 바로 다음 피격의 출처 카드를 기록하고 대상을 그대로 돌려준다(호출부를 한 줄로 감싸기 위함)
		self._pendingCard = cardIdx
		return target
	end

	method integer ConsumeSource()
		-- TakeDamage 진입 직후 부른다 — 기록된 출처를 꺼내고 비운다(태그 없는 피격은 0)
		local card = self._pendingCard
		self._pendingCard = 0
		return card
	end

	method void RecordDamage(integer cardIdx, number damage)
		-- 실제로 들어간 최종 대미지를 카드별로 누적한다
		if damage <= 0 then return end
		if self._totals == nil then self._totals = {} end
		self._totals[cardIdx] = (self._totals[cardIdx] or 0) + damage
		self._dirty = true
		-- 레이드용 이동 평균 버킷에도 같은 대미지를 넣는다
		if self._buckets == nil then self:ResetBuckets() end
		self._buckets[self._bucketIdx] = self._buckets[self._bucketIdx] + damage
	end

	method void ResetBuckets()
		-- 1초 버킷 링버퍼를 0으로 채운다
		local slots = math.floor(self.PeakWindowSeconds)
		local t = {}
		for i = 1, slots do t[i] = 0 end
		self._buckets = t
		self._bucketIdx = 1
		self._bucketTimer = 0
	end

	method void TickBuckets(number delta)
		-- 1초마다 다음 버킷으로 넘기고, 창이 다 찼으면 이동 평균 최고치를 갱신한다
		if self._buckets == nil then self:ResetBuckets() end
		self._bucketTimer = self._bucketTimer + delta
		if self._bucketTimer < 1.0 then return end
		self._bucketTimer = self._bucketTimer - 1.0
		local slots = #self._buckets
		if self._elapsed >= self.PeakWindowSeconds then
			local sum = 0
			for i = 1, slots do sum = sum + self._buckets[i] end
			local avg = sum / self.PeakWindowSeconds
			if avg > self._peakDps then self._peakDps = avg end
		end
		self._bucketIdx = self._bucketIdx + 1
		if self._bucketIdx > slots then self._bucketIdx = 1 end
		self._buckets[self._bucketIdx] = 0
	end

	-- 이번 판의 대표 DPS — RaidLogic이 판마다 이 값을 보스 피해량에 더한다.
	-- 30초가 안 되는 짧은 판은 창이 덜 차서 이동 평균이 과대평가되므로 누적 DPS로 대체한다.
	method number GetRunDps()
		if self._elapsed < self.PeakWindowSeconds then
			if self._elapsed <= 0 then return 0 end
			local total = 0
			if self._totals ~= nil then
				for _, dmg in pairs(self._totals) do total = total + dmg end
			end
			return total / self._elapsed
		end
		return self._peakDps
	end

	@ExecSpace("ServerOnly")
	method void ResetRun()
		-- 새 판 시작 시 초기화(GameManager.StartGame / RestartGame)
		self._totals = {}
		self._elapsed = 0
		self._pendingCard = 0
		self._snapshotTimer = 0
		self._dirty = false
		self.Snapshot = "0|"
		self._peakDps = 0
		self:ResetBuckets()
		log("DpsMeterLogic: reset for new run")
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 전투 중인 시간만 센다(옵션/튜토리얼 정지·게임오버 제외). 스냅샷은 1초마다만 갱신
		if not _GameManager.GameStarted or _GameManager.GameOver then return end
		if _GameManager:IsGamePaused() then return end
		self._elapsed = self._elapsed + delta
		self:TickBuckets(delta)
		self._snapshotTimer = self._snapshotTimer + delta
		if self._snapshotTimer < self.SnapshotInterval then return end
		self._snapshotTimer = 0
		self:PublishSnapshot()
	end

	@ExecSpace("ServerOnly")
	method void PublishSnapshot()
		-- "경과초|카드:대미지,..." — 대미지는 정수로 반올림해 문자열을 짧게 유지
		local parts = {}
		if self._totals ~= nil then
			for card, dmg in pairs(self._totals) do
				table.insert(parts, tostring(card) .. ":" .. tostring(math.floor(dmg + 0.5)))
			end
		end
		self.Snapshot = string.format("%.1f", self._elapsed) .. "|" .. table.concat(parts, ",")
	end

	-- ── 클라이언트용 파서 ──────────────────────────────────────────────────────
	method table ParseSnapshot()
		-- { elapsed = 초, rows = { {card=, damage=}, ... } } — 대미지 내림차순
		local result = { elapsed = 0, rows = {} }
		local raw = self.Snapshot
		if raw == nil or raw == "" then return result end
		local bar = string.find(raw, "|", 1, true)
		if bar == nil then return result end
		result.elapsed = tonumber(string.sub(raw, 1, bar - 1)) or 0
		local body = string.sub(raw, bar + 1)
		for token in string.gmatch(body, "[^,]+") do
			local colon = string.find(token, ":", 1, true)
			if colon ~= nil then
				local card = math.floor(tonumber(string.sub(token, 1, colon - 1)) or 0)
				local dmg = tonumber(string.sub(token, colon + 1)) or 0
				table.insert(result.rows, { card = card, damage = dmg })
			end
		end
		table.sort(result.rows, function(a, b) return a.damage > b.damage end)
		return result
	end

end
