@Component
script TreasureChestEgg extends Component

	property string StandRUID = "9cff692190eb472fba4f6d0e68f213a7"
	property string DieRUID = "7a09c81fa4534f898a41595750d7411d"
	property number DieDuration = 0.5

	-- 상자 옆에 같이 놓인 장식(map12의 object-1036 등) — 상자가 열릴 때 같이 사라져야 하는 딸린 엔티티.
	-- 안 쓰는 맵의 상자는 빈 값이면 그냥 무시된다
	property Entity extraEntity = ""

	property boolean _opened = false
	property any _touchHandler = nil

	method void OnBeginPlay()
		if self:IsClient() then
			local renderer = self.Entity.SpriteRendererComponent
			if renderer ~= nil then renderer.SpriteRUID = self.StandRUID end
			self._touchHandler = self.Entity:ConnectEvent(TouchEvent, self.OnTouched)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		-- 게임오버 팝업이나 타이틀(로비) 화면이 떠 있는 동안은 뒤에 있는 월드 오브젝트가 눌리면 안 된다 —
		-- UI의 CanvasGroup.BlocksRaycasts는 UI 레이어끼리만 막고 월드 스페이스 TouchReceiveComponent는
		-- 별도 경로라 막히지 않으므로(실측 확인), 여기서 직접 게이트한다.
		if _GameManager.GameOver then return end
		if _TitleUI.titleGroup.Enable then return end
		-- 터치 시 서버에 개봉을 요청한다
		self:RequestOpen()
	end

	@ExecSpace("Server")
	method void RequestOpen()
		-- 이미 열렸으면 중복 요청 무시 (여러 번 터치해도 카드가 한 번만 드롭되도록)
		if self._opened then return end
		self._opened = true
		self:PlayOpen()
		-- CardManager.OnEliteKilled는 파라미터 이름이 worldPos일 정도로 월드 좌표를 기대한다
		-- (내부에서 _UILogic:WorldToScreenPosition으로 화면 좌표 변환). 이 상자가 Zone12처럼
		-- 오프셋을 가진 컨테이너 밑에 있으면(또는 유저가 Maker에서 상자를 옮기면) Position(로컬)과
		-- WorldPosition이 달라져서, 로컬 좌표를 넘기면 화면 밖 엉뚱한 곳으로 환산되어 드롭 연출이
		-- 아예 안 보이는 버그가 있었다.
		-- 상자는 항상 바닥에 있으므로 fallHeight=0 고정(groundWorldY는 미사용)
		local wp = self.Entity.TransformComponent.WorldPosition
		_CardManager:OnEliteKilled(wp, 0, wp.y)
		self.Entity:Destroy(self.DieDuration + 0.3)
		if isvalid(self.extraEntity) then
			self.extraEntity:Destroy(self.DieDuration + 0.3)
		end
	end

	@ExecSpace("Multicast")
	method void PlayOpen()
		if self:IsServer() then return end
		local renderer = self.Entity.SpriteRendererComponent
		if renderer ~= nil then renderer.SpriteRUID = self.DieRUID end
	end

	method void OnEndPlay()
		if self:IsClient() and self._touchHandler ~= nil then
			self.Entity:DisconnectEvent(TouchEvent, self._touchHandler)
		end
	end

end
