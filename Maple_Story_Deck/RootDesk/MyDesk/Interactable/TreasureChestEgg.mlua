@Component
script TreasureChestEgg extends Component

	property string StandRUID = "9cff692190eb472fba4f6d0e68f213a7"
	property string DieRUID = "7a09c81fa4534f898a41595750d7411d"
	property number DieDuration = 0.5

	-- 열렸을 때 보상 방식
	--   "chest"       기본 상자 규칙(CardManager.OnTreasureBoxOpened — 슬롯카드 최대 2개, 빈 풀이면 하얀 포션)
	--   "skillPotion" 슬롯 스킬 1개 + 빨간 포션 1개(유저 지정 2026-09-17, map04 EasterEggObject). 강화할 스킬이 없으면 포션만
	property string RewardMode = "chest"

	-- 상자 옆에 같이 놓인 장식(map12의 object-1036 등) — 상자가 열릴 때 같이 사라져야 하는 딸린 엔티티.
	-- 안 쓰는 맵의 상자는 빈 값이면 그냥 무시된다
	property Entity extraEntity = ""

	property boolean _opened = false
	property any _touchHandler = nil
	-- 열린 뒤 숨기는 예약 타이머 토큰 — 열자마자(0.8초 안에) 다시하기를 누르면 예약된 "숨기기"가
	-- 방금 되살린 상자를 다시 꺼버리지 않게, 리셋할 때 토큰을 올려 예약을 무효화한다
	property integer _openToken = 0

	method void OnBeginPlay()
		if self:IsServer() then
			-- 다시하기 때 다시 닫힌 채로 되돌릴 수 있게 등록(TreasureChestEggRegistry.ResetForNewRun)
			_TreasureChestEggRegistry:Register(self)
		end
		if self:IsClient() then
			local renderer = self.Entity.SpriteRendererComponent
			if renderer ~= nil then renderer.SpriteRUID = self.StandRUID end
			-- 숨겼다 다시 켜질 때 OnBeginPlay가 다시 불려도 터치 핸들러가 두 번 붙지 않게 한다
			if self._touchHandler == nil then
				self._touchHandler = self.Entity:ConnectEvent(TouchEvent, self.OnTouched)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		-- 몬스터 위에 겹친 오브젝트는 눌리면 안 된다(유저 리포트 2026-09-08: "몬스터 누르면 맵에
		-- 오브젝트도 눌려") — 이 자리에 몬스터 스프라이트가 있으면 터치를 몬스터에게 양보한다
		if _CardManager:IsMonsterUnderTouch(event.TouchPoint) then return end
		-- 게임오버 팝업이나 타이틀(로비) 화면이 떠 있는 동안은 뒤에 있는 월드 오브젝트가 눌리면 안 된다 —
		-- UI의 CanvasGroup.BlocksRaycasts는 UI 레이어끼리만 막고 월드 스페이스 TouchReceiveComponent는
		-- 별도 경로라 막히지 않으므로(실측 확인), 여기서 직접 게이트한다.
		if _GameManager.GameOver then return end
		if _TitleUI.titleGroup.Enable then return end
		-- 터치 시 서버에 개봉을 요청한다
		self:RequestOpen()
	end

	@ExecSpace("Server")
	method void RequestOpen()
		-- 이미 열렸으면 중복 요청 무시 (여러 번 터치해도 카드가 한 번만 드롭되도록)
		if self._opened then return end
		self._opened = true
		_AchievementLogic:OnTreasureChestOpened()
		self:PlayOpen()
		-- 이스터에그 튜토리얼이 이 오브젝트를 가리키고 있었다면 여기서 끝난다(TutorialLogic.NotifyEggObjectOpened)
		_TutorialLogic:NotifyEggObjectOpened(self.Entity.Path)
		-- CardManager.OnTreasureBoxOpened는 파라미터 이름이 worldPos일 정도로 월드 좌표를 기대한다
		-- (내부에서 _UILogic:WorldToScreenPosition으로 화면 좌표 변환). 이 상자가 Zone12처럼
		-- 오프셋을 가진 컨테이너 밑에 있으면(또는 유저가 Maker에서 상자를 옮기면) Position(로컬)과
		-- WorldPosition이 달라져서, 로컬 좌표를 넘기면 화면 밖 엉뚱한 곳으로 환산되어 드롭 연출이
		-- 아예 안 보이는 버그가 있었다.
		-- 상자는 항상 바닥에 있으므로 fallHeight=0 고정(groundWorldY는 미사용). 몬스터가 아니라
		-- 고정된 월드 오브젝트라 거리에 따른 깊이 스케일 개념이 없으므로 dropScale은 항상 1.0(원래 크기).
		-- 엘리트 드롭(OnEliteKilled, 최대 3개+빈 풀 시 골드)과 달리 상자 전용 룰(최대 2개+빈 풀 시 하얀 포션)을 쓴다
		local wp = self.Entity.TransformComponent.WorldPosition
		if self.RewardMode == "skillPotion" then
			-- 빨간 포션 1개(ApplyPotionDrop potionType 1) + 슬롯 스킬 1개(Ep1TouchEasterEggLogic "skill"과 같은 경로)
			-- 이 오브젝트는 공중에 떠 있어서 fallHeight=0이면 제자리 근처에서 멈춘다(유저 리포트 2026-09-17 "바닥까지 착지").
			-- 공중몹 사망 드롭(MonsterAI.GetLootDropFallParams)과 같은 방식 — 아래로 레이캐스트해서 바로 밑 발판에 착지.
			-- fallHeight는 UI px 근사(월드 1 = 100)
			local groundY = wp.y
			local fallHeight = 0
			local map = self.Entity.CurrentMap
			if map ~= nil then
				---@type FootholdComponent
				local foothold = map:GetComponent("FootholdComponent")
				if foothold ~= nil then
					local hits = foothold:RaycastAll(Vector2(wp.x, wp.y), Vector2(0, -1), 50)
					local bestDist = nil
					for i = 1, #hits do
						local y = hits[i]:GetYByX(wp.x)
						local dist = wp.y - y
						if dist >= 0 and (bestDist == nil or dist < bestDist) then
							bestDist = dist
							groundY = y
						end
					end
					if wp.y > groundY then fallHeight = (wp.y - groundY) * 100 end
				end
			end
			_GameManager:ApplyPotionDrop(1, wp, fallHeight, groundY, 1.0)
			local pool = _CardManager:BuildActiveUpgradePool()
			if #pool > 0 then
				_CardManager:GrantCardUpgradesFromPool(pool, wp, fallHeight, groundY, 1.0, 1, 0)
			end
			log("TreasureChestEgg: " .. self.Entity.Name .. " opened -> red potion + slot skill (pool=" .. #pool .. ", fall " .. string.format("%.2f", wp.y) .. " -> " .. string.format("%.2f", groundY) .. ")")
			-- 덤(유저 지정 2026-09-18): 버프 포션 5% / 다이아 5%
			_EasterEggBonusLogic:RollBonus(wp, fallHeight, groundY)
		else
			_CardManager:OnTreasureBoxOpened(wp, 0, wp.y, 1.0)
			_EasterEggBonusLogic:RollBonus(wp, 0, wp.y)
		end
		-- 예전엔 Entity:Destroy()로 영구 삭제해서 "다시하기"를 해도 상자가 다시 안 생겼다(유저 리포트
		-- 2026-09-13). 이제 열림 연출만 잠깐 보여준 뒤 Enable=false로 숨기고, ResetChest()에서 되살린다
		-- (Ep2Map1ChestEasterEggLogic과 같은 방식)
		self._openToken = self._openToken + 1
		local token = self._openToken
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			if self._openToken ~= token or not self._opened then return end
			self.Entity.Enable = false
			if isvalid(self.extraEntity) then self.extraEntity.Enable = false end
		end, self.DieDuration + 0.3)
	end

	@ExecSpace("Multicast")
	method void PlayOpen()
		if self:IsServer() then return end
		local renderer = self.Entity.SpriteRendererComponent
		if renderer ~= nil then renderer.SpriteRUID = self.DieRUID end
	end

	@ExecSpace("ServerOnly")
	method boolean ResetChest()
		-- TreasureChestEggRegistry.ResetForNewRun()이 호출 — 열렸던 상자만 닫힌 채로 되돌린다. 되돌렸으면 true
		if not self._opened then return false end
		self._opened = false
		self._openToken = self._openToken + 1
		self.Entity.Enable = true
		if isvalid(self.extraEntity) then self.extraEntity.Enable = true end
		self:PlayReset()
		return true
	end

	@ExecSpace("Multicast")
	method void PlayReset()
		-- 클라에서 열림 스프라이트(PlayOpen)로 바꿔둔 걸 닫힌 스프라이트로 되돌린다
		if self:IsServer() then return end
		local renderer = self.Entity.SpriteRendererComponent
		if renderer ~= nil then renderer.SpriteRUID = self.StandRUID end
	end

	method void OnEndPlay()
		if self:IsClient() and self._touchHandler ~= nil then
			self.Entity:DisconnectEvent(TouchEvent, self._touchHandler)
			self._touchHandler = nil
		end
	end

end
