@Logic
script TreasureChestEggRegistry extends Logic

	-- 맵에 놓인 보물상자(TreasureChestEgg — map11 상자, map11 Zone12 상자, map12 상자 등) 목록.
	-- 상자마다 서버 OnBeginPlay에서 자기 자신을 등록하고, "다시하기"(GameManager.RestartGame)에서
	-- ResetForNewRun()이 등록된 상자를 전부 다시 닫힌 채로 되돌린다(유저 지정 2026-09-13: "다시하기하면
	-- 다시 있어야지"). 새 상자를 맵에 추가해도 여기를 고칠 필요 없다 — 경로를 하드코딩하지 않는다.
	property any _chests = {}

	@ExecSpace("ServerOnly")
	method void Register(any chest)
		-- TreasureChestEgg.OnBeginPlay(서버)가 호출. 같은 상자가 두 번 등록되지 않게 막는다
		for _, c in ipairs(self._chests) do
			if c == chest then return end
		end
		table.insert(self._chests, chest)
	end

	@ExecSpace("ServerOnly")
	method void ResetForNewRun()
		-- GameManager.RestartGame()이 호출 — 열려서 숨겨진 상자를 다시 닫힌 채로 보이게 한다
		local restored = 0
		for _, chest in ipairs(self._chests) do
			if isvalid(chest) and chest:ResetChest() then restored = restored + 1 end
		end
		log("TreasureChestEggRegistry: reset " .. restored .. "/" .. #self._chests .. " chests")
	end

end
