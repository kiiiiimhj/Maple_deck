@Component
script Ep2Map2ArenaRetryTrigger extends Component

	property any _touchHandler = nil

	method void OnBeginPlay()
		if self:IsClient() then
			self._touchHandler = self.Entity:ConnectEvent(TouchEvent, self.OnTouched)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		self:RequestRetry()
	end

	@ExecSpace("Server")
	method void RequestRetry()
		_Ep2Map2ArenaLogic:OnRetryClicked()
	end

	method void OnEndPlay()
		if self:IsClient() then
			if self._touchHandler ~= nil then self.Entity:DisconnectEvent(TouchEvent, self._touchHandler) end
		end
	end

end