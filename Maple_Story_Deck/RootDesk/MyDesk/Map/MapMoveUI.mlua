@Logic
script MapMoveUI extends Logic

	-- UI 바인딩 (클라이언트 전용)
	property ButtonComponent btnMapLeft = "0e741f46-3a04-4117-be4d-54aa6898a335"
	property ButtonComponent btnMapRight = "4489416c-b03d-4478-bc37-514ac3a40990"
	property ButtonComponent btnMapUp = "2c899ef8-3dfd-49aa-ad4d-0ad3fa2e0d46"
	property ButtonComponent btnMapDown = "ebf77f70-837b-4ae3-a13d-5bb9f8d84b51"

	-- 맵4 이상 잠금 표시용 자물쇠 아이콘 / ">" 텍스트 (BtnMapRight의 자식/자기자신 컴포넌트)
	property SpriteGUIRendererComponent lockIcon = "cbd1ed65-3756-41a9-8e89-4bec9ecc3778"
	property TextComponent rightArrowText = "4489416c-b03d-4478-bc37-514ac3a40990"

	property any _leftHandler = nil
	property any _rightHandler = nil
	property any _upHandler = nil
	property any _downHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self._leftHandler = self.btnMapLeft.Entity:ConnectEvent(ButtonClickEvent, self.OnLeftClicked)
		self._rightHandler = self.btnMapRight.Entity:ConnectEvent(ButtonClickEvent, self.OnRightClicked)
		self._upHandler = self.btnMapUp.Entity:ConnectEvent(ButtonClickEvent, self.OnUpClicked)
		self._downHandler = self.btnMapDown.Entity:ConnectEvent(ButtonClickEvent, self.OnDownClicked)
		self:UpdateLockVisual()
		self:UpdateButtonVisibility(_MapManager.CurrentMapIndex)
		log("MapMoveUI started")
	end

	-- GameManager.OnBossDefeated() / MapManager.DoMapChange()가 각각 호출 — OnSyncProperty는 자기 자신의
	-- @Sync 프로퍼티 변경에만 반응하고 다른 스크립트(GameManager/MapManager)의 동기화는 감지하지 못해서
	-- 명시적으로 알려줘야 한다
	-- bossDefeated를 파라미터로 직접 받는다 — GameManager.BossDefeated의 @Sync 전파와 이 Multicast 호출은
	-- 서로 다른 채널이라 순서 보장이 없어서, 여기서 다시 _GameManager.BossDefeated를 읽으면 아직 갱신 전
	-- (false) 값을 볼 수 있어 자물쇠가 즉시 갱신되지 않는다
	@ExecSpace("Multicast")
	method void NotifyBossDefeated(boolean bossDefeated)
		if not self:IsClient() then return end
		local showLock = (self:GetLocalZoneIndex(_MapManager.CurrentMapIndex) == 3) and (not bossDefeated)
		self:ApplyLockState(showLock)
		log("MapMoveUI: NotifyBossDefeated bossDefeated=" .. tostring(bossDefeated) .. " showLock=" .. tostring(showLock))
	end

	-- Zone15PuzzleLogic.OnSwitchTouched()가 정답을 다 맞췄을 때 호출 — 지금 존15에 있는 클라이언트라면
	-- 자물쇠를 즉시 ">"로 바꿔준다(IsSolved의 @Sync 전파를 기다리지 않고 명시적으로 알려줌 — 위 두
	-- Notify*와 동일한 이유)
	@ExecSpace("Multicast")
	method void NotifyZone15Solved()
		if not self:IsClient() then return end
		if _MapManager.CurrentMapIndex ~= 15 then return end
		self:ApplyLockState(false)
		log("MapMoveUI: NotifyZone15Solved")
	end

	-- mapIndex를 파라미터로 직접 받는다 — CurrentMapIndex의 @Sync 전파와 이 Multicast 호출은 서로 다른
	-- 채널이라 순서 보장이 없어서, 여기서 다시 _MapManager.CurrentMapIndex를 읽으면 아직 갱신 전(이전
	-- 값)을 볼 수 있다
	@ExecSpace("Multicast")
	method void NotifyMapChanged(integer mapIndex)
		if not self:IsClient() then return end
		local showLock = false
		if self:GetLocalZoneIndex(mapIndex) == 3 then
			showLock = _GameManager.Level < 5
		elseif mapIndex == 15 then
			showLock = not _Zone15PuzzleLogic.IsSolved
		end
		self:ApplyLockState(showLock)
		self:UpdateButtonVisibility(mapIndex)
	end

	-- MapManager.MoveToMap의 레벨5 잠금과 동일한 환산 — 에피1은 그대로, 에피2(내부 mapIndex 45~54)는
	-- 44를 빼서 "그 에피소드 안에서 몇 번째 존인지"로 되돌린다. 자물쇠 표시 기준(mapIndex==3)이
	-- 실제 잠금 기준과 반드시 같은 값을 봐야 한다.
	@ExecSpace("ClientOnly")
	method integer GetLocalZoneIndex(integer mapIndex)
		if mapIndex >= 45 then return mapIndex - 44 end
		return mapIndex
	end

	-- 맵6/존19/존40/map1존5(49)에만 "위로" 버튼(맵6에선 맵7 진입, 존19에선 존15 복귀, 존40에선 존29 복귀,
	-- map1존5(49)에선 map2존5(59)로 직행 — 유저 지정: "map2가 꼭대기고 그 아래층이 map1"이라 map1→map2가
	-- 위로 올라가는 방향), 맵7/존15/존29/map2존5(59)에만 "아래로" 버튼(맵7에선 맵6 복귀, 존15에선 그룹G/존19
	-- 직행, 존29에선 그룹L/존40 직행, map2존5(59)에선 map1존5(49)로 복귀). 존19에는 그림자 상점(존18) 복귀용
	-- 버튼을 일부러 두지 않는다 — 존18은 존15에서 횟불 3개를 켜야 풀리는 ">" 정공법으로만 들어가야 하고,
	-- 그룹G/I(존19~30) 쪽에서 되돌아가는 백도어가 있으면 그 퍼즐 게이트를 우회하게 된다. 같은 이유로 존18
	-- 자신도 ">"가 없어야 한다 — 존18은 막다른 길(그림자 상점)이고, "<"로만 존17로 돌아나갈 수 있다.
	@ExecSpace("ClientOnly")
	method void UpdateButtonVisibility(integer mapIndex)
		-- 맵21(mapIndex==35)은 존1~34 순환 밖의 비밀 구역(택시 이스터에그) — 일반 좌/우 이동 버튼은
		-- 여기서 의미가 없으므로 둘 다 숨긴다. 복귀는 Map21RelicEasterEgg의 전용 "<" 버튼(실피드를
		-- 이미 획득했을 때만 노출)으로만 한다.
		if isvalid(self.btnMapUp) then self.btnMapUp.Entity.Enable = (mapIndex == 6 or mapIndex == 19 or mapIndex == 40 or mapIndex == 49 or mapIndex == 79) end
		if isvalid(self.btnMapDown) then self.btnMapDown.Entity.Enable = (mapIndex == 7 or mapIndex == 15 or mapIndex == 29 or mapIndex == 59 or mapIndex == 69) end
		-- map1 존1(mapIndex==45)은 map2 존10(64)의 ">"로만 도달하는 순환 고리의 시작점이라 "<"가 어디로도
		-- 갈 곳이 없다(유저 지정 — "버튼은 안 쓰니깐 숨겨주면 좋겠네") — 존7/존35와 동일하게 숨긴다.
		-- 존85(ep2_map2_hidden 존1)도 숨긴다 — 유저 지정: "여기 나가는길은 없고 시간이 끝나면 자동으로
		-- 복귀". 이 히든존은 나가는 경로가 없다(3분 타이머 만료 시 Ep2Map2HiddenExpBoostLogic이 자동
		-- 복귀시킨다) — "<" 버튼 자체가 무의미해서 숨긴다. 서버 쪽 차단은 MapManager.MoveByDelta 참고.
		if isvalid(self.btnMapLeft) then self.btnMapLeft.Entity.Enable = (mapIndex ~= 7 and mapIndex ~= 35 and mapIndex ~= 45 and mapIndex ~= 85) end
		-- 존88(ep2_map2_hidden 존4)도 히든존의 끝(막다른 길)이라 ">"를 숨긴다 — MapManager.MoveByDelta의
		-- "actualIndex==88 and delta==1" 차단과 짝이다.
		if isvalid(self.btnMapRight) then self.btnMapRight.Entity.Enable = (mapIndex ~= 18 and mapIndex ~= 35 and mapIndex ~= 88) end
	end

	@ExecSpace("ClientOnly")
	method void UpdateLockVisual()
		-- 자물쇠는 (a) 지금 맵3에 있고 아직 보스를 못 잡았을 때, 또는 (b) 존15에 있고 아직 불꽃
		-- 이스터에그를 못 풀었을 때만 보여준다. 그 외 맵은 항상 ">"가 맞다
		local mapIndex = _MapManager.CurrentMapIndex
		local showLock = false
		if self:GetLocalZoneIndex(mapIndex) == 3 then
			showLock = _GameManager.Level < 5
		elseif mapIndex == 15 then
			showLock = not _Zone15PuzzleLogic.IsSolved
		end
		self:ApplyLockState(showLock)
	end

	@ExecSpace("ClientOnly")
	method void ApplyLockState(boolean showLock)
		if isvalid(self.lockIcon) then self.lockIcon.Enable = showLock end
		if isvalid(self.rightArrowText) then self.rightArrowText.Enable = not showLock end
	end

	@ExecSpace("ClientOnly")
	method void OnLeftClicked()
		_MapManager:RequestMoveLeft()
	end

	@ExecSpace("ClientOnly")
	method void OnRightClicked()
		-- 존15 자물쇠가 걸려있는 동안 ">"를 누르면 이동 대신 힌트 토스트만 띄운다
		if _MapManager.CurrentMapIndex == 15 and not _Zone15PuzzleLogic.IsSolved then
			_UIToast:ShowMessage("불꽃과 기둥은 답을 알고있다")
			return
		end
		_MapManager:RequestMoveRight()
	end

	-- 맵6→7 전용 경로. 우측 이동 버튼(RequestMoveRight)은 맵6에서 이제 맵11(해변 존)로 분기하므로,
	-- 맵7 진입은 더 이상 그 함수와 공유하지 않고 RequestMoveToMap7로 분리되어 있다.
	-- 존19에서는 같은 버튼을 존15 복귀 전용 경로로 가로챈다(존15의 "아래로" 버튼과 대칭되는 재사용 패턴).
	-- 존40에서는 같은 버튼을 존29 복귀 전용 경로로 가로챈다(존29의 "아래로" 버튼과 대칭되는 재사용 패턴,
	-- 유저 지정). map1존5(49)에서는 같은 버튼을 map2존5(59) 직행 경로로 가로챈다(유저 지정 — "map2가
	-- 꼭대기고 그 아래층이 map1"이라 위로 올라가는 방향이 map2로 이어진다).
	@ExecSpace("ClientOnly")
	method void OnUpClicked()
		if _MapManager.CurrentMapIndex == 19 then
			_MapManager:RequestMoveToZone15()
			return
		end
		if _MapManager.CurrentMapIndex == 40 then
			_MapManager:RequestMoveToZone29()
			return
		end
		if _MapManager.CurrentMapIndex == 49 then
			_MapManager:RequestMoveToMap2Zone5()
			return
		end
		if _MapManager.CurrentMapIndex == 79 then
			_MapManager:RequestMoveToMap3Zone5()
			return
		end
		_MapManager:RequestMoveToMap7()
	end

	-- 맵7→6은 인덱스상 -1이라 RequestMoveLeft와 동일한 이동이지만, "아래로"라는 별도 버튼으로 노출한다.
	-- 존15에서는 같은 버튼을 그룹G(존19) 직행 분기로 가로챈다(맵6의 "위로" 버튼과 동일한 재사용 패턴).
	-- 존29에서는 같은 버튼을 그룹L(존40) 직행 분기로 가로챈다(유저 지정). map2존5(59)에서는 같은 버튼을
	-- map1존5(49) 복귀 경로로 가로챈다(OnUpClicked의 map1존5 분기와 대칭되는 역방향).
	@ExecSpace("ClientOnly")
	method void OnDownClicked()
		if _MapManager.CurrentMapIndex == 15 then
			_MapManager:RequestMoveToZone19()
			return
		end
		if _MapManager.CurrentMapIndex == 29 then
			_MapManager:RequestMoveToZone40()
			return
		end
		if _MapManager.CurrentMapIndex == 59 then
			_MapManager:RequestMoveToMap1Zone5()
			return
		end
		if _MapManager.CurrentMapIndex == 69 then
			_MapManager:RequestMoveToMap4Zone5()
			return
		end
		_MapManager:RequestMoveLeft()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._leftHandler then self.btnMapLeft.Entity:DisconnectEvent(ButtonClickEvent, self._leftHandler) end
		if self._rightHandler then self.btnMapRight.Entity:DisconnectEvent(ButtonClickEvent, self._rightHandler) end
		if self._upHandler then self.btnMapUp.Entity:DisconnectEvent(ButtonClickEvent, self._upHandler) end
		if self._downHandler then self.btnMapDown.Entity:DisconnectEvent(ButtonClickEvent, self._downHandler) end
	end

end
