@Logic
script MapTaxiLogic extends Logic

	-- 존20(map20) object-1228_1을 처음 눌렀는지 — 클라이언트(MapTaxiTrigger)가 이 값을 보고 소환
	-- 연출을 재생할지 결정하므로 @Sync 필요. 처음 눌렀을 때만 연출을 재생하고, 그 뒤로는 매번
	-- 티켓 확인으로 바로 간다.
	@Sync property boolean Summoned = false

	property string TicketItemId = "unknown_ticket"

	-- 맵21 착지 지점 — 다른 맵 전환(MapManager.SpawnPosition)과 동일하게 y=0.2에서 시작해 중력으로
	-- 실제 발판(x=0 기준 y=-0.70 폭 -1.35~1.35)에 자연스럽게 떨어져 안착한다
	property Vector3 Map21SpawnPos = Vector3(0, 0.2, 0)

	@ExecSpace("ServerOnly")
	method void OnTaxiTouched()
		-- object-1228_1을 두 번 눌러야 실제로 이동한다: 1번째=연출만, 2번째부터=티켓 확인+이동.
		-- 연출 자체는 MapTaxiTrigger(클라이언트, self.Entity 직접 사용)가 재생한다.
		if not self.Summoned then
			self.Summoned = true
			log("MapTaxiLogic: taxi summoned")
			return
		end
		self:TryBoardTaxi()
	end

	@ExecSpace("ServerOnly")
	method void TryBoardTaxi()
		if _PlayerInventory:GetItemCount(self.TicketItemId) <= 0 then
			_UIToast:ShowMessage("티켓이 없습니다!")
			log("MapTaxiLogic: no ticket, blocked")
			return
		end
		_PlayerInventory:AddItem(self.TicketItemId, -1)
		log("MapTaxiLogic: ticket consumed, traveling to map21")
		self:TravelToMap21()
	end

	@ExecSpace("ServerOnly")
	method void TravelToMap21()
		-- 떠나는 맵의 몬스터를 일시정지시켜야 한다 — MapManager의 모든 맵 이동(DoMapChange/
		-- DoScrollMapChange/SilentMoveToMap)이 공통으로 하는 처리인데 여기서 빠뜨렸었다. 안 하면
		-- 화면 밖(이전 맵)에 남은 몬스터가 접근/공격 타이머를 계속 돌려 맵21(몬스터 없음)에 있는데도
		-- 대미지가 들어오는 버그가 생긴다(유저 실측 확인). 맵21은 몬스터가 없으므로 도착 맵 재개는 불필요.
		local oldMapEntity = _MonsterSpawner:GetZoneEntity(_MapManager.CurrentMapIndex)
		_MapManager:SetMonstersPaused(oldMapEntity, true)

		-- 위에서 "지금 있는" 몬스터만 멈췄을 뿐, MonsterSpawner.SpawnWave는 계속 주기적으로(4~6초마다)
		-- _MapManager.CurrentMapIndex를 그대로 믿고 새 몬스터를 스폰한다 — CurrentMapIndex를 안
		-- 바꾸면 존 시스템 밖(맵21)에 가 있는 동안에도 "플레이어가 아직 여기 있다"고 오판해서
		-- 새로 태어나는 몬스터를 계속 미일시정지 상태로 만든다(SpawnBatchOnMap의 isCurrentMap 분기 —
		-- 유저 재실측 확인: 몬스터 일시정지를 넣었는데도 계속 공격받는 원인이 바로 이것이었다).
		-- 35(MapManager.ZoneInfo의 맵21 전용 조회 항목)로 돌려서 GetCurrentMap()이 실제로 존재하는
		-- 맵21 엔티티를 가리키게 한다 — 0처럼 존재하지 않는 파일로 떨어지는 값을 쓰면 GetCurrentMap이
		-- nil을 반환해 "어디 있는지 모르면 전부 활성 취급"하는 안전장치가 오히려 발동해버린다(실측
		-- 재현 — 존재하지 않는 맵 인덱스를 쓰는 것보다 더 나쁜 결과였다). 맵21→맵20 복귀
		-- (Map21RelicEasterEgg.AcquireAndTravel)에서 34로 다시 정상 값을 채운다.
		_MapManager.CurrentMapIndex = 35

		-- 존 이동(MapManager.DoMapChange)과 동일한 검은 와이프 전환 패턴을 그대로 재사용한다
		_MapTransitionLogic:PlayCover("right")
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			for _, userEntity in pairs(_UserService.UserEntities) do
				_TeleportService:TeleportToMapPosition(userEntity, self.Map21SpawnPos, "map21")
			end
			_TimerService:SetTimerOnce(function()
				if isvalid(self) then _MapTransitionLogic:PlayReveal("right") end
			end, _MapTransitionLogic.CameraSettleDelay)
		end, _MapTransitionLogic.CoverDuration)
	end

end
