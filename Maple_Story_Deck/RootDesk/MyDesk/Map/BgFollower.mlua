@Component
script BgFollower extends Component

	-- (monster_screen_pos - 0.5) * image_height_WU = (0.91 - 0.5) * 9.36 = 3.84
	property number CameraYOffset = 3.84

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local pTf = player:GetComponent("MOD.Core.TransformComponent")
		if pTf == nil then return end
		local myTf = self.Entity:GetComponent("MOD.Core.TransformComponent")
		myTf.Position = Vector3(pTf.Position.x, pTf.Position.y + self.CameraYOffset, myTf.Position.z)
	end

end
