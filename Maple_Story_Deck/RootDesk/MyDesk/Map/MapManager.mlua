@Logic
script MapManager extends Logic

	-- 현재 플레이어가 있는 맵 번호 (map01~03 = 1~3)
	@Sync property integer CurrentMapIndex = 1

	property integer MinMapIndex = 1
	-- 맵11(해변 존)이 맵6의 우측 분기로 추가되면서, 그리고 맵12가 맵11의 순차적 연장으로 추가되면서
	-- 스폰/정리 루프(SpawnWave, ClearAllMonsters 등)가 도는 범위에 11~12도 포함되도록 12로 올린다.
	-- 맵10→11 방향의 일반 순차 이동은 MoveByDelta에서 별도로 막아, "10 다음이 11"이 아니라
	-- "6의 분기가 11"이라는 의도를 유지한다. 반면 11→12는 진짜 순차 연장이라 별도 분기 없이
	-- 일반 델타(+1/-1) 이동으로 자연스럽게 처리된다.
	-- 그룹E(맵13~15, 개미굴 테마)가 맵12의 순차적 연장으로 추가되면서 15로 올린다. 12→13은 물리적으로
	-- 다른 파일(map11→map13)이라 GetMapName이 다른 값을 반환하므로, MoveToMap의 "같은 파일이면 스크롤"
	-- 분기를 타지 않고 자동으로 기존 와이프 전환(DoMapChange)을 탄다 — 6→11 같은 별도 delta 분기가 필요 없다.
	-- 그룹F(존16~18, 그림자 존)가 존15 이스터에그를 풀어야 열리는 다음 단계로 추가되면서 18로 올린다.
	-- map13을 덤프해서 만든 map16.map 하나를 host로 존17/18을 Zone17/Zone18 자식 컨테이너로 병합한다
	-- (그룹A/B/C/E와 동일한 패턴). MapMoveUI가 존15에서 ">'를 잠가두므로 경계값을 올린 것만으로
	-- 실수로 먼저 뚫리지는 않는다.
	-- 그룹G(존19~22)가 추가되면서 22로 올린다. 유저가 전체 맵을 덤프해서 만든 map17.map 하나를 host로
	-- 존20/21/22를 Zone20/Zone21/Zone22 자식 컨테이너로 병합한다(그룹A/B/C/E/F와 동일한 패턴). 물리 파일명
	-- "map17"과 논리 존 번호가 겹치지 않도록(존17/18은 이미 그룹F/map16이 사용 중) 19~22로 배정했다.
	-- map17.map 안에 유저가 미리 만들어둔 Zone17/Zone18 컨테이너(스폰X 15.5/31.0 기준으로 이미 정확히
	-- 배치돼 있었음)를 Zone20/Zone21로 리네임하고 Zone22(스폰X 46.5)를 추가로 생성했다. 아직 다른 게임
	-- 시스템(MonsterSpawner 존별 몬스터풀, MapMoveUI 이동 경로 등)에는 연결하지 않았다 — 맵 작업 범위만.
	-- 그룹H(존23~26)가 추가되면서 26으로 올린다. 유저가 map17.map을 다시 덤프해서 만든 map18.map을 host로
	-- 존24/25/26을 자식 컨테이너로 병합한다(그룹G와 동일한 4존 패턴 — 덤프 원본에 이미 Zone20/21/22라는
	-- 이름의 컨테이너가 스폰X 15.5/31.0/46.5로 정확히 박혀있었는데, 이건 map17 그룹G의 옛 이름이 그대로
	-- 복사된 것이라 새 존 번호(24/25/26)에 맞게 리네임만 했다). 22→23은 물리 파일이 달라(map17≠map18)
	-- MoveToMap이 자동으로 와이프 전환을 타므로 존15→19 같은 별도 skip 분기가 필요 없다 — 그냥 순차 델타로 연결된다.
	-- 그룹I(존27~30)가 추가되면서 30으로 올린다. 유저가 새로 만든 map19.map을 host로 존28/29/30을
	-- Zone28/Zone29/Zone30 자식 컨테이너로 병합한다. 존26까지의 순차 연장이 아니라 존19에서 갈라지는
	-- 별도 곁가지(스퍼)라, 그룹D(존6→11)와 동일하게 MoveByDelta에 전용 분기를 추가했다 — 아래 MoveByDelta 참고.
	-- 그룹J(존31~34, 정글 컨셉: 루팡/호돌이/바나나갈매기/좀비루팡)가 추가되면서 34로 올린다. 유저가 새로
	-- 만든 map20.map을 host로 존32/33/34를 Zone32/Zone33/Zone34 자식 컨테이너로 병합한다(덤프 원본엔
	-- 그룹H의 옛 이름 Zone24/25/26이 그대로 복사돼 있어 새 존 번호에 맞게 리네임만 했다). 그룹I와 달리
	-- 이번엔 존26의 순차 연장으로 이어진다 — 존26의 기본 ">"가 (존19~30 그룹처럼 스퍼로 갈라지지 않고)
	-- 그대로 그룹J로 진입하도록 MoveByDelta에 전용 분기를 추가했다(그룹D/I와 동일한 패턴, 아래 참고) —
	-- 존26+1이 그룹I의 존27로 새는 기본 델타를 덮어써야 하기 때문이다.
	property integer MaxMapIndex = 34

	-- 맵 이동 시 플레이어를 위치시킬 좌표. Y는 DefaultUserEnterLeaveLogic이 원래 스폰시키는 높이(0.2)와
	-- 반드시 맞춰야 한다 — 다르면 카메라가 그 차이만큼 밀려서 몬스터가 화면 아래(UI 위)로 잘못 표시된다
	property Vector3 SpawnPosition = Vector3(0, 0.2, 0)

	-- mapIndex별 물리 파일/자식 컨테이너/스폰 X를 한 곳에서 관리하는 데이터 테이블. 그룹D(11/12) 병합 때는
	-- "if mapIndex==12" 분기가 GetMapName/GetSpawnPositionForIndex(여기)와 MonsterSpawner의
	-- GetZoneEntity/GetZoneOffsetX 4곳에 흩어져 있었는데, 그룹A/B/C로 존이 7개 더 늘어나면 그 방식은
	-- 계속 복사-붙여넣기가 늘어나고 오프셋 적용을 빠뜨리기 쉽다 — 그래서 이 테이블 하나로 통일한다.
	-- file: 물리 .map 파일명(확장자 제외). container: 루트 엔티티 자신이면 nil, 자식 컨테이너면 그 이름.
	-- spawnX: 플레이어/몬스터 스폰 중심 월드 X(병합 안 된 맵은 전부 0).
	property any ZoneInfo = nil

	-- MonsterSpawner 등 다른 스크립트가 mapIndex별 물리 위치 정보를 조회할 때 쓰는 단일 진입점.
	-- ZoneInfo 자체는 OnBeginPlay에서 채운다 — OnInitialize에서 채웠더니 이 Logic의 OnBeginPlay보다
	-- 늦게 실행되는 경우가 있어([LEA-2007] ZoneInfo가 nil인 채로 OnBeginPlay가 GetMapName을 호출) 실측으로
	-- 확인 후 옮김. MonsterSpawner._activeMaps와 동일하게 "OnBeginPlay 맨 앞에서 초기화" 패턴을 따른다.
	method any GetZoneInfo(integer mapIndex)
		return self.ZoneInfo[mapIndex]
	end

	-- 네이티브 기본 줌(100)이면 맵 가장자리(발판/배경이 끝나는 지점)에서 카메라가 그 바깥의 빈 공간을
	-- 살짝 비춰서 검은 틈이 보인다 — 유저가 Maker에서 마우스 휠로 살짝 줌아웃하니 사라짐을 확인. 플레이어는
	-- IsAllowZoomInOut=false라 스스로 조절할 수 없으므로, 게임 시작 시점에 기본값을 살짝 더 줌아웃된 값으로
	-- 고정한다(값이 크면 더 줌아웃 — CameraComponent.d.mlua ZoomRatioMin=30/Max=500/기본=100).
	property number DefaultZoomRatio = 115

	-- 존 스크롤 전환(DoScrollMapChange) 때 카메라가 옆으로 따라붙는 속도 — 네이티브 기본값(2.5, 5.0)이
	-- 너무 느리다는 피드백으로 낮췄다(작을수록 더 빠르게 반응 — CameraComponent.d.mlua Damping 설명 참고).
	-- ResetCameraConfine()이 게임 시작 + 매 스크롤 전환마다 호출되므로 여기 한 곳만 바꾸면 전부 적용된다.
	property Vector2 ScrollCameraDamping = Vector2(1.2, 2.0)

	-- SilentMoveToMap 전용 Damping 임시 저장값 (0.001로 낮췄다가 짧게 복구)
	property Vector2 _savedSilentMoveDamping = Vector2(2.5, 5.0)
	property boolean _silentMoveDampingSaved = false
	property number SilentMoveDampingRestoreDelay = 0.1

	-- 게임을 시작할 맵 번호. DefaultUserEnterLeaveLogic.StartPoint(Maker 전용 설정, 기본 /maps/map01)를
	-- 직접 바꾸기 전까지의 코드측 임시 우회 — 유저 접속이 확인되는 즉시 이 맵으로 이동시킨다
	property integer DesiredStartMapIndex = 1

	property boolean _startRedirectDone = false

	-- 맵 인덱스 → 파일/엔티티 이름 변환. ZoneInfo 테이블 기반 — 두 인덱스가 같은 파일 이름을 반환하는
	-- 것 자체가 "같은 물리 맵(스크롤 전환 대상)"이라는 판정 기준이 된다(MoveToMap에서 사용).
	method string GetMapName(integer mapIndex)
		local info = self.ZoneInfo[mapIndex]
		if info == nil then return string.format("map%02d", mapIndex) end
		return info.file
	end

	-- 존별 스폰 X는 ZoneInfo.spawnX에서 가져온다(병합 안 된 맵은 0). Y/Z는 공통 SpawnPosition을 그대로 쓴다 —
	-- "카메라 고정 앵글"을 위해 그룹 내 모든 존이 같은 지면 Y를 공유해야 하므로(그룹A/B/C 설계 문서 참고),
	-- 존마다 Y를 따로 두지 않고 항상 SpawnPosition.y 하나로 통일한다.
	method Vector3 GetSpawnPositionForIndex(integer mapIndex)
		local info = self.ZoneInfo[mapIndex]
		local x = (info ~= nil) and info.spawnX or 0
		return Vector3(x, self.SpawnPosition.y, self.SpawnPosition.z)
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self.ZoneInfo = {
			-- 그룹A(맵1~3) 병합: map01.map을 host로 map02/03을 Zone02/Zone03 자식 컨테이너로 병합.
			-- 발판폭(14.16) + 버퍼로 spawnX를 공식 계산(15.5, 31.0 — 타일 그리드 정수 정렬을 위해
			-- 0.5 단위로 반올림). 맵1/2/3은 지면 Y가 전부 -1.35로 동일해서 Y 정렬이 필요 없었다.
			[1] = { file = "map01", container = nil, spawnX = 0 },
			[2] = { file = "map01", container = "Zone02", spawnX = 15.5 },
			[3] = { file = "map01", container = "Zone03", spawnX = 31.0 },
			-- 그룹B(맵4~6) 병합: map04.map을 host로 map05/06을 Zone05/Zone06 자식 컨테이너로 병합.
			-- 발판폭(14.3) + 버퍼로 spawnX 공식 계산(15.5, 31.0). 맵4/5/6도 지면 Y가 전부 -1.22로
			-- 동일해서 Y 정렬 불필요(밴드가 있는 위쪽 발판 높이만 다름 — 그건 스폰 로직에서 별도 처리됨).
			[4] = { file = "map04", container = nil, spawnX = 0 },
			[5] = { file = "map04", container = "Zone05", spawnX = 15.5 },
			[6] = { file = "map04", container = "Zone06", spawnX = 31.0 },
			-- 그룹C(맵7~10) 병합: map07.map을 host로 map08/09/10을 Zone08/Zone09/Zone10 자식 컨테이너로
			-- 병합. 발판폭(14.14) + 버퍼로 spawnX 공식 계산(15.5, 31.0, 46.5 — A/B와 동일 값 재사용).
			-- 맵7/8/9는 지면 Y가 -1.18로 동일했지만 맵10만 -1.25로 달라서, 병합 시 맵10의 발판/타일/장식
			-- 전체를 +0.07만큼 Y-shift해서 공통 기준선(-1.18)에 맞췄다 — "카메라 고정 앵글" 요구사항 때문.
			[7] = { file = "map07", container = nil, spawnX = 0 },
			[8] = { file = "map07", container = "Zone08", spawnX = 15.5 },
			[9] = { file = "map07", container = "Zone09", spawnX = 31.0 },
			[10] = { file = "map07", container = "Zone10", spawnX = 46.5 },
			[11] = { file = "map11", container = nil, spawnX = 0 },
			[12] = { file = "map11", container = "Zone12", spawnX = 15 },
			-- 그룹E(맵13~15) 병합: map13.map을 host로 map14/15를 Zone14/Zone15 자식 컨테이너로 병합.
			-- 발판폭(14.36) + 버퍼로 spawnX 공식 계산(15.5, 31.0 — A/B/C와 동일 값 재사용). 맵13/14/15는
			-- 지면 Y가 전부 -1.25로 동일해서 Y 정렬 불필요(그룹C의 맵10 같은 보정이 필요 없었음).
			[13] = { file = "map13", container = nil, spawnX = 0 },
			[14] = { file = "map13", container = "Zone14", spawnX = 15.5 },
			[15] = { file = "map13", container = "Zone15", spawnX = 31.0 },
			-- 그룹F(존16~18, 그림자 존) 병합: map13을 덤프해서 만든 map16.map을 host로 존17/18을
			-- Zone17/Zone18 자식 컨테이너로 병합. 그룹A/B/C/E와 동일한 오프셋(15.5, 31.0) 재사용.
			-- 존15에서 이스터에그를 풀고 ">'를 누르면 존16으로 온다.
			[16] = { file = "map16", container = nil, spawnX = 0 },
			[17] = { file = "map16", container = "Zone17", spawnX = 15.5 },
			[18] = { file = "map16", container = "Zone18", spawnX = 31.0 },
			-- 그룹G(존19~22) 병합: map17.map(유저가 통째로 덤프해서 만든 맵) 하나를 host로 존20/21/22를
			-- Zone20/Zone21/Zone22 자식 컨테이너로 병합. 발판폭(map17 foothold bounds -7.14~58.44) 기준으로
			-- A/B/C/E/F와 동일한 spawnX(15.5, 31.0, 46.5)를 그대로 재사용 — 유저가 Zone17/18(리네임 전) 컨테이너를
			-- 이미 이 좌표에 맞춰 배치해뒀음을 확인 후 그대로 유지했다.
			[19] = { file = "map17", container = nil, spawnX = 0 },
			[20] = { file = "map17", container = "Zone20", spawnX = 15.5 },
			[21] = { file = "map17", container = "Zone21", spawnX = 31.0 },
			[22] = { file = "map17", container = "Zone22", spawnX = 46.5 },
			-- 그룹H(존23~26) 병합: map18.map(유저가 map17을 다시 덤프해서 만든 맵) 하나를 host로 존24/25/26을
			-- Zone24/Zone25/Zone26 자식 컨테이너로 병합. spawnX는 그룹A/B/C/E/F/G와 동일한 15.5/31.0/46.5 재사용.
			-- 존25(spawnX=31.0)만 예외: 유저가 map17에는 없던 계단식 발판(x=30.66~34.14)을 map18의 이
			-- 자리에 새로 만들어서, 다른 존들과 같은 공통 지면(y=-1.25)이 이 구간엔 더 이상 없다 — 그 높이로
			-- 스크롤 이동하면(DoScrollMapChange가 기본적으로 "이전 존의 Y 그대로 재사용"하므로) 발판 사이
			-- 빈 공간으로 떨어져 맵 밖 세이프티넷에 의해 존23 스폰으로 되돌아가는 버그가 있었다(실측 확인,
			-- 스크린샷으로 위치 확인 후 유저가 "발판은 의도한 지형"이라고 확정). landY로 이 존만 새 발판
			-- 표면 높이(y=-0.65, 실측 foothold Id 76/77의 y)에 착지하도록 명시적으로 지정한다.
			[23] = { file = "map18", container = nil, spawnX = 0 },
			[24] = { file = "map18", container = "Zone24", spawnX = 15.5 },
			[25] = { file = "map18", container = "Zone25", spawnX = 31.0, landY = -0.65 },
			[26] = { file = "map18", container = "Zone26", spawnX = 46.5 },
			-- 그룹I(존27~30) 병합: map19.map(유저가 새로 만든 맵) 하나를 host로 존28/29/30을
			-- Zone28/Zone29/Zone30 자식 컨테이너로 병합. 그룹A~H와 동일한 spawnX(15.5/31.0/46.5)
			-- 재사용 — 발판 범위(-7.09~58.47)가 기존 그룹들과 거의 동일해서 그대로 맞아떨어짐(실측 확인).
			-- 존26까지의 순차 연장이 아니라 존19에서 갈라지는 별도 곁가지(스퍼)다 — 존19의 기본 "<"가
			-- 더 이상 존18(그림자 상점)로 안 돌아가지 않고 이 그룹으로 진입하도록 MoveByDelta에 전용
			-- 분기를 추가했다(그룹D의 존6→11과 동일한 패턴). 존18 복귀 경로는 의도적으로 만들지 않았다 —
			-- 존18은 존15 횟불 퍼즐을 풀어야 열리는 ">" 정공법으로만 들어가야 하고, 존19 이상(그룹G/I)
			-- 쪽에서 되돌아가는 버튼이 있으면 그 게이트를 우회하게 된다(존18 자체도 ">"가 막혀 있음).
			-- 그룹I는 그룹A~H와 달리 지면이 존마다 계단식으로 다르다(RaycastAll 실측: 존27=-0.489,
			-- 존28=-1.089, 존29=-0.489, 존30=-1.089 — 발판 Id 77/16/71/55). DoScrollMapChange는 기본적으로
			-- "이전 존의 Y 그대로 재사용"하는데, 이 그룹은 그 가정이 깨져서 스크롤 이동마다 발판 높이
			-- 차이만큼 순간 낙하해 화면이 튀는 버그가 있었다(존25와 동일한 원인, 유저 재현 확인) — landY로
			-- 존마다 실제 발판 표면 높이를 명시해 강제 착지시킨다. 존27 도착 시(위프 전환, 중력으로 자연
			-- 착지) 실측 y=-0.489로 정확히 일치함을 확인했다 — 이 값들이 진짜 지면이다.
			[27] = { file = "map19", container = nil, spawnX = 0, landY = -0.489 },
			[28] = { file = "map19", container = "Zone28", spawnX = 15.5, landY = -1.089 },
			[29] = { file = "map19", container = "Zone29", spawnX = 31.0, landY = -0.489 },
			[30] = { file = "map19", container = "Zone30", spawnX = 46.5, landY = -1.089 },
			-- 그룹J(존31~34) 병합: map20.map(유저가 새로 만든 맵) 하나를 host로 존32/33/34를
			-- Zone32/Zone33/Zone34 자식 컨테이너로 병합. 발판 범위(-7.08~58.38, 폭 65.46)가 기존 그룹들과
			-- 거의 동일해서 A~I와 동일한 spawnX(15.5/31.0/46.5) 재사용. 지면 Y도 4존 전부 -1.35로 동일함을
			-- 실측 확인(존25/그룹I처럼 존별로 다른 발판 높이가 아니라서 landY 지정이 필요 없다).
			[31] = { file = "map20", container = nil, spawnX = 0 },
			[32] = { file = "map20", container = "Zone32", spawnX = 15.5 },
			[33] = { file = "map20", container = "Zone33", spawnX = 31.0 },
			[34] = { file = "map20", container = "Zone34", spawnX = 46.5 },
		}
		-- 몬스터 스폰/시작맵 리다이렉트는 GameStarted가 될 때까지 미룬다(BeginGameplay 참고) —
		-- 타이틀 화면을 보는 동안 몬스터가 먼저 쌓이면 안 된다. 여기서는 현재 위치만 계산해둔다.
		self.CurrentMapIndex = self:ResolveCurrentMapIndex()
		log("MapManager started at " .. self:GetMapName(self.CurrentMapIndex))
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		if name == "CurrentMapIndex" then
			-- 화면(카메라)이 통째로 바뀌는 시점 — 바닥까지 낙하/홉 중이던 잡템 드롭 아이콘이 있으면
			-- 그 연출을 마저 재생하지 않고 지금 위치에서 곧장 가방으로 날아가게 해서, 이전 화면의
			-- 아이템이 새 화면 위에 그대로 남아있는 것처럼 보이지 않게 한다
			_GameManager:ForceFinishLootDrops()
		end
	end

	-- GameManager.StartGame()이 "게임 시작" 클릭 시 호출 — 여기서 처음으로 몬스터 스폰을 활성화한다
	@ExecSpace("ServerOnly")
	method void BeginGameplay()
		_MonsterSpawner:ActivateMap(self.CurrentMapIndex)
		_MonsterSpawner:BeginGameplay()
		self:ResetCameraConfine()
	end

	-- DesiredStartMapIndex로 1회 리다이렉트. 월드 시작 직후에는 _UserService.UserEntities가 아직
	-- 비어있을 수 있어(OnBeginPlay 시점 유저 미접속) 매 프레임 재시도하다가, 유저가 실제로 확인되는
	-- 첫 프레임에 MoveToMap으로 옮긴다. 이미 원하는 맵이면(또는 나중에 StartPoint를 Maker에서 직접
	-- 고치면) 아무 것도 하지 않고 바로 종료한다.
	-- GameStarted를 기다리지 않는다 — 타이틀 화면이 이미 전체 화면을 가리고 있으므로, 리다이렉트를
	-- 여기서(타이틀 화면 뒤에서) 미리 끝내두면 "게임 시작"을 눌러 타이틀이 사라지는 순간엔 카메라가
	-- 이미 정확한 위치에 자리 잡은 상태다. 예전엔 GameStarted가 될 때까지 기다렸다가 리다이렉트해서,
	-- 타이틀이 사라진 직후 카메라가 새 위치로 따라붙는 움직임이 짧게 보이는 문제가 있었다(실측 확인 —
	-- Damping을 아무리 낮춰도 완전히 없어지지 않았다). 몬스터 스폰 활성화는 별도로 BeginGameplay()가
	-- GameStarted 시점에 맡으므로(SilentMoveToMap 안의 ActivateMap 호출은 GameStarted 가드로 막아둠),
	-- 여기서 미리 이동해도 웨이브가 타이틀 화면 중에 먼저 쌓이는 일은 없다.
	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if self._startRedirectDone then return end
		local hasUser = false
		for _, userEntity in pairs(_UserService.UserEntities) do
			hasUser = true
			break
		end
		if not hasUser then return end
		-- 유저가 실제로 접속한 뒤에야 진짜 위치를 다시 계산한다 — OnBeginPlay 시점엔 아직 아무도
		-- 접속 전이라 ResolveCurrentMapIndex가 항상 MinMapIndex(기본값)로 폴백하는데, 그 값을 그대로
		-- 믿고 비교하면 DesiredStartMapIndex가 우연히 MinMapIndex와 같을 때 리다이렉트가 트리거조차
		-- 안 되는 버그가 있었다(네이티브 DefaultUserEnterLeaveLogic.StartPoint가 다른 맵을 가리켜도
		-- 절대 교정되지 않음 — 실측으로 발견).
		self.CurrentMapIndex = self:ResolveCurrentMapIndex()
		if self.CurrentMapIndex == self.DesiredStartMapIndex then
			self._startRedirectDone = true
			return
		end
		self._startRedirectDone = true
		self:SilentMoveToMap(self.CurrentMapIndex, self.DesiredStartMapIndex)
	end

	-- 게임 시작 리다이렉트 전용: 와이프 커버/리빌 연출 없이 즉시 텔레포트한다. 일반 좌우 이동(MoveToMap)과
	-- 달리 "맵을 이동했다"는 느낌을 주면 안 되고, 그냥 처음부터 DesiredStartMapIndex에서 시작한 것처럼 보여야 한다.
	@ExecSpace("ServerOnly")
	method void SilentMoveToMap(integer fromIndex, integer targetIndex)
		if targetIndex < self.MinMapIndex or targetIndex > self.MaxMapIndex then return end
		if targetIndex == fromIndex then return end

		local mapName = self:GetMapName(targetIndex)
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapName)
		if mapEntity == nil then
			log_error("MapManager: " .. mapName .. " not found")
			return
		end

		-- 이 텔레포트엔 와이프 커버가 없어서(MapTransitionLogic처럼 화면을 가릴 게 없다) 카메라 Damping이
		-- 그대로면 새 스폰 지점까지 0.5~0.8초 동안 부드럽게 미끄러져 따라붙는 움직임이 그대로 노출돼
		-- "시작하자마자 화면이 살짝 흔들린다"는 것처럼 보인다. Damping을 순간적으로 0에 가깝게 낮췄다가
		-- 짧게 복구해서 즉시 스냅되게 한다(와이프가 없으니 복구를 오래 미룰 필요도 없다).
		self:SnapCameraForSilentMove()

		for _, userEntity in pairs(_UserService.UserEntities) do
			_TeleportService:TeleportToMapPosition(userEntity, self:GetSpawnPositionForIndex(targetIndex), mapName)
		end

		local oldMapEntity = _MonsterSpawner:GetZoneEntity(fromIndex)
		local newMapEntity = _MonsterSpawner:GetZoneEntity(targetIndex)
		self:SetMonstersPaused(oldMapEntity, true)
		self:SetMonstersPaused(newMapEntity, false)

		-- ActivateMap보다 먼저 CurrentMapIndex를 갱신해야 한다 — MonsterSpawner.SpawnBatchOnMap이
		-- "지금 도착한 맵이 맞는지"를 GetCurrentMap()(=GetZoneEntity(_MapManager.CurrentMapIndex))으로
		-- 판정하는데, 이걸 나중에 갱신하면 첫 방문 스폰 시점엔 아직 옛 인덱스라 "다른 맵"으로 오판해서
		-- 방금 태어난 몬스터를 전부 Pause()해버린다 — 그 뒤로 아무도 Resume()을 다시 불러주지 않으니
		-- 영구히 멈춰있는 것처럼 보인다(실측 확인 — "이동할 때 가끔 몬스터가 멈춰있다"는 문제의 원인).
		self.CurrentMapIndex = targetIndex

		-- 처음 가보는 맵이면 여기서 스폰이 시작된다. 맵10(보너스 스테이지)은 일반 웨이브 스폰 대신
		-- 매번 입장할 때마다 보너스 보스 등장 여부를 판정하는 별도 진입점을 탄다.
		-- GameStarted 전(타이틀 화면 중 미리 위치만 옮겨두는 경우)엔 스폰을 켜지 않는다 — 어차피
		-- BeginGameplay()가 "게임 시작" 클릭 시점에 self.CurrentMapIndex(이미 갱신됨) 기준으로
		-- ActivateMap을 다시 호출해준다. 여기서 조건 없이 켜버리면 타이틀 화면을 보는 동안 몬스터가
		-- 먼저 쌓이기 시작하는 문제가 생긴다.
		if _GameManager.GameStarted then
			if targetIndex == 10 then
				_MonsterSpawner:TryStartBonusStage()
			else
				_MonsterSpawner:ActivateMap(targetIndex)
			end
		end

		log("MapManager: silent-started at " .. mapName)
		_MapMoveUI:NotifyMapChanged(targetIndex)
		-- 존15 이스터에그: 도착했을 때만 알려준다(재입장 시 불꽃이 아직 안 풀렸으면 다시 꺼지는 연출)
		if targetIndex == 15 then _Zone15PuzzleLogic:OnEnterZone15() end
	end

	-- 실제로 플레이어가 있는 맵 번호를 엔티티 기준으로 다시 계산한다. Maker Play Test는 world 시작 시점의
	-- 유저 연결 타이밍에 따라 항상 map01에서 시작한다고 보장할 수 없어서(예: 마지막으로 있던 맵에서 재개),
	-- CurrentMapIndex를 무조건 1로 고정하면 실제 위치와 어긋나 보스 스폰/일시정지 대상이 틀어진다.
	-- 알려진 한계: 그룹D 병합으로 맵11/12가 같은 파일(map11)을 쓰기 때문에, 이 이름-파싱 방식으로는
	-- 둘을 구분하지 못하고 항상 11로 판정한다 — 월드 재시작 시점에 마침 12에 있었던 경우에만 11로
	-- 되돌아가는 정도의 미세한 엣지케이스이고(버튼 이동 중엔 CurrentMapIndex가 그대로 신뢰됨), 실사용
	-- 흐름(버튼으로만 이동)에서는 영향이 없다.
	@ExecSpace("ServerOnly")
	method integer ResolveCurrentMapIndex()
		for _, userEntity in pairs(_UserService.UserEntities) do
			local mapName = userEntity.CurrentMapName
			if mapName ~= nil then
				local numStr = string.match(mapName, "(%d+)$")
				local idx = numStr and tonumber(numStr) or nil
				if idx ~= nil and idx >= self.MinMapIndex and idx <= self.MaxMapIndex then
					return idx
				end
			end
		end
		return self.MinMapIndex
	end

	-- 클라이언트의 좌측 이동 버튼 요청
	@ExecSpace("Server")
	method void RequestMoveLeft()
		self:MoveByDelta(-1)
	end

	-- 클라이언트의 우측 이동 버튼 요청
	@ExecSpace("Server")
	method void RequestMoveRight()
		self:MoveByDelta(1)
	end

	-- 클라이언트의 "위로" 버튼 요청 (맵6 → 맵7 전용 경로). 우측 이동 버튼은 맵6에서 이제 맵11로
	-- 분기하므로, 맵7 진입은 더 이상 RequestMoveRight와 공유하지 않고 이 전용 메서드로 분리한다
	@ExecSpace("Server")
	method void RequestMoveToMap7()
		local actualIndex = self.CurrentMapIndex
		if actualIndex ~= 6 then return end
		self:MoveToMap(actualIndex, 7)
	end

	-- 클라이언트의 존15 전용 "아래로" 버튼 요청 (존15 → 그룹G/존19 직행 분기). 존19는 인덱스상 존15의
	-- 순차 다음(16)이 아니라 그룹F(16~18) 전체를 건너뛰는 별도 분기라서, 맵6→7과 동일하게 전용 메서드로
	-- 분리한다.
	@ExecSpace("Server")
	method void RequestMoveToZone19()
		local actualIndex = self.CurrentMapIndex
		if actualIndex ~= 15 then return end
		self:MoveToMap(actualIndex, 19)
	end

	-- 클라이언트의 "위로" 버튼 요청 (존19 → 존15 복귀, RequestMoveToZone19의 역방향 전용 경로)
	@ExecSpace("Server")
	method void RequestMoveToZone15()
		local actualIndex = self.CurrentMapIndex
		if actualIndex ~= 19 then return end
		self:MoveToMap(actualIndex, 15)
	end

	-- self.CurrentMapIndex를 그대로 신뢰한다 — 그룹D(맵11/12) 병합 이후 ResolveCurrentMapIndex()는
	-- CurrentMapName("map11")만으로 11/12를 구분하지 못해 항상 11로 오판하는데(실측 확인됨), 이동이
	-- 전부 버튼 트리거라 CurrentMapIndex는 매 이동마다 확정적으로 갱신되므로 여기서는 이게 더 정확하다.
	@ExecSpace("ServerOnly")
	method void MoveByDelta(integer delta)
		local actualIndex = self.CurrentMapIndex
		local targetIndex = actualIndex + delta

		-- 맵6↔11 특수 분기: 맵6의 오른쪽은 7이 아니라 11(신규 해변 존)로 이어지고, 맵11의 왼쪽은
		-- 6으로 되돌아간다. 맵7 진입은 RequestMoveToMap7("위로" 버튼) 전용 경로로 분리되어 있다.
		if actualIndex == 6 and delta == 1 then
			targetIndex = 11
		elseif actualIndex == 11 and delta == -1 then
			targetIndex = 6
		elseif actualIndex == 10 and delta == 1 then
			-- MaxMapIndex를 11로 올린 부작용 방지: 맵10 오른쪽은 여전히 막다른 길이어야 한다
			-- (11은 맵6 전용 분기이지 맵10의 다음 단계가 아님)
			return
		elseif actualIndex == 18 and delta == 1 then
			-- 존18(그림자 상점)은 막다른 길이다 — MapMoveUI가 ">"를 아예 숨기지만(UpdateButtonVisibility),
			-- 서버 쪽에서도 동일하게 막아 어떤 경로로 호출되든 존19 이상으로 못 넘어가게 한다. 존18은
			-- 존15에서 횟불 3개를 켜야 풀리는 ">" 정공법(15→16→17→18)으로만 들어갈 수 있어야 하는데,
			-- 여기서 존19로 계속 진행할 수 있으면 그 퍼즐 게이트를 무의미하게 만든다.
			return
		-- 존19↔27 특수 분기: 그룹D(맵6↔11)와 동일한 패턴. 존19의 기본 "<"는 더 이상 존18(그림자
		-- 상점)로 돌아가지 않고 그룹I(존27~30, map19.map)로 진입한다. 존18 복귀 경로는 의도적으로
		-- 만들지 않았다 — 그림자 상점(존18)은 존15에서 횟불 3개를 켜야 풀리는 ">" 정공법(순차 진행
		-- 15→16→17→18)으로만 들어갈 수 있어야 하고, 존19(그룹G, 존15의 "아래로" 직행 분기) 쪽에서
		-- 되돌아 들어가는 백도어가 있으면 이 퍼즐 게이트를 완전히 우회하게 된다. 존27의 기본 "<"는
		-- 존19로 되돌아간다.
		elseif actualIndex == 19 and delta == -1 then
			targetIndex = 27
		elseif actualIndex == 27 and delta == -1 then
			targetIndex = 19
		-- 존26↔31 특수 분기: 그룹J(존31~34, map20.map)는 그룹I와 달리 존26의 순차 연장으로 이어진다.
		-- 존26+1의 기본 델타는 그룹I의 존27로 새므로(존19~30 범위가 먼저 차 있음), 여기서 명시적으로
		-- 덮어써 존26의 ">"가 그룹J로 진입하게 한다. 존31의 "<"는 대칭으로 존26으로 되돌아간다.
		elseif actualIndex == 26 and delta == 1 then
			targetIndex = 31
		elseif actualIndex == 31 and delta == -1 then
			targetIndex = 26
		end

		self:MoveToMap(actualIndex, targetIndex)
	end

	-- map 위의 모든 몬스터를 일괄 일시정지/재개
	@ExecSpace("ServerOnly")
	method void SetMonstersPaused(Entity map, boolean paused)
		if map == nil then return end
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		for i = 1, #monsters do
			---@type MonsterAI
			local ai = monsters[i]
			if paused then ai:Pause() else ai:Resume() end
		end
	end

	-- 이동 요청 사이 최소 간격 — 이보다 빠르게 연달아 이동 요청이 들어오면(예: ">"를 빠르게 연타)
	-- 뒤 요청을 무시한다. 실측 확인: 두 이동 요청이 이 간격보다 가깝게 겹치면, 먼저 요청한 이동의
	-- 위치 확정이 나중에 처리되면서 이미 화면에 반영된 나중 이동 결과를 몇 초 뒤 조용히 덮어써버리는
	-- 경합(race condition)이 있었다(존13→14→15를 빠르게 연달아 누르면 마지막 도착 화면이 잠시 후
	-- 예전 존으로 되돌아가는 버그의 원인 — 2초 간격을 두면 전혀 재현되지 않음을 확인).
	-- 유저 요청으로 1초로 낮춰본다(2초가 너무 길다는 피드백 — 위 레이스 컨디션이 1초에서도
	-- 재현되는지 확인 필요, 재현되면 되돌릴 예정).
	property number MoveCooldownDuration = 1.0
	property boolean _moveLocked = false

	@ExecSpace("ServerOnly")
	method void MoveToMap(integer fromIndex, integer targetIndex)
		-- 범위를 벗어나면 무시 (map1에서 좌 / 마지막 맵에서 우 — 아무 반응 없음)
		if targetIndex < self.MinMapIndex or targetIndex > self.MaxMapIndex then return end
		if targetIndex == fromIndex then return end

		-- 이전 이동이 아직 "확정 대기" 중이면 이번 요청은 무시한다(연타 방지)
		if self._moveLocked then
			log("MapManager: move ignored (cooldown) fromIndex=" .. fromIndex .. " targetIndex=" .. targetIndex)
			return
		end
		self._moveLocked = true
		_TimerService:SetTimerOnce(function()
			if isvalid(self) then self._moveLocked = false end
		end, self.MoveCooldownDuration)

		-- 맵4 이상은 레벨10이 되기 전까지 잠겨있다 (예전엔 보스 처치 기준이었는데, 보스를 못 잡는
		-- 버그가 생길 경우 진행이 완전히 막히는 걸 막기 위해 레벨 기준으로 바꿨다 — Wave와 Level은
		-- LevelUp()에서 항상 같이 증가하므로 레벨10 = 웨이브10 시점과 동일하다)
		if targetIndex >= 4 and _GameManager.Level < 10 then
			log("MapManager: map" .. targetIndex .. " locked until level 10")
			return
		end

		-- 그룹D(맵11↔12)처럼 물리적으로 같은 파일(map11.map)을 공유하는 존 사이 이동은 와이프 대신
		-- 카메라가 옆으로 쓸려가는 스크롤 전환을 쓴다. GetMapName이 같은 파일명을 반환한다는 것 자체가
		-- "같은 물리 맵"이라는 판정 기준이다. 그 외(파일이 실제로 다른 맵)는 기존 와이프 그대로 유지.
		if self:GetMapName(fromIndex) == self:GetMapName(targetIndex) then
			self:DoScrollMapChange(fromIndex, targetIndex)
			return
		end

		-- 화면을 먼저 이동 방향으로 덮은 뒤(와이프 커버), 다 덮인 시점에 실제 텔레포트를 실행한다 —
		-- 순간이동 컷을 가려서 부드럽게 넘어가는 것처럼 보이게 한다
		local direction = "right"
		if targetIndex < fromIndex then direction = "left" end
		_MapTransitionLogic:PlayCover(direction)

		_TimerService:SetTimerOnce(function()
			self:DoMapChange(fromIndex, targetIndex, direction)
		end, _MapTransitionLogic.CoverDuration)
	end

	-- 그룹D(맵11↔12) 전용 스크롤 전환: 맵11/12가 물리적으로 같은 파일 · 같은 발판 그룹이라, 네이티브
	-- confine(ConfineCameraArea)이 이미 맵11 전체 발판 범위(x -14.09~33.92)를 기준으로 자리 잡아 있고
	-- 이 범위는 두 존 사이를 이동해도 전혀 바뀌지 않는다 — 그래서 여기서는 confine을 따로 손대지 않고
	-- (이전엔 존마다 커스텀 confine을 넓혔다 좁혔다 했었는데, 타이밍이 꼬이면 넓힌 상태로 눌러앉아
	-- 화면이 통째로 줌아웃되는 버그가 있었다) 그냥 플레이어만 옮긴다. 네이티브 Damping이 알아서
	-- 옆으로 자연스럽게 따라붙는다 — "처음 맵11에 도착했을 때의 카메라 앵글이 계속 유지된다"는
	-- 요청과도 정확히 맞아떨어진다(confine을 아예 안 바꾸니까).
	@ExecSpace("ServerOnly")
	method void DoScrollMapChange(integer fromIndex, integer targetIndex)
		local mapName = self:GetMapName(targetIndex)
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapName)
		if mapEntity == nil then
			log_error("MapManager: " .. mapName .. " not found")
			return
		end

		self:ResetCameraConfine()

		-- _TeleportService:TeleportToMapPosition은 "다른 맵으로" 이동을 전제로 한 API라, 목적지 맵 이름이
		-- 지금 있는 맵과 같으면(그룹D처럼 물리적으로 같은 파일) 위치가 갱신되지 않고 조용히 무시된다
		-- (실측 확인됨) — 같은 파일 내부 이동이므로 직접 재배치한다. 다만 TransformComponent.Position을
		-- 그냥 대입하면 RigidbodyComponent가 그 이동을 인지하지 못해 새 발판으로 낙하/스냅되지 않고
		-- 허공에 그대로 떠 있는다(실측 확인됨) — RigidbodyComponent:SetPosition으로 물리 바디까지 갱신한다.
		-- Y는 GetSpawnPositionForIndex의 SpawnPosition.y(0.2, 최초 스폰/와이프 전환 전용값)를 쓰지 않고
		-- 플레이어의 "현재" Y를 그대로 유지한다 — 그룹 안의 모든 존은 지면 Y가 동일하도록 병합했으므로
		-- (§6 카메라 고정 앵글) X만 바꿔도 항상 같은 발판 위다. 예전처럼 spawnPos.y(0.2)로 옮기면 실제
		-- 지면(-1.xx)보다 한참 위라 중력에 끌려 짧게 낙하하는 게 화면에 그대로 보여 "붕 떴다 가라앉는"
		-- 것처럼 보이는 버그가 있었다(맵1~3 병합 그룹에서 실측 확인).
		-- ZoneInfo에 landY가 명시된 존(예: 존25 — 공통 지면과 다른 높이에 새 발판이 있는 경우)은 그 값을
		-- 착지 Y로 강제한다. "이전 존 Y 재사용" 기본 규칙이 깨지는 지형 예외를 존 단위로 표시하는 용도다.
		local spawnX = self:GetSpawnPositionForIndex(targetIndex).x
		local targetZoneInfo = self:GetZoneInfo(targetIndex)
		local landY = (targetZoneInfo ~= nil and targetZoneInfo.landY ~= nil) and targetZoneInfo.landY or nil
		for _, userEntity in pairs(_UserService.UserEntities) do
			local rigidbody = userEntity.RigidbodyComponent
			local y = (landY ~= nil) and landY or userEntity.TransformComponent.WorldPosition.y
			if rigidbody ~= nil then
				rigidbody:SetPosition(Vector2(spawnX, y))
			else
				userEntity.TransformComponent.Position = Vector3(spawnX, y, 0)
			end
		end

		local oldMapEntity = _MonsterSpawner:GetZoneEntity(fromIndex)
		local newMapEntity = _MonsterSpawner:GetZoneEntity(targetIndex)
		self:SetMonstersPaused(oldMapEntity, true)
		self:SetMonstersPaused(newMapEntity, false)

		-- ActivateMap보다 먼저 갱신 — MonsterSpawner.GetCurrentMap()이 이 값을 기준으로 "지금 도착한
		-- 맵인지"를 판정하므로, 나중에 갱신하면 첫 방문 스폰 시점의 몬스터가 전부 Pause된 채로 태어나서
		-- 영구히 멈춰있는 버그가 생긴다(실측 확인).
		self.CurrentMapIndex = targetIndex

		-- 맵10(보너스 스테이지)은 일반 웨이브 스폰 대신 매번 입장할 때마다 보너스 보스 등장 여부를
		-- 판정하는 별도 진입점을 타야 한다 — DoMapChange/SilentMoveToMap엔 이 분기가 있었는데
		-- DoScrollMapChange엔 그룹D(맵11/12) 전용으로 작성될 당시엔 맵10이 관여하지 않아 빠져 있었다.
		-- 그룹C 병합으로 존9→10 이동이 이제 이 스크롤 경로를 타게 되면서, 무조건 ActivateMap만 불러
		-- 보너스 보스 대신 매번 일반 웨이브가 스폰되는 버그가 있었다(실측 확인).
		if targetIndex == 10 then
			_MonsterSpawner:TryStartBonusStage()
		else
			_MonsterSpawner:ActivateMap(targetIndex)
		end

		log("MapManager: scrolled to zone " .. targetIndex .. " (" .. mapName .. ")")
		_MapMoveUI:NotifyMapChanged(targetIndex)
		-- 존15 이스터에그: 도착했을 때만 알려준다(재입장 시 불꽃이 아직 안 풀렸으면 다시 꺼지는 연출)
		if targetIndex == 15 then _Zone15PuzzleLogic:OnEnterZone15() end
	end

	-- CameraComponent는 CameraService.GetCurrentCameraComponent()가 ClientOnly라 서버에서 직접 만질 수
	-- 없다(호출해도 조용히 nil) — Multicast로 클라이언트에서 실제로 손댄다. UseCustomBound를 꺼서
	-- 네이티브 ConfineCameraArea(맵11 전체 발판 범위 기준)로 되돌린다 — 이전 커스텀 confine 실험이
	-- 남긴 값이 있으면 그걸로 눌러앉는 문제를 막기 위해 매 스크롤 전환마다 확실히 리셋한다. 겸사겸사
	-- DefaultZoomRatio도 같이 맞춰서, 게임 시작이든 존 스크롤 전환이든 항상 같은 줌 값을 유지한다.
	@ExecSpace("Multicast")
	method void ResetCameraConfine()
		if not self:IsClient() then return end
		self:ApplyDefaultZoomImmediate()
		local cam = _CameraService:GetCurrentCameraComponent()
		if cam == nil then return end
		cam.UseCustomBound = false
		cam.Damping = self.ScrollCameraDamping
	end

	-- 타이틀 화면이 뜨기도 전에(TitleUI 클라이언트 OnBeginPlay에서) 곧바로 호출해서 줌을 맞춘다.
	-- BeginGameplay 시점(ResetCameraConfine, "게임 시작" 클릭 후)까지 기다리면 그 사이엔 네이티브
	-- 기본 줌(100)으로 한 프레임 이상 렌더링되다가 DefaultZoomRatio(115)로 튀어서, 유저 눈에는
	-- "줌인 상태로 시작했다가 줌아웃되는" 것처럼 보이는 버그가 있었다(실제로 접속하는 매 클라이언트마다
	-- 재현). Multicast가 아니라 ClientOnly로 둬서 그 클라이언트가 접속하는 즉시(서버의 Multicast
	-- 브로드캐스트를 기다리지 않고) 스스로 적용할 수 있게 한다.
	@ExecSpace("ClientOnly")
	method void ApplyDefaultZoomImmediate()
		local cam = _CameraService:GetCurrentCameraComponent()
		if cam == nil then return end
		cam.ZoomRatio = self.DefaultZoomRatio
	end

	-- SilentMoveToMap(게임 시작 리다이렉트)은 MapTransitionLogic의 와이프 커버 같은 가림막이 없다 —
	-- 그 상태에서 카메라 Damping이 그대로면 새 스폰 지점까지 천천히 미끄러져 따라붙는 움직임이 그대로
	-- 노출되어 "시작하자마자 화면이 살짝 흔들린다"는 것처럼 보인다(실측 확인). 텔레포트 직전에 Damping을
	-- 거의 0으로 낮춰 순간 스냅되게 하고, 가림막이 없으니 아주 짧게(SilentMoveDampingRestoreDelay)만
	-- 기다렸다가 원래 값으로 복구한다(MapTransitionLogic.PlayCover/PlayReveal과 같은 패턴).
	@ExecSpace("Multicast")
	method void SnapCameraForSilentMove()
		if not self:IsClient() then return end
		local cam = _CameraService:GetCurrentCameraComponent()
		if cam == nil then return end
		if not self._silentMoveDampingSaved then
			self._savedSilentMoveDamping = cam.Damping
			self._silentMoveDampingSaved = true
			cam.Damping = Vector2(0.001, 0.001)
		end
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			local c = _CameraService:GetCurrentCameraComponent()
			if c ~= nil and self._silentMoveDampingSaved then
				c.Damping = self._savedSilentMoveDamping
				self._silentMoveDampingSaved = false
			end
		end, self.SilentMoveDampingRestoreDelay)
	end

	@ExecSpace("ServerOnly")
	method void DoMapChange(integer fromIndex, integer targetIndex, string direction)
		-- 와이프가 화면을 다 덮은 뒤 실행되는 실제 텔레포트 + 몬스터 일시정지/재개 처리
		local mapName = self:GetMapName(targetIndex)
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapName)
		if mapEntity == nil then
			log_error("MapManager: " .. mapName .. " not found")
			_MapTransitionLogic:PlayReveal(direction)
			return
		end

		-- 텔레포트를 먼저 실행해야 한다 — ActivateMap()이 내부에서 "지금 내가 있는 맵"을 실제 엔티티
		-- 위치로 판정하는데(MonsterSpawner.GetCurrentMap), 텔레포트보다 먼저 스폰하면 아직 예전 맵에
		-- 있는 것으로 판정되어 방금 도착한 맵의 새 몬스터가 거꾸로 일시정지된 채로 태어난다.
		for _, userEntity in pairs(_UserService.UserEntities) do
			_TeleportService:TeleportToMapPosition(userEntity, self:GetSpawnPositionForIndex(targetIndex), mapName)
		end

		-- 떠나는 맵의 몬스터는 일시정지(공격/접근 중단) — 안 그러면 화면 밖에서 계속 타이머가 돌아
		-- 플레이어가 안 보고 있어도 GameManager에 피해를 입힌다. 도착한 맵의 몬스터는 재개.
		-- mapEntity는 루트 맵 엔티티라(EntityByPath("/maps/"..mapName)), targetIndex가 Zone14/15/17/18
		-- 같은 자식 컨테이너 존이면 몬스터가 그 밑에 없어 SetMonstersPaused가 아무도 못 찾고 조용히
		-- 아무 일도 안 한다 — GetZoneEntity로 다시 조회해야 실제 몬스터가 있는 컨테이너를 찾는다
		-- (실측 확인 — 존16→15처럼 다른 파일에서 자식 컨테이너 존으로 들어올 때만 재현되고, 같은 파일
		-- 내부 이동(DoScrollMapChange)이나 루트 존으로 들어올 때는 mapEntity 자체가 맞아서 안 드러났다).
		local oldMapEntity = _MonsterSpawner:GetZoneEntity(fromIndex)
		local newMapEntity = _MonsterSpawner:GetZoneEntity(targetIndex)
		self:SetMonstersPaused(oldMapEntity, true)
		self:SetMonstersPaused(newMapEntity, false)

		-- ActivateMap보다 먼저 갱신해야 한다 — MonsterSpawner.SpawnBatchOnMap이 "지금 도착한 맵인지"를
		-- GetCurrentMap()(=GetZoneEntity(_MapManager.CurrentMapIndex))으로 판정하는데, 텔레포트로 유저
		-- 엔티티 위치를 옮기는 것과는 별개로 이 인덱스 자체를 갱신해야 판정이 맞다 — 나중에 갱신하면 첫
		-- 방문 스폰 시점엔 아직 옛 인덱스라 "다른 맵"으로 오판해서 방금 태어난 몬스터를 전부 Pause()해
		-- 버리고, 그 뒤로 아무도 다시 Resume()을 불러주지 않아 영구히 멈춰있는 것처럼 보인다(실측 확인 —
		-- "이동할 때 가끔 몬스터가 멈춰있다"는 문제의 원인. 위 텔레포트-먼저 코멘트는 진짜 원인이 아니었다).
		self.CurrentMapIndex = targetIndex

		-- 처음 가보는 맵이면 여기서 스폰이 시작된다 (이미 활성화된 맵이면 아무 일도 안 함). 맵10(보너스
		-- 스테이지)은 일반 웨이브 스폰 대신 매번 입장할 때마다 보너스 보스 등장 여부를 판정하는 별도
		-- 진입점을 탄다.
		if targetIndex == 10 then
			_MonsterSpawner:TryStartBonusStage()
		else
			_MonsterSpawner:ActivateMap(targetIndex)
		end

		log("MapManager: moved to " .. mapName)
		-- targetIndex를 파라미터로 직접 넘긴다 — CurrentMapIndex의 @Sync 전파와 이 Multicast 호출은
		-- 서로 다른 채널이라 순서 보장이 없어서, 클라이언트가 NotifyMapChanged 시점에 CurrentMapIndex를
		-- 다시 읽으면 아직 갱신 전(이전 값)을 볼 수 있다 — 값 자체를 인자로 넘겨야 확실하다
		_MapMoveUI:NotifyMapChanged(targetIndex)
		-- 존15 이스터에그: 도착했을 때만 알려준다(재입장 시 불꽃이 아직 안 풀렸으면 다시 꺼지는 연출)
		if targetIndex == 15 then _Zone15PuzzleLogic:OnEnterZone15() end

		-- 텔레포트 직후 카메라가 새 맵 발판 범위에 맞춰 자리 잡는 데 실측 0.5~0.8초 정도 걸린다
		-- (Damping을 낮춰도 confine 영역 자체가 바뀌는 건 즉시 스냅되지 않음) — 그 시간만큼 화면을
		-- 가린 채로 더 기다렸다가 걷어내야 리빌 도중/직후에 카메라가 움직이는 게 보이지 않는다
		_TimerService:SetTimerOnce(function()
			_MapTransitionLogic:PlayReveal(direction)
		end, _MapTransitionLogic.CameraSettleDelay)
	end

end
