	-- 클라이언트의 에피소드3 map4 존3 전용 "위로" 버튼 요청 (map4 존3 → map3 존6 복귀,
	-- RequestMoveToEp3Map4Zone3의 역방향 전용 경로)
	@ExecSpace("Server")
	method void RequestMoveToEp3Map3Zone6()
		local actualIndex = self.CurrentMapIndex
		if actualIndex ~= 121 then return end
		self:MoveToMap(actualIndex, 114)
	end

	-- self.CurrentMapIndex를 그대로 신뢰한다 — 그룹D(맵11/12) 병합 이후 ResolveCurrentMapIndex()는
	-- CurrentMapName("map11")만으로 11/12를 구분하지 못해 항상 11로 오판하는데(실측 확인됨), 이동이
	-- 전부 버튼 트리거라 CurrentMapIndex는 매 이동마다 확정적으로 갱신되므로 여기서는 이게 더 정확하다.
	@ExecSpace("ServerOnly")
	method void MoveByDelta(integer delta)
		local actualIndex = self.CurrentMapIndex
		local targetIndex = actualIndex + delta

		-- 맵6↔11 특수 분기: 맵6의 오른쪽은 7이 아니라 11(신규 해변 존)로 이어지고, 맵11의 왼쪽은
		-- 6으로 되돌아간다. 맵7 진입은 RequestMoveToMap7("위로" 버튼) 전용 경로로 분리되어 있다.
		if actualIndex == 6 and delta == 1 then
			targetIndex = 11
		elseif actualIndex == 11 and delta == -1 then
			targetIndex = 6
		elseif actualIndex == 10 and delta == 1 then
			-- MaxMapIndex를 11로 올린 부작용 방지: 맵10 오른쪽은 여전히 막다른 길이어야 한다
			-- (11은 맵6 전용 분기이지 맵10의 다음 단계가 아님)
			return
		elseif actualIndex == 18 and delta == 1 then
			-- 존18(그림자 상점)은 막다른 길이다 — MapMoveUI가 ">"를 아예 숨기지만(UpdateButtonVisibility),
			-- 서버 쪽에서도 동일하게 막아 어떤 경로로 호출되든 존19 이상으로 못 넘어가게 한다. 존18은
			-- 존15에서 횟불 3개를 켜야 풀리는 ">" 정공법(15→16→17→18)으로만 들어갈 수 있어야 하는데,
			-- 여기서 존19로 계속 진행할 수 있으면 그 퍼즐 게이트를 무의미하게 만든다.
			return
		-- 존19↔27 특수 분기: 그룹D(맵6↔11)와 동일한 패턴. 존19의 기본 "<"는 더 이상 존18(그림자
		-- 상점)로 돌아가지 않고 그룹I(존27~30, map19.map)로 진입한다. 존18 복귀 경로는 의도적으로
		-- 만들지 않았다 — 그림자 상점(존18)은 존15에서 횟불 3개를 켜야 풀리는 ">" 정공법(순차 진행
		-- 15→16→17→18)으로만 들어갈 수 있어야 하고, 존19(그룹G, 존15의 "아래로" 직행 분기) 쪽에서
		-- 되돌아 들어가는 백도어가 있으면 이 퍼즐 게이트를 완전히 우회하게 된다. 존27의 기본 "<"는
		-- 존19로 되돌아간다.
		elseif actualIndex == 19 and delta == -1 then
			targetIndex = 27
		elseif actualIndex == 27 and delta == -1 then
			targetIndex = 19
		-- 존26↔31 특수 분기: 그룹J(존31~34, map20.map)는 그룹I와 달리 존26의 순차 연장으로 이어진다.
		-- 존26+1의 기본 델타는 그룹I의 존27로 새므로(존19~30 범위가 먼저 차 있음), 여기서 명시적으로
		-- 덮어써 존26의 ">"가 그룹J로 진입하게 한다. 존31의 "<"는 대칭으로 존26으로 되돌아간다.
		elseif actualIndex == 26 and delta == 1 then
			targetIndex = 31
		elseif actualIndex == 31 and delta == -1 then
			targetIndex = 26
		-- 존34↔36 특수 분기: 그룹K(존36~39, map22.map)도 그룹J와 동일하게 존34의 순차 연장으로 이어진다.
		-- 존34+1의 기본 델타는 35(맵21 택시 이스터에그 전용 조회 항목, 진짜 존이 아님)로 새므로, 여기서
		-- 명시적으로 덮어써 존34의 ">"가 그룹K로 진입하게 한다. 존36의 "<"는 대칭으로 존34로 되돌아간다.
		elseif actualIndex == 34 and delta == 1 then
			targetIndex = 36
		elseif actualIndex == 36 and delta == -1 then
			targetIndex = 34
		elseif actualIndex == 39 and delta == 1 then
			-- 그룹L(존40~43, map23.map)은 그룹I와 동일하게 순차 연장이 아니라 곁가지다 — 존40 진입은
			-- 존29의 "아래로" 버튼(RequestMoveToZone40) 전용 경로로만 가능해야 한다. MaxMapIndex를
			-- 43으로 올린 부작용으로 존39+1(=40)이 더 이상 상한 밖이 아니게 됐으므로(맵10과 동일한
			-- 이유로) 여기서 명시적으로 막아 존39가 계속 막다른 길로 남게 한다.
			return
		elseif actualIndex == 43 and delta == 1 then
			-- 존44(map24)는 존35(map21)와 동일하게 일반 순차 이동으로 들어가면 안 된다 — 존43의
			-- 포탈(portal-12)을 통해서만 진입 가능. MaxMapIndex를 44로 올린 부작용으로 존43+1이
			-- 더 이상 상한 밖이 아니게 됐으므로 여기서 명시적으로 막는다(존39와 동일한 차단 패턴).
			return
		elseif actualIndex == 54 and delta == 1 then
			-- map4(존1~10=mapIndex75~84) 추가로 map1 존10(54)의 ">"가 더 이상 막다른 길이 아니게 됐다
			-- (유저 지정 — "맵1 존10에서 오른쪽 누르면 맵4 존1이동"). map2 진입은 여전히 오직 map1 존5의
			-- "아래로" 버튼[RequestMoveToMap2Zone5]으로만 가능하다(이 분기와는 무관).
			targetIndex = 75
		elseif actualIndex == 75 and delta == -1 then
			-- 위 54→75의 대칭 반대 방향 — map4 존1의 "<"는 map1 존10으로 되돌아간다.
			targetIndex = 54
		elseif actualIndex == 64 and delta == 1 then
			-- map2 존10의 ">"는 순차 다음(65)이 아니라 map1 존1(mapIndex45)로 되돌아가는 순환 고리다
			-- (유저 지정 — "map1 존1로 연결"). 반대 방향(map1 존1의 "<")은 만들지 않는다 — map1 존1의
			-- "<" 버튼은 UI에서 그대로 숨긴다(MapMoveUI.UpdateButtonVisibility 참고).
			targetIndex = 45
		elseif actualIndex == 74 and delta == 1 then
			-- map3 존10↔map2 존1 특수 분기(유저 지정 — "맵3 10에서 오른쪽누르면 맵2 1로 이동"). map3 존10의
			-- 순차 다음(75)은 map4 존1인데, 그쪽은 map1 존10의 ">"(위 54→75)로만 진입해야 하는 별도
			-- 경로이므로 여기서는 map2 존1로 직행하도록 명시적으로 덮어쓴다.
			targetIndex = 55
		elseif actualIndex == 55 and delta == -1 then
			-- 위 74→55의 대칭 반대 방향(유저 지정 — "맵2 1에서 왼쪽 누르면 맵3 10으로 이동").
			targetIndex = 74
		elseif actualIndex == 65 and delta == -1 then
			-- map3 존1(mapIndex65)은 map3의 왼쪽 끝단이다 — map3 진입은 오직 map4 존5의 "위로" 버튼
			-- (RequestMoveToMap3Zone5, mapIndex69 스퍼) 또는 map2 존1의 "<"(74로 직행)로만 가능하므로,
			-- 존65 자신의 "<"는 막다른 길이어야 한다(존10/존39/존43과 동일한 차단 패턴).
			return
		elseif actualIndex == 84 and delta == 1 then
			-- map4 존10(mapIndex84)도 동일하게 막다른 길이다 — map4 진입/진행은 map1 존10의 ">"(75로
			-- 직행)와 map3 존5의 스퍼(69↔79)뿐이다. 85(ep2_map2_hidden 존1)는 이제 존재하지만
			-- 순차 진행 대상이 아니라 존61 전용 스퍼(RequestMoveToEp2Map2Hidden)로만 들어가야 하므로
			-- 여기서는 여전히 막다른 길로 남겨둔다(그룹L의 존39/43과 동일한 차단 패턴).
			return
		elseif actualIndex == 88 and delta == 1 then
			-- ep2_map2_hidden 존4(mapIndex88)는 히든존의 끝 — 그 다음(89)은 존재하지 않는다.
			return
		elseif actualIndex == 85 and delta == -1 then
			-- 유저 지정(2026-08-24): "여기 나가는길은 없고 시간이 끝나면 자동으로 복귀" — 히든존은
			-- 나가는 경로 자체가 없다. 3분 타이머가 끝나면 Ep2Map2HiddenExpBoostLogic이 존61로 직접
			-- MoveToMap을 호출해 자동 복귀시킨다(일반 "<" 이동이 아님). 그래서 존85의 "<"는 항상
			-- 막다른 길이어야 한다(MapMoveUI에서 버튼 자체도 숨김).
			return
		elseif actualIndex == 129 and delta == -1 then
			-- ep3_map4_ester_1 존1(입구, portal-3으로만 입장) — 왼쪽은 막다른 길. 나가는 건 오직
			-- Ep3Map4Ester1PortalLogic의 60초 타이머 자동퇴장뿐이다(유저 지정, [[project_ep3map4_ester1_portal]]).
			return
		elseif actualIndex == 133 and delta == 1 then
			-- ep3_map4_ester_1 존5(마지막) — 오른쪽은 막다른 길.
			return
		elseif actualIndex == 89 and delta == -1 then
			-- 에피소드3 map1 존1(mapIndex89)의 "<" 특수 분기(유저 지정, 2026-08-25 — "맵1의 1존에서
			-- 왼쪽 버튼누르면 맵3의 1존 나오게"). 델타 그대로 두면 88(ep2_map2_hidden 존4, 전혀 다른
			-- 에피소드의 히든존)로 새어 들어가므로 원래는 항상 막다른 길(return)이었는데, 이제 map3
			-- 존1(mapIndex109)로 직행하는 전용 곁가지로 바뀐다. 반대 방향(map3 존1의 "<")은 원래도
			-- 순차적으로 108(map2 존10)로 이어지는 정상 경로라 별도 처리가 필요 없다 — MapMoveUI에서
			-- 숨겨뒀던 이 버튼도 다시 보이게 해야 한다(UpdateButtonVisibility 참고).
			targetIndex = 109
		end

		self:MoveToMap(actualIndex, targetIndex)
	end

	-- map 위의 모든 몬스터를 일괄 일시정지/재개
	@ExecSpace("ServerOnly")
	method void SetMonstersPaused(Entity map, boolean paused)
		if map == nil then return end
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		for i = 1, #monsters do
			---@type MonsterAI
			local ai = monsters[i]
			-- isvalid 가드 필수 — 죽어서 파괴 대기 중인(Entity:Destroy(delay)) 몬스터가 스냅샷에 섞여
			-- 있으면 Pause/Resume 호출이 nil 메서드 에러([LEA-2011])로 죽는다. 이 루프가 죽으면
			-- DoScrollMapChange 전체가 그 자리에서 중단돼 CurrentMapIndex 갱신도 못 하고 남아 —
			-- 그 뒤로는 어느 존으로 이동해도 신규 스폰이 박제된 옛 존에 계속 떨어지고, 떠나온 존
			-- 몬스터는 Pause가 안 걸려 화면 밖에서 계속 공격하는 버그로 이어진다(실측 확인 —
			-- 존1→6 이동 재현 테스트 중 이 크래시가 실제로 발생).
			if isvalid(ai) and isvalid(ai.Entity) then
				if paused then ai:Pause() else ai:Resume() end
			end
		end
	end

	-- 버그 수정(2026-08-19, 유저 리포트 "다른 존에서 몹이 뜬다") — SetMonstersPaused(map, paused)는
	-- map 엔티티 밑의 몬스터를 "전부" Pause/Resume한다. container가 있는 존 그룹(Zone14/15 등)은 존마다
	-- 자식 컨테이너가 따로 있어 GetZoneEntity가 zone마다 다른 엔티티를 반환하므로 문제없었는데, 맵3/4처럼
	-- container=nil인 존 10개가 파일 하나(맵 루트)를 공유하면 GetZoneEntity(65)~GetZoneEntity(74)가 전부
	-- 같은 루트 엔티티를 반환한다 — 존67→68로 스크롤 이동만 해도 "떠나는 맵(=같은 루트) Pause,
	-- 도착한 맵(=같은 루트) Resume"이 같은 엔티티에 연달아 걸려 사실상 아무 필터링 없이 그 파일에
	-- 존재하는 몬스터 전부가 Resume되어 버린다 — 이미 지나온 존(65/66/67...)의 몬스터까지 전부 다시
	-- 활성화되어 화면 밖에서(또는 스크롤로 다시 보일 때) 움직이는 게 "다른 존에서 몹이 뜬다"로 보였다.
	-- MonsterAI._spawnZoneIndex(스폰 시점에 이미 기록됨)로 한 번 더 걸러서, 같은 파일을 공유하는 존이라도
	-- 정확히 그 존 몬스터만 골라 Pause/Resume한다 — container 기반 존도 자기 자신의 zoneIndex와 항상
	-- 일치하므로 부작용 없이 그대로 적용된다.
	@ExecSpace("ServerOnly")
	method void SetMonstersPausedForZone(Entity map, integer zoneIndex, boolean paused)
		if map == nil then return end
		-- 성능 최적화(2026-08-24, 유저 리포트 "맵이동할때 렉 여전함") — 실측: map:GetChildComponentsByTypeName로
		-- container=nil 공유맵(map3/4, 존 10개가 파일 하나를 공유)의 몬스터를 전부(100마리 이상) 훑고
		-- _spawnZoneIndex로 걸러내던 방식이 맵이동 한 번(old/new 두 번 호출)에 1.3초까지 걸렸다. 이제
		-- MonsterSpawner가 존별로 직접 들고 있는 레지스트리에서 정확히 이 존만 O(그 존 크기)로 받아온다.
		local monsters = _MonsterSpawner:GetMonstersInZone(zoneIndex)
		for i = 1, #monsters do
			---@type MonsterAI
			local ai = monsters[i]
			if isvalid(ai) and isvalid(ai.Entity) then
				if paused then ai:Pause() else ai:Resume() end
			end
		end
	end

	-- 이동 요청 사이 최소 간격 — 이보다 빠르게 연달아 이동 요청이 들어오면(예: ">"를 빠르게 연타)
	-- 뒤 요청을 무시한다. 실측 확인: 두 이동 요청이 이 간격보다 가깝게 겹치면, 먼저 요청한 이동의
	-- 위치 확정이 나중에 처리되면서 이미 화면에 반영된 나중 이동 결과를 몇 초 뒤 조용히 덮어써버리는
	-- 경합(race condition)이 있었다(존13→14→15를 빠르게 연달아 누르면 마지막 도착 화면이 잠시 후
	-- 예전 존으로 되돌아가는 버그의 원인 — 2초 간격을 두면 전혀 재현되지 않음을 확인).
	-- 유저 요청으로 1초로 낮춰본다(2초가 너무 길다는 피드백 — 위 레이스 컨디션이 1초에서도
	-- 재현되는지 확인 필요, 재현되면 되돌릴 예정).
	property number MoveCooldownDuration = 1.0
	property boolean _moveLocked = false

	-- 이스터에그/존 요소를 대충 훑고 지나가는 것 방지용 "빠른 이동" 안전장치(유저 요청: "이동 버튼
	-- 눌러서 존나 빨리 이동해버리면 너무 허무하게 깨지는거 같다"). 한 존에 RushStayThreshold초 미만
	-- 머물고 연속으로 이동하면 3단계로 escalate한다 — 방금 도착한(지금 머무는 존이 아니라 "다음" 존)
	-- 존의 몬스터를 유저 쪽으로 당기고(1단계), 그 위에 스탯까지 강화하고(2단계), 마지막으로 절망의
	-- 칼날(타임어택 오버타임 전용 몹)을 조기 소환한다(3단계, 2026-08-11 유저 지정).
	property number _zoneEnterTime = 0
	property integer _rushMoveStreak = 0
	property number RushStayThreshold = 3.0
	property integer RushStreakThreshold1 = 3
	property integer RushStreakThreshold2 = 6
	property integer RushStreakThreshold3 = 9
	-- 토스트 스팸 방지용 — 이번 스트릭 동안 이미 안내한 최고 티어. 티어가 "새로 올라간" 순간에만
	-- 토스트를 띄우고, 스트릭이 끊기면(0으로 리셋) 같이 리셋된다.
	property integer _rushAnnouncedTier = 0

	-- 존 도착마다 호출 — countsAsMove=false(SilentMoveToMap의 시스템 리다이렉트)는 시계만 리셋하고
	-- 스트릭 판정은 건너뛴다. countsAsMove=true(실제 이동 버튼 결과, DoScrollMapChange/DoMapChange)만
	-- "얼마나 빨리 다음 존으로 넘어갔는지"를 스트릭에 반영한다.
	@ExecSpace("ServerOnly")
	method void RegisterZoneArrival(integer targetIndex, boolean countsAsMove)
		local now = _UtilLogic.ElapsedSeconds
		local tier = 0
		if countsAsMove and self._zoneEnterTime > 0 then
			local stayed = now - self._zoneEnterTime
			if stayed < self.RushStayThreshold then
				self._rushMoveStreak = self._rushMoveStreak + 1
			else
				self._rushMoveStreak = 0
			end

			if self._rushMoveStreak >= self.RushStreakThreshold3 then
				tier = 3
			elseif self._rushMoveStreak >= self.RushStreakThreshold2 then
				tier = 2
			elseif self._rushMoveStreak >= self.RushStreakThreshold1 then
				tier = 1
			end

			if tier == 0 then
				self._rushAnnouncedTier = 0
			elseif tier > self._rushAnnouncedTier then
				-- 티어가 새로 올라간 순간에만 토스트/3단계 소환을 1회 트리거한다(매 이동마다 반복
				-- 스팸 방지). 스폰 배치 보정(pendingRushPenalty, 아래)은 그와 별개로 매 이동마다 계속 적용.
				if tier == 1 then
					_UIToast:ShowMessage("빠른 이동으로 몬스터가 빨라집니다!")
				elseif tier == 2 then
					_UIToast:ShowMessage("빠른 이동으로 몬스터가 강해집니다!")
				elseif tier == 3 then
					_UIToast:ShowMessage("빠른 이동으로 「절망의 칼날」이 소환되었습니다.")
					_GameManager:SpawnDespairBlade()
				end
				self._rushAnnouncedTier = tier
				log("MapManager: rush move streak=" .. self._rushMoveStreak .. " -> tier " .. tier .. " applied to zone " .. targetIndex)
			end
		end
		-- 매번 명시적으로 덮어쓴다(0 포함) — 안 그러면 트리거된 존이 존10(보너스 스테이지,
		-- ActivateMap을 안 거치고 TryStartBonusStage로 감)이었을 때 플래그가 소비 안 된 채 남아
		-- 엉뚱한 다음 존 스폰에 적용되는 누수가 생긴다. 3단계는 2단계(스탯 강화)를 포함한다.
		_MonsterSpawner._pendingRushPenalty = (tier >= 2) and 2 or ((tier >= 1) and 1 or 0)
		self._zoneEnterTime = now
	end

	@ExecSpace("ServerOnly")
	method void MoveToMap(integer fromIndex, integer targetIndex)
		-- 범위를 벗어나면 무시 (map1에서 좌 / 마지막 맵에서 우 — 아무 반응 없음)
		-- 129~133(ep3_map4_ester_1 히든맵, portal-3 전용 — [[project_ep3map4_ester1_portal]])은
		-- MaxMapIndex(에피3=128) 밖이지만 유효한 목적지다(ZoneInfo엔 등록돼 있음) — 정상 진행으로는
		-- 절대 도달 못 하고(MoveByDelta의 129/133 막다른 길 분기 참고) 오직 존1(129) 진입은
		-- Ep3Map4Ester1PortalLogic이, 존간 이동(130~132)은 이 예외를 타고 여기까지 온다.
		local isEsterZone = targetIndex >= 129 and targetIndex <= 133
		if (targetIndex < self.MinMapIndex or targetIndex > self.MaxMapIndex) and not isEsterZone then return end
		if targetIndex == fromIndex then return end

		-- 이전 이동이 아직 "확정 대기" 중이면 이번 요청은 무시한다(연타 방지)
		if self._moveLocked then
			log("MapManager: move ignored (cooldown) fromIndex=" .. fromIndex .. " targetIndex=" .. targetIndex)
			return
		end
		self._moveLocked = true
		_TimerService:SetTimerOnce(function()
			if isvalid(self) then self._moveLocked = false end
		end, self.MoveCooldownDuration)

		-- 맵4 이상은 레벨5가 되기 전까지 잠겨있다 (예전엔 보스 처치 기준이었는데, 보스를 못 잡는
		-- 버그가 생길 경우 진행이 완전히 막히는 걸 막기 위해 레벨 기준으로 바꿨다. 2026-08-04:
		-- 유저 요청으로 기준 레벨을 10→5로 완화 — MapMoveUI.mlua의 자물쇠 표시 기준과 반드시 같이 맞춰야 한다)
		-- 2026-08-10: 에피소드2(존1~10 = 내부 mapIndex 45~54) 추가로 이 절대 인덱스 비교가 깨졌었다 —
		-- 45~54는 전부 4 이상이라 에피소드2의 첫 이동(존1→존2)부터 무조건 잠겨서 아예 못 움직이는
		-- 버그였다(유저 리포트로 발견). 에피소드별 "그 에피소드 안에서 몇 번째 존인지"로 환산해서
		-- 비교해야 한다 — 에피1은 그대로 1~44, 에피2는 45를 빼서 1~10으로 되돌린다.
		-- 2026-08-25: 에피소드3(존1~10 = 내부 mapIndex 89~98) 추가로 89 이상 분기를 먼저 걸어야 한다 —
		-- 45 이상 분기가 먼저면 89도 걸려서(89>=45) 45를 빼 localIndex=45가 되어버려 항상 잠기는 동일한
		-- 버그가 재발한다. 큰 범위부터 먼저 체크.
		local localIndex = targetIndex
		if isEsterZone then
			-- 히든맵은 레벨 잠금 대상이 아니다 — portal-3 진입 자체가 이미 아이템 게이트(자격의 증표)이므로
			-- 별도 레벨 조건을 걸지 않는다.
			localIndex = 0
		elseif targetIndex >= 89 then localIndex = targetIndex - 88
		elseif targetIndex >= 45 then localIndex = targetIndex - 44 end
		-- 임시 테스트 변경(2026-08-26) — 시작 지점을 ep3_map3 존1(109)로 옮겨두면 localIndex가 항상
		-- >=4라 레벨5 미만인 새 캐릭터는 어느 방향으로도 못 움직인다. TestUnlockAllZones로 이 잠금을
		-- 통째로 우회한다 — 테스트 끝나면 false로 되돌릴 것(MapMoveUI 자물쇠 표시도 같이 되돌아감).
		if not self.TestUnlockAllZones and localIndex >= 4 and _GameManager.Level < 5 then
			log("MapManager: map" .. targetIndex .. " (local " .. localIndex .. ") locked until level 5")
			return
		end

		-- 그룹D(맵11↔12)처럼 물리적으로 같은 파일(map11.map)을 공유하는 존 사이 이동은 와이프 대신
		-- 카메라가 옆으로 쓸려가는 스크롤 전환을 쓴다. GetMapName이 같은 파일명을 반환한다는 것 자체가
		-- "같은 물리 맵"이라는 판정 기준이다. 그 외(파일이 실제로 다른 맵)는 기존 와이프 그대로 유지.
		if self:GetMapName(fromIndex) == self:GetMapName(targetIndex) then
			self:DoScrollMapChange(fromIndex, targetIndex)
			return
		end

		-- 화면을 먼저 이동 방향으로 덮은 뒤(와이프 커버), 다 덮인 시점에 실제 텔레포트를 실행한다 —
		-- 순간이동 컷을 가려서 부드럽게 넘어가는 것처럼 보이게 한다
		local direction = "right"
		if targetIndex < fromIndex then direction = "left" end
		_MapTransitionLogic:PlayCover(direction)

		_TimerService:SetTimerOnce(function()
			self:DoMapChange(fromIndex, targetIndex, direction)
		end, _MapTransitionLogic.CoverDuration)
	end

	-- 그룹D(맵11↔12) 전용 스크롤 전환: 맵11/12가 물리적으로 같은 파일 · 같은 발판 그룹이라, 네이티브
	-- confine(ConfineCameraArea)이 이미 맵11 전체 발판 범위(x -14.09~33.92)를 기준으로 자리 잡아 있고
	-- 이 범위는 두 존 사이를 이동해도 전혀 바뀌지 않는다 — 그래서 여기서는 confine을 따로 손대지 않고
	-- (이전엔 존마다 커스텀 confine을 넓혔다 좁혔다 했었는데, 타이밍이 꼬이면 넓힌 상태로 눌러앉아
	-- 화면이 통째로 줌아웃되는 버그가 있었다) 그냥 플레이어만 옮긴다. 네이티브 Damping이 알아서
	-- 옆으로 자연스럽게 따라붙는다 — "처음 맵11에 도착했을 때의 카메라 앵글이 계속 유지된다"는
	-- 요청과도 정확히 맞아떨어진다(confine을 아예 안 바꾸니까).
	-- 버그 수정(2026-08-25) — DoScrollMapChange 아래 코멘트 참고. 직전 존과 착지 Y가 이 오차 이내로
	-- 같으면 "Y가 안 바뀌는 이동"으로 판단해 NoHeightChangeYNudge만큼 위로 띄워 강제 재낙하시킨다.
	property number NoHeightChangeYThreshold = 0.02
	property number NoHeightChangeYNudge = 0.15

	@ExecSpace("ServerOnly")
	method void DoScrollMapChange(integer fromIndex, integer targetIndex)
		local mapName = self:GetMapName(targetIndex)
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapName)
		if mapEntity == nil then
			log_error("MapManager: " .. mapName .. " not found")
			return
		end

		self:ResetCameraConfine(targetIndex)

		-- _TeleportService:TeleportToMapPosition은 "다른 맵으로" 이동을 전제로 한 API라, 목적지 맵 이름이
		-- 지금 있는 맵과 같으면(그룹D처럼 물리적으로 같은 파일) 위치가 갱신되지 않고 조용히 무시된다
		-- (실측 확인됨) — 같은 파일 내부 이동이므로 직접 재배치한다. 다만 TransformComponent.Position을
		-- 그냥 대입하면 RigidbodyComponent가 그 이동을 인지하지 못해 새 발판으로 낙하/스냅되지 않고
		-- 허공에 그대로 떠 있는다(실측 확인됨) — RigidbodyComponent:SetPosition으로 물리 바디까지 갱신한다.
		-- Y는 GetSpawnPositionForIndex의 SpawnPosition.y(0.2, 최초 스폰/와이프 전환 전용값)를 쓰지 않고
		-- 플레이어의 "현재" Y를 그대로 유지한다 — 그룹 안의 모든 존은 지면 Y가 동일하도록 병합했으므로
		-- (§6 카메라 고정 앵글) X만 바꿔도 항상 같은 발판 위다. 예전처럼 spawnPos.y(0.2)로 옮기면 실제
		-- 지면(-1.xx)보다 한참 위라 중력에 끌려 짧게 낙하하는 게 화면에 그대로 보여 "붕 떴다 가라앉는"
		-- 것처럼 보이는 버그가 있었다(맵1~3 병합 그룹에서 실측 확인).
		-- ZoneInfo에 landY가 명시된 존(예: 존25 — 공통 지면과 다른 높이에 새 발판이 있는 경우)은 그 값을
		-- 착지 Y로 강제한다. "이전 존 Y 재사용" 기본 규칙이 깨지는 지형 예외를 존 단위로 표시하는 용도다.
		local spawnX = self:GetSpawnPositionForIndex(targetIndex).x
		local targetZoneInfo = self:GetZoneInfo(targetIndex)
		local landY = (targetZoneInfo ~= nil and targetZoneInfo.landY ~= nil) and targetZoneInfo.landY or nil
		for _, userEntity in pairs(_UserService.UserEntities) do
			local rigidbody = userEntity.RigidbodyComponent
			local y = (landY ~= nil) and landY or userEntity.TransformComponent.WorldPosition.y
			if rigidbody ~= nil then
				-- 버그 수정(2026-08-25, 유저 리포트 "존5 화면 튕김") — 처음엔 직전 존과 착지 Y가 완전히
				-- 같은 이동에서만 재현되는 줄 알고 그 경우에만 넛지를 걸었었다. SetPosition은 위치를
				-- 즉시 갱신하지만, 물리엔진이 "발판이 그대로다"로 오판해 새 X의 발판을 다시 인식하지
				-- 않고 그대로 허공에 남아 떨어지는 것으로 추정된다(PositionReset/SetWorldPosition으로도
				-- 안 고쳐졌던 것과 일치 — 물리 갱신이 아니라 발판 재탐지 자체가 안 되는 문제).
				-- 재확인(2026-08-26, 유저 리포트 "4번째가 그러네") — 존3→존4(-1.28→-0.68, Y가 실제로
				-- 바뀌는 이동)에서도 동일 증상이 실측 확인됨(YCHK 로그: t0 -0.79 → t0.1 -1.10 →
				-- t0.3 -2.33까지 계속 낙하하다 세이프티넷 발동). 존4의 발판(Id79~83, x=43.31~48.49,
				-- 폭 5.14로 좁은 "섬" 지형)처럼 특정 지형에서는 Y가 달라도 같은 문제가 재현된다는 뜻이라,
				-- "Y가 같을 때만" 조건을 없애고 항상 살짝 위로(NoHeightChangeYNudge) 띄워서 매번 실제
				-- 낙하가 한 프레임 이상 발생하도록 강제한다 — 원래도 무해한 트릭이었고(기존 통과하던
				-- 전환들에서 0.15만큼 잠깐 더 높이 착지하다 내려오는 건 육안으로 안 보임), 이제 모든
				-- 존 스크롤 전환에 예외 없이 적용한다.
				rigidbody:SetPosition(Vector2(spawnX, y + self.NoHeightChangeYNudge))
			else
				userEntity.TransformComponent.Position = Vector3(spawnX, y, 0)
			end
		end

		local oldMapEntity = _MonsterSpawner:GetZoneEntity(fromIndex)
		local newMapEntity = _MonsterSpawner:GetZoneEntity(targetIndex)
		self:SetMonstersPausedForZone(oldMapEntity, fromIndex, true)
		self:SetMonstersPausedForZone(newMapEntity, targetIndex, false)

		-- ActivateMap보다 먼저 갱신 — MonsterSpawner.GetCurrentMap()이 이 값을 기준으로 "지금 도착한
		-- 맵인지"를 판정하므로, 나중에 갱신하면 첫 방문 스폰 시점의 몬스터가 전부 Pause된 채로 태어나서
		-- 영구히 멈춰있는 버그가 생긴다(실측 확인).
		self.CurrentMapIndex = targetIndex

		-- 맵10(보너스 스테이지)은 일반 웨이브 스폰 대신 매번 입장할 때마다 보너스 보스 등장 여부를
		-- 판정하는 별도 진입점을 타야 한다 — DoMapChange/SilentMoveToMap엔 이 분기가 있었는데
		-- DoScrollMapChange엔 그룹D(맵11/12) 전용으로 작성될 당시엔 맵10이 관여하지 않아 빠져 있었다.
		-- 그룹C 병합으로 존9→10 이동이 이제 이 스크롤 경로를 타게 되면서, 무조건 ActivateMap만 불러
		-- 보너스 보스 대신 매번 일반 웨이브가 스폰되는 버그가 있었다(실측 확인).
		-- 실제 이동 버튼 결과다(countsAsMove=true) — 빠른 이동 스트릭에 반영한다.
		self:RegisterZoneArrival(targetIndex, true)
		if targetIndex == 10 then
			_MonsterSpawner:TryStartBonusStage()
		else
			_MonsterSpawner:ActivateMap(targetIndex)
		end

		log("MapManager: scrolled to zone " .. targetIndex .. " (" .. mapName .. ")")
		self:TriggerBgmIfFileChanged(mapName)
		_MapMoveUI:NotifyMapChanged(targetIndex)
		-- 존15 이스터에그: 도착했을 때만 알려준다(재입장 시 불꽃이 아직 안 풀렸으면 다시 꺼지는 연출)
		if targetIndex == 15 then _Zone15PuzzleLogic:OnEnterZone15() end
	end

	-- CameraComponent는 CameraService.GetCurrentCameraComponent()가 ClientOnly라 서버에서 직접 만질 수
	-- 없다(호출해도 조용히 nil) — Multicast로 클라이언트에서 실제로 손댄다. UseCustomBound를 꺼서
	-- 네이티브 ConfineCameraArea(맵11 전체 발판 범위 기준)로 되돌린다 — 이전 커스텀 confine 실험이
	-- 남긴 값이 있으면 그걸로 눌러앉는 문제를 막기 위해 매 스크롤 전환마다 확실히 리셋한다. 겸사겸사
	-- DefaultZoomRatio도 같이 맞춰서, 게임 시작이든 존 스크롤 전환이든 항상 같은 줌 값을 유지한다.
	-- 버그 수정(2026-08-22): mapIndex를 파라미터로 명시적으로 받는다 — DoScrollMapChange에서
	-- self.CurrentMapIndex는 이 호출 시점엔 아직 fromIndex(이동 전 존)로 남아있고 targetIndex로
	-- 갱신되는 건 이 호출 "이후"라(MonsterSpawner.GetCurrentMap 판정 때문에 일부러 늦게 갱신하도록
	-- 짜여있음), self.CurrentMapIndex를 그대로 읽으면 한 존 뒤처진 값으로 판정해버린다.
	-- 네이티브 DeadZone/SoftZone(카메라가 타겟을 따라가는 화면 비율 영역) 기본값 — 카메라 Y고정 존을
	-- 벗어날 때 여기로 복원한다.
	property Vector2 DefaultDeadZone = Vector2(0.052, 0.080)
	property Vector2 DefaultSoftZone = Vector2(0.268, 0.750)

	@ExecSpace("Multicast")
	method void ResetCameraConfine(integer mapIndex)
		if not self:IsClient() then return end
		self:ApplyDefaultZoomImmediate()
		local cam = _CameraService:GetCurrentCameraComponent()
		if cam == nil then return end
		cam.Damping = self.ScrollCameraDamping
		if mapIndex >= 65 and mapIndex <= 74 then
			-- ep2_map3(존1~10) 체류 중엔 존4~5 계단 지형으로 인한 카메라 높낮이 변화를 없애기 위해
			-- Y를 고정한 커스텀 confine을 쓴다(위 프로퍼티 주석 참고). X는 맵 전체 발판 범위 그대로라
			-- 좌우 스크롤 동작은 기존과 동일하다.
			-- 버그 수정(2026-08-25, ep3_map3/4와 동일한 근본 원인 — 유저 지정 "ep2_map3도 같은 문제
			-- 있으니 변경") — ConfineCameraArea(기본 true)를 꺼두지 않으면 네이티브가 여전히 그 존의
			-- 실제 발판 높이를 따라 카메라를 자체 confine해버려 커스텀 박스가 무력화된다.
			cam.ConfineCameraArea = false
			cam.UseCustomBound = true
			cam.LeftBottom = Vector2(self.Ep2Map3ConfineMinX, self.Ep2Map3FixedCameraY)
			cam.RightTop = Vector2(self.Ep2Map3ConfineMaxX, self.Ep2Map3FixedCameraY)
			cam.DeadZone = Vector2(self.DefaultDeadZone.x, 1.0)
			cam.SoftZone = Vector2(self.DefaultSoftZone.x, 1.0)
		elseif mapIndex >= 109 and mapIndex <= 118 then
			-- 에피소드3 map3(존1~10) — 유저 지정: "존1(root)랑 같은 카메라 위치를 가지고 싶은데... 존1
			-- 기준으로 쭉 카메라 앵글 이동없이 10까지". Y를 존1 기준 고정한다.
			-- 버그 수정(2026-08-25, 유저 스크린샷으로 실측 확인 — DeadZone/SoftZone만 넓혀도 여전히
			-- 존109→111에서 카메라가 위로 튀는 게 재현됨). 근본 원인: CameraComponent.ConfineCameraArea
			-- (기본값 true, "발판 영역만 비추게 confine")가 UseCustomBound와 별개의 스위치라서, 계속
			-- true인 채로 있으면 커스텀 LeftBottom/RightTop을 켜놔도 네이티브가 여전히 그 존의 실제
			-- 발판(foothold) 높이를 따라 카메라를 자체적으로 다시 confine해버린다(mlua_api_retriever로
			-- CameraComponent 문서 재확인 — UseCustomBound 설명에 "When this is False, you will use the
			-- map area..."만 있고 ConfineCameraArea와의 우선순위는 별도임을 확인). 그래서 반드시
			-- ConfineCameraArea도 함께 false로 꺼야 커스텀 박스가 실제로 유일한 confine 기준이 된다.
			cam.ConfineCameraArea = false
			cam.UseCustomBound = true
			cam.LeftBottom = Vector2(self.Ep3Map3ConfineMinX, self.Ep3Map3FixedCameraY)
			cam.RightTop = Vector2(self.Ep3Map3ConfineMaxX, self.Ep3Map3FixedCameraY)
			cam.DeadZone = Vector2(self.DefaultDeadZone.x, 1.0)
			cam.SoftZone = Vector2(self.DefaultSoftZone.x, 1.0)
		elseif mapIndex >= 119 and mapIndex <= 128 then
			-- 에피소드3 map4(존1~10) — 유저 지정, map3와 동일한 이유로 동일 패턴 적용.
			cam.ConfineCameraArea = false
			cam.UseCustomBound = true
			cam.LeftBottom = Vector2(self.Ep3Map4ConfineMinX, self.Ep3Map4FixedCameraY)
			cam.RightTop = Vector2(self.Ep3Map4ConfineMaxX, self.Ep3Map4FixedCameraY)
			cam.DeadZone = Vector2(self.DefaultDeadZone.x, 1.0)
			cam.SoftZone = Vector2(self.DefaultSoftZone.x, 1.0)
		elseif mapIndex >= 129 and mapIndex <= 133 then
			-- ep3_map4_ester_1(히든맵) — 위 프로퍼티 주석 참고, ep3_map3/4와 동일 패턴.
			cam.ConfineCameraArea = false
			cam.UseCustomBound = true
			cam.LeftBottom = Vector2(self.Ep3Map4Ester1ConfineMinX, self.Ep3Map4Ester1FixedCameraY)
			cam.RightTop = Vector2(self.Ep3Map4Ester1ConfineMaxX, self.Ep3Map4Ester1FixedCameraY)
			cam.DeadZone = Vector2(self.DefaultDeadZone.x, 1.0)
			cam.SoftZone = Vector2(self.DefaultSoftZone.x, 1.0)
		else
			cam.ConfineCameraArea = true
			cam.UseCustomBound = false
			cam.DeadZone = self.DefaultDeadZone
			cam.SoftZone = self.DefaultSoftZone
		end
	end

	-- Ep2Map4GalleryPortalTrigger.RequestEnterGallery()가 플레이어를 갤러리 맵으로 텔레포트시킨 직후
	-- 호출 — mapIndex 분기가 없는 별도 맵이라 ResetCameraConfine을 안 타므로 여기서 직접 카메라를
	-- 고정한다(유저 지정: "존 중심을 골든맘무트가 있는 y축정도로").
	-- targetUserId를 지정하는 "Client"로 선언돼 있었는데, 라이브 테스트에서 매번
	-- "[LEA-3032] FailedSendToClient: TargetUserId ... 유효하지 않습니다" 에러가 발생해 실제로는
	-- 전달이 안 되고 있었다(이 프로젝트는 월드당 플레이어 1명뿐이라 Multicast로 바꿔도 안전하다).
	@ExecSpace("Multicast")
	method void SetGalleryCameraConfine()
		local cam = _CameraService:GetCurrentCameraComponent()
		if cam == nil then return end
		cam.UseCustomBound = true
		cam.LeftBottom = Vector2(self.GalleryConfineMinX, self.GalleryFixedCameraY)
		cam.RightTop = Vector2(self.GalleryConfineMaxX, self.GalleryFixedCameraY)
	end

	-- 타이틀 화면이 뜨기도 전에(TitleUI 클라이언트 OnBeginPlay에서) 곧바로 호출해서 줌을 맞춘다.
	-- BeginGameplay 시점(ResetCameraConfine, "게임 시작" 클릭 후)까지 기다리면 그 사이엔 네이티브
	-- 기본 줌(100)으로 한 프레임 이상 렌더링되다가 DefaultZoomRatio(115)로 튀어서, 유저 눈에는
	-- "줌인 상태로 시작했다가 줌아웃되는" 것처럼 보이는 버그가 있었다(실제로 접속하는 매 클라이언트마다
	-- 재현). Multicast가 아니라 ClientOnly로 둬서 그 클라이언트가 접속하는 즉시(서버의 Multicast
	-- 브로드캐스트를 기다리지 않고) 스스로 적용할 수 있게 한다.
	@ExecSpace("ClientOnly")
	method void ApplyDefaultZoomImmediate()
		local cam = _CameraService:GetCurrentCameraComponent()
		if cam == nil then return end
		cam.ZoomRatio = self.DefaultZoomRatio
	end

	-- SilentMoveToMap(게임 시작 리다이렉트)은 MapTransitionLogic의 와이프 커버 같은 가림막이 없다 —
	-- 그 상태에서 카메라 Damping이 그대로면 새 스폰 지점까지 천천히 미끄러져 따라붙는 움직임이 그대로
	-- 노출되어 "시작하자마자 화면이 살짝 흔들린다"는 것처럼 보인다(실측 확인). 텔레포트 직전에 Damping을
	-- 거의 0으로 낮춰 순간 스냅되게 하고, 가림막이 없으니 아주 짧게(SilentMoveDampingRestoreDelay)만
	-- 기다렸다가 원래 값으로 복구한다(MapTransitionLogic.PlayCover/PlayReveal과 같은 패턴).
	@ExecSpace("Multicast")
	method void SnapCameraForSilentMove()
		if not self:IsClient() then return end
		local cam = _CameraService:GetCurrentCameraComponent()
		if cam == nil then return end
		if not self._silentMoveDampingSaved then
			self._savedSilentMoveDamping = cam.Damping
			self._silentMoveDampingSaved = true
			cam.Damping = Vector2(0.001, 0.001)
		end
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			local c = _CameraService:GetCurrentCameraComponent()
			if c ~= nil and self._silentMoveDampingSaved then
				c.Damping = self._savedSilentMoveDamping
				self._silentMoveDampingSaved = false
			end
		end, self.SilentMoveDampingRestoreDelay)
	end

	@ExecSpace("ServerOnly")
	method void DoMapChange(integer fromIndex, integer targetIndex, string direction)
		-- 와이프가 화면을 다 덮은 뒤 실행되는 실제 텔레포트 + 몬스터 일시정지/재개 처리
		local mapName = self:GetMapName(targetIndex)
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapName)
		if mapEntity == nil then
			log_error("MapManager: " .. mapName .. " not found")
			_MapTransitionLogic:PlayReveal(direction)
			return
		end

		-- 텔레포트를 먼저 실행해야 한다 — ActivateMap()이 내부에서 "지금 내가 있는 맵"을 실제 엔티티
		-- 위치로 판정하는데(MonsterSpawner.GetCurrentMap), 텔레포트보다 먼저 스폰하면 아직 예전 맵에
		-- 있는 것으로 판정되어 방금 도착한 맵의 새 몬스터가 거꾸로 일시정지된 채로 태어난다.
		for _, userEntity in pairs(_UserService.UserEntities) do
			_TeleportService:TeleportToMapPosition(userEntity, self:GetSpawnPositionForIndex(targetIndex), mapName)
		end

		-- 버그 수정(2026-08-22): DoScrollMapChange(같은 파일 내부 이동)만 카메라 confine을 리셋하고
		-- 있었다 — DoMapChange(다른 파일로 이동하는 와이프 전환)는 원래 confine을 전혀 안 건드리는데,
		-- ep2_map3용 커스텀 confine(UseCustomBound=true)을 켠 채로 다른 맵으로 넘어가면 그 값이 그대로
		-- 눌러앉아 새 맵에서도 카메라가 Y로 고정된 채 안 움직이는 회귀 버그가 생긴다. ep2_map3 밖으로
		-- 나가거나 안으로 들어올 때도 여기서 명시적으로 리셋한다.
		self:ResetCameraConfine(targetIndex)

		-- 떠나는 맵의 몬스터는 일시정지(공격/접근 중단) — 안 그러면 화면 밖에서 계속 타이머가 돌아
		-- 플레이어가 안 보고 있어도 GameManager에 피해를 입힌다. 도착한 맵의 몬스터는 재개.
		-- mapEntity는 루트 맵 엔티티라(EntityByPath("/maps/"..mapName)), targetIndex가 Zone14/15/17/18
		-- 같은 자식 컨테이너 존이면 몬스터가 그 밑에 없어 SetMonstersPaused가 아무도 못 찾고 조용히
		-- 아무 일도 안 한다 — GetZoneEntity로 다시 조회해야 실제 몬스터가 있는 컨테이너를 찾는다
		-- (실측 확인 — 존16→15처럼 다른 파일에서 자식 컨테이너 존으로 들어올 때만 재현되고, 같은 파일
		-- 내부 이동(DoScrollMapChange)이나 루트 존으로 들어올 때는 mapEntity 자체가 맞아서 안 드러났다).
		local oldMapEntity = _MonsterSpawner:GetZoneEntity(fromIndex)
		local newMapEntity = _MonsterSpawner:GetZoneEntity(targetIndex)
		self:SetMonstersPausedForZone(oldMapEntity, fromIndex, true)
		self:SetMonstersPausedForZone(newMapEntity, targetIndex, false)

		-- ActivateMap보다 먼저 갱신해야 한다 — MonsterSpawner.SpawnBatchOnMap이 "지금 도착한 맵인지"를
		-- GetCurrentMap()(=GetZoneEntity(_MapManager.CurrentMapIndex))으로 판정하는데, 텔레포트로 유저
		-- 엔티티 위치를 옮기는 것과는 별개로 이 인덱스 자체를 갱신해야 판정이 맞다 — 나중에 갱신하면 첫
		-- 방문 스폰 시점엔 아직 옛 인덱스라 "다른 맵"으로 오판해서 방금 태어난 몬스터를 전부 Pause()해
		-- 버리고, 그 뒤로 아무도 다시 Resume()을 불러주지 않아 영구히 멈춰있는 것처럼 보인다(실측 확인 —
		-- "이동할 때 가끔 몬스터가 멈춰있다"는 문제의 원인. 위 텔레포트-먼저 코멘트는 진짜 원인이 아니었다).
		self.CurrentMapIndex = targetIndex

		-- 처음 가보는 맵이면 여기서 스폰이 시작된다 (이미 활성화된 맵이면 아무 일도 안 함). 맵10(보너스
		-- 스테이지)은 일반 웨이브 스폰 대신 매번 입장할 때마다 보너스 보스 등장 여부를 판정하는 별도
		-- 진입점을 탄다.
		-- 실제 이동 버튼 결과다(countsAsMove=true) — 빠른 이동 스트릭에 반영한다.
		self:RegisterZoneArrival(targetIndex, true)
		if targetIndex == 10 then
			_MonsterSpawner:TryStartBonusStage()
		else
			_MonsterSpawner:ActivateMap(targetIndex)
		end

		log("MapManager: moved to " .. mapName)
		self:TriggerBgmIfFileChanged(mapName)
		-- targetIndex를 파라미터로 직접 넘긴다 — CurrentMapIndex의 @Sync 전파와 이 Multicast 호출은
		-- 서로 다른 채널이라 순서 보장이 없어서, 클라이언트가 NotifyMapChanged 시점에 CurrentMapIndex를
		-- 다시 읽으면 아직 갱신 전(이전 값)을 볼 수 있다 — 값 자체를 인자로 넘겨야 확실하다
		_MapMoveUI:NotifyMapChanged(targetIndex)
		-- 존15 이스터에그: 도착했을 때만 알려준다(재입장 시 불꽃이 아직 안 풀렸으면 다시 꺼지는 연출)
		if targetIndex == 15 then _Zone15PuzzleLogic:OnEnterZone15() end

		-- 텔레포트 직후 카메라가 새 맵 발판 범위에 맞춰 자리 잡는 데 실측 0.5~0.8초 정도 걸린다
		-- (Damping을 낮춰도 confine 영역 자체가 바뀌는 건 즉시 스냅되지 않음) — 그 시간만큼 화면을
		-- 가린 채로 더 기다렸다가 걷어내야 리빌 도중/직후에 카메라가 움직이는 게 보이지 않는다
		_TimerService:SetTimerOnce(function()
			_MapTransitionLogic:PlayReveal(direction)
		end, _MapTransitionLogic.CameraSettleDelay)
	end

end
