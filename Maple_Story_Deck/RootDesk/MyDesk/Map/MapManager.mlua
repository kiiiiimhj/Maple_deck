			[102] = { file = "ep3_map2", container = "Zone4", spawnX = 46.5, landY = -0.64 },
			[103] = { file = "ep3_map2", container = "Zone5", spawnX = 62.0, landY = -0.04 },
			[104] = { file = "ep3_map2", container = "Zone6", spawnX = 77.5, landY = -1.24 },
			[105] = { file = "ep3_map2", container = "Zone7", spawnX = 93.0, landY = -1.24 },
			[106] = { file = "ep3_map2", container = "Zone8", spawnX = 108.5, landY = -1.24 },
			[107] = { file = "ep3_map2", container = "Zone9", spawnX = 124.0, landY = -1.24 },
			[108] = { file = "ep3_map2", container = "Zone10", spawnX = 139.5, landY = -1.24 },

			-- 에피소드3 map3(ep3_map3.map, 유저가 다른 맵을 덤프해서 만듦) — 존1~10을 mapIndex 109~118로
			-- 배정한다. container/spawnX는 덤프 원본 그대로 유지된 값을 MapBuilder로 실측 확인(15.5 간격,
			-- 기존 그룹들과 동일). landY는 각 존의 spawnX 지점에서 실제로 가장 위에 걸리는(=중력이 착지시킬)
			-- 발판을 실측해 명시한다 — 존1/2/7/8/10은 공중 발판(y=1.12/0.52)이 공통지면보다 먼저 걸려
			-- 그쪽이 진짜 착지 지점이고, 존4/5는 map1/2와 달리 이 맵만의 독자적인 둔덕/단(y=-0.68/-0.08)이다.
			[109] = { file = "ep3_map3", container = nil, spawnX = 0, landY = 1.12 },
			[110] = { file = "ep3_map3", container = "Zone2", spawnX = 15.5, landY = 1.12 },
			[111] = { file = "ep3_map3", container = "Zone3", spawnX = 31.0, landY = -1.28 },
			[112] = { file = "ep3_map3", container = "Zone4", spawnX = 46.5, landY = -0.68 },
			[113] = { file = "ep3_map3", container = "Zone5", spawnX = 62.0, landY = -0.08 },
			[114] = { file = "ep3_map3", container = "Zone6", spawnX = 77.5, landY = -1.28 },
			[115] = { file = "ep3_map3", container = "Zone7", spawnX = 93.0, landY = 0.52 },
			[116] = { file = "ep3_map3", container = "Zone8", spawnX = 108.5, landY = 1.12 },
			[117] = { file = "ep3_map3", container = "Zone9", spawnX = 124.0, landY = -1.28 },
			[118] = { file = "ep3_map3", container = "Zone10", spawnX = 139.5, landY = 0.52 },
			[119] = { file = "ep3_map4", container = nil, spawnX = 0, landY = 1.12 },
			[120] = { file = "ep3_map4", container = "Zone2", spawnX = 15.5, landY = 1.12 },
			[121] = { file = "ep3_map4", container = "Zone3", spawnX = 31.0, landY = 1.12 },
			[122] = { file = "ep3_map4", container = "Zone4", spawnX = 46.5, landY = -0.68 },
			[123] = { file = "ep3_map4", container = "Zone5", spawnX = 62.0, landY = -0.68 },
			[124] = { file = "ep3_map4", container = "Zone6", spawnX = 77.5, landY = -1.28 },
			[125] = { file = "ep3_map4", container = "Zone7", spawnX = 93.0, landY = 0.52 },
			[126] = { file = "ep3_map4", container = "Zone8", spawnX = 108.5, landY = 1.12 },
			[127] = { file = "ep3_map4", container = "Zone9", spawnX = 124.0, landY = -1.28 },
			[128] = { file = "ep3_map4", container = "Zone10", spawnX = 139.5, landY = 0.52 },
			-- ep3_map4_ester_1(히든맵, portal-3 전용 — [[project_ep3map4_ester1_portal]]) — MaxMapIndex(128)
			-- 밖이라 일반 MoveByDelta/화살표 이동으로는 절대 도달 못 하고, Ep3Map4Ester1PortalLogic이
			-- 직접 CurrentMapIndex를 129로 세팅하는 방식으로만 진입한다(SilentMoveToMap/MoveToMap은
			-- MaxMapIndex 가드에 막혀 못 씀). 실측 결과 이 파일은 Zone2~Zone10 마커(스폰X 전용, 15.5
			-- 간격 — 다른 그룹과 동일 패턴)까지 이미 있어 총 10존 분량 지형이 있지만, 이번엔 유저 지정대로
			-- 5존(129~133)만 등록한다 — 존간 이동(Zone1→2...) 트리거는 아직 안 만들어서 실제로는 항상
			-- 존1(129)에서 시작해 60초 뒤 자동 퇴장한다. container는 다른 container=nil 존 그룹(맵3/4)과
			-- 동일하게 nil(지형이 물리적으로 이어진 한 파일 — Zone2~10은 그냥 좌표 마커일 뿐 별도 엔티티 아님).
			-- landY 실측(getFootholds): 존1~3(x=0/15.5/31) 지면 -1.08, 존4~5(x=46.5/62)는 둔덕처럼
			-- 한 단 높은 -0.48 — 버그 수정(2026-08-27, 유저 리포트: "3번에서 4번 이동하니깐 여전히
			-- 튕겨") landY를 안 주면 DoScrollMapChange가 "이전 존 Y 그대로 재사용"해서 존3(-1.08)에서
			-- 존4로 넘어갈 때 실제 둔덕 높이(-0.48)보다 낮게 착지 → 존39/존122(ep3_map4 존4)와 동일한
			-- 원인의 튕김 버그. 5존 전부 명시적으로 지정(ep3_map3/4 관례와 동일하게 전부 명시).
			[129] = { file = "ep3_map4_ester_1", container = nil, spawnX = 0, landY = -1.08 },
			[130] = { file = "ep3_map4_ester_1", container = nil, spawnX = 15.5, landY = -1.08 },
			[131] = { file = "ep3_map4_ester_1", container = nil, spawnX = 31.0, landY = -1.08 },
			[132] = { file = "ep3_map4_ester_1", container = nil, spawnX = 46.5, landY = -0.48 },
			[133] = { file = "ep3_map4_ester_1", container = nil, spawnX = 62.0, landY = -0.48 },
		}
		-- 몬스터 스폰/시작맵 리다이렉트는 GameStarted가 될 때까지 미룬다(BeginGameplay 참고) —
		-- 타이틀 화면을 보는 동안 몬스터가 먼저 쌓이면 안 된다. 여기서는 현재 위치만 계산해둔다.
		self.CurrentMapIndex = self:ResolveCurrentMapIndex()
		log("MapManager started at " .. self:GetMapName(self.CurrentMapIndex))
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		if name == "CurrentMapIndex" then
			-- 화면(카메라)이 통째로 바뀌는 시점 — 바닥까지 낙하/홉 중이던 잡템 드롭 아이콘이 있으면
			-- 그 연출을 마저 재생하지 않고 지금 위치에서 곧장 가방으로 날아가게 해서, 이전 화면의
			-- 아이템이 새 화면 위에 그대로 남아있는 것처럼 보이지 않게 한다
			_GameManager:ForceFinishLootDrops()
		end
	end

	-- GameManager.StartGame()이 "게임 시작" 클릭 시 호출 — 여기서 처음으로 몬스터 스폰을 활성화한다
	@ExecSpace("ServerOnly")
	method void BeginGameplay()
		_MonsterSpawner:ActivateMap(self.CurrentMapIndex)
		_MonsterSpawner:BeginGameplay()
		self:ResetCameraConfine(self.CurrentMapIndex)
		self:ForcePlayBgmForCurrentMap()
	end

	-- "게임 시작"/"다시하기" 전용 — 로비 화면(TitleUI)이 StopBGM(true)로 채널을 이미 끊어놨을 수 있으므로,
	-- 지금 있는 맵 파일이 방금 전과 같아도(_lastBgmMapFile 미변경) 무조건 다시 재생한다. 같은 파일 안의
	-- 존 스크롤 중에는 계속 이어져야 하는 TriggerBgmIfFileChanged(중복 호출 방지)와는 반대 목적이라
	-- 별도 메서드로 분리했다.
	@ExecSpace("ServerOnly")
	method void ForcePlayBgmForCurrentMap()
		local mapName = self:GetMapName(self.CurrentMapIndex)
		self._lastBgmMapFile = mapName
		self:NotifyBgmMapChanged(mapName)
	end

	-- DoMapChange/DoScrollMapChange 전용 — 물리 맵 파일이 실제로 바뀌었을 때만 BGM을 다시 튼다.
	-- 같은 파일 안에서의 존 스크롤(예: ep2_map1 존1↔존2)은 파일명이 안 바뀌므로 여기서 걸러져 BGM이
	-- 끊김 없이 계속 이어진다.
	@ExecSpace("ServerOnly")
	method void TriggerBgmIfFileChanged(string mapName)
		if mapName == self._lastBgmMapFile then return end
		self._lastBgmMapFile = mapName
		self:NotifyBgmMapChanged(mapName)
	end

	-- 실제 BGM 재생은 클라이언트 전용(SoundService) — 대상 맵 파일 루트 엔티티에 이미 박혀있는
	-- SoundComponent.AudioClipRUID를 그대로 재생한다. RUID를 여기 따로 하드코딩하지 않으므로 나중에
	-- 맵의 BGM을 바꾸면(SoundComponent만 고치면) 이 로직도 자동으로 새 곡을 따라간다.
	@ExecSpace("Multicast")
	method void NotifyBgmMapChanged(string mapFile)
		if not self:IsClient() then return end
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapFile)
		if mapEntity == nil then return end
		local sound = mapEntity.SoundComponent
		if sound == nil or sound.AudioClipRUID == "" then return end
		_SoundService:StopBGM(true)
		_SoundService:PlayBGM(sound.AudioClipRUID, 1.0)
		log("MapManager: BGM -> " .. mapFile)
	end

	-- DesiredStartMapIndex로 1회 리다이렉트. 월드 시작 직후에는 _UserService.UserEntities가 아직
	-- 비어있을 수 있어(OnBeginPlay 시점 유저 미접속) 매 프레임 재시도하다가, 유저가 실제로 확인되는
	-- 첫 프레임에 MoveToMap으로 옮긴다. 이미 원하는 맵이면(또는 나중에 StartPoint를 Maker에서 직접
	-- 고치면) 아무 것도 하지 않고 바로 종료한다.
	-- GameStarted를 기다리지 않는다 — 타이틀 화면이 이미 전체 화면을 가리고 있으므로, 리다이렉트를
	-- 여기서(타이틀 화면 뒤에서) 미리 끝내두면 "게임 시작"을 눌러 타이틀이 사라지는 순간엔 카메라가
	-- 이미 정확한 위치에 자리 잡은 상태다. 예전엔 GameStarted가 될 때까지 기다렸다가 리다이렉트해서,
	-- 타이틀이 사라진 직후 카메라가 새 위치로 따라붙는 움직임이 짧게 보이는 문제가 있었다(실측 확인 —
	-- Damping을 아무리 낮춰도 완전히 없어지지 않았다). 몬스터 스폰 활성화는 별도로 BeginGameplay()가
	-- GameStarted 시점에 맡으므로(SilentMoveToMap 안의 ActivateMap 호출은 GameStarted 가드로 막아둠),
	-- 여기서 미리 이동해도 웨이브가 타이틀 화면 중에 먼저 쌓이는 일은 없다.
	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if self._startRedirectDone then return end
		local hasUser = false
		for _, userEntity in pairs(_UserService.UserEntities) do
			hasUser = true
			break
		end
		if not hasUser then return end
		-- 유저가 실제로 접속한 뒤에야 진짜 위치를 다시 계산한다 — OnBeginPlay 시점엔 아직 아무도
		-- 접속 전이라 ResolveCurrentMapIndex가 항상 MinMapIndex(기본값)로 폴백하는데, 그 값을 그대로
		-- 믿고 비교하면 DesiredStartMapIndex가 우연히 MinMapIndex와 같을 때 리다이렉트가 트리거조차
		-- 안 되는 버그가 있었다(네이티브 DefaultUserEnterLeaveLogic.StartPoint가 다른 맵을 가리켜도
		-- 절대 교정되지 않음 — 실측으로 발견).
		self.CurrentMapIndex = self:ResolveCurrentMapIndex()
		if self.CurrentMapIndex == self.DesiredStartMapIndex then
			self._startRedirectDone = true
			return
		end
		self._startRedirectDone = true
		self:SilentMoveToMap(self.CurrentMapIndex, self.DesiredStartMapIndex)
	end

	-- 게임 시작 리다이렉트 전용: 와이프 커버/리빌 연출 없이 즉시 텔레포트한다. 일반 좌우 이동(MoveToMap)과
	-- 달리 "맵을 이동했다"는 느낌을 주면 안 되고, 그냥 처음부터 DesiredStartMapIndex에서 시작한 것처럼 보여야 한다.
	@ExecSpace("ServerOnly")
	method void SilentMoveToMap(integer fromIndex, integer targetIndex)
		if targetIndex < self.MinMapIndex or targetIndex > self.MaxMapIndex then return end
		if targetIndex == fromIndex then return end

		local mapName = self:GetMapName(targetIndex)
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapName)
		if mapEntity == nil then
			log_error("MapManager: " .. mapName .. " not found")
			return
		end

		-- 이 텔레포트엔 와이프 커버가 없어서(MapTransitionLogic처럼 화면을 가릴 게 없다) 카메라 Damping이
		-- 그대로면 새 스폰 지점까지 0.5~0.8초 동안 부드럽게 미끄러져 따라붙는 움직임이 그대로 노출돼
		-- "시작하자마자 화면이 살짝 흔들린다"는 것처럼 보인다. Damping을 순간적으로 0에 가깝게 낮췄다가
		-- 짧게 복구해서 즉시 스냅되게 한다(와이프가 없으니 복구를 오래 미룰 필요도 없다).
		self:SnapCameraForSilentMove()

		for _, userEntity in pairs(_UserService.UserEntities) do
			_TeleportService:TeleportToMapPosition(userEntity, self:GetSpawnPositionForIndex(targetIndex), mapName)
		end

		local oldMapEntity = _MonsterSpawner:GetZoneEntity(fromIndex)
		local newMapEntity = _MonsterSpawner:GetZoneEntity(targetIndex)
		self:SetMonstersPausedForZone(oldMapEntity, fromIndex, true)
		self:SetMonstersPausedForZone(newMapEntity, targetIndex, false)

		-- ActivateMap보다 먼저 CurrentMapIndex를 갱신해야 한다 — MonsterSpawner.SpawnBatchOnMap이
		-- "지금 도착한 맵이 맞는지"를 GetCurrentMap()(=GetZoneEntity(_MapManager.CurrentMapIndex))으로
		-- 판정하는데, 이걸 나중에 갱신하면 첫 방문 스폰 시점엔 아직 옛 인덱스라 "다른 맵"으로 오판해서
		-- 방금 태어난 몬스터를 전부 Pause()해버린다 — 그 뒤로 아무도 Resume()을 다시 불러주지 않으니
		-- 영구히 멈춰있는 것처럼 보인다(실측 확인 — "이동할 때 가끔 몬스터가 멈춰있다"는 문제의 원인).
		self.CurrentMapIndex = targetIndex

		-- 처음 가보는 맵이면 여기서 스폰이 시작된다. 맵10(보너스 스테이지)은 일반 웨이브 스폰 대신
		-- 매번 입장할 때마다 보너스 보스 등장 여부를 판정하는 별도 진입점을 탄다.
		-- GameStarted 전(타이틀 화면 중 미리 위치만 옮겨두는 경우)엔 스폰을 켜지 않는다 — 어차피
		-- BeginGameplay()가 "게임 시작" 클릭 시점에 self.CurrentMapIndex(이미 갱신됨) 기준으로
		-- ActivateMap을 다시 호출해준다. 여기서 조건 없이 켜버리면 타이틀 화면을 보는 동안 몬스터가
		-- 먼저 쌓이기 시작하는 문제가 생긴다.
		-- 시스템 리다이렉트(에피소드 시작 위치 보정)라 스트릭에는 반영하지 않고 시계만 리셋한다.
		self:RegisterZoneArrival(targetIndex, false)
		if _GameManager.GameStarted then
			if targetIndex == 10 then
				_MonsterSpawner:TryStartBonusStage()
			else
				_MonsterSpawner:ActivateMap(targetIndex)
			end
		end

		log("MapManager: silent-started at " .. mapName)
		_MapMoveUI:NotifyMapChanged(targetIndex)
		-- 존15 이스터에그: 도착했을 때만 알려준다(재입장 시 불꽃이 아직 안 풀렸으면 다시 꺼지는 연출)
		if targetIndex == 15 then _Zone15PuzzleLogic:OnEnterZone15() end
	end

	-- 실제로 플레이어가 있는 맵 번호를 엔티티 기준으로 다시 계산한다. Maker Play Test는 world 시작 시점의
	-- 유저 연결 타이밍에 따라 항상 map01에서 시작한다고 보장할 수 없어서(예: 마지막으로 있던 맵에서 재개),
	-- CurrentMapIndex를 무조건 1로 고정하면 실제 위치와 어긋나 보스 스폰/일시정지 대상이 틀어진다.
	-- 알려진 한계: 그룹D 병합으로 맵11/12가 같은 파일(map11)을 쓰기 때문에, 이 이름-파싱 방식으로는
	-- 둘을 구분하지 못하고 항상 11로 판정한다 — 월드 재시작 시점에 마침 12에 있었던 경우에만 11로
	-- 되돌아가는 정도의 미세한 엣지케이스이고(버튼 이동 중엔 CurrentMapIndex가 그대로 신뢰됨), 실사용
	-- 흐름(버튼으로만 이동)에서는 영향이 없다.
	@ExecSpace("ServerOnly")
	method integer ResolveCurrentMapIndex()
		for _, userEntity in pairs(_UserService.UserEntities) do
			local mapName = userEntity.CurrentMapName
			if mapName ~= nil then
				local numStr = string.match(mapName, "(%d+)$")
				local idx = numStr and tonumber(numStr) or nil
				if idx ~= nil and idx >= self.MinMapIndex and idx <= self.MaxMapIndex then
					return idx
				end
			end
		end
		return self.MinMapIndex
	end

	-- 클라이언트의 좌측 이동 버튼 요청
	@ExecSpace("Server")
	method void RequestMoveLeft()
		self:MoveByDelta(-1)
	end

	-- 클라이언트의 우측 이동 버튼 요청
	@ExecSpace("Server")
	method void RequestMoveRight()
		self:MoveByDelta(1)
	end

	-- 클라이언트의 "위로" 버튼 요청 (맵6 → 맵7 전용 경로). 우측 이동 버튼은 맵6에서 이제 맵11로
	-- 분기하므로, 맵7 진입은 더 이상 RequestMoveRight와 공유하지 않고 이 전용 메서드로 분리한다
	@ExecSpace("Server")
	method void RequestMoveToMap7()
		local actualIndex = self.CurrentMapIndex
		if actualIndex ~= 6 then return end
		self:MoveToMap(actualIndex, 7)
	end

