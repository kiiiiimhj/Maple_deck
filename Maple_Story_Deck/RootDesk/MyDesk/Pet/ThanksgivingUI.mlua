@Logic
script ThanksgivingUI extends Logic
	property Entity Root = "f08cf621-80fd-4498-972a-337c74585ac4"
	-- 로비 입장 버튼은 TitleGroup 안(EventEntry)에 둔다 — 이 그룹에 두면 GroupOrder가 커서 다른 팝업 위에 떴다(2026-10-27)
	property Entity EntryButton = "c21c6587-d565-4c88-8241-93f9f2f02286"
	-- 입장 버튼 느낌표 — 이용 안내를 아직 안 본 계정에만(유저 지정 2026-10-28)
	property Entity EntryRedDot = "0db9fdfe-2eb0-40f5-883d-c86bdb1541ca"
	property Entity TitleGroup = "4109795c-8f3d-41f1-9403-fefcec8fbb3e"
	property table Handlers = {}
	property boolean Opened = false
	property boolean Pending = false
	property boolean WaitingForTest = false
	property number NextRefresh = 0
	property number PendingSince = 0
	property string LocaleOverride = ""
	property string Notice = ""
	property integer SelectedProduct = 1
	property integer PurchaseQuantity = 1
	property boolean QuantityInputSync = false
	property any QuantityChangeHandler = nil
	property any QuantityEndHandler = nil
	property any EventScrollHandler = nil
	property any EventSliderHandler = nil
	property boolean SyncingEventScroll = false
	property number EventScrollAt = 0
	property table AcornGuideImages = {"9d9e0e3f1144473c9174c8bf977e399c","4c6676876a0c4dd08d00de739d704ca8","1195fbf93035492f97815b98e7e137b7"}
	property table AcornGuideArrows = {"6643f10005754442948e6e60629b9359","6643f10005754442948e6e60629b9359"}
	property boolean AcornGuideBound = false
	property boolean AcornGuideOpen = false
	property number AcornGuideTime = 0
	property integer AcornGuideStage = 0
	property table AcornGuideAges = {}
	property Vector2 AcornGuideCanvas = Vector2(0,0)
	property Vector2 AcornGuideScreen = Vector2(0,0)
	-- 이벤트 종료 뒤 도토리→골드 환산 요청(세션당 1회)
	property boolean ConversionRequested = false
	-- 상품 칸을 잡고 끌어서 스크롤(업적 팝업처럼). 드래그로 판정되면 그 손가락의 클릭은 무시한다
	property table DragHandlers = {}
	property boolean DragMoved = false
	property number DragDistance = 0

	@ExecSpace("ClientOnly")
	method table Labels()
		-- Real text components receive localized strings; the artwork contains no lettering.
		local locale=string.lower(self.LocaleOverride~="" and self.LocaleOverride or (_LocalizationService.CurrentLocaleId or "ko"))
		local language=locale=="zh-tw" and "tw" or string.sub(locale,1,2)
		local text={
			ko={"도토리 교환소","풍성한 가을, 새로운 친구","출시일부터 2026.11.30까지 · 한국 시간","한정 펫","뚠호","도토리","계정당 1회 교환","뚠호 낙하","적이 가장 많은\n곳으로 낙하해\n경로의 모든 적을\n한 번씩 공격합니다.","피해 100 +\n유저 레벨 × 10\n60초마다 발동","교환하기","펫하우스","보유 중","도토리가 부족해요","이벤트 시작 전","이벤트가 종료됐어요","교환 확인","도토리 1,000개로 뚠호를 교환할까요?","취소","교환 성공! 펫하우스에서 만나보세요.","저장하지 못했어요. 잠시 후 다시 시도해 주세요.","교환 중…","전용 재화로 한정 친구를 만나보세요.","메이커 미리보기","임시 부화","구매 제한 1 / 1"},
			tw={"橡果兌換所","豐收之秋，迎接新夥伴","上線起至2026.11.30 · 韓國時間","限定寵物","胖虎","橡果","每個帳號限兌換一次","胖虎墜落","朝敵人最密集的\n位置墜落，攻擊\n路徑上的所有敵人，\n各造成一次傷害。","傷害 100 +\n玩家等級 × 10\n每60秒施放","兌換","寵物小屋","已擁有","橡果不足","活動尚未開始","活動已結束","確認兌換","要使用1,000枚橡果兌換胖虎嗎？","取消","兌換成功！前往寵物小屋看看吧。","儲存失敗，請稍後再試。","兌換中…","用橡果迎接限定夥伴。","製作工具預覽","暫時孵化","限購 1 / 1"},
			en={"Acorn Exchange","A harvest season. A new friend.","From launch through NOV 30, 2026 · KST","LIMITED PET","Ttunho","Acorns","One exchange per account","Ttunho Drop","Fall into the densest\nenemy group. Hit each\nenemy in the path\nonce.","Damage 100 +\nplayer level x 10\nEvery 60s","Exchange","Pet House","Owned","Not enough acorns","Event starts soon","Event has ended","Confirm exchange","Exchange 1,000 Acorns for Ttunho?","Cancel","Ttunho is yours! Meet your friend in the Pet House.","Could not save. Please try again shortly.","Exchanging…","Meet a limited friend with event currency.","Maker preview","Test hatch","Limit 1 / 1"},
			ja={"どんぐり交換所","実りの秋、新しい友だち","公開日から2026.11.30まで · 韓国時間","限定ペット","トゥンホ","どんぐり","アカウントごとに1回交換","トゥンホ落下","敵が最も多い\n場所へ落下し、\n経路上の全敵を\n1回ずつ攻撃します。","ダメージ 100 +\nプレイヤーレベル × 10\n60秒ごと","交換する","ペットハウス","所持済み","どんぐり不足","開始前","イベント終了","交換確認","どんぐり1,000枚でトゥンホと交換しますか？","キャンセル","交換成功！ペットハウスで会いましょう。","保存できませんでした。再度お試しください。","交換中…","どんぐりで限定の友だちを迎えよう。","メーカープレビュー","仮ふ化","交換上限 1 / 1"},
			zh={"橡果兑换所","丰收之秋，迎接新伙伴","上线起至2026.11.30 · 韩国时间","限定宠物","胖虎","橡果","每个账号限兑换一次","胖虎坠落","朝敌人最密集的\n位置坠落，攻击\n路径上的所有敌人，\n各造成一次伤害。","伤害 100 +\n玩家等级 × 10\n每60秒施放","兑换","宠物小屋","已拥有","橡果不足","活动尚未开始","活动已结束","确认兑换","要使用1,000枚橡果兑换胖虎吗？","取消","兑换成功！前往宠物小屋看看吧。","保存失败，请稍后再试。","兑换中…","用橡果迎接限定伙伴。","制作工具预览","临时孵化","限购 1 / 1"},
			es={"Canje de bellotas","Una cosecha y un nuevo amigo.","Desde el lanzamiento hasta el 30 NOV 2026 · KST","MASCOTA LIMITADA","Ttunho","Bellotas","Un canje por cuenta","Caída de Ttunho","Cae sobre el grupo\nmás numeroso.\nGolpea una vez a cada\nenemigo en su camino.","Daño 100 +\nnivel del jugador x 10\nCada 60 s","Canjear","Casa de mascotas","En propiedad","Faltan bellotas","Próximamente","Evento finalizado","Confirmar canje","¿Canjear 1.000 bellotas por Ttunho?","Cancelar","¡Canje completado! Ve a la casa de mascotas.","No se pudo guardar. Inténtalo de nuevo.","Canjeando…","Consigue un amigo con bellotas.","Vista previa del editor","Eclosión de prueba","Límite 1 / 1"}
		}
		return text[language] or text.en
	end

	@ExecSpace("ClientOnly")
	method table GridLabels()
		-- A second translation table covers catalog controls without baking lettering into sprites.
		local locale=string.lower(self.LocaleOverride~="" and self.LocaleOverride or (_LocalizationService.CurrentLocaleId or "ko"))
		local key=locale=="zh-tw" and "tw" or string.sub(locale,1,2)
		local labels={
			ko={"전체","펫","강화","재화·재료","재고: %d","구매","품절","이벤트 종료 후 남은 도토리는 1개당 10골드로 환산돼요.","일반 상품의 가격·교환 횟수는 시안용 임시값입니다.","상세 정보","장비 강화에 사용하는 주문서입니다.","골드를 획득합니다.","펫 성장에 사용하는 재료입니다.","교환 수량","준비 중"},
			tw={"全部","寵物","強化","貨幣·材料","庫存: %d","購買","售完","活動結束後，剩餘的橡果每1個將換算為10金幣。","一般商品的價格和次數為示意暫定值。","詳細資訊","用於裝備強化的卷軸。","獲得金幣。","用於寵物成長的材料。","兌換數量","準備中"},
			en={"All","Pets","Enhancement","Currency & Materials","Stock: %d","Buy","Sold out","After the event, each remaining acorn converts to 10 gold.","Regular item prices and limits are provisional for this preview.","Item details","A scroll used to enhance equipment.","Receive gold.","A material used for pet growth.","Quantity","Coming soon"},
			ja={"すべて","ペット","強化","通貨・素材","在庫: %d","購入","売り切れ","イベント終了後、残ったどんぐりは1個につき10ゴールドに換算されます。","通常商品の価格と交換回数はプレビュー用の仮設定です。","詳細情報","装備強化に使う書です。","ゴールドを獲得します。","ペットの成長に使う素材です。","交換数","準備中"},
			zh={"全部","宠物","强化","货币·材料","库存: %d","购买","售完","活动结束后，剩余的橡果每1个将换算为10金币。","普通商品的价格和次数为示意暂定值。","详细信息","用于装备强化的卷轴。","获得金币。","用于宠物成长的材料。","兑换数量","准备中"},
			es={"Todos","Mascotas","Mejora","Moneda y materiales","Stock: %d","Comprar","Agotado","Al terminar el evento, cada bellota restante se convierte en 10 de oro.","Los precios y límites normales son provisionales para esta vista.","Detalles","Un pergamino para mejorar equipo.","Recibe oro.","Un material para el crecimiento de mascotas.","Cantidad","Próximamente"}}
		return labels[key] or labels.en
	end

