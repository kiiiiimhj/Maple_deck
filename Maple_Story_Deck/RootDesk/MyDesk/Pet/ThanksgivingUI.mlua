				desc={ko="유물 뽑기를 1회 할 수 있어요.",tw="可進行1次遺物抽獎。",en="Use for one relic pull.",ja="遺物ガチャを1回引けます。",zh="可进行1次遗物抽奖。",es="Sirve para una tirada de reliquia."}},
			{id="520001",live=true,category=4,price=200,limit=5,amount=5,icon="b239798f5a8d4129ae1c086e7069f7fc",names={ko="펫 성장석 ×5",tw="寵物成長石 ×5",en="Pet Growth Stone x5",ja="ペット成長石 ×5",zh="宠物成长石 ×5",es="Piedra de mascota x5"}},
			{id="gold",live=true,category=4,price=100,limit=10,amount=10000,icon="",names={ko="골드 10,000",tw="金幣 10,000",en="10,000 Gold",ja="10,000 ゴールド",zh="金币 10,000",es="10.000 de oro"}},
			{id="510001",live=true,category=3,price=50,limit=20,amount=1,icon="52df3f22bb014921a232021a48a1279b",names={ko="무기 강화 주문서",tw="武器強化卷軸",en="Weapon Scroll",ja="武器強化の書",zh="武器强化卷轴",es="Pergamino de arma"}},
			{id="510002",live=true,category=3,price=50,limit=20,amount=1,icon="2f9a8db2d118401f847acf20e3684d0d",names={ko="갑옷 강화 주문서",tw="鎧甲強化卷軸",en="Armor Scroll",ja="鎧強化の書",zh="铠甲强化卷轴",es="Pergamino de armadura"}},
			{id="510003",live=true,category=3,price=50,limit=20,amount=1,icon="0ad04f9af12b49469cb49848e9f90f05",names={ko="모자 강화 주문서",tw="帽子強化卷軸",en="Hat Scroll",ja="帽子強化の書",zh="帽子强化卷轴",es="Pergamino de sombrero"}},
