	method table Catalog()
		-- 전 상품 실제 판매(live) — 2026-10-28 QA에서 뚠호 말고 전부 테스트용으로 남아 있던 걸 발견해 전부 켬
		return {
			-- 순서(유저 지정 2026-10-28): 펫 → 스킬 뽑기권 → 유물 뽑기권 → 성장석 → 골드 → 강화 주문서("무료" 표기는 빼기로 함)
			{id="ttunho",category=2,price=1000,limit=1,amount=1,icon="5429147d026142ff8f2931892f9d2f4a",live=true,names={ko="뚠호",tw="胖虎",en="Ttunho",ja="トゥンホ",zh="胖虎",es="Ttunho"}},
