@Logic
script LoadingUI extends Logic

	-- 게임 입장 로딩 화면(ui/LoadingGroup.ui).
	--
	-- 왜 필요했나: "게임 시작"을 누르면 곧바로 인게임이라, 유저가 화면을 인식하기도 전에 몬스터가
	-- 붙어서 죽는 경우가 있었다(유저 리포트). 그래서 화면을 검게 덮은 채로 잠깐 두고, 그 사이
	-- 서버는 몬스터 스폰 시작을 미룬다(GameManager.EntryDelaySeconds). 연출과 실제 전투 시작이
	-- 같이 늦춰져야 의미가 있다 — 화면만 가리면 "죽는 걸 못 본" 문제가 오히려 심해진다.
	--
	-- 연출은 페이드(알파 트윈). 맵 이동은 검은 와이프(MapTransitionLogic)로 이미 쓰고 있어서,
	-- "장소 이동=와이프 / 시간 경과·로딩=페이드"로 역할을 갈라 두면 둘이 헷갈리지 않는다.

	property Entity loadingScreen = "4e3f744a-329a-4aa7-9e36-a0ec50fb2906"
	property CanvasGroupComponent screenCanvas = "4e3f744a-329a-4aa7-9e36-a0ec50fb2906"
	property SpriteGUIRendererComponent bgSprite = "4a7dbbce-a4e0-4168-a001-e93a0443194a"
	-- 배경 위의 UFO 장식 — 다른 배경 이미지로 덮을 때(레이드 입장) 같이 숨긴다
	property Entity ufoDeco = "263bbba6-a056-457e-bae7-299438d639ff"
	-- 전용 로딩 그림을 쓸 때만 켜는 제목(ui/LoadingGroup.ui의 Screen/RaidTitle).
	-- 글자를 그림에 구워 넣지 않고 UI 텍스트로 얹는 이유: 번역표(ko/en/zh-TW/ja)가 그대로 따라오고,
	-- 색·크기·위치를 이미지 재업로드 없이 고칠 수 있다
	property Entity titleText = "6da9c879-fd9b-4d79-ae7f-a2d50276f434"

	-- CoverNowWithImage로 배경을 잠깐 바꿨을 때 원래 값(걷힐 때 되돌린다)
	property any _origBgRuid = nil
	property boolean _bgOverridden = false
	property boolean _origUfoEnable = true

	-- ── 로딩 배경 + 언어별 로고(2026-10-29 유저 지정) ──
	-- 배경(2560×1440, 글자 없음, 언어 공통)은 .ui에 박아서 앱 로딩 때 같이 받는다 — 화면보다 크게 깔려서
	-- 스크립트가 켜지기 전에도 아이폰 안전영역 밖까지 덮는다(MobileScreenFitLogic이 안 건드림).
	-- 그림은 스크립트 없이 언어를 못 가려서, 로고(1600×600 캔버스)만 스크립트가 받은 뒤 "쿵" 박히는 연출로 띄운다
	-- (처음엔 통그림을 언어별로 바꿨는데 영어 → 대만어로 바뀌는 게 보여서 유저가 분리를 지정).
	-- 위의 bgSprite는 평소 투명하게 두고 레이드 입장 그림을 띄울 때만 보이게 한다
	property SpriteGUIRendererComponent localeBgSprite = "4db560eb-a782-4ab0-8b0e-8f322341f433"
	property SpriteGUIRendererComponent logoSprite = "04469a87-12cd-4fe9-a589-a0c2b72a796f"
	property string LogoKo = "bba9d4b51f8e471db52f01c3b373d1bf"
	property string LogoEn = "875ad107d52443c79bff1dbc8ca8e7b1"
	property string LogoZhTw = "adc8a13a841040ad8554836ce7ac6d0b"
	property string LogoZhCn = "fcd135fa1b5c4440b6041c95fd68880f"
	property string LogoJa = "6fca6c055e3e4663a107c30205d3229a"
	property string LogoEs = "dc90c8c8853a415eb9fae72bfa3a9494"
	-- 로고 등장: LogoDropScale배로 크게 나타나 LogoDropSeconds 동안 줄어들며 박히고, 살짝 튕겼다 제자리
	property number LogoDropScale = 1.6
	property number LogoDropSeconds = 0.28
	property number LogoBounceScale = 1.06
	property number LogoBounceSeconds = 0.16
	-- 박힌 뒤 이만큼 더 보여주고 나서 부팅 커버를 걷게 한다
	property number LogoHoldSeconds = 0.5
	-- 우주선(ufoDeco) 등장(2026-10-29 유저 지정): .ui에는 화면 왼쪽 밖(UfoStartX)에 저장해 두고, 로고가 준비되면
	-- 제자리(UfoHome)로 날아온다. 도착하는 순간에 맞춰 로고가 박힌다(로고 연출은 비행 끝 LogoDropSeconds 전에 시작)
	property Vector2 UfoHome = Vector2(-4.0557, -121.5849)
	property number UfoStartX = -1700
	property number UfoFlySeconds = 1.2
	property boolean _origLogoEnable = true

	-- "Loading..." 글자들을 담은 컨테이너. 파도 연출은 글자마다 위상이 달라야 해서 한 덩어리
	-- TextComponent로는 안 되고, Char_0..Char_N 자식 엔티티를 각각 위아래로 흔든다.
	-- 문구 전체 위치를 옮기려면 이 컨테이너만 움직이면 되고, 글자 간격은 각 Char_N의 x를 조정한다
	property Entity waveContainer = "9b28daaa-c08b-40e5-81b6-784034204f55"
	-- 글자가 위아래로 흔들리는 폭(px)
	property number WaveAmplitude = 12
	-- 파도가 흐르는 속도(rad/s)
	property number WaveSpeed = 6.0
	-- 글자 하나당 위상차(rad) — 클수록 파도가 촘촘해진다
	property number WavePhase = 0.55

	property table _waveChars = {}
	property number _waveTime = 0

	-- 화면이 검어지는 시간. 타이틀 화면은 이 페이드가 끝난 뒤에 닫아서, 로비가 사라지는 순간이
	-- 검은 화면 뒤에 감춰지게 한다(에피2/3의 맵 점프 노출도 같이 가려진다)
	property number FadeInSeconds = 0.35
	-- 검은 화면을 유지하는 시간(= 실제 "로딩" 구간)
	property number HoldSeconds = 1.2
	-- 화면이 다시 밝아지는 시간
	property number FadeOutSeconds = 0.5

	-- ── 부팅 커버 ──
	-- 월드를 처음 켤 때 각 UI 그룹의 "저장된 상태"가 먼저 한 번 그려지고, 그 뒤에야 컨트롤러
	-- 스크립트의 OnBeginPlay가 돌면서 정리된다(DefaultGroup의 HUD 18개가 보이고, TitleGroup은
	-- Shop/Skill 패널이 동시에 켜진 채로 보였다가 ShowTab("battle")이 정리하는 식).
	-- 그래서 이 화면은 .ui에 **덮인 상태로 저장**되어 있고(Screen.Enable=true, GroupAlpha=1),
	-- 여기서는 "언제 걷을지"만 결정한다 — 스크립트가 켜는 방식이면 이미 늦어서 못 막는다.
	property boolean CoverOnBoot = true
	-- 데이터 로드가 끝났는지 확인하는 주기
	property number BootPollSeconds = 0.1
	-- 데이터 로드가 끝난 뒤 UI들이 자리를 잡을 여유
	property number BootSettleSeconds = 0.35
	-- 로딩 화면을 최소한 이만큼은 보여준다. 실측상 데이터 로드가 0.3초면 끝나버려서, 이게 없으면
	-- 로딩 화면이 스치듯 지나가 유저가 보지도 못한다(유저 리포트: "거의 안 보인다")
	property number BootMinShowSeconds = 2.0
	-- 안전장치: 로드 완료 신호가 끝내 안 와도 이 시간이 지나면 무조건 걷는다.
	-- 이게 없으면 로드 단계가 실패했을 때 화면이 영영 검은 채로 남는다
	property number BootMaxSeconds = 8.0

	-- ── 레이드 입장 로딩 전용(2026-09-23 유저 지정) ──
	-- 로딩 그림(배경+제목)을 레이드 팝업 액자 가운데에 맞춘다 — 액자는 화면 가운데보다 왼쪽(x≈-24)에 있어서
	-- 그림 속 문양이 액자 장식(별)과 어긋나 보였다. 맞춘 뒤 미세 조정이 필요하면 이 값(px, +는 오른쪽)을 고친다
	property number AlignNudgeX = 0
	-- 걷힐 때 뽑기 덮개(GachaUI.PlayCoverOpen)처럼 살짝 커졌다가(팝) 위로 올라가며 사라진다
	property number LiftPopScale = 1.04
	property number LiftPopSeconds = 0.08
	property number LiftDistance = 140
	property number LiftSeconds = 0.32

	-- ── 입장 미리 받기(2026-10-26 유저 지정) ──
	-- 로비에서 새 판을 시작할 때, 서버가 보낸 그 판 핵심 그림(시작 존 몬스터·첫 엘리트·첫 보스)과
	-- 스킬 이펙트 미리받기(CardManager)가 끝날 때까지 화면을 걷지 않는다. 늦어도 입장 후 이 시간이 지나면 걷는다
	-- (GameManager.EntryPresentationTimeoutSeconds가 이 값 + 실루엣 연출보다 길어야 한다)
	property number EntryPreloadMaxSeconds = 6.0

	-- ── 부팅 미리 받기(2026-10-26 유저 지정 "로비도 받아야지" / "처음 시작하면 스토리 튜토리얼 이런 것도") ──
	-- 부팅 커버가 덮고 있는 동안 로비 전체(TitleGroup)·인트로 만화·로비 튜토리얼·첫 판 튜토리얼 화면의 그림을 받는다.
	-- 다 받으면 걷고, 늦어도 BootMaxSeconds에서 걷는다. 경로 조회는 안 열린 UI 그룹에서 예외를 던져서 루트를 UUID로 직접 잡는다
	property Entity bootPreloadTitleRoot = "4109795c-8f3d-41f1-9403-fefcec8fbb3e"
	property Entity bootPreloadIntroComicRoot = "ce60597f-39ed-4aa3-a52f-27e510c5d1c8"
	property Entity bootPreloadLobbyTutorialRoot = "39161750-b585-46e3-acca-f6ca57cf1b12"
	property Entity bootPreloadAimStageRoot = "8c356b00-ef31-4b7c-92d9-997d381f7638"

	property integer _entryCharacterIndex = -1
	property any _entryOnFinished = nil
	property boolean _playing = false
	-- 지금 화면이 완전히 덮여 있는가(부팅 커버 포함) — PlayEntry가 페이드인을 건너뛸지 판단한다
	property boolean _covered = false
	property number _bootElapsed = 0
	property integer _bootTimerId = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		if not isvalid(self.loadingScreen) or not isvalid(self.screenCanvas) then
			log_error("LoadingUI: screen entity missing")
			return
		end

		if not self.CoverOnBoot then
			self.loadingScreen.Enable = false
			self.screenCanvas.GroupAlpha = 0
			self._covered = false
			self:ApplyLocaleBackground()
			-- 이 분기에서도 글자 캐시는 반드시 해둬야 한다 — 부팅 커버를 꺼도 "게임 시작" 로딩에서
			-- 같은 글자들을 쓰기 때문. 여기 빠뜨리면 파도가 조용히 안 움직인다
			self:CacheWaveChars()
			log("LoadingUI started (boot cover disabled)")
			return
		end

		-- .ui에 저장된 대로 이미 덮여 있는 상태. 여기서 켜는 게 아니라 상태만 맞춰둔다
		self.loadingScreen.Enable = true
		self.screenCanvas.GroupAlpha = 1
		self._covered = true
		self._bootElapsed = 0
		-- 덮인 상태를 맞춘 뒤에 부른다 — 로고가 이미 받아져 있으면 콜백이 즉시 돌아서, 그 전에 부르면 연출 없이 그냥 뜬다.
		-- 부팅 미리 받기보다 먼저 요청해서 로고가 줄 맨 앞에 서게 한다
		self:ApplyLocaleBackground()
		self:PreloadBootAssets()
		self._bootTimerId = _TimerService:SetTimerRepeat(self.TickBootCover, self.BootPollSeconds, self.BootPollSeconds)
		self:CacheWaveChars()
		log("LoadingUI started (boot cover on)")
	end

	@ExecSpace("ClientOnly")
	method string GetLocaleLogoRuid()
		-- 앱 언어에 맞는 로고. 목록에 없는 언어는 영어
		local locale = string.lower(_LocalizationService.CurrentLocaleId or "en")
		local head = string.sub(locale, 1, 2)
		if head == "ko" then return self.LogoKo end
		if head == "ja" then return self.LogoJa end
		if head == "es" then return self.LogoEs end
		if head == "zh" then
			-- zh-CN/zh-Hans(간체)만 대륙판, 나머지 중국어(zh-TW/zh-HK/zh-Hant)는 번체
			if string.find(locale, "cn", 1, true) or string.find(locale, "hans", 1, true) or string.find(locale, "sg", 1, true) then
				return self.LogoZhCn
			end
			return self.LogoZhTw
		end
		return self.LogoEn
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocaleBackground()
		-- 언어별 로고를 다 받은 뒤에 띄운다 — 받기 전에 켜면 빈 그림이 보이는 순간이 생긴다.
		-- 기존 배경(bgSprite)은 레이드 그림 전용으로 평소엔 투명
		if isvalid(self.bgSprite) and not self._bgOverridden then self.bgSprite.Color = Color(1, 1, 1, 0) end
		if not isvalid(self.logoSprite) then
			log_warning("LoadingUI: logo missing")
			self:PlaceUfoHome()
			return
		end
		self._T.logoLanded = false
		self.logoSprite.Color = Color(1, 1, 1, 0)
		local ruid = self:GetLocaleLogoRuid()
		local startedAt = _UtilLogic.ElapsedSeconds
		_ResourceService:PreloadAsync({ ruid }, function(results)
			if not isvalid(self) or not isvalid(self.logoSprite) then return end
			self.logoSprite.ImageRUID = DataRef(ruid)
			-- 아직 로딩 화면이 덮고 있으면 박히는 연출, 이미 걷혔으면 다음에 덮을 때 바로 보이게만 해 둔다
			local animate = self._covered and isvalid(self.loadingScreen) and self.loadingScreen.Enable
			if animate then
				self:PlayUfoEntrance()
			else
				self.logoSprite.Color = Color(1, 1, 1, 1)
				self:PlaceUfoHome()
				self._T.logoLanded = true
			end
			log(string.format("[VRF] LoadingUI: logo ready locale=%s ruid=%s in %.2fs animate=%s",
				tostring(_LocalizationService.CurrentLocaleId), ruid, _UtilLogic.ElapsedSeconds - startedAt, tostring(animate)))
		end)
	end

	@ExecSpace("ClientOnly")
	method void PlaceUfoHome()
		-- 연출 없이 우주선을 제자리에 둔다(로딩이 이미 걷혔거나 로고가 없을 때)
		if isvalid(self.ufoDeco) then self.ufoDeco.UITransformComponent.anchoredPosition = self.UfoHome end
	end

	@ExecSpace("ClientOnly")
	method void PlayUfoEntrance()
		-- 우주선이 왼쪽 밖에서 감속하며 날아오고, 도착하는 순간 로고가 박힌다
		if not isvalid(self.ufoDeco) then
			self:PlayLogoDrop()
			return
		end
		local t = self.ufoDeco.UITransformComponent
		local from = Vector2(self.UfoStartX, self.UfoHome.y)
		local to = self.UfoHome
		t.anchoredPosition = from
		_TweenLogic:PlayTween(from, to, self.UfoFlySeconds, EaseType.CubicEaseOut, function(v)
			if isvalid(t) then t.anchoredPosition = v end
		end)
		local dropDelay = self.UfoFlySeconds - self.LogoDropSeconds
		if dropDelay < 0 then dropDelay = 0 end
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			if isvalid(t) then t.anchoredPosition = to end
		end, self.UfoFlySeconds)
		_TimerService:SetTimerOnce(function()
			if isvalid(self) then self:PlayLogoDrop() end
		end, dropDelay)
	end

	@ExecSpace("ClientOnly")
	method void PlayLogoDrop()
		-- 크게 반투명으로 나타나 → 빠르게 줄어들며 박히고(가속) → 살짝 튕겼다 제자리
		local sprite = self.logoSprite
		local t = sprite.Entity.UITransformComponent
		local big = self.LogoDropScale
		t.Scale = Vector3(big, big, 1)
		sprite.Color = Color(1, 1, 1, 0)
		_TweenLogic:PlayTween(0, 1, self.LogoDropSeconds, EaseType.QuadEaseIn, function(p)
			if not isvalid(sprite) then return end
			local s = big + (1 - big) * p
			t.Scale = Vector3(s, s, 1)
			-- 알파는 앞쪽에서 빨리 차오르게(절반 시점에 불투명)
			sprite.Color = Color(1, 1, 1, math.min(1, p * 2))
		end)
		_TimerService:SetTimerOnce(function()
			if not isvalid(sprite) then return end
			t.Scale = Vector3(1, 1, 1)
			sprite.Color = Color(1, 1, 1, 1)
			local bounce = self.LogoBounceScale
			_TweenLogic:PlayTween(0, 1, self.LogoBounceSeconds, EaseType.QuadEaseOut, function(p)
				if not isvalid(sprite) then return end
				-- 0→1→0 한 번 부풀었다 돌아온다
				local s = 1 + (bounce - 1) * math.sin(p * math.pi)
				t.Scale = Vector3(s, s, 1)
			end)
		end, self.LogoDropSeconds)
		_TimerService:SetTimerOnce(function()
			if isvalid(self) then self._T.logoLanded = true end
		end, self.LogoDropSeconds + self.LogoBounceSeconds + self.LogoHoldSeconds)
	end

	-- "Loading..." 글자 엔티티와 각자의 기준 y를 한 번만 모아둔다.
	-- 기준 y를 .ui에서 읽어두기 때문에, 하이라키에서 글자 위치를 옮겨도 그 자리를 중심으로 흔들린다
	@ExecSpace("ClientOnly")
	method void CacheWaveChars()
		local chars = {}
		if not isvalid(self.waveContainer) then
			self._waveChars = chars
			log_warning("LoadingUI: waveContainer missing, wave disabled")
			return
		end

		for _, child in ipairs(self.waveContainer.Children:ToTable()) do
			if isvalid(child) then
				local t = child.UITransformComponent
				chars[#chars + 1] = { transform = t, baseX = t.anchoredPosition.x, baseY = t.anchoredPosition.y }
			end
		end

		self._waveChars = chars
		log("LoadingUI: wave chars cached = " .. tostring(#chars))
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 로딩 화면이 떠 있는 동안만 글자를 흔든다
		if not isvalid(self.loadingScreen) or not self.loadingScreen.Enable then return end

		local chars = self._waveChars
		if chars == nil or #chars == 0 then return end

		self._waveTime = self._waveTime + delta
		for i = 1, #chars do
			local c = chars[i]
			if isvalid(c.transform) then
				-- 글자마다 위상을 WavePhase만큼 밀어서, 왼쪽에서 오른쪽으로 물결이 흐르는 것처럼 보인다
				local y = c.baseY + math.sin(self._waveTime * self.WaveSpeed - (i - 1) * self.WavePhase) * self.WaveAmplitude
				c.transform.anchoredPosition = Vector2(c.baseX, y)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void TickBootCover()
		-- 데이터 로드 완료(_DataLoadLogic.IsLoadEnd)까지 덮어두고, 안 오면 BootMaxSeconds에서 포기한다
		self._bootElapsed = self._bootElapsed + self.BootPollSeconds

		-- 첫 설치 인트로 만화를 띄울지 알려면 서버가 "봤음" 값을 읽어 와야 한다 — 그것까지 기다린다(시간 초과면 안 띄움)
		-- 로비·만화·튜토리얼 그림 미리 받기(PreloadBootAssets)도 같이 기다린다
		-- 로고가 박히는 연출까지 보여준 뒤에 걷는다(폰에선 로고 받기가 데이터 로드보다 늦을 수 있다)
		local ready = _DataLoadLogic.IsLoadEnd and _IntroComicUI:IsIntroLoaded() and self._T.bootPreloadDone == true
			and self._T.logoLanded ~= false
		local timedOut = self._bootElapsed >= self.BootMaxSeconds
		if not ready and not timedOut then return end
		log(string.format("[VRF] boot cover ready=%s data=%s images=%s at %.1fs", tostring(ready), tostring(_DataLoadLogic.IsLoadEnd), tostring(self._T.bootPreloadDone == true), self._bootElapsed))
		-- 이제부터 로비·만화를 보는 동안 몬스터·레이드 그림을 뒤에서 계속 받는다(GameManager.RequestLobbyPreload)
		_GameManager:RequestLobbyPreload()

		_TimerService:ClearTimer(self._bootTimerId)
		self._bootTimerId = 0

		-- 처음 들어온 유저: 로딩 화면 대신 인트로 만화(유저 지정 2026-09-24). 만화의 흰 바탕이 덮은 뒤 로딩을 걷어서
		-- 만화가 끝나면 바로 로비가 보인다. 최소 노출 시간(BootMinShowSeconds)은 기다리지 않는다
		if ready and _IntroComicUI:ShouldPlay() then
			log(string.format("LoadingUI: first install — intro comic instead of loading (%.1fs)", self._bootElapsed))
			_IntroComicUI:Play()
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				self:PlayReveal()
			end, self.BootSettleSeconds)
			return
		end

		if timedOut and not ready then
			log_warning(string.format("LoadingUI: boot cover timed out after %.1fs (data load or image preload not finished), revealing anyway", self._bootElapsed))
		else
			log(string.format("LoadingUI: data load finished at %.1fs", self._bootElapsed))
		end

		-- 로드가 끝나도 각 UI의 OnBeginPlay 정리가 같은 프레임에 끝나 있지 않을 수 있어 잠깐 더 둔다.
		-- 여기에 더해 BootMinShowSeconds를 채울 때까지 기다린다 — 로드가 순식간에 끝나도 로딩
		-- 화면이 최소 그 시간만큼은 보이게 하려는 것
		local settle = self.BootSettleSeconds
		local remainMin = self.BootMinShowSeconds - self._bootElapsed
		if remainMin > settle then settle = remainMin end

		log(string.format("LoadingUI: revealing in %.2fs (min-show %.1fs)", settle, self.BootMinShowSeconds))
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self:PlayReveal()
		end, settle)
	end

	@ExecSpace("ClientOnly")
	method void PreloadBootAssets()
		-- 로비·인트로 만화·로비 튜토리얼·에임 시연 화면 아래 SpriteGUIRenderer 그림 전부 + 에임 시연용 그림/소리를 받는다
		if not self.BootPreloadEnabled then
			-- 꺼져 있으면 받지 않고 바로 "다 받음"으로 둔다(부팅 커버는 데이터 로드만 기다린다)
			self._T.bootPreloadDone = true
			log("LoadingUI: boot preload disabled")
			return
		end
		self._T.bootPreloadDone = false
		-- 엔진 기본 스프라이트는 미리 받으면 [LEA-3015] CannotLoad를 찍는다(기기에선 로그 콘솔이 튀어나옴) — RaidUI.PreloadRaidImages의
		-- 제외 목록 + 로비에서 실측된 2개(3d355ae7…, 7d614552…, 2026-10-26)
		local seen = { ["2860136c06ab075439721c027de365af"] = true, ["4fea64a3307cda641809ad8be0d4890b"] = true,
			["3d355ae7efc15cd4eb036ee178a6b277"] = true, ["7d614552ba7843049bb48ebd4509fb8f"] = true }
		local ruids = {}
		local function add(id)
			if id ~= nil and id ~= "" and seen[id] == nil then
				seen[id] = true
				table.insert(ruids, id)
			end
		end
		local roots = { self.bootPreloadTitleRoot, self.bootPreloadIntroComicRoot, self.bootPreloadLobbyTutorialRoot, self.bootPreloadAimStageRoot }
		for _, root in ipairs(roots) do
			if isvalid(root) then
				local stack = { root }
				while #stack > 0 do
					local e = table.remove(stack)
					local sp = e.SpriteGUIRendererComponent
					if sp ~= nil and sp.ImageRUID ~= nil then add(sp.ImageRUID.DataId) end
					for _, c in ipairs(e.Children) do table.insert(stack, c) end
				end
			end
		end
		for _, id in ipairs(_TutorialGuideUI:GetPreloadRuids()) do add(id) end
		-- 도토리 교환소(추수감사절 이벤트) 팝업 전체 + 상품·안내 그림 — 이벤트 기간에만(유저 지정 2026-10-28).
		-- 칠면조 몸 그림은 ThanksgivingMonsterLogic.PreloadArtwork가 따로 받는다
		if _ThanksgivingUI:IsEventPreloadWanted() then
			local stack = { _ThanksgivingUI.Root }
			while #stack > 0 do
				local e = table.remove(stack)
				if isvalid(e) then
					local sp = e.SpriteGUIRendererComponent
					if sp ~= nil and sp.ImageRUID ~= nil then add(sp.ImageRUID.DataId) end
					for _, c in ipairs(e.Children) do table.insert(stack, c) end
				end
			end
			for _, id in ipairs(_ThanksgivingUI:GetPreloadRuids()) do add(id) end
		end
		if #ruids == 0 then
			self._T.bootPreloadDone = true
			return
		end
		local startedAt = _UtilLogic.ElapsedSeconds
		_ResourceService:PreloadAsync(ruids, function(results)
			if not isvalid(self) then return end
			local failed = 0
			for _, status in pairs(results) do
				if status ~= PreloadResultStatus.Success then failed = failed + 1 end
			end
			self._T.bootPreloadDone = true
			log(string.format("[VRF] boot preload done count=%d failed=%d in %.2fs", #ruids, failed, _UtilLogic.ElapsedSeconds - startedAt))
		end)
		log("[VRF] boot preload requested count=" .. #ruids)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._bootTimerId ~= 0 then
			_TimerService:ClearTimer(self._bootTimerId)
			self._bootTimerId = 0
		end
	end

	-- "게임 시작"/"다시하기"가 호출하는 입장 연출 전체.
	-- onCovered: 화면이 완전히 검어진 시점에 실행할 콜백(타이틀 닫기 등) — 없으면 nil을 넘긴다.
	-- 로비에서 새 판을 시작할 때만 캐릭터 실루엣 입장을 예약한다.
	@ExecSpace("ClientOnly")
	method void PlayCharacterEntry(any onCovered, integer characterIndex, any onFinished)
		if self._playing then return end
		self._entryCharacterIndex = characterIndex
		self._entryOnFinished = onFinished
		self:PlayEntry(onCovered)
	end

	@ExecSpace("ClientOnly")
	method void PlayEntry(any onCovered)
		if self._playing then
			log("LoadingUI: already playing, ignored")
			return
		end
		local entryCharacter = self._entryCharacterIndex
		local entryDone = self._entryOnFinished
		self._entryCharacterIndex = -1
		self._entryOnFinished = nil
		if not isvalid(self.loadingScreen) or not isvalid(self.screenCanvas) then
			-- 로딩 UI가 없어도 게임 진행 자체는 막지 않는다 — 콜백만 즉시 실행하고 빠진다
			log_error("LoadingUI: screen entity missing, skipping presentation")
			if onCovered ~= nil then onCovered() end
			if entryDone ~= nil then entryDone() end
			return
		end

		self._playing = true
		-- 새 판 입장(로비)만 미리 받기를 기다린다 — 다시하기는 이미 받은 그림이라 예전처럼 바로 걷는다
		self._T.entryPreloadWaiting = entryCharacter >= 0
		self._T.entryPreloadDone = false
		self._T.entryPreloadStartedAt = _UtilLogic.ElapsedSeconds
		self:ResetLiftTransform()
		-- 게임 입장 로딩은 항상 기본 그림으로. 레이드 로딩 그림 예열(WarmImage, 로비에서 약 1초) 도중에
		-- "게임 시작"을 누르면 예열 쪽 복구가 건너뛰어져 레이드 그림·제목이 그대로 떴다(2026-09-24 유저 리포트)
		self:RestoreBackground()
		self.loadingScreen.Enable = true

		-- 이미 덮여 있으면(부팅 커버가 아직 안 걷힌 상태) 페이드인을 건너뛴다 —
		-- 여기서 알파를 0으로 되돌리면 로비가 한 번 번쩍 보였다가 다시 검어진다
		local fadeIn = self.FadeInSeconds
		if self._covered then
			fadeIn = 0
		else
			self.screenCanvas.GroupAlpha = 0
		end

		local totalCovered = fadeIn + self.HoldSeconds
		log(string.format("LoadingUI: PlayEntry (fadeIn=%.2f hold=%.2f fadeOut=%.2f)", fadeIn, self.HoldSeconds, self.FadeOutSeconds))

		-- 1) 검게 덮기
		if fadeIn > 0 then
			_TweenLogic:PlayTween(0, 1, fadeIn, EaseType.QuadEaseIn, function(value)
				if isvalid(self.screenCanvas) then self.screenCanvas.GroupAlpha = value end
			end)
		end

		-- 2) 완전히 가려진 순간 — 타이틀 닫기 같은 "보이면 안 되는 전환"을 여기서 처리한다
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			if isvalid(self.screenCanvas) then self.screenCanvas.GroupAlpha = 1 end
			self._covered = true
			if onCovered ~= nil then onCovered() end
			-- 새 판 입장이면 "기절했다 눈 뜨는" 뿌연 시야를 미리 깐다 — 로딩이 걷히는 동안에도 뿌옇게(유저 지정 2026-10-07)
			if entryCharacter >= 0 then _GameEntryFxUI:ShowWakeVision() end
		end, fadeIn)

		-- 3) 유지 후(새 판이면 미리 받기가 끝날 때까지) 다시 밝히기
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self:RevealAfterPreload(entryCharacter, entryDone)
		end, totalCovered)
	end

	@ExecSpace("ClientOnly")
	method void RevealAfterPreload(integer entryCharacter, any entryDone)
		-- 미리 받기가 끝났거나 EntryPreloadMaxSeconds를 넘기면 화면을 걷고, 새 판이면 걷힌 화면에 실루엣을 입힌다
		-- (실루엣이 끝나면 호출자가 서버에 알려 전투를 해제한다)
		local waited = _UtilLogic.ElapsedSeconds - (self._T.entryPreloadStartedAt or 0)
		if self._T.entryPreloadWaiting == true then
			local ready = self._T.entryPreloadDone == true and _CardManager:IsEffectPreloadDone()
			if not ready and waited < self.EntryPreloadMaxSeconds then
				_TimerService:SetTimerOnce(function()
					if isvalid(self) then self:RevealAfterPreload(entryCharacter, entryDone) end
				end, 0.1)
				return
			end
			log(string.format("[VRF] entry preload reveal monsters=%s effects=%s waited=%.2fs", tostring(self._T.entryPreloadDone == true), tostring(_CardManager:IsEffectPreloadDone()), waited))
			self._T.entryPreloadWaiting = false
		end
		self:PlayReveal()
		if entryCharacter >= 0 then
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				if not _GameEntryFxUI:PlayWithCompletion(entryCharacter, entryDone) and entryDone ~= nil then entryDone() end
			end, self.FadeOutSeconds)
		end
	end

	@ExecSpace("Client")
	method void BeginEntryPreload(string csv)
		-- 서버(GameManager.SendEntryPreload)가 보낸 그 판 핵심 그림 RUID(쉼표 목록)를 받는다.
		-- 직접 그린 프레임 몬스터(에피5 등)는 클립 대신 프레임 그림들을 받는다
		if self._T.entryPreloadWaiting ~= true then return end
		local token = self._T.entryPreloadStartedAt
		local ruids = {}
		for r in string.gmatch(csv, "[^,]+") do
			table.insert(ruids, r)
			local clip = _GameManager:GetCustomMonsterAnimation(r)
			if clip ~= nil then
				for _, f in ipairs(clip.frames) do table.insert(ruids, f) end
			end
		end
		if #ruids == 0 then
			self._T.entryPreloadDone = true
			return
		end
		local startedAt = _UtilLogic.ElapsedSeconds
		_ResourceService:PreloadAsync(ruids, function(results)
			if not isvalid(self) or self._T.entryPreloadStartedAt ~= token then return end
			local failed = 0
			for _, status in pairs(results) do
				if status ~= PreloadResultStatus.Success then failed = failed + 1 end
			end
			self._T.entryPreloadDone = true
			log(string.format("[VRF] entry preload done count=%d failed=%d in %.2fs", #ruids, failed, _UtilLogic.ElapsedSeconds - startedAt))
		end)
		-- 뒤에서 받기 줄이 같은 그림을 다시 받지 않게 받은 목록에 올려 둔다
		if self._T.bgSeen == nil then self._T.bgSeen = {} end
		for _, r in ipairs(ruids) do self._T.bgSeen[r] = true end
	end

	-- ── 뒤에서 계속 받기(2026-10-26 유저 지정 "그냥 계속 리소스를 받고 있으면 되잖아, 게임에 영향 안 가는 선에서") ──
	-- 게임을 켠 순간부터 그림을 조금씩 계속 받는 다운로드 줄. 무엇을 어떤 순서로 넣는지는 서버(GameManager의
	-- RequestLobbyPreload / SendEpisodeBackgroundPreload / SendNeighborZonePreload)가 정한다.
	-- 줄은 lane 3개: 1 = 지금 존 이웃(제일 먼저) / 2 = 곧 볼 것(지금 에피소드·레이드) / 3 = 나머지 전부(에피1→5).
	-- 한 번에 BackgroundBatchSize개만 받고, 끝나면 BackgroundBatchGapSeconds 쉬었다 다음 묶음 — 전투에 부담을 덜 준다.
	-- 입장 로딩(entryPreloadWaiting) 중엔 그쪽에 대역폭을 몰아주려고 쉰다. 이미 넣은 그림은 다시 넣지 않는다
	property integer BackgroundBatchSize = 6
	property number BackgroundBatchGapSeconds = 0.25
	-- 끄기 스위치 — 저사양 기기에서 메모리/발열 문제가 보이면 false(입장·부팅 미리 받기와 이웃 존은 그대로, 나머지 줄만 멈춘다)
	-- 2026-10-27 출시판은 false(유저 동의) — 폰에서 메모리/발열 확인 후 다음 업데이트에서 켤 것
	property boolean BackgroundPreloadEnabled = false
	-- 부팅 미리 받기(로비·만화·튜토리얼 그림) 스위치. 2026-10-29 테스트로 껐다가 다시 켬 — 폰에서 "재입장하면 옛날 방식 글자
	-- (TextComponent)가 안 뜬다"는 증상은 꺼도 똑같아서 원인이 아니었다(MSW 모바일 앱 버그, PC는 정상)
	property boolean BootPreloadEnabled = true

	@ExecSpace("Client")
	method void BeginZonePreload(string csv)
		-- 서버에서 온 이웃 존 그림 목록(쉼표 문자열) — 줄 맨 앞(lane 1)
		self:EnqueueBackground(csv, 1)
	end

	@ExecSpace("Client")
	method void BeginBackgroundPreload(string csv, integer lane)
		-- 서버에서 온 뒤에서 받을 목록(쉼표 문자열)
		self:EnqueueBackground(csv, lane)
	end

	@ExecSpace("ClientOnly")
	method void EnqueueBackground(string csv, integer lane)
		-- 목록을 lane 줄 끝에 붙인다. 직접 그린 프레임 몬스터(에피5 등)는 프레임 그림까지 펼친다
		if not self.BackgroundPreloadEnabled and lane >= 2 then return end
		if self._T.bgSeen == nil then self._T.bgSeen = {} end
		if self._T.bgLanes == nil then self._T.bgLanes = { {}, {}, {} } end
		local seen = self._T.bgSeen
		local queue = self._T.bgLanes[math.max(1, math.min(3, lane))]
		local added = 0
		for r in string.gmatch(csv, "[^,]+") do
			if seen[r] == nil then
				seen[r] = true
				table.insert(queue, r)
				added = added + 1
				local clip = _GameManager:GetCustomMonsterAnimation(r)
				if clip ~= nil then
					for _, f in ipairs(clip.frames) do
						if seen[f] == nil then
							seen[f] = true
							table.insert(queue, f)
							added = added + 1
						end
					end
				end
			end
		end
		if Environment:IsMakerPlay() and added > 0 then log("[VRF] background enqueue lane=" .. lane .. " added=" .. added) end
		self:PumpBackground()
	end

	@ExecSpace("ClientOnly")
	method void PumpBackground()
		-- 앞 묶음이 끝났으면 가장 급한 lane에서 다음 묶음을 꺼내 받는다
		if self._T.bgBusy == true then return end
		local lanes = self._T.bgLanes
		if lanes == nil then return end
		local queue = nil
		for i = 1, 3 do
			if #lanes[i] > 0 then
				queue = lanes[i]
				break
			end
		end
		if queue == nil then
			if Environment:IsMakerPlay() and (self._T.bgDone or 0) > 0 and self._T.bgIdleLogged ~= self._T.bgDone then
				self._T.bgIdleLogged = self._T.bgDone
				log("[VRF] background idle downloaded=" .. tostring(self._T.bgDone))
			end
			return
		end
		self._T.bgBusy = true
		if self._T.entryPreloadWaiting == true then
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				self._T.bgBusy = false
				self:PumpBackground()
			end, 0.5)
			return
		end
		local batch = {}
		while #batch < self.BackgroundBatchSize and #queue > 0 do table.insert(batch, table.remove(queue, 1)) end
		_ResourceService:PreloadAsync(batch, function(results)
			if not isvalid(self) then return end
			self._T.bgDone = (self._T.bgDone or 0) + #batch
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				self._T.bgBusy = false
				self:PumpBackground()
			end, self.BackgroundBatchGapSeconds)
		end)
	end

	@ExecSpace("ClientOnly")
	method void CoverNow()
		-- 페이드 없이 즉시 덮는다 — 레이드 입장처럼 "누르는 즉시 팝업이 떠야" 하는 곳에서 쓴다.
		-- 자동으로 걷히지 않으므로 호출한 쪽이 준비가 끝나면 PlayReveal()을 불러야 한다
		if not isvalid(self.loadingScreen) or not isvalid(self.screenCanvas) then return end
		self._playing = true
		self._covered = true
		self:ResetLiftTransform()
		self.loadingScreen.Enable = true
		self.screenCanvas.GroupAlpha = 1
	end

	@ExecSpace("ClientOnly")
	method void ResetLiftTransform()
		-- PlayRevealLift로 올려 둔 화면 위치/크기를 원래대로. 올리는 트윈의 마지막 프레임이 종료 타이머보다
		-- 늦게 와서 y가 +140에 남는 걸 실측으로 확인했다 — 그래서 다음에 덮을 때마다 여기서 한 번 더 되돌린다
		if self._T.liftBase == nil or not isvalid(self.loadingScreen) then return end
		local t = self.loadingScreen.UITransformComponent
		t.anchoredPosition = self._T.liftBase
		t.Scale = Vector3(1, 1, 1)
	end

	@ExecSpace("ClientOnly")
	method void CoverNowWithImage(string ruid)
		-- CoverNow와 같지만 배경을 ruid 이미지로 바꾸고 UFO 장식을 숨긴다(레이드 전용 로딩 그림).
		-- 걷히고 나면(PlayReveal 끝) 원래 게임 입장 로딩 그림으로 되돌린다
		if isvalid(self.bgSprite) and ruid ~= nil and ruid ~= "" then
			if not self._bgOverridden then
				self._origBgRuid = self.bgSprite.ImageRUID
				if isvalid(self.ufoDeco) then self._origUfoEnable = self.ufoDeco.Enable end
				if isvalid(self.logoSprite) then self._origLogoEnable = self.logoSprite.Entity.Enable end
				self._bgOverridden = true
			end
			self.bgSprite.ImageRUID = DataRef(ruid)
			-- 평소엔 투명(언어별 그림이 보이게) — 레이드 그림을 띄울 때만 보이게 한다
			self.bgSprite.Color = Color(1, 1, 1, 1)
			if isvalid(self.ufoDeco) then self.ufoDeco.Enable = false end
			-- 로고는 레이드 그림보다 위 순서라 같이 숨긴다
			if isvalid(self.logoSprite) then self.logoSprite.Entity.Enable = false end
		end
		self:CoverNow()
	end

	@ExecSpace("ClientOnly")
	method void CoverNowWithImageTitled(string ruid)
		-- CoverNowWithImage에 제목까지 띄운다(레이드 입장). 제목은 .ui에 번역 키로 박혀 있어서
		-- 여기서는 켜기만 하면 되고, 걷힐 때 RestoreBackground가 다시 끈다.
		-- WarmImage(예열)는 제목 없이 CoverNowWithImage를 쓴다 — 예열 중에 글자가 비치면 안 되니까
		if isvalid(self.titleText) then self.titleText.Enable = true end
		log("LoadingUI: titled cover (title=" .. tostring(isvalid(self.titleText)) .. ")")
		self:CoverNowWithImage(ruid)
	end

	@ExecSpace("ClientOnly")
	method number GetCoverAlpha()
		-- 로딩 화면이 지금 얼마나 덮고 있나(0=안 보임, 1=완전히 덮음). 입장 뿌연 시야가 로딩 그림 위를 덮지 않게 쓴다
		if not isvalid(self.loadingScreen) or not self.loadingScreen.Enable or not isvalid(self.screenCanvas) then return 0 end
		return self.screenCanvas.GroupAlpha
	end

	@ExecSpace("ClientOnly")
	method boolean IsIdle()
		-- 로딩 화면이 지금 아무 데도 안 쓰이는가(부팅 커버/입장 연출/덮기 모두 끝난 상태)
		return not self._playing and not self._covered and isvalid(self.loadingScreen) and not self.loadingScreen.Enable
	end

	@ExecSpace("ClientOnly")
	method void WarmImage(string ruid, number seconds)
		-- 큰 배경 이미지는 미리 불러와도 **처음 그릴 때** 한 번 더 걸려서, 첫 CoverNowWithImage 때 원래 로딩 그림이
		-- 잠깐 보였다가 바뀌었다(2026-09-23 실측). 로딩 화면이 쉬고 있을 때 거의 투명(0.01)·터치 통과로
		-- 그 이미지를 seconds초 그려 두고 원래대로 돌린다. 그 사이 진짜로 덮으면(CoverNow) 그쪽이 이긴다
		if not self:IsIdle() or not isvalid(self.bgSprite) then return end
		self:CoverNowWithImage(ruid)
		self._playing = false
		self._covered = false
		self.screenCanvas.GroupAlpha = 0.01
		self.screenCanvas.BlocksRaycasts = false
		self.screenCanvas.Interactable = false
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self.screenCanvas.BlocksRaycasts = true
			self.screenCanvas.Interactable = true
			-- 그 사이 누가 실제로 덮었으면(CoverNow가 알파 1로 올림) 건드리지 않는다
			if self._playing or self._covered then return end
			self.screenCanvas.GroupAlpha = 0
			if isvalid(self.loadingScreen) then self.loadingScreen.Enable = false end
			self:RestoreBackground()
			log("LoadingUI: image warmed (" .. ruid .. ")")
		end, seconds)
	end

	@ExecSpace("ClientOnly")
	method void RestoreBackground()
		-- CoverNowWithImage로 바꾼 배경/장식을 원래대로.
		-- 제목은 _bgOverridden 가드보다 먼저 끈다 — 배경 복구가 이미 끝난 뒤에도 글자만 남는 일이 없게
		if isvalid(self.titleText) then self.titleText.Enable = false end
		self:ResetContentAlign()
		if not self._bgOverridden then return end
		self._bgOverridden = false
		if isvalid(self.bgSprite) and self._origBgRuid ~= nil then self.bgSprite.ImageRUID = self._origBgRuid end
		if isvalid(self.bgSprite) then self.bgSprite.Color = Color(1, 1, 1, 0) end
		if isvalid(self.ufoDeco) then self.ufoDeco.Enable = self._origUfoEnable end
		if isvalid(self.logoSprite) then self.logoSprite.Entity.Enable = self._origLogoEnable end
	end

	@ExecSpace("ClientOnly")
	method void PlayReveal()
		-- 검은 화면을 걷어낸다. 이 시점엔 서버가 이미 스폰을 시작했으므로(EntryDelaySeconds와 맞춤)
		-- 화면이 밝아지면서 몬스터가 저 멀리서 다가오는 게 보인다
		if not isvalid(self.screenCanvas) then
			self._playing = false
			self._covered = false
			return
		end

		_TweenLogic:PlayTween(1, 0, self.FadeOutSeconds, EaseType.QuadEaseOut, function(value)
			if isvalid(self.screenCanvas) then self.screenCanvas.GroupAlpha = value end
		end)

		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			if isvalid(self.screenCanvas) then self.screenCanvas.GroupAlpha = 0 end
			if isvalid(self.loadingScreen) then self.loadingScreen.Enable = false end
			self._playing = false
			self._covered = false
			self:RestoreBackground()
			log("LoadingUI: revealed")
		end, self.FadeOutSeconds)
	end

	@ExecSpace("ClientOnly")
	method table GetAlignTargets()
		-- 액자 가운데 맞춤 때 같이 옮기는 엔티티(배경 그림 + 제목). 없는 건 빼고 돌려준다
		local list = {}
		if isvalid(self.bgSprite) then table.insert(list, self.bgSprite.Entity) end
		if isvalid(self.titleText) then table.insert(list, self.titleText) end
		return list
	end

	@ExecSpace("ClientOnly")
	method void AlignContentTo(Entity target)
		-- 로딩 그림(배경+제목)의 가로 가운데를 target(다른 UI 그룹의 엔티티) 가운데에 맞춘다(레이드 액자).
		-- 위치는 RestoreBackground → ResetContentAlign이 되돌린다
		if not isvalid(target) or not isvalid(self.loadingScreen) then return end
		local corners = target.UITransformComponent:GetWorldCorners()
		local cx = (corners[1].x + corners[3].x) * 0.5
		local cy = (corners[1].y + corners[3].y) * 0.5
		local p = self.loadingScreen.UITransformComponent:ToLocalPoint(Vector3(cx, cy, 0))
		local dx = p.x + self.AlignNudgeX
		for _, e in ipairs(self:GetAlignTargets()) do
			if isvalid(e) then
				if self._T.alignBase == nil then self._T.alignBase = {} end
				local t = e.UITransformComponent
				if self._T.alignBase[e.Id] == nil then self._T.alignBase[e.Id] = t.anchoredPosition end
				local base = self._T.alignBase[e.Id]
				t.anchoredPosition = Vector2(base.x + dx, base.y)
			end
		end
		log(string.format("LoadingUI: content aligned dx=%.1f", dx))
	end

	@ExecSpace("ClientOnly")
	method void ResetContentAlign()
		-- AlignContentTo로 옮긴 배경/제목을 원래 자리로
		if self._T.alignBase == nil then return end
		for _, e in ipairs(self:GetAlignTargets()) do
			if isvalid(e) and self._T.alignBase[e.Id] ~= nil then
				e.UITransformComponent.anchoredPosition = self._T.alignBase[e.Id]
			end
		end
		self._T.alignBase = nil
	end

	@ExecSpace("ClientOnly")
	method number GetLiftRevealSeconds()
		-- PlayRevealLift가 끝나기까지 걸리는 시간(올라가며 사라짐)
		return self.LiftSeconds
	end

	@ExecSpace("ClientOnly")
	method void PlayRevealLift()
		-- PlayReveal과 같지만 뽑기 덮개처럼: 살짝 커졌다가(팝) 위로 슥 올라가면서 알파가 빠져 사라진다(레이드 입장)
		if not isvalid(self.screenCanvas) or not isvalid(self.loadingScreen) then
			self:PlayReveal()
			return
		end
		local screen = self.loadingScreen
		local t = screen.UITransformComponent
		-- 기준 위치는 처음 한 번만 잡는다(직전 연출이 덜 되돌려진 채로 다시 불려도 기준이 밀리지 않게)
		if self._T.liftBase == nil then self._T.liftBase = t.anchoredPosition end
		local basePos = self._T.liftBase
		local liftPos = Vector2(basePos.x, basePos.y + self.LiftDistance)
		local liftSec = self.LiftSeconds

		-- 커졌다 작아지는 팝은 뺐다(2026-09-24 유저 "로딩할 때 화면 크기 바뀌는 거 그냥 빼") — 크기는 그대로 두고 올라가며 사라지기만 한다
		_TimerService:SetTimerOnce(function()
			if not isvalid(screen) then return end
			_TweenLogic:PlayTween(basePos, liftPos, liftSec, EaseType.QuadEaseOut, function(value)
				if isvalid(screen) then screen.UITransformComponent.anchoredPosition = value end
			end)
			_TweenLogic:PlayTween(1, 0, liftSec, EaseType.QuadEaseOut, function(value)
				if isvalid(self.screenCanvas) then self.screenCanvas.GroupAlpha = value end
			end)
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				if isvalid(self.screenCanvas) then self.screenCanvas.GroupAlpha = 0 end
				if isvalid(screen) then screen.Enable = false end
				self._playing = false
				self._covered = false
				self:RestoreBackground()
				self:ResetLiftTransform()
				-- 트윈 마지막 프레임이 늦게 덮어쓰는 경우를 대비해 조금 뒤 한 번 더(다음 덮기 때도 ResetLiftTransform이 돈다)
				_TimerService:SetTimerOnce(function()
					if isvalid(self) and not self._covered then self:ResetLiftTransform() end
				end, 0.1)
				log("LoadingUI: revealed (lift)")
			end, liftSec)
		end, 0.01)
	end

	-- 화면이 검게 덮여있는 총 시간. GameManager가 스폰 시작을 얼마나 미룰지 맞출 때 참고한다.
	method number GetCoveredSeconds()
		return self.FadeInSeconds + self.HoldSeconds
	end

end
