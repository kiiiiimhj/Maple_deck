	end

	@ExecSpace("ServerOnly")
	method void InitializeLostRudolph(integer zoneIndex, string standRUID, string moveRUID, string dieRUID, number dieDuration, string dieSoundRUID, number spawnX, number minX, number maxX, number groundY)
		self:SetSpawnZone(zoneIndex)
		self._isMiniMoore = true
		self._isLostRudolph = true
		self._isFlying = false
		self._standRUID = standRUID
		self._moveRUID = moveRUID
		self._dieRUID = dieRUID
		self._dieDuration = dieDuration
		self._dieSoundRUID = dieSoundRUID
		self._currentScale = 1.0
		self._wanderMinX = minX
		self._wanderMaxX = maxX
		self._wanderY = groundY
		self.IsStanding = false
		self._lostRudolphCycleTimer = self.LostRudolphMoveMin + _UtilLogic:RandomDouble() * (self.LostRudolphMoveMax - self.LostRudolphMoveMin)
		self.MonsterSprite = moveRUID
		self.Entity.TransformComponent.Position = Vector3(spawnX, groundY, 0)
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:HideDepthOverlay()
		self:PickNewWanderTarget()
		log("MonsterAI: lost rudolph initialized")
	end

	@ExecSpace("ServerOnly")
	method void UpdateLostRudolphCycle(number delta)
		self._lostRudolphCycleTimer = self._lostRudolphCycleTimer - delta
		if self._lostRudolphCycleTimer > 0 then return end
		if self.IsStanding then
			self.IsStanding = false
			self.MonsterSprite = self._moveRUID
			self._lostRudolphCycleTimer = self.LostRudolphMoveMin + _UtilLogic:RandomDouble() * (self.LostRudolphMoveMax - self.LostRudolphMoveMin)
		else
			self.IsStanding = true
			self.MonsterSprite = self._standRUID
			self._lostRudolphCycleTimer = self.LostRudolphStandDuration
		end
	end

	@ExecSpace("ClientOnly")
	method void OnLostRudolphClientTouched(TouchEvent event)
		if not self._isLostRudolph then return end
		if _GameManager.GameOver then return end
		if _TitleUI.titleGroup.Enable then return end
		self:OnLostRudolphTouched()
	end

	@ExecSpace("Server")
	method void OnLostRudolphTouched()
		if not self._isLostRudolph or self._dead then return end
		if self.IsStanding then
			self._dead = true
			self:PlayDeathAnimation(self._dieRUID, self._dieDuration)
			self.Entity:Destroy(self._dieDuration + 0.2)
			_Ep3Map2LostRudolphLogic:OnCaught()
		else
			_Ep3Map2LostRudolphLogic:OnMissedTouch(self.Entity.TransformComponent.WorldPosition, self._spawnZoneIndex)
		end
	end

	@ExecSpace("ServerOnly")
	method void SetIsBadRudolph(boolean value)
		self._isBadRudolph = value
	end

	@ExecSpace("ServerOnly")
	method void RollMiniMooreDrop()
		if not isvalid(self) or not isvalid(self.Entity) then return end
		
		local worldPos = self.Entity.TransformComponent.WorldPosition
		local fallHeight = 0
		local groundWorldY = worldPos.y
		local map = self.Entity.CurrentMap
		if map ~= nil then
			---@type FootholdComponent
			local foothold = map:GetComponent("FootholdComponent")
			if foothold ~= nil then
				local hits = foothold:RaycastAll(Vector2(worldPos.x, worldPos.y), Vector2(0, -1), 50)
				local groundY = nil
				local bestDist = nil
				for i = 1, #hits do
					local h = hits[i]
					local y = h:GetYByX(worldPos.x)
					local dist = worldPos.y - y
					if bestDist == nil or dist < bestDist then
						bestDist = dist
						groundY = y
					end
				end
				if groundY ~= nil and worldPos.y > groundY then
					fallHeight = (worldPos.y - groundY) * 100
					groundWorldY = groundY
				end
			end
		end
		
		local dropScale = _CardManager:GetEffectScaleRatio(self)
		if _UtilLogic:RandomDouble() < self.MiniMooreDropChance then
			_CardManager:OnEliteKilled(worldPos, fallHeight, groundWorldY, dropScale)
			log("MonsterAI: mini moore dropped a skill")
		else
			_GameManager:ForceDropLootItem(worldPos, fallHeight, groundWorldY, dropScale)
			log("MonsterAI: mini moore dropped a junk item")
		end
	end

	@ExecSpace("ServerOnly")
	method void EndMiniMooreLife()
		if self._miniMooreDropTimerId ~= 0 then
			_TimerService:ClearTimer(self._miniMooreDropTimerId)
			self._miniMooreDropTimerId = 0
		end
		self._miniMooreLifeTimerId = 0
		if not isvalid(self) or not isvalid(self.Entity) then return end
		self:PlayDespawnJump()
		log("MonsterAI: mini moore lifetime ended, despawning")
	end

	@ExecSpace("ServerOnly")
	method void MarkElite()
		-- 엘리트 승급: 체력/공격력 +15%, 비주얼 스케일 확대. OnBeginPlay에서 웨이브 스탯이 잡힌 직후(스폰 직후) 호출된다.
		if self._isElite then return end
		self._isElite = true
		-- 보스(웨이브10+)의 x10 스케일과 곱연산으로 같이 적용되도록 덮어쓰지 않고 곱한다
		self._scaleMultiplier = self._scaleMultiplier * 1.15
		self.MaxHp = self.MaxHp * 1.15
		self.CurrentHp = self.MaxHp
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		-- 골드 아웃라인 머티리얼 적용 (MaterialId는 @Sync라 서버에서 바꾸면 클라이언트에 자동 반영)
		self.Entity.SpriteRendererComponent:ChangeMaterial(self.EliteOutlineMaterialId)
		log("MonsterAI: promoted to ELITE (HP=" .. math.floor(self.MaxHp) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void ApplySmallVariant()
		self._scaleMultiplier = self._scaleMultiplier * (2.0 / 3.0)
		self.MaxHp = math.floor(self.MaxHp * 0.8)
		self.CurrentHp = self.MaxHp
		self.ApproachSpeed = self.ApproachSpeed * self.SmallVariantSpeedMultiplier
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
	end

	@ExecSpace("ServerOnly")
	method void ApplyRushPenalty(integer tier)
		if not (self._isFlying or self._neverAttacks) then
			local mid = (self._currentScale + self._reachedScaleThreshold) * 0.5
			if mid > self._currentScale then
				self._currentScale = mid
				self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
				self:SyncDepthOverlaySprite()
				self:UpdateDepth()
			end
		end
		if tier >= 2 then
			self.MaxHp = math.floor(self.MaxHp * self.RushTier2StatMultiplier)
			self.CurrentHp = self.MaxHp
			-- 공격력은 체력과 다른 배율을 쓴다(위 프로퍼티 주석 참고)
			self._rushDamageMultiplier = self.RushTier2DamageMultiplier
		end
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- MonsterSprite가 동기화되면 SpriteRendererComponent의 RUID를 교체한다.
		-- 사망 후에는 무시 — Die()가 죽는 스프라이트로 이미 바꿔놨는데, 사망 처리 직후(Entity가
		-- 파괴 전 유예시간 동안 살아있는 동안) 뒤늦게 도착한 MonsterSprite 동기화가 이걸 다시
		-- 비행/서 있는 포즈로 덮어써버리는 버그(죽는 연출 직후 날아다니는 포즈가 잠깐 보임)가 있었다.
		if self._dead then return end
		if name == "MonsterSprite" and self.MonsterSprite ~= "" then
			local renderer = self.Entity.SpriteRendererComponent
			if renderer ~= nil then
				-- 버그 수정(2026-08-27, 유저 리포트: "웨어울프/라이칸스로프/스노우맨 공격 연출이 안 보이고
				-- 점프만 보임") — OnUpdate가 처음 도달(_reachedPlayer=true)하는 그 프레임에 self.MonsterSprite를
				-- stand로 바꾼 바로 다음 줄에서 OnReachPlayer()를 호출해 PlayAttackAnimation(Multicast)도
				-- 같은 프레임에 나간다. 이 MonsterSprite 동기화(OnSyncProperty)와 PlayAttackAnimation
				-- Multicast는 둘 다 서버→클라이언트 메시지라 도착 순서가 보장되지 않는다 — 동기화가 나중에
				-- 도착하면 방금 재생을 시작한 attack1(또는 hit1) 스프라이트를 여기서 즉시 stand로 되돌려버려,
				-- 실제로는 화면에 공격 포즈가 한 프레임도 안 보이고 PlayAttackHop(위치만 바뀌는 점프 트윈)만
				-- 보이는 문제였다(스노우맨처럼 원거리라 홉조차 없는 종은 아예 아무 반응도 없어 보였다).
				--
				-- ⚠ 1차 수정(current==self._attackRUID 비교)은 실측으로 무효였다 — _attackRUID/_hitRUID는
				-- @Sync가 아니라서 클라이언트에서는 항상 기본값 ""로 읽힌다(서버에서만 실제 값을 가짐).
				-- 라이브 디버그 로그로 "attackRUID=[]"가 매번 찍히는 걸 직접 확인. 대신 attack1/hit1
				-- 스프라이트를 실제로 세팅하는 PlayAttackAnimation/PlayHitAnimation 자신이(둘 다 클라이언트
				-- 에서 실행되는 Multicast라 정확한 RPC 인자를 받음) 순수 클라이언트 로컬 플래그
				-- (_isPlayingTransientSprite, 동기화 대상 아님)를 직접 세팅/해제하게 하고 여기서는 그 플래그만
				-- 확인한다.
				if not self._isPlayingTransientSprite then
					renderer.SpriteRUID = self.MonsterSprite
				end
			else
				log_warning("MonsterAI: SpriteRendererComponent nil")
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if self._dead then return end
		if _GameManager.GameOver then return end
		if self._isPushingBack then return end
		if self._paused then return end
		
		if self._isBonusBoss then
			self:UpdateWander(delta)
			-- 비행형과 동일한 원인의 버그 — 보너스 보스도 이 분기에서 바로 return해서 지상 전용 로직(콤보
			-- 어택 오브 회전 갱신)까지 못 내려갔다. 비행형 수정 때 같이 안 잡혔던 케이스(유저 재확인으로 발견).
			self:UpdateComboOrbPositions(delta)
			return
		end
		
		-- ep3_map1 "한겨울의 주황버섯" 이스터에그(지상형 미니무르) — 얄미운 미니무르와 동일한 드롭/전투
		-- 무시 정책이지만 비행이 아니라 BonusBoss와 동일한 방식(UpdateWander, 고정 Y 좌우 배회)으로
		-- 지상을 걸어다닌다. InitializeGroundMiniMoore()가 _isFlying=false로 설정해서 여기로 온다.
		if self._isMiniMoore and not self._isFlying then
			-- "길잃은 루돌프" 전용 이동/정지 사이클 — 정지 중엔 UpdateWander를 건너뛰어 실제로도
			-- 제자리에 멈춘다(다른 지상형 미니무르는 IsStanding이 항상 false라 동작 변화 없음).
			if self._isLostRudolph then
				self:UpdateLostRudolphCycle(delta)
			end
			if not self.IsStanding then
				self:UpdateWander(delta)
			end
			self:UpdateComboOrbPositions(delta)
			return
		end
		
		if self._isFlying then
			self:UpdateFlying(delta)
			-- 비행형은 이 아래 지상 전용 로직으로 못 내려가서 콤보어택 오브 회전이 갱신되지 않고
			-- 멈춰 있었다(유저 리포트: "연출이 고정되어 있고 뱅글뱅글 오브가 안돔") — 여기서 직접 호출.
			self:UpdateComboOrbPositions(delta)
			return
		end
		
		-- 돌진형 종(맘무트/골든맘무트/트라고스) wind-up: dash가 아직 시작 안 됐고 도달 전이면 제자리에서
		-- 위아래로 떨기만 하고 스케일 접근 로직 전체를 건너뛴다. wind-up이 끝나는 프레임에 dash를 시작시키고
		-- (ApproachSpeed 부스트 + 먼지 이펙트), 그 이후로는 이 분기 자체가 실행되지 않아 아래 일반 스케일
		-- 접근 로직(부스트된 속도로 훨씬 빠르게 진행)으로 자연히 이어진다.
		if self._isCharge and not self._chargeDashActive and not self._reachedPlayer then
			if not self._isStunned and not self._isHardFrozen then
				self._chargeWindupTimer = self._chargeWindupTimer - delta
				local jitterX = (_UtilLogic:RandomDouble() * 2 - 1) * self.ChargeShakeAmplitude
				local jitterY = (_UtilLogic:RandomDouble() * 2 - 1) * self.ChargeShakeAmplitude
				local jpos = self.Entity.TransformComponent.Position
				self.Entity.TransformComponent.Position = Vector3(self._chargeSpawnX + jitterX, self._chargeSpawnY + jitterY, jpos.z)
				if self._chargeWindupTimer <= 0 then
					self:StartChargeDash()
				end
			end
			return
		end
		
		-- 빙결/스턴 인디케이터는 map(=Entity.CurrentMap, 맵 루트)의 자식으로 스폰되는데 이 몬스터
		-- 자신은 Zone12 같은 오프셋 컨테이너의 자식일 수 있다 — 로컬 Position을 그대로 쓰면 존 오프셋만큼
		-- 어긋난 곳으로 계속 갱신되므로 WorldPosition을 써야 한다.
		-- 빙결 스택 UI 지표 위치 추적
		if isvalid(self._freezeIndicator) then
			local fpos = self.Entity.TransformComponent.WorldPosition
			self._freezeIndicator.TransformComponent.Position = Vector3(fpos.x + 0.45, fpos.y - 0.40, fpos.z - 0.05)
		end
		
		-- 스턴 별 이펙트 위치 추적 (머리 위)
		if isvalid(self._stunStarsIndicator) then
			local spos = self.Entity.TransformComponent.WorldPosition
			self._stunStarsIndicator.TransformComponent.Position = Vector3(spos.x, spos.y + 0.9, spos.z - 0.1)
		end
		
		-- 콤보어택 오브 회전(몬스터 자식 엔티티라 로컬 좌표만 갱신하면 됨 — 존 오프셋 보정 불필요)
		self:UpdateComboOrbPositions(delta)
		
		if self._reachedPlayer then
			-- 스턴/속박(ApplyStun) 중에는 이미 도달해서 공격 중이던 지상(근접) 유닛도 완전히 멈춰야
			-- 한다 — UpdateFlying(비행형)엔 이미 있던 체크인데 이 지상형 분기엔 빠져 있어서, 속박 중에도
			-- 이미 붙어있던 몬스터는 계속 공격이 나가는 버그가 있었다. 타이머 자체를 멈춰서 스턴이
			-- 끝나면 정상적으로 AttackInterval부터 다시 카운트되게 한다.
			if self._isStunned or self._isHardFrozen then return end
			-- 보물상자처럼 도달 상태를 재사용하되 실제로 공격하면 안 되는 고정 타겟은 여기서 건너뛴다
			if self._neverAttacks then return end
			-- 유저 요청: 에르다스는 도달 후에도 제자리에 얼어붙지 않고 공중 발판 위를 좌우로
			-- 배회하면서(발판을 벗어나면 낙하) 계속 공격한다 — 이동과 공격 타이머는 서로 독립적으로
			-- 같은 프레임에 같이 처리된다.
			if self._isErdas then
				self:UpdateErdasPatrol(delta)
			end
			-- 정면에 멈춰서 일정 간격으로 계속 공격
			self._attackTimer = self._attackTimer - delta
			if self._attackTimer <= 0 then
				self:OnReachPlayer()
				self._attackTimer = (self._customAttackInterval > 0) and self._customAttackInterval or self.AttackInterval
			end
			return
		end
		
		-- 스케일 증가 (카메라 접근 연출) — 스턴/완전빙결 중에는 전진 자체가 멈춰야 한다
		if not self._isStunned and not self._isHardFrozen then
			self._currentScale = self._currentScale + self.ApproachSpeed * delta
		end
		
		-- 닌자/재규어 지그재그: 전진(스케일)과 독립적으로 X만 사인파로 좌우 흔들되, 중심(_zigzagBaseX)에서
		-- 벗어나지 않게 한다. 도달(_reachedPlayer=true) 후에는 이 분기 자체가 실행되지 않으므로
		-- 자동으로 멈추고 정면에 고정된다. 스턴/속박(ApplyStun) 중에는 흔들림 자체를 멈춰야 하는데(유저
		-- 지적 — 지그재그 중에도 계속 좌우로 흔들리는 버그, 존27~30 닌자에도 원래 있던 문제) 타이머
		-- (_zigzagTime)까지 통째로 멈춰서 스턴이 풀리면 멈췄던 위상 그대로 이어서 흔들리게 한다.
		-- 완전빙결도 동일하게 멈춰야 한다.
		if self._isZigzag and not self._isStunned and not self._isHardFrozen then
			self._zigzagTime = self._zigzagTime + delta
			local offsetX = math.sin(self._zigzagTime * self.ZigzagFrequency + self._zigzagPhase) * self._zigzagAmplitudeActual
			local zpos = self.Entity.TransformComponent.Position
			self.Entity.TransformComponent.Position = Vector3(self._zigzagBaseX + offsetX, zpos.y, zpos.z)
		
			if self._hasZigzagAfterimage then
				self._afterimageTimer = self._afterimageTimer - delta
				if self._afterimageTimer <= 0 then
					self:SpawnAfterimage()
					self._afterimageTimer = self.AfterimageInterval
				end
			end
		end
		
		if self._currentScale >= self._reachedScaleThreshold then
			-- 도달 임계값(근접 1.5 / 원거리는 더 낮음)에 도달 → 소멸하지 않고 그 자리에서 계속 공격 시작
			self._currentScale = self._reachedScaleThreshold
			local reachedScale = self._reachedScaleThreshold * self._scaleMultiplier * (1.0 + self._erdasHitGrowthBonus)
			self.Entity.TransformComponent.Scale = Vector3(reachedScale, reachedScale, 1.0)
			self:UpdateDepth()
			self._reachedPlayer = true
			self._attackTimer = (self._customAttackInterval > 0) and self._customAttackInterval or self.AttackInterval
			-- 도달했으니 걷는 포즈(move)에서 정지 포즈(stand)로 되돌린다 — move가 아예 없던 종(moveRUID=="")은
			-- 이미 MonsterSprite가 stand였으므로 그대로 다시 대입해도 무해하다.
			self.MonsterSprite = self._standRUID
			self:SyncDepthOverlaySprite()
			self:OnReachPlayer()
		else
			local approachScale = self._currentScale * self._scaleMultiplier * (1.0 + self._erdasHitGrowthBonus)
			self.Entity.TransformComponent.Scale = Vector3(approachScale, approachScale, 1.0)
			self:UpdateDepth()
		end
	end

	@ExecSpace("ServerOnly")
	method void UpdateWander(number delta)
		self._wanderRetargetTimer = self._wanderRetargetTimer - delta
		if self._wanderRetargetTimer <= 0 then
			self:PickNewWanderTarget()
		end
		
		local pos = self.Entity.TransformComponent.Position
		local dx = self._wanderTargetX - pos.x
		local step = self._wanderSpeed * delta
		local moveX = pos.x
		if math.abs(dx) <= step then
			moveX = self._wanderTargetX
		elseif dx > 0 then
			moveX = pos.x + step
		else
			moveX = pos.x - step
		end
		self.Entity.TransformComponent.Position = Vector3(moveX, self._wanderY, pos.z)
	end

	@ExecSpace("ServerOnly")
	method void PickNewWanderTarget()
		self._wanderTargetX = self._wanderMinX + _UtilLogic:RandomDouble() * (self._wanderMaxX - self._wanderMinX)
		self._wanderRetargetTimer = 0.4 + _UtilLogic:RandomDouble() * 0.6
	end

	@ExecSpace("ServerOnly")
	method void UpdateErdasPatrol(number delta)
		local map = self.Entity.CurrentMap
		if map == nil then return end
		local pos = self.Entity.TransformComponent.Position
		---@type FootholdComponent
		local foothold = map:GetComponent("FootholdComponent")
		
		if self._isErdasFalling then
			self._erdasFallVelocity = self._erdasFallVelocity + self.ErdasGravity * delta
			local fallY = pos.y - self._erdasFallVelocity * delta
			local landed = false
			if foothold ~= nil then
				local hit = foothold:Raycast(Vector2(pos.x, pos.y), Vector2(0, -1), 200)
				if hit ~= nil then
					local groundY = hit:GetYByX(pos.x)
					if fallY <= groundY then
						fallY = groundY
						landed = true
					end
				end
			end
			self.Entity.TransformComponent.Position = Vector3(pos.x, fallY, pos.z)
			if landed then
				self._isErdasFalling = false
				self._erdasFallVelocity = 0
			end
			return
		end
		
		self._erdasPatrolRetargetTimer = self._erdasPatrolRetargetTimer - delta
		if self._erdasPatrolRetargetTimer <= 0 then
			self:PickNewErdasPatrolTarget()
		end
		
		local dx = self._erdasPatrolTargetX - pos.x
		local step = self.ErdasPatrolSpeed * delta
		local moveX = pos.x
		if math.abs(dx) <= step then
			moveX = self._erdasPatrolTargetX
		elseif dx > 0 then
			moveX = pos.x + step
		else
			moveX = pos.x - step
		end
		
		-- 짧은 거리만 살펴서 "지금 딛고 있는 발판"만 인식한다 — 아래로 멀리까지 훑으면 훨씬 아래에 있는
		-- 메인 바닥까지 걸려서 발판을 벗어나도 계속 그 자리에 붙어있는 것처럼 보인다
		local onFoothold = false
		local groundY = pos.y
		if foothold ~= nil then
			local hit = foothold:Raycast(Vector2(moveX, pos.y + 0.2), Vector2(0, -1), 0.6)
			if hit ~= nil then
				groundY = hit:GetYByX(moveX)
				onFoothold = true
			end
		end
		
		if onFoothold then
			self.Entity.TransformComponent.Position = Vector3(moveX, groundY, pos.z)
		else
			self._isErdasFalling = true
			self._erdasFallVelocity = 0
			self.Entity.TransformComponent.Position = Vector3(moveX, pos.y, pos.z)
		end
	end

	method void PickNewErdasPatrolTarget()
		self._erdasPatrolTargetX = self._erdasPatrolMinX + _UtilLogic:RandomDouble() * (self._erdasPatrolMaxX - self._erdasPatrolMinX)
		self._erdasPatrolRetargetTimer = 1.5 + _UtilLogic:RandomDouble() * 1.5
	end

	@ExecSpace("ServerOnly")
	method void ApplyErdasHitGrowth()
		if self._erdasHitGrowthBonus >= self.ErdasHitGrowthMaxBonus then return end
		self._erdasHitGrowthBonus = math.min(self.ErdasHitGrowthMaxBonus, self._erdasHitGrowthBonus + self.ErdasHitGrowthPerHit)
		local scale = self._currentScale * self._scaleMultiplier * (1.0 + self._erdasHitGrowthBonus)
		self.Entity.TransformComponent.Scale = Vector3(scale, scale, 1.0)
	end

	@ExecSpace("ServerOnly")
	method void StartChargeDash()
		self._chargeDashActive = true
		local pos = self.Entity.TransformComponent.Position
		self.Entity.TransformComponent.Position = Vector3(self._chargeSpawnX, self._chargeSpawnY, pos.z)
		-- 유저 지정(2026-08-22): 원형파장(DustExplosion — "연기와 함께 원형 파장이 터지는" 네이티브
		-- 파티클) 위치가 발밑에 너무 깔려 보였다는 지적으로 Y오프셋을 0.5 올림(-0.25 → 0.25).
		_ParticleService:PlayBasicParticleAttached(
			BasicParticleType.DustExplosion,
			self.Entity,
			Vector3(0, 0.25, 0.1),
			0,
			Vector3(self.ChargeDustScale, self.ChargeDustScale, self.ChargeDustScale),
			false,
			{ SortingLayer = self.ChargeDustSortingLayer, OrderInLayer = self.ChargeDustOrderInLayer }
		)
		self.ApproachSpeed = self.ApproachSpeed * self.ChargeDashSpeedMultiplier
		log("MonsterAI: charge dash started, boosted ApproachSpeed=" .. self.ApproachSpeed)
	end

	@ExecSpace("ServerOnly")
	method void UpdateFlying(number delta)
		-- 스턴/속박(ApplyStun) 중에는 지상 몬스터처럼 완전히 멈춰야 한다 — ApproachSpeed=0만으로는
		-- 공중 몬스터(사인파 기반 UpdateFlying)를 막지 못해서 별도로 체크한다. 완전빙결도 동일하다.
		if self._isStunned or self._isHardFrozen then return end
		self._flyTime = self._flyTime + delta
		local x = self._flyCenterX + math.sin(self._flyTime * self.FlySpeedX * self._flySpeedMultX + self._flyPhaseX) * self.FlyRangeX
		local yAmplitude = (self.FlyingWanderMaxY - self.FlyingWanderMinY) * 0.5
		local y = self._flyBaseY + math.sin(self._flyTime * self.FlySpeedY * self._flySpeedMultY + self._flyPhaseY) * yAmplitude
		local pos = self.Entity.TransformComponent.Position
		self.Entity.TransformComponent.Position = Vector3(x, y, pos.z)
		
		-- 무리원(_isSwarmMember) 전용 — CardManager.FindTarget()은 살아있는 몬스터 중 _currentScale이
		-- 가장 큰 "단 하나"만 매 프레임 고정 타겟으로 고른다(전 게임 공통 로직, 엄격한 > 비교라 동률이면
		-- 먼저 나온 쪽이 계속 이긴다). 일반 몬스터는 접근하며 스케일이 계속 자라 자연히 타겟이 바뀌는데,
		-- 미니빈은 스케일이 고정이라 그중 한 마리(스케일이 가장 낮게 뽑힌 개체)가 다른 개체들이 전부
		-- 죽기 전까지 영원히 타겟에서 배제됐다(유저 리포트: "현재 공격하는 한마리는 플레이어가 공격
		-- 자체를 못함"). 각자 비행 위상(_flyPhaseX, 스폰 시 이미 개별 랜덤)에 맞춰 아주 작게(±2%,
		-- 육안으로는 거의 안 보임 — 유저가 뺀 "커졌다 작아졌다"는 공격 순간의 큰 들이받기 펌프였지 이
		-- 미세한 상시 진동이 아니다) 흔들어서, 매 순간 "제일 큰" 개체가 무리 안에서 계속 돌아가며
		-- 바뀌게 한다.
		if self._isSwarmMember then
			local swarmScale = 1.0 + math.sin(self._flyTime * 1.7 + self._flyPhaseX) * 0.02
			self._currentScale = swarmScale
			self.Entity.TransformComponent.Scale = Vector3(swarmScale * self._scaleMultiplier, swarmScale * self._scaleMultiplier, 1.0)
		end
		
		self._attackTimer = self._attackTimer - delta
		if self._attackTimer <= 0 then
			-- 미니무르/_neverAttacks(노란 미니빈 등)는 순수 이스터에그용(플레이어를 공격하지 않음) —
			-- 공격 판정 자체를 건너뛴다. _neverAttacks는 원래 지상형 분기(_reachedPlayer)에서만
			-- 체크되고 있었는데, 비행형은 이 분기를 아예 안 타서 무시되고 있었다.
			if not self._isMiniMoore and not self._neverAttacks then
				self:OnReachPlayer()
			end
			self._attackTimer = self.FlyAttackInterval
		end
	end

	@ExecSpace("ServerOnly")
	method void PlayDespawnJump()
		local map = self.Entity.CurrentMap
		local startPos = self.Entity.TransformComponent.Position
		if map ~= nil then
			-- Entity.CurrentMap은 물리적 최상위 맵 엔티티(맵 루트)를 가리키는데, 이 몬스터의 실제
			-- 부모는 Zone12 같은 오프셋을 가진 자식 컨테이너일 수 있다 — 이 경우 로컬(startPos)과
			-- 루트 기준 좌표가 어긋나므로, SpawnByModelId(parent=map=루트)에 넘길 좌표는 반드시
			-- WorldPosition으로 다시 구해야 한다(실측: 안 그러면 먼지가 몬스터 옆이 아니라 존 오프셋만큼
			-- 떨어진 엉뚱한 곳에서 뜬다).
			local worldPos = self.Entity.TransformComponent.WorldPosition
			local dustPos = Vector3(worldPos.x, worldPos.y - 0.35, worldPos.z + 0.1)
			local dust = _SpawnService:SpawnByModelId("skilleffect", "Dust", dustPos, map)
			if dust ~= nil then
				local r = dust.SpriteRendererComponent
				if r ~= nil then r.SpriteRUID = "98262e9a441d41abb19a6d519f74aec7" end
				dust:Destroy(0.5)
			end
		end
		
		local duration = 0.6
		local jumpHeight = 3.0
		_TweenLogic:PlayTween(0.0, 1.0, duration, EaseType.QuadEaseIn, function(t)
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local y = startPos.y + jumpHeight * t
			self.Entity.TransformComponent.Position = Vector3(startPos.x, y, startPos.z)
			local renderer = self.Entity.SpriteRendererComponent
			if renderer ~= nil then renderer.Color = Color(1, 1, 1, 1.0 - t) end
		end)
		
		self.Entity:Destroy(duration + 0.05)
	end

	@ExecSpace("ServerOnly")
	method void UpdateDepth()
		-- 스케일이 작을수록(멀리 있을수록) Z를 크게 해서 뒤로 깔리고,
		-- 스케일이 커질수록(가까이 다가올수록) Z를 작게 해서 앞으로 나오게 한다
		local pos = self.Entity.TransformComponent.Position
		local depth = 1.5 - self._currentScale - self._depthTieBreak
		self.Entity.TransformComponent.Position = Vector3(pos.x, pos.y, depth)
		
		-- 깊이 오버레이 알파도 같이 갱신: 스폰(0.3) 시점엔 DepthOverlayMaxAlpha(가장 어두움),
		-- 도달 임계값(_reachedScaleThreshold — 근접/원거리 몬스터마다 다름)에 가까워질수록 0(원래 색)으로 선형 보간
		local overlay = self:GetDepthOverlayRenderer()
		if overlay ~= nil then
			local span = self._reachedScaleThreshold - 0.3
			local t = 0
			if span > 0 then t = (self._currentScale - 0.3) / span end
			if t < 0 then t = 0 elseif t > 1 then t = 1 end
			overlay.Color = Color(0, 0, 0, self.DepthOverlayMaxAlpha * (1 - t))
		end
	end

	@ExecSpace("ServerOnly")
	method SpriteRendererComponent GetDepthOverlayRenderer()
		if self._depthOverlayRenderer == nil then
			local overlayEntity = self.Entity:GetChildByName("DepthOverlay")
			if overlayEntity ~= nil then
				self._depthOverlayRenderer = overlayEntity.SpriteRendererComponent
			end
		end
		return self._depthOverlayRenderer
	end

	@ExecSpace("ServerOnly")
	method void SyncDepthOverlaySprite()
		local overlay = self:GetDepthOverlayRenderer()
		if overlay ~= nil then
			overlay.SpriteRUID = self.MonsterSprite
		end
	end

	@ExecSpace("ServerOnly")
	method void UpdateAnimationFreeze()
		local rate = 1
		if self._isStunned or self._isHardFrozen then rate = 0 end
		local renderer = self.Entity.SpriteRendererComponent
		if renderer ~= nil then renderer.PlayRate = rate end
		local overlay = self:GetDepthOverlayRenderer()
		if overlay ~= nil then overlay.PlayRate = rate end
	end

	@ExecSpace("ServerOnly")
	method void HideDepthOverlay()
		local overlay = self:GetDepthOverlayRenderer()
		if overlay ~= nil then overlay.Color = Color(0, 0, 0, 0) end
	end

	@ExecSpace("ServerOnly")
	method void FlashHideDepthOverlay(number duration)
		self:HideDepthOverlay()
		_TimerService:SetTimerOnce(function()
			if isvalid(self) and not self._dead then self:UpdateDepth() end
		end, duration)
	end

	@ExecSpace("ServerOnly")
	method number GetGearEliteBossDamageMult()
		if self._isElite or self._isBoss or self._isBonusBoss then
			return _GearEffectLogic:GetEliteBossDamageMult()
		end
		return 1.0
	end

	@ExecSpace("ServerOnly")
	method void TakeDamage(number damage)
		-- 카드 공격 시 호출
		if self._dead then return end
		if self._isCauldron and self._cauldronLocked then return end
		damage = damage * self:GetGearEliteBossDamageMult()
		if self._isBonusBoss then
			if self._bonusBossCombatLocked then return end
			-- 버그 수정(2026-08-26, 유저 리포트 "죽는 연출 2번 나오는거같아") — 킬링 블로우에서 히트
			-- 애니메이션 직후 곧바로 사망 연출이 스프라이트를 또 덮어써서 두 연출이 몇 프레임 간격으로
			-- 겹쳐 보였다 — 이 타격으로 죽는지 미리 계산해, 죽는 타격이면 히트 애니메이션은 건너뛰고
			-- 바로 사망 연출로 넘어간다.
			local willDie = self._bonusBossKillable and (self.CurrentHp - damage) <= 0
			self:PlayDamageSkin(damage, false)
			if not willDie then self:PlayHitAnimation(self._hitRUID, self.MonsterSprite) end
			self:OnBonusBossHit()
			if self._bonusBossKillable then
				self.CurrentHp = self.CurrentHp - damage
				if self.CurrentHp <= 0 then self:OnBonusBossDefeated() end
			end
			return
		end
		if self._isMiniMoore then
			-- 전투 대상이 아니다 — 타격을 완전히 무시한다(반응/보상 없음, RollMiniMooreDrop이 별도로 처리)
			return
		end
		self.CurrentHp = self.CurrentHp - damage
		if self._isErdas then self:ApplyErdasHitGrowth() end
		log("Monster HP: " .. self.CurrentHp .. "/" .. self.MaxHp)
		self:PlayDamageSkin(damage, false)
		self:PlayHitAnimation(self._hitRUID, self.MonsterSprite)
		self:FlashHideDepthOverlay(self.HitFlashDuration)
		if self.CurrentHp <= 0 then
			self:Die()
		end
	end

	@ExecSpace("Multicast")
	method void PlayHitAnimation(string hitRUID, string standRUID)
		if self:IsServer() then return end
		if self._dead then return end
		if self._hitSoundRUID ~= "" then _SoundOptionLogic:PlaySfx(self._hitSoundRUID, 1.0) end
		local renderer = self.Entity.SpriteRendererComponent
		if renderer == nil or hitRUID == "" then return end
		renderer.SpriteRUID = hitRUID
		-- OnSyncProperty(MonsterSprite)가 이 재생 중에 되돌리지 못하도록 표시(MonsterAI 상단
		-- _isPlayingTransientSprite 주석 참고). 세대 번호로 겹치는 호출 중 최신 것만 실제로 되돌린다
		-- (위 _transientSpriteGeneration 주석 참고).
		self._isPlayingTransientSprite = true
		self._transientSpriteGeneration = self._transientSpriteGeneration + 1
		local myGeneration = self._transientSpriteGeneration
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			if self._transientSpriteGeneration ~= myGeneration then return end
			-- 죽음(일반 사망이든 예티류의 1→2페이즈 변신이든)으로 이미 전환된 뒤라면 절대 건드리지 않는다 —
			-- 이 함수는 Multicast라 서버의 TakeDamage가 같은 프레임에 보낸 PlayPhase1TransformAnimation/
			-- PlayDeathAnimation과 클라이언트 도착 순서가 보장되지 않는다. 순서가 뒤집히면(변신 연출이 먼저
			-- 도착해 die1로 바뀐 뒤 이 히트 복원 타이머가 나중에 stand로 되돌리는 경우) 변신 중인 몬스터가
			-- 잠깐 원래 1페이즈 stand 포즈로 보였다가 사라진 것처럼 보이는 버그가 있었다(유저 리포트 —
			-- "페이즈 2 변화하다가 그냥 사라져"). _dead를 한 번 더 확인해 die1/변신 중에는 복원을 건너뛴다.
			if self._dead then
				self._isPlayingTransientSprite = false
				return
			end
			-- hit1 상태일 때만 stand로 복원 — die1로 전환된 뒤라면 그대로 둔다
			if renderer.SpriteRUID == hitRUID then
				renderer.SpriteRUID = standRUID
			end
			self._isPlayingTransientSprite = false
		end, self.HitFlashDuration)
	end

	@ExecSpace("Multicast")
	method void PlayDamageSkin(number damage, boolean isCritical)
		if self:IsServer() then return end
		_DamageSkinService:Play(self.Entity, self._damageSkinId, 0.05, { math.floor(damage) }, DamageSkinTweenType.Default, isCritical)
	end

	@ExecSpace("Multicast")
	method void PlayDamageSkinWithOffset(number damage, boolean isCritical, Vector2 offset)
		if self:IsServer() then return end
		_DamageSkinService:Play(self.Entity, self._damageSkinId, 0.05, { math.floor(damage) }, DamageSkinTweenType.Default, isCritical, offset)
	end

	@ExecSpace("ServerOnly")
	method void TakeDamageWithOffset(number damage, Vector2 offset)
		if self._dead then return end
		if self._isCauldron and self._cauldronLocked then return end
		if self._isBonusBoss then
			if self._bonusBossCombatLocked then return end
			-- 버그 수정(2026-08-26) — TakeDamage와 동일 이유(킬링 블로우 히트+사망 연출 겹침 방지)
			local willDie = self._bonusBossKillable and (self.CurrentHp - damage) <= 0
			self:PlayDamageSkinWithOffset(damage, false, offset)
			if not willDie then self:PlayHitAnimation(self._hitRUID, self.MonsterSprite) end
			self:OnBonusBossHit()
			if self._bonusBossKillable then
				self.CurrentHp = self.CurrentHp - damage
				if self.CurrentHp <= 0 then self:OnBonusBossDefeated() end
			end
			return
		end
		if self._isMiniMoore then
			return
		end
		self.CurrentHp = self.CurrentHp - damage
		if self._isErdas then self:ApplyErdasHitGrowth() end
		log("Monster HP: " .. self.CurrentHp .. "/" .. self.MaxHp)
		self:PlayDamageSkinWithOffset(damage, false, offset)
		self:PlayHitAnimation(self._hitRUID, self.MonsterSprite)
		self:FlashHideDepthOverlay(self.HitFlashDuration)
		if self.CurrentHp <= 0 then
			self:Die()
		end
	end

	@ExecSpace("ServerOnly")
	method void TakeDamageCritWithOffset(number damage, Vector2 offset)
		if self._dead then return end
		if self._isCauldron and self._cauldronLocked then return end
		damage = damage * (1.0 + _CardManager:GetCriticalShotBonus() + _CardManager:GetKarmaBonus())
		-- 장비 치명타 피해 보너스(자마다르 에픽 상시 / 레전더리 확률 버프) — 모든 크리티컬이
		-- 이 두 진입점(TakeDamageCrit / TakeDamageCritWithOffset)만 거치므로 개별 스킬의
		-- `damage * 2` 호출부를 전부 건드릴 필요가 없다
		damage = damage * (1.0 + _GearEffectLogic:GetCritDamageBonus()) * self:GetGearEliteBossDamageMult()
		if self._isBonusBoss then
			if self._bonusBossCombatLocked then return end
			-- 버그 수정(2026-08-26) — TakeDamage와 동일 이유(킬링 블로우 히트+사망 연출 겹침 방지)
			local willDie = self._bonusBossKillable and (self.CurrentHp - damage) <= 0
			self:PlayDamageSkinWithOffset(damage, true, offset)
			if not willDie then self:PlayHitAnimation(self._hitRUID, self.MonsterSprite) end
			self:OnBonusBossHit()
			if self._bonusBossKillable then
				self.CurrentHp = self.CurrentHp - damage
				if self.CurrentHp <= 0 then self:OnBonusBossDefeated() end
			end
			return
		end
		if self._isMiniMoore then
			return
		end
		self.CurrentHp = self.CurrentHp - damage
		if self._isErdas then self:ApplyErdasHitGrowth() end
		log("Monster HP (CRIT): " .. self.CurrentHp .. "/" .. self.MaxHp)
		self:PlayDamageSkinWithOffset(damage, true, offset)
		self:PlayHitAnimation(self._hitRUID, self.MonsterSprite)
		self:FlashHideDepthOverlay(self.HitFlashDuration)
		if self.CurrentHp <= 0 then
			self:Die()
		end
	end

	@ExecSpace("ServerOnly")
	method void TakeDamageCrit(number damage)
		if self._dead then return end
		if self._isCauldron and self._cauldronLocked then return end
		-- 크리티컬 샷(카드111, 실피드 전용 패시브) + 카르마(카드182, 쉐이드 전용 패시브) 보너스 —
		-- 모든 크리티컬 대미지에 추가 배율 적용(같은 런에서 둘 다 활성일 수 없어 가산해도 안전)
		damage = damage * (1.0 + _CardManager:GetCriticalShotBonus() + _CardManager:GetKarmaBonus())
		-- 장비 치명타 피해 보너스(자마다르 에픽 상시 / 레전더리 확률 버프) — 모든 크리티컬이
		-- 이 두 진입점(TakeDamageCrit / TakeDamageCritWithOffset)만 거치므로 개별 스킬의
		-- `damage * 2` 호출부를 전부 건드릴 필요가 없다
		damage = damage * (1.0 + _GearEffectLogic:GetCritDamageBonus()) * self:GetGearEliteBossDamageMult()
		if self._isBonusBoss then
			if self._bonusBossCombatLocked then return end
			-- 버그 수정(2026-08-26) — TakeDamage와 동일 이유(킬링 블로우 히트+사망 연출 겹침 방지)
			local willDie = self._bonusBossKillable and (self.CurrentHp - damage) <= 0
			self:PlayDamageSkin(damage, true)
			if not willDie then self:PlayHitAnimation(self._hitRUID, self.MonsterSprite) end
			self:OnBonusBossHit()
			if self._bonusBossKillable then
				self.CurrentHp = self.CurrentHp - damage
				if self.CurrentHp <= 0 then self:OnBonusBossDefeated() end
			end
			return
		end
		if self._isMiniMoore then
			-- 전투 대상이 아니다 — 타격을 완전히 무시한다(반응/보상 없음, RollMiniMooreDrop이 별도로 처리)
			return
		end
		self.CurrentHp = self.CurrentHp - damage
		if self._isErdas then self:ApplyErdasHitGrowth() end
		log("Monster HP (CRIT): " .. self.CurrentHp .. "/" .. self.MaxHp)
		self:PlayDamageSkin(damage, true)
		self:PlayHitAnimation(self._hitRUID, self.MonsterSprite)
		self:FlashHideDepthOverlay(self.HitFlashDuration)
		if self.CurrentHp <= 0 then
			self:Die()
		end
	end

	@ExecSpace("ServerOnly")
	method void TakeDamageDelayedDeath(number damage, boolean isCrit, number deathDelay)
		if self._dead then return end
		if self._isCauldron and self._cauldronLocked then return end
		-- 크리티컬 샷(카드111)/카르마(카드182) 보너스 — 크리티컬 경로에서만 추가 배율 적용
		if isCrit then damage = damage * (1.0 + _CardManager:GetCriticalShotBonus() + _CardManager:GetKarmaBonus()) end
		if self._isBonusBoss then
			if self._bonusBossCombatLocked then return end
			-- 버그 수정(2026-08-26) — TakeDamage와 동일 이유(킬링 블로우 히트+사망 연출 겹침 방지)
			local willDie = self._bonusBossKillable and (self.CurrentHp - damage) <= 0
			self:PlayDamageSkin(damage, isCrit)
			if not willDie then self:PlayHitAnimation(self._hitRUID, self.MonsterSprite) end
			self:OnBonusBossHit()
			if self._bonusBossKillable then
				self.CurrentHp = self.CurrentHp - damage
				if self.CurrentHp <= 0 then self:OnBonusBossDefeated() end
			end
			return
		end
		if self._isMiniMoore then
			return
		end
		self.CurrentHp = self.CurrentHp - damage
		if self._isErdas then self:ApplyErdasHitGrowth() end
		log("Monster HP (delayed-death): " .. self.CurrentHp .. "/" .. self.MaxHp)
		self:PlayDamageSkin(damage, isCrit)
		self:PlayHitAnimation(self._hitRUID, self.MonsterSprite)
		self:FlashHideDepthOverlay(self.HitFlashDuration)
		if self.CurrentHp <= 0 then
			_TimerService:SetTimerOnce(function()
				if isvalid(self) and not self._dead then self:Die() end
			end, deathDelay)
		end
	end

	@ExecSpace("ServerOnly")
	method void OnBonusBossHit()
		_GameManager:AddGold(self.BonusGoldPerHit)
		-- ForceDropPotion/OnEliteKilled는 파라미터 이름부터 worldPos일 정도로 월드 좌표를 기대한다
		-- (화면 좌표 환산·다른 부모 하위 스폰에 쓰임) — 로컬 Position을 넘기면 존 오프셋만큼 어긋난다.
		local dropScale = _CardManager:GetEffectScaleRatio(self)
		if _UtilLogic:RandomDouble() < self.BonusPotionChance then
			_GameManager:ForceDropPotion(self.Entity.TransformComponent.WorldPosition, dropScale)
		end
		if _UtilLogic:RandomDouble() < self.BonusSkillChance then
			-- 보너스 보스는 비행형이 아니라 사망 위치가 항상 바닥이므로 fallHeight=0 고정(groundWorldY는 미사용)
			local wp = self.Entity.TransformComponent.WorldPosition
			_CardManager:OnEliteKilled(wp, 0, wp.y, dropScale)
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplySlow(number duration)
		-- 이동속도를 50% 감소. 중복 적용 시 타이머만 갱신 (속도 이중 감소 방지)
		if not self._isSlowed then
			self.ApproachSpeed = self.ApproachSpeed * 0.5
			self._isSlowed = true
			-- 슬로우 상태를 눈에 보이게 하늘색으로 틴트. 알파는 반드시 1.0(불투명) — 원작 메이플스토리의
			-- 빙결 연출처럼 몸 전체가 통짜 색으로 바뀌는 느낌을 내기 위함이고, 알파를 낮추면(반투명) 몬스터끼리
			-- 겹칠 때 뒤에 있는 몬스터가 비쳐 보여 지저분해 보인다(깊이 오버레이와는 별개 문제).
			-- (SpriteRendererComponent.Color는 @Sync라 서버에서 바꾸면 클라이언트에 자동 반영)
			local renderer = self.Entity.SpriteRendererComponent
			if renderer ~= nil then renderer.Color = Color(0.6, 0.85, 1.0, 1.0) end
		end
		if self._slowTimerId ~= 0 then
			_TimerService:ClearTimer(self._slowTimerId)
		end
		self._slowTimerId = _TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(self.Entity) then return end
			self._slowTimerId = 0
			if not self._isSlowed then return end
			if self._freezeSlowed then return end  -- 빙결이 슬로우 유지 중
			self.ApproachSpeed = self.ApproachSpeed * 2.0
			self._isSlowed = false
			local renderer = self.Entity.SpriteRendererComponent
			if renderer ~= nil then renderer.Color = Color(1, 1, 1, 1) end
		end, duration)
	end

	@ExecSpace("ServerOnly")
	method void ApplyStun(number duration, boolean showIndicator)
		-- 잠깐 완전히 멈췄다가 원래 속도로 돌아온다. 중복 적용 시 타이머만 갱신
		if not self._isStunned then
			self._stunSavedSpeed = self.ApproachSpeed
			self.ApproachSpeed = 0
			self._isStunned = true
			self:UpdateAnimationFreeze()
			if showIndicator then self:SpawnStunStars() end
		end
		if self._stunTimerId ~= 0 then
			_TimerService:ClearTimer(self._stunTimerId)
		end
		self._stunTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(self) and isvalid(self.Entity) and self._isStunned then
				self.ApproachSpeed = self._stunSavedSpeed
				self._isStunned = false
				self._stunTimerId = 0
				self:UpdateAnimationFreeze()
				self:DestroyStunStars()
				-- 아쿠아 트랩/서지는 ApplyStun과 ApplyLevitate를 같은 duration으로 같이 걸지만 둘은
				-- 완전히 독립된 타이머다 — 다른 스킬(예: 썬더볼트)이 같은 대상에게 더 짧은 스턴을
				-- 다시 걸면 ApplyStun 쪽만 먼저 풀리고 ApplyLevitate는 원래(더 긴) 자기 타이머대로
				-- 계속 떠 있어서, "속박(스턴)은 풀렸는데 공중에 계속 떠 있는" 것처럼 보이는 불일치가
				-- 있었다 — 스턴이 풀리는 시점에 아직 떠 있다면 그때 바로 착지시켜 동기화한다.
				if self._isLevitating then self:LandFromLevitate(0.2) end
			end
		end, duration)
	end

	@ExecSpace("ServerOnly")
	method void ApplyAccuracyDebuff(number missChance, number duration)
		self._accuracyDebuffPercent = missChance
		if self._accuracyDebuffTimerId ~= 0 then
			_TimerService:ClearTimer(self._accuracyDebuffTimerId)
		end
		self._accuracyDebuffTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(self) then
				self._accuracyDebuffPercent = 0
				self._accuracyDebuffTimerId = 0
			end
		end, duration)
	end

	@ExecSpace("ServerOnly")
	method void ApplyHardFreeze(number duration)
		-- _dead 체크를 여기서 하지 않는다 — 스폰 재사용 엔티티가 죽은 적 없는데도 _dead=true로
		-- 읽히는 잔존 버그(InitializeStats 참고)에 걸리면 이 가드가 얼려야 할 몬스터를 조용히
		-- 건너뛰어버렸다("아이템 먹었는데 안 얼어있다" 버그의 원인). 실제 사망 처리는 OnUpdate
		-- 맨 앞의 _dead 체크(행동 자체를 막음)가 이미 담당하므로 여기서 또 막을 필요가 없다.
		if not self._isHardFrozen then
			self._isHardFrozen = true
			local renderer = self.Entity.SpriteRendererComponent
			if renderer ~= nil then
				self._preHardFreezeColor = renderer.Color
				renderer.Color = Color(0.35, 0.55, 1.0, 1.0)
			end
			-- 색만 바꾸면 스프라이트 자체가 animationclip인 경우(걷기/서있기 등) 자체 재생이
			-- 계속 돌아서 "얼어서 행동은 못 하는데 방방 뛰는 idle 연출은 계속 재생되는" 것처럼
			-- 보였다 — PlayRate=0으로 지금 프레임에 그대로 멈춘다(본체+그림자 둘 다, UpdateAnimationFreeze 참고).
			self:UpdateAnimationFreeze()
		end
		if self._hardFreezeTimerId ~= 0 then
			_TimerService:ClearTimer(self._hardFreezeTimerId)
		end
		self._hardFreezeTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(self) and isvalid(self.Entity) and self._isHardFrozen then
				self._isHardFrozen = false
				self._hardFreezeTimerId = 0
				local renderer = self.Entity.SpriteRendererComponent
				if renderer ~= nil then
					renderer.Color = self._preHardFreezeColor
				end
				self:UpdateAnimationFreeze()
			end
		end, duration)
	end

	@ExecSpace("ServerOnly")
	method void SpawnStunStars()
		-- 머리 위에 뺑글뻉글 도는 별 이펙트를 스폰한다 (색상 틴트 대신 사용)
		if isvalid(self._stunStarsIndicator) then return end
		local map = self.Entity.CurrentMap
		if map == nil then return end
		-- map(=CurrentMap)은 맵 루트라 로컬 Position이 아니라 WorldPosition을 써야 존 오프셋과 맞는다
		local pos = self.Entity.TransformComponent.WorldPosition
		local starPos = Vector3(pos.x, pos.y + 0.9, pos.z - 0.1)
		self._stunStarsIndicator = _SpawnService:SpawnByModelId("stunstars", "StunStars", starPos, map)
	end

	@ExecSpace("ServerOnly")
	method void DestroyStunStars()
		if isvalid(self._stunStarsIndicator) then
			self._stunStarsIndicator:Destroy()
			self._stunStarsIndicator = nil
		end
	end

	@ExecSpace("ServerOnly")
	method void AddFreezeStack()
		-- 프리징 이펙트 패시브가 활성화된 경우에만 동작
		if _CardManager.FreezingEffectLevel <= 0 then return end
		if self._dead then return end
		if self.FreezeStack >= 5 then return end
		self.FreezeStack = self.FreezeStack + 1
		-- 첫 스택에서 슬로우 적용 (아직 freeze-slow가 없을 때만)
		if self.FreezeStack == 1 and not self._freezeSlowed then
			if not self._isSlowed then
				self.ApproachSpeed = self.ApproachSpeed * 0.5
				self._isSlowed = true
				local renderer = self.Entity.SpriteRendererComponent
				if renderer ~= nil then renderer.Color = Color(0.6, 0.85, 1.0, 1.0) end
			end
			self._freezeSlowed = true
		end
		self:UpdateFreezeIndicator()
		log("AddFreezeStack: stack=" .. self.FreezeStack)
	end

	@ExecSpace("ServerOnly")
	method void ResetFreezeStack()
		if self.FreezeStack <= 0 then return end
		self.FreezeStack = 0
		if self._freezeSlowed then
			self._freezeSlowed = false
			-- ColdBeam 슬로우 타이머가 없으면 freeze slow 직접 해제
			if self._slowTimerId == 0 and self._isSlowed then
				self.ApproachSpeed = self.ApproachSpeed * 2.0
				self._isSlowed = false
				local renderer = self.Entity.SpriteRendererComponent
				if renderer ~= nil then renderer.Color = Color(1, 1, 1, 1) end
			end
			-- _slowTimerId != 0이면 타이머가 _freezeSlowed=false를 보고 자동 해제
		end
		self:UpdateFreezeIndicator()
	end

	@ExecSpace("ServerOnly")
	method void UpdateFreezeIndicator()
		local map = self.Entity.CurrentMap
		if map == nil then return end
		-- map(=CurrentMap)은 맵 루트라 로컬 Position이 아니라 WorldPosition을 써야 존 오프셋과 맞는다
		local pos = self.Entity.TransformComponent.WorldPosition
		local iPos = Vector3(pos.x + 0.45, pos.y - 0.40, pos.z - 0.05)
		if self.FreezeStack <= 0 then
			if isvalid(self._freezeIndicator) then
				self._freezeIndicator:Destroy()
				self._freezeIndicator = nil
			end
			return
		end
		if not isvalid(self._freezeIndicator) then
			self._freezeIndicator = _SpawnService:SpawnByModelId("stackindicator-model-id", "FreezeStack", iPos, map)
			if isvalid(self._freezeIndicator) then
				local t = self._freezeIndicator.TextRendererComponent
				if t ~= nil then
					t.FontColor = Color(0.4, 0.8, 1.0, 1.0)
					t.Text = tostring(self.FreezeStack)
				end
			end
		else
			self._freezeIndicator.TransformComponent.Position = iPos
			local t = self._freezeIndicator.TextRendererComponent
			if t ~= nil then t.Text = tostring(self.FreezeStack) end
		end
	end

	@ExecSpace("ServerOnly")
	method void AddComboStack(number lastHitDamage)
		if self._dead then return end
		if self.ComboStack >= 5 then return end
		self.ComboStack = self.ComboStack + 1
		self:UpdateComboIndicator()
		if self.ComboStack >= 5 then
			self:TriggerComboFinish(lastHitDamage)
		end
	end

	@ExecSpace("ServerOnly")
	method void ResetComboStack()
		if self.ComboStack <= 0 and not self:HasAnyComboOrb() then return end
		self.ComboStack = 0
		self:UpdateComboIndicator()
	end

	method boolean HasAnyComboOrb()
		return isvalid(self._comboOrb1) or isvalid(self._comboOrb2) or isvalid(self._comboOrb3)
			or isvalid(self._comboOrb4) or isvalid(self._comboOrb5)
	end

	method Entity GetComboOrb(integer idx)
		if idx == 1 then return self._comboOrb1
		elseif idx == 2 then return self._comboOrb2
		elseif idx == 3 then return self._comboOrb3
		elseif idx == 4 then return self._comboOrb4
		elseif idx == 5 then return self._comboOrb5
		end
		return nil
	end

	method void SetComboOrb(integer idx, Entity e)
		if idx == 1 then self._comboOrb1 = e
		elseif idx == 2 then self._comboOrb2 = e
		elseif idx == 3 then self._comboOrb3 = e
		elseif idx == 4 then self._comboOrb4 = e
		elseif idx == 5 then self._comboOrb5 = e
		end
	end

	method number GetComboOrbReveal(integer idx)
		if idx == 1 then return self._comboOrbReveal1
		elseif idx == 2 then return self._comboOrbReveal2
		elseif idx == 3 then return self._comboOrbReveal3
		elseif idx == 4 then return self._comboOrbReveal4
		elseif idx == 5 then return self._comboOrbReveal5
		end
		return 0
	end

	method void SetComboOrbReveal(integer idx, number v)
		if idx == 1 then self._comboOrbReveal1 = v
		elseif idx == 2 then self._comboOrbReveal2 = v
		elseif idx == 3 then self._comboOrbReveal3 = v
		elseif idx == 4 then self._comboOrbReveal4 = v
		elseif idx == 5 then self._comboOrbReveal5 = v
		end
	end

	@ExecSpace("ServerOnly")
	method void UpdateComboIndicator()
		for i = 1, 5 do
			local orb = self:GetComboOrb(i)
			if i <= self.ComboStack then
				if not isvalid(orb) then
					local newOrb = _SpawnService:SpawnByModelId("comboorbeffect", "ComboOrb" .. i, Vector3(self.ComboOrbRadius, 0.3, -0.1), self.Entity)
					if newOrb ~= nil then
						local renderer = newOrb.SpriteRendererComponent
						if renderer ~= nil then
							renderer.SpriteRUID = _CardManager.ComboOrbRUID
							renderer.StartFrameIndex = 0
							renderer.EndFrameIndex = 0
						end
						self:SetComboOrbReveal(i, 0)
						self:SetComboOrb(i, newOrb)
					end
				end
			else
				if isvalid(orb) then
					orb:Destroy()
					self:SetComboOrb(i, nil)
				end
			end
		end
	end

	method void UpdateComboOrbPositions(number delta)
		if self.ComboStack <= 0 then return end
		self._comboOrbAngle = self._comboOrbAngle + delta * self.ComboOrbRotateSpeed
		local scale = _CardManager:GetEffectScaleRatio(self) * self.ComboOrbScaleMultiplier
		local step = (2 * math.pi) / self.ComboStack
		for i = 1, self.ComboStack do
			local orb = self:GetComboOrb(i)
			if isvalid(orb) then
				local a = self._comboOrbAngle + (i - 1) * step
				local x = math.cos(a) * self.ComboOrbRadius
				local y = 0.3 - math.sin(a) * self.ComboOrbRadius
				orb.TransformComponent.Position = Vector3(x, y, -0.1)
				orb.TransformComponent.Scale = Vector3(scale, scale, 1.0)
		
				local reveal = self:GetComboOrbReveal(i) + delta
				self:SetComboOrbReveal(i, reveal)
				local frame = math.min(i, math.floor(reveal / self.ComboOrbFrameStepDuration))
				local renderer = orb.SpriteRendererComponent
				if renderer ~= nil then
					renderer.StartFrameIndex = frame
					renderer.EndFrameIndex = frame
				end
			end
		end
	end

	method void ClearAllComboOrbs()
		for i = 1, 5 do
			local orb = self:GetComboOrb(i)
			if isvalid(orb) then
				orb:Destroy()
				self:SetComboOrb(i, nil)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void TriggerComboFinish(number lastHitDamage)
		_CardManager:PlayComboFinishBurst(self, lastHitDamage)
		self:ResetComboStack()
	end

	@ExecSpace("ServerOnly")
	method void ApplyDot(number damagePerTick, integer ticks, number tickInterval)
		-- 도트 데미지 적용. 중복 시 이전 도트를 취소하고 새 도트로 덮어씀
		if self._dotTimerId ~= 0 then
			_TimerService:ClearTimer(self._dotTimerId)
			self._dotTimerId = 0
		end
		self._dotDamage = damagePerTick
		self._dotTicksLeft = ticks
		self._dotTimerId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self) or not isvalid(self.Entity) or self._dead then
				if self._dotTimerId ~= 0 then _TimerService:ClearTimer(self._dotTimerId) end
				self._dotTimerId = 0
				return
			end
			self:TakeDamage(self._dotDamage)
			self._dotTicksLeft = self._dotTicksLeft - 1
			if self._dotTicksLeft <= 0 then
				_TimerService:ClearTimer(self._dotTimerId)
				self._dotTimerId = 0
			end
		end, tickInterval)
	end

	@ExecSpace("ServerOnly")
	method void ApplyKnockback(number targetScale)
		if self._dead or self._isFlying or self._isBonusBoss then return end
		if targetScale >= self._currentScale then return end
		self._reachedPlayer = false
		self._isPushingBack = true
		-- 먼지 이펙트 — "이어하기" PushBack()과 동일한 패턴(WorldPosition 사용, 존 오프셋 대응)
		local map = self.Entity.CurrentMap
		local worldPos = self.Entity.TransformComponent.WorldPosition
		if map ~= nil then
			local dustPos = Vector3(worldPos.x, worldPos.y - 0.35, worldPos.z + 0.1)
			local dust = _SpawnService:SpawnByModelId("skilleffect", "Dust", dustPos, map)
			if dust ~= nil then
				local r = dust.SpriteRendererComponent
				if r ~= nil then r.SpriteRUID = "98262e9a441d41abb19a6d519f74aec7" end
				dust:Destroy(0.5)
			end
		end
		local fromScale = self._currentScale
		_TweenLogic:PlayTween(0.0, 1.0, 0.35, EaseType.QuadEaseOut, function(t)
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local s = fromScale + (targetScale - fromScale) * t
			self._currentScale = s
			self.Entity.TransformComponent.Scale = Vector3(s * self._scaleMultiplier, s * self._scaleMultiplier, 1.0)
			self:UpdateDepth()
		end)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self._isPushingBack = false
		end, 0.35)
	end

	@ExecSpace("ServerOnly")
	method void ApplyLateralShove(number edgeX, number duration)
		-- 이중 방어(2026-08-26, 유저 리포트 "보너스보스가 넉백맞고 사라짐") — CardManager.ClampKnockbackDestX가
		-- 보너스보스는 이제 제외하지만, 혹시 다른 경로로 clamp 없이 이 메서드가 직접 호출되더라도 보너스보스는
		-- ApplyKnockback과 동일하게 넉백 자체를 무시한다.
		if self._dead or self._isBonusBoss then return end
		self._isPushingBack = true
		local fromX = self.Entity.TransformComponent.Position.x
		_TweenLogic:PlayTween(0.0, 1.0, duration, EaseType.QuadEaseOut, function(t)
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local p = self.Entity.TransformComponent.Position
			local x = fromX + (edgeX - fromX) * t
			self.Entity.TransformComponent.Position = Vector3(x, p.y, p.z)
		end)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self._isPushingBack = false
		end, duration)
	end

	@ExecSpace("ServerOnly")
	method void ApplyLevitate(number duration)
		if self._dead or self._isFlying then return end
		local liftHeight = 0.35
		local fallDuration = math.min(0.25, duration * 0.3)
		
		if not self._isLevitating then
			self._isLevitating = true
			self._levitateBaseY = self.Entity.TransformComponent.Position.y
			local baseY = self._levitateBaseY
			_TweenLogic:PlayTween(0.0, 1.0, fallDuration, EaseType.QuadEaseOut, function(t)
				if not isvalid(self) or not isvalid(self.Entity) then return end
				local pos = self.Entity.TransformComponent.Position
				self.Entity.TransformComponent.Position = Vector3(pos.x, baseY + liftHeight * t, pos.z)
			end)
		end
		
		if self._levitateTimerId ~= 0 then
			_TimerService:ClearTimer(self._levitateTimerId)
		end
		local baseY = self._levitateBaseY
		self._levitateTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(self) then self:LandFromLevitate(fallDuration) end
		end, math.max(0, duration - fallDuration))
	end

	@ExecSpace("ServerOnly")
	method void LandFromLevitate(number duration)
		if not self._isLevitating then return end
		self._isLevitating = false
		if self._levitateTimerId ~= 0 then
			_TimerService:ClearTimer(self._levitateTimerId)
			self._levitateTimerId = 0
		end
		if not isvalid(self) or not isvalid(self.Entity) then return end
		local baseY = self._levitateBaseY
		local liftHeight = 0.35
		_TweenLogic:PlayTween(1.0, 0.0, duration, EaseType.QuadEaseIn, function(t)
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local pos = self.Entity.TransformComponent.Position
			self.Entity.TransformComponent.Position = Vector3(pos.x, baseY + liftHeight * t, pos.z)
		end)
	end

	@ExecSpace("ServerOnly")
	method void PushBack()
		if self._dead then return end
		-- 상태이상 타이머 정리
		if self._slowTimerId ~= 0 then _TimerService:ClearTimer(self._slowTimerId) ; self._slowTimerId = 0 end
		if self._stunTimerId ~= 0 then _TimerService:ClearTimer(self._stunTimerId) ; self._stunTimerId = 0 end
		if self._dotTimerId ~= 0 then _TimerService:ClearTimer(self._dotTimerId) ; self._dotTimerId = 0 end
		self._isStunned = false
		self:DestroyStunStars()
		self._reachedPlayer = false
		-- 아쿠아 트랩으로 공중에 뜬 채였다면(예: "이어하기"로 밀려날 때) 여기서 강제로 착지시킨다 —
		-- 안 그러면 기존 착지 타이머가 뒤에서 따로 돌다가 꼬여서 영영 안 내려오는 경우가 생긴다.
		if self._isLevitating then self:LandFromLevitate(0.2) end
		
		-- 비행형(박쥐)은 접근/스케일 개념이 없으므로 되밀기 트윈 없이 배회만 잠깐 멈췄다 재개한다
		if self._isFlying then
			self._isPushingBack = true
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				self._isPushingBack = false
			end, 0.75)
			return
		end
		
		self._isPushingBack = true
		-- 먼지 이펙트 스폰 — 몬스터 바닥(y 최하단)에 붙도록 y 오프셋 적용. Entity.CurrentMap은 맵
		-- 루트를 가리키므로(Zone12 같은 자식 컨테이너가 아니라) 로컬 Position이 아니라 WorldPosition을
		-- 써야 한다 — 안 그러면 존 오프셋만큼 어긋난 곳에서 먼지가 뜬다(실측 확인 — "이어하기" 시 재현).
		local map = self.Entity.CurrentMap
		local pos = self.Entity.TransformComponent.WorldPosition
		if map ~= nil then
			local dustPos = Vector3(pos.x, pos.y - 0.35, pos.z + 0.1)
			local dust = _SpawnService:SpawnByModelId("skilleffect", "Dust", dustPos, map)
			if dust ~= nil then
				local r = dust.SpriteRendererComponent
				if r ~= nil then r.SpriteRUID = "98262e9a441d41abb19a6d519f74aec7" end
				dust:Destroy(0.5)
			end
		end
		-- 서버에서 직접 트윈: 현재 스케일 → 0.85 (TransformComponent.Scale이 클라에 자동 동기화)
		local fromScale = self._currentScale
		local toScale = 0.85
		local mult = self._scaleMultiplier
		_TweenLogic:PlayTween(0.0, 1.0, 0.7, EaseType.QuadEaseOut, function(t)
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local s = fromScale + (toScale - fromScale) * t
			self._currentScale = s
			self.Entity.TransformComponent.Scale = Vector3(s * mult, s * mult, 1.0)
			self:UpdateDepth()
		end)
		-- 트윈 완료 후 OnUpdate 재개 + 속도 복구
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self._currentScale = 0.85
			self.ApproachSpeed = _GameManager:GetWaveApproachSpeed(_GameManager.Wave)
			self._isPushingBack = false
		end, 0.75)
	end

	@ExecSpace("ServerOnly")
	method table GetLootDropFallParams()
		local fallHeight = 0
		local groundWorldY = self.Entity.TransformComponent.WorldPosition.y
		if self._isFlying or self._isLevitating then
			local worldPos = self.Entity.TransformComponent.WorldPosition
			local map = self.Entity.CurrentMap
			if map ~= nil then
				---@type FootholdComponent
				local foothold = map:GetComponent("FootholdComponent")
				if foothold ~= nil then
					local hits = foothold:RaycastAll(Vector2(worldPos.x, worldPos.y), Vector2(0, -1), 50)
					local groundY = nil
					local bestDist = nil
					for i = 1, #hits do
						local h = hits[i]
						if not _MonsterSpawner:IsExcludedZone15Foothold(h.OwnerId) then
							local y = h:GetYByX(worldPos.x)
							local dist = worldPos.y - y
							if bestDist == nil or dist < bestDist then
								bestDist = dist
								groundY = y
							end
						end
					end
					if groundY ~= nil and worldPos.y > groundY then
						fallHeight = (worldPos.y - groundY) * 100
						groundWorldY = groundY
					end
				end
			end
		end
		local dropScale = _CardManager:GetEffectScaleRatio(self)
		return { fallHeight = fallHeight, groundWorldY = groundWorldY, dropScale = dropScale }
	end

	@ExecSpace("ServerOnly")
	method void Die()
		if self._dead then return end
		-- 거대 네펜데스 1페이즈는 진짜 죽지 않는다 — 죽는 연출만 재생한 뒤 2페이즈로 부활한다.
		-- 2페이즈(_giantNepenthesRevived=true)부터는 아래 일반 사망 처리로 그대로 흘러간다.
		if self._isGiantNepenthes and not self._giantNepenthesRevived then
			self:DieAndRevivePhase1()
			return
		end
		-- 예티/다크예티/예티와페페/다크예티와페페/주니어예티(에피소드3 map2) 범용 2페이즈 — 위 거대
		-- 네펜데스와 동일한 분기 구조. _phase2Chance(기본 1.0=항상)를 여기서 딱 1번만 굴린다 — 주니어
		-- 예티는 0.5라 절반은 그냥 평범하게 죽고(아래 일반 사망 처리로 흘러감) 나머지 절반만 die1 재생
		-- 후 성체 예티로 자란다.
		-- (2026-08-25 조사 노트: 유저 리포트 "가끔 페이즈 안바뀌고 바로 죽는거같은데"에 대해 진단 로그로
		-- 존106~108 실전 전투 28회 phase1 사망을 전수 추적 — 28/28 전부 정상적으로 revived as phase2까지
		-- 완주 확인, 서버 상태머신 로직 자체는 문제없음. 재현되면 클라이언트 시각 레이스 쪽을 의심할 것.)
		if self._hasPhase2 and not self._phase2Revived and _UtilLogic:RandomDouble() < self._phase2Chance then
			self:DieAndRevivePhase1Generic()
			return
		end
		self._dead = true
		-- 죽는 연출(die 스프라이트)과 깊이 오버레이(서 있는 포즈를 검게 덧씌운 것)가 서로 어긋나 보이지
		-- 않도록, 죽는 순간 오버레이부터 즉시 꺼버린다
		self:HideDepthOverlay()
		-- 상태이상 타이머 즉시 정리 (죽는 연출 중 색상 간섭 방지)
		if self._slowTimerId ~= 0 then _TimerService:ClearTimer(self._slowTimerId) ; self._slowTimerId = 0 end
		if self._stunTimerId ~= 0 then _TimerService:ClearTimer(self._stunTimerId) ; self._stunTimerId = 0 end
		if self._dotTimerId ~= 0 then _TimerService:ClearTimer(self._dotTimerId) ; self._dotTimerId = 0 end
		if self._hardFreezeTimerId ~= 0 then _TimerService:ClearTimer(self._hardFreezeTimerId) ; self._hardFreezeTimerId = 0 end
		-- 얼어있거나(완전빙결)/스턴 걸린 도중 죽으면 PlayRate=0이 그대로 남아 죽는 애니메이션(본체+그림자)까지
		-- 안 움직이거나, 이 엔티티가 나중에 스폰 재사용될 때 새 몬스터가 멈춘 채로 시작할 수 있다 — 플래그를
		-- 먼저 끈 뒤 UpdateAnimationFreeze로 다시 계산해 복구한다.
		local wasFrozenOrStunned = self._isHardFrozen or self._isStunned
		self._isHardFrozen = false
		self.FreezeStack = 0
		self._freezeSlowed = false
		self._isStunned = false
		if wasFrozenOrStunned then self:UpdateAnimationFreeze() end
		self:DestroyStunStars()
		-- 죽는 순간 공중에 떠 있던 착지 타이머가 남아있으면 정리한다(잔여 트윈이 나중에 잘못 발동하는 일 방지)
		-- — 아래에서 드랍 낙하 연출 여부를 판단해야 하므로 리셋하기 전에 값을 따로 저장해둔다.
		local wasLevitating = self._isLevitating
		if self._levitateTimerId ~= 0 then _TimerService:ClearTimer(self._levitateTimerId) ; self._levitateTimerId = 0 end
		self._isLevitating = false
		if isvalid(self._freezeIndicator) then
			self._freezeIndicator:Destroy()
			self._freezeIndicator = nil
		end
		self.ComboStack = 0
		self:ClearAllComboOrbs()
		log("Monster died")
		-- 보스는 OnBossDefeated()가 처치 보상(Exp/Gold)까지 전부 처리한다. OnMonsterKilled()도
		-- 같이 부르면 NotifyExpChanged가 한 프레임 안에 두 번 겹쳐 호출되어, 레벨업 트윈이 강제로
		-- 0%부터 시작하기 직전에 다른 값으로 이미 차오르고 있던 바가 순간적으로 줄어드는 것처럼
		-- 보이는 버그가 있었다. OnBossDefeated() 호출 자체는 스킬조각/파워엘릭서 드롭 위치 계산
		-- (fallHeight/groundWorldY/dropScale)이 끝난 뒤로 아래로 옮겼다.
		if not self._isBoss then
			if self._isBadRudolph then
				-- "불량 루돌프" — 유저 지정: 골드는 정상 지급하되 EXP는 주지 않는다(OnMonsterKilled는
				-- 골드+EXP를 한 번에 처리하므로 골드만 떼어낸 GetGoldPerKill을 직접 호출한다)
				_GameManager:AddGold(_GameManager:GetGoldPerKill())
			else
				_GameManager:OnMonsterKilled()
			end
		end
		-- 비행형(박쥐 등)은 사망 위치가 공중이므로, 드랍 연출이 실제 발판(몬스터가 걸어다니는 바닥) 높이까지
		-- 먼저 빙그르르 돌며 떨어지도록 그 높이차(UI px)를 같이 넘긴다. FlyingWanderMinY는 배회 궤적의
		-- 하한일 뿐 실제 지면이 아니므로(맵마다 발판 높이가 다름), 사망 지점에서 실제로 아래로 레이캐스트해
		-- FootholdComponent 표면 Y를 구한다 — 걷는 몬스터는 이미 바닥에 있으니 0.
		-- 발판은 "그 위에 서 있을 수 있는 표면"이지, 타일 몸통 자체가 아니다 — 사망 지점이 어떤 타일의
		-- 발판 인식선보다 낮으면(타일 몸통을 관통해서 죽은 경우 포함) 그 타일 위에 서 있는 게 아니므로,
		-- 거리가 가깝다는 이유로 그 타일에 착지시키면 안 된다. 아래 방향으로만 쏴서, 사망 지점과 같거나
		-- 더 낮은 위치의 발판만 착지 후보로 삼는다 — 타일을 관통해서 죽었다면 그보다 더 아래(멀더라도)
		-- 있는 다음 발판까지 정상적으로 떨어지는 게 맞다.
		-- 발판을 못 찾으면(hit==nil) groundY를 함부로 0으로 가정하지 않고 낙하 연출 자체를 건너뛴다
		-- (존 오프셋이 있는 맵에서 잘못된 Y로 잘못 계산하면 아이템이 엉뚱한 자리에 멈춰 보이는 문제가 있었다).
		-- 존15는 중앙 기둥 대신 유저가 깔아둔 CustomFootholdComponent 오브젝트(foothold-848_1~3)가
		-- 있는데, 이건 몬스터 스폰 위치로도 이미 제외 처리된(MonsterSpawner.IsExcludedZone15Foothold)
		-- "장식용" 발판이라 눈에 보이는 타일이 없다 — Raycast(첫 번째 하나만) 대신 RaycastAll로 사망
		-- 지점 아래의 모든 발판을 훑어서, 이 제외 대상이 아닌 것 중 가장 가까운 것을 착지 지점으로 쓴다.
		-- 이 값은 포션/잡템/야누스의 검 교환권 드롭 전부(엘리트 처치의 카드 드롭 화면 연출은 제외)가
		-- 공유하므로, 아래 elite/potion 분기보다 먼저 계산해둔다.
		-- fallHeight는 낙하 연출의 재생 시간/회전량만 결정하는 대략치(서버는 UI 좌표계 변환 API를
		-- 쓸 수 없어 world 델타 * 100으로 근사)이고, 실제로 어디까지 떨어뜨릴지는 groundWorldY(월드
		-- Y좌표 그대로)를 따로 넘겨서 클라이언트가 _UILogic으로 정확히 변환하게 한다 — world 1유닛이
		-- 화면 UI px로 항상 100이 아니라(실측 시 해상도에 따라 ~170px) 예전처럼 fallHeight를 그대로
		-- UI px 낙하거리로 썼더니 실제 발판보다 한참 못 미치는 높이에서 낙하 연출이 멈춰, 존15/16
		-- 비행형 몬스터의 드롭 아이템이 바닥에 닿지 못하고 공중에 떠 있는 것처럼 보이는 버그가 있었다.
		local fallHeight = 0
		local groundWorldY = self.Entity.TransformComponent.WorldPosition.y
		-- 아쿠아 트랩/서지 등으로 속박되어 공중에 떠 있는 도중에 죽으면(_isLevitating, 위에서 이미
		-- false로 리셋했으므로 여기서는 별도의 로컬 플래그로 판단해야 함) 사망 위치 자체가 공중이라,
		-- 비행형과 똑같이 드랍 연출이 바닥까지 떨어지도록 같은 낙하 계산을 재사용한다 — 안 그러면
		-- 드랍 아이템이 방금까지 떠 있던 공중 위치에 그대로 멈춰 보인다.
		if self._isFlying or wasLevitating then
			local worldPos = self.Entity.TransformComponent.WorldPosition
			local map = self.Entity.CurrentMap
			if map ~= nil then
				---@type FootholdComponent
				local foothold = map:GetComponent("FootholdComponent")
				if foothold ~= nil then
					local hits = foothold:RaycastAll(Vector2(worldPos.x, worldPos.y), Vector2(0, -1), 50)
					local groundY = nil
					local bestDist = nil
					for i = 1, #hits do
						local h = hits[i]
						if not _MonsterSpawner:IsExcludedZone15Foothold(h.OwnerId) then
							local y = h:GetYByX(worldPos.x)
							local dist = worldPos.y - y
							if bestDist == nil or dist < bestDist then
								bestDist = dist
								groundY = y
							end
						end
					end
					if groundY ~= nil and worldPos.y > groundY then
						fallHeight = (worldPos.y - groundY) * 100
						groundWorldY = groundY
					end
				end
			end
		end
		-- OnEliteKilled/TryDropHealPotion 둘 다 월드 좌표를 기대한다(카드 드롭 화면 연출·포션 드롭 연출) —
		-- 로컬 Position을 넘기면 Zone12처럼 오프셋을 가진 존에서 드롭 연출이 화면 밖으로 어긋난다(실측 확인).
		-- 드롭 연출 크기도 스킬 이펙트와 동일하게 죽은 몬스터 자신의 거리(깊이) 비율을 그대로 따라간다
		-- (유저 요청 — 멀리서 죽은 몬스터의 드롭은 작게 보이게).
		local dropScale = _CardManager:GetEffectScaleRatio(self)
		-- 무기 드롭(유저 지정: 태초의 마을 전 구간, 몬스터 종류/보스·엘리트 무관하게 처치마다 판정)
		_GameManager:TryDropWeaponItem(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
		-- 무기 스킬(레어 등급 100마리 처치 해금) 카운트 — 보스/엘리트 포함 모든 처치마다 누적
		_CardManager:OnWeaponSkillKill()
		-- 장비 등급 스킬의 처치 카운터(활 10마리 추가공격 / 양손검·슈트 회복 / 자마다르·망토 버프 /
		-- 투구 쿨감 해금) — 무기 스킬과 동일하게 보스/엘리트 포함 모든 처치마다 누적
		_GearEffectLogic:OnMonsterKilled()
		if self._isElite then
			_CardManager:OnEliteKilled(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
			_MonsterSpawner:OnEliteKilled()
		elseif self._isCorruptedCentaur then
			-- 타락한 켄타우로스(ep2_map4 MapObject_205) — 유저 지정: "엘리트처럼" 확정 드롭(빨간 포션 +
			-- 슬롯 스킬 1개). 검은 켄타우로스(_isBlackCentaur)는 이 분기를 안 타므로 힐포션 등 일반
			-- 확률성 드롭이 그대로 나간다(유저가 "잡템"만 없애달라고 했지 이쪽은 언급 안 함).
			_CardManager:OnCorruptedCentaurKilled(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
		elseif not self._isCauldron then
			-- 카페테리아 가마솥은 자기만의 확정 포션 표(아래 elseif 체인)가 있으므로 일반 존의 확률성
			-- 힐포션/빙결아이템/허수아비/바운스 드롭과 중복되지 않게 제외한다.
			_GameManager:TryDropHealPotion(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
			_GameManager:TryDropFreezeItem(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
			_GameManager:TryDropScarecrowItem(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
			_GameManager:TryDropBounceKnockbackItem(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
		end
		-- 존16~17(그림자 존) 전용: 야누스의 검 교환권 5% 확률 드롭 (보스/일반/엘리트 무관하게 처치마다 판정)
		if self._isErdas then
			-- 존 잡템 풀 대신 Map23ErdasEasterEggLogic이 정수 드롭(100% 확정)+킬카운트를 전담한다
			_Map23ErdasEasterEggLogic:OnErdasKilled(self._erdasOrdinal, self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
		elseif self._isYellowMiniBean then
			-- 일반 존 잡템 대신 스킬 카드 1개(슬롯 강화)를 지급한다 — _isYellowMiniBean 주석 참고
			_CardManager:OnYellowMiniBeanCaught(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
		elseif self._isTreasureChest then
			-- map24는 웨이브/존 잡템 개념이 없다 — 처치 시점에 그 자리에 귀환 포탈을 생성한다
			_Map24TreasureChestLogic:OnChestKilled(self.Entity.TransformComponent.WorldPosition)
		elseif self._isTiredKnight then
			-- 지쳐버린 기사(ep2_map3 존마다 1마리) — 유저 지정: "처치시 100% 아이템이 나오고" — 존 잡템
			-- 확률 대신 GrantLootItemDrop(무조건 지급)으로 tired_knight_seal을 확정 지급한다.
			_GameManager:GrantLootItemDrop(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, "tired_knight_seal", dropScale)
		elseif self._isBlackCentaur or self._isCorruptedCentaur then
			-- 검은/타락한 켄타우로스(ep2_map4 MapObject_205 이벤트) — 유저 지정: "잡템은 나올필요없고" —
			-- 존 잡템 지급을 완전히 건너뛴다.
		elseif self._isBadRudolph then
			-- "불량 루돌프"(ep3_map2 존10 길잃은 루돌프 이스터에그) — 유저 지정: 잡템/장비/스킬 드롭 전부
			-- 없음(골드는 위에서 이미 정상 지급됨). 존 잡템 지급을 완전히 건너뛴다.
		elseif self._isCauldron then
			-- 카페테리아 가마솥 — 유저 지정 확률표: 엘릭서(potionType=3) 5% / 하얀포션(2) 35% / 빨간포션(1) 60%
			local roll = _UtilLogic:RandomDouble()
			local potionType = 1
			if roll < 0.05 then
				potionType = 3
			elseif roll < 0.40 then
				potionType = 2
			end
			_GameManager:ApplyPotionDrop(potionType, self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
		elseif self._spawnZoneIndex == 16 or self._spawnZoneIndex == 17 then
			_GameManager:TryDropShadowVoucher(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
		else
			-- 그 외 전 구간: 확률로 "이 몬스터가 실제로 잡으면 주는" 잡템 1개를 가방에 지급 (보스/일반/엘리트 무관).
			-- 버그 수정(2026-08-26, 유저 리포트 "다크 예티 잡으면 뿔나오잖아 근데 그게 예티 뿔로나와 다크
			-- 예티 잡템이 아니라") — 2페이즈로 이미 진화한 상태로 죽었으면(예티→다크예티 등, _phase2Revived)
			-- _speciesIdx/스폰존이 스폰 시점(진화 전) 값 그대로라 그냥 쓰면 진화 전 잡템이 나온다. 진화
			-- 후 정체성 기준 잡템(GetMonsterLootItemIdPhase2)을 대신 쓰고, 혹시 매핑이 없으면(방어적)
			-- 진화 전 잡템으로 폴백한다.
			local lootItemId
			if self._phase2Revived then
				lootItemId = _GameManager:GetMonsterLootItemIdPhase2(self._spawnZoneIndex, self._speciesIdx)
				if lootItemId == "" then
					lootItemId = _GameManager:GetMonsterLootItemId(self._spawnZoneIndex, self._speciesIdx)
				end
			else
				lootItemId = _GameManager:GetMonsterLootItemId(self._spawnZoneIndex, self._speciesIdx)
			end
			_GameManager:TryDropLootItem(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, lootItemId, dropScale)
		end
		if self._isBoss then
			_GameManager:OnBossDefeated(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
		end
		if self._isCauldron then
			-- 유저 지정: "포션을 뱉으면 알파가 빠지면서 자연스럽게 사라짐" — die1 재생과 동시에 알파를
			-- 0으로 페이드, 파괴 타이밍(_dieDuration+0.2)에 정확히 맞춰 끝나게 한다.
			local renderer = self.Entity.SpriteRendererComponent
			if renderer ~= nil then
				_TweenLogic:PlayTween(1.0, 0.0, self._dieDuration + 0.2, EaseType.QuadEaseIn, function(alpha)
					if isvalid(self) and isvalid(self.Entity) and isvalid(renderer) then
						local c = renderer.Color
						renderer.Color = Color(c.r, c.g, c.b, alpha)
					end
				end)
			end
		end
		self:PlayDeathAnimation(self._dieRUID, self._dieDuration)
		self.Entity:Destroy(self._dieDuration + 0.2)
	end

	@ExecSpace("ServerOnly")
	method void DieAndRevivePhase1()
		log("GiantNepenthes: phase1 died, reviving as phase2")
		-- _dead=true인 동안 OnUpdate 전체가 멈춘다(공격 타이머 포함) — 변신 연출 도중엔 공격이
		-- 나갈 수 없다(유저 요청: "변신될때는 그때는 공격 못하게").
		self._dead = true
		self:HideDepthOverlay()
		-- PlayDeathAnimation(일반 사망용)은 재생 후 알파를 0으로 낮춰 사라지게 만드는데, 1페이즈는
		-- 실제로 죽는 게 아니라 2페이즈로 바로 이어져야 한다(유저 지적: "사라졌다가 다시 켜지면 안됨,
		-- 자연스럽게 연결되어야함") — 그래서 알파 페이드가 없는 전용 연출을 재생하고, die1이 끝나는
		-- 정확한 시점에 곧바로 2페이즈 외형으로 덮어써서(ReviveAsPhase2) 끊기는 구간이 없게 한다.
		self:PlayPhase1TransformAnimation(self._dieRUID, self._dieSoundRUID)
		_TimerService:SetTimerOnce(function()
			if isvalid(self) and isvalid(self.Entity) then self:ReviveAsPhase2() end
		end, self._dieDuration)
	end

	@ExecSpace("Multicast")
	method void PlayPhase1TransformAnimation(string dieRUID, string dieSoundRUID)
		if self:IsServer() then return end
		if dieSoundRUID ~= "" then _SoundOptionLogic:PlaySfx(dieSoundRUID, 1.0) end
		local renderer = self.Entity.SpriteRendererComponent
		if renderer == nil then return end
		renderer.Color = Color(1, 1, 1, 1)
		if dieRUID ~= "" then renderer.SpriteRUID = dieRUID end
	end

	@ExecSpace("ServerOnly")
	method void ReviveAsPhase2()
		log("GiantNepenthes: revived as phase2 (ranged attacker)")
		self._giantNepenthesRevived = true
		self._dead = false
		self.CurrentHp = self.MaxHp
		self._standRUID = _GameManager.GiantNepenthesStandRUID
		self._hitRUID = _GameManager.GiantNepenthesHitRUID
		self._dieRUID = _GameManager.GiantNepenthesDieRUID
		self._dieDuration = _GameManager.GiantNepenthesDieDuration
		self._hitSoundRUID = _GameManager.GiantNepenthesHitSoundRUID
		self._dieSoundRUID = _GameManager.GiantNepenthesDieSoundRUID
		self._attackRUID = _GameManager.GiantNepenthesAttackRUID
		self._attackDuration = _GameManager.GiantNepenthesAttackDuration
		self._attackSoundRUID = _GameManager.GiantNepenthesAttackSoundRUID
		self._hitEffectRUID = _GameManager.GiantNepenthesHitEffectRUID
		self._hitEffectDuration = _GameManager.GiantNepenthesHitEffectDuration
		self._customAttackInterval = self._attackDuration + 0.7
		self._neverAttacks = false
		self._attackTimer = self._customAttackInterval
		self.MonsterSprite = self._standRUID
		local renderer = self.Entity.SpriteRendererComponent
		if renderer ~= nil then
			renderer.SpriteRUID = self._standRUID
			renderer.Color = Color(1, 1, 1, 1)
		end
		self:SyncDepthOverlaySprite()
		self:UpdateDepth()
	end

	@ExecSpace("ServerOnly")
	method void DieAndRevivePhase1Generic()
		log("Phase2Monster: phase1 died, reviving as phase2")
		self._dead = true
		self:HideDepthOverlay()
		self:PlayPhase1TransformAnimation(self._dieRUID, self._dieSoundRUID)
		_TimerService:SetTimerOnce(function()
			if isvalid(self) and isvalid(self.Entity) then self:ReviveAsPhase2Generic() end
		end, self._dieDuration)
	end

	@ExecSpace("ServerOnly")
	method void ReviveAsPhase2Generic()
		log("Phase2Monster: revived as phase2")
		self._phase2Revived = true
		self._dead = false
		self.CurrentHp = self.MaxHp
		local zone = self._spawnZoneIndex
		local idx = self._speciesIdx
		self._standRUID = _GameManager:GetMapPhase2StandRUID(zone, idx)
		self._moveRUID = _GameManager:GetMapPhase2MoveRUID(zone, idx)
		self._hitRUID = _GameManager:GetMapPhase2HitRUID(zone, idx)
		self._dieRUID = _GameManager:GetMapPhase2DieRUID(zone, idx)
		self._dieDuration = _GameManager:GetMapPhase2DieDuration(zone, idx)
		self._hitSoundRUID = _GameManager:GetMapPhase2HitSoundRUID(zone, idx)
		self._dieSoundRUID = _GameManager:GetMapPhase2DieSoundRUID(zone, idx)
		self._attackRUID = _GameManager:GetMapPhase2AttackRUID(zone, idx)
		self._attackDuration = _GameManager:GetMapPhase2AttackDuration(zone, idx)
		-- 버그 수정(2026-08-25, 유저 리포트 "걷는 연출이랑 이런건 다 빠진거 같은데") — InitializeStats의
		-- 스폰 시점 규칙(658번줄 부근, "접근 중엔 move, 이미 도달했거나 move가 없는 종은 stand")을 그대로
		-- 재현해야 하는데 기존엔 무조건 standRUID로 고정해서, 아직 플레이어에게 도달하기 전에 죽어 2페이즈로
		-- 부활한 개체는 부활 이후에도 걷는 연출 없이 제자리에 멈춰 서 있는 것처럼 보였다. _reachedPlayer는
		-- 1페이즈 상태를 그대로 들고 있으므로(부활 시 안 건드림) 이미 도달했던 개체는 정상적으로 stand로
		-- 시작해 다음 OnUpdate에서 바로 공격으로 이어진다.
		local phase2Sprite = self._standRUID
		if not self._reachedPlayer and not self._isFlying and self._moveRUID ~= "" then
			phase2Sprite = self._moveRUID
		end
		self.MonsterSprite = phase2Sprite
		local renderer = self.Entity.SpriteRendererComponent
		if renderer ~= nil then
			renderer.SpriteRUID = phase2Sprite
			renderer.Color = Color(1, 1, 1, 1)
		end
		self:SyncDepthOverlaySprite()
		self:UpdateDepth()
	end

	@ExecSpace("Multicast")
	method void PlayDeathAnimation(string dieRUID, number dieDuration)
		if self:IsServer() then return end
		if self._dieSoundRUID ~= "" then _SoundOptionLogic:PlaySfx(self._dieSoundRUID, 1.0) end
		local renderer = self.Entity.SpriteRendererComponent
		if renderer == nil then return end
		-- 상태이상 색상 제거 + die1 스프라이트로 전환해 메이플 원본 죽는 연출 재생
		renderer.Color = Color(1, 1, 1, 1)
		if dieRUID ~= "" then renderer.SpriteRUID = dieRUID end
		-- die1 정확한 1사이클 후 알파 0으로 설정해 루프 방지
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local r = self.Entity.SpriteRendererComponent
			if r ~= nil then r.Color = Color(1, 1, 1, 0) end
		end, dieDuration)
	end

	@ExecSpace("ServerOnly")
	method void Pause()
		if self._neverPauses then return end
		self._paused = true
	end

	@ExecSpace("ServerOnly")
	method void SetNeverPauses(boolean value)
		self._neverPauses = value
	end

	@ExecSpace("ServerOnly")
	method void SetSkipAttackLunge(boolean value)
		self._skipAttackLunge = value
	end

	@ExecSpace("ServerOnly")
	method void SetRangedHitEffect(string hitEffectRUID, number hitEffectDuration, number scaleMultiplier)
		self._hitEffectRUID = hitEffectRUID
		self._hitEffectDuration = hitEffectDuration
		self._hitEffectScaleMultiplier = scaleMultiplier
	end

	@ExecSpace("ServerOnly")
	method void SetSelfAttackEffect(string effectRUID, number effectDuration)
		self._selfAttackEffectRUID = effectRUID
		self._selfAttackEffectDuration = effectDuration
	end

	@ExecSpace("ServerOnly")
	method void SetCurrentScale(number scale)
		self._currentScale = scale
		self.Entity.TransformComponent.Scale = Vector3(scale * self._scaleMultiplier, scale * self._scaleMultiplier, 1.0)
	end

	@ExecSpace("ServerOnly")
	method void SetAttackDuration(number duration)
		self._attackDuration = duration
	end

	@ExecSpace("ServerOnly")
	method void SetSwarmMember(boolean value)
		self._isSwarmMember = value
	end

	@ExecSpace("ServerOnly")
	method void SetYellowMiniBean(boolean value)
		self._isYellowMiniBean = value
		self._neverAttacks = value
	end

	@ExecSpace("ServerOnly")
	method void SetSkillDropOnDeath(boolean value)
		self._isYellowMiniBean = value
	end

	@ExecSpace("ServerOnly")
	method void SetScaleMultiplier(number value)
		self._scaleMultiplier = value
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * value, self._currentScale * value, 1.0)
	end

	@ExecSpace("ServerOnly")
	method void SetAlienInvaderSounds(string attackSoundRUID, string hitSoundRUID, string dieSoundRUID)
		self._attackSoundRUID = attackSoundRUID
		self._hitSoundRUID = hitSoundRUID
		self._dieSoundRUID = dieSoundRUID
	end

	@ExecSpace("ServerOnly")
	method void Resume()
		self._paused = false
	end

	@ExecSpace("ServerOnly")
	method void OnReachPlayer()
		-- 무리 공격 중복 제거(_isSwarmMember 주석 참고) — 유저 지정: "공격모션은 전체가 다 해야함,
		-- 데미지만 1번" — 그래서 데미지 판정(미스 굴림 포함)만 이 플래그로 막고, 아래 연출 블록은
		-- 무리원 전체가 항상(선점 실패해도) 실행한다. TryClaimGroupAttack이 false를 반환해도 함수
		-- 전체를 리턴하지 않고 isGroupWinner만 꺼둔 채로 계속 진행한다.
		local isGroupWinner = true
		if self._isSwarmMember then
			isGroupWinner = _Ep2MiniBeanEasterEggLogic:TryClaimGroupAttack()
		end
		
		if isGroupWinner then
			-- 연막탄(쉐이드) 명중 하락 판정 — 보스/엘리트는 절반만 적용. 빗나가면 데미지만 스킵
			-- (연출은 아래에서 무리원 전체가 그대로 재생됨).
			local missed = false
			if self._accuracyDebuffPercent > 0 then
				local missChance = self._accuracyDebuffPercent
				if self._isBoss or self._isElite then missChance = missChance * 0.5 end
				if _UtilLogic:RandomDouble() < missChance then
					log("Monster attack missed (smoke debuff " .. math.floor(missChance * 100) .. "%)")
					missed = true
				end
			end
		
			-- 다크 사이트(카드184, 쉐이드 전용 패시브) — 영구 회피 확률. 연막탄 디버프와 별개 판정이고
			-- 보스/엘리트도 감쇄 없이 그대로 적용된다(플레이어 자신의 고정 스탯이라 몬스터 등급과 무관).
			local darkSightChance = _CardManager:GetDarkSightEvadeChance()
			if not missed and darkSightChance > 0 and _UtilLogic:RandomDouble() < darkSightChance then
				log("Monster attack missed (dark sight " .. math.floor(darkSightChance * 100) .. "%)")
				missed = true
			end
		
			if not missed then
				-- 플레이어 HP 감소 (엘리트는 공격력 15% 추가, 보스는 BossAttackMultiplier 배)
				log("Monster reached player!")
				local dmgMultiplier = 1.0
				if self._isBoss then
					dmgMultiplier = _GameManager.BossAttackMultiplier
				elseif self._isElite then
					dmgMultiplier = 1.15
				end
				-- 빠른 이동 안전장치 2단계(6연속) — ApplyRushPenalty가 세팅한 배율을 그대로 곱한다(기본 1.0이면 무영향)
				dmgMultiplier = dmgMultiplier * self._rushDamageMultiplier
				if self._isRangedSlash then
					-- 발톱자국 이펙트가 실제로 최대 스케일(화면에 닿는 시점)에 도달했을 때 대미지가 들어가도록
					-- PlaySlashEffect와 동일한 지연(공격모션 절반 + 이펙트 성장 시간)만큼 늦춘다(유저 요청 —
					-- "스케일이 0.6까지 도달했을때 대미지 들어오도록"). 다른 종(근접/비행/먹물)은 기존처럼 즉시.
					local hitDelay = self._attackDuration * 0.5 + self.SlashEffectDuration
					_TimerService:SetTimerOnce(function()
						if not isvalid(self) or self._dead then return end
						_GameManager:OnMonsterReached(dmgMultiplier, self._isSwarmMember or self._ignoresHitImmune)
					end, hitDelay)
				else
					-- 무리 공격(_isSwarmMember)은 TryClaimGroupAttack으로 이미 무리 내부에서 1회로 제한해뒀는데,
					-- 일반 스폰 몬스터가 방금 때려서 걸린 전역 무적 프레임(GameManager._hitImmune, 0.8초)에
					-- 또 막혀서 대미지가 안 들어가는 경우가 있었다(유저 지적: "다른 일반 스폰 몬스터가 연속으로
					-- 때리면 대미지 안들어가게 딜레이 걸었잖아? 쟤는 무시하라는말임"). 무리 공격은 이 무적
					-- 프레임을 무시하고 항상 들어가게 한다 — 다른 몬스터끼리의 무적 프레임 상호작용은 그대로 유지.
					-- _ignoresHitImmune(Tired Knight)도 동일한 경로로 무적 프레임을 무시한다.
					_GameManager:OnMonsterReached(dmgMultiplier, self._isSwarmMember or self._ignoresHitImmune)
				end
			end
		end
		
		-- 비행형(박쥐)은 배회 중 스케일이 고정돼 있어 "접근감"이 없고 공격이 잘 안 보인다는 피드백이 있어,
		-- 공격 순간 2배 크기까지 확 커졌다가 돌아오는 들이받기로 임팩트를 준다(boost=1.0, baseScale 1.0
		-- 기준 피크 2.0) — 이미 위아래로 날아다니는 중이라 별도 홉을 얹지 않는다.
		-- attack1 리소스가 있는 종(뉴그레이 화이트 등)은 확대(들이받기)와 동시에 스프라이트도 attack1로
		-- 바꿔서, 커지기만 하고 실제 공격 모션은 안 보이던 기존 비행형(attack1 없는 박쥐 등)과 구분한다.
		-- attack1 리소스가 있는 웨이브(비행형이 아닌 경우)는 스프라이트 교체, 원거리(먹물) 종은 화면 잉크
		-- 스플랫, 그 외(없는 웨이브)는 기본 들이받기로 대체 — 비행형을 제외한 전 종이 공격 순간 살짝 위로
		-- 뛰었다 착지하는 홉 모션을 공유한다(원래 존14/15 이블아이/커즈아이 전용이었던 걸 전 몬스터로 확장).
		if self._isFlying then
			if self._attackRUID ~= "" then
				self:PlayAttackAnimation(self._attackRUID, self.MonsterSprite, self._attackDuration)
			end
			if not self._skipAttackLunge then
				self:PlayLungeAnimation(1.0, 0)
			end
			-- 원거리 비행형(미니빈 등) 전용 — 근접 비행형(_hitEffectRUID=="")은 내부에서 그냥 아무것도
			-- 안 하고 리턴하므로 무조건 호출해도 안전하다.
			self:PlayRangedHitEffect()
			-- 푼코/쿠스코 전용 — 몬스터 자신의 위치에 뜨는 이펙트(_selfAttackEffectRUID=="")면 무조건
			-- 호출해도 안전하다.
			self:PlaySelfAttackEffect()
		elseif self._attackRUID ~= "" then
			self:PlayAttackAnimation(self._attackRUID, self.MonsterSprite, self._attackDuration)
			self:FlashHideDepthOverlay(self._attackDuration)
			-- 정책 변경(2026-08-27, 유저 지정: "앞으로 어택모션있는애들은 공격할때 점프하는거 있잖아
			-- 그거 빼 몬스터만들때 그 모션 없는애들만 점프하는 걸로 만들어(기존 달팽이처럼)") —
			-- attack1(전용 공격 스프라이트)이 있는 종은 그 포즈 교체만으로 공격을 표현하고, 제자리 홉은
			-- 더 이상 같이 재생하지 않는다. 홉(PlayAttackHop)은 attack1이 아예 없는 종의 대체 연출
			-- (else 분기, PlayLungeAnimation과 짝)로만 남긴다 — "기존 달팽이처럼".
			-- 원거리(칼자국) 종(자이언트 쉐도우)은 자기 자신의 attack1 스프라이트 교체 위에 발톱자국
			-- 이펙트를 추가로 띄운다 — 원거리(먹물)와 달리 대체 연출이 아니라 "얹는" 방식이라 elseif가
			-- 아니라 이 분기 안에 같이 넣는다.
			if self._isRangedSlash then
				self:PlaySlashEffect()
			end
			-- 스노우맨(원거리) 전용 — 유저 요청: 실제로 몬스터→플레이어로 날아가는 눈덩이 투사체.
			-- _projectileRUID가 빈 문자열인 다른 원거리 종은 내부에서 그냥 아무것도 안 함.
			if self._isRangedInk then
				self:PlayRangedProjectile()
			end
			-- 원거리(가시/먹물) 종(네펜데스/다크네펜데스/거대 네펜데스 2페이즈) 전용 히트 이펙트 — 유저
			-- 요청: 문어(먹물)와 같은 방식으로, 공격이 플레이어에게 닿는 위치에 종별 전용 이펙트를 띄운다.
			-- 빈 문자열이면 내부에서 그냥 아무것도 안 함.
			self:PlayRangedHitEffect()
		elseif self._isRangedInk then
			self:PlayInkAttack()
			self:PlayAttackHop()
		else
			self:PlayLungeAnimation(0.25, self.AttackHopHeight)
		end
	end

	@ExecSpace("ServerOnly")
	method void PlayAttackHop()
		if self._dead then return end
		local baseY = self.Entity.TransformComponent.Position.y
		_TweenLogic:PlayTween(0.0, 1.0, 0.18, EaseType.QuadEaseOut, function(t)
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local pos = self.Entity.TransformComponent.Position
			self.Entity.TransformComponent.Position = Vector3(pos.x, baseY + self.AttackHopHeight * math.sin(t * math.pi), pos.z)
		end)
	end

	@ExecSpace("ServerOnly")
	method void SpawnAfterimage()
		local map = self.Entity.CurrentMap
		if map == nil then return end
		local pos = self.Entity.TransformComponent.WorldPosition
		local scale = self.Entity.TransformComponent.Scale
		local ghost = _SpawnService:SpawnByModelId("afterimage", "Afterimage", pos, map)
		if ghost == nil then return end
		local renderer = ghost.SpriteRendererComponent
		if renderer ~= nil then
			renderer.SpriteRUID = self.MonsterSprite
			renderer.Color = Color(0.6, 0.75, 1.0, self.AfterimageAlpha)
		end
		ghost.TransformComponent.Scale = scale
		_TweenLogic:PlayTween(self.AfterimageAlpha, 0.0, self.AfterimageFadeDuration, EaseType.QuadEaseIn, function(alpha)
			if isvalid(ghost) and renderer ~= nil then renderer.Color = Color(0.6, 0.75, 1.0, alpha) end
		end)
		ghost:Destroy(self.AfterimageFadeDuration + 0.05)
	end

	@ExecSpace("ServerOnly")
	method void PlayInkAttack()
		-- PlayInkSplat은 파라미터 이름부터 worldPos — WorldToScreenPosition으로 화면 좌표 환산에 쓰인다.
		-- 로컬 Position을 넘기면 Zone12에서는 존 오프셋만큼 어긋난 화면 밖 위치로 환산돼 연출이 안 보인다.
		local pos = self.Entity.TransformComponent.WorldPosition
		_GameManager:PlayInkSplat(Vector2(pos.x, pos.y))
		self:PlaySquirtAnimation()
	end

	@ExecSpace("ServerOnly")
	method void PlaySquirtAnimation()
		if self._dead then return end
		local mult = self._scaleMultiplier
		local baseScale = self._currentScale
		local squashAmount = 0.35
		_TweenLogic:PlayTween(0.0, 1.0, 0.2, EaseType.QuadEaseOut, function(t)
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local squash = math.sin(t * math.pi) * squashAmount
			local sx = (baseScale + squash) * mult
			local sy = (baseScale - squash * 0.6) * mult
			self.Entity.TransformComponent.Scale = Vector3(sx, sy, 1.0)
		end)
	end

	@ExecSpace("ServerOnly")
	method void PlaySlashEffect()
		local delay = self._attackDuration * 0.5
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(self.Entity) or self._dead then return end
			local map = self.Entity.CurrentMap
			if map == nil then return end
			local pos = self.Entity.TransformComponent.WorldPosition
			local dropScale = _CardManager:GetEffectScaleRatio(self)
			local offsetX = (_UtilLogic:RandomDouble() * 2 - 1) * 0.3
			local offsetY = (_UtilLogic:RandomDouble() * 2 - 1) * 0.2
			local fxPos = Vector3(pos.x + offsetX, pos.y + offsetY, pos.z - 0.2)
		
			local fx = _SpawnService:SpawnByModelId("skilleffect", "SlashFX", fxPos, map)
			if fx == nil then return end
			local renderer = fx.SpriteRendererComponent
			if renderer ~= nil then
				renderer.SpriteRUID = self.SlashEffectRUID
				renderer.PlayRate = self.SlashEffectPlayRate
			end
		
			local startScale = self.SlashEffectStartScale * dropScale
			local endScale = self.SlashEffectEndScale * dropScale
			fx.TransformComponent.Scale = Vector3(startScale, startScale, 1)
			_TweenLogic:PlayTween(startScale, endScale, self.SlashEffectDuration, EaseType.QuadEaseIn, function(scale)
				if isvalid(fx) then fx.TransformComponent.Scale = Vector3(scale, scale, 1) end
			end)
		
			fx:Destroy(self.SlashEffectDuration)
		end, delay)
	end

	@ExecSpace("ServerOnly")
	method void PlayRangedHitEffect()
		if self._hitEffectRUID == "" then return end
		local delay = self._attackDuration * 0.5
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(self.Entity) or self._dead then return end
			local map = self.Entity.CurrentMap
			if map == nil then return end
			local px = _CardManager:GetPlayerCenterX()
			local py = _CardManager:GetPlayerCenterY()
			local z = self.Entity.TransformComponent.WorldPosition.z
			local dropScale = _CardManager:GetEffectScaleRatio(self) * self._hitEffectScaleMultiplier
			-- 문어(PlayInkSplat)처럼 화면 전체 범위에서 무작위 위치에 뜨도록 스프레드를 넓혔다(유저
			-- 요청: "연출 위치 좀 랜덤으로 화면내에(먹물처럼)"). PC 카메라 가시범위(±6.4, ±3.6) 대비
			-- 화면 밖으로 새지 않을 정도로 여유를 둔 값 — ink splat의 UI px 스프레드(±220,±140)를
			-- 월드 단위로 환산한 비율과 동일하다.
			local offsetX = (_UtilLogic:RandomDouble() * 2 - 1) * 1.5
			local offsetY = (_UtilLogic:RandomDouble() * 2 - 1) * 0.9
			local fxY = py + offsetY
			-- 유저 지정(2026-08-22, PlayInkSplat 하단 30% 제외와 동일한 요청 — "네펜데스랑 골든 어쩌구
			-- 걔네도") — PC 카메라 가시범위(세로 ±3.6, 전체 7.2) 기준 화면 하단 30%(2.16)를 제외한다.
			-- py(GetPlayerCenterY, 카메라가 대체로 플레이어를 따라가므로 화면 중심 Y의 근사치)를 기준으로
			-- 하단 경계는 py - 3.6 + 2.16 = py - 1.44.
			local worldBottomExcludeY = py - 1.44
			if fxY < worldBottomExcludeY then fxY = worldBottomExcludeY end
			local fxPos = Vector3(px + offsetX, fxY, z - 0.2)
			-- 실제 스폰/중복 방지는 GameManager가 전담한다(문어 PlayInkSplat과 동일한 전역 가드 —
			-- 유저 요청: "문어처럼", 여러 마리가 동시에 쏴도 화면엔 한 번에 하나만 뜨게 함).
			_GameManager:PlayRangedHitEffect(fxPos, self._hitEffectRUID, self._hitEffectDuration, map, dropScale, self._hitEffectMaxConcurrent, self._hitEffectAlpha)
		end, delay)
	end

	@ExecSpace("ServerOnly")
	method void PlaySelfAttackEffect()
		if self._selfAttackEffectRUID == "" then return end
		local map = self.Entity.CurrentMap
		if map == nil then return end
		local pos = self.Entity.TransformComponent.WorldPosition
		local dropScale = _CardManager:GetEffectScaleRatio(self)
		local fxPos = Vector3(pos.x, pos.y, pos.z - 0.1)
		
		local fx = _SpawnService:SpawnByModelId("skilleffect", "SelfAttackFX", fxPos, map)
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		if renderer ~= nil then renderer.SpriteRUID = self._selfAttackEffectRUID end
		fx.TransformComponent.Scale = Vector3(dropScale, dropScale, 1)
		fx:Destroy(self._selfAttackEffectDuration)
	end

	@ExecSpace("ServerOnly")
	method void PlayRangedProjectile()
		if self._projectileRUID == "" then return end
		local map = self.Entity.CurrentMap
		if map == nil then return end
		local startPos = self.Entity.TransformComponent.WorldPosition
		local px = _CardManager:GetPlayerCenterX()
		local py = _CardManager:GetPlayerCenterY()
		local dropScale = _CardManager:GetEffectScaleRatio(self)
		local travelDuration = self._attackDuration * 0.5
		
		local fx = _SpawnService:SpawnByModelId("skilleffect", "SnowballFX", startPos, map)
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		if renderer ~= nil then renderer.SpriteRUID = self._projectileRUID end
		fx.TransformComponent.Scale = Vector3(dropScale, dropScale, 1)
		
		_TweenLogic:PlayTween(0.0, 1.0, travelDuration, EaseType.Linear, function(t)
			if not isvalid(fx) then return end
			local x = startPos.x + (px - startPos.x) * t
			local y = startPos.y + (py - startPos.y) * t
			fx.TransformComponent.Position = Vector3(x, y, startPos.z - 0.3)
		end)
		
		fx:Destroy(travelDuration)
	end

	@ExecSpace("Multicast")
	method void PlayAttackAnimation(string attackRUID, string standRUID, number duration)
		if self:IsServer() then return end
		if self._dead then return end
		if self._attackSoundRUID ~= "" then _SoundOptionLogic:PlaySfx(self._attackSoundRUID, 1.0) end
		local renderer = self.Entity.SpriteRendererComponent
		if renderer == nil or attackRUID == "" then return end
		renderer.SpriteRUID = attackRUID
		-- OnSyncProperty(MonsterSprite)가 이 재생 중에 되돌리지 못하도록 표시(위 _isPlayingTransientSprite
		-- 주석 참고). 세대 번호를 찍어서, 공격 주기가 겹쳐 들어와도 "가장 최신 호출"의 타이머만 실제로
		-- 되돌리게 한다(위 _transientSpriteGeneration 주석 참고).
		self._isPlayingTransientSprite = true
		self._transientSpriteGeneration = self._transientSpriteGeneration + 1
		local myGeneration = self._transientSpriteGeneration
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			if self._transientSpriteGeneration ~= myGeneration then return end
			-- attack1 상태일 때만 stand로 복원 — hit1/die1로 이미 전환된 뒤라면 그대로 둔다
			if renderer.SpriteRUID == attackRUID then
				renderer.SpriteRUID = standRUID
			end
			self._isPlayingTransientSprite = false
		end, duration)
	end

	@ExecSpace("ServerOnly")
	method void PlayLungeAnimation(number lungeBoost, number hopHeight)
		if self._dead then return end
		local mult = self._scaleMultiplier
		local baseScale = self._currentScale
		local baseY = self.Entity.TransformComponent.Position.y
		_TweenLogic:PlayTween(0.0, 1.0, 0.18, EaseType.QuadEaseOut, function(t)
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local s = baseScale + lungeBoost * math.sin(t * math.pi)
			self.Entity.TransformComponent.Scale = Vector3(s * mult, s * mult, 1.0)
			if hopHeight > 0 then
				local pos = self.Entity.TransformComponent.Position
				self.Entity.TransformComponent.Position = Vector3(pos.x, baseY + hopHeight * math.sin(t * math.pi), pos.z)
			end
		end)
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 슬로우·스턴·도트 타이머 정리
		if self._slowTimerId ~= 0 then
			_TimerService:ClearTimer(self._slowTimerId)
			self._slowTimerId = 0
		end
		if self._stunTimerId ~= 0 then
			_TimerService:ClearTimer(self._stunTimerId)
			self._stunTimerId = 0
		end
		if self._dotTimerId ~= 0 then
			_TimerService:ClearTimer(self._dotTimerId)
			self._dotTimerId = 0
		end
		if self._miniMooreDropTimerId ~= 0 then
			_TimerService:ClearTimer(self._miniMooreDropTimerId)
			self._miniMooreDropTimerId = 0
		end
		if self._miniMooreLifeTimerId ~= 0 then
			_TimerService:ClearTimer(self._miniMooreLifeTimerId)
			self._miniMooreLifeTimerId = 0
		end
		if self:IsClient() and self._touchHandler ~= nil then
			self.Entity:DisconnectEvent(TouchEvent, self._touchHandler)
			self._touchHandler = nil
		end
		if isvalid(self._freezeIndicator) then
			self._freezeIndicator:Destroy()
			self._freezeIndicator = nil
		end
		self:ClearAllComboOrbs()
		self:DestroyStunStars()
		-- 성능 최적화(2026-08-24) — SetSpawnZone에서 등록한 존별 레지스트리 항목을 뗀다. OnEndPlay는
		-- Die()든 직접 Entity:Destroy()든(지연 파괴 포함) 파괴 경로와 무관하게 항상 불리므로, 등록 짝을
		-- 여기 한 곳에만 두면 어디서 죽거나 파괴되든 레지스트리가 새지 않는다.
		_MonsterSpawner:UnregisterZoneMonster(self._spawnZoneIndex, self)
	end

end