@Component
script MonsterAI extends Component

	-- 몬스터 스탯
	property number MaxHp = 100

	property number CurrentHp = 100

	@Sync
	property string MonsterSprite = ""

	-- 접근 속도: 초당 스케일 증가량 (0.3 → 1.5까지 약 4초)
	-- 웨이브별 스프라이트 동기화 (서버 → 클라이언트)
	property number ApproachSpeed = 0.3

	-- 도착 타이밍 분산: 개체별로 ApproachSpeed를 ±이 값만큼 무작위로 흔들어
	-- 같은 타이밍에 스폰된 몬스터들이 동시에 도착하지 않게 한다
	property number ApproachSpeedVariance = 0.08

	-- 정면 도착 후 공격 간격 (초)
	property number AttackInterval = 1.0

	-- 엔진 기본 데미지 스킨 RUID (DamageSkinSettingComponent 기본값과 동일 — 실제 메이플스토리 데미지 숫자 그래픽)
	property string _damageSkinId = "6ba67548f43f48f29eb23dafd0766383"

	@Sync
	property boolean _dead = false

	-- 내부 상태
	-- _dead는 원래 서버 전용 로컬 프로퍼티였는데, 클라이언트 쪽 애니메이션 코드(OnSyncProperty/
	-- PlayHitAnimation/PlayAttackAnimation)가 전부 "죽었으면 무시"를 self._dead로 체크하고 있었다 —
	-- @Sync가 없어서 클라이언트 자신의 _dead는 절대 true가 안 되니 그 가드들이 전부 무효였던 것
	-- (죽는 애니 재생 직후 늦게 도착한 다른 애니 갱신이 덮어써버리는 버그의 진짜 원인).
	property number _currentScale = 0.3

	property boolean _reachedPlayer = false

	property number _attackTimer = 0

	-- 스폰된 존 번호(InitializeStats가 넘겨준 zoneIndex를 저장) — Die()에서 존16~17 전용
	-- 재화(야누스의 검 교환권) 드롭 판정에 쓴다
	property integer _spawnZoneIndex = 0

	-- InitializeStats가 뽑은 외형 인덱스(웨이브 번호 또는 존 전용 풀 내 인덱스) 저장 — Die()에서
	-- GameManager.GetMonsterLootItemId(zoneIndex, speciesIdx)로 "실제 그 몬스터의 드롭템"을 결정하는 데 쓴다
	property integer _speciesIdx = 0

	-- 맵23 에르다스 이스터에그 전용(InitializeErdas) — 이 몬스터가 죽을 때 존 잡템 대신
	-- Map23ErdasEasterEggLogic.OnErdasKilled에 알려서 정수 드롭+킬카운트를 처리한다
	property boolean _isErdas = false

	property integer _erdasOrdinal = 0

	-- 맵24 진 힐라의 보물상자 전용(InitializeTreasureChest) — 죽을 때 Map24TreasureChestLogic에 알린다
	property boolean _isTreasureChest = false

	-- 에르다스/보물상자 전용 피격·사망 사운드(기본 몬스터 풀은 사운드가 없어 빈 문자열 유지)
	property string _hitSoundRUID = ""

	property string _dieSoundRUID = ""

	-- true면 정면 도달(_reachedPlayer)해도 OnReachPlayer(플레이어 공격)를 호출하지 않는다 — 보물상자처럼
	-- 스탯 몬스터를 재사용하되 공격은 안 하는 고정 타겟을 만들 때 쓴다
	property boolean _neverAttacks = false

	-- 거대 네펜데스 전용 2단계 부활 메커니즘(유저 요청, 2026-08-10 확정). 1페이즈(첫 등장, 패시브)로
	-- 죽으면 진짜 죽지 않고 그 자리에서 2페이즈(원거리 공격)로 부활하고, 2페이즈가 죽어야 진짜 사망한다.
	-- 네펜데스/다크네펜데스는 이 메커니즘과 완전히 무관하다(거대 네펜데스 자신의 사망 처리 분기일 뿐,
	-- 다른 종을 거대 네펜데스로 변신/소환시키지 않는다 — 유저가 여러 차례 강하게 확정한 사항).
	property boolean _isGiantNepenthes = false

	property boolean _giantNepenthesRevived = false

	-- 예티/다크예티/예티와페페/다크예티와페페(에피소드3 map2) 전용 범용 2단계 부활 메커니즘 — 위
	-- 거대 네펜데스와 동일한 구조(1페이즈 die1 재생 후 진짜 죽지 않고 2페이즈로 부활)이지만, 종마다
	-- 1/2페이즈 외형이 전부 달라서 GiantNepenthes*처럼 고정 프로퍼티가 아니라 존 풀 테이블
	-- (GetMapHasPhase2/GetMapPhase2*RUID, mapIndex+idx 기준)로 관리한다.
	property boolean _hasPhase2 = false

	property boolean _phase2Revived = false

	-- 2페이즈 발동 확률(0.0~1.0, 기본 1.0=항상). 주니어 예티(사망 시 50%만 성체 예티로 성장)처럼 부활이
	-- 확정이 아닌 종을 위한 필드 — 실제 굴림은 Die()에서 1회만 한다.
	property number _phase2Chance = 1.0

	-- 공격 사운드(선택적 — 대부분 종은 비워둔다). 현재는 거대 네펜데스 2페이즈 전용으로만 채워진다.
	property string _attackSoundRUID = ""

	-- 슬로우 상태 (콜드 빔)
	-- 유물 수리검(10번) 판정용 — 마지막으로 받은 타격이 치명타였는지. Die()에서 확률 굴림에 쓴다
	property boolean _lastHitWasCrit = false
	property boolean _isSlowed = false

	property integer _slowTimerId = 0

	-- 감전(스턴) 상태 (썬더볼트)
	property boolean _isStunned = false

	property integer _stunTimerId = 0

	property number _stunSavedSpeed = 0

	-- 명중 하락(연막탄 전용) — 0이면 정상, >0이면 그 확률만큼 OnReachPlayer에서 공격이 "빗나감"
	-- 처리된다(보스/엘리트는 OnReachPlayer에서 절반만 적용). 재적용 시 확률/타이머 갱신.
	property number _accuracyDebuffPercent = 0

	property integer _accuracyDebuffTimerId = 0

	-- 완전 빙결(아이템 "얼음 파편" 전용) — 빙결스택(FreezeStack, 슬로우만 걸리는 별도 시스템)과도,
	-- 스턴(ApplyStun, 스킬별로 걸리고 풀리는 자기 타이머)과도 독립된 상태다. 행동불가 + 진한 파란색
	-- 틴트로 고정 지속시간(7초) 동안 완전히 멈춰있다가 자동으로 원래대로 돌아온다.
	property boolean _isHardFrozen = false

	property integer _hardFreezeTimerId = 0

	property Color _preHardFreezeColor = Color(1, 1, 1, 1)

	-- 공중 부양 상태 (아쿠아 트랩). 착지 타이머를 추적해야, 같은 대상이 아직 떠 있는 도중에
	-- 다시 걸렸을 때(부스터로 쿨타임이 속박시간보다 짧아지면 실제로 발생) 기준 높이를 다시 잡지
	-- 않고 그대로 재예약할 수 있다 — 안 그러면 기준 높이가 계속 위로 밀려 올라가 영영 안 내려온다.
	property boolean _isLevitating = false

	property integer _levitateTimerId = 0

	property number _levitateBaseY = 0

	-- 도트 데미지 상태 (메테오)
	property number _dotDamage = 0

	property integer _dotTicksLeft = 0

	property integer _dotTimerId = 0

	-- 엘리트 상태 (5웨이브마다 스폰 그룹 중 1마리)
	property boolean _isElite = false

	property number _scaleMultiplier = 1.0

	property string EliteOutlineMaterialId = "1a012835-dab3-4dcd-821b-9bc826ce696f"  -- RootDesk/MyDesk/Materials/EliteOutline.material

	-- 웨이브10 리본돼지 보스인지 여부 — Die()에서 GameManager에 보스 처치를 알리는 데 사용
	property boolean _isBoss = false

	-- 맵10 보너스 스테이지 전용 보스 여부 — true면 접근/공격 대신 배회하고, 사실상 무적이며
	-- 맞을 때마다(죽지 않고) 골드/포션/스킬을 지급한다. MonsterSpawner.InitializeBonusBoss()가 설정한다.
	property boolean _isBonusBoss = false

	-- 유저 지정(2026-08-26): "보스 체력을 만들자" — ep3_map2 커플예티 보너스보스만 이 플래그로 실제
	-- HP를 추적해 진짜로 죽을 수 있게 한다(InitializeAnimatedBonusBoss가 true로 설정). 맵10의 구식
	-- 정적 보너스보스(InitializeBonusBoss)는 이 플래그를 안 건드리므로 기존처럼 영원히 무적으로 남는다.
	property boolean _bonusBossKillable = false

	-- 유저 지정(2026-08-26): "타이머가 돌아갈때 공격하게 바꿔줘(타이머 있는 모든곳)" — 존이동/스폰
	-- 직후 화면이 아직 전환 중이거나 타이머가 "30"으로 표시되기 전(1초 지연 구간)에는 유저가 상황을
	-- 인지하기도 전에 공격이 이미 들어가고 있었다(버그 리포트). 두 보너스보스(맵10 InitializeBonusBoss,
	-- ep3_map2 InitializeAnimatedBonusBoss) 모두 스폰 즉시 이 플래그를 true로 걸어 완전히 무적/타겟불가
	-- 취급하고, 각 소유 Logic이 실제로 타이머를 보여주기 시작하는 시점에 false로 풀어준다.
	property boolean _bonusBossCombatLocked = false

	-- 존27 석상 이스터에그 전용("얄미운 미니무르") — 전투 대상이 아니다(타격 완전 무시, 무적/사망 개념
	-- 자체가 없음). 순수 시간 기반: MiniMooreDropInterval마다 무조건 뭔가 하나 떨어뜨린다 —
	-- MiniMooreDropChance 확률로 보유 스킬, 그 외엔 잡템(RollMiniMooreDrop 참고) — 하다가
	-- MiniMooreLifetime이 지나면 스스로 날아올라 사라진다(PlayDespawnJump 재사용).
	-- NinjaStatuePuzzleLogic.SpawnMiniMoore()가 InitializeMiniMoore()로 설정한다.
	property boolean _isMiniMoore = false

	property number MiniMooreDropInterval = 1.0

	property number MiniMooreDropChance = 0.03

	-- 스폰 즉시 드랍하면 어색해서 첫 드랍은 MiniMooreDropInterval만큼 지연시킨다(SetTimerRepeat의
	-- startDelaySeconds) — 그래서 총 유지시간도 12초(드랍 12번)+시작 지연 1초 = 13초로 늘렸다.
	property number MiniMooreLifetime = 13.0

	property integer _miniMooreDropTimerId = 0

	property integer _miniMooreLifeTimerId = 0

	-- 존2 trap-44 이스터에그 "마노"(InitializeStatsAsMano) — 미니무르 계열과 달리 실제로 잡을 수 있고,
	-- 처치하면 Die()가 Ep1Zone2ManoLogic으로 보상 지급을 넘긴다. 유저 지정: HP 1000 고정 / 10초 제한.
	property boolean _isMano = false

	property number ManoFixedHp = 1000

	property number ManoLifetime = 10.0

	property integer _manoLifeTimerId = 0

	property number _wanderMinX = -5

	property number _wanderMaxX = 5

	property number _wanderY = -1.18

	property number _wanderTargetX = 0

	property number _wanderSpeed = 1.6

	property number _wanderRetargetTimer = 0

	property integer BonusGoldPerHit = 8

	property number BonusPotionChance = 0.10

	property number BonusSkillChance = 0.01

	@Sync
	property boolean _isLostRudolph = false

	@Sync
	property boolean IsStanding = false

	-- 에피소드3 map2 존10 "길잃은 루돌프" 이스터에그(Ep3Map2LostRudolphLogic) — _isMiniMoore를 그대로
	-- 재사용해 전투 완전 무시(일반 공격 X, 유저 지정) + 지상 배회(UpdateWander)를 얻고, 여기에 이동/정지
	-- 애니메이션 사이클(4~6초 이동→1초 정지)만 얹는다. 정지 중에 터치하면 성공(die1 재생 후 사라짐,
	-- 보상 없음), 이동 중에 터치하면 실패(Ep3Map2LostRudolphLogic이 "불량 루돌프" 2마리를 소환).
	-- 버그 수정(2026-08-26, 유저 리포트 "길잃은 루돌프를 눌러도(움직일때) 불량 루돌프는 생성이
	-- 안되네") — @Sync가 없어서 클라이언트 쪽 이 값은 항상 기본값(false)에 머물렀다. 서버가
	-- InitializeLostRudolph()에서 true로 세팅해도 그 값이 클라에 동기화되지 않아, 클라 전용 터치
	-- 핸들러(OnLostRudolphClientTouched)의 가드(`if not self._isLostRudolph then return end`)가
	-- 매번 조용히 막고 있었다 — 터치 자체가 서버까지 전달되지 않았던 원인.
	property number _lostRudolphCycleTimer = 0

	property number LostRudolphMoveMin = 4.0

	property number LostRudolphMoveMax = 6.0

	property number LostRudolphStandDuration = 1.0

	property any _touchHandler = nil

	-- "불량 루돌프"(길잃은 루돌프를 이동 중에 잘못 터치했을 때의 처벌 소환) 전용 — 정상 처치 보상
	-- (골드는 유저 지정대로 정상 지급되지만 EXP/잡템/장비/스킬 드롭은 전부 없음, Die() 참고)
	property boolean _isBadRudolph = false

	-- 맵23 에르다스 전용 — 도달(_reachedPlayer)한 뒤 제자리에 얼어붙는 대신 공중 발판 위를 좌우로
	-- 배회하며 공격한다(유저 요청: "좌우로 이동하면서 공격하면 좋겠거든"). 배회 목표가 발판 범위를
	-- 벗어나면(유저 요청: "발판을 벗어나면 아래로 떨어지게") 실제 발판 유무를 매 프레임 레이캐스트로
	-- 확인해서 없으면 낙하로 전환한다. BonusBoss의 UpdateWander(고정 Y, 항상 안전한 바닥)와 달리
	-- 지형을 따라 Y가 실시간으로 바뀌고, 발판이 없으면 중력으로 떨어지다가 아래쪽 발판(맵23 메인
	-- 바닥이 전체 폭을 덮고 있어 결국 착지함)에 닿으면 다시 배회를 재개한다.
	property number _erdasPatrolMinX = -1.3

	property number _erdasPatrolMaxX = 1.3

	property number _erdasPatrolTargetX = 0

	property number ErdasPatrolSpeed = 0.8

	property number _erdasPatrolRetargetTimer = 0

	property boolean _isErdasFalling = false

	property number _erdasFallVelocity = 0

	property number ErdasGravity = 9.8

	-- 맞을 때마다 스케일이 커지는 효과(유저 요청: "때릴때마다 2%씩 스케일이 커지면 좋겠어 맥스 20%") —
	-- _scaleMultiplier 자체를 곱하지 않고 별도 배율로 둔다(그래야 정확히 +2%p씩 20%까지 선형으로
	-- 쌓이고, 이미 적용된 사이즈 절반(0.5배)과도 독립적으로 곱연산된다)
	property number _erdasHitGrowthBonus = 0

	property number ErdasHitGrowthPerHit = 0.02

	property number ErdasHitGrowthMaxBonus = 0.20

	-- 스폰 시점 웨이브의 die1 / hit1 / attack1 애니메이션 RUID 및 재생 시간
	property string _dieRUID = ""

	property number _dieDuration = 0.5

	property string _hitRUID = ""

	property string _attackRUID = ""  -- 없는 웨이브(3/5/6/8/9/10)는 빈 문자열 → 들이받기 연출로 대체

	-- attack1/hit1 스프라이트가 화면에 떠 있는 동안 true — PlayAttackAnimation/PlayHitAnimation(둘 다
	-- 클라이언트에서 실행)이 직접 세팅/해제한다. OnSyncProperty가 이 플래그로 "지금 재생 중인 공격/피격
	-- 포즈를 MonsterSprite 동기화가 되돌려버리면 안 된다"를 판단한다 — _attackRUID/_hitRUID 자체는
	-- @Sync가 아니라 클라이언트에서 항상 ""로 읽히므로 그 값으로는 판단할 수 없다(실측으로 확인된 함정).
	property boolean _isPlayingTransientSprite = false

	-- 버그 수정(2026-08-27, 유저 리포트: "웨어울프나 라이칸이나 연출이 끝까지 나올때가 있고 그냥
	-- 안나올때가 있는거 같아") — 공격 주기(AttackInterval)가 attack1 재생시간(_attackDuration)보다
	-- 짧은 종은 이전 공격의 복귀 타이머가 살아있는 채로 다음 공격이 겹쳐 들어온다. PlayAttackAnimation/
	-- PlayHitAnimation의 복귀 타이머는 "지금 스프라이트가 내가 세팅한 attackRUID/hitRUID와 같은가"만
	-- 확인해서 되돌리는데, attackRUID는 종 전체가 같은 값이라 새/구 타이머를 구분 못 해 구 타이머가
	-- 새로 시작한 재생을 조기에 stand로 끊어버리고 _isPlayingTransientSprite까지 꺼버린다(그 순간 마침
	-- 도착한 MonsterSprite 동기화가 다시 덮어쓸 수 있는 창이 열림) — "가끔 끝까지 나오고 가끔 아예
	-- 안 보인다"가 정확히 이 겹침 여부에 좌우된다. 매 PlayAttackAnimation/PlayHitAnimation 호출마다
	-- 1씩 증가시켜, 각 복귀 타이머가 "내가 최신 세대일 때만" 되돌리게 한다(AttackInterval 튜닝과
	-- 별개로, 어떤 종에서도 이 겹침 자체가 다시는 문제되지 않도록 하는 이중 안전장치).
	property integer _transientSpriteGeneration = 0

	-- attack1 스프라이트를 원래 포즈로 되돌리기까지 대기하는 시간 — 클립 프레임 수가 다 다른데 기존엔
	-- 0.25초로 고정돼 있어서, 프레임이 많은 종(자이언트 쉐도우 8프레임 등)은 재생 중간에 잘려 보였다.
	-- die1과 같은 재생 속도(초당 약 10프레임) 가정으로 종별 프레임 수에 맞춰 GetMapAttackDuration이 계산해 준다.
	property number _attackDuration = 0.25

	-- 원거리 종(네펜데스/다크네펜데스/거대 네펜데스 2페이즈) 전용 히트 이펙트(attack1/info/hit 서브클립).
	-- 빈 문자열이면 PlayRangedHitEffect가 아무것도 재생하지 않는다.
	property string _hitEffectRUID = ""

	property number _hitEffectDuration = 0.5

	-- PlayRangedHitEffect의 dropScale에 곱해지는 추가 배율(기본 1.0=무영향). Ep2MiniBeanEasterEggLogic
	-- 전용 값(30% 크게)뿐 아니라, InitializeStats(존 풀 종)에서도 GameManager.GetMapHitEffectScaleMultiplier로
	-- 채운다 — 유저 지정(2026-08-25): 몽실생크림 20%·예티류 15% 축소.
	property number _hitEffectScaleMultiplier = 1.0

	-- 원거리 히트 이펙트 알파(투명도, GameManager.GetMapHitEffectAlpha와 짝) — 기본 1.0. 유저 지정
	-- (2026-08-25): 예티류만 15% 감소(0.85).
	property number _hitEffectAlpha = 1.0

	-- 원거리 히트 이펙트 동시 출력 개수 상한(GameManager._rangedHitEffectActiveCount와 짝) — 기본 1(기존
	-- 종은 전부 이 값), 예티류만 유저 지정으로 3(GetMapHitEffectMaxConcurrent 참고).
	property integer _hitEffectMaxConcurrent = 1

	-- 스노우맨(원거리) 전용 — 몬스터 위치에서 플레이어 위치까지 실제로 날아가는 투사체(attack1/info/ball
	-- 서브클립, 유저 제공). 빈 문자열이면 PlayRangedProjectile이 아무것도 재생하지 않는다(기존 원거리
	-- 종처럼 착탄 이펙트(_hitEffectRUID)만 뜬다).
	property string _projectileRUID = ""

	-- 푼코/쿠스코(Ep3Map3·4PunkoEasterEggLogic) 전용 — 공격 순간 몬스터 자기 자신의 위치(중앙)에 뜨는
	-- 연출(attack1/info/effect 서브클립, 유저 지정: "푼코 가운데서 나타나게"). _hitEffectRUID(플레이어
	-- 위치에 뜨는 착탄 이펙트)와 달리 몬스터 자신의 WorldPosition에 뜬다는 점이 다르다. 빈 문자열이면
	-- PlaySelfAttackEffect가 아무것도 안 한다.
	property string _selfAttackEffectRUID = ""

	property number _selfAttackEffectDuration = 0.5

	-- 원거리 히트 이펙트를 쓰는 종(네펜데스/다크네펜데스/거대 네펜데스 2페이즈) 전용 공격 쿨타임
	-- 오버라이드 — 유저 요청: "너무 빠르게 공격하는 감이 있는데 공격하고 0.7초정도는 쉬자". 0이면
	-- 공용 AttackInterval을 그대로 쓴다. 공격 애니메이션(_attackDuration) 재생이 끝난 뒤 순수하게
	-- 쉬는 시간이 0.7초가 되도록 attackDuration + 0.7로 계산한다.
	property number _customAttackInterval = 0

	-- 빠른 이동 안전장치 2단계(6연속) 전용 — ApplyRushPenalty가 세팅. 1.0이면 평소와 동일(강화 없음).
	-- 2026-08-17 유저 요청("6연속때 공격력 더 쎄게")으로 체력/공격력 배율을 분리했다. 원래는 둘 다
	-- RushTier2StatMultiplier 하나를 공용으로 썼는데, 그대로 올리면 몬스터가 같이 탱키해져서
	-- "빨리 죽이고 지나가기"가 더 어려워지는 역효과가 난다 — 체력은 1.2 유지, 공격력만 1.8로 올린다.
	property number RushTier2StatMultiplier = 1.2

	property number RushTier2DamageMultiplier = 1.8

	property number _rushDamageMultiplier = 1.0

	-- 접근(스케일 확대) 중 보여줄 이동 애니메이션. MonsterSprite는 "지금 화면에 보여야 할 정지 포즈"
	-- 하나만 나타내던 프로퍼티였는데, 이제 접근 중엔 move, 도달(_reachedPlayer)하면 stand로 스스로 갈아끼운다 —
	-- PlayHitAnimation/PlayAttackAnimation이 전부 self.MonsterSprite를 "복귀할 정지 포즈"로 참조하므로, 이렇게
	-- MonsterSprite 자체를 단계별로 바꿔주면 히트/공격 연출 복귀 로직을 손댈 필요가 없다(항상 "지금 단계의
	-- 올바른 포즈"로 자동 복귀됨). 공중형은 스케일 접근이 아니라 자유비행이라 move 연출 자체가 필요 없어
	-- _moveRUID가 빈 문자열로 유지되고(InitializeStats), 그 경우 MonsterSprite는 항상 _standRUID로 고정된다.
	property string _standRUID = ""

	property string _moveRUID = ""

	-- 맵 전용 몬스터 풀 중 원거리(먹물) 공격 종인지 여부 — true면 도달 시 들이받기 대신 화면 잉크 스플랫 연출
	property boolean _isRangedInk = false

	-- 원거리 종이 근접 종보다 "조금 멀리서" 공격하도록, 도달 판정(_reachedPlayer) 스케일 임계값을 낮춰준다.
	-- 근접은 기존과 동일하게 1.5(최대 크기)까지 다가와야 도달 판정, 원거리는 이보다 작은 값에서 멈춘다
	property number _reachedScaleThreshold = 1.5

	property number RangedReachedScale = 1.15

	-- 맵 전용 몬스터 풀 중 원거리(칼자국) 공격 종인지 여부(자이언트 쉐도우) — _isRangedInk와 마찬가지로
	-- 도달 임계값을 낮추지만, 대체 연출이 아니라 기존 attackRUID 스프라이트 스왑 공격 위에 발톱자국
	-- 이펙트(PlaySlashEffect)를 얹는다(OnReachPlayer 참고) — 자이언트 쉐도우는 자체 attack1 애니메이션이
	-- 이미 있어서 대체할 필요가 없다.
	property boolean _isRangedSlash = false

	-- 발톱자국 이펙트 리소스 — 애초에 UI 아이콘 하나를 전 몬스터가 공유하는 방식(_slashMarkActive 가드)
	-- 이었는데, 여러 마리가 동시에 공격하면 첫 번째 것만 보이고 나머지는 씹히는 버그가 있었다(유저 실측:
	-- "지금은 공격 이펙트 1개만 뜨는듯"). "skilleffect" 월드 이펙트(개별 Entity라 마리마다 독립적으로
	-- 동시에 뜰 수 있음)로 바꿔서 해결. RUID는 애니메이션클립 전체(4프레임)를 그대로 써서 발톱이 스치는
	-- 과정 자체가 재생되게 한다(정적 프레임 하나만 쓰던 것보다 자연스러움).
	-- 작게 시작해서(StartScale) 크게(EndScale) 자라나며 화면 쪽으로 다가오는 느낌을 준다(유저 요청 —
	-- "검기 발산하는 것처럼 사이즈가 커지면서 화면에 닿으면 더 좋을듯").
	property string SlashEffectRUID = "954ea7049e454950b7e44643049de099"

	property number SlashEffectStartScale = 0.15

	property number SlashEffectEndScale = 0.6

	-- 0.5초였을 때 "너무 빨리 끝나서 잘 안 보인다"는 피드백 — 0.65초로 늘리고, 스프라이트 자체 재생
	-- 속도(PlayRate)도 늦춰서 이 늘어난 지속시간 내내 (마지막 프레임의 흐릿한 잔광이 아니라) 선명한
	-- 발톱자국 프레임이 계속 보이게 한다.
	property number SlashEffectDuration = 0.65

	property number SlashEffectPlayRate = 0.5

	-- 깊이감 연출: 몬스터 위에 같은 스프라이트를 검게 덧씌운 자식 엔티티(.model의 "DepthOverlay")를
	-- 스폰 시점(뒤쪽, 알파 최대)부터 도달 시점(앞쪽, 알파 0)까지 _currentScale 진행도에 맞춰 점점
	-- 투명하게 만들어 "멀리 있을수록 어둡고 다가올수록 원래 색이 드러나는" 것처럼 보이게 한다.
	-- 몬스터 자체의 Color를 바꾸는 게 아니라 별도 오버레이 레이어라서, 슬로우/빙결 틴트(ApplySlow 등)와
	-- 절대 간섭하지 않는다.
	property number DepthOverlayMaxAlpha = 0.5

	property SpriteRendererComponent _depthOverlayRenderer = nil

	-- 같은 종/같은 웨이브로 스폰된 몬스터는 스폰 직후 스케일이 완전히 동일해서(ApproachSpeedVariance가
	-- 아직 벌려놓기 전) Z값이 겹친다 — 이때 그림자(DepthOverlay, 자기 본체보다 로컬 Z -0.001만큼 항상
	-- 앞에 그려짐)가 Z가 같은 "다른" 몬스터의 본체 앞으로 잘못 겹쳐 보일 수 있다. OnBeginPlay에서
	-- 개체마다 한 번만 뽑는 미세한 고유 오프셋을 깊이 계산에 항상 더해서 서로 다른 개체끼리는 절대
	-- 정확히 같은 Z가 되지 않게 한다(그림자 -0.001 오프셋보다 10배 커서 확실히 갈라놓음).
	property number _depthTieBreak = 0

	-- 히트 리액션(PlayHitAnimation)이 몬스터 본체 스프라이트를 hitRUID로 잠깐 바꾸는 동안, 오버레이가
	-- 여전히 서 있는 포즈 실루엣을 보여주면 서로 어긋나 보인다 — 이 구간만 오버레이를 꺼둔다.
	-- PlayHitAnimation의 복귀 타이머와 반드시 같은 값을 써야 한다(하드코딩 이중관리 방지).
	property number HitFlashDuration = 0.15

	-- 공격 시 살짝 위로 뛰는 모션 높이 — 비행형을 제외한 모든 몬스터의 공격 연출에 공용으로 쓰인다
	property number AttackHopHeight = 0.2

	-- 비행형 종(맵15 박쥐) 전용 — 스케일로 "접근"을 표현하는 대신 화면 안에서 2D로 자유롭게
	-- 날아다니다가(접근/도달 개념 없음) 일정 간격으로 공격한다. "목표점 찍고 걸어가기" 방식은 X범위가
	-- Y범위보다 훨씬 넓어서 사실상 가로로만 움직이는 것처럼 보이는 문제가 있었다(실측 확인) — 대신
	-- X/Y를 각각 다른 주기의 사인파로 동시에 흔들어(리사주 곡선) 항상 두 축이 같이 바뀌는 나풀거리는
	-- 궤적을 만든다. 개체마다 위상/속도를 무작위로 달리해 여러 마리가 같은 패턴으로 겹쳐 보이지 않게 한다.
	property boolean _isFlying = false

	property number FlyRangeX = 3.0  -- 좌우 진폭

	property number FlyingWanderMinY = -0.3

	property number FlyingWanderMaxY = 2.0

	property number FlySpeedX = 1.1  -- 좌우 기본 각속도

	property number FlySpeedY = 1.7  -- 상하 기본 각속도 (좌우와 다르게 잡아 단순 대각선 왕복이 되지 않게 함)

	property number FlyAttackInterval = 1.5  -- 도달 판정 없이 이 간격으로 계속 공격

	property number _flyCenterX = 0

	property number _flyBaseY = 0

	property number _flyTime = 0

	property number _flyPhaseX = 0

	property number _flyPhaseY = 0

	property number _flySpeedMultX = 1.0

	property number _flySpeedMultY = 1.0

	-- 닌자 컨셉 몬스터(존27~30 지상형) 전용 — 접근 중 좌우로 사인파 지그재그 흔들림을 얹는다(전진 자체는
	-- 기존과 동일하게 _currentScale로 표현, 좌우 흔들림만 별도 X 오프셋으로 분리해서 서로 간섭하지 않는다).
	-- 흔들리는 동안 잔상(반투명 스프라이트 복제)을 주기적으로 남겨 "휙" 하는 느낌을 보탠다.
	property boolean _isZigzag = false

	property number ZigzagAmplitude = 0.5  -- 좌우 진폭(월드 단위) 기본값 — 발판이 이보다 좁으면 실제로는

	-- _zigzagAmplitudeActual로 줄여서 쓴다(아래 참고)
	property number ZigzagFrequency = 3.0  -- 좌우 흔들림 각속도

	property number _zigzagTime = 0

	property number _zigzagPhase = 0

	property number _zigzagBaseX = 0  -- 지그재그 중심(스폰 X)

	-- 실제로 이번 흔들림에 쓸 진폭 — InitializeStats가 스폰된 발판의 실제 xMin/xMax(MonsterSpawner.
	-- GetContainingRunBounds)를 조회해 ZigzagAmplitude를 발판 폭 안으로 클램프한 값. 좁은 공중타일(예:
	-- 에피소드2 map2 존7~10)에서 기본 진폭(0.5)이 타일 경계를 넘어가 "타일 아닌 부분을 밟는 것처럼
	-- 보인다"는 유저 리포트로 추가(2026-08-19). 발판을 못 찾으면(밴드/타일섬 스폰 등) ZigzagAmplitude
	-- 그대로 폴백.
	property number _zigzagAmplitudeActual = 0.5

	-- 재규어(존32/33, 정글 컨셉)도 접근 중 지그재그를 켜지만, 닌자 전용이던 잔상 연출은 같이 얹지 않는다
	-- (유저 요청 — "살짝 지그재그"만, 잔상은 그대로 존27~30 전용). _isZigzag는 공유하되 잔상 여부만 분리.
	property boolean _hasZigzagAfterimage = false

	property number AfterimageInterval = 0.12

	property number _afterimageTimer = 0

	property number AfterimageFadeDuration = 0.2

	property number AfterimageAlpha = 0.35

	-- 이어하기 밀려나는 중 OnUpdate 스킵 플래그
	-- 돌진형 종(맘무트/골든맘무트/트라고스) — 스폰 후 GetMapChargeShakeDuration만큼 제자리에서 위아래로
	-- 떨다가(wind-up), 뒤에 먼지 이펙트를 남기며 ApproachSpeed를 크게 부스트해서 빠르게 접근한다. wind-up이
	-- 끝나고 나면(_chargeDashActive=true) 일반 몬스터의 스케일 접근 로직(OnUpdate 하단)을 그대로 재사용한다 —
	-- 부스트된 ApproachSpeed 하나로 "빠른 접근"이 표현되므로 별도 이동 코드가 필요 없다.
	property boolean _isCharge = false

	property number _chargeWindupTimer = 0

	property boolean _chargeDashActive = false

	property number _chargeSpawnX = 0

	property number _chargeSpawnY = 0

	property number ChargeShakeAmplitude = 0.06  -- 떨림 진폭(월드 단위)

	property number ChargeDashSpeedMultiplier = 7.0  -- wind-up 종료 시 ApproachSpeed에 곱해지는 배수

	property string ChargeDustSortingLayer = "MapLayer0"

	property integer ChargeDustOrderInLayer = 1  -- 몬스터 본체(OrderInLayer=2, platform.md 기본값)보다 낮게 둬서 몬스터가 먼지 위에 그려지게 한다

	property number ChargeDustScale = 0.6  -- 원형 먼지 이펙트 스케일(유저 요청: 기존 1.0 대비 40% 축소)

	property boolean _isPushingBack = false

	-- 플레이어가 이 몬스터가 있는 맵을 떠났을 때 true — 접근/공격 로직을 멈춘다 (MapManager가 제어)
	property boolean _paused = false

	-- true면 Pause()가 호출돼도 무시한다(Ep2MiniBeanEasterEggLogic 전용 — "존을 이동해도 항상 활동"을
	-- 위해 도입. 예전엔 _spawnZoneIndex에 존 범위 밖 예약값(999)을 넣어 SetMonstersPausedForZone의
	-- 매칭 자체를 피해가는 방식이었는데, GetMonstersInCurrentZone(플레이어 카드/스킬 타겟팅이 쓰는
	-- 목록)도 똑같이 _spawnZoneIndex==currentZone으로 걸러서 그 트릭 때문에 플레이어 공격이 얘네를
	-- 영원히 못 때리는 부작용이 있었다 — 유저 리포트: "플레이어가 미니빈 공격을 안한다". 이제
	-- _spawnZoneIndex는 항상 실제 현재 존을 따라가게 하고(RepositionFlyingCenter가 갱신), 대신 이
	-- 플래그로 "일시정지만" 별도로 막는다.)
	property boolean _neverPauses = false

	-- true면 OnReachPlayer의 비행형 공격 분기에서 PlayLungeAnimation(스케일이 확 커졌다 돌아오는
	-- 들이받기 임팩트)을 생략한다(Ep2MiniBeanEasterEggLogic 전용 — 유저 요청: "스케일 작아졌다
	-- 커졌다 안 하고 그냥 날아다녀도 될 듯"). 다른 비행형(뉴그레이 화이트 등)은 기존 그대로 유지.
	property boolean _skipAttackLunge = false

	-- true면 OnReachPlayer 진입 즉시 Ep2MiniBeanEasterEggLogic:TryClaimGroupAttack()을 거쳐, 그 프레임에
	-- 이미 다른 무리원이 먼저 공격을 "선점"했으면 전부 스킵한다(Ep2MiniBeanEasterEggLogic 전용 — 유저
	-- 요청: "핑크빈 무리가 공격할때 무조건 1회 공격 들어가게, 딴 몬스터가 때리는거 관계없이" — 미니빈
	-- 12마리는 전부 같은 시점에 스폰돼 FlyAttackInterval도 동일하므로 공격 타이머가 완전히 동기화돼
	-- 있고, 매 주기마다 12마리가 동시에 OnReachPlayer를 불러 12배 대미지가 들어가고 있었다).
	property boolean _isSwarmMember = false

	-- true면 OnReachPlayer의 대미지 판정이 GameManager._hitImmune(플레이어 피격 후 0.8초 전역 무적 프레임)를
	-- 무시하고 항상 들어간다(_isSwarmMember와 동일한 ignoreHitImmune 경로를 공유 — Tired Knight("지쳐버린
	-- 기사") 전용, 유저 지정: "일반 몬스터가 때릴때 대미지가 안들어가는 부분을 뚫고 공격할수있음(일반
	-- 몬스터가 떄리고 바로 떄려도 대미지 들어감)"). InitializeStatsAsTiredKnight에서 true로 설정.
	property boolean _ignoresHitImmune = false

	-- true면 이 개체가 "지쳐버린 기사"(Tired Knight)다 — Die()에서 일반 잡템 확률 드롭 대신
	-- tired_knight_seal을 100% 확정 지급한다(GameManager.GrantLootItemDrop). ep2_map3 각 존마다
	-- 1마리씩 등장(유저 지정 "존마다 1마리씩 무조건 스폰"). InitializeStatsAsTiredKnight에서 true로 설정.
	property boolean _isTiredKnight = false

	-- true면 이 개체가 ep2_map3 존4 "카페테리아 가마솥"(Cafeteria Cauldron)이다 — 구름(MapObject_17)이
	-- 걷히기 전까지는 _cauldronLocked=true로 TakeDamage 계열 전부를 무시한다(유저 지정: "구름이 있는
	-- 상태에서는 솥단지 눌리면 안됨(공격도 안됨)"). Die()에서 일반 잡템 대신 확률 포션(엘릭서5%/하얀35%/
	-- 빨강60%)을 지급하고 알파 페이드아웃으로 사라진다. Ep2Map3CauldronLogic이 초기화/잠금해제를 담당.
	property boolean _isCauldron = false

	property boolean _cauldronLocked = false

	-- true면 이 개체가 ep2_map4 MapObject_205 이스터에그(Ep2Map4CentaurLogic)로 스폰된 "검은 켄타우로스"
	-- 또는 "타락한 켄타우로스"다 — 둘 다 Die()에서 일반 잡템 드롭을 건너뛴다(유저 지정: "잡템은 나올필요없고").
	-- 타락한 켄타우로스만 별도로 _isCorruptedCentaur도 true가 되어 엘리트처럼(빨간포션+슬롯 스킬 1개) 확정
	-- 드롭을 받는다. InitializeStatsAsBlackCentaur/InitializeStatsAsCorruptedCentaur에서 설정.
	property boolean _isBlackCentaur = false

	property boolean _isCorruptedCentaur = false

	-- true면 원거리 공격을 하지 않는다(_neverAttacks와 별개로 UpdateFlying 비행형 분기에도 적용) +
	-- Die()에서 일반 잡템/카드 드롭 대신 _CardManager:OnYellowMiniBeanCaught로 스킬 1개를 지급한다
	-- (Ep2MiniBeanEasterEggLogic 전용 — 유저 지정: "노란미니빈은 공격은 안하고 잡으면 스킬 1개").
	property boolean _isYellowMiniBean = false

	-- 빙결 스택 (프리징 이펙트 패시브)
	@Sync
	property integer FreezeStack = 0

	property Entity _freezeIndicator = nil

	property boolean _freezeSlowed = false

	@Sync
	property integer ComboStack = 0

	-- 콤보어택 스택(레이온 기본공격 전용) — FreezeStack과 동일하게 "맞는 대상(몬스터)"에게 스택이
	-- 쌓이는 패턴(유저 지정: "캐릭터한테 스택이 쌓이는게 아니라 몬스터한테"). 최대 5스택, 5스택에서
	-- 자동으로 폭발 연출(코마 팩 finish/1~10 무작위, 유저 확인: "코마는 콤보를 터트리는 효과" — 이
	-- 용도로는 정확) 후 스택이 초기화된다.
	-- 오브 연출은 CardManager.ComboOrbRUID(6프레임 클립)를 스택 개수만큼 스폰해서 몬스터 주위를
	-- 시계방향으로 도는 것처럼 표현한다(유저가 실제 게임 스크린샷으로 확인: 슬롯 개수만큼 같은
	-- 오브가 원형으로 돈다). 슬롯 5개를 각각 프로퍼티로 들고(_comboOrb1~5), OnUpdate에서
	-- _comboOrbAngle을 누적해 위치를, _comboOrbReveal1~5를 누적해 프레임(자기 슬롯 번호까지
	-- 0→N 순서 재생 후 정지)을 매 프레임 갱신한다.
	property Entity _comboOrb1 = nil

	property Entity _comboOrb2 = nil

	property Entity _comboOrb3 = nil

	property Entity _comboOrb4 = nil

	property Entity _comboOrb5 = nil

	property number _comboOrbReveal1 = 0

	property number _comboOrbReveal2 = 0

	property number _comboOrbReveal3 = 0

	property number _comboOrbReveal4 = 0

	property number _comboOrbReveal5 = 0

	-- 프레임 1개당 재생 시간(초) — 오브가 생성돼서 자기 목표 프레임까지 세는 데 걸리는 시간
	property number ComboOrbFrameStepDuration = 0.08

	property number _comboOrbAngle = 0

	property number ComboOrbRadius = 0.45

	-- 실제 콤보어택 오브 리소스(44x44px, 작은 아이콘형)로 교체하면서 재조정한 배율(유저 지정:
	-- "지금의 1/2로")
	property number ComboOrbScaleMultiplier = 0.5

	-- 라디안/초. 양수 = 화면 기준 시계방향(각도가 커질수록 -sin 성분이 아래로 향하게 좌표식을 짬)
	property number ComboOrbRotateSpeed = 3.0

	-- 스턴(감전) 중 머리 위에 뺑글뻉글 도는 별 이펙트
	property Entity _stunStarsIndicator = nil

	-- 2026-08-05(유저 지정): 스폰되는 일반 몬스터 중 일부를 "작은 개체"(크기 2/3, 체력 20% 낮음)로 만든다.
	-- MarkElite와 동일하게 InitializeStats 직후(스폰 시점)에 한 번 호출되는 post-hoc 보정 — 덮어쓰지 않고
	-- 곱해서 보스/엘리트 배율과 함께 적용돼도 자연스럽게 누적되게 한다.
	-- 2026-08-05(2차, 유저 지정): 작은 개체는 접근 속도(ApproachSpeed, ="이동속도" — 이 게임은 실제 이동이
	-- 아니라 스케일 증가로 접근을 표현)도 기준(1.0) 대비 +0.3 더 빠르게(1.3배) 만든다. ApproachSpeed는
	-- InitializeStats에서 이미 웨이브별 값+분산까지 정해진 뒤이므로, 그 값에 곱해서 적용해야 웨이브 진행에
	-- 따라 커지는 기본 속도 위에도 비율이 그대로 유지된다.
	property number SmallVariantSpeedMultiplier = 1.3

	-- 성능 최적화(2026-08-24) — _spawnZoneIndex를 설정하는 모든 InitializeStats* 계열이 공통으로
	-- 거치는 지점. MonsterSpawner._zoneMonsterRegistry에 자신을 등록해서, MapManager/CardManager 등이
	-- "이 존의 몬스터만" O(그 존 크기)로 바로 조회할 수 있게 한다(예전엔 map:GetChildComponentsByTypeName로
	-- 맵 전체를 매번 훑었다 — container=nil 공유맵(map3/4)에서 몬스터 100마리 이상까지 실측, 맵이동 한 번에
	-- 1.3초까지 걸렸었다). 재초기화로 다시 불려도 레지스트리는 집합이라 중복 등록 걱정 없다. 짝은
	-- OnEndPlay의 UnregisterZoneMonster.
	method void SetSpawnZone(integer zoneIndex)
		self._spawnZoneIndex = zoneIndex
		_MonsterSpawner:RegisterZoneMonster(zoneIndex, self)
	end

	method void OnBeginPlay()
		if self:IsServer() then
			-- 스탯/외형 초기화는 MonsterSpawner가 스폰 직후 InitializeStats()를 명시적으로 호출해서 처리한다 —
			-- 존(zone)별 몬스터 풀을 고르려면 "이 몬스터가 어느 맵에서 스폰됐는지"가 필요한데
			-- OnBeginPlay는 그 정보를 모른다(스폰 파라미터로 전달받지 않는 한 알 수 없음).
			self._currentScale = 0.85
			self.Entity.TransformComponent.Scale = Vector3(0.85 * self._scaleMultiplier, 0.85 * self._scaleMultiplier, 1.0)
			self._depthTieBreak = _UtilLogic:RandomDouble() * 0.01
			self:GetDepthOverlayRenderer()
			self:UpdateDepth()
		else
			-- 클라이언트: MonsterSprite가 이미 초기 동기화되어 도착해 있을 수 있으므로(스폰 직후 등)
			-- OnSyncProperty의 "값 변경" 이벤트만 기다리지 않고 여기서 바로 적용한다.
			-- 맵 이동 직후처럼 동기화 타이밍이 애매한 경우, OnSyncProperty가 안 불려도
			-- 몬스터가 기본 플레이스홀더 스프라이트로 멈춰있지 않도록 하기 위함.
			local renderer = self.Entity.SpriteRendererComponent
			if renderer ~= nil then
				renderer.SpriteRUID = self.MonsterSprite
			end
			-- "길잃은 루돌프" 전용 터치 연결 — TouchReceiveComponent가 없는 일반 몬스터에서는
			-- TouchEvent가 애초에 발생하지 않으므로 이 연결은 무해하다(다른 500여종 몬스터엔 영향 없음).
			self._touchHandler = self.Entity:ConnectEvent(TouchEvent, self.OnLostRudolphClientTouched)
		end
	end

	-- MonsterSpawner가 스폰 직후 호출: zoneIndex(1~3=기존 웨이브 풀, 4~6=신규 몬스터 풀)에 맞춰
	-- 스탯(HP/접근속도)과 외형(스프라이트 RUID)을 초기화한다. HP/접근속도는 존과 무관하게 항상
	-- 웨이브 공식을 따르고, 외형만 존별 규칙으로 고른다.
	-- forcedSpeciesIdx: 맵 전용 풀(zoneIndex>=7)에서 스폰 위치 결정과 같은 종을 쓰기 위해
	-- MonsterSpawner가 미리 뽑아서 넘겨주는 값. 0 이하면 기존처럼 여기서 무작위로 고른다.
	@ExecSpace("ServerOnly")
	method void InitializeStats(integer zoneIndex, integer wave, boolean isBoss, integer forcedSpeciesIdx)
		-- 방금 막 스폰된 몬스터는 절대 죽어있을 수 없다 — 그런데도 스폰 직후 이 값이 이미 true로
		-- 관측되는 경우가 실측 확인됐다(같은 틱에 다른 몬스터가 죽은 직후 엔티티 재사용 시 이전
		-- 점유자의 _dead가 새 스폰에 남아있는 것으로 추정). 남아있으면 얼음 파편처럼 "방금 스폰된
		-- 몬스터"를 신뢰하는 로직이 조용히 무력화되므로, 초기화 맨 앞에서 명시적으로 되돌린다.
		self._dead = false
		self:SetSpawnZone(zoneIndex)
		self._isBoss = isBoss
		self._reachedScaleThreshold = 1.5
		-- 2026-08-03 3차 재설계: 체력은 화력 비례 방식을 버리고 순수 시간 "단계" 기반으로 되돌린다
		-- (GameManager.GetTimeStep/GetTimeStepHp) — 3분까지는 강해지지 않고, 그 뒤로 5분마다 한
		-- 계단씩만 오른다. 보스는 그 값에 BossHpMultiplier를 곱한다.
		local hp
		if isBoss then
			hp = _GameManager:GetTimeStepHp(_GameManager:GetTimeStep()) * _GameManager.BossHpMultiplier
		else
			hp = _GameManager:GetTimeStepHp(_GameManager:GetTimeStep())
		end
		self.MaxHp = hp
		self.CurrentHp = hp
		if isBoss then
			-- 보스는 항상 느린 접근(15초 교전창)을 유지한다 — GetWaveApproachSpeed는 wave==10일 때만
			-- 특수값을 반환하므로, 실제 wave 값과 무관하게 리터럴 10을 넘겨 그 분기를 그대로 재사용한다.
			self.ApproachSpeed = _GameManager:GetWaveApproachSpeed(10)
		else
			self.ApproachSpeed = _GameManager:GetWaveApproachSpeed(wave)
		end
		-- 유물 에오스의 돌(6번) — 적 이동속도 감소. 스폰 시 한 번만 곱해두면 이후 접근 로직이
		-- 전부 이 값을 쓰므로 매 프레임 계산할 필요가 없다(스턴/슬로우는 별도로 또 곱해진다).
		self.ApproachSpeed = self.ApproachSpeed * (1.0 - _RelicInventory:GetEnemySlowRatio())

		-- 보스는 속도 분산 없이 일정하게 접근 + 임팩트를 위해 비주얼 스케일 2.5배(기존 5배가 너무 커서 50% 축소)
		-- (엘리트와 곱연산으로 같이 적용됨)
		if not isBoss then
			local variance = (_UtilLogic:RandomDouble() * 2 - 1) * self.ApproachSpeedVariance
			self.ApproachSpeed = self.ApproachSpeed + variance
			-- 유저 요청으로 "일반(엘리트/보스가 아닌) 몬스터는 웨이브가 올라가도 크기를 키우지 않는다" —
			-- 예전엔 여기서 웨이브10 이후 무한 웨이브 동안 일반 몬스터도 체력처럼 크기가 완만하게
			-- 커지게(최대 ×1.6) 했었는데, 그 성장이 엘리트/보스 여부와 무관하게 전부 적용되다 보니
			-- 웨이브를 빠르게 건너뛰는 테스트에서 "일반 몬스터가 갑자기 커 보인다"는 혼란을 유발했다.
			-- 이제 일반 몬스터는 웨이브와 무관하게 항상 기본 크기(_scaleMultiplier=1.0)를 유지하고,
			-- 엘리트(MarkElite)/보스만 각자의 고정 배율로 커진다.
		else
			self._scaleMultiplier = self._scaleMultiplier * 2.5
		end
		
		if zoneIndex >= 7 then
			-- 맵7~9 전용 몬스터 풀: 맵마다 별도 구성(고스텀프/보어류 등)에서 무작위로 외형을 고른다.
			-- 맵10(보너스 스테이지)은 별도 풀이 없고 맵9 몬스터 풀을 그대로 재사용한다(평소 웨이브 폴백 시).
			local appearanceZone = zoneIndex
			if appearanceZone == 10 then appearanceZone = 9 end
			-- ep2_map2_hidden(존1~4=mapIndex85~88) — MonsterSpawner.ResolveAppearanceZone과 동일한
			-- 별칭 매핑을 여기도 복제한다(이 메서드는 그 헬퍼를 안 거치고 직접 계산하는 별도 경로라
			-- 짝을 맞춰야 함 — 안 맞추면 스폰 위치 판정과 실제 스탯/외형이 서로 다른 존 풀을 보게 됨).
			if appearanceZone == 85 then appearanceZone = 56
			elseif appearanceZone == 86 then appearanceZone = 61
			elseif appearanceZone == 87 then appearanceZone = 63
			elseif appearanceZone == 88 then appearanceZone = 60
			end
			local speciesIdx = forcedSpeciesIdx
			if speciesIdx <= 0 then
				speciesIdx = _UtilLogic:RandomIntegerRange(1, _GameManager:GetMapMonsterCount(appearanceZone))
			end
			self._speciesIdx = speciesIdx
			self._standRUID = _GameManager:GetMapStandRUID(appearanceZone, speciesIdx)
			self._moveRUID = _GameManager:GetMapMoveRUID(appearanceZone, speciesIdx)
			self._dieRUID = _GameManager:GetMapDieRUID(appearanceZone, speciesIdx)
			self._dieDuration = _GameManager:GetMapDieDuration(appearanceZone, speciesIdx)
			self._hitRUID = _GameManager:GetMapHitRUID(appearanceZone, speciesIdx)
			self._attackRUID = _GameManager:GetMapAttackRUID(appearanceZone, speciesIdx)
			self._attackDuration = _GameManager:GetMapAttackDuration(appearanceZone, speciesIdx)
			-- 원거리 히트 이펙트(네펜데스/다크네펜데스 전용, 유저 요청) — 빈 문자열이면 PlayRangedHitEffect가
			-- 자체적으로 아무것도 재생하지 않는다
			self._hitEffectRUID = _GameManager:GetMapHitEffectRUID(appearanceZone, speciesIdx)
			self._hitEffectDuration = _GameManager:GetMapHitEffectDuration(appearanceZone, speciesIdx)
			self._hitEffectMaxConcurrent = _GameManager:GetMapHitEffectMaxConcurrent(appearanceZone, speciesIdx)
			self._projectileRUID = _GameManager:GetMapProjectileRUID(appearanceZone, speciesIdx)
			self._hitEffectScaleMultiplier = _GameManager:GetMapHitEffectScaleMultiplier(appearanceZone, speciesIdx)
			self._hitEffectAlpha = _GameManager:GetMapHitEffectAlpha(appearanceZone, speciesIdx)
			-- 버그 수정(2026-08-27, 유저 리포트: "웨어울프나 라이칸이나 연출이 끝까지 나올때가 있고 그냥
			-- 안나올때가 있는거 같아") — 원래는 원거리 히트 이펙트가 있는 종만 attackDuration에 맞춰
			-- 공격 주기를 늘렸는데, 웨어울프/라이칸스로프(근접, 히트 이펙트 없음)는 attackDuration이
			-- 1.25초인데 기본 AttackInterval은 1.0초라 다음 공격이 이전 공격의 attack1 재생이 끝나기 전에
			-- 겹쳐 들어왔다. PlayAttackAnimation의 복귀 타이머는 "지금 스프라이트가 내가 세팅한 attackRUID와
			-- 같으면" 되돌리는 방식이라 새/구 타이머를 구분 못 해서, 겹치면 구(이전) 타이머가 새로 시작한
			-- attack1을 즉시 stand로 되돌리고 _isPlayingTransientSprite까지 꺼버려 그 순간 마침 도착한
			-- MonsterSprite 동기화가 다시 덮어쓸 수 있는 창이 열렸다 — "가끔은 끝까지 나오고 가끔은 아예
			-- 안 보인다"는 정확히 이 겹침 타이밍(공격 시점이 서로 얼마나 가까운가)에 좌우되는 증상과 일치.
			-- attackRUID가 있는 종은 전부(히트 이펙트 유무 무관) attackDuration이 기본 간격보다 길면
			-- 겹치지 않을 만큼 간격을 늘린다.
			if self._hitEffectRUID ~= "" or (self._attackRUID ~= "" and self._attackDuration > self.AttackInterval) then
				self._customAttackInterval = self._attackDuration + 0.7
			else
				self._customAttackInterval = 0
			end
			-- 존별 시각 크기 배율(그룹G 15% 축소 등) — 보스(×2.5)와 곱연산으로 같이 적용된다
			self._scaleMultiplier = self._scaleMultiplier * _GameManager:GetMapScaleMultiplier(appearanceZone, speciesIdx)
			self._isRangedInk = _GameManager:GetMapIsRanged(appearanceZone, speciesIdx)
			self._isRangedSlash = _GameManager:GetMapIsRangedSlash(appearanceZone, speciesIdx)
			if self._isRangedInk or self._isRangedSlash then
				self._reachedScaleThreshold = self.RangedReachedScale
			end
			-- 에피소드2 거대 네펜데스(고정형/공격안함) — 존 풀에 직접 배치된 경우에만 등장한다. 네펜데스/
			-- 다크네펜데스는 그냥 죽으면 끝 — 별도로 거대 네펜데스를 소환/변신시키지 않는다(유저 요청 최종 확정).
			self._neverAttacks = _GameManager:GetMapNeverAttacks(appearanceZone, speciesIdx)
			-- 에피소드2 종 전용 피격/사망 사운드(그 외 기존 존7+ 풀은 원래 사운드가 없어 빈 문자열 유지)
			self._hitSoundRUID = _GameManager:GetMapHitSoundRUID(appearanceZone, speciesIdx)
			self._dieSoundRUID = _GameManager:GetMapDieSoundRUID(appearanceZone, speciesIdx)
			-- 거대 네펜데스는 항상 1페이즈(패시브, 전용 외형)로 첫 등장한다 — 위에서 읽어온 존 풀 값들은
			-- 사실 2페이즈(부활 후) 외형이므로, 1페이즈 전용 값으로 즉시 덮어쓴다. 부활 시점에
			-- ReviveAsPhase2가 다시 2페이즈 값으로 되돌린다.
			self._isGiantNepenthes = _GameManager:GetMapIsGiantNepenthes(appearanceZone, speciesIdx)
			if self._isGiantNepenthes then
				self._giantNepenthesRevived = false
				self._standRUID = _GameManager.GiantNepenthesPhase1StandRUID
				self._dieRUID = _GameManager.GiantNepenthesPhase1DieRUID
				self._dieDuration = _GameManager.GiantNepenthesPhase1DieDuration
				self._dieSoundRUID = _GameManager.GiantNepenthesPhase1DieSoundRUID
				-- 1페이즈 리소스팩엔 hit1이 없다 — 피격 시 스프라이트/사운드 교체 없이 데미지 숫자만 뜬다
				self._hitRUID = ""
				self._hitSoundRUID = ""
			end
			-- 에피소드3 map2 예티/다크예티/예티와페페/다크예티와페페 전용 범용 2페이즈(유저 지정 —
			-- "거대 네펜데스처럼 페이즈가 나눠져있는 몬스터"). 존 풀 테이블(GetMap*RUID)이 그대로 1페이즈
			-- 외형이라 거대 네펜데스처럼 덮어쓸 필요 없이, hasPhase2 플래그와 부활 여부만 기록해둔다 —
			-- 실제 전환은 Die()에서 DieAndRevivePhase1Generic이 처리한다.
			-- 단, 주니어예티(라이트) 3슬롯(99/1, 100/2, 102/2) + 다크주니어예티 3슬롯(99/2, 101/1, 103/2)만은
			-- 예외다(유저 최종 지정, 2026-08-25 재재정정+다크 추가 요청 — "예티는 죽을때 바로죽거나 페이즈2로
			-- 넘어가 그확률이 50%... 스폰될때 정할꺼면 [페이즈없는 예티]/[페이즈있는 예티] 이거 쓰면 되고,
			-- 페이즈있는 예티는 die1이 변신 모션" + "다크 주니어 예티도 해줘야지"). 이 6슬롯은
			-- GetMapHasPhase2(확정형 종 전용)를 거치지 않고, 스폰 시점에 여기서 직접 50% 코인플립으로
			-- "페이즈있는"/"페이즈없는" 두 리소스팩 중 하나를 확정한다(라이트/다크는 GetMapIsJuniorYetiDark로
			-- 갈라서 각자의 RUID 세트를 쓴다) — 그래서 존 풀 테이블 값(위에서 이미 읽은 pack1=페이즈없는 값)을
			-- 덮어써야 한다. Die()에서는 더 이상 확률을 굴리지 않는다(_phase2Chance=1.0 고정 — 이미 스폰
			-- 시점에 확정됐으므로).
			if _GameManager:GetMapIsJuniorYetiPhase2Roll(appearanceZone, speciesIdx) then
				local isDarkJuniorYeti = _GameManager:GetMapIsJuniorYetiDark(appearanceZone, speciesIdx)
				self._hasPhase2 = _UtilLogic:RandomDouble() < 0.5
				self._phase2Chance = 1.0
				if self._hasPhase2 then
					self._phase2Revived = false
					if isDarkJuniorYeti then
						-- "페이즈있는 다크주니어예티" 팩 — die1(16프레임 실측=1.65초)이 변신 모션. 사운드는 effect.
						self._standRUID = "92b8be5ea1164ccf839ebfc3f76ecb46"
						self._moveRUID = "1e7b429eb65e497db96b0c70defbc971"
						self._hitRUID = "8cab9c536b5347e7b29c62310d9709df"
						self._dieRUID = "5c4af8b63f6d4bb981bd14257751e34c"
						self._dieDuration = 1.65
						self._hitSoundRUID = "19da3f9e06b948f49b8ad43647b3e73a"
						self._dieSoundRUID = "7b1c4562c6564cc5bbf7594f20c95260"
					else
						-- "페이즈있는 예티" 팩 — die1(16프레임 실측=1.65초) 자체가 변신 모션. 사운드는 effect.
						self._standRUID = "48399164e47a4c0ebf7b09332ffee38f"
						self._moveRUID = "6f11483b09a942f4b954e238f86e4d13"
						self._hitRUID = "59be70295ac0403ba16e0ed911920906"
						self._dieRUID = "f7ee11ac35cd4983b592d51cbabc0a55"
						self._dieDuration = 1.65
						self._hitSoundRUID = "a0f695a2323c43378124889d88ef1d1e"
						self._dieSoundRUID = "3f970229ffde4240b129112a59925f93"
					end
					-- 버그 수정(2026-08-25, 유저 리포트 "맵3,맵4에 공격 모션 빠진애들이 보이는데") — 주니어
					-- 예티/다크주니어예티 리소스팩(mob/5100000·5100001·5130105)엔 attack1 서브클립 자체가
					-- 없다(msw-search 실측 확인 — stand/move/hit1/die1/jump뿐). 개체마다 코인플립으로 결정된
					-- hit1을 그대로 "공격" 연출로 재사용한다(리소스가 없는 상태로 방치하면 도달 공격 때마다
					-- 스프라이트가 아예 안 바뀌어 "공격 모션이 빠짐"으로 보인다).
					self._attackRUID = self._hitRUID
				else
					if isDarkJuniorYeti then
						-- "페이즈없는 다크주니어예티" 팩 — die1(5프레임 실측=0.55초)은 진짜 사망. 사운드는 voice.
						self._standRUID = "ce56cf9613174f80976dab5b61f7b604"
						self._moveRUID = "8d2b8951794d406a86cc580e9eeff18d"
						self._hitRUID = "cbe070cdf1fa4611a3529f3d70296a33"
						self._dieRUID = "fad50a0e478c40fcbd383e069bc278da"
						self._dieDuration = 0.55
						self._hitSoundRUID = "f5b7e04a5ac6496cac77b016ea13a16f"
						self._dieSoundRUID = "53324cebb7744fe69b7c972568192375"
					else
						-- "페이즈없는 예티" 팩 — die1(5프레임 실측=0.55초)은 진짜 사망. 사운드는 voice.
						self._standRUID = "1975dd704eec461ab49bdeb0c11c54d9"
						self._moveRUID = "842a6865f7074f94ac4a190ed90e2e21"
						self._hitRUID = "63a1a5f280f04e55b935d6a2155edcef"
						self._dieRUID = "13b9f2b2f7664cc5a08e663f2fe0502b"
						self._dieDuration = 0.55
						self._hitSoundRUID = "6f4dcabb6d9941a38f84c1cc6b5cdad8"
						self._dieSoundRUID = "6f3ab281ca93458d9b122b8d5cbf60df"
					end
					-- "페이즈없는" 팩도 attack1이 없기는 마찬가지라 동일하게 hit1을 재사용한다.
					self._attackRUID = self._hitRUID
				end
			else
				self._hasPhase2 = _GameManager:GetMapHasPhase2(appearanceZone, speciesIdx)
				if self._hasPhase2 then
					self._phase2Revived = false
					self._phase2Chance = _GameManager:GetMapPhase2Chance(appearanceZone, speciesIdx)
				end
			end
			if self._neverAttacks then
				self._currentScale = self._reachedScaleThreshold
				self._reachedPlayer = true
			end
			self._isFlying = _GameManager:GetMapIsFlying(appearanceZone, speciesIdx)
			if self._isFlying then
				-- 접근 애니메이션 없이 스폰 즉시 고정 크기로 보이게 하고, 스폰 X를 중심으로 X/Y 동시
				-- 사인파 비행 시작 (개체별 위상/속도를 무작위로 달리해 여러 마리가 겹쳐 보이지 않게 함).
				-- UpdateFlying은 TransformComponent.Position(부모 기준 로컬)에 직접 쓰므로, 중심값도
				-- 반드시 로컬 Position 기준이어야 한다 — WorldPosition(존 오프셋 포함)을 쓰면 존14/15처럼
				-- 오프셋이 있는 존에서 오프셋이 두 번 겹쳐 적용돼 화면 밖으로 날아가 버린다(실측 확인 —
				-- 존15에서 박쥐가 안 보이던 원인이 바로 이것).
				self._currentScale = 1.0
				self._flyCenterX = self.Entity.TransformComponent.Position.x
				self._flyBaseY = (self.FlyingWanderMinY + self.FlyingWanderMaxY) * 0.5
				self._flyTime = 0
				self._flyPhaseX = _UtilLogic:RandomDouble() * math.pi * 2
				self._flyPhaseY = _UtilLogic:RandomDouble() * math.pi * 2
				self._flySpeedMultX = 0.8 + _UtilLogic:RandomDouble() * 0.4
				self._flySpeedMultY = 0.8 + _UtilLogic:RandomDouble() * 0.4
				self._attackTimer = self.FlyAttackInterval
			end
			-- 돌진형 종(맘무트/골든맘무트/트라고스) — 스폰 위치를 떨림 중심으로 저장하고 wind-up 타이머를 시작한다.
			-- 비행형과는 동시에 성립하지 않는다(현재 종 구성상 겹치지 않음).
			self._isCharge = _GameManager:GetMapIsCharge(appearanceZone, speciesIdx)
			if self._isCharge and not self._isFlying then
				self._chargeWindupTimer = _GameManager:GetMapChargeShakeDuration(appearanceZone, speciesIdx)
				self._chargeDashActive = false
				local chargePos = self.Entity.TransformComponent.Position
				self._chargeSpawnX = chargePos.x
				self._chargeSpawnY = chargePos.y
			else
				self._isCharge = false
			end
			-- 그룹I(존27~30, 닌자 컨셉) 지상형만 접근 중 좌우 지그재그 흔들림을 켠다 — 비행형(스티지)은
			-- 이미 자체 리사주 비행 궤적이 있어서 별도로 흔들 필요가 없다. 흔들림 중심은 스폰 시점의
			-- 로컬 X(발판 위 스폰 위치)로 고정하고, 개체마다 위상을 무작위로 달리해 겹쳐 보이지 않게 한다.
			-- 재규어(존32/존33 지상형=2번째 종)도 유저 요청으로 같은 지그재그를 얹는다 — 단, 잔상은
			-- 닌자 전용으로 남겨두고 재규어는 안 켠다(_hasZigzagAfterimage로 분리).
			-- 판정은 GameManager.GetMapIsZigzag(zoneIndex, speciesIdx)로 위임한다 — 닌자/재규어존은 존
			-- 전체가 대상이지만, 에피소드2 map2(존7~10)는 지그재그 종(루이넬류)과 그렇지 않은 종이 한 존에
			-- 섞여 있어 zoneIndex만으로는 구분할 수 없다(종 idx까지 같이 봐야 함).
			local isNinjaZone = appearanceZone >= 27 and appearanceZone <= 30
			if _GameManager:GetMapIsZigzag(appearanceZone, speciesIdx) and not self._isFlying then
				self._isZigzag = true
				self._zigzagBaseX = self.Entity.TransformComponent.Position.x
				self._zigzagTime = 0
				self._zigzagPhase = _UtilLogic:RandomDouble() * math.pi * 2
				-- 스폰된 발판의 실제 폭 안으로 진폭을 클램프한다 — 좁은 발판에서 기본 진폭(0.5)이 타일
				-- 경계를 넘어가는 것을 막는다. EdgeMarginAerial(0.15)과 동일한 여유를 양쪽에 둔다.
				self._zigzagAmplitudeActual = self.ZigzagAmplitude
				local worldPos = self.Entity.TransformComponent.WorldPosition
				-- 버그 수정(2026-08-24, ep2_map2_hidden 별칭 도입 중 발견) — 여기는 반드시 appearanceZone이
				-- 아니라 zoneIndex(실제 물리 존)를 넘겨야 한다. GetContainingRunBounds는 mapIndex로
				-- _MapManager:GetMapName(mapIndex)를 거쳐 그 "파일"의 FootholdComponent를 조회하는데,
				-- appearanceZone은 외형/스탯 참조용 별칭 존(예: 존86→61)이라 물리적으로 다른 맵 파일이다 —
				-- 실측 확인: ep2_map2_hidden 존86(별칭 61=ep2_map2)에서 이 값을 그대로 쓰면 엔티티는
				-- ep2_map2_hidden에 있는데 발판은 ep2_map2 것을 찾아 좌표가 어긋나 "NO RUN FOUND"로
				-- 조용히 실패(클램프 없이 기본 진폭 0.5 그대로)했다. zoneIndex를 쓰면 항상 엔티티가 실제로
				-- 서 있는 그 맵의 발판을 정확히 찾는다(별칭이 없는 기존 존들은 zoneIndex==appearanceZone이라
				-- 동작 변화 없음).
				local bounds = _MonsterSpawner:GetContainingRunBounds(zoneIndex, worldPos.x, worldPos.y)
				if bounds ~= nil then
					local safeHalfWidth = math.min(worldPos.x - bounds.xMin, bounds.xMax - worldPos.x) - 0.15
					self._zigzagAmplitudeActual = math.max(0, math.min(self.ZigzagAmplitude, safeHalfWidth))
					log("MonsterAI: Zigzag zone=" .. zoneIndex .. " idx=" .. speciesIdx .. " worldX=" .. string.format("%.2f", worldPos.x) .. " worldY=" .. string.format("%.2f", worldPos.y) .. " runXMin=" .. string.format("%.2f", bounds.xMin) .. " runXMax=" .. string.format("%.2f", bounds.xMax) .. " amplitude=" .. string.format("%.2f", self._zigzagAmplitudeActual))
				else
					log("MonsterAI: Zigzag zone=" .. zoneIndex .. " idx=" .. speciesIdx .. " worldX=" .. string.format("%.2f", worldPos.x) .. " worldY=" .. string.format("%.2f", worldPos.y) .. " NO RUN FOUND, amplitude=" .. string.format("%.2f", self._zigzagAmplitudeActual))
				end
				if isNinjaZone then
					self._hasZigzagAfterimage = true
					self._afterimageTimer = self.AfterimageInterval
				end
			end
		elseif zoneIndex >= 4 then
			-- 맵4~6 전용 몬스터 풀: 스폰마다 1~4 중 무작위로 외형을 고른다 (보스도 이 풀에서 고름 — 별도 존 보스는 없음)
			local speciesIdx = _UtilLogic:RandomIntegerRange(1, _GameManager:GetZoneMonsterCount())
			self._speciesIdx = speciesIdx
			self._standRUID = _GameManager:GetZoneStandRUID(speciesIdx)
			self._moveRUID = _GameManager:GetZoneMoveRUID(speciesIdx)
			self._dieRUID = _GameManager:GetZoneDieRUID(speciesIdx)
			self._dieDuration = _GameManager:GetZoneDieDuration(speciesIdx)
			self._hitRUID = _GameManager:GetZoneHitRUID(speciesIdx)
			self._attackRUID = ""
		else
			-- 맵1~3: 웨이브1~9는 웨이브 번호 = 종 인덱스(기존과 동일), 보스는 항상 리본돼지(species=10)
			-- 고정(2026-08-03: 보스가 시간 기반으로 바뀌면서 wave가 더 이상 10이 아닐 수 있어 isBoss로
			-- 직접 판정), 그 외(11부터)는 지금까지 나온 1~9 종 중 무작위로 섞어서 계속 등장시킨다
			local speciesIdx = wave
			if isBoss then
				speciesIdx = 10
			elseif wave > 10 then
				speciesIdx = _UtilLogic:RandomIntegerRange(1, 9)
			end
			self._speciesIdx = speciesIdx
			self._standRUID = _GameManager:GetWaveStandRUID(speciesIdx)
			self._moveRUID = _GameManager:GetWaveMoveRUID(speciesIdx)
			self._dieRUID = _GameManager:GetWaveDieRUID(speciesIdx)
			self._dieDuration = _GameManager:GetWaveDieDuration(speciesIdx)
			self._hitRUID = _GameManager:GetWaveHitRUID(speciesIdx)
			self._attackRUID = _GameManager:GetWaveAttackRUID(speciesIdx)
		end
		
		-- 접근 중엔 move, 이미 도달(_reachedPlayer)했거나 애초에 move 연출이 없는 종(빈 문자열 — 공중형은
		-- 항상 여기 해당)은 stand로 시작한다. OnUpdate가 도달하는 순간 다시 stand로 갈아끼운다.
		if not self._isFlying and self._moveRUID ~= "" then
			self.MonsterSprite = self._moveRUID
		else
			self.MonsterSprite = self._standRUID
		end
		
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:UpdateDepth()
		if self._isFlying then
			-- 비행형은 스폰 즉시 고정 크기로 "도달"해 있는 상태라 UpdateDepth의 점진적 페이드가 의미가 없다 — 꺼둔다
			self:HideDepthOverlay()
		end
		-- 얼음 파편 효과가 지속되는 도중에 스폰된 몬스터도 즉시 얼려야 한다(유저 지적 — 발동 시점에
		-- 이미 있던 몬스터만 얼리면, 그 뒤로 계속 스폰되는 몬스터는 안 얼어서 "몬스터가 계속 움직인다"는
		-- 것처럼 보인다). 남은 시간(_globalFreezeRemaining)만큼만 걸어서 원래 종료 시점과 맞춘다.
		if _GameManager._globalFreezeActive and _GameManager._globalFreezeRemaining > 0 then
			self:ApplyHardFreeze(_GameManager._globalFreezeRemaining)
		end
		log("MonsterAI: Zone=" .. zoneIndex .. " Wave=" .. wave .. " HP=" .. self.CurrentHp .. " Speed=" .. self.ApproachSpeed)
	end

	-- ep2_map3 "지쳐버린 기사"(Tired Knight) 전용 초기화 — InitializeAlienInvader와 동일하게 존 몬스터
	-- 풀 시스템(InitializeStats)을 거치지 않고 고정된 전용 리소스팩으로 직접 초기화한다(유저 지정 리소스팩,
	-- 2026-08-22). MonsterSpawner가 존마다 1마리씩 우선 스폰할 때, 그리고 MapObject_67 드래그 트리거가
	-- 존1에서 호출한다.
	-- 체력=일반 몬스터의 3배, 공격력=1배(dmgMultiplier 관여 없음, OnReachPlayer 기본값 그대로),
	-- 크기=1.3배(_scaleMultiplier), 피격 무적 프레임 무시(_ignoresHitImmune — OnReachPlayer 참고),
	-- 처치 시 tired_knight_seal 100% 확정 드롭(_isTiredKnight — Die() 참고).
	-- attackDuration/dieDuration은 attack1(5프레임)/die1 클립의 정확한 실측값이 아니라, 다른 종의 프레임수별
	-- 실측 패턴(GetMapAttackDuration/GetMapDieDuration 주석 참고 — 대략 0.1초/프레임)에 맞춘 추정치다.
	@ExecSpace("ServerOnly")
	method void InitializeStatsAsTiredKnight(integer zoneIndex)
		self._dead = false
		self:SetSpawnZone(zoneIndex)
		self._isBoss = false
		self._isElite = false
		self._isTiredKnight = true
		self._ignoresHitImmune = true
		self._reachedScaleThreshold = 1.5
		
		self.MaxHp = _GameManager:GetTimeStepHp(_GameManager:GetTimeStep()) * 3
		self.CurrentHp = self.MaxHp
		-- 보스와 동일하게 느리고 일정한 접근(변동폭 없이) — 유저 지정 없음, 일반 잡몹과 구분되는 "특별한
		-- 강적" 정체성에 맞춰 안정적으로 다가오게 한다.
		self.ApproachSpeed = _GameManager:GetWaveApproachSpeed(10)
		
		-- 전용 리소스팩(유저 제공 RUID, resource_pack "지쳐버린 기사")
		self._standRUID = "8e4d16ddd74644d8bfafaf422a1f7400"
		self._moveRUID = "009463a95c1f47d8a0c62e2507ff1799"
		self._attackRUID = "ac8d9def0432409eabc96f14c268c8ad"
		self._dieRUID = "5915fd536a8c417693933725d2858118"
		self._hitRUID = "380100b9447542e8a11559ea18d5a5b8"
		self._attackSoundRUID = "5095fddab73842a5af4750a178e4c98d"
		self._hitSoundRUID = "972a7ccd15234882acd9face6fd52d93"
		self._dieSoundRUID = "437dd7114fac4758a1d4195cd541853c"
		self._attackDuration = 0.55
		self._dieDuration = 0.45
		
		-- 재사용 엔티티에 이전 점유자의 특수 플래그가 남아있을 수 있어(위쪽 InitializeStats 주석 참고)
		-- 명시적으로 초기화한다 — 지쳐버린 기사는 평범한 지상형 근접 공격 개체다.
		self._isFlying = false
		self._isRangedInk = false
		self._isRangedSlash = false
		self._isCharge = false
		self._isZigzag = false
		self._neverAttacks = false
		self._isGiantNepenthes = false
		self._hasPhase2 = false
		self._phase2Chance = 1.0
		self._isSwarmMember = false
		self._isYellowMiniBean = false
		self._hitEffectRUID = ""
		self._hitEffectMaxConcurrent = 1
		self._customAttackInterval = 0
		self._accuracyDebuffPercent = 0
		self.FreezeStack = 0
		
		self._scaleMultiplier = 1.3
		self.MonsterSprite = self._moveRUID
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:UpdateDepth()
		if _GameManager._globalFreezeActive and _GameManager._globalFreezeRemaining > 0 then
			self:ApplyHardFreeze(_GameManager._globalFreezeRemaining)
		end
		log("MonsterAI: TiredKnight initialized Zone=" .. zoneIndex .. " HP=" .. self.CurrentHp)
	end

	-- Ep2Map3CauldronLogic.SpawnCauldron()이 스폰 직후 호출: ep2_map3 존4에 고정 배치되는 "카페테리아
	-- 가마솥" 전용 초기화. InitializeTreasureChest(보물상자)와 동일한 패턴 — 이동/공격 리소스가 없는
	-- (stand/hit1/die1만 있는) 완전 고정형 오브젝트라 접근 애니메이션 없이 처음부터 "도달" 상태로
	-- 등장하고 _neverAttacks=true로 플레이어를 절대 공격하지 않는다. 구름(MapObject_17)이 걷히기
	-- 전까지는 _cauldronLocked=true로 모든 피격을 무시한다(Ep2Map3CauldronLogic이 구름 클리어 시 해제).
	-- HP는 유저가 별도 수치를 지정하지 않아 일반 몬스터와 동일한 시간대 기준값(GetTimeStepHp)을 쓴다.
	@ExecSpace("ServerOnly")
	method void InitializeStatsAsCauldron(integer zoneIndex)
		self._dead = false
		self:SetSpawnZone(zoneIndex)
		self._isBoss = false
		self._isElite = false
		self._isCauldron = true
		self._cauldronLocked = true
		self._neverAttacks = true
		self._reachedScaleThreshold = 1.5
		
		self.MaxHp = _GameManager:GetTimeStepHp(_GameManager:GetTimeStep())
		self.CurrentHp = self.MaxHp
		self.ApproachSpeed = 0
		
		-- 전용 리소스팩(유저 제공 RUID, resource_pack "Cafeteria Cauldron") — move/attack 없음
		self._standRUID = "07fda3686b304900bdea6d71e01618d7"
		self._hitRUID = "c2bd674886f6462fbc94de108fa4883b"
		self._dieRUID = "923f98f630cb4a89a144cd5b6bf1c883"
		self._moveRUID = ""
		self._attackRUID = ""
		self._hitSoundRUID = "4cfc46ecd21c4c3382f4dcf470047d29"
		self._dieSoundRUID = "d3652d96e0664d989c3f988f4e5ff7c3"
		self._attackSoundRUID = ""
		-- 프레임 수 정보가 없어 다른 소형 오브젝트 사망연출과 비슷한 수준으로 추정(실측 아님)
		self._dieDuration = 0.35
		
		self._isFlying = false
		self._isRangedInk = false
		self._isRangedSlash = false
		self._isCharge = false
		self._isZigzag = false
		self._isGiantNepenthes = false
		self._hasPhase2 = false
		self._phase2Chance = 1.0
		self._isSwarmMember = false
		self._isYellowMiniBean = false
		self._hitEffectRUID = ""
		self._hitEffectMaxConcurrent = 1
		self._customAttackInterval = 0
		self._accuracyDebuffPercent = 0
		self.FreezeStack = 0
		
		-- InitializeTreasureChest와 동일 — 접근 연출 없이 처음부터 "도달" 상태로 고정, 실제 공격 호출만
		-- _neverAttacks로 막는다
		-- 유저가 CauldronPreview(ep2_map3, 실제 스프라이트 미리보기)를 드래그로 크기 조정한 결과값
		-- (절대 Scale 0.74574697) ÷ _reachedScaleThreshold(1.5) = 이 배율.
		self._scaleMultiplier = 0.497164647
		self._currentScale = self._reachedScaleThreshold
		self._reachedPlayer = true
		
		self.MonsterSprite = self._standRUID
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:HideDepthOverlay()
		if _GameManager._globalFreezeActive and _GameManager._globalFreezeRemaining > 0 then
			self:ApplyHardFreeze(_GameManager._globalFreezeRemaining)
		end
		log("MonsterAI: Cauldron initialized Zone=" .. zoneIndex .. " HP=" .. self.CurrentHp)
	end

	-- Ep1Zone2ManoLogic.SpawnMano()가 스폰 직후 호출 — 존2 trap-44를 누르면 나오는 "마노"(유저 제공
	-- 리소스팩). 미니무르 계열(_isMiniMoore)과 달리 "잡을 수 있는" 몬스터다 — 타격을 정상적으로
	-- 받고 HP가 0이 되면 Die()를 타며, 그때 Ep1Zone2ManoLogic이 보상을 준다(_isMano 플래그로 식별).
	--  · HP는 시간대 기준값이 아니라 유저 지정 고정값 1000(ManoFixedHp)
	--  · _neverAttacks=true — 플레이어를 절대 공격하지 않는다(가마솥과 동일 정책)
	--  · 지상에서 좌우로 배회하다 플레이어 쪽으로 접근한다(일반 몬스터의 접근 이동을 그대로 쓰되
	--    공격만 막는 형태 — 10초 안에 잡아야 해서 사거리 안으로 들어와줘야 한다)
	--  · 10초(ManoLifetime) 안에 못 잡으면 스스로 사라진다(EndManoLife)
	@ExecSpace("ServerOnly")
	method void InitializeStatsAsMano(integer zoneIndex, number spawnX, number groundY)
		self._dead = false
		self:SetSpawnZone(zoneIndex)
		self._isBoss = false
		self._isElite = false
		self._isMano = true
		self._neverAttacks = true

		self.MaxHp = self.ManoFixedHp
		self.CurrentHp = self.MaxHp

		-- 유저 제공 리소스팩 "마노" — hit1/die1/move/stand + 사운드. skill1은 공격을 안 하므로 쓰지 않는다
		self._standRUID = "e035bb90c053401b88de2159dfa230eb"
		self._moveRUID = "3dcd0dc63d2d491b9b8d39b3b9d0a214"
		self._hitRUID = "452cb740ddcb4837a46b75d7935e2ffc"
		self._dieRUID = "f430051f6fc34f2eb56fe5e62b346eac"
		self._attackRUID = ""
		self._hitSoundRUID = "6de4a479bd344a3688d8c28a8b46c0f2"
		self._dieSoundRUID = "ba4aab7d12af410ea2cc7e3fbc97ec54"
		self._attackSoundRUID = ""
		-- 프레임 수 정보가 없어 다른 소형 몬스터 사망연출과 같은 값으로 둔다(실측 아님)
		self._dieDuration = 0.35

		self._isFlying = false
		self._isRangedInk = false
		self._isRangedSlash = false
		self._isCharge = false
		self._isZigzag = false
		self._isGiantNepenthes = false
		self._hasPhase2 = false
		self._phase2Chance = 0
		self._isSwarmMember = false
		self._isYellowMiniBean = false
		self._hitEffectRUID = ""
		self._hitEffectMaxConcurrent = 1
		self._customAttackInterval = 0
		self._accuracyDebuffPercent = 0
		self.FreezeStack = 0

		self._currentScale = 1.0
		self.MonsterSprite = self._standRUID
		self.Entity.TransformComponent.Position = Vector3(spawnX, groundY, 0)
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:HideDepthOverlay()
		if _GameManager._globalFreezeActive and _GameManager._globalFreezeRemaining > 0 then
			self:ApplyHardFreeze(_GameManager._globalFreezeRemaining)
		end

		self._manoLifeTimerId = _TimerService:SetTimerOnce(self.EndManoLife, self.ManoLifetime)
		log("MonsterAI: Mano initialized Zone=" .. zoneIndex .. " HP=" .. self.CurrentHp)
	end

	-- ManoLifetime이 지날 때까지 못 잡으면 호출 — 보상 없이 조용히 사라진다.
	-- 이미 죽었으면(_dead) 아무것도 하지 않는다 — 처치 보상은 Die() 쪽에서 이미 나갔다.
	@ExecSpace("ServerOnly")
	method void EndManoLife()
		self._manoLifeTimerId = 0
		if self._dead then return end
		if not isvalid(self.Entity) then return end
		log("MonsterAI: Mano despawned (not killed in time)")
		self:PlayDespawnJump()
	end

	-- Ep2Map4CentaurLogic.SpawnCentaurHorde()가 스폰 직후 호출 — ep2_map4 MapObject_205를 2번 클릭하면
	-- 등장하는 무리 중 "검은 켄타우로스"(9마리, 유저 지정: 크기 0.8, 체력은 그 시점 일반 몬스터와 동일).
	-- 전용 리소스팩(msw-search로 확인, resource_pack "mob/8140101.img" — "검은 켄타우로스").
	@ExecSpace("ServerOnly")
	method void InitializeStatsAsBlackCentaur(integer zoneIndex)
		self._dead = false
		self:SetSpawnZone(zoneIndex)
		self._isBoss = false
		self._isElite = false
		self._isBlackCentaur = true
		self._reachedScaleThreshold = 1.5
		
		self.MaxHp = _GameManager:GetTimeStepHp(_GameManager:GetTimeStep())
		self.CurrentHp = self.MaxHp
		self.ApproachSpeed = _GameManager:GetWaveApproachSpeed(_GameManager.Wave)
		
		self._standRUID = "cbb6bd77341b4dceb4c88e70cf524740"
		self._moveRUID = "83c104143ccd4550bd61d180ea70c369"
		self._attackRUID = "bff36d5a39404119a6f8160653fd745a"
		self._dieRUID = "433a8737e1044f21ab6db90ae7864ffc"
		self._hitRUID = "4b2f616d2fe640bab7335c33cf535d3f"
		self._attackSoundRUID = "3c987a84b45a42e9b01d5a5b5404ee66"
		self._hitSoundRUID = "fa7114a0b24b473ba32b1b98aa761606"
		self._dieSoundRUID = "775705f8cc904686a64ed763b93af841"
		-- 프레임 수 실측 없이 일반 지상형 몬스터 관례값 사용(라이브 확인 후 조정 가능)
		self._attackDuration = 0.55
		self._dieDuration = 0.45
		
		self._isFlying = false
		self._isRangedInk = false
		self._isRangedSlash = false
		self._isCharge = false
		self._isZigzag = false
		self._neverAttacks = false
		self._isGiantNepenthes = false
		self._hasPhase2 = false
		self._phase2Chance = 1.0
		self._isSwarmMember = false
		self._isYellowMiniBean = false
		self._hitEffectRUID = ""
		self._hitEffectMaxConcurrent = 1
		self._customAttackInterval = 0
		self._accuracyDebuffPercent = 0
		self.FreezeStack = 0
		
		self._scaleMultiplier = 0.8
		self.MonsterSprite = self._moveRUID
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:UpdateDepth()
		if _GameManager._globalFreezeActive and _GameManager._globalFreezeRemaining > 0 then
			self:ApplyHardFreeze(_GameManager._globalFreezeRemaining)
		end
		log("MonsterAI: BlackCentaur initialized Zone=" .. zoneIndex .. " HP=" .. self.CurrentHp)
	end

	-- Ep2Map4CentaurLogic.SpawnCentaurHorde()가 스폰 직후 호출 — 무리의 우두머리 "타락한 켄타우로스"
	-- (1마리, 유저 지정: 체력=그 시점 일반 몬스터의 2배, 크기 1.2). 처치 시 엘리트와 동일하게 확정
	-- 드롭(빨간 포션 + 슬롯 스킬 1개, CardManager.OnCorruptedCentaurKilled 참고)을 받는다. 전용 리소스팩
	-- (msw-search로 확인, resource_pack "mob/8220019.img" — "타락한 켄타우로스").
	@ExecSpace("ServerOnly")
	method void InitializeStatsAsCorruptedCentaur(integer zoneIndex)
		self._dead = false
		self:SetSpawnZone(zoneIndex)
		self._isBoss = false
		self._isElite = false
		self._isCorruptedCentaur = true
		self._reachedScaleThreshold = 1.5
		
		self.MaxHp = _GameManager:GetTimeStepHp(_GameManager:GetTimeStep()) * 2.0
		self.CurrentHp = self.MaxHp
		self.ApproachSpeed = _GameManager:GetWaveApproachSpeed(_GameManager.Wave)
		
		self._standRUID = "d5b65bd56bcd4f85a87a8ca123abe32f"
		self._moveRUID = "06a3223907a14b64b9e8990c8a30bf72"
		self._attackRUID = "fd9aa2adc8ed47989304af6904d24ccb"
		self._dieRUID = "fcdccdc2a9c04eecaa97f6bf1ebdc0ae"
		self._hitRUID = "6c48dbfea7c542b98309f8e51fe877d1"
		self._attackSoundRUID = "2375c66fa3364e2f9b182c9b7a37ff87"
		self._hitSoundRUID = "700e833db5c245b0bd9100170b071bec"
		self._dieSoundRUID = "9e8683b5c8e84d0485e2053b63d7711b"
		self._attackDuration = 0.55
		self._dieDuration = 0.45
		
		self._isFlying = false
		self._isRangedInk = false
		self._isRangedSlash = false
		self._isCharge = false
		self._isZigzag = false
		self._neverAttacks = false
		self._isGiantNepenthes = false
		self._hasPhase2 = false
		self._phase2Chance = 1.0
		self._isSwarmMember = false
		self._isYellowMiniBean = false
		self._hitEffectRUID = ""
		self._hitEffectMaxConcurrent = 1
		self._customAttackInterval = 0
		self._accuracyDebuffPercent = 0
		self.FreezeStack = 0
		
		self._scaleMultiplier = 1.2
		self.MonsterSprite = self._moveRUID
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:UpdateDepth()
		if _GameManager._globalFreezeActive and _GameManager._globalFreezeRemaining > 0 then
			self:ApplyHardFreeze(_GameManager._globalFreezeRemaining)
		end
		log("MonsterAI: CorruptedCentaur initialized Zone=" .. zoneIndex .. " HP=" .. self.CurrentHp)
	end

	-- MonsterSpawner.SpawnBonusBoss()가 스폰 직후 호출: 배회 범위/스프라이트를 설정하고 무적·보상형 보스로 전환한다.
	-- MonsterSprite를 명시적으로 세팅해야 한다 — 안 그러면 OnBeginPlay의 클라이언트 분기가 빈 문자열을
	-- SpriteRUID에 덮어써서(기본값 "") 모델에 박아둔 스프라이트가 순간적으로 사라져 보일 수 있다.
	-- 버그 수정(2026-08-24, 유저 리포트 "발록 스테이지인데 다른 존 몹들을 공격함") — 다른 모든
	-- InitializeStats* 계열은 SetSpawnZone()으로 존별 레지스트리(_zoneMonsterRegistry)에 등록되는데,
	-- 이 메서드만 그걸 빠뜨리고 있었다. 그 결과 (1) MonsterSpawner.OnUpdate의 "존이 비었나" 응급 스폰
	-- 판정이 레지스트리 기준으로 존10을 계속 "0마리"로 오판해 무적 보스가 떠 있는 동안에도 2초마다
	-- 계속 일반 웨이브 몬스터(맵9 풀)를 존10에 밀어넣었고(SpawnWave 쪽 "_bonusBossActive면 존10 스킵"
	-- 가드는 이 응급 스폰 경로엔 없었다), (2) CardManager.GetMonstersInCurrentZone도 이제 이 레지스트리만
	-- 보고 판정하므로 보스 자신은 스킬 타겟 후보에서 아예 빠져, 플레이어가 겨냥한 공격이 방금 잘못
	-- 끼어든 그 일반 몬스터들한테 맞는 것으로 보였다. SetSpawnZone(10)으로 등록해서 둘 다 해결한다.
	-- 유저 지정(2026-09-01): 크기 20% 축소(1.3→1.04). 스프라이트 리소스가 sprite 타입이 아니라
	-- LoadSpriteAndWait로 Pivot 실측이 불가능해서(LEA-3015 CannotLoad), 살짝 공중에 떠 보인다는
	-- 리포트에 맞춰 지면 방향(-)으로 넛지 값을 하나 둔다 — 다른 여러 몬스터의 착지 넛지 사례와
	-- 동일하게 정확한 값은 실측 불가라 우선 추정치로 시작, 라이브에서 눈으로 보고 조정 필요.
	property number BonusBossYOffset = -0.15

	@ExecSpace("ServerOnly")
	method void InitializeBonusBoss(number minX, number maxX, number groundY, string spriteRUID)
		self:SetSpawnZone(10)
		self._isBonusBoss = true
		-- 유저 지정: 타이머가 보이기 시작하기 전까진 완전히 공격 불가 — 소유측(MonsterSpawner)이
		-- 지연 후 타이머를 실제로 띄우는 시점에 false로 풀어준다.
		self._bonusBossCombatLocked = true
		self._wanderMinX = minX
		self._wanderMaxX = maxX
		-- _wanderY는 매 프레임 배회 로직이 Y를 다시 여기로 맞추므로(실측 확인 — Position에만 오프셋을
		-- 줬더니 다음 틱에 원래 groundY로 되돌아갔다), 넛지 오프셋을 여기에 반영해야 계속 유지된다.
		self._wanderY = groundY + self.BonusBossYOffset
		self.MonsterSprite = spriteRUID
		self._currentScale = 1.04
		self.Entity.TransformComponent.Position = Vector3(0, self._wanderY, 0)
		self.Entity.TransformComponent.Scale = Vector3(1.04, 1.04, 1.0)
		self:SyncDepthOverlaySprite()
		self:HideDepthOverlay()
		self:PickNewWanderTarget()
		log("MonsterAI: bonus boss initialized, _spawnZoneIndex=" .. self._spawnZoneIndex)
	end

	-- Ep3Map2BonusBossLogic 전용 — 위 InitializeBonusBoss(맵10 고정, 단일 정지 스프라이트)와 달리
	-- 걷기/피격/사망 애니메이션이 각각 따로 있는 리소스팩("사랑에 빠진 커플예티" 등)을 쓴다.
	-- _isBonusBoss=true로 히트당 보상(OnBonusBossHit)은 그대로 재사용하되, zoneIndex는 이 보스가
	-- 물리적으로 서 있는 존이 아니라 "플레이어가 입장 직전에 있던 실제 존"을 넘긴다 — CardManager.
	-- GetMonstersInCurrentZone이 _MapManager.CurrentMapIndex(고정 아레나는 ZoneInfo 밖이라 갱신 안 함)로
	-- 이 레지스트리를 조회하므로, 그 값과 zoneIndex를 일치시켜야 스킬 타겟팅이 이 보스를 찾는다(그
	-- 존의 원래 몬스터들은 입장 시 Pause되어 _paused로 걸러지므로 결과적으로 이 보스만 남는다).
	-- 유저 지정(2026-08-26): "보스 체력을 만들자" — hp를 받아 실제로 죽을 수 있게 한다
	-- (_bonusBossKillable=true, 아래 TakeDamage 계열에서 사용).
	@ExecSpace("ServerOnly")
	method void InitializeAnimatedBonusBoss(integer zoneIndex, number spawnX, number minX, number maxX, number groundY, string standRUID, string moveRUID, string hitRUID, string dieRUID, string hitSoundRUID, string dieSoundRUID, number hp)
		self:SetSpawnZone(zoneIndex)
		self._isBonusBoss = true
		self._bonusBossKillable = true
		-- 유저 지정: 타이머가 보이기 시작하기 전까진 완전히 공격 불가 — Ep3Map2BonusBossLogic.
		-- StartBossTimer()가 실제로 타이머를 띄우는 시점에 false로 풀어준다.
		self._bonusBossCombatLocked = true
		self.MaxHp = hp
		self.CurrentHp = hp
		self._wanderMinX = minX
		self._wanderMaxX = maxX
		self._wanderY = groundY
		self._standRUID = standRUID
		self._hitRUID = hitRUID
		self._dieRUID = dieRUID
		self._hitSoundRUID = hitSoundRUID
		self._dieSoundRUID = dieSoundRUID
		-- 항상 배회 중(UpdateWander가 매 프레임 계속 이동)이라 "걷는" 스프라이트를 기본으로 유지한다.
		self.MonsterSprite = moveRUID
		self._currentScale = 1.3
		self.Entity.TransformComponent.Position = Vector3(spawnX, groundY, 0)
		self.Entity.TransformComponent.Scale = Vector3(1.3, 1.3, 1.0)
		self:SyncDepthOverlaySprite()
		self:HideDepthOverlay()
		self:PickNewWanderTarget()
		log("MonsterAI: animated bonus boss initialized zone=" .. zoneIndex .. " hp=" .. math.floor(hp))
	end

	-- 유저 지정(2026-08-26): "만약에 잡으면 장비 1개 드롭시켜줘! 등급 확률같은건 그대로!" — TakeDamage
	-- 계열이 _bonusBossKillable 보스의 CurrentHp가 0 이하가 된 순간 호출한다. GrantWeaponItemDrop은
	-- TryDropWeaponItem의 확률체크(WeaponDropChance)만 뗀 확정 지급형이라 등급/품질 굴림은 그대로 유지된다.
	-- 사망 연출/무대 종료/랜덤 존 퇴장은 전부 Ep3Map2BonusBossLogic.EndBonusStage()에 위임한다(자연 시간초과
	-- 종료와 100% 동일한 연출+퇴장 시퀀스를 그대로 재사용, 중복 실행은 그쪽의 Active 가드가 막는다).
	@ExecSpace("ServerOnly")
	method void OnBonusBossDefeated()
		self._dead = true
		local worldPos = self.Entity.TransformComponent.WorldPosition
		local dropScale = _CardManager:GetEffectScaleRatio(self)
		_GameManager:GrantWeaponItemDrop(worldPos, 0, worldPos.y, dropScale)
		log("MonsterAI: bonus boss defeated, weapon drop granted")
		_Ep3Map2BonusBossLogic:EndBonusStage()
	end

	-- Zone21AlienEasterEggLogic.SpawnAlienWave()가 스폰 직후 호출: 존 몬스터 풀 시스템(InitializeStats)을
	-- 거치지 않는 일회성 특수 몬스터(뉴그레이 화이트)를 InitializeBonusBoss와 동일한 방식으로 직접 초기화한다.
	-- 공격 애니메이션이 있는 종이라 attackRUID를 명시적으로 넘긴다(zone7+ 풀은 항상 ""로 고정되어 있어 재사용 불가).
	@ExecSpace("ServerOnly")
	method void InitializeAlienInvader(integer zoneIndex, number hp, number speed, string standRUID, string hitRUID, string dieRUID, number dieDuration, string attackRUID)
		self:SetSpawnZone(zoneIndex)
		self.MaxHp = hp
		self.CurrentHp = hp
		self.ApproachSpeed = speed
		self.MonsterSprite = standRUID
		self._dieRUID = dieRUID
		self._dieDuration = dieDuration
		self._hitRUID = hitRUID
		self._attackRUID = attackRUID
		self._isFlying = true
		self._currentScale = 1.0
		self._flyCenterX = self.Entity.TransformComponent.Position.x
		self._flyBaseY = (self.FlyingWanderMinY + self.FlyingWanderMaxY) * 0.5
		self._flyTime = 0
		self._flyPhaseX = _UtilLogic:RandomDouble() * math.pi * 2
		self._flyPhaseY = _UtilLogic:RandomDouble() * math.pi * 2
		self._flySpeedMultX = 0.8 + _UtilLogic:RandomDouble() * 0.4
		self._flySpeedMultY = 0.8 + _UtilLogic:RandomDouble() * 0.4
		self._attackTimer = self.FlyAttackInterval
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:HideDepthOverlay()
		log("MonsterAI: alien invader initialized HP=" .. hp)
	end

	-- Ep3Map2LostRudolphLogic.SpawnBadRudolphPair()가 스폰 직후 호출 — InitializeAlienInvader(비행형)와
	-- 동일한 목적(존 몬스터 풀/HP 시스템을 건너뛰는 커스텀 RUID 침입자)이지만 유저 지정("불량 루돌프는
	-- 공중 유닛 아니다")대로 지상형으로 초기화한다. _isFlying=false로 두고 특수 플래그(_isMiniMoore/
	-- _isBonusBoss 등)를 아무것도 안 켜면 OnUpdate가 자동으로 일반 웨이브 몬스터와 동일한 "스케일 성장
	-- 접근"(실제 이동이 아니라 스케일이 커지며 다가오는 것처럼 보이는 이 게임 고유의 접근 표현) 경로를
	-- 타므로 별도 이동 로직이 필요 없다. _isRangedInk=true로 원거리 종 취급해서(근접 홉 생략, 더 먼
	-- 거리에서 정지) 원거리 몬스터답게 보이게 한다.
	@ExecSpace("ServerOnly")
	method void InitializeGroundAlienInvader(integer zoneIndex, number hp, number speed, string standRUID, string moveRUID, string hitRUID, string dieRUID, number dieDuration, string attackRUID, number spawnX, number groundY)
		self:SetSpawnZone(zoneIndex)
		self.MaxHp = hp
		self.CurrentHp = hp
		self.ApproachSpeed = speed
		self._standRUID = standRUID
		self._moveRUID = moveRUID
		self._dieRUID = dieRUID
		self._dieDuration = dieDuration
		self._hitRUID = hitRUID
		self._attackRUID = attackRUID
		self._isFlying = false
		self._isRangedInk = true
		self._reachedScaleThreshold = self.RangedReachedScale
		self.Entity.TransformComponent.Position = Vector3(spawnX, groundY, 0)
		self.MonsterSprite = (moveRUID ~= "") and moveRUID or standRUID
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:UpdateDepth()
		log("MonsterAI: ground alien invader initialized HP=" .. hp)
	end

	-- Ep2MiniBeanEasterEggLogic 전용 — "존을 이동해도 따라오게" 하기 위해 비행 사인파 중심(_flyCenterX/
	-- _flyBaseY, InitializeStats/InitializeAlienInvader가 스폰 시점에 한 번만 고정하는 값)을 새 존의
	-- 스폰 위치로 즉시 옮긴다(드리프트 없이 스냅 — SilentMoveToMap처럼 강제 이동은 원래 순간이동이라
	-- 자연스럽다). _spawnZoneIndex도 함께 항상 "실제 현재 존"으로 갱신한다 — GetMonstersInCurrentZone
	-- (플레이어 카드/스킬 타겟팅 목록)이 _spawnZoneIndex==currentZone으로 걸러내므로, 이걸 실제 존과
	-- 다르게 둬버리면 플레이어 공격이 영원히 안 맞는다(_neverPauses로 일시정지만 별도로 막으므로
	-- SetMonstersPausedForZone이 실제 존을 보고 Pause를 걸어도 무시된다).
	--
	-- 버그 수정(2026-08-21, 유저 리포트: "구름을 눌러 미니빈 소환 후, 다시 다른 구름을 눌러 다른 존으로
	-- 이동하면 미니빈이 안 죽는다 — 정확히는 공격이 안 먹힌다") — 실제 원인은 이 메서드가 엔티티를
	-- 재부모(reparent)하지 않고 있었던 것. GetMonstersInCurrentZone은 map:GetChildComponentsByTypeName을
	-- 비재귀로 호출해 "그 존 컨테이너의 직계 자식"만 후보로 보는데, 미니빈은 항상 최초 스폰 존의 컨테이너
	-- 밑에 그대로 남아있었다 — 그래서 플레이어가 그 다음 존으로 한 번 더 이동하면(스폰 존 ≠ 현재 존)
	-- GetClosestTargets가 아예 후보에서 빼버려 영원히 공격이 안 맞았다(492줄 UpdateFlying 초기화 주석과
	-- 동일한 클래스의 버그 — "로컬 Position에 월드/타 존 좌표를 그대로 쓰면 오프셋이 겹친다"는 것도
	-- 여기 같이 걸려있었다: newCenterX는 MapManager.GetSpawnPositionForIndex가 반환하는 물리 맵 파일
	-- 기준 좌표인데, 재부모 없이 옛 존 컨테이너 기준 로컬 Position에 그대로 썼으니 화면 위치도 같이
	-- 틀어져 있었다). MonsterSpawner.GetZoneEntity/ToLocalSpawnPos(스폰 시점과 동일한 헬퍼)로 실제
	-- 컨테이너를 옮기고 좌표도 그 컨테이너 기준 로컬로 다시 변환한다.
	@ExecSpace("ServerOnly")
	method void RepositionFlyingCenter(number newCenterX, number newBaseY, integer newZoneIndex)
		-- 이미 등록돼 있던 예전 존 버킷에서 빼고 새 존 버킷에 등록해야 한다 — 안 그러면 존별 레지스트리
		-- (2026-08-24 추가)가 옛 존을 계속 가리켜, 이 메서드가 원래 고치려던 "재부모 안 해서 공격이 안
		-- 먹힌다"는 것과 똑같은 클래스의 버그가 레지스트리 쪽에서 재발한다.
		_MonsterSpawner:UnregisterZoneMonster(self._spawnZoneIndex, self)
		self:SetSpawnZone(newZoneIndex)
		local newMap = _MonsterSpawner:GetZoneEntity(newZoneIndex)
		if newMap == nil or not isvalid(newMap) then
			log_error("MonsterAI: RepositionFlyingCenter - zone entity not found for " .. newZoneIndex)
			return
		end
		self.Entity:AttachTo(newMap)
		local localPos = _MonsterSpawner:ToLocalSpawnPos(newMap, Vector3(newCenterX, newBaseY, 0))
		self._flyCenterX = localPos.x
		self._flyBaseY = localPos.y
		local pos = self.Entity.TransformComponent.Position
		self.Entity.TransformComponent.Position = Vector3(localPos.x, localPos.y, pos.z)
	end

	-- Map23ErdasEasterEggLogic.SpawnErdas()가 스폰 직후 호출: 일반 지상형 몬스터와 동일한 접근(스케일 성장)
	-- +공격 로직을 그대로 쓰되, 체력만 "현재 웨이브 기준 일반 몬스터 HP"의 2배(유저 요청: "일반 몬스터의
	-- 체력 2배 공격력은 같음")로 고정한다. attackRUID는 리소스팩에 전용 공격 연출이 없어 빈 문자열로
	-- 두면(zone4~6 풀과 동일한 패턴) 도달 시 기본 들이받기(PlayLungeAnimation)로 공격한다.
	@ExecSpace("ServerOnly")
	method void InitializeErdas(integer ordinal, integer zoneIndex, string standRUID, string moveRUID, string hitRUID, string dieRUID, number dieDuration, string hitSoundRUID, string dieSoundRUID, number patrolMinX, number patrolMaxX)
		self._isErdas = true
		self._erdasOrdinal = ordinal
		self:SetSpawnZone(zoneIndex)
		self._erdasPatrolMinX = patrolMinX
		self._erdasPatrolMaxX = patrolMaxX
		self:PickNewErdasPatrolTarget()
		-- 2026-08-03 3차 재설계: 순수 시간 단계 기반(GetTimeStep/GetTimeStepHp)으로 되돌림
		local hp = _GameManager:GetTimeStepHp(_GameManager:GetTimeStep()) * 2
		self.MaxHp = hp
		self.CurrentHp = hp
		self.ApproachSpeed = _GameManager:GetWaveApproachSpeed(_GameManager.Wave)
		local variance = (_UtilLogic:RandomDouble() * 2 - 1) * self.ApproachSpeedVariance
		self.ApproachSpeed = self.ApproachSpeed + variance
		self._standRUID = standRUID
		self._moveRUID = moveRUID
		self._hitRUID = hitRUID
		self._dieRUID = dieRUID
		self._dieDuration = dieDuration
		self._attackRUID = ""
		self._hitSoundRUID = hitSoundRUID
		self._dieSoundRUID = dieSoundRUID
		self._isFlying = false
		-- 유저 요청: 사이즈 절반
		self._scaleMultiplier = self._scaleMultiplier * 0.5
		self._erdasHitGrowthBonus = 0
		if self._moveRUID ~= "" then
			self.MonsterSprite = self._moveRUID
		else
			self.MonsterSprite = self._standRUID
		end
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:UpdateDepth()
		log("MonsterAI: Erdas #" .. ordinal .. " initialized HP=" .. hp)
	end

	-- Map24TreasureChestLogic.SpawnChest()가 스폰 직후 호출: 공중 타일 중간에 고정된 채 등장하는
	-- 일회성 특수 몬스터(진 힐라의 보물상자). 이동 애니메이션이 없어 접근 성장 연출 없이 처음부터
	-- 완전한 크기로 등장하고(InitializeBonusBoss와 동일한 방식), 플레이어를 공격하지 않는다
	-- (_neverAttacks — 유저 요청: "고정 체력 + 플레이어 공격하지 않음"). 체력은 웨이브 개념이 없는
	-- map24 전용이라 고정값을 그대로 받는다(유저 지정: 3000).
	@ExecSpace("ServerOnly")
	method void InitializeTreasureChest(number hp, string standRUID, string hitRUID, string dieRUID, number dieDuration, string hitSoundRUID, string dieSoundRUID)
		self._isTreasureChest = true
		-- 버그 수정(2026-08-28, 유저 리포트 "상자를 유저가 공격을 안하네") — 다른 모든 InitializeStats*/
		-- InitializeErdas/InitializeBonusBoss 계열은 SetSpawnZone()으로 존별 레지스트리(_zoneMonsterRegistry)에
		-- 등록되는데, 이 메서드만 그걸 빠뜨리고 있었다. GetClosestTargets/FindTarget(모든 카드·기본공격의
		-- 단일 타겟팅 진입점)이 이 레지스트리만 보고 판정하므로, 등록이 안 된 상자는 플레이어 공격 후보에서
		-- 아예 빠져 있었다(HP는 그대로인데 원래 고정 표시라 눈치채기 어려움). map24는 항상 존44 고정
		-- (Map23ErdasEasterEggLogic.TeleportToMap24가 targetIndex=44로 하드코딩) — 그대로 등록한다.
		self:SetSpawnZone(44)
		self._neverAttacks = true
		self.MaxHp = hp
		self.CurrentHp = hp
		self._standRUID = standRUID
		self._moveRUID = ""
		self._hitRUID = hitRUID
		self._dieRUID = dieRUID
		self._dieDuration = dieDuration
		self._attackRUID = ""
		self._hitSoundRUID = hitSoundRUID
		self._dieSoundRUID = dieSoundRUID
		self._isFlying = false
		self._currentScale = self._reachedScaleThreshold
		-- 유저 확인: 보물상자는 고정이 맞다(좌우 배회는 에르다스 얘기였음) — 도달 상태로 그 자리에
		-- 고정하고, 실제 공격 호출만 _neverAttacks로 막는다
		self._reachedPlayer = true
		self.MonsterSprite = standRUID
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:HideDepthOverlay()
		log("MonsterAI: treasure chest initialized HP=" .. hp)
	end

	-- NinjaStatuePuzzleLogic.SpawnMiniMoore()가 스폰 직후 호출: 존 몬스터 풀/HP/전투 시스템을 완전히
	-- 건너뛰는 일회성 특수 몬스터(얄미운 미니무르)를 InitializeAlienInvader와 동일한 방식(비행형)으로
	-- 초기화한다. 전투 대상이 아니라서(타격 완전 무시) hitRUID/dieRUID/attackRUID가 전혀 필요 없다 —
	-- MiniMooreDropInterval마다 MiniMooreDropChance 확률로 보유 스킬을 떨어뜨리다가 MiniMooreLifetime
	-- 후 스스로 날아올라 사라진다(RollMiniMooreDrop/EndMiniMooreLife 참고).
	@ExecSpace("ServerOnly")
	method void InitializeMiniMoore(integer zoneIndex, string standRUID, string moveRUID)
		self:SetSpawnZone(zoneIndex)
		self._isMiniMoore = true
		self.MonsterSprite = standRUID
		self._standRUID = standRUID
		self._moveRUID = moveRUID
		self._attackRUID = ""
		self._isFlying = true
		self._currentScale = 1.0
		self._flyCenterX = self.Entity.TransformComponent.Position.x
		self._flyBaseY = (self.FlyingWanderMinY + self.FlyingWanderMaxY) * 0.5
		self._flyTime = 0
		self._flyPhaseX = _UtilLogic:RandomDouble() * math.pi * 2
		self._flyPhaseY = _UtilLogic:RandomDouble() * math.pi * 2
		self._flySpeedMultX = 0.8 + _UtilLogic:RandomDouble() * 0.4
		self._flySpeedMultY = 0.8 + _UtilLogic:RandomDouble() * 0.4
		self._attackTimer = self.FlyAttackInterval
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:HideDepthOverlay()
		self._miniMooreDropTimerId = _TimerService:SetTimerRepeat(self.RollMiniMooreDrop, self.MiniMooreDropInterval, self.MiniMooreDropInterval)
		self._miniMooreLifeTimerId = _TimerService:SetTimerOnce(self.EndMiniMooreLife, self.MiniMooreLifetime)
		log("MonsterAI: mini moore initialized")
	end

	-- Ep3Map1MushroomLogic.SpawnMushroom()이 스폰 직후 호출: ep3_map1 "한겨울의 주황버섯" 이스터에그
	-- 전용 — InitializeMiniMoore와 완전히 동일한 드롭/유지시간/전투무시 정책(RollMiniMooreDrop/
	-- EndMiniMooreLife 그대로 재사용, 유저 지정: "유지 시간도 같게, 드롭템 확률도 같게")이지만 비행이
	-- 아니라(유저 지정: "비행형은 아님") BonusBoss.UpdateWander와 동일한 방식(_wanderMinX~Y 재사용)으로
	-- 지정 X범위 안에서 고정 Y(지면)를 좌우로 배회한다. _isFlying=false로 두면 OnUpdate가 이 지상 배회
	-- 분기를 자동으로 타게 된다.
	@ExecSpace("ServerOnly")
	method void InitializeGroundMiniMoore(integer zoneIndex, string standRUID, string moveRUID, number spawnX, number minX, number maxX, number groundY)
		self:SetSpawnZone(zoneIndex)
		self._isMiniMoore = true
		self._isFlying = false
		self.MonsterSprite = (moveRUID ~= "") and moveRUID or standRUID
		self._standRUID = standRUID
		self._moveRUID = moveRUID
		self._attackRUID = ""
		self._currentScale = 1.0
		self._wanderMinX = minX
		self._wanderMaxX = maxX
		self._wanderY = groundY
		self.Entity.TransformComponent.Position = Vector3(spawnX, groundY, 0)
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:HideDepthOverlay()
		self:PickNewWanderTarget()
		self._miniMooreDropTimerId = _TimerService:SetTimerRepeat(self.RollMiniMooreDrop, self.MiniMooreDropInterval, self.MiniMooreDropInterval)
		self._miniMooreLifeTimerId = _TimerService:SetTimerOnce(self.EndMiniMooreLife, self.MiniMooreLifetime)
		log("MonsterAI: ground mini moore (mushroom) initialized")
	end

	-- Ep3Map2LostRudolphLogic.SpawnLostRudolph()가 스폰 직후 호출 — InitializeGroundMiniMoore와 동일한
	-- 지상 배회 기반이지만(_isMiniMoore=true 재사용, 타격 완전 무시) MiniMoore의 드롭/유지시간 타이머는
	-- 전혀 쓰지 않는다 — 대신 이동/정지 애니메이션 사이클을 새로 갖는다(UpdateLostRudolphCycle 참고).
	@ExecSpace("ServerOnly")
	method void InitializeLostRudolph(integer zoneIndex, string standRUID, string moveRUID, string dieRUID, number dieDuration, string dieSoundRUID, number spawnX, number minX, number maxX, number groundY)
		self:SetSpawnZone(zoneIndex)
		self._isMiniMoore = true
		self._isLostRudolph = true
		self._isFlying = false
		self._standRUID = standRUID
		self._moveRUID = moveRUID
		self._dieRUID = dieRUID
		self._dieDuration = dieDuration
		self._dieSoundRUID = dieSoundRUID
		self._currentScale = 1.0
		self._wanderMinX = minX
		self._wanderMaxX = maxX
		self._wanderY = groundY
		self.IsStanding = false
		self._lostRudolphCycleTimer = self.LostRudolphMoveMin + _UtilLogic:RandomDouble() * (self.LostRudolphMoveMax - self.LostRudolphMoveMin)
		self.MonsterSprite = moveRUID
		self.Entity.TransformComponent.Position = Vector3(spawnX, groundY, 0)
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:HideDepthOverlay()
		self:PickNewWanderTarget()
		log("MonsterAI: lost rudolph initialized")
	end

	-- MonsterAI.OnUpdate의 지상 배회 분기가 매 프레임 호출 — 이동 상태를 LostRudolphMoveMin~Max초
	-- 유지하다가 LostRudolphStandDuration초(기본 1초) 동안 정지하는 것을 반복한다.
	@ExecSpace("ServerOnly")
	method void UpdateLostRudolphCycle(number delta)
		self._lostRudolphCycleTimer = self._lostRudolphCycleTimer - delta
		if self._lostRudolphCycleTimer > 0 then return end
		if self.IsStanding then
			self.IsStanding = false
			self.MonsterSprite = self._moveRUID
			self._lostRudolphCycleTimer = self.LostRudolphMoveMin + _UtilLogic:RandomDouble() * (self.LostRudolphMoveMax - self.LostRudolphMoveMin)
		else
			self.IsStanding = true
			self.MonsterSprite = self._standRUID
			self._lostRudolphCycleTimer = self.LostRudolphStandDuration
		end
	end

	-- 클라이언트 터치 감지 — TouchReceiveComponent가 있는 개체(길잃은 루돌프 전용 .model)에서만 실제로 발생한다.
	@ExecSpace("ClientOnly")
	method void OnLostRudolphClientTouched(TouchEvent event)
		if not self._isLostRudolph then return end
		if _GameManager.GameOver then return end
		if _TitleUI.titleGroup.Enable then return end
		self:OnLostRudolphTouched()
	end

	-- 서 있을 때(IsStanding) 터치하면 성공(die1 재생 후 사라짐, 보상 없음 — 유저 지정). 이동 중에
	-- 터치하면 실패 — Ep3Map2LostRudolphLogic이 "불량 루돌프" 2마리를 소환한다(존 제한, 유저 지정).
	@ExecSpace("Server")
	method void OnLostRudolphTouched()
		if not self._isLostRudolph or self._dead then return end
		if self.IsStanding then
			self._dead = true
			self:PlayDeathAnimation(self._dieRUID, self._dieDuration)
			self.Entity:Destroy(self._dieDuration + 0.2)
			_Ep3Map2LostRudolphLogic:OnCaught()
		else
			_Ep3Map2LostRudolphLogic:OnMissedTouch(self.Entity.TransformComponent.WorldPosition, self._spawnZoneIndex)
		end
	end

	-- Ep3Map2LostRudolphLogic.SpawnBadRudolphPair()가 소환 직후 호출 — Die()에서 EXP/잡템/장비/스킬
	-- 드롭을 전부 건너뛰게 한다(골드는 유저 지정대로 정상 지급).
	@ExecSpace("ServerOnly")
	method void SetIsBadRudolph(boolean value)
		self._isBadRudolph = value
	end

	-- MiniMooreDropInterval마다 호출 — 매 틱마다 뭔가는 무조건 떨어진다: MiniMooreDropChance(3%) 확률로
	-- 보유 스킬 카드 하나를 강화/드롭하고(CardManager.OnEliteKilled 재사용 — 엘리트 처치 보상과 동일한
	-- "이미 장착/해금된 카드 강화" 연출), 그 외(97%)엔 지금까지 구현된 몬스터 잡템 중 아무거나 하나를
	-- 떨어뜨린다(GameManager.ForceDropLootItem). 스킬이 나온 틱엔 잡템은 같이 안 준다(요청사항).
	-- 비행형이라 사망 위치가 항상 공중이므로, 드롭 낙하 연출이 실제 발판까지 떨어지도록 Die()의 비행형
	-- 분기와 동일한 방식으로 fallHeight/groundWorldY를 레이캐스트로 계산해서 두 분기가 공유한다.
	@ExecSpace("ServerOnly")
	method void RollMiniMooreDrop()
		if not isvalid(self) or not isvalid(self.Entity) then return end
		
		local worldPos = self.Entity.TransformComponent.WorldPosition
		local fallHeight = 0
		local groundWorldY = worldPos.y
		local map = self.Entity.CurrentMap
		if map ~= nil then
			---@type FootholdComponent
			local foothold = map:GetComponent("FootholdComponent")
			if foothold ~= nil then
				local hits = foothold:RaycastAll(Vector2(worldPos.x, worldPos.y), Vector2(0, -1), 50)
				local groundY = nil
				local bestDist = nil
				for i = 1, #hits do
					local h = hits[i]
					local y = h:GetYByX(worldPos.x)
					local dist = worldPos.y - y
					if bestDist == nil or dist < bestDist then
						bestDist = dist
						groundY = y
					end
				end
				if groundY ~= nil and worldPos.y > groundY then
					fallHeight = (worldPos.y - groundY) * 100
					groundWorldY = groundY
				end
			end
		end
		
		local dropScale = _CardManager:GetEffectScaleRatio(self)
		if _UtilLogic:RandomDouble() < self.MiniMooreDropChance then
			_CardManager:OnEliteKilled(worldPos, fallHeight, groundWorldY, dropScale)
			log("MonsterAI: mini moore dropped a skill")
		else
			_GameManager:ForceDropLootItem(worldPos, fallHeight, groundWorldY, dropScale)
			log("MonsterAI: mini moore dropped a junk item")
		end
	end

	-- MiniMooreLifetime 경과 시 호출 — 드롭 타이머를 멈추고 보너스 보스 퇴장 연출(먼지+붕 뜨며 페이드)로
	-- 사라진다. 전투로 죽지 않으므로 Die()가 아니라 PlayDespawnJump()를 재사용한다.
	@ExecSpace("ServerOnly")
	method void EndMiniMooreLife()
		if self._miniMooreDropTimerId ~= 0 then
			_TimerService:ClearTimer(self._miniMooreDropTimerId)
			self._miniMooreDropTimerId = 0
		end
		self._miniMooreLifeTimerId = 0
		if not isvalid(self) or not isvalid(self.Entity) then return end
		self:PlayDespawnJump()
		log("MonsterAI: mini moore lifetime ended, despawning")
	end

	@ExecSpace("ServerOnly")
	method void MarkElite()
		-- 엘리트 승급: 체력/공격력 +15%, 비주얼 스케일 확대. OnBeginPlay에서 웨이브 스탯이 잡힌 직후(스폰 직후) 호출된다.
		if self._isElite then return end
		self._isElite = true
		-- 보스(웨이브10+)의 x10 스케일과 곱연산으로 같이 적용되도록 덮어쓰지 않고 곱한다
		self._scaleMultiplier = self._scaleMultiplier * 1.15
		self.MaxHp = self.MaxHp * 1.15
		self.CurrentHp = self.MaxHp
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		-- 골드 아웃라인 머티리얼 적용 (MaterialId는 @Sync라 서버에서 바꾸면 클라이언트에 자동 반영)
		self.Entity.SpriteRendererComponent:ChangeMaterial(self.EliteOutlineMaterialId)
		log("MonsterAI: promoted to ELITE (HP=" .. math.floor(self.MaxHp) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void ApplySmallVariant()
		self._scaleMultiplier = self._scaleMultiplier * (2.0 / 3.0)
		self.MaxHp = math.floor(self.MaxHp * 0.8)
		self.CurrentHp = self.MaxHp
		self.ApproachSpeed = self.ApproachSpeed * self.SmallVariantSpeedMultiplier
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
	end

	-- 빠른 이동 안전장치(MonsterSpawner._pendingRushPenalty가 스폰 배치 단위로 적용) — 유저 요청:
	-- "이동 버튼 눌러서 존나 빨리 이동해버리면 너무 허무하게 깨지는거 같다". tier(1|2)는
	-- MapManager.RegisterZoneArrival의 연속 이동 스트릭 단계에서 그대로 넘어온다.
	-- 1단계(3연속): 스폰 시점의 접근 스케일을 미리 절반쯤 당겨서(스폰 기본값~접근완료 중간) 화면에
	-- 더 크고 가깝게 시작시키고, 그만큼 공격 판정(_reachedPlayer)까지 걸리는 시간도 자연히 줄어든다.
	-- 2단계(6연속, 2026-08-11 추가): 1단계에 더해 실제로 체력/공격력도 RushTier2StatMultiplier배
	-- 강화한다("몬스터가 강해집니다" 토스트와 일치시키기 위함 — 1단계는 접근만 당길 뿐 스탯은 그대로였음).
	-- 비행형(스케일 접근 개념이 없음)과 거대네펜데스 1페이즈(_neverAttacks — 이미 도달 상태로 고정
	-- 스폰됨)는 접근-당김 대상에서 제외하되, 2단계 스탯 강화는 이들에게도 그대로 적용한다.
	@ExecSpace("ServerOnly")
	method void ApplyRushPenalty(integer tier)
		if not (self._isFlying or self._neverAttacks) then
			local mid = (self._currentScale + self._reachedScaleThreshold) * 0.5
			if mid > self._currentScale then
				self._currentScale = mid
				self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
				self:SyncDepthOverlaySprite()
				self:UpdateDepth()
			end
		end
		if tier >= 2 then
			self.MaxHp = math.floor(self.MaxHp * self.RushTier2StatMultiplier)
			self.CurrentHp = self.MaxHp
			-- 공격력은 체력과 다른 배율을 쓴다(위 프로퍼티 주석 참고)
			self._rushDamageMultiplier = self.RushTier2DamageMultiplier
		end
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- MonsterSprite가 동기화되면 SpriteRendererComponent의 RUID를 교체한다.
		-- 사망 후에는 무시 — Die()가 죽는 스프라이트로 이미 바꿔놨는데, 사망 처리 직후(Entity가
		-- 파괴 전 유예시간 동안 살아있는 동안) 뒤늦게 도착한 MonsterSprite 동기화가 이걸 다시
		-- 비행/서 있는 포즈로 덮어써버리는 버그(죽는 연출 직후 날아다니는 포즈가 잠깐 보임)가 있었다.
		if self._dead then return end
		if name == "MonsterSprite" and self.MonsterSprite ~= "" then
			local renderer = self.Entity.SpriteRendererComponent
			if renderer ~= nil then
				-- 버그 수정(2026-08-27, 유저 리포트: "웨어울프/라이칸스로프/스노우맨 공격 연출이 안 보이고
				-- 점프만 보임") — OnUpdate가 처음 도달(_reachedPlayer=true)하는 그 프레임에 self.MonsterSprite를
				-- stand로 바꾼 바로 다음 줄에서 OnReachPlayer()를 호출해 PlayAttackAnimation(Multicast)도
				-- 같은 프레임에 나간다. 이 MonsterSprite 동기화(OnSyncProperty)와 PlayAttackAnimation
				-- Multicast는 둘 다 서버→클라이언트 메시지라 도착 순서가 보장되지 않는다 — 동기화가 나중에
				-- 도착하면 방금 재생을 시작한 attack1(또는 hit1) 스프라이트를 여기서 즉시 stand로 되돌려버려,
				-- 실제로는 화면에 공격 포즈가 한 프레임도 안 보이고 PlayAttackHop(위치만 바뀌는 점프 트윈)만
				-- 보이는 문제였다(스노우맨처럼 원거리라 홉조차 없는 종은 아예 아무 반응도 없어 보였다).
				--
				-- ⚠ 1차 수정(current==self._attackRUID 비교)은 실측으로 무효였다 — _attackRUID/_hitRUID는
				-- @Sync가 아니라서 클라이언트에서는 항상 기본값 ""로 읽힌다(서버에서만 실제 값을 가짐).
				-- 라이브 디버그 로그로 "attackRUID=[]"가 매번 찍히는 걸 직접 확인. 대신 attack1/hit1
				-- 스프라이트를 실제로 세팅하는 PlayAttackAnimation/PlayHitAnimation 자신이(둘 다 클라이언트
				-- 에서 실행되는 Multicast라 정확한 RPC 인자를 받음) 순수 클라이언트 로컬 플래그
				-- (_isPlayingTransientSprite, 동기화 대상 아님)를 직접 세팅/해제하게 하고 여기서는 그 플래그만
				-- 확인한다.
				if not self._isPlayingTransientSprite then
					renderer.SpriteRUID = self.MonsterSprite
				end
			else
				log_warning("MonsterAI: SpriteRendererComponent nil")
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if self._dead then return end
		if _GameManager.GameOver then return end
		if self._isPushingBack then return end
		if self._paused then return end
		
		if self._isBonusBoss then
			self:UpdateWander(delta)
			-- 비행형과 동일한 원인의 버그 — 보너스 보스도 이 분기에서 바로 return해서 지상 전용 로직(콤보
			-- 어택 오브 회전 갱신)까지 못 내려갔다. 비행형 수정 때 같이 안 잡혔던 케이스(유저 재확인으로 발견).
			self:UpdateComboOrbPositions(delta)
			return
		end
		
		-- ep3_map1 "한겨울의 주황버섯" 이스터에그(지상형 미니무르) — 얄미운 미니무르와 동일한 드롭/전투
		-- 무시 정책이지만 비행이 아니라 BonusBoss와 동일한 방식(UpdateWander, 고정 Y 좌우 배회)으로
		-- 지상을 걸어다닌다. InitializeGroundMiniMoore()가 _isFlying=false로 설정해서 여기로 온다.
		if self._isMiniMoore and not self._isFlying then
			-- "길잃은 루돌프" 전용 이동/정지 사이클 — 정지 중엔 UpdateWander를 건너뛰어 실제로도
			-- 제자리에 멈춘다(다른 지상형 미니무르는 IsStanding이 항상 false라 동작 변화 없음).
			if self._isLostRudolph then
				self:UpdateLostRudolphCycle(delta)
			end
			if not self.IsStanding then
				self:UpdateWander(delta)
			end
			self:UpdateComboOrbPositions(delta)
			return
		end
		
		if self._isFlying then
			self:UpdateFlying(delta)
			-- 비행형은 이 아래 지상 전용 로직으로 못 내려가서 콤보어택 오브 회전이 갱신되지 않고
			-- 멈춰 있었다(유저 리포트: "연출이 고정되어 있고 뱅글뱅글 오브가 안돔") — 여기서 직접 호출.
			self:UpdateComboOrbPositions(delta)
			return
		end
		
		-- 돌진형 종(맘무트/골든맘무트/트라고스) wind-up: dash가 아직 시작 안 됐고 도달 전이면 제자리에서
		-- 위아래로 떨기만 하고 스케일 접근 로직 전체를 건너뛴다. wind-up이 끝나는 프레임에 dash를 시작시키고
		-- (ApproachSpeed 부스트 + 먼지 이펙트), 그 이후로는 이 분기 자체가 실행되지 않아 아래 일반 스케일
		-- 접근 로직(부스트된 속도로 훨씬 빠르게 진행)으로 자연히 이어진다.
		if self._isCharge and not self._chargeDashActive and not self._reachedPlayer then
			if not self._isStunned and not self._isHardFrozen then
				self._chargeWindupTimer = self._chargeWindupTimer - delta
				local jitterX = (_UtilLogic:RandomDouble() * 2 - 1) * self.ChargeShakeAmplitude
				local jitterY = (_UtilLogic:RandomDouble() * 2 - 1) * self.ChargeShakeAmplitude
				local jpos = self.Entity.TransformComponent.Position
				self.Entity.TransformComponent.Position = Vector3(self._chargeSpawnX + jitterX, self._chargeSpawnY + jitterY, jpos.z)
				if self._chargeWindupTimer <= 0 then
					self:StartChargeDash()
				end
			end
			return
		end
		
		-- 빙결/스턴 인디케이터는 map(=Entity.CurrentMap, 맵 루트)의 자식으로 스폰되는데 이 몬스터
		-- 자신은 Zone12 같은 오프셋 컨테이너의 자식일 수 있다 — 로컬 Position을 그대로 쓰면 존 오프셋만큼
		-- 어긋난 곳으로 계속 갱신되므로 WorldPosition을 써야 한다.
		-- 빙결 스택 UI 지표 위치 추적
		if isvalid(self._freezeIndicator) then
			local fpos = self.Entity.TransformComponent.WorldPosition
			self._freezeIndicator.TransformComponent.Position = Vector3(fpos.x + 0.45, fpos.y - 0.40, fpos.z - 0.05)
		end
		
		-- 스턴 별 이펙트 위치 추적 (머리 위)
		if isvalid(self._stunStarsIndicator) then
			local spos = self.Entity.TransformComponent.WorldPosition
			self._stunStarsIndicator.TransformComponent.Position = Vector3(spos.x, spos.y + 0.9, spos.z - 0.1)
		end
		
		-- 콤보어택 오브 회전(몬스터 자식 엔티티라 로컬 좌표만 갱신하면 됨 — 존 오프셋 보정 불필요)
		self:UpdateComboOrbPositions(delta)
		
		if self._reachedPlayer then
			-- 스턴/속박(ApplyStun) 중에는 이미 도달해서 공격 중이던 지상(근접) 유닛도 완전히 멈춰야
			-- 한다 — UpdateFlying(비행형)엔 이미 있던 체크인데 이 지상형 분기엔 빠져 있어서, 속박 중에도
			-- 이미 붙어있던 몬스터는 계속 공격이 나가는 버그가 있었다. 타이머 자체를 멈춰서 스턴이
			-- 끝나면 정상적으로 AttackInterval부터 다시 카운트되게 한다.
			if self._isStunned or self._isHardFrozen then return end
			-- 보물상자처럼 도달 상태를 재사용하되 실제로 공격하면 안 되는 고정 타겟은 여기서 건너뛴다
			if self._neverAttacks then return end
			-- 유저 요청: 에르다스는 도달 후에도 제자리에 얼어붙지 않고 공중 발판 위를 좌우로
			-- 배회하면서(발판을 벗어나면 낙하) 계속 공격한다 — 이동과 공격 타이머는 서로 독립적으로
			-- 같은 프레임에 같이 처리된다.
			if self._isErdas then
				self:UpdateErdasPatrol(delta)
			end
			-- 정면에 멈춰서 일정 간격으로 계속 공격
			self._attackTimer = self._attackTimer - delta
			if self._attackTimer <= 0 then
				self:OnReachPlayer()
				self._attackTimer = (self._customAttackInterval > 0) and self._customAttackInterval or self.AttackInterval
			end
			return
		end
		
		-- 스케일 증가 (카메라 접근 연출) — 스턴/완전빙결 중에는 전진 자체가 멈춰야 한다
		if not self._isStunned and not self._isHardFrozen then
			self._currentScale = self._currentScale + self.ApproachSpeed * delta
		end
		
		-- 닌자/재규어 지그재그: 전진(스케일)과 독립적으로 X만 사인파로 좌우 흔들되, 중심(_zigzagBaseX)에서
		-- 벗어나지 않게 한다. 도달(_reachedPlayer=true) 후에는 이 분기 자체가 실행되지 않으므로
		-- 자동으로 멈추고 정면에 고정된다. 스턴/속박(ApplyStun) 중에는 흔들림 자체를 멈춰야 하는데(유저
		-- 지적 — 지그재그 중에도 계속 좌우로 흔들리는 버그, 존27~30 닌자에도 원래 있던 문제) 타이머
		-- (_zigzagTime)까지 통째로 멈춰서 스턴이 풀리면 멈췄던 위상 그대로 이어서 흔들리게 한다.
		-- 완전빙결도 동일하게 멈춰야 한다.
		if self._isZigzag and not self._isStunned and not self._isHardFrozen then
			self._zigzagTime = self._zigzagTime + delta
			local offsetX = math.sin(self._zigzagTime * self.ZigzagFrequency + self._zigzagPhase) * self._zigzagAmplitudeActual
			local zpos = self.Entity.TransformComponent.Position
			self.Entity.TransformComponent.Position = Vector3(self._zigzagBaseX + offsetX, zpos.y, zpos.z)
		
			if self._hasZigzagAfterimage then
				self._afterimageTimer = self._afterimageTimer - delta
				if self._afterimageTimer <= 0 then
					self:SpawnAfterimage()
					self._afterimageTimer = self.AfterimageInterval
				end
			end
		end
		
		if self._currentScale >= self._reachedScaleThreshold then
			-- 도달 임계값(근접 1.5 / 원거리는 더 낮음)에 도달 → 소멸하지 않고 그 자리에서 계속 공격 시작
			self._currentScale = self._reachedScaleThreshold
			local reachedScale = self._reachedScaleThreshold * self._scaleMultiplier * (1.0 + self._erdasHitGrowthBonus)
			self.Entity.TransformComponent.Scale = Vector3(reachedScale, reachedScale, 1.0)
			self:UpdateDepth()
			self._reachedPlayer = true
			self._attackTimer = (self._customAttackInterval > 0) and self._customAttackInterval or self.AttackInterval
			-- 도달했으니 걷는 포즈(move)에서 정지 포즈(stand)로 되돌린다 — move가 아예 없던 종(moveRUID=="")은
			-- 이미 MonsterSprite가 stand였으므로 그대로 다시 대입해도 무해하다.
			self.MonsterSprite = self._standRUID
			self:SyncDepthOverlaySprite()
			self:OnReachPlayer()
		else
			local approachScale = self._currentScale * self._scaleMultiplier * (1.0 + self._erdasHitGrowthBonus)
			self.Entity.TransformComponent.Scale = Vector3(approachScale, approachScale, 1.0)
			self:UpdateDepth()
		end
	end

	-- 보너스 보스 전용: 짧은 간격으로 새 목표 X를 뽑아 그쪽으로 이동해 "정신없이 돌아다니는" 느낌을 준다
	@ExecSpace("ServerOnly")
	method void UpdateWander(number delta)
		self._wanderRetargetTimer = self._wanderRetargetTimer - delta
		if self._wanderRetargetTimer <= 0 then
			self:PickNewWanderTarget()
		end
		
		local pos = self.Entity.TransformComponent.Position
		local dx = self._wanderTargetX - pos.x
		local step = self._wanderSpeed * delta
		local moveX = pos.x
		if math.abs(dx) <= step then
			moveX = self._wanderTargetX
		elseif dx > 0 then
			moveX = pos.x + step
		else
			moveX = pos.x - step
		end
		self.Entity.TransformComponent.Position = Vector3(moveX, self._wanderY, pos.z)
	end

	@ExecSpace("ServerOnly")
	method void PickNewWanderTarget()
		self._wanderTargetX = self._wanderMinX + _UtilLogic:RandomDouble() * (self._wanderMaxX - self._wanderMinX)
		self._wanderRetargetTimer = 0.4 + _UtilLogic:RandomDouble() * 0.6
	end

	-- 에르다스 전용 — 도달한 뒤 공중 발판 위를 좌우로 배회한다(공격 타이머는 호출부인 OnUpdate의
	-- _reachedPlayer 분기가 그대로 담당). BonusBoss.UpdateWander처럼 고정 Y가 아니라, 목표 X로 이동한
	-- 뒤 그 자리 아래에 실제 발판이 있는지 매 프레임 레이캐스트로 확인해 Y를 지형에 맞춰 갱신한다.
	-- 발판이 없으면(배회 범위가 발판 가장자리를 넘어섬) 낙하로 전환한다.
	@ExecSpace("ServerOnly")
	method void UpdateErdasPatrol(number delta)
		local map = self.Entity.CurrentMap
		if map == nil then return end
		local pos = self.Entity.TransformComponent.Position
		---@type FootholdComponent
		local foothold = map:GetComponent("FootholdComponent")
		
		if self._isErdasFalling then
			self._erdasFallVelocity = self._erdasFallVelocity + self.ErdasGravity * delta
			local fallY = pos.y - self._erdasFallVelocity * delta
			local landed = false
			if foothold ~= nil then
				local hit = foothold:Raycast(Vector2(pos.x, pos.y), Vector2(0, -1), 200)
				if hit ~= nil then
					local groundY = hit:GetYByX(pos.x)
					if fallY <= groundY then
						fallY = groundY
						landed = true
					end
				end
			end
			self.Entity.TransformComponent.Position = Vector3(pos.x, fallY, pos.z)
			if landed then
				self._isErdasFalling = false
				self._erdasFallVelocity = 0
			end
			return
		end
		
		self._erdasPatrolRetargetTimer = self._erdasPatrolRetargetTimer - delta
		if self._erdasPatrolRetargetTimer <= 0 then
			self:PickNewErdasPatrolTarget()
		end
		
		local dx = self._erdasPatrolTargetX - pos.x
		local step = self.ErdasPatrolSpeed * delta
		local moveX = pos.x
		if math.abs(dx) <= step then
			moveX = self._erdasPatrolTargetX
		elseif dx > 0 then
			moveX = pos.x + step
		else
			moveX = pos.x - step
		end
		
		-- 짧은 거리만 살펴서 "지금 딛고 있는 발판"만 인식한다 — 아래로 멀리까지 훑으면 훨씬 아래에 있는
		-- 메인 바닥까지 걸려서 발판을 벗어나도 계속 그 자리에 붙어있는 것처럼 보인다
		local onFoothold = false
		local groundY = pos.y
		if foothold ~= nil then
			local hit = foothold:Raycast(Vector2(moveX, pos.y + 0.2), Vector2(0, -1), 0.6)
			if hit ~= nil then
				groundY = hit:GetYByX(moveX)
				onFoothold = true
			end
		end
		
		if onFoothold then
			self.Entity.TransformComponent.Position = Vector3(moveX, groundY, pos.z)
		else
			self._isErdasFalling = true
			self._erdasFallVelocity = 0
			self.Entity.TransformComponent.Position = Vector3(moveX, pos.y, pos.z)
		end
	end

	method void PickNewErdasPatrolTarget()
		self._erdasPatrolTargetX = self._erdasPatrolMinX + _UtilLogic:RandomDouble() * (self._erdasPatrolMaxX - self._erdasPatrolMinX)
		self._erdasPatrolRetargetTimer = 1.5 + _UtilLogic:RandomDouble() * 1.5
	end

	-- 에르다스 전용 — 맞을 때마다(TakeDamage 계열 전부에서 호출) 스케일이 2%p씩 커지다 20%에서 멈춘다
	-- (유저 요청: "때릴때마다 2%씩 스케일이 커지면 좋겠어 맥스 20%"). _scaleMultiplier 자체를 곱하지
	-- 않고 별도 배율(_erdasHitGrowthBonus)로 둬서 정확히 선형으로 20%까지만 쌓이게 한다 — OnUpdate의
	-- 두 Scale 대입 지점(접근 중/도달 직후)이 이미 이 배율을 곱해서 쓰므로 여기서는 값만 갱신하고
	-- 즉시 한 번 더 반영한다(도달 후에는 OnUpdate가 매프레임 Scale을 다시 대입하지 않기 때문).
	@ExecSpace("ServerOnly")
	method void ApplyErdasHitGrowth()
		if self._erdasHitGrowthBonus >= self.ErdasHitGrowthMaxBonus then return end
		self._erdasHitGrowthBonus = math.min(self.ErdasHitGrowthMaxBonus, self._erdasHitGrowthBonus + self.ErdasHitGrowthPerHit)
		local scale = self._currentScale * self._scaleMultiplier * (1.0 + self._erdasHitGrowthBonus)
		self.Entity.TransformComponent.Scale = Vector3(scale, scale, 1.0)
	end

	-- 돌진형 종의 wind-up이 끝나는 순간 1회 호출 — 스폰 위치로 정확히 되돌리고(떨림 오프셋 제거),
	-- 몬스터 뒤(아래쪽)에 먼지 이펙트를 1회 재생한 뒤 ApproachSpeed를 크게 부스트한다. 이후 프레임부터는
	-- OnUpdate 하단의 일반 스케일 접근 로직이 부스트된 속도로 그대로 이어받는다.
	@ExecSpace("ServerOnly")
	method void StartChargeDash()
		self._chargeDashActive = true
		local pos = self.Entity.TransformComponent.Position
		self.Entity.TransformComponent.Position = Vector3(self._chargeSpawnX, self._chargeSpawnY, pos.z)
		-- 유저 지정(2026-08-22): 원형파장(DustExplosion — "연기와 함께 원형 파장이 터지는" 네이티브
		-- 파티클) 위치가 발밑에 너무 깔려 보였다는 지적으로 Y오프셋을 0.5 올림(-0.25 → 0.25).
		_ParticleService:PlayBasicParticleAttached(
			BasicParticleType.DustExplosion,
			self.Entity,
			Vector3(0, 0.25, 0.1),
			0,
			Vector3(self.ChargeDustScale, self.ChargeDustScale, self.ChargeDustScale),
			false,
			{ SortingLayer = self.ChargeDustSortingLayer, OrderInLayer = self.ChargeDustOrderInLayer }
		)
		self.ApproachSpeed = self.ApproachSpeed * self.ChargeDashSpeedMultiplier
		log("MonsterAI: charge dash started, boosted ApproachSpeed=" .. self.ApproachSpeed)
	end

	-- 비행형(박쥐) 전용: 접근/도달 개념 없이 화면 안에서 2D로 자유롭게 날아다니다가, FlyAttackInterval마다 계속 공격한다.
	-- X/Y를 서로 다른 각속도의 사인파로 동시에 움직여(리사주 곡선) 항상 두 축이 같이 바뀌는 궤적을 만든다.
	@ExecSpace("ServerOnly")
	method void UpdateFlying(number delta)
		-- 스턴/속박(ApplyStun) 중에는 지상 몬스터처럼 완전히 멈춰야 한다 — ApproachSpeed=0만으로는
		-- 공중 몬스터(사인파 기반 UpdateFlying)를 막지 못해서 별도로 체크한다. 완전빙결도 동일하다.
		if self._isStunned or self._isHardFrozen then return end
		self._flyTime = self._flyTime + delta
		local x = self._flyCenterX + math.sin(self._flyTime * self.FlySpeedX * self._flySpeedMultX + self._flyPhaseX) * self.FlyRangeX
		local yAmplitude = (self.FlyingWanderMaxY - self.FlyingWanderMinY) * 0.5
		local y = self._flyBaseY + math.sin(self._flyTime * self.FlySpeedY * self._flySpeedMultY + self._flyPhaseY) * yAmplitude
		local pos = self.Entity.TransformComponent.Position
		self.Entity.TransformComponent.Position = Vector3(x, y, pos.z)
		
		-- 무리원(_isSwarmMember) 전용 — CardManager.FindTarget()은 살아있는 몬스터 중 _currentScale이
		-- 가장 큰 "단 하나"만 매 프레임 고정 타겟으로 고른다(전 게임 공통 로직, 엄격한 > 비교라 동률이면
		-- 먼저 나온 쪽이 계속 이긴다). 일반 몬스터는 접근하며 스케일이 계속 자라 자연히 타겟이 바뀌는데,
		-- 미니빈은 스케일이 고정이라 그중 한 마리(스케일이 가장 낮게 뽑힌 개체)가 다른 개체들이 전부
		-- 죽기 전까지 영원히 타겟에서 배제됐다(유저 리포트: "현재 공격하는 한마리는 플레이어가 공격
		-- 자체를 못함"). 각자 비행 위상(_flyPhaseX, 스폰 시 이미 개별 랜덤)에 맞춰 아주 작게(±2%,
		-- 육안으로는 거의 안 보임 — 유저가 뺀 "커졌다 작아졌다"는 공격 순간의 큰 들이받기 펌프였지 이
		-- 미세한 상시 진동이 아니다) 흔들어서, 매 순간 "제일 큰" 개체가 무리 안에서 계속 돌아가며
		-- 바뀌게 한다.
		if self._isSwarmMember then
			local swarmScale = 1.0 + math.sin(self._flyTime * 1.7 + self._flyPhaseX) * 0.02
			self._currentScale = swarmScale
			self.Entity.TransformComponent.Scale = Vector3(swarmScale * self._scaleMultiplier, swarmScale * self._scaleMultiplier, 1.0)
		end
		
		self._attackTimer = self._attackTimer - delta
		if self._attackTimer <= 0 then
			-- 미니무르/_neverAttacks(노란 미니빈 등)는 순수 이스터에그용(플레이어를 공격하지 않음) —
			-- 공격 판정 자체를 건너뛴다. _neverAttacks는 원래 지상형 분기(_reachedPlayer)에서만
			-- 체크되고 있었는데, 비행형은 이 분기를 아예 안 타서 무시되고 있었다.
			if not self._isMiniMoore and not self._neverAttacks then
				self:OnReachPlayer()
			end
			self._attackTimer = self.FlyAttackInterval
		end
	end

	-- MonsterSpawner.EndBonusStage()가 보너스 보스 지속시간 종료 시 호출 — 즉시 사라지는 대신
	-- 바닥에 먼지를 일으키고 위로 붕 뜨며 점점 투명해지다가 사라지는 연출 후 파괴한다
	@ExecSpace("ServerOnly")
	method void PlayDespawnJump()
		local map = self.Entity.CurrentMap
		local startPos = self.Entity.TransformComponent.Position
		if map ~= nil then
			-- Entity.CurrentMap은 물리적 최상위 맵 엔티티(맵 루트)를 가리키는데, 이 몬스터의 실제
			-- 부모는 Zone12 같은 오프셋을 가진 자식 컨테이너일 수 있다 — 이 경우 로컬(startPos)과
			-- 루트 기준 좌표가 어긋나므로, SpawnByModelId(parent=map=루트)에 넘길 좌표는 반드시
			-- WorldPosition으로 다시 구해야 한다(실측: 안 그러면 먼지가 몬스터 옆이 아니라 존 오프셋만큼
			-- 떨어진 엉뚱한 곳에서 뜬다).
			local worldPos = self.Entity.TransformComponent.WorldPosition
			local dustPos = Vector3(worldPos.x, worldPos.y - 0.35, worldPos.z + 0.1)
			local dust = _SpawnService:SpawnByModelId("skilleffect", "Dust", dustPos, map)
			if dust ~= nil then
				local r = dust.SpriteRendererComponent
				if r ~= nil then r.SpriteRUID = "98262e9a441d41abb19a6d519f74aec7" end
				dust:Destroy(0.5)
			end
		end
		
		local duration = 0.6
		local jumpHeight = 3.0
		_TweenLogic:PlayTween(0.0, 1.0, duration, EaseType.QuadEaseIn, function(t)
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local y = startPos.y + jumpHeight * t
			self.Entity.TransformComponent.Position = Vector3(startPos.x, y, startPos.z)
			local renderer = self.Entity.SpriteRendererComponent
			if renderer ~= nil then renderer.Color = Color(1, 1, 1, 1.0 - t) end
		end)
		
		self.Entity:Destroy(duration + 0.05)
	end

	@ExecSpace("ServerOnly")
	method void UpdateDepth()
		-- 스케일이 작을수록(멀리 있을수록) Z를 크게 해서 뒤로 깔리고,
		-- 스케일이 커질수록(가까이 다가올수록) Z를 작게 해서 앞으로 나오게 한다
		local pos = self.Entity.TransformComponent.Position
		local depth = 1.5 - self._currentScale - self._depthTieBreak
		self.Entity.TransformComponent.Position = Vector3(pos.x, pos.y, depth)
		
		-- 깊이 오버레이 알파도 같이 갱신: 스폰(0.3) 시점엔 DepthOverlayMaxAlpha(가장 어두움),
		-- 도달 임계값(_reachedScaleThreshold — 근접/원거리 몬스터마다 다름)에 가까워질수록 0(원래 색)으로 선형 보간
		local overlay = self:GetDepthOverlayRenderer()
		if overlay ~= nil then
			local span = self._reachedScaleThreshold - 0.3
			local t = 0
			if span > 0 then t = (self._currentScale - 0.3) / span end
			if t < 0 then t = 0 elseif t > 1 then t = 1 end
			overlay.Color = Color(0, 0, 0, self.DepthOverlayMaxAlpha * (1 - t))
		end
	end

	-- .model의 "DepthOverlay" 자식 엔티티(같은 스프라이트를 검게 덧씌운 깊이감 연출용)의
	-- SpriteRendererComponent를 찾아 캐시해둔다. Color/SpriteRUID는 전부 @Sync 네이티브 필드라
	-- 서버에서 이 캐시를 통해 값만 바꾸면 클라이언트에 자동 반영된다(ApplySlow와 동일한 방식).
	@ExecSpace("ServerOnly")
	method SpriteRendererComponent GetDepthOverlayRenderer()
		if self._depthOverlayRenderer == nil then
			local overlayEntity = self.Entity:GetChildByName("DepthOverlay")
			if overlayEntity ~= nil then
				self._depthOverlayRenderer = overlayEntity.SpriteRendererComponent
			end
		end
		return self._depthOverlayRenderer
	end

	-- 오버레이가 실제 이 몬스터의 현재 외형(MonsterSprite)을 그대로 따라가도록 RUID를 동기화한다.
	-- 외형이 바뀌는 모든 지점(InitializeStats/InitializeBonusBoss)에서 호출해야 한다.
	@ExecSpace("ServerOnly")
	method void SyncDepthOverlaySprite()
		local overlay = self:GetDepthOverlayRenderer()
		if overlay ~= nil then
			overlay.SpriteRUID = self.MonsterSprite
		end
	end

	-- 스턴/완전빙결처럼 "행동불가"인 상태이상이 걸려있는 동안 본체 스프라이트가 애니메이션클립이면
	-- idle/move 포즈가 계속 재생돼 멈춰있는 것처럼 안 보이는 문제를 막는다. 본체뿐 아니라 그림자
	-- (DepthOverlay)도 별도의 SpriteRendererComponent 인스턴스라 독립적으로 재생되므로 같이 멈춰야
	-- 한다 — 둘 중 하나라도 걸려있으면 0, 둘 다 풀리면 1로 매번 다시 계산해서 두 효과가 겹칠 때도
	-- 서로 상대방이 아직 안 풀렸는데 먼저 풀린 쪽이 재생을 재개시켜버리는 일이 없게 한다.
	@ExecSpace("ServerOnly")
	method void UpdateAnimationFreeze()
		local rate = 1
		if self._isStunned or self._isHardFrozen then rate = 0 end
		local renderer = self.Entity.SpriteRendererComponent
		if renderer ~= nil then renderer.PlayRate = rate end
		local overlay = self:GetDepthOverlayRenderer()
		if overlay ~= nil then overlay.PlayRate = rate end
	end

	-- 접근 연출이 없는 특수 개체(비행형/보너스 보스)는 UpdateDepth의 점진적 페이드가 적용되지 않으므로
	-- 오버레이를 아예 꺼서(알파 0) 매번 다른 색으로 겹쳐 보이는 일이 없게 한다.
	@ExecSpace("ServerOnly")
	method void HideDepthOverlay()
		local overlay = self:GetDepthOverlayRenderer()
		if overlay ~= nil then overlay.Color = Color(0, 0, 0, 0) end
	end

	-- 몬스터 본체가 잠깐 다른 스프라이트(hitRUID/attackRUID)로 바뀌는 동안(PlayHitAnimation/
	-- PlayAttackAnimation) 오버레이가 여전히 이전 포즈 실루엣을 보여주면 서로 어긋나 보인다 — 그
	-- 구간만 꺼뒀다가, 본체가 원래 포즈로 돌아오는 시점에 맞춰 UpdateDepth()로 알파를 다시 정확히
	-- 계산해 복원한다. duration은 호출부의 실제 스프라이트 교체 지속시간과 반드시 같아야 한다
	-- (히트=HitFlashDuration, 공격=_attackDuration — mlua는 기본값 파라미터를 지원하지 않아 호출부마다 명시).
	@ExecSpace("ServerOnly")
	method void FlashHideDepthOverlay(number duration)
		self:HideDepthOverlay()
		_TimerService:SetTimerOnce(function()
			if isvalid(self) and not self._dead then self:UpdateDepth() end
		end, duration)
	end

	-- 망토 에픽/레전더리 "엘리트/보스 몬스터에게 주는 피해량 증가" — 자기 자신이 엘리트/보스일 때만
	-- 곱해진다. 일반 몬스터는 항상 1.0이라 계산에 영향 없음
	@ExecSpace("ServerOnly")
	-- 유물 힘의 마법석(9번) — 상태이상(스턴/빙결/슬로우/속박)에 걸린 적에게 주는 피해 배율.
	-- 상태이상이 하나도 없으면 1.0이라 일반 몬스터에게는 아무 영향이 없다.
	method number GetRelicAilmentDamageMult()
		if self._isStunned or self._isHardFrozen or self._isSlowed or self._isLevitating then
			return _RelicInventory:GetAilmentDamageMult()
		end
		return 1.0
	end

	method number GetGearEliteBossDamageMult()
		-- 유물 룬(3번)은 기획표가 "보스에게 가하는 피해"라 엘리트는 빼고 보스/보너스보스에만 건다.
		-- 장비 쪽 보너스는 기존대로 엘리트까지 포함한다(둘의 적용 범위가 다르다).
		local relicMult = 1.0
		if self._isBoss or self._isBonusBoss then
			relicMult = _RelicInventory:GetBossDamageMult()
		end
		if self._isElite or self._isBoss or self._isBonusBoss then
			return _GearEffectLogic:GetEliteBossDamageMult() * relicMult
		end
		return relicMult
	end

	@ExecSpace("ServerOnly")
	method void TakeDamage(number damage)
		-- 카드 공격 시 호출
		if self._dead then return end
		if self._isCauldron and self._cauldronLocked then return end
		self._lastHitWasCrit = false
		damage = damage * self:GetGearEliteBossDamageMult() * self:GetRelicAilmentDamageMult()
		if self._isBonusBoss then
			if self._bonusBossCombatLocked then return end
			-- 버그 수정(2026-08-26, 유저 리포트 "죽는 연출 2번 나오는거같아") — 킬링 블로우에서 히트
			-- 애니메이션 직후 곧바로 사망 연출이 스프라이트를 또 덮어써서 두 연출이 몇 프레임 간격으로
			-- 겹쳐 보였다 — 이 타격으로 죽는지 미리 계산해, 죽는 타격이면 히트 애니메이션은 건너뛰고
			-- 바로 사망 연출로 넘어간다.
			local willDie = self._bonusBossKillable and (self.CurrentHp - damage) <= 0
			self:PlayDamageSkin(damage, false)
			if not willDie then self:PlayHitAnimation(self._hitRUID, self.MonsterSprite) end
			self:OnBonusBossHit()
			if self._bonusBossKillable then
				self.CurrentHp = self.CurrentHp - damage
				if self.CurrentHp <= 0 then self:OnBonusBossDefeated() end
			end
			return
		end
		if self._isMiniMoore then
			-- 전투 대상이 아니다 — 타격을 완전히 무시한다(반응/보상 없음, RollMiniMooreDrop이 별도로 처리)
			return
		end
		self.CurrentHp = self.CurrentHp - damage
		if self._isErdas then self:ApplyErdasHitGrowth() end
		log("Monster HP: " .. self.CurrentHp .. "/" .. self.MaxHp)
		self:PlayDamageSkin(damage, false)
		self:PlayHitAnimation(self._hitRUID, self.MonsterSprite)
		self:FlashHideDepthOverlay(self.HitFlashDuration)
		if self.CurrentHp <= 0 then
			self:Die()
		end
	end

	@ExecSpace("Multicast")
	method void PlayHitAnimation(string hitRUID, string standRUID)
		if self:IsServer() then return end
		if self._dead then return end
		if self._hitSoundRUID ~= "" then _SoundOptionLogic:PlaySfx(self._hitSoundRUID, 1.0) end
		local renderer = self.Entity.SpriteRendererComponent
		if renderer == nil or hitRUID == "" then return end
		renderer.SpriteRUID = hitRUID
		-- OnSyncProperty(MonsterSprite)가 이 재생 중에 되돌리지 못하도록 표시(MonsterAI 상단
		-- _isPlayingTransientSprite 주석 참고). 세대 번호로 겹치는 호출 중 최신 것만 실제로 되돌린다
		-- (위 _transientSpriteGeneration 주석 참고).
		self._isPlayingTransientSprite = true
		self._transientSpriteGeneration = self._transientSpriteGeneration + 1
		local myGeneration = self._transientSpriteGeneration
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			if self._transientSpriteGeneration ~= myGeneration then return end
			-- 죽음(일반 사망이든 예티류의 1→2페이즈 변신이든)으로 이미 전환된 뒤라면 절대 건드리지 않는다 —
			-- 이 함수는 Multicast라 서버의 TakeDamage가 같은 프레임에 보낸 PlayPhase1TransformAnimation/
			-- PlayDeathAnimation과 클라이언트 도착 순서가 보장되지 않는다. 순서가 뒤집히면(변신 연출이 먼저
			-- 도착해 die1로 바뀐 뒤 이 히트 복원 타이머가 나중에 stand로 되돌리는 경우) 변신 중인 몬스터가
			-- 잠깐 원래 1페이즈 stand 포즈로 보였다가 사라진 것처럼 보이는 버그가 있었다(유저 리포트 —
			-- "페이즈 2 변화하다가 그냥 사라져"). _dead를 한 번 더 확인해 die1/변신 중에는 복원을 건너뛴다.
			if self._dead then
				self._isPlayingTransientSprite = false
				return
			end
			-- hit1 상태일 때만 stand로 복원 — die1로 전환된 뒤라면 그대로 둔다
			if renderer.SpriteRUID == hitRUID then
				renderer.SpriteRUID = standRUID
			end
			self._isPlayingTransientSprite = false
		end, self.HitFlashDuration)
	end

	-- 엔진 기본 내장 데미지 스킨(실제 메이플스토리와 동일한 숫자 그래픽/트윈)을 재생한다.
	-- TakeDamage/TakeDamageCrit는 ServerOnly라 시각 연출은 별도 Multicast로 클라이언트에서만 재생한다.
	@ExecSpace("Multicast")
	method void PlayDamageSkin(number damage, boolean isCritical)
		if self:IsServer() then return end
		_DamageSkinService:Play(self.Entity, self._damageSkinId, 0.05, { math.floor(damage) }, DamageSkinTweenType.Default, isCritical)
	end

	-- PlayDamageSkin과 동일하지만 화면 오프셋을 지정할 수 있다 — 강화 애로우 블로우(카드117)처럼
	-- 짧은 간격으로 같은 좌표에 여러 번 맞을 때 대미지 숫자가 겹쳐 보이지 않도록 호출부에서 수평
	-- 오프셋을 줄 때 사용한다.
	@ExecSpace("Multicast")
	method void PlayDamageSkinWithOffset(number damage, boolean isCritical, Vector2 offset)
		if self:IsServer() then return end
		_DamageSkinService:Play(self.Entity, self._damageSkinId, 0.05, { math.floor(damage) }, DamageSkinTweenType.Default, isCritical, offset)
	end

	-- TakeDamage와 동일하지만 대미지 숫자 표시에 오프셋을 줄 수 있다(용도: 위 PlayDamageSkinWithOffset 참고)
	@ExecSpace("ServerOnly")
	method void TakeDamageWithOffset(number damage, Vector2 offset)
		if self._dead then return end
		if self._isCauldron and self._cauldronLocked then return end
		if self._isBonusBoss then
			if self._bonusBossCombatLocked then return end
			-- 버그 수정(2026-08-26) — TakeDamage와 동일 이유(킬링 블로우 히트+사망 연출 겹침 방지)
			local willDie = self._bonusBossKillable and (self.CurrentHp - damage) <= 0
			self:PlayDamageSkinWithOffset(damage, false, offset)
			if not willDie then self:PlayHitAnimation(self._hitRUID, self.MonsterSprite) end
			self:OnBonusBossHit()
			if self._bonusBossKillable then
				self.CurrentHp = self.CurrentHp - damage
				if self.CurrentHp <= 0 then self:OnBonusBossDefeated() end
			end
			return
		end
		if self._isMiniMoore then
			return
		end
		self.CurrentHp = self.CurrentHp - damage
		if self._isErdas then self:ApplyErdasHitGrowth() end
		log("Monster HP: " .. self.CurrentHp .. "/" .. self.MaxHp)
		self:PlayDamageSkinWithOffset(damage, false, offset)
		self:PlayHitAnimation(self._hitRUID, self.MonsterSprite)
		self:FlashHideDepthOverlay(self.HitFlashDuration)
		if self.CurrentHp <= 0 then
			self:Die()
		end
	end

	-- TakeDamageCrit와 동일하지만 대미지 숫자 표시에 오프셋을 줄 수 있다(용도: 위 PlayDamageSkinWithOffset 참고)
	@ExecSpace("ServerOnly")
	method void TakeDamageCritWithOffset(number damage, Vector2 offset)
		if self._dead then return end
		if self._isCauldron and self._cauldronLocked then return end
		self._lastHitWasCrit = true
		damage = damage * (1.0 + _CardManager:GetCriticalShotBonus() + _CardManager:GetKarmaBonus() + _RelicInventory:GetCritDamageBonus())
		-- 장비 치명타 피해 보너스(자마다르 에픽 상시 / 레전더리 확률 버프) — 모든 크리티컬이
		-- 이 두 진입점(TakeDamageCrit / TakeDamageCritWithOffset)만 거치므로 개별 스킬의
		-- `damage * 2` 호출부를 전부 건드릴 필요가 없다
		damage = damage * (1.0 + _GearEffectLogic:GetCritDamageBonus()) * self:GetGearEliteBossDamageMult() * self:GetRelicAilmentDamageMult()
		if self._isBonusBoss then
			if self._bonusBossCombatLocked then return end
			-- 버그 수정(2026-08-26) — TakeDamage와 동일 이유(킬링 블로우 히트+사망 연출 겹침 방지)
			local willDie = self._bonusBossKillable and (self.CurrentHp - damage) <= 0
			self:PlayDamageSkinWithOffset(damage, true, offset)
			if not willDie then self:PlayHitAnimation(self._hitRUID, self.MonsterSprite) end
			self:OnBonusBossHit()
			if self._bonusBossKillable then
				self.CurrentHp = self.CurrentHp - damage
				if self.CurrentHp <= 0 then self:OnBonusBossDefeated() end
			end
			return
		end
		if self._isMiniMoore then
			return
		end
		self.CurrentHp = self.CurrentHp - damage
		if self._isErdas then self:ApplyErdasHitGrowth() end
		log("Monster HP (CRIT): " .. self.CurrentHp .. "/" .. self.MaxHp)
		self:PlayDamageSkinWithOffset(damage, true, offset)
		self:PlayHitAnimation(self._hitRUID, self.MonsterSprite)
		self:FlashHideDepthOverlay(self.HitFlashDuration)
		if self.CurrentHp <= 0 then
			self:Die()
		end
	end

	@ExecSpace("ServerOnly")
	method void TakeDamageCrit(number damage)
		if self._dead then return end
		if self._isCauldron and self._cauldronLocked then return end
		self._lastHitWasCrit = true
		-- 크리티컬 샷(카드111, 실피드 전용 패시브) + 카르마(카드182, 쉐이드 전용 패시브) 보너스 —
		-- 모든 크리티컬 대미지에 추가 배율 적용(같은 런에서 둘 다 활성일 수 없어 가산해도 안전)
		damage = damage * (1.0 + _CardManager:GetCriticalShotBonus() + _CardManager:GetKarmaBonus() + _RelicInventory:GetCritDamageBonus())
		-- 장비 치명타 피해 보너스(자마다르 에픽 상시 / 레전더리 확률 버프) — 모든 크리티컬이
		-- 이 두 진입점(TakeDamageCrit / TakeDamageCritWithOffset)만 거치므로 개별 스킬의
		-- `damage * 2` 호출부를 전부 건드릴 필요가 없다
		damage = damage * (1.0 + _GearEffectLogic:GetCritDamageBonus()) * self:GetGearEliteBossDamageMult() * self:GetRelicAilmentDamageMult()
		if self._isBonusBoss then
			if self._bonusBossCombatLocked then return end
			-- 버그 수정(2026-08-26) — TakeDamage와 동일 이유(킬링 블로우 히트+사망 연출 겹침 방지)
			local willDie = self._bonusBossKillable and (self.CurrentHp - damage) <= 0
			self:PlayDamageSkin(damage, true)
			if not willDie then self:PlayHitAnimation(self._hitRUID, self.MonsterSprite) end
			self:OnBonusBossHit()
			if self._bonusBossKillable then
				self.CurrentHp = self.CurrentHp - damage
				if self.CurrentHp <= 0 then self:OnBonusBossDefeated() end
			end
			return
		end
		if self._isMiniMoore then
			-- 전투 대상이 아니다 — 타격을 완전히 무시한다(반응/보상 없음, RollMiniMooreDrop이 별도로 처리)
			return
		end
		self.CurrentHp = self.CurrentHp - damage
		if self._isErdas then self:ApplyErdasHitGrowth() end
		log("Monster HP (CRIT): " .. self.CurrentHp .. "/" .. self.MaxHp)
		self:PlayDamageSkin(damage, true)
		self:PlayHitAnimation(self._hitRUID, self.MonsterSprite)
		self:FlashHideDepthOverlay(self.HitFlashDuration)
		if self.CurrentHp <= 0 then
			self:Die()
		end
	end

	-- 플레시 미라주(카드108) 전용 — TakeDamage/TakeDamageCrit와 동일하지만, HP가 0 이하가 돼도
	-- 즉시 Die()하지 않고 deathDelay(=넉백 이동 시간) 뒤로 미룬다(유저 요청: "대미지가 들어가도
	-- 즉시 죽지말고 넉백은하고 죽기"). damage는 다른 TakeDamage 계열과 동일하게 크리티컬이면
	-- 호출부에서 이미 2배로 넘어온 값이고, isCrit은 데미지 스킨(연출) 표시용일 뿐이다.
	@ExecSpace("ServerOnly")
	method void TakeDamageDelayedDeath(number damage, boolean isCrit, number deathDelay)
		if self._dead then return end
		if self._isCauldron and self._cauldronLocked then return end
		-- 크리티컬 샷(카드111)/카르마(카드182) 보너스 — 크리티컬 경로에서만 추가 배율 적용
		if isCrit then damage = damage * (1.0 + _CardManager:GetCriticalShotBonus() + _CardManager:GetKarmaBonus() + _RelicInventory:GetCritDamageBonus()) end
		if self._isBonusBoss then
			if self._bonusBossCombatLocked then return end
			-- 버그 수정(2026-08-26) — TakeDamage와 동일 이유(킬링 블로우 히트+사망 연출 겹침 방지)
			local willDie = self._bonusBossKillable and (self.CurrentHp - damage) <= 0
			self:PlayDamageSkin(damage, isCrit)
			if not willDie then self:PlayHitAnimation(self._hitRUID, self.MonsterSprite) end
			self:OnBonusBossHit()
			if self._bonusBossKillable then
				self.CurrentHp = self.CurrentHp - damage
				if self.CurrentHp <= 0 then self:OnBonusBossDefeated() end
			end
			return
		end
		if self._isMiniMoore then
			return
		end
		self.CurrentHp = self.CurrentHp - damage
		if self._isErdas then self:ApplyErdasHitGrowth() end
		log("Monster HP (delayed-death): " .. self.CurrentHp .. "/" .. self.MaxHp)
		self:PlayDamageSkin(damage, isCrit)
		self:PlayHitAnimation(self._hitRUID, self.MonsterSprite)
		self:FlashHideDepthOverlay(self.HitFlashDuration)
		if self.CurrentHp <= 0 then
			_TimerService:SetTimerOnce(function()
				if isvalid(self) and not self._dead then self:Die() end
			end, deathDelay)
		end
	end

	-- 보너스 보스는 사실상 무적 — 맞을 때마다(죽음 없이) 골드는 무조건, 포션/스킬은 각각 확률적으로 지급한다
	@ExecSpace("ServerOnly")
	method void OnBonusBossHit()
		_GameManager:AddGold(self.BonusGoldPerHit)
		-- ForceDropPotion/OnEliteKilled는 파라미터 이름부터 worldPos일 정도로 월드 좌표를 기대한다
		-- (화면 좌표 환산·다른 부모 하위 스폰에 쓰임) — 로컬 Position을 넘기면 존 오프셋만큼 어긋난다.
		local dropScale = _CardManager:GetEffectScaleRatio(self)
		if _UtilLogic:RandomDouble() < self.BonusPotionChance then
			_GameManager:ForceDropPotion(self.Entity.TransformComponent.WorldPosition, dropScale)
		end
		if _UtilLogic:RandomDouble() < self.BonusSkillChance then
			-- 보너스 보스는 비행형이 아니라 사망 위치가 항상 바닥이므로 fallHeight=0 고정(groundWorldY는 미사용)
			local wp = self.Entity.TransformComponent.WorldPosition
			_CardManager:OnEliteKilled(wp, 0, wp.y, dropScale)
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplySlow(number duration)
		-- 유물 시몬수의자(2번) — 모든 상태이상 지속시간을 늘린다. 각 Apply* 진입점에서 한 번씩만 곱한다
		duration = duration * _RelicInventory:GetAilmentDurationMult()
		-- 이동속도를 50% 감소. 중복 적용 시 타이머만 갱신 (속도 이중 감소 방지)
		if not self._isSlowed then
			self.ApproachSpeed = self.ApproachSpeed * 0.5
			self._isSlowed = true
			-- 슬로우 상태를 눈에 보이게 하늘색으로 틴트. 알파는 반드시 1.0(불투명) — 원작 메이플스토리의
			-- 빙결 연출처럼 몸 전체가 통짜 색으로 바뀌는 느낌을 내기 위함이고, 알파를 낮추면(반투명) 몬스터끼리
			-- 겹칠 때 뒤에 있는 몬스터가 비쳐 보여 지저분해 보인다(깊이 오버레이와는 별개 문제).
			-- (SpriteRendererComponent.Color는 @Sync라 서버에서 바꾸면 클라이언트에 자동 반영)
			local renderer = self.Entity.SpriteRendererComponent
			if renderer ~= nil then renderer.Color = Color(0.6, 0.85, 1.0, 1.0) end
		end
		if self._slowTimerId ~= 0 then
			_TimerService:ClearTimer(self._slowTimerId)
		end
		self._slowTimerId = _TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(self.Entity) then return end
			self._slowTimerId = 0
			if not self._isSlowed then return end
			if self._freezeSlowed then return end  -- 빙결이 슬로우 유지 중
			self.ApproachSpeed = self.ApproachSpeed * 2.0
			self._isSlowed = false
			local renderer = self.Entity.SpriteRendererComponent
			if renderer ~= nil then renderer.Color = Color(1, 1, 1, 1) end
		end, duration)
	end

	-- showIndicator=true: 썬더볼트 감전처럼 머리 위 빙글빙글 도는 별 이펙트를 같이 띄운다.
	-- false: 아쿠아 트랩처럼 자체 연출(물 구속구)이 따로 있어 별 이펙트가 필요 없는 경우.
	@ExecSpace("ServerOnly")
	method void ApplyStun(number duration, boolean showIndicator)
		-- 유물 시몬수의자(2번) — 상태이상 지속시간 증가
		duration = duration * _RelicInventory:GetAilmentDurationMult()
		-- 잠깐 완전히 멈췄다가 원래 속도로 돌아온다. 중복 적용 시 타이머만 갱신
		if not self._isStunned then
			self._stunSavedSpeed = self.ApproachSpeed
			self.ApproachSpeed = 0
			self._isStunned = true
			self:UpdateAnimationFreeze()
			if showIndicator then self:SpawnStunStars() end
		end
		if self._stunTimerId ~= 0 then
			_TimerService:ClearTimer(self._stunTimerId)
		end
		self._stunTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(self) and isvalid(self.Entity) and self._isStunned then
				self.ApproachSpeed = self._stunSavedSpeed
				self._isStunned = false
				self._stunTimerId = 0
				self:UpdateAnimationFreeze()
				self:DestroyStunStars()
				-- 아쿠아 트랩/서지는 ApplyStun과 ApplyLevitate를 같은 duration으로 같이 걸지만 둘은
				-- 완전히 독립된 타이머다 — 다른 스킬(예: 썬더볼트)이 같은 대상에게 더 짧은 스턴을
				-- 다시 걸면 ApplyStun 쪽만 먼저 풀리고 ApplyLevitate는 원래(더 긴) 자기 타이머대로
				-- 계속 떠 있어서, "속박(스턴)은 풀렸는데 공중에 계속 떠 있는" 것처럼 보이는 불일치가
				-- 있었다 — 스턴이 풀리는 시점에 아직 떠 있다면 그때 바로 착지시켜 동기화한다.
				if self._isLevitating then self:LandFromLevitate(0.2) end
			end
		end, duration)
	end

	-- 연막탄(쉐이드 Card174) 전용 — 이 몬스터의 플레이어 공격 명중률을 missChance만큼 낮춘다(실제
	-- 적용은 OnReachPlayer에서 확률 굴림). 재적용 시(연막이 겹치거나 다음 틱마다 갱신) 확률·타이머 모두
	-- 최신 값으로 덮어쓴다 — 스턴과 달리 상태 플래그가 따로 없어 단순히 값만 갱신하면 된다.
	@ExecSpace("ServerOnly")
	method void ApplyAccuracyDebuff(number missChance, number duration)
		self._accuracyDebuffPercent = missChance
		if self._accuracyDebuffTimerId ~= 0 then
			_TimerService:ClearTimer(self._accuracyDebuffTimerId)
		end
		self._accuracyDebuffTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(self) then
				self._accuracyDebuffPercent = 0
				self._accuracyDebuffTimerId = 0
			end
		end, duration)
	end

	-- 얼음 파편 아이템 전용 완전 빙결 — 행동불가 + 진한 파란색. 재적용 시 타이머만 갱신(더 늦게 죽은
	-- 몬스터가 새로 얼어도 남은 시간이 갱신되도록)
	@ExecSpace("ServerOnly")
	method void ApplyHardFreeze(number duration)
		-- 유물 시몬수의자(2번) — 상태이상 지속시간 증가
		duration = duration * _RelicInventory:GetAilmentDurationMult()
		-- _dead 체크를 여기서 하지 않는다 — 스폰 재사용 엔티티가 죽은 적 없는데도 _dead=true로
		-- 읽히는 잔존 버그(InitializeStats 참고)에 걸리면 이 가드가 얼려야 할 몬스터를 조용히
		-- 건너뛰어버렸다("아이템 먹었는데 안 얼어있다" 버그의 원인). 실제 사망 처리는 OnUpdate
		-- 맨 앞의 _dead 체크(행동 자체를 막음)가 이미 담당하므로 여기서 또 막을 필요가 없다.
		if not self._isHardFrozen then
			self._isHardFrozen = true
			local renderer = self.Entity.SpriteRendererComponent
			if renderer ~= nil then
				self._preHardFreezeColor = renderer.Color
				renderer.Color = Color(0.35, 0.55, 1.0, 1.0)
			end
			-- 색만 바꾸면 스프라이트 자체가 animationclip인 경우(걷기/서있기 등) 자체 재생이
			-- 계속 돌아서 "얼어서 행동은 못 하는데 방방 뛰는 idle 연출은 계속 재생되는" 것처럼
			-- 보였다 — PlayRate=0으로 지금 프레임에 그대로 멈춘다(본체+그림자 둘 다, UpdateAnimationFreeze 참고).
			self:UpdateAnimationFreeze()
		end
		if self._hardFreezeTimerId ~= 0 then
			_TimerService:ClearTimer(self._hardFreezeTimerId)
		end
		self._hardFreezeTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(self) and isvalid(self.Entity) and self._isHardFrozen then
				self._isHardFrozen = false
				self._hardFreezeTimerId = 0
				local renderer = self.Entity.SpriteRendererComponent
				if renderer ~= nil then
					renderer.Color = self._preHardFreezeColor
				end
				self:UpdateAnimationFreeze()
			end
		end, duration)
	end

	@ExecSpace("ServerOnly")
	method void SpawnStunStars()
		-- 머리 위에 뺑글뻉글 도는 별 이펙트를 스폰한다 (색상 틴트 대신 사용)
		if isvalid(self._stunStarsIndicator) then return end
		local map = self.Entity.CurrentMap
		if map == nil then return end
		-- map(=CurrentMap)은 맵 루트라 로컬 Position이 아니라 WorldPosition을 써야 존 오프셋과 맞는다
		local pos = self.Entity.TransformComponent.WorldPosition
		local starPos = Vector3(pos.x, pos.y + 0.9, pos.z - 0.1)
		self._stunStarsIndicator = _SpawnService:SpawnByModelId("stunstars", "StunStars", starPos, map)
	end

	@ExecSpace("ServerOnly")
	method void DestroyStunStars()
		if isvalid(self._stunStarsIndicator) then
			self._stunStarsIndicator:Destroy()
			self._stunStarsIndicator = nil
		end
	end

	@ExecSpace("ServerOnly")
	method void AddFreezeStack()
		-- 프리징 이펙트 패시브가 활성화된 경우에만 동작
		if _CardManager.FreezingEffectLevel <= 0 then return end
		if self._dead then return end
		if self.FreezeStack >= 5 then return end
		self.FreezeStack = self.FreezeStack + 1
		-- 첫 스택에서 슬로우 적용 (아직 freeze-slow가 없을 때만)
		if self.FreezeStack == 1 and not self._freezeSlowed then
			if not self._isSlowed then
				self.ApproachSpeed = self.ApproachSpeed * 0.5
				self._isSlowed = true
				local renderer = self.Entity.SpriteRendererComponent
				if renderer ~= nil then renderer.Color = Color(0.6, 0.85, 1.0, 1.0) end
			end
			self._freezeSlowed = true
		end
		self:UpdateFreezeIndicator()
		log("AddFreezeStack: stack=" .. self.FreezeStack)
	end

	@ExecSpace("ServerOnly")
	method void ResetFreezeStack()
		if self.FreezeStack <= 0 then return end
		self.FreezeStack = 0
		if self._freezeSlowed then
			self._freezeSlowed = false
			-- ColdBeam 슬로우 타이머가 없으면 freeze slow 직접 해제
			if self._slowTimerId == 0 and self._isSlowed then
				self.ApproachSpeed = self.ApproachSpeed * 2.0
				self._isSlowed = false
				local renderer = self.Entity.SpriteRendererComponent
				if renderer ~= nil then renderer.Color = Color(1, 1, 1, 1) end
			end
			-- _slowTimerId != 0이면 타이머가 _freezeSlowed=false를 보고 자동 해제
		end
		self:UpdateFreezeIndicator()
	end

	@ExecSpace("ServerOnly")
	method void UpdateFreezeIndicator()
		local map = self.Entity.CurrentMap
		if map == nil then return end
		-- map(=CurrentMap)은 맵 루트라 로컬 Position이 아니라 WorldPosition을 써야 존 오프셋과 맞는다
		local pos = self.Entity.TransformComponent.WorldPosition
		local iPos = Vector3(pos.x + 0.45, pos.y - 0.40, pos.z - 0.05)
		if self.FreezeStack <= 0 then
			if isvalid(self._freezeIndicator) then
				self._freezeIndicator:Destroy()
				self._freezeIndicator = nil
			end
			return
		end
		if not isvalid(self._freezeIndicator) then
			self._freezeIndicator = _SpawnService:SpawnByModelId("stackindicator-model-id", "FreezeStack", iPos, map)
			if isvalid(self._freezeIndicator) then
				local t = self._freezeIndicator.TextRendererComponent
				if t ~= nil then
					t.Font = "Maple"  -- 게임 전체 폰트 통일
					t.FontColor = Color(0.4, 0.8, 1.0, 1.0)
					t.Text = tostring(self.FreezeStack)
				end
			end
		else
			self._freezeIndicator.TransformComponent.Position = iPos
			local t = self._freezeIndicator.TextRendererComponent
			if t ~= nil then t.Text = tostring(self.FreezeStack) end
		end
	end

	-- 레이온 기본공격/슬래시/브랜디쉬가 적중할 때마다 호출 — 스택 자체엔 데미지 보너스가 없고, 5스택
	-- 도달 시 이 마지막 타격 데미지(lastHitDamage, 크리티컬 반영 후)의 200%를 폭발 데미지로 추가
	-- 적용한 뒤 초기화된다(파라미터 필수 — 기본값 파라미터는 mlua에서 Logic/Component 전체가 조용히
	-- nil이 되는 버그가 있어 사용하지 않는다).
	@ExecSpace("ServerOnly")
	method void AddComboStack(number lastHitDamage)
		if self._dead then return end
		if self.ComboStack >= 5 then return end
		self.ComboStack = self.ComboStack + 1
		self:UpdateComboIndicator()
		if self.ComboStack >= 5 then
			self:TriggerComboFinish(lastHitDamage)
		end
	end

	@ExecSpace("ServerOnly")
	method void ResetComboStack()
		if self.ComboStack <= 0 and not self:HasAnyComboOrb() then return end
		self.ComboStack = 0
		self:UpdateComboIndicator()
	end

	method boolean HasAnyComboOrb()
		return isvalid(self._comboOrb1) or isvalid(self._comboOrb2) or isvalid(self._comboOrb3)
			or isvalid(self._comboOrb4) or isvalid(self._comboOrb5)
	end

	method Entity GetComboOrb(integer idx)
		if idx == 1 then return self._comboOrb1
		elseif idx == 2 then return self._comboOrb2
		elseif idx == 3 then return self._comboOrb3
		elseif idx == 4 then return self._comboOrb4
		elseif idx == 5 then return self._comboOrb5
		end
		return nil
	end

	method void SetComboOrb(integer idx, Entity e)
		if idx == 1 then self._comboOrb1 = e
		elseif idx == 2 then self._comboOrb2 = e
		elseif idx == 3 then self._comboOrb3 = e
		elseif idx == 4 then self._comboOrb4 = e
		elseif idx == 5 then self._comboOrb5 = e
		end
	end

	method number GetComboOrbReveal(integer idx)
		if idx == 1 then return self._comboOrbReveal1
		elseif idx == 2 then return self._comboOrbReveal2
		elseif idx == 3 then return self._comboOrbReveal3
		elseif idx == 4 then return self._comboOrbReveal4
		elseif idx == 5 then return self._comboOrbReveal5
		end
		return 0
	end

	method void SetComboOrbReveal(integer idx, number v)
		if idx == 1 then self._comboOrbReveal1 = v
		elseif idx == 2 then self._comboOrbReveal2 = v
		elseif idx == 3 then self._comboOrbReveal3 = v
		elseif idx == 4 then self._comboOrbReveal4 = v
		elseif idx == 5 then self._comboOrbReveal5 = v
		end
	end

	-- 스택 개수만큼 오브 슬롯(1~5)을 켜고 끈다. 실제 위치/회전/프레임은 OnUpdate의
	-- UpdateComboOrbPositions가 매 프레임 갱신하므로 여기서는 존재 여부(스폰/제거)만 맞춘다.
	@ExecSpace("ServerOnly")
	method void UpdateComboIndicator()
		for i = 1, 5 do
			local orb = self:GetComboOrb(i)
			if i <= self.ComboStack then
				if not isvalid(orb) then
					local newOrb = _SpawnService:SpawnByModelId("comboorbeffect", "ComboOrb" .. i, Vector3(self.ComboOrbRadius, 0.3, -0.1), self.Entity)
					if newOrb ~= nil then
						local renderer = newOrb.SpriteRendererComponent
						if renderer ~= nil then
							renderer.SpriteRUID = _CardManager.ComboOrbRUID
							renderer.StartFrameIndex = 0
							renderer.EndFrameIndex = 0
						end
						self:SetComboOrbReveal(i, 0)
						self:SetComboOrb(i, newOrb)
					end
				end
			else
				if isvalid(orb) then
					orb:Destroy()
					self:SetComboOrb(i, nil)
				end
			end
		end
	end

	-- 켜져 있는 오브들을 몬스터 주위로 시계방향 원형 배치하고(유저 확인: 실제 게임처럼 스택 개수만큼
	-- 같은 오브가 원형으로 돎), 각 오브를 자기 슬롯 번호(i)까지 프레임 0→i를 순서대로 재생한 뒤
	-- 정지시킨다(유저 지정: "1->3(두번째 콤보)" 등 — 애니메이션 자동재생이 아니라 매 프레임
	-- StartFrameIndex=EndFrameIndex를 수동으로 갱신하는 "정지 프레임" 방식). y = -sin(...)으로
	-- 각도가 커질수록 아래로 향하게 해서 화면 기준 시계방향(오른쪽→아래→왼쪽→위)으로 돌게 한다.
	method void UpdateComboOrbPositions(number delta)
		if self.ComboStack <= 0 then return end
		self._comboOrbAngle = self._comboOrbAngle + delta * self.ComboOrbRotateSpeed
		local scale = _CardManager:GetEffectScaleRatio(self) * self.ComboOrbScaleMultiplier
		local step = (2 * math.pi) / self.ComboStack
		for i = 1, self.ComboStack do
			local orb = self:GetComboOrb(i)
			if isvalid(orb) then
				local a = self._comboOrbAngle + (i - 1) * step
				local x = math.cos(a) * self.ComboOrbRadius
				local y = 0.3 - math.sin(a) * self.ComboOrbRadius
				orb.TransformComponent.Position = Vector3(x, y, -0.1)
				orb.TransformComponent.Scale = Vector3(scale, scale, 1.0)
		
				local reveal = self:GetComboOrbReveal(i) + delta
				self:SetComboOrbReveal(i, reveal)
				local frame = math.min(i, math.floor(reveal / self.ComboOrbFrameStepDuration))
				local renderer = orb.SpriteRendererComponent
				if renderer ~= nil then
					renderer.StartFrameIndex = frame
					renderer.EndFrameIndex = frame
				end
			end
		end
	end

	-- Die() / 소멸 시점에 켜져 있는 오브 슬롯을 전부 정리한다
	method void ClearAllComboOrbs()
		for i = 1, 5 do
			local orb = self:GetComboOrb(i)
			if isvalid(orb) then
				orb:Destroy()
				self:SetComboOrb(i, nil)
			end
		end
	end

	-- 5스택 도달 시 자동으로 터지는 폭발 연출(리소스팩 "코마"의 finish/1~10 중 무작위 + 전용 사운드)
	-- 후 스택을 초기화한다. 유저 지정: "5개되면...코마처럼 자동으로 터지면 좋겠구먼"
	@ExecSpace("ServerOnly")
	method void TriggerComboFinish(number lastHitDamage)
		_CardManager:PlayComboFinishBurst(self, lastHitDamage)
		self:ResetComboStack()
	end

	@ExecSpace("ServerOnly")
	method void ApplyDot(number damagePerTick, integer ticks, number tickInterval)
		-- 도트 데미지 적용. 중복 시 이전 도트를 취소하고 새 도트로 덮어씀
		if self._dotTimerId ~= 0 then
			_TimerService:ClearTimer(self._dotTimerId)
			self._dotTimerId = 0
		end
		self._dotDamage = damagePerTick
		self._dotTicksLeft = ticks
		self._dotTimerId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self) or not isvalid(self.Entity) or self._dead then
				if self._dotTimerId ~= 0 then _TimerService:ClearTimer(self._dotTimerId) end
				self._dotTimerId = 0
				return
			end
			self:TakeDamage(self._dotDamage)
			self._dotTicksLeft = self._dotTicksLeft - 1
			if self._dotTicksLeft <= 0 then
				_TimerService:ClearTimer(self._dotTimerId)
				self._dotTimerId = 0
			end
		end, tickInterval)
	end

	-- 전투 중 넉백(예: 썬더 커터 Lv3) — 현재 스케일에서 targetScale까지 짧게 튕겨나가듯 줄어들며
	-- "맨 뒤로 밀려난다". PushBack()과 달리 상태이상 타이머는 건드리지 않는다(넉백이 슬로우/스턴/도트를
	-- 해제해서는 안 되므로) — 순수하게 접근 진행도(스케일)만 되돌린다.
	@ExecSpace("ServerOnly")
	method void ApplyKnockback(number targetScale)
		if self._dead or self._isFlying or self._isBonusBoss then return end
		if targetScale >= self._currentScale then return end
		self._reachedPlayer = false
		self._isPushingBack = true
		-- 먼지 이펙트 — "이어하기" PushBack()과 동일한 패턴(WorldPosition 사용, 존 오프셋 대응)
		local map = self.Entity.CurrentMap
		local worldPos = self.Entity.TransformComponent.WorldPosition
		if map ~= nil then
			local dustPos = Vector3(worldPos.x, worldPos.y - 0.35, worldPos.z + 0.1)
			local dust = _SpawnService:SpawnByModelId("skilleffect", "Dust", dustPos, map)
			if dust ~= nil then
				local r = dust.SpriteRendererComponent
				if r ~= nil then r.SpriteRUID = "98262e9a441d41abb19a6d519f74aec7" end
				dust:Destroy(0.5)
			end
		end
		local fromScale = self._currentScale
		_TweenLogic:PlayTween(0.0, 1.0, 0.35, EaseType.QuadEaseOut, function(t)
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local s = fromScale + (targetScale - fromScale) * t
			self._currentScale = s
			self.Entity.TransformComponent.Scale = Vector3(s * self._scaleMultiplier, s * self._scaleMultiplier, 1.0)
			self:UpdateDepth()
		end)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self._isPushingBack = false
		end, 0.35)
	end

	-- 플레시 미라주(카드108) 전용 — ApplyKnockback(스케일/접근진행도 기준)과 달리 실제 화면 X좌표를
	-- 가장자리(edgeX)까지 밀어붙이는 넉백. _isPushingBack을 그대로 재사용해 OnUpdate의 통상
	-- 이동·애니메이션 갱신을 잠가서(OnUpdate 최상단에서 이미 이 플래그를 체크해 즉시 리턴한다)
	-- 트윈과 충돌하지 않게 한다.
	@ExecSpace("ServerOnly")
	method void ApplyLateralShove(number edgeX, number duration)
		-- 이중 방어(2026-08-26, 유저 리포트 "보너스보스가 넉백맞고 사라짐") — CardManager.ClampKnockbackDestX가
		-- 보너스보스는 이제 제외하지만, 혹시 다른 경로로 clamp 없이 이 메서드가 직접 호출되더라도 보너스보스는
		-- ApplyKnockback과 동일하게 넉백 자체를 무시한다.
		if self._dead or self._isBonusBoss then return end
		self._isPushingBack = true
		local fromX = self.Entity.TransformComponent.Position.x
		_TweenLogic:PlayTween(0.0, 1.0, duration, EaseType.QuadEaseOut, function(t)
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local p = self.Entity.TransformComponent.Position
			local x = fromX + (edgeX - fromX) * t
			self.Entity.TransformComponent.Position = Vector3(x, p.y, p.z)
		end)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self._isPushingBack = false
		end, duration)
	end

	-- 속박류 CC(예: 아쿠아 트랩)에 맞았을 때 공중으로 살짝 떠오르는 연출 — duration 동안 떠 있다가
	-- 끝나는 시점에 맞춰 다시 내려온다. 비행 유닛은 이미 공중에 있으므로 띄우지 않는다.
	-- 이미 떠 있는 도중에 다시 걸리면(부스터로 쿨타임이 속박시간보다 짧아지면 실제로 발생) 기준
	-- 높이(_levitateBaseY)를 다시 잡지 않고 그대로 두고 착지 타이머만 새로 예약한다 — 안 그러면
	-- 매번 "지금(이미 떠 있는) 높이"를 새 기준으로 잡아버려서 기준 높이가 계속 위로 밀려 올라가
	-- 영영 안 내려오는 버그가 난다.
	@ExecSpace("ServerOnly")
	method void ApplyLevitate(number duration)
		if self._dead or self._isFlying then return end
		-- 유물 시몬수의자(2번) — 상태이상(속박) 지속시간 증가
		duration = duration * _RelicInventory:GetAilmentDurationMult()
		local liftHeight = 0.35
		local fallDuration = math.min(0.25, duration * 0.3)
		
		if not self._isLevitating then
			self._isLevitating = true
			self._levitateBaseY = self.Entity.TransformComponent.Position.y
			local baseY = self._levitateBaseY
			_TweenLogic:PlayTween(0.0, 1.0, fallDuration, EaseType.QuadEaseOut, function(t)
				if not isvalid(self) or not isvalid(self.Entity) then return end
				local pos = self.Entity.TransformComponent.Position
				self.Entity.TransformComponent.Position = Vector3(pos.x, baseY + liftHeight * t, pos.z)
			end)
		end
		
		if self._levitateTimerId ~= 0 then
			_TimerService:ClearTimer(self._levitateTimerId)
		end
		local baseY = self._levitateBaseY
		self._levitateTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(self) then self:LandFromLevitate(fallDuration) end
		end, math.max(0, duration - fallDuration))
	end

	-- 지금 위치에서 원래 지상 높이(_levitateBaseY)로 내려오는 트윈을 재생하고 부양 상태를 해제한다.
	-- 착지 타이머가 정상 만료됐을 때뿐 아니라, PushBack/Die처럼 상태이상을 강제로 정리하는 지점에서도
	-- 호출해서 몬스터가 공중에 뜬 채로 영영 남는 일이 없게 한다.
	@ExecSpace("ServerOnly")
	method void LandFromLevitate(number duration)
		if not self._isLevitating then return end
		self._isLevitating = false
		if self._levitateTimerId ~= 0 then
			_TimerService:ClearTimer(self._levitateTimerId)
			self._levitateTimerId = 0
		end
		if not isvalid(self) or not isvalid(self.Entity) then return end
		local baseY = self._levitateBaseY
		local liftHeight = 0.35
		_TweenLogic:PlayTween(1.0, 0.0, duration, EaseType.QuadEaseIn, function(t)
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local pos = self.Entity.TransformComponent.Position
			self.Entity.TransformComponent.Position = Vector3(pos.x, baseY + liftHeight * t, pos.z)
		end)
	end

	-- 이어하기 시 호출: 현재 스케일에서 0.85로 서버 트윈 (OnUpdate 잠금 후 복구)
	@ExecSpace("ServerOnly")
	method void PushBack()
		if self._dead then return end
		-- 상태이상 타이머 정리
		if self._slowTimerId ~= 0 then _TimerService:ClearTimer(self._slowTimerId) ; self._slowTimerId = 0 end
		if self._stunTimerId ~= 0 then _TimerService:ClearTimer(self._stunTimerId) ; self._stunTimerId = 0 end
		if self._dotTimerId ~= 0 then _TimerService:ClearTimer(self._dotTimerId) ; self._dotTimerId = 0 end
		self._isStunned = false
		self:DestroyStunStars()
		self._reachedPlayer = false
		-- 아쿠아 트랩으로 공중에 뜬 채였다면(예: "이어하기"로 밀려날 때) 여기서 강제로 착지시킨다 —
		-- 안 그러면 기존 착지 타이머가 뒤에서 따로 돌다가 꼬여서 영영 안 내려오는 경우가 생긴다.
		if self._isLevitating then self:LandFromLevitate(0.2) end
		
		-- 비행형(박쥐)은 접근/스케일 개념이 없으므로 되밀기 트윈 없이 배회만 잠깐 멈췄다 재개한다
		if self._isFlying then
			self._isPushingBack = true
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				self._isPushingBack = false
			end, 0.75)
			return
		end
		
		self._isPushingBack = true
		-- 먼지 이펙트 스폰 — 몬스터 바닥(y 최하단)에 붙도록 y 오프셋 적용. Entity.CurrentMap은 맵
		-- 루트를 가리키므로(Zone12 같은 자식 컨테이너가 아니라) 로컬 Position이 아니라 WorldPosition을
		-- 써야 한다 — 안 그러면 존 오프셋만큼 어긋난 곳에서 먼지가 뜬다(실측 확인 — "이어하기" 시 재현).
		local map = self.Entity.CurrentMap
		local pos = self.Entity.TransformComponent.WorldPosition
		if map ~= nil then
			local dustPos = Vector3(pos.x, pos.y - 0.35, pos.z + 0.1)
			local dust = _SpawnService:SpawnByModelId("skilleffect", "Dust", dustPos, map)
			if dust ~= nil then
				local r = dust.SpriteRendererComponent
				if r ~= nil then r.SpriteRUID = "98262e9a441d41abb19a6d519f74aec7" end
				dust:Destroy(0.5)
			end
		end
		-- 서버에서 직접 트윈: 현재 스케일 → 0.85 (TransformComponent.Scale이 클라에 자동 동기화)
		local fromScale = self._currentScale
		local toScale = 0.85
		local mult = self._scaleMultiplier
		_TweenLogic:PlayTween(0.0, 1.0, 0.7, EaseType.QuadEaseOut, function(t)
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local s = fromScale + (toScale - fromScale) * t
			self._currentScale = s
			self.Entity.TransformComponent.Scale = Vector3(s * mult, s * mult, 1.0)
			self:UpdateDepth()
		end)
		-- 트윈 완료 후 OnUpdate 재개 + 속도 복구
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self._currentScale = 0.85
			self.ApproachSpeed = _GameManager:GetWaveApproachSpeed(_GameManager.Wave)
			self._isPushingBack = false
		end, 0.75)
	end

	-- 스틸(CardManager.TriggerStealDrop)이 죽지 않은 몬스터를 맞춰서 드랍을 터뜨릴 때 쓰는, Die()의
	-- fallHeight/groundWorldY 계산 로직과 동일한 버전. Die()는 사망 직후 리셋되기 전의 값을 별도
	-- 로컬(wasLevitating)로 저장해서 쓰지만, 여기서는 몬스터가 아직 살아있으므로 현재 상태를 그대로
	-- 읽으면 된다(_isLevitating이 여기선 리셋되지 않음).
	@ExecSpace("ServerOnly")
	method table GetLootDropFallParams()
		local fallHeight = 0
		local groundWorldY = self.Entity.TransformComponent.WorldPosition.y
		if self._isFlying or self._isLevitating then
			local worldPos = self.Entity.TransformComponent.WorldPosition
			local map = self.Entity.CurrentMap
			if map ~= nil then
				---@type FootholdComponent
				local foothold = map:GetComponent("FootholdComponent")
				if foothold ~= nil then
					local hits = foothold:RaycastAll(Vector2(worldPos.x, worldPos.y), Vector2(0, -1), 50)
					local groundY = nil
					local bestDist = nil
					for i = 1, #hits do
						local h = hits[i]
						if not _MonsterSpawner:IsExcludedZone15Foothold(h.OwnerId) then
							local y = h:GetYByX(worldPos.x)
							local dist = worldPos.y - y
							if bestDist == nil or dist < bestDist then
								bestDist = dist
								groundY = y
							end
						end
					end
					if groundY ~= nil and worldPos.y > groundY then
						fallHeight = (worldPos.y - groundY) * 100
						groundWorldY = groundY
					end
				end
			end
		end
		local dropScale = _CardManager:GetEffectScaleRatio(self)
		return { fallHeight = fallHeight, groundWorldY = groundWorldY, dropScale = dropScale }
	end

	@ExecSpace("ServerOnly")
	method void Die()
		if self._dead then return end
		-- 거대 네펜데스 1페이즈는 진짜 죽지 않는다 — 죽는 연출만 재생한 뒤 2페이즈로 부활한다.
		-- 2페이즈(_giantNepenthesRevived=true)부터는 아래 일반 사망 처리로 그대로 흘러간다.
		if self._isGiantNepenthes and not self._giantNepenthesRevived then
			self:DieAndRevivePhase1()
			return
		end
		-- 예티/다크예티/예티와페페/다크예티와페페/주니어예티(에피소드3 map2) 범용 2페이즈 — 위 거대
		-- 네펜데스와 동일한 분기 구조. _phase2Chance(기본 1.0=항상)를 여기서 딱 1번만 굴린다 — 주니어
		-- 예티는 0.5라 절반은 그냥 평범하게 죽고(아래 일반 사망 처리로 흘러감) 나머지 절반만 die1 재생
		-- 후 성체 예티로 자란다.
		-- (2026-08-25 조사 노트: 유저 리포트 "가끔 페이즈 안바뀌고 바로 죽는거같은데"에 대해 진단 로그로
		-- 존106~108 실전 전투 28회 phase1 사망을 전수 추적 — 28/28 전부 정상적으로 revived as phase2까지
		-- 완주 확인, 서버 상태머신 로직 자체는 문제없음. 재현되면 클라이언트 시각 레이스 쪽을 의심할 것.)
		if self._hasPhase2 and not self._phase2Revived and _UtilLogic:RandomDouble() < self._phase2Chance then
			self:DieAndRevivePhase1Generic()
			return
		end
		self._dead = true
		-- 존2 마노 이스터에그 — 제한시간 안에 잡았을 때만 여기로 온다(시간 초과는 EndManoLife가
		-- 보상 없이 despawn). 남은 수명 타이머를 정리하고 보상 지급을 Logic으로 넘긴다
		if self._isMano then
			if self._manoLifeTimerId ~= 0 then
				_TimerService:ClearTimer(self._manoLifeTimerId)
				self._manoLifeTimerId = 0
			end
			_Ep1Zone2ManoLogic:OnManoKilled(self.Entity.TransformComponent.Position)
		end
		-- 죽는 연출(die 스프라이트)과 깊이 오버레이(서 있는 포즈를 검게 덧씌운 것)가 서로 어긋나 보이지
		-- 않도록, 죽는 순간 오버레이부터 즉시 꺼버린다
		self:HideDepthOverlay()
		-- 상태이상 타이머 즉시 정리 (죽는 연출 중 색상 간섭 방지)
		if self._slowTimerId ~= 0 then _TimerService:ClearTimer(self._slowTimerId) ; self._slowTimerId = 0 end
		if self._stunTimerId ~= 0 then _TimerService:ClearTimer(self._stunTimerId) ; self._stunTimerId = 0 end
		if self._dotTimerId ~= 0 then _TimerService:ClearTimer(self._dotTimerId) ; self._dotTimerId = 0 end
		if self._hardFreezeTimerId ~= 0 then _TimerService:ClearTimer(self._hardFreezeTimerId) ; self._hardFreezeTimerId = 0 end
		-- 얼어있거나(완전빙결)/스턴 걸린 도중 죽으면 PlayRate=0이 그대로 남아 죽는 애니메이션(본체+그림자)까지
		-- 안 움직이거나, 이 엔티티가 나중에 스폰 재사용될 때 새 몬스터가 멈춘 채로 시작할 수 있다 — 플래그를
		-- 먼저 끈 뒤 UpdateAnimationFreeze로 다시 계산해 복구한다.
		local wasFrozenOrStunned = self._isHardFrozen or self._isStunned
		self._isHardFrozen = false
		self.FreezeStack = 0
		self._freezeSlowed = false
		self._isStunned = false
		if wasFrozenOrStunned then self:UpdateAnimationFreeze() end
		self:DestroyStunStars()
		-- 죽는 순간 공중에 떠 있던 착지 타이머가 남아있으면 정리한다(잔여 트윈이 나중에 잘못 발동하는 일 방지)
		-- — 아래에서 드랍 낙하 연출 여부를 판단해야 하므로 리셋하기 전에 값을 따로 저장해둔다.
		local wasLevitating = self._isLevitating
		if self._levitateTimerId ~= 0 then _TimerService:ClearTimer(self._levitateTimerId) ; self._levitateTimerId = 0 end
		self._isLevitating = false
		if isvalid(self._freezeIndicator) then
			self._freezeIndicator:Destroy()
			self._freezeIndicator = nil
		end
		self.ComboStack = 0
		self:ClearAllComboOrbs()
		log("Monster died")
		-- 보스는 OnBossDefeated()가 처치 보상(Exp/Gold)까지 전부 처리한다. OnMonsterKilled()도
		-- 같이 부르면 NotifyExpChanged가 한 프레임 안에 두 번 겹쳐 호출되어, 레벨업 트윈이 강제로
		-- 0%부터 시작하기 직전에 다른 값으로 이미 차오르고 있던 바가 순간적으로 줄어드는 것처럼
		-- 보이는 버그가 있었다. OnBossDefeated() 호출 자체는 스킬조각/파워엘릭서 드롭 위치 계산
		-- (fallHeight/groundWorldY/dropScale)이 끝난 뒤로 아래로 옮겼다.
		if not self._isBoss then
			if self._isBadRudolph then
				-- "불량 루돌프" — 유저 지정: 골드는 정상 지급하되 EXP는 주지 않는다(OnMonsterKilled는
				-- 골드+EXP를 한 번에 처리하므로 골드만 떼어낸 GetGoldPerKill을 직접 호출한다)
				_GameManager:AddGold(_GameManager:GetGoldPerKill())
			else
				_GameManager:OnMonsterKilled()
			end
			-- 유물 수리검(10번) — 마지막 타격이 치명타였으면 확률로 골드를 한 번 더 준다(2배 효과).
			-- OnMonsterKilled의 시그니처를 건드리지 않으려고 별도 호출로 뺐다.
			if self._lastHitWasCrit then
				_GameManager:TryRelicCritCoinBonus()
			end
		end
		-- 비행형(박쥐 등)은 사망 위치가 공중이므로, 드랍 연출이 실제 발판(몬스터가 걸어다니는 바닥) 높이까지
		-- 먼저 빙그르르 돌며 떨어지도록 그 높이차(UI px)를 같이 넘긴다. FlyingWanderMinY는 배회 궤적의
		-- 하한일 뿐 실제 지면이 아니므로(맵마다 발판 높이가 다름), 사망 지점에서 실제로 아래로 레이캐스트해
		-- FootholdComponent 표면 Y를 구한다 — 걷는 몬스터는 이미 바닥에 있으니 0.
		-- 발판은 "그 위에 서 있을 수 있는 표면"이지, 타일 몸통 자체가 아니다 — 사망 지점이 어떤 타일의
		-- 발판 인식선보다 낮으면(타일 몸통을 관통해서 죽은 경우 포함) 그 타일 위에 서 있는 게 아니므로,
		-- 거리가 가깝다는 이유로 그 타일에 착지시키면 안 된다. 아래 방향으로만 쏴서, 사망 지점과 같거나
		-- 더 낮은 위치의 발판만 착지 후보로 삼는다 — 타일을 관통해서 죽었다면 그보다 더 아래(멀더라도)
		-- 있는 다음 발판까지 정상적으로 떨어지는 게 맞다.
		-- 발판을 못 찾으면(hit==nil) groundY를 함부로 0으로 가정하지 않고 낙하 연출 자체를 건너뛴다
		-- (존 오프셋이 있는 맵에서 잘못된 Y로 잘못 계산하면 아이템이 엉뚱한 자리에 멈춰 보이는 문제가 있었다).
		-- 존15는 중앙 기둥 대신 유저가 깔아둔 CustomFootholdComponent 오브젝트(foothold-848_1~3)가
		-- 있는데, 이건 몬스터 스폰 위치로도 이미 제외 처리된(MonsterSpawner.IsExcludedZone15Foothold)
		-- "장식용" 발판이라 눈에 보이는 타일이 없다 — Raycast(첫 번째 하나만) 대신 RaycastAll로 사망
		-- 지점 아래의 모든 발판을 훑어서, 이 제외 대상이 아닌 것 중 가장 가까운 것을 착지 지점으로 쓴다.
		-- 이 값은 포션/잡템/야누스의 검 교환권 드롭 전부(엘리트 처치의 카드 드롭 화면 연출은 제외)가
		-- 공유하므로, 아래 elite/potion 분기보다 먼저 계산해둔다.
		-- fallHeight는 낙하 연출의 재생 시간/회전량만 결정하는 대략치(서버는 UI 좌표계 변환 API를
		-- 쓸 수 없어 world 델타 * 100으로 근사)이고, 실제로 어디까지 떨어뜨릴지는 groundWorldY(월드
		-- Y좌표 그대로)를 따로 넘겨서 클라이언트가 _UILogic으로 정확히 변환하게 한다 — world 1유닛이
		-- 화면 UI px로 항상 100이 아니라(실측 시 해상도에 따라 ~170px) 예전처럼 fallHeight를 그대로
		-- UI px 낙하거리로 썼더니 실제 발판보다 한참 못 미치는 높이에서 낙하 연출이 멈춰, 존15/16
		-- 비행형 몬스터의 드롭 아이템이 바닥에 닿지 못하고 공중에 떠 있는 것처럼 보이는 버그가 있었다.
		local fallHeight = 0
		local groundWorldY = self.Entity.TransformComponent.WorldPosition.y
		-- 아쿠아 트랩/서지 등으로 속박되어 공중에 떠 있는 도중에 죽으면(_isLevitating, 위에서 이미
		-- false로 리셋했으므로 여기서는 별도의 로컬 플래그로 판단해야 함) 사망 위치 자체가 공중이라,
		-- 비행형과 똑같이 드랍 연출이 바닥까지 떨어지도록 같은 낙하 계산을 재사용한다 — 안 그러면
		-- 드랍 아이템이 방금까지 떠 있던 공중 위치에 그대로 멈춰 보인다.
		if self._isFlying or wasLevitating then
			local worldPos = self.Entity.TransformComponent.WorldPosition
			local map = self.Entity.CurrentMap
			if map ~= nil then
				---@type FootholdComponent
				local foothold = map:GetComponent("FootholdComponent")
				if foothold ~= nil then
					local hits = foothold:RaycastAll(Vector2(worldPos.x, worldPos.y), Vector2(0, -1), 50)
					local groundY = nil
					local bestDist = nil
					for i = 1, #hits do
						local h = hits[i]
						if not _MonsterSpawner:IsExcludedZone15Foothold(h.OwnerId) then
							local y = h:GetYByX(worldPos.x)
							local dist = worldPos.y - y
							if bestDist == nil or dist < bestDist then
								bestDist = dist
								groundY = y
							end
						end
					end
					if groundY ~= nil and worldPos.y > groundY then
						fallHeight = (worldPos.y - groundY) * 100
						groundWorldY = groundY
					end
				end
			end
		end
		-- OnEliteKilled/TryDropHealPotion 둘 다 월드 좌표를 기대한다(카드 드롭 화면 연출·포션 드롭 연출) —
		-- 로컬 Position을 넘기면 Zone12처럼 오프셋을 가진 존에서 드롭 연출이 화면 밖으로 어긋난다(실측 확인).
		-- 드롭 연출 크기도 스킬 이펙트와 동일하게 죽은 몬스터 자신의 거리(깊이) 비율을 그대로 따라간다
		-- (유저 요청 — 멀리서 죽은 몬스터의 드롭은 작게 보이게).
		local dropScale = _CardManager:GetEffectScaleRatio(self)
		-- 무기 드롭(유저 지정: 태초의 마을 전 구간, 몬스터 종류/보스·엘리트 무관하게 처치마다 판정)
		_GameManager:TryDropWeaponItem(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
		-- 장비 레벨 강화 주문서(부위 5종 각각 0.2%) — 장비 드롭과 같이 보스/엘리트/종류 무관 처치마다 판정
		_GameManager:TryDropEnhanceScroll(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
		-- 무기 스킬(레어 등급 100마리 처치 해금) 카운트 — 보스/엘리트 포함 모든 처치마다 누적
		_CardManager:OnWeaponSkillKill()
		-- 장비 등급 스킬의 처치 카운터(활 10마리 추가공격 / 양손검·슈트 회복 / 자마다르·망토 버프 /
		-- 투구 쿨감 해금) — 무기 스킬과 동일하게 보스/엘리트 포함 모든 처치마다 누적
		_GearEffectLogic:OnMonsterKilled()
		if self._isElite then
			_CardManager:OnEliteKilled(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
			_MonsterSpawner:OnEliteKilled()
		elseif self._isCorruptedCentaur then
			-- 타락한 켄타우로스(ep2_map4 MapObject_205) — 유저 지정: "엘리트처럼" 확정 드롭(빨간 포션 +
			-- 슬롯 스킬 1개). 검은 켄타우로스(_isBlackCentaur)는 이 분기를 안 타므로 힐포션 등 일반
			-- 확률성 드롭이 그대로 나간다(유저가 "잡템"만 없애달라고 했지 이쪽은 언급 안 함).
			_CardManager:OnCorruptedCentaurKilled(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
		elseif not self._isCauldron then
			-- 카페테리아 가마솥은 자기만의 확정 포션 표(아래 elseif 체인)가 있으므로 일반 존의 확률성
			-- 힐포션/빙결아이템/허수아비/바운스 드롭과 중복되지 않게 제외한다.
			_GameManager:TryDropHealPotion(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
			_GameManager:TryDropFreezeItem(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
			_GameManager:TryDropScarecrowItem(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
			_GameManager:TryDropBounceKnockbackItem(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
		end
		-- 존16~17(그림자 존) 전용: 야누스의 검 교환권 5% 확률 드롭 (보스/일반/엘리트 무관하게 처치마다 판정)
		if self._isErdas then
			-- 존 잡템 풀 대신 Map23ErdasEasterEggLogic이 정수 드롭(100% 확정)+킬카운트를 전담한다
			_Map23ErdasEasterEggLogic:OnErdasKilled(self._erdasOrdinal, self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
		elseif self._isYellowMiniBean then
			-- 일반 존 잡템 대신 스킬 카드 1개(슬롯 강화)를 지급한다 — _isYellowMiniBean 주석 참고
			_CardManager:OnYellowMiniBeanCaught(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
		elseif self._isTreasureChest then
			-- map24는 웨이브/존 잡템 개념이 없다 — 처치 시점에 그 자리에 귀환 포탈을 생성한다
			_Map24TreasureChestLogic:OnChestKilled(self.Entity.TransformComponent.WorldPosition)
		elseif self._isTiredKnight then
			-- 지쳐버린 기사(ep2_map3 존마다 1마리) — 유저 지정: "처치시 100% 아이템이 나오고" — 존 잡템
			-- 확률 대신 GrantLootItemDrop(무조건 지급)으로 tired_knight_seal을 확정 지급한다.
			_GameManager:GrantLootItemDrop(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, "tired_knight_seal", dropScale)
		elseif self._isBlackCentaur or self._isCorruptedCentaur then
			-- 검은/타락한 켄타우로스(ep2_map4 MapObject_205 이벤트) — 유저 지정: "잡템은 나올필요없고" —
			-- 존 잡템 지급을 완전히 건너뛴다.
		elseif self._isBadRudolph then
			-- "불량 루돌프"(ep3_map2 존10 길잃은 루돌프 이스터에그) — 유저 지정: 잡템/장비/스킬 드롭 전부
			-- 없음(골드는 위에서 이미 정상 지급됨). 존 잡템 지급을 완전히 건너뛴다.
		elseif self._isCauldron then
			-- 카페테리아 가마솥 — 유저 지정 확률표: 엘릭서(potionType=3) 5% / 하얀포션(2) 35% / 빨간포션(1) 60%
			local roll = _UtilLogic:RandomDouble()
			local potionType = 1
			if roll < 0.05 then
				potionType = 3
			elseif roll < 0.40 then
				potionType = 2
			end
			_GameManager:ApplyPotionDrop(potionType, self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
		elseif self._spawnZoneIndex == 16 or self._spawnZoneIndex == 17 then
			_GameManager:TryDropShadowVoucher(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
		else
			-- 그 외 전 구간: 확률로 "이 몬스터가 실제로 잡으면 주는" 잡템 1개를 가방에 지급 (보스/일반/엘리트 무관).
			-- 버그 수정(2026-08-26, 유저 리포트 "다크 예티 잡으면 뿔나오잖아 근데 그게 예티 뿔로나와 다크
			-- 예티 잡템이 아니라") — 2페이즈로 이미 진화한 상태로 죽었으면(예티→다크예티 등, _phase2Revived)
			-- _speciesIdx/스폰존이 스폰 시점(진화 전) 값 그대로라 그냥 쓰면 진화 전 잡템이 나온다. 진화
			-- 후 정체성 기준 잡템(GetMonsterLootItemIdPhase2)을 대신 쓰고, 혹시 매핑이 없으면(방어적)
			-- 진화 전 잡템으로 폴백한다.
			local lootItemId
			if self._phase2Revived then
				lootItemId = _GameManager:GetMonsterLootItemIdPhase2(self._spawnZoneIndex, self._speciesIdx)
				if lootItemId == "" then
					lootItemId = _GameManager:GetMonsterLootItemId(self._spawnZoneIndex, self._speciesIdx)
				end
			else
				lootItemId = _GameManager:GetMonsterLootItemId(self._spawnZoneIndex, self._speciesIdx)
			end
			_GameManager:TryDropLootItem(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, lootItemId, dropScale)
		end
		if self._isBoss then
			_GameManager:OnBossDefeated(self.Entity.TransformComponent.WorldPosition, fallHeight, groundWorldY, dropScale)
		end
		if self._isCauldron then
			-- 유저 지정: "포션을 뱉으면 알파가 빠지면서 자연스럽게 사라짐" — die1 재생과 동시에 알파를
			-- 0으로 페이드, 파괴 타이밍(_dieDuration+0.2)에 정확히 맞춰 끝나게 한다.
			local renderer = self.Entity.SpriteRendererComponent
			if renderer ~= nil then
				_TweenLogic:PlayTween(1.0, 0.0, self._dieDuration + 0.2, EaseType.QuadEaseIn, function(alpha)
					if isvalid(self) and isvalid(self.Entity) and isvalid(renderer) then
						local c = renderer.Color
						renderer.Color = Color(c.r, c.g, c.b, alpha)
					end
				end)
			end
		end
		self:PlayDeathAnimation(self._dieRUID, self._dieDuration)
		self.Entity:Destroy(self._dieDuration + 0.2)
	end

	-- 거대 네펜데스 1페이즈 사망 처리: 킬카운트/드롭 등 실제 사망 부수효과는 전혀 발생시키지 않고,
	-- 1페이즈 죽는 연출(die1+사운드)만 재생한 뒤 2페이즈로 부활시킨다. 연출 도중엔 _dead=true로
	-- 취급해 OnUpdate/피격이 멈추게 한다(일반 사망과 동일한 방식).
	@ExecSpace("ServerOnly")
	method void DieAndRevivePhase1()
		log("GiantNepenthes: phase1 died, reviving as phase2")
		-- _dead=true인 동안 OnUpdate 전체가 멈춘다(공격 타이머 포함) — 변신 연출 도중엔 공격이
		-- 나갈 수 없다(유저 요청: "변신될때는 그때는 공격 못하게").
		self._dead = true
		self:HideDepthOverlay()
		-- PlayDeathAnimation(일반 사망용)은 재생 후 알파를 0으로 낮춰 사라지게 만드는데, 1페이즈는
		-- 실제로 죽는 게 아니라 2페이즈로 바로 이어져야 한다(유저 지적: "사라졌다가 다시 켜지면 안됨,
		-- 자연스럽게 연결되어야함") — 그래서 알파 페이드가 없는 전용 연출을 재생하고, die1이 끝나는
		-- 정확한 시점에 곧바로 2페이즈 외형으로 덮어써서(ReviveAsPhase2) 끊기는 구간이 없게 한다.
		self:PlayPhase1TransformAnimation(self._dieRUID, self._dieSoundRUID)
		_TimerService:SetTimerOnce(function()
			if isvalid(self) and isvalid(self.Entity) then self:ReviveAsPhase2() end
		end, self._dieDuration)
	end

	-- 1페이즈 사망→2페이즈 전환 전용 연출: die1을 재생하되(사운드 포함) PlayDeathAnimation과 달리
	-- 알파를 0으로 낮추지 않는다 — 곧바로 ReviveAsPhase2가 같은 프레임 타이밍에 2페이즈 외형으로
	-- 이어받으므로, 사라졌다 다시 나타나는 깜빡임 없이 자연스럽게 연결된다.
	@ExecSpace("Multicast")
	method void PlayPhase1TransformAnimation(string dieRUID, string dieSoundRUID)
		if self:IsServer() then return end
		if dieSoundRUID ~= "" then _SoundOptionLogic:PlaySfx(dieSoundRUID, 1.0) end
		local renderer = self.Entity.SpriteRendererComponent
		if renderer == nil then return end
		renderer.Color = Color(1, 1, 1, 1)
		if dieRUID ~= "" then renderer.SpriteRUID = dieRUID end
	end

	-- 거대 네펜데스 2페이즈로 전환: HP를 최대치로 되돌리고 외형/공격을 전부 GameManager의 2페이즈
	-- 전용 값(원본 거대 네펜데스 리소스팩)으로 교체한 뒤 공격을 켠다(_neverAttacks=false). 이후부터는
	-- 일반 지상 유닛과 동일하게 OnUpdate가 AttackInterval마다 OnReachPlayer를 호출한다.
	@ExecSpace("ServerOnly")
	method void ReviveAsPhase2()
		log("GiantNepenthes: revived as phase2 (ranged attacker)")
		self._giantNepenthesRevived = true
		self._dead = false
		self.CurrentHp = self.MaxHp
		self._standRUID = _GameManager.GiantNepenthesStandRUID
		self._hitRUID = _GameManager.GiantNepenthesHitRUID
		self._dieRUID = _GameManager.GiantNepenthesDieRUID
		self._dieDuration = _GameManager.GiantNepenthesDieDuration
		self._hitSoundRUID = _GameManager.GiantNepenthesHitSoundRUID
		self._dieSoundRUID = _GameManager.GiantNepenthesDieSoundRUID
		self._attackRUID = _GameManager.GiantNepenthesAttackRUID
		self._attackDuration = _GameManager.GiantNepenthesAttackDuration
		self._attackSoundRUID = _GameManager.GiantNepenthesAttackSoundRUID
		self._hitEffectRUID = _GameManager.GiantNepenthesHitEffectRUID
		self._hitEffectDuration = _GameManager.GiantNepenthesHitEffectDuration
		self._customAttackInterval = self._attackDuration + 0.7
		self._neverAttacks = false
		self._attackTimer = self._customAttackInterval
		self.MonsterSprite = self._standRUID
		local renderer = self.Entity.SpriteRendererComponent
		if renderer ~= nil then
			renderer.SpriteRUID = self._standRUID
			renderer.Color = Color(1, 1, 1, 1)
		end
		self:SyncDepthOverlaySprite()
		self:UpdateDepth()
	end

	-- 예티/다크예티/예티와페페/다크예티와페페(에피소드3 map2) 범용 1페이즈 사망 처리 — 거대 네펜데스의
	-- DieAndRevivePhase1과 완전히 동일한 구조(진짜 죽지 않고 die1 재생 후 2페이즈로 부활)이되, 종마다
	-- 다른 외형을 존 풀 테이블(appearanceZone 기준)에서 읽어야 해서 self._spawnZoneIndex/_speciesIdx를
	-- 사용하는 별도 메서드로 분리했다.
	@ExecSpace("ServerOnly")
	method void DieAndRevivePhase1Generic()
		log("Phase2Monster: phase1 died, reviving as phase2")
		self._dead = true
		self:HideDepthOverlay()
		self:PlayPhase1TransformAnimation(self._dieRUID, self._dieSoundRUID)
		_TimerService:SetTimerOnce(function()
			if isvalid(self) and isvalid(self.Entity) then self:ReviveAsPhase2Generic() end
		end, self._dieDuration)
	end

	-- 2페이즈로 전환 — GameManager의 존 풀 전용 Phase2 테이블(GetMapPhase2*RUID, appearanceZone+
	-- speciesIdx 기준)에서 외형/공격을 읽어와 교체한다. appearanceZone은 InitializeStats가 계산했던
	-- 값과 동일해야 하는데, 이 몬스터가 스폰될 당시 별칭(alias) 매핑이 없는 존(89~108, 에피소드3)에서만
	-- 쓰이므로 self._spawnZoneIndex를 그대로 appearanceZone으로 써도 안전하다(다른 별칭 존에서 이 종을
	-- 쓸 계획이 생기면 InitializeStats의 별칭 매핑을 여기도 복제해야 함).
	@ExecSpace("ServerOnly")
	method void ReviveAsPhase2Generic()
		log("Phase2Monster: revived as phase2")
		self._phase2Revived = true
		self._dead = false
		self.CurrentHp = self.MaxHp
		local zone = self._spawnZoneIndex
		local idx = self._speciesIdx
		self._standRUID = _GameManager:GetMapPhase2StandRUID(zone, idx)
		self._moveRUID = _GameManager:GetMapPhase2MoveRUID(zone, idx)
		self._hitRUID = _GameManager:GetMapPhase2HitRUID(zone, idx)
		self._dieRUID = _GameManager:GetMapPhase2DieRUID(zone, idx)
		self._dieDuration = _GameManager:GetMapPhase2DieDuration(zone, idx)
		self._hitSoundRUID = _GameManager:GetMapPhase2HitSoundRUID(zone, idx)
		self._dieSoundRUID = _GameManager:GetMapPhase2DieSoundRUID(zone, idx)
		self._attackRUID = _GameManager:GetMapPhase2AttackRUID(zone, idx)
		self._attackDuration = _GameManager:GetMapPhase2AttackDuration(zone, idx)
		-- 버그 수정(2026-08-25, 유저 리포트 "걷는 연출이랑 이런건 다 빠진거 같은데") — InitializeStats의
		-- 스폰 시점 규칙(658번줄 부근, "접근 중엔 move, 이미 도달했거나 move가 없는 종은 stand")을 그대로
		-- 재현해야 하는데 기존엔 무조건 standRUID로 고정해서, 아직 플레이어에게 도달하기 전에 죽어 2페이즈로
		-- 부활한 개체는 부활 이후에도 걷는 연출 없이 제자리에 멈춰 서 있는 것처럼 보였다. _reachedPlayer는
		-- 1페이즈 상태를 그대로 들고 있으므로(부활 시 안 건드림) 이미 도달했던 개체는 정상적으로 stand로
		-- 시작해 다음 OnUpdate에서 바로 공격으로 이어진다.
		local phase2Sprite = self._standRUID
		if not self._reachedPlayer and not self._isFlying and self._moveRUID ~= "" then
			phase2Sprite = self._moveRUID
		end
		self.MonsterSprite = phase2Sprite
		local renderer = self.Entity.SpriteRendererComponent
		if renderer ~= nil then
			renderer.SpriteRUID = phase2Sprite
			renderer.Color = Color(1, 1, 1, 1)
		end
		self:SyncDepthOverlaySprite()
		self:UpdateDepth()
	end

	@ExecSpace("Multicast")
	method void PlayDeathAnimation(string dieRUID, number dieDuration)
		if self:IsServer() then return end
		if self._dieSoundRUID ~= "" then _SoundOptionLogic:PlaySfx(self._dieSoundRUID, 1.0) end
		local renderer = self.Entity.SpriteRendererComponent
		if renderer == nil then return end
		-- 상태이상 색상 제거 + die1 스프라이트로 전환해 메이플 원본 죽는 연출 재생
		renderer.Color = Color(1, 1, 1, 1)
		if dieRUID ~= "" then renderer.SpriteRUID = dieRUID end
		-- die1 정확한 1사이클 후 알파 0으로 설정해 루프 방지
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local r = self.Entity.SpriteRendererComponent
			if r ~= nil then r.Color = Color(1, 1, 1, 0) end
		end, dieDuration)
	end

	-- MapManager가 호출: 플레이어가 이 맵을 떠나면 접근/공격을 멈춘다 (화면 밖에서 몰래 때리는 것 방지)
	@ExecSpace("ServerOnly")
	method void Pause()
		if self._neverPauses then return end
		self._paused = true
	end

	-- Ep2MiniBeanEasterEggLogic 전용 — 위 _neverPauses 주석 참고
	@ExecSpace("ServerOnly")
	method void SetNeverPauses(boolean value)
		self._neverPauses = value
	end

	-- Ep2MiniBeanEasterEggLogic 전용 — 위 _skipAttackLunge 주석 참고
	@ExecSpace("ServerOnly")
	method void SetSkipAttackLunge(boolean value)
		self._skipAttackLunge = value
	end

	-- Ep2MiniBeanEasterEggLogic 전용 — InitializeAlienInvader는 원거리 히트 이펙트 개념이 없어서
	-- (Zone21AlienEasterEggLogic과 공유하는 시그니처라 파라미터를 늘리지 않았다) 별도 세터로 뺐다.
	-- PlayRangedHitEffect()는 _hitEffectRUID가 빈 문자열이면 스스로 아무것도 안 하므로, 이걸 호출
	-- 안 하는 다른 비행형(뉴그레이 화이트 등)에는 영향이 없다.
	@ExecSpace("ServerOnly")
	method void SetRangedHitEffect(string hitEffectRUID, number hitEffectDuration, number scaleMultiplier)
		self._hitEffectRUID = hitEffectRUID
		self._hitEffectDuration = hitEffectDuration
		self._hitEffectScaleMultiplier = scaleMultiplier
	end

	-- Ep3Map3·4PunkoEasterEggLogic 전용 — 위 _selfAttackEffectRUID 주석 참고
	@ExecSpace("ServerOnly")
	method void SetSelfAttackEffect(string effectRUID, number effectDuration)
		self._selfAttackEffectRUID = effectRUID
		self._selfAttackEffectDuration = effectDuration
	end

	-- Ep2MiniBeanEasterEggLogic 전용 — GetClosestTargets 등이 _currentScale 내림차순으로 정렬해 타겟을
	-- 고르는데, 미니빈은 전부 고정 1.0이라 완전히 동률이었다. 동률이면 table.sort가 매번 같은 순서로
	-- 정리해버려서(입력 순서가 고정이라 사실상 결정적) 특정 한 마리(하필 무리 공격 선점자와 겹치는
	-- 경우가 많았다)가 영구히 타겟 후보 밖으로 밀려 플레이어 공격을 아예 못 맞는 버그가 있었다(유저
	-- 리포트: "현재 공격하는 한마리는 플레이어가 공격 자체를 못함"). 눈에 안 띄는 아주 작은 편차를
	-- 줘서 동률을 깨고, 렌더 크기도 같이 갱신한다(InitializeAlienInvader와 동일한 계산식).
	@ExecSpace("ServerOnly")
	method void SetCurrentScale(number scale)
		self._currentScale = scale
		self.Entity.TransformComponent.Scale = Vector3(scale * self._scaleMultiplier, scale * self._scaleMultiplier, 1.0)
	end

	-- Ep2MiniBeanEasterEggLogic 전용 — InitializeAlienInvader는 _attackDuration을 세팅하지 않아
	-- 기본값(0.25초)으로 남는다. PlayAttackAnimation은 이 시간이 지나면 무조건 attackRUID를 stand로
	-- 되돌리는데, attack2가 19프레임짜리라(이 프로젝트 관례상 초당 약 10프레임 → 1.9초 필요,
	-- GetMapAttackDuration 주석의 "11프레임=1.1초" 사례와 동일 계산) 0.25초는 한참 모자라 애니메이션이
	-- 중간에 잘려 보였다(유저 리포트: "공격 모션이 너무 빨라서 짤린다").
	@ExecSpace("ServerOnly")
	method void SetAttackDuration(number duration)
		self._attackDuration = duration
	end

	-- Ep2MiniBeanEasterEggLogic 전용 — 위 _isSwarmMember 주석 참고
	@ExecSpace("ServerOnly")
	method void SetSwarmMember(boolean value)
		self._isSwarmMember = value
	end

	-- Ep2MiniBeanEasterEggLogic 전용 — 위 _isYellowMiniBean 주석 참고. 공격 자체를 막는 것까지 한 번에
	-- 처리한다(_neverAttacks는 UpdateFlying 비행형 분기에서도 존중하도록 아래에서 같이 수정했다).
	@ExecSpace("ServerOnly")
	method void SetYellowMiniBean(boolean value)
		self._isYellowMiniBean = value
		self._neverAttacks = value
	end

	-- Ep3Map3PunkoEasterEggLogic 전용 — 위 SetYellowMiniBean과 달리 _neverAttacks는 건드리지 않는다
	-- (유저 지정: "쿠스코"는 정상적으로 공격도 하면서 잡으면 잡템 대신 스킬 카드 1개를 받아야 한다).
	-- Die()의 _isYellowMiniBean 분기(_CardManager:OnYellowMiniBeanCaught 호출)는 그대로 재사용한다 —
	-- 이름은 "노란 미니빈" 전용으로 붙었지만 실제 동작은 "잡으면 스킬 1개"라는 범용 보상 분기다.
	@ExecSpace("ServerOnly")
	method void SetSkillDropOnDeath(boolean value)
		self._isYellowMiniBean = value
	end

	-- Ep3Map3PunkoEasterEggLogic 전용 — InitializeAlienInvader는 종별 크기 배율(_scaleMultiplier)을
	-- 건드리지 않아 항상 기본 1.0으로 남는다(Ep2MiniBeanEasterEggLogic도 크기를 줄일 필요가 없어서
	-- 지금까지 쓸 일이 없었다). 유저 지정("크기 20% 줄여주고")대로 종 전체 크기를 줄이거나 키울 때 쓴다 —
	-- _isSwarmMember의 매 프레임 사인파 흔들림(_currentScale)과는 독립된 별도 배율이라 서로 곱해진다.
	@ExecSpace("ServerOnly")
	method void SetScaleMultiplier(number value)
		self._scaleMultiplier = value
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * value, self._currentScale * value, 1.0)
	end

	-- Ep3Map3PunkoEasterEggLogic 전용 — InitializeAlienInvader는 사운드를 세팅하지 않는다
	-- (Ep2MiniBeanEasterEggLogic도 동일하게 사운드 없이 써왔다). 이번엔 유저가 리소스팩에 사운드까지
	-- 같이 줘서, 공격/피격/사망 시점에 자동 재생되는 기존 _attackSoundRUID/_hitSoundRUID/_dieSoundRUID
	-- 필드에 직접 꽂아준다.
	@ExecSpace("ServerOnly")
	method void SetAlienInvaderSounds(string attackSoundRUID, string hitSoundRUID, string dieSoundRUID)
		self._attackSoundRUID = attackSoundRUID
		self._hitSoundRUID = hitSoundRUID
		self._dieSoundRUID = dieSoundRUID
	end

	-- MapManager가 호출: 플레이어가 이 맵으로 돌아오면 다시 활동 재개
	@ExecSpace("ServerOnly")
	method void Resume()
		self._paused = false
	end

	@ExecSpace("ServerOnly")
	method void OnReachPlayer()
		-- 무리 공격 중복 제거(_isSwarmMember 주석 참고) — 유저 지정: "공격모션은 전체가 다 해야함,
		-- 데미지만 1번" — 그래서 데미지 판정(미스 굴림 포함)만 이 플래그로 막고, 아래 연출 블록은
		-- 무리원 전체가 항상(선점 실패해도) 실행한다. TryClaimGroupAttack이 false를 반환해도 함수
		-- 전체를 리턴하지 않고 isGroupWinner만 꺼둔 채로 계속 진행한다.
		local isGroupWinner = true
		if self._isSwarmMember then
			isGroupWinner = _Ep2MiniBeanEasterEggLogic:TryClaimGroupAttack()
		end
		
		if isGroupWinner then
			-- 연막탄(쉐이드) 명중 하락 판정 — 보스/엘리트는 절반만 적용. 빗나가면 데미지만 스킵
			-- (연출은 아래에서 무리원 전체가 그대로 재생됨).
			local missed = false
			if self._accuracyDebuffPercent > 0 then
				local missChance = self._accuracyDebuffPercent
				if self._isBoss or self._isElite then missChance = missChance * 0.5 end
				if _UtilLogic:RandomDouble() < missChance then
					log("Monster attack missed (smoke debuff " .. math.floor(missChance * 100) .. "%)")
					missed = true
				end
			end
		
			-- 다크 사이트(카드184, 쉐이드 전용 패시브) — 영구 회피 확률. 연막탄 디버프와 별개 판정이고
			-- 보스/엘리트도 감쇄 없이 그대로 적용된다(플레이어 자신의 고정 스탯이라 몬스터 등급과 무관).
			local darkSightChance = _CardManager:GetDarkSightEvadeChance()
			if not missed and darkSightChance > 0 and _UtilLogic:RandomDouble() < darkSightChance then
				log("Monster attack missed (dark sight " .. math.floor(darkSightChance * 100) .. "%)")
				missed = true
			end
		
			if not missed then
				-- 플레이어 HP 감소 (엘리트는 공격력 15% 추가, 보스는 BossAttackMultiplier 배)
				log("Monster reached player!")
				local dmgMultiplier = 1.0
				if self._isBoss then
					dmgMultiplier = _GameManager.BossAttackMultiplier
				elseif self._isElite then
					dmgMultiplier = 1.15
				end
				-- 빠른 이동 안전장치 2단계(6연속) — ApplyRushPenalty가 세팅한 배율을 그대로 곱한다(기본 1.0이면 무영향)
				dmgMultiplier = dmgMultiplier * self._rushDamageMultiplier
				if self._isRangedSlash then
					-- 발톱자국 이펙트가 실제로 최대 스케일(화면에 닿는 시점)에 도달했을 때 대미지가 들어가도록
					-- PlaySlashEffect와 동일한 지연(공격모션 절반 + 이펙트 성장 시간)만큼 늦춘다(유저 요청 —
					-- "스케일이 0.6까지 도달했을때 대미지 들어오도록"). 다른 종(근접/비행/먹물)은 기존처럼 즉시.
					local hitDelay = self._attackDuration * 0.5 + self.SlashEffectDuration
					_TimerService:SetTimerOnce(function()
						if not isvalid(self) or self._dead then return end
						_GameManager:OnMonsterReached(dmgMultiplier, self._isSwarmMember or self._ignoresHitImmune)
					end, hitDelay)
				else
					-- 무리 공격(_isSwarmMember)은 TryClaimGroupAttack으로 이미 무리 내부에서 1회로 제한해뒀는데,
					-- 일반 스폰 몬스터가 방금 때려서 걸린 전역 무적 프레임(GameManager._hitImmune, 0.8초)에
					-- 또 막혀서 대미지가 안 들어가는 경우가 있었다(유저 지적: "다른 일반 스폰 몬스터가 연속으로
					-- 때리면 대미지 안들어가게 딜레이 걸었잖아? 쟤는 무시하라는말임"). 무리 공격은 이 무적
					-- 프레임을 무시하고 항상 들어가게 한다 — 다른 몬스터끼리의 무적 프레임 상호작용은 그대로 유지.
					-- _ignoresHitImmune(Tired Knight)도 동일한 경로로 무적 프레임을 무시한다.
					_GameManager:OnMonsterReached(dmgMultiplier, self._isSwarmMember or self._ignoresHitImmune)
				end
			end
		end
		
		-- 비행형(박쥐)은 배회 중 스케일이 고정돼 있어 "접근감"이 없고 공격이 잘 안 보인다는 피드백이 있어,
		-- 공격 순간 2배 크기까지 확 커졌다가 돌아오는 들이받기로 임팩트를 준다(boost=1.0, baseScale 1.0
		-- 기준 피크 2.0) — 이미 위아래로 날아다니는 중이라 별도 홉을 얹지 않는다.
		-- attack1 리소스가 있는 종(뉴그레이 화이트 등)은 확대(들이받기)와 동시에 스프라이트도 attack1로
		-- 바꿔서, 커지기만 하고 실제 공격 모션은 안 보이던 기존 비행형(attack1 없는 박쥐 등)과 구분한다.
		-- attack1 리소스가 있는 웨이브(비행형이 아닌 경우)는 스프라이트 교체, 원거리(먹물) 종은 화면 잉크
		-- 스플랫, 그 외(없는 웨이브)는 기본 들이받기로 대체 — 비행형을 제외한 전 종이 공격 순간 살짝 위로
		-- 뛰었다 착지하는 홉 모션을 공유한다(원래 존14/15 이블아이/커즈아이 전용이었던 걸 전 몬스터로 확장).
		if self._isFlying then
			if self._attackRUID ~= "" then
				self:PlayAttackAnimation(self._attackRUID, self.MonsterSprite, self._attackDuration)
			end
			if not self._skipAttackLunge then
				self:PlayLungeAnimation(1.0, 0)
			end
			-- 원거리 비행형(미니빈 등) 전용 — 근접 비행형(_hitEffectRUID=="")은 내부에서 그냥 아무것도
			-- 안 하고 리턴하므로 무조건 호출해도 안전하다.
			self:PlayRangedHitEffect()
			-- 푼코/쿠스코 전용 — 몬스터 자신의 위치에 뜨는 이펙트(_selfAttackEffectRUID=="")면 무조건
			-- 호출해도 안전하다.
			self:PlaySelfAttackEffect()
		elseif self._attackRUID ~= "" then
			self:PlayAttackAnimation(self._attackRUID, self.MonsterSprite, self._attackDuration)
			self:FlashHideDepthOverlay(self._attackDuration)
			-- 정책 변경(2026-08-27, 유저 지정: "앞으로 어택모션있는애들은 공격할때 점프하는거 있잖아
			-- 그거 빼 몬스터만들때 그 모션 없는애들만 점프하는 걸로 만들어(기존 달팽이처럼)") —
			-- attack1(전용 공격 스프라이트)이 있는 종은 그 포즈 교체만으로 공격을 표현하고, 제자리 홉은
			-- 더 이상 같이 재생하지 않는다. 홉(PlayAttackHop)은 attack1이 아예 없는 종의 대체 연출
			-- (else 분기, PlayLungeAnimation과 짝)로만 남긴다 — "기존 달팽이처럼".
			-- 원거리(칼자국) 종(자이언트 쉐도우)은 자기 자신의 attack1 스프라이트 교체 위에 발톱자국
			-- 이펙트를 추가로 띄운다 — 원거리(먹물)와 달리 대체 연출이 아니라 "얹는" 방식이라 elseif가
			-- 아니라 이 분기 안에 같이 넣는다.
			if self._isRangedSlash then
				self:PlaySlashEffect()
			end
			-- 스노우맨(원거리) 전용 — 유저 요청: 실제로 몬스터→플레이어로 날아가는 눈덩이 투사체.
			-- _projectileRUID가 빈 문자열인 다른 원거리 종은 내부에서 그냥 아무것도 안 함.
			if self._isRangedInk then
				self:PlayRangedProjectile()
			end
			-- 원거리(가시/먹물) 종(네펜데스/다크네펜데스/거대 네펜데스 2페이즈) 전용 히트 이펙트 — 유저
			-- 요청: 문어(먹물)와 같은 방식으로, 공격이 플레이어에게 닿는 위치에 종별 전용 이펙트를 띄운다.
			-- 빈 문자열이면 내부에서 그냥 아무것도 안 함.
			self:PlayRangedHitEffect()
		elseif self._isRangedInk then
			self:PlayInkAttack()
			self:PlayAttackHop()
		else
			self:PlayLungeAnimation(0.25, self.AttackHopHeight)
		end
	end

	-- 공격 순간 살짝 위로 뛰었다 착지하는 모션 — PlayLungeAnimation은 스케일 트윈에 이미 이 Y 모션을
	-- 같이 얹어 처리하지만, 스프라이트 교체(PlayAttackAnimation)/원거리 잉크(PlayInkAttack)처럼 자체적으로
	-- Y를 안 건드리는 연출에는 이 공용 홉을 별도로 얹어야 한다.
	@ExecSpace("ServerOnly")
	method void PlayAttackHop()
		if self._dead then return end
		local baseY = self.Entity.TransformComponent.Position.y
		_TweenLogic:PlayTween(0.0, 1.0, 0.18, EaseType.QuadEaseOut, function(t)
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local pos = self.Entity.TransformComponent.Position
			self.Entity.TransformComponent.Position = Vector3(pos.x, baseY + self.AttackHopHeight * math.sin(t * math.pi), pos.z)
		end)
	end

	-- 닌자 지그재그 잔상: 현재 스프라이트를 그대로 복제한 반투명 엔티티를 지금 위치에 남기고 빠르게
	-- 페이드아웃시킨다. AfterimageInterval마다 OnUpdate의 지그재그 분기에서 호출된다.
	@ExecSpace("ServerOnly")
	method void SpawnAfterimage()
		local map = self.Entity.CurrentMap
		if map == nil then return end
		local pos = self.Entity.TransformComponent.WorldPosition
		local scale = self.Entity.TransformComponent.Scale
		local ghost = _SpawnService:SpawnByModelId("afterimage", "Afterimage", pos, map)
		if ghost == nil then return end
		local renderer = ghost.SpriteRendererComponent
		if renderer ~= nil then
			renderer.SpriteRUID = self.MonsterSprite
			renderer.Color = Color(0.6, 0.75, 1.0, self.AfterimageAlpha)
		end
		ghost.TransformComponent.Scale = scale
		_TweenLogic:PlayTween(self.AfterimageAlpha, 0.0, self.AfterimageFadeDuration, EaseType.QuadEaseIn, function(alpha)
			if isvalid(ghost) and renderer ~= nil then renderer.Color = Color(0.6, 0.75, 1.0, alpha) end
		end)
		ghost:Destroy(self.AfterimageFadeDuration + 0.05)
	end

	-- 원거리(먹물) 공격 연출: 화면 잉크 스플랫(GameManager 담당)에 더해, 몬스터 본인도 "찍 내뿜는"
	-- 스쿼시 연출을 재생한다 — 리소스 팩(mob/3401009.img)에 attack1 클립이 아예 없어서(die1/hit1/
	-- move/stand만 존재, msw-search로 확인) 근접종의 PlayLungeAnimation과 같은 절차적 방식을 쓰되,
	-- 원거리종은 앞으로 들이받으면 안 되므로 전진 없이 제자리에서 가로로 짜부라졌다 돌아오는 모션으로 대체한다.
	@ExecSpace("ServerOnly")
	method void PlayInkAttack()
		-- PlayInkSplat은 파라미터 이름부터 worldPos — WorldToScreenPosition으로 화면 좌표 환산에 쓰인다.
		-- 로컬 Position을 넘기면 Zone12에서는 존 오프셋만큼 어긋난 화면 밖 위치로 환산돼 연출이 안 보인다.
		local pos = self.Entity.TransformComponent.WorldPosition
		_GameManager:PlayInkSplat(Vector2(pos.x, pos.y))
		self:PlaySquirtAnimation()
	end

	-- 먹물을 내뿜는 순간의 스쿼시(가로로 넓어지고 세로로 눌렸다 원래대로) 연출 — 근접종의 들이받기
	-- (PlayLungeAnimation)와 달리 위치/전체 스케일은 그대로 두고 XY 비율만 짧게 일그러뜨린다.
	@ExecSpace("ServerOnly")
	method void PlaySquirtAnimation()
		if self._dead then return end
		local mult = self._scaleMultiplier
		local baseScale = self._currentScale
		local squashAmount = 0.35
		_TweenLogic:PlayTween(0.0, 1.0, 0.2, EaseType.QuadEaseOut, function(t)
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local squash = math.sin(t * math.pi) * squashAmount
			local sx = (baseScale + squash) * mult
			local sy = (baseScale - squash * 0.6) * mult
			self.Entity.TransformComponent.Scale = Vector3(sx, sy, 1.0)
		end)
	end

	-- 원거리(칼자국) 종 전용 — attack1 스프라이트 스왑 애니메이션 재생 중, "칼이 실제로 내려찍히는"
	-- 시점(전체 길이의 절반쯤)에 맞춰 지연 후 발톱자국 월드 이펙트를 하나 띄운다. 매번 독립된 Entity를
	-- 스폰하므로(예전 UI 아이콘 공유 방식과 달리) 여러 마리가 동시에 공격해도 각자 자기 이펙트가 뜬다.
	--
	-- ⚠ 처음엔 CardManager.SpawnEffect(내부적으로 CardManager.GetCurrentMap() = "플레이어의 현재 존"
	-- 기준으로 부모 맵을 정함)를 그대로 썼는데, 지연(delay) 타이머가 끝나기 전에 플레이어가 다른 존으로
	-- 화면을 넘기면 그 사이 CurrentMapIndex가 바뀌어서, 이 몬스터(자이언트 쉐도우)의 존 로컬 좌표를
	-- 엉뚱한(새) 존 컨테이너 밑에 그대로 스폰해버리는 버그가 있었다(유저 실측: "화면이동할때 이펙트
	-- 남아있음" — 새 화면의 좌표계에 옛 존의 로컬 좌표가 얹혀서 잘못된 위치에 떠 있게 됨). SpawnAfterimage
	-- 와 동일하게 self.Entity.CurrentMap(이 몬스터 자신이 실제로 속한 맵)을 직접 써서 이 불일치 자체를
	-- 없앤다.
	--
	-- "검기가 발산되어 화면 쪽으로 다가오는" 느낌을 위해 작게 시작해서 크게 자라나도록 스케일을 트윈한다
	-- (유저 요청 — 이전엔 고정 크기로 팝만 되고 다가오는 느낌이 없었음). 개별 Destroy로 직접 수명 관리
	-- (skilleffect 기본 Duration에 의존하지 않음 — 프로젝트 공통 정책).
	@ExecSpace("ServerOnly")
	method void PlaySlashEffect()
		local delay = self._attackDuration * 0.5
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(self.Entity) or self._dead then return end
			local map = self.Entity.CurrentMap
			if map == nil then return end
			local pos = self.Entity.TransformComponent.WorldPosition
			local dropScale = _CardManager:GetEffectScaleRatio(self)
			local offsetX = (_UtilLogic:RandomDouble() * 2 - 1) * 0.3
			local offsetY = (_UtilLogic:RandomDouble() * 2 - 1) * 0.2
			local fxPos = Vector3(pos.x + offsetX, pos.y + offsetY, pos.z - 0.2)
		
			local fx = _SpawnService:SpawnByModelId("skilleffect", "SlashFX", fxPos, map)
			if fx == nil then return end
			local renderer = fx.SpriteRendererComponent
			if renderer ~= nil then
				renderer.SpriteRUID = self.SlashEffectRUID
				renderer.PlayRate = self.SlashEffectPlayRate
			end
		
			local startScale = self.SlashEffectStartScale * dropScale
			local endScale = self.SlashEffectEndScale * dropScale
			fx.TransformComponent.Scale = Vector3(startScale, startScale, 1)
			_TweenLogic:PlayTween(startScale, endScale, self.SlashEffectDuration, EaseType.QuadEaseIn, function(scale)
				if isvalid(fx) then fx.TransformComponent.Scale = Vector3(scale, scale, 1) end
			end)
		
			fx:Destroy(self.SlashEffectDuration)
		end, delay)
	end

	-- 원거리(가시/먹물) 종 전용 히트 이펙트 — 문어(먹물, PlayInkSplat)와 같은 취지로, 공격이 "실제로
	-- 플레이어에게 닿는" 시점에 종별 전용 애니메이션클립(attack1/info/hit)을 플레이어 위치에 띄운다.
	-- PlaySlashEffect(몬스터 자신의 위치)와 달리 GetPlayerCenterX/Y로 플레이어의 실제 월드 좌표를
	-- 구한다 — 존 오프셋이 있는 병합 맵에서도 항상 정확한 위치에 뜬다.
	@ExecSpace("ServerOnly")
	method void PlayRangedHitEffect()
		if self._hitEffectRUID == "" then return end
		local delay = self._attackDuration * 0.5
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(self.Entity) or self._dead then return end
			local map = self.Entity.CurrentMap
			if map == nil then return end
			local px = _CardManager:GetPlayerCenterX()
			local py = _CardManager:GetPlayerCenterY()
			local z = self.Entity.TransformComponent.WorldPosition.z
			local dropScale = _CardManager:GetEffectScaleRatio(self) * self._hitEffectScaleMultiplier
			-- 문어(PlayInkSplat)처럼 화면 전체 범위에서 무작위 위치에 뜨도록 스프레드를 넓혔다(유저
			-- 요청: "연출 위치 좀 랜덤으로 화면내에(먹물처럼)"). PC 카메라 가시범위(±6.4, ±3.6) 대비
			-- 화면 밖으로 새지 않을 정도로 여유를 둔 값 — ink splat의 UI px 스프레드(±220,±140)를
			-- 월드 단위로 환산한 비율과 동일하다.
			local offsetX = (_UtilLogic:RandomDouble() * 2 - 1) * 1.5
			local offsetY = (_UtilLogic:RandomDouble() * 2 - 1) * 0.9
			local fxY = py + offsetY
			-- 유저 지정(2026-08-22, PlayInkSplat 하단 30% 제외와 동일한 요청 — "네펜데스랑 골든 어쩌구
			-- 걔네도") — PC 카메라 가시범위(세로 ±3.6, 전체 7.2) 기준 화면 하단 30%(2.16)를 제외한다.
			-- py(GetPlayerCenterY, 카메라가 대체로 플레이어를 따라가므로 화면 중심 Y의 근사치)를 기준으로
			-- 하단 경계는 py - 3.6 + 2.16 = py - 1.44.
			local worldBottomExcludeY = py - 1.44
			if fxY < worldBottomExcludeY then fxY = worldBottomExcludeY end
			local fxPos = Vector3(px + offsetX, fxY, z - 0.2)
			-- 실제 스폰/중복 방지는 GameManager가 전담한다(문어 PlayInkSplat과 동일한 전역 가드 —
			-- 유저 요청: "문어처럼", 여러 마리가 동시에 쏴도 화면엔 한 번에 하나만 뜨게 함).
			_GameManager:PlayRangedHitEffect(fxPos, self._hitEffectRUID, self._hitEffectDuration, map, dropScale, self._hitEffectMaxConcurrent, self._hitEffectAlpha)
		end, delay)
	end

	-- 푼코/쿠스코(Ep3Map3·4PunkoEasterEggLogic) 전용 — 유저 요청: "공격할때 이 이펙트가 몬스터 가운데서
	-- 나타나게". PlayRangedHitEffect(플레이어 위치)와 달리 몬스터 자기 자신의 WorldPosition에 즉시
	-- 띄운다 — 공격 순간 그 자리에서 재생되다 사라지는 연출. _selfAttackEffectRUID가 빈 문자열이면
	-- 아무것도 안 한다.
	@ExecSpace("ServerOnly")
	method void PlaySelfAttackEffect()
		if self._selfAttackEffectRUID == "" then return end
		local map = self.Entity.CurrentMap
		if map == nil then return end
		local pos = self.Entity.TransformComponent.WorldPosition
		local dropScale = _CardManager:GetEffectScaleRatio(self)
		local fxPos = Vector3(pos.x, pos.y, pos.z - 0.1)
		
		local fx = _SpawnService:SpawnByModelId("skilleffect", "SelfAttackFX", fxPos, map)
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		if renderer ~= nil then renderer.SpriteRUID = self._selfAttackEffectRUID end
		fx.TransformComponent.Scale = Vector3(dropScale, dropScale, 1)
		fx:Destroy(self._selfAttackEffectDuration)
	end

	-- 스노우맨(원거리) 전용 — 유저 요청: "눈덩이 투사체 연출 추가". attack1 재생과 동시에 몬스터
	-- 위치에서 스폰해 플레이어 위치까지 실제로 날아가는 투사체를 그린다. PlayRangedHitEffect(착탄
	-- 이펙트, _attackDuration*0.5 지연 후 재생)와 같은 타이밍에 도착·소멸하도록 이동 시간을 똑같이
	-- _attackDuration*0.5로 맞춘다 — "눈덩이가 날아가서 그 순간 맞는 이펙트가 뜬다"로 자연스럽게
	-- 이어지게. _projectileRUID가 빈 문자열(대부분의 다른 원거리 종)이면 아무것도 안 하고 기존처럼
	-- 착탄 이펙트만 뜬다.
	@ExecSpace("ServerOnly")
	method void PlayRangedProjectile()
		if self._projectileRUID == "" then return end
		local map = self.Entity.CurrentMap
		if map == nil then return end
		local startPos = self.Entity.TransformComponent.WorldPosition
		local px = _CardManager:GetPlayerCenterX()
		local py = _CardManager:GetPlayerCenterY()
		local dropScale = _CardManager:GetEffectScaleRatio(self)
		local travelDuration = self._attackDuration * 0.5
		
		local fx = _SpawnService:SpawnByModelId("skilleffect", "SnowballFX", startPos, map)
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		if renderer ~= nil then renderer.SpriteRUID = self._projectileRUID end
		fx.TransformComponent.Scale = Vector3(dropScale, dropScale, 1)
		
		_TweenLogic:PlayTween(0.0, 1.0, travelDuration, EaseType.Linear, function(t)
			if not isvalid(fx) then return end
			local x = startPos.x + (px - startPos.x) * t
			local y = startPos.y + (py - startPos.y) * t
			fx.TransformComponent.Position = Vector3(x, y, startPos.z - 0.3)
		end)
		
		fx:Destroy(travelDuration)
	end

	@ExecSpace("Multicast")
	method void PlayAttackAnimation(string attackRUID, string standRUID, number duration)
		if self:IsServer() then return end
		if self._dead then return end
		if self._attackSoundRUID ~= "" then _SoundOptionLogic:PlaySfx(self._attackSoundRUID, 1.0) end
		local renderer = self.Entity.SpriteRendererComponent
		if renderer == nil or attackRUID == "" then return end
		renderer.SpriteRUID = attackRUID
		-- OnSyncProperty(MonsterSprite)가 이 재생 중에 되돌리지 못하도록 표시(위 _isPlayingTransientSprite
		-- 주석 참고). 세대 번호를 찍어서, 공격 주기가 겹쳐 들어와도 "가장 최신 호출"의 타이머만 실제로
		-- 되돌리게 한다(위 _transientSpriteGeneration 주석 참고).
		self._isPlayingTransientSprite = true
		self._transientSpriteGeneration = self._transientSpriteGeneration + 1
		local myGeneration = self._transientSpriteGeneration
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			if self._transientSpriteGeneration ~= myGeneration then return end
			-- attack1 상태일 때만 stand로 복원 — hit1/die1로 이미 전환된 뒤라면 그대로 둔다
			if renderer.SpriteRUID == attackRUID then
				renderer.SpriteRUID = standRUID
			end
			self._isPlayingTransientSprite = false
		end, duration)
	end

	-- attack1 애니메이션 리소스가 없는 몬스터용 대체 연출. 이 게임은 몬스터 스케일 자체가
	-- "카메라와의 거리"를 표현하므로(접근할수록 커짐), 같은 방식으로 순간적으로 더 커졌다가
	-- 되돌아오게 해서 위치를 옮기지 않고도 "들이받는" 느낌을 준다. lungeBoost는 baseScale 대비
	-- 최대로 커지는 양(예: baseScale=1.0에 0.4를 주면 피크 스케일 1.4). hopHeight가 0보다 크면
	-- 같은 타이밍에 위로 살짝 뛰었다 착지하는 Y 모션을 더한다(0이면 기존과 동일하게 제자리 들이받기).
	@ExecSpace("ServerOnly")
	method void PlayLungeAnimation(number lungeBoost, number hopHeight)
		if self._dead then return end
		local mult = self._scaleMultiplier
		local baseScale = self._currentScale
		local baseY = self.Entity.TransformComponent.Position.y
		_TweenLogic:PlayTween(0.0, 1.0, 0.18, EaseType.QuadEaseOut, function(t)
			if not isvalid(self) or not isvalid(self.Entity) then return end
			local s = baseScale + lungeBoost * math.sin(t * math.pi)
			self.Entity.TransformComponent.Scale = Vector3(s * mult, s * mult, 1.0)
			if hopHeight > 0 then
				local pos = self.Entity.TransformComponent.Position
				self.Entity.TransformComponent.Position = Vector3(pos.x, baseY + hopHeight * math.sin(t * math.pi), pos.z)
			end
		end)
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 슬로우·스턴·도트 타이머 정리
		if self._slowTimerId ~= 0 then
			_TimerService:ClearTimer(self._slowTimerId)
			self._slowTimerId = 0
		end
		if self._stunTimerId ~= 0 then
			_TimerService:ClearTimer(self._stunTimerId)
			self._stunTimerId = 0
		end
		if self._dotTimerId ~= 0 then
			_TimerService:ClearTimer(self._dotTimerId)
			self._dotTimerId = 0
		end
		if self._miniMooreDropTimerId ~= 0 then
			_TimerService:ClearTimer(self._miniMooreDropTimerId)
			self._miniMooreDropTimerId = 0
		end
		if self._miniMooreLifeTimerId ~= 0 then
			_TimerService:ClearTimer(self._miniMooreLifeTimerId)
			self._miniMooreLifeTimerId = 0
		end
		if self:IsClient() and self._touchHandler ~= nil then
			self.Entity:DisconnectEvent(TouchEvent, self._touchHandler)
			self._touchHandler = nil
		end
		if isvalid(self._freezeIndicator) then
			self._freezeIndicator:Destroy()
			self._freezeIndicator = nil
		end
		self:ClearAllComboOrbs()
		self:DestroyStunStars()
		-- 성능 최적화(2026-08-24) — SetSpawnZone에서 등록한 존별 레지스트리 항목을 뗀다. OnEndPlay는
		-- Die()든 직접 Entity:Destroy()든(지연 파괴 포함) 파괴 경로와 무관하게 항상 불리므로, 등록 짝을
		-- 여기 한 곳에만 두면 어디서 죽거나 파괴되든 레지스트리가 새지 않는다.
		_MonsterSpawner:UnregisterZoneMonster(self._spawnZoneIndex, self)
	end

end