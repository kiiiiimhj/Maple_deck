@Component
script MonsterAI extends Component

	-- 몬스터 스탯
	property number MaxHp = 100

	property number CurrentHp = 100

	@Sync
	property string MonsterSprite = ""

	-- 접근 속도: 초당 스케일 증가량 (0.3 → 1.5까지 약 4초)
	-- 웨이브별 스프라이트 동기화 (서버 → 클라이언트)
	property number ApproachSpeed = 0.3

	-- 도착 타이밍 분산: 개체별로 ApproachSpeed를 ±이 값만큼 무작위로 흔들어
	-- 같은 타이밍에 스폰된 몬스터들이 동시에 도착하지 않게 한다
	property number ApproachSpeedVariance = 0.08

	-- 정면 도착 후 공격 간격 (초)
	property number AttackInterval = 1.0

	-- 엔진 기본 데미지 스킨 RUID (DamageSkinSettingComponent 기본값과 동일 — 실제 메이플스토리 데미지 숫자 그래픽)
	property string _damageSkinId = "6ba67548f43f48f29eb23dafd0766383"

	@Sync
	property boolean _dead = false

	-- 내부 상태
	-- _dead는 원래 서버 전용 로컬 프로퍼티였는데, 클라이언트 쪽 애니메이션 코드(OnSyncProperty/
	-- PlayHitAnimation/PlayAttackAnimation)가 전부 "죽었으면 무시"를 self._dead로 체크하고 있었다 —
	-- @Sync가 없어서 클라이언트 자신의 _dead는 절대 true가 안 되니 그 가드들이 전부 무효였던 것
	-- (죽는 애니 재생 직후 늦게 도착한 다른 애니 갱신이 덮어써버리는 버그의 진짜 원인).
	property number _currentScale = 0.3

	property boolean _reachedPlayer = false

	property number _attackTimer = 0

	-- 스폰된 존 번호(InitializeStats가 넘겨준 zoneIndex를 저장) — Die()에서 존16~17 전용
	-- 재화(야누스의 검 교환권) 드롭 판정에 쓴다
	property integer _spawnZoneIndex = 0

	-- InitializeStats가 뽑은 외형 인덱스(웨이브 번호 또는 존 전용 풀 내 인덱스) 저장 — Die()에서
	-- GameManager.GetMonsterLootItemId(zoneIndex, speciesIdx)로 "실제 그 몬스터의 드롭템"을 결정하는 데 쓴다
	property integer _speciesIdx = 0

	-- 맵23 에르다스 이스터에그 전용(InitializeErdas) — 이 몬스터가 죽을 때 존 잡템 대신
	-- Map23ErdasEasterEggLogic.OnErdasKilled에 알려서 정수 드롭+킬카운트를 처리한다
	property boolean _isErdas = false

	property integer _erdasOrdinal = 0

	-- 맵24 진 힐라의 보물상자 전용(InitializeTreasureChest) — 죽을 때 Map24TreasureChestLogic에 알린다
	property boolean _isTreasureChest = false

	-- 에르다스/보물상자 전용 피격·사망 사운드(기본 몬스터 풀은 사운드가 없어 빈 문자열 유지)
	property string _hitSoundRUID = ""

	property string _dieSoundRUID = ""

	-- true면 정면 도달(_reachedPlayer)해도 OnReachPlayer(플레이어 공격)를 호출하지 않는다 — 보물상자처럼
	-- 스탯 몬스터를 재사용하되 공격은 안 하는 고정 타겟을 만들 때 쓴다
	property boolean _neverAttacks = false

	-- 거대 네펜데스 전용 2단계 부활 메커니즘(유저 요청, 2026-08-10 확정). 1페이즈(첫 등장, 패시브)로
	-- 죽으면 진짜 죽지 않고 그 자리에서 2페이즈(원거리 공격)로 부활하고, 2페이즈가 죽어야 진짜 사망한다.
	-- 네펜데스/다크네펜데스는 이 메커니즘과 완전히 무관하다(거대 네펜데스 자신의 사망 처리 분기일 뿐,
	-- 다른 종을 거대 네펜데스로 변신/소환시키지 않는다 — 유저가 여러 차례 강하게 확정한 사항).
	property boolean _isGiantNepenthes = false

	property boolean _giantNepenthesRevived = false

	-- 예티/다크예티/예티와페페/다크예티와페페(에피소드3 map2) 전용 범용 2단계 부활 메커니즘 — 위
	-- 거대 네펜데스와 동일한 구조(1페이즈 die1 재생 후 진짜 죽지 않고 2페이즈로 부활)이지만, 종마다
	-- 1/2페이즈 외형이 전부 달라서 GiantNepenthes*처럼 고정 프로퍼티가 아니라 존 풀 테이블
	-- (GetMapHasPhase2/GetMapPhase2*RUID, mapIndex+idx 기준)로 관리한다.
	property boolean _hasPhase2 = false

	property boolean _phase2Revived = false

	-- 2페이즈 발동 확률(0.0~1.0, 기본 1.0=항상). 주니어 예티(사망 시 50%만 성체 예티로 성장)처럼 부활이
	-- 확정이 아닌 종을 위한 필드 — 실제 굴림은 Die()에서 1회만 한다.
	property number _phase2Chance = 1.0

	-- 공격 사운드(선택적 — 대부분 종은 비워둔다). 현재는 거대 네펜데스 2페이즈 전용으로만 채워진다.
	property string _attackSoundRUID = ""

	-- 슬로우 상태 (콜드 빔)
	-- 유물 수리검(10번) 판정용 — 마지막으로 받은 타격이 치명타였는지. Die()에서 확률 굴림에 쓴다
	property boolean _lastHitWasCrit = false
	property boolean _isSlowed = false

	property integer _slowTimerId = 0

	-- 감전(스턴) 상태 (썬더볼트)
	property boolean _isStunned = false

	property integer _stunTimerId = 0

	property number _stunSavedSpeed = 0

	-- 명중 하락(연막탄 전용) — 0이면 정상, >0이면 그 확률만큼 OnReachPlayer에서 공격이 "빗나감"
	-- 처리된다(보스/엘리트는 OnReachPlayer에서 절반만 적용). 재적용 시 확률/타이머 갱신.
	property number _accuracyDebuffPercent = 0

	property integer _accuracyDebuffTimerId = 0

	-- 완전 빙결(아이템 "얼음 파편" 전용) — 빙결스택(FreezeStack, 슬로우만 걸리는 별도 시스템)과도,
	-- 스턴(ApplyStun, 스킬별로 걸리고 풀리는 자기 타이머)과도 독립된 상태다. 행동불가 + 진한 파란색
	-- 틴트로 고정 지속시간(7초) 동안 완전히 멈춰있다가 자동으로 원래대로 돌아온다.
	property boolean _isHardFrozen = false

	property integer _hardFreezeTimerId = 0

	property Color _preHardFreezeColor = Color(1, 1, 1, 1)

	-- 공중 부양 상태 (아쿠아 트랩). 착지 타이머를 추적해야, 같은 대상이 아직 떠 있는 도중에
	-- 다시 걸렸을 때(부스터로 쿨타임이 속박시간보다 짧아지면 실제로 발생) 기준 높이를 다시 잡지
	-- 않고 그대로 재예약할 수 있다 — 안 그러면 기준 높이가 계속 위로 밀려 올라가 영영 안 내려온다.
	property boolean _isLevitating = false

	property integer _levitateTimerId = 0

	property number _levitateBaseY = 0

	-- 도트 데미지 상태 (메테오)
	property number _dotDamage = 0

	property integer _dotTicksLeft = 0

	property integer _dotTimerId = 0

	-- 엘리트 상태 (5웨이브마다 스폰 그룹 중 1마리).
	-- @Sync인 이유: 엘리트 표식(발밑 오라)을 **클라가 스스로** 켜야 하기 때문이다. MarkElite는 스폰
	-- 직후에 불리는데, 그 시점엔 클라에 엔티티가 아직 없을 수 있어서 Multicast로 오라를 쏘면
	-- self.Entity가 유효하지 않아 조용히 실패한다. @Sync로 두면 클라가 엔티티를 만든 뒤
	-- OnSyncProperty로 값을 받으므로 타이밍 경합이 없다.
	@Sync
	property boolean _isElite = false

	property number _scaleMultiplier = 1.0

	-- ── 엘리트 표식: 발밑 오라 (유저 지정 2026-09-08) ─────────────────────────────────
	-- "테두리 노란색으로 감기는 거 쪼금 짜치는데" → 아웃라인 머티리얼을 걷어내고, 메이플 본가처럼
	-- 바닥에 원근으로 깔리는 오라 링을 발밑에 붙인다. 원본 스프라이트는 전혀 안 건드린다.
	-- RUID는 바닥 원근 골드 링(7프레임, 320x280 — 썸네일 육안 확인). 엔티티에 **부착**이라
	-- 몬스터가 접근하며 커지면 오라도 같이 커지고, 존 이동/파괴 때도 같이 따라간다.
	property string EliteAuraRUID = "34887ea12dd34598a59c8fb9fb210c13"

	-- 몬스터 엔티티 스케일에 곱해지는 로컬 배율(부착 이펙트라 부모 스케일을 상속한다)
	property number EliteAuraScale = 0.30

	property number EliteAuraYOffset = 0.0

	-- 클립이 7프레임 루프라 밝기가 오르내린다(맥동). 가장 어두운 프레임에서도 "엘리트구나"가
	-- 읽혀야 해서 알파는 1.0로 둔다 — 더 은은하게 하고 싶으면 이 값만 낮추면 된다.
	property number EliteAuraAlpha = 1.0

	-- 클라이언트 로컬 — _EffectService:RemoveEffect에 넘길 시리얼(0이면 재생 중 아님)
	property integer _eliteAuraSerial = 0

	-- 웨이브10 리본돼지 보스인지 여부 — Die()에서 GameManager에 보스 처치를 알리는 데 사용.
	-- @Sync인 이유: CardManager.ScanMonsterBoxAt(맵 오브젝트 터치 가드)이 **클라에서** 보스 여부를
	-- 알아야 터치 판정 상자에 보스 배율(FocusBoxBossScale)을 적용할 수 있다. 쓰기는 전부 서버 쪽
	-- (InitializeStats 등)이라 동기화 방향(서버→클라)과 어긋나지 않는다.
	@Sync
	property boolean _isBoss = false
	-- 에피소드1 보스 분열(2페이즈) 관련. _ep1BossSplitDone은 보스 쪽 1회 가드,
	-- _isEp1BossSplit은 튀어나온 분열체 쪽 표식(사망 시 스포너에 생존 수를 알려야 한다)
	property boolean _ep1BossSplitDone = false
	-- 이번 보스가 분열 기믹을 가진 종인지(에피소드1 로스터의 hasSplit). 보스 순번마다 다르므로
	-- InitializeStats가 스폰할 때마다 다시 세운다 — 기믹 없는 보스(블루 머쉬맘)는 false라
	-- 일반 사망 경로로 바로 흘러간다.
	property boolean _hasEp1Split = false
	property boolean _isEp1BossSplit = false
	property integer _ep1SplitFadeTimerId = 0

	-- 맵10 보너스 스테이지 전용 보스 여부 — true면 접근/공격 대신 배회하고, 사실상 무적이며
	-- 맞을 때마다(죽지 않고) 골드/포션/스킬을 지급한다. MonsterSpawner.InitializeBonusBoss()가 설정한다.
	property boolean _isBonusBoss = false

	-- 유저 지정(2026-08-26): "보스 체력을 만들자" — ep3_map2 커플예티 보너스보스만 이 플래그로 실제
	-- HP를 추적해 진짜로 죽을 수 있게 한다(InitializeAnimatedBonusBoss가 true로 설정). 맵10의 구식
	-- 정적 보너스보스(InitializeBonusBoss)는 이 플래그를 안 건드리므로 기존처럼 영원히 무적으로 남는다.
	property boolean _bonusBossKillable = false

	-- 유저 지정(2026-08-26): "타이머가 돌아갈때 공격하게 바꿔줘(타이머 있는 모든곳)" — 존이동/스폰
	-- 직후 화면이 아직 전환 중이거나 타이머가 "30"으로 표시되기 전(1초 지연 구간)에는 유저가 상황을
	-- 인지하기도 전에 공격이 이미 들어가고 있었다(버그 리포트). 두 보너스보스(맵10 InitializeBonusBoss,
	-- ep3_map2 InitializeAnimatedBonusBoss) 모두 스폰 즉시 이 플래그를 true로 걸어 완전히 무적/타겟불가
	-- 취급하고, 각 소유 Logic이 실제로 타이머를 보여주기 시작하는 시점에 false로 풀어준다.
	property boolean _bonusBossCombatLocked = false

	-- 존27 석상 이스터에그 전용("얄미운 미니무르") — 전투 대상이 아니다(타격 완전 무시, 무적/사망 개념
	-- 자체가 없음). 순수 시간 기반: MiniMooreDropInterval마다 무조건 뭔가 하나 떨어뜨린다 —
	-- MiniMooreDropChance 확률로 보유 스킬, 그 외엔 잡템(RollMiniMooreDrop 참고) — 하다가
	-- MiniMooreLifetime이 지나면 스스로 날아올라 사라진다(PlayDespawnJump 재사용).
	-- NinjaStatuePuzzleLogic.SpawnMiniMoore()가 InitializeMiniMoore()로 설정한다.
	property boolean _isMiniMoore = false

	property number MiniMooreDropInterval = 1.0

	property number MiniMooreDropChance = 0.03

	-- 스폰 즉시 드랍하면 어색해서 첫 드랍은 MiniMooreDropInterval만큼 지연시킨다(SetTimerRepeat의
	-- startDelaySeconds) — 그래서 총 유지시간도 12초(드랍 12번)+시작 지연 1초 = 13초로 늘렸다.
	property number MiniMooreLifetime = 13.0

	property integer _miniMooreDropTimerId = 0

	property integer _miniMooreLifeTimerId = 0

	-- 존2 trap-44 이스터에그 "마노"(InitializeStatsAsMano) — 미니무르 계열과 달리 실제로 잡을 수 있고,
	-- 처치하면 Die()가 Ep1Zone2ManoLogic으로 보상 지급을 넘긴다. 유저 지정: HP 1000 고정 / 10초 제한.
	property boolean _isMano = false

	property number ManoFixedHp = 1000

	property number ManoLifetime = 10.0

	property integer _manoLifeTimerId = 0

	property number _wanderMinX = -5

	property number _wanderMaxX = 5

	property number _wanderY = -1.18

	property number _wanderTargetX = 0

	property number _wanderSpeed = 1.6

	property number _wanderRetargetTimer = 0

	property integer BonusGoldPerHit = 8

	property number BonusPotionChance = 0.10

	property number BonusSkillChance = 0.01

	@Sync
	property boolean _isLostRudolph = false

	@Sync
	property boolean IsStanding = false

	-- 에피소드3 map2 존10 "길잃은 루돌프" 이스터에그(Ep3Map2LostRudolphLogic) — _isMiniMoore를 그대로
	-- 재사용해 전투 완전 무시(일반 공격 X, 유저 지정) + 지상 배회(UpdateWander)를 얻고, 여기에 이동/정지
	-- 애니메이션 사이클(4~6초 이동→1초 정지)만 얹는다. 정지 중에 터치하면 성공(die1 재생 후 사라짐,
	-- 보상 없음), 이동 중에 터치하면 실패(Ep3Map2LostRudolphLogic이 "불량 루돌프" 2마리를 소환).
	-- 버그 수정(2026-08-26, 유저 리포트 "길잃은 루돌프를 눌러도(움직일때) 불량 루돌프는 생성이
	-- 안되네") — @Sync가 없어서 클라이언트 쪽 이 값은 항상 기본값(false)에 머물렀다. 서버가
	-- InitializeLostRudolph()에서 true로 세팅해도 그 값이 클라에 동기화되지 않아, 클라 전용 터치
	-- 핸들러(OnLostRudolphClientTouched)의 가드(`if not self._isLostRudolph then return end`)가
	-- 매번 조용히 막고 있었다 — 터치 자체가 서버까지 전달되지 않았던 원인.
	property number _lostRudolphCycleTimer = 0

	property number LostRudolphMoveMin = 4.0

	property number LostRudolphMoveMax = 6.0

	property number LostRudolphStandDuration = 1.0

	property any _touchHandler = nil

	-- "불량 루돌프"(길잃은 루돌프를 이동 중에 잘못 터치했을 때의 처벌 소환) 전용 — 정상 처치 보상
	-- (골드는 유저 지정대로 정상 지급되지만 EXP/잡템/장비/스킬 드롭은 전부 없음, Die() 참고)
	property boolean _isBadRudolph = false

	-- 맵23 에르다스 전용 — 도달(_reachedPlayer)한 뒤 제자리에 얼어붙는 대신 공중 발판 위를 좌우로
	-- 배회하며 공격한다(유저 요청: "좌우로 이동하면서 공격하면 좋겠거든"). 배회 목표가 발판 범위를
	-- 벗어나면(유저 요청: "발판을 벗어나면 아래로 떨어지게") 실제 발판 유무를 매 프레임 레이캐스트로
	-- 확인해서 없으면 낙하로 전환한다. BonusBoss의 UpdateWander(고정 Y, 항상 안전한 바닥)와 달리
	-- 지형을 따라 Y가 실시간으로 바뀌고, 발판이 없으면 중력으로 떨어지다가 아래쪽 발판(맵23 메인
	-- 바닥이 전체 폭을 덮고 있어 결국 착지함)에 닿으면 다시 배회를 재개한다.
	property number _erdasPatrolMinX = -1.3

	property number _erdasPatrolMaxX = 1.3

	property number _erdasPatrolTargetX = 0

	property number ErdasPatrolSpeed = 0.8

	property number _erdasPatrolRetargetTimer = 0

	property boolean _isErdasFalling = false

	property number _erdasFallVelocity = 0

	property number ErdasGravity = 9.8

	-- 맞을 때마다 스케일이 커지는 효과(유저 요청: "때릴때마다 2%씩 스케일이 커지면 좋겠어 맥스 20%") —
	-- _scaleMultiplier 자체를 곱하지 않고 별도 배율로 둔다(그래야 정확히 +2%p씩 20%까지 선형으로
	-- 쌓이고, 이미 적용된 사이즈 절반(0.5배)과도 독립적으로 곱연산된다)
	property number _erdasHitGrowthBonus = 0

	property number ErdasHitGrowthPerHit = 0.02

	property number ErdasHitGrowthMaxBonus = 0.20

	-- 스폰 시점 웨이브의 die1 / hit1 / attack1 애니메이션 RUID 및 재생 시간
	property string _dieRUID = ""

	property number _dieDuration = 0.5

	property string _hitRUID = ""

	property string _attackRUID = ""  -- 없는 웨이브(3/5/6/8/9/10)는 빈 문자열 → 들이받기 연출로 대체

	-- attack1/hit1 스프라이트가 화면에 떠 있는 동안 true — PlayAttackAnimation/PlayHitAnimation(둘 다
	-- 클라이언트에서 실행)이 직접 세팅/해제한다. OnSyncProperty가 이 플래그로 "지금 재생 중인 공격/피격
	-- 포즈를 MonsterSprite 동기화가 되돌려버리면 안 된다"를 판단한다 — _attackRUID/_hitRUID 자체는
	-- @Sync가 아니라 클라이언트에서 항상 ""로 읽히므로 그 값으로는 판단할 수 없다(실측으로 확인된 함정).
	property boolean _isPlayingTransientSprite = false

	-- 공격 연출(attack1)이 화면에 떠 있는 동안만 true. 위 _isPlayingTransientSprite는 피격 연출에도
	-- 켜지기 때문에 "지금 공격 중인가"를 구분할 수 없어서 따로 뒀다. PlayAttackAnimation이 켜고
	-- 그 복원 타이머가 끈다(둘 다 클라이언트) — 같은 클라 안에서만 쓰므로 @Sync가 필요 없다.
	property boolean _isPlayingAttackSprite = false

	-- 켜져 있으면 공격 연출 재생 중에는 피격 연출로 갈아끼우지 않는다(대미지는 그대로 들어간다).
	-- 유저 지정 — 에피소드1 보스는 attack1이 1.8초로 길어서, 그 사이에 맞을 때마다 1프레임짜리
	-- hit1로 튀어 공격 연출이 계속 끊겨 보였다. 서버(InitializeStats)가 정하고 클라의
	-- PlayHitAnimation이 읽어야 하므로 @Sync가 필요하다.
	@Sync property boolean _noHitAnimDuringAttack = false

	-- 버그 수정(2026-08-27, 유저 리포트: "웨어울프나 라이칸이나 연출이 끝까지 나올때가 있고 그냥
	-- 안나올때가 있는거 같아") — 공격 주기(AttackInterval)가 attack1 재생시간(_attackDuration)보다
	-- 짧은 종은 이전 공격의 복귀 타이머가 살아있는 채로 다음 공격이 겹쳐 들어온다. PlayAttackAnimation/
	-- PlayHitAnimation의 복귀 타이머는 "지금 스프라이트가 내가 세팅한 attackRUID/hitRUID와 같은가"만
	-- 확인해서 되돌리는데, attackRUID는 종 전체가 같은 값이라 새/구 타이머를 구분 못 해 구 타이머가
	-- 새로 시작한 재생을 조기에 stand로 끊어버리고 _isPlayingTransientSprite까지 꺼버린다(그 순간 마침
	-- 도착한 MonsterSprite 동기화가 다시 덮어쓸 수 있는 창이 열림) — "가끔 끝까지 나오고 가끔 아예
	-- 안 보인다"가 정확히 이 겹침 여부에 좌우된다. 매 PlayAttackAnimation/PlayHitAnimation 호출마다
	-- 1씩 증가시켜, 각 복귀 타이머가 "내가 최신 세대일 때만" 되돌리게 한다(AttackInterval 튜닝과
	-- 별개로, 어떤 종에서도 이 겹침 자체가 다시는 문제되지 않도록 하는 이중 안전장치).
	property integer _transientSpriteGeneration = 0

	-- attack1 스프라이트를 원래 포즈로 되돌리기까지 대기하는 시간 — 클립 프레임 수가 다 다른데 기존엔
	-- 0.25초로 고정돼 있어서, 프레임이 많은 종(자이언트 쉐도우 8프레임 등)은 재생 중간에 잘려 보였다.
	-- die1과 같은 재생 속도(초당 약 10프레임) 가정으로 종별 프레임 수에 맞춰 GetMapAttackDuration이 계산해 준다.
	property number _attackDuration = 0.25

	-- 원거리 종(네펜데스/다크네펜데스/거대 네펜데스 2페이즈) 전용 히트 이펙트(attack1/info/hit 서브클립).
	-- 빈 문자열이면 PlayRangedHitEffect가 아무것도 재생하지 않는다.
	property string _hitEffectRUID = ""

	property number _hitEffectDuration = 0.5

	-- 착탄 연출이 정지 스프라이트 **2장**으로 쪼개져 있는 종(블랙 나이트의 attack1/info/hit/0 → /1)의
	-- 두 번째 그림. 빈 문자열이면 기존처럼 1장만 뜬다 — 자세한 동작은 GameManager.PlayRangedHitEffect 참고.
	property string _hitEffectRUID2 = ""

	-- 착탄 그림이 **정지 스프라이트 N장**으로만 제공되는 종(심연의 마스터 레쉬 — 팩에 합쳐진
	-- attack1/info/hit 클립이 없다)용 프레임 목록. nil이면 기존 경로(단일 클립 / 2장)를 그대로 탄다.
	-- _hitEffectRUID2(2장 전용)의 N장 일반화다.
	property any _hitEffectFrames = nil

	-- 위 프레임 목록의 장당 재생시간(초). 총 재생시간 = 이 값 × 장수.
	property number _hitEffectFrameDelay = 0

	-- 착탄 연출(PlayRangedHitEffect)이 뜨기까지의 지연(초). 0이면 기존 공식(_attackDuration × 0.5).
	-- attack1이 긴 종에서 연출이 뜨기 전에 몬스터가 죽어 취소되는 문제 때문에 도입했다 — 자세한 배경은
	-- PlayRangedHitEffect 주석 참고. 기존 원거리 종은 전부 0이라 동작이 바뀌지 않는다.
	property number _hitEffectDelayOverride = 0

	-- 원거리 착탄 연출이 뜨는 범위(모든 원거리 종 공통, 유저 지정 2026-09-07). 전부 **플레이어 기준
	-- 월드 유닛**이고, 실측 근거는 PlayRangedHitEffect 주석 참고.
	--   CenterY = 플레이어 발밑에서 위로 이만큼 올린 곳이 밴드의 중심(화면 중앙은 +1.41 지점)
	--   SpreadY = 그 중심에서 위아래로 흔드는 폭 → 실제 밴드는 py+1.7 ~ py+3.3
	--   SpreadX = 좌우로 흔드는 폭(가시 반폭 5.56 중 4.2 → 양 끝 24%만 비운다)
	property number RangedHitFxCenterY = 2.5

	property number RangedHitFxSpreadY = 0.8

	property number RangedHitFxSpreadX = 4.2

	-- ── 보스 2번째 공격 = 소환기(에피소드1 로스터의 attack2/summon* 칸) ──────────────────
	-- _summonCooldown이 0이면 이 보스는 소환기가 없다(로직 자체가 안 돈다). 도달(_reachedPlayer)한
	-- 뒤부터 쿨타임을 세고, 만료되면 attack2 모션을 재생하면서 부하를 부른다.
	property string _attack2RUID = ""

	property number _attack2Duration = 0

	property string _attack2SoundRUID = ""

	property number _summonCooldown = 0

	property integer _summonCount = 0

	property number _summonTimer = 0

	-- ── 맞을수록 성장하는 보스(4번 다일) ─────────────────────────────────────────────
	-- 전부 0이면 성장 로직이 안 돈다(다른 보스/일반 몬스터). 스택은 TakeDamage 계열 5곳에서
	-- ApplyBossHitGrowth()로 1씩 쌓인다.
	--   크기: 에르다스가 쓰던 성장 배율(_erdasHitGrowthBonus)을 **그대로 재사용**한다 —
	--         OnUpdate의 스케일 대입 두 곳(접근 중/도달 시)에 이미 물려 있어서 새 배선이 필요 없다.
	--         한 엔티티가 에르다스이면서 동시에 다일일 수는 없으므로 충돌하지 않는다.
	--   공격속도: _growAtkBonus만큼 공격 주기를 나눈다(GetEffectiveAttackInterval).
	property number _growScalePerHit = 0

	property number _growScaleMax = 0

	property number _growAtkPerHit = 0

	property number _growAtkMax = 0

	property number _growAtkBonus = 0

	-- PlayRangedHitEffect의 dropScale에 곱해지는 추가 배율(기본 1.0=무영향). Ep2MiniBeanEasterEggLogic
	-- 전용 값(30% 크게)뿐 아니라, InitializeStats(존 풀 종)에서도 GameManager.GetMapHitEffectScaleMultiplier로
	-- 채운다 — 유저 지정(2026-08-25): 몽실생크림 20%·예티류 15% 축소.
	property number _hitEffectScaleMultiplier = 1.0

	-- 원거리 히트 이펙트 알파(투명도, GameManager.GetMapHitEffectAlpha와 짝) — 기본 1.0. 유저 지정
	-- (2026-08-25): 예티류만 15% 감소(0.85).
	property number _hitEffectAlpha = 1.0

	-- 원거리 히트 이펙트 동시 출력 개수 상한(GameManager._rangedHitEffectActiveCount와 짝) — 기본 1(기존
	-- 종은 전부 이 값), 예티류만 유저 지정으로 3(GetMapHitEffectMaxConcurrent 참고).
	property integer _hitEffectMaxConcurrent = 1

	-- 스노우맨(원거리) 전용 — 몬스터 위치에서 플레이어 위치까지 실제로 날아가는 투사체(attack1/info/ball
	-- 서브클립, 유저 제공). 빈 문자열이면 PlayRangedProjectile이 아무것도 재생하지 않는다(기존 원거리
	-- 종처럼 착탄 이펙트(_hitEffectRUID)만 뜬다).
	property string _projectileRUID = ""

	-- 푼코/쿠스코(Ep3Map3·4PunkoEasterEggLogic) 전용 — 공격 순간 몬스터 자기 자신의 위치(중앙)에 뜨는
	-- 연출(attack1/info/effect 서브클립, 유저 지정: "푼코 가운데서 나타나게"). _hitEffectRUID(플레이어
	-- 위치에 뜨는 착탄 이펙트)와 달리 몬스터 자신의 WorldPosition에 뜬다는 점이 다르다. 빈 문자열이면
	-- PlaySelfAttackEffect가 아무것도 안 한다.
	property string _selfAttackEffectRUID = ""

	property number _selfAttackEffectDuration = 0.5

	-- 공격 시작(attack1 재생 시작) 시점부터 이 연출이 뜨기까지의 지연(초). 0이면 즉시(푼코/쿠스코의
	-- 기존 동작 그대로). attack1 클립이 "뜸을 들였다가 터지는" 종은 그 터지는 프레임 시각을 넣어야
	-- 연출이 따로 논다는 느낌이 안 난다(블루 머쉬맘 = 0.80초).
	property number _selfAttackEffectDelay = 0

	-- 원거리 히트 이펙트를 쓰는 종(네펜데스/다크네펜데스/거대 네펜데스 2페이즈) 전용 공격 쿨타임
	-- 오버라이드 — 유저 요청: "너무 빠르게 공격하는 감이 있는데 공격하고 0.7초정도는 쉬자". 0이면
	-- 공용 AttackInterval을 그대로 쓴다. 공격 애니메이션(_attackDuration) 재생이 끝난 뒤 순수하게
	-- 쉬는 시간이 0.7초가 되도록 attackDuration + 0.7로 계산한다.
	property number _customAttackInterval = 0

	-- 빠른 이동 안전장치 2단계(6연속) 전용 — ApplyRushPenalty가 세팅. 1.0이면 평소와 동일(강화 없음).
	-- 2026-08-17 유저 요청("6연속때 공격력 더 쎄게")으로 체력/공격력 배율을 분리했다. 원래는 둘 다
	-- RushTier2StatMultiplier 하나를 공용으로 썼는데, 그대로 올리면 몬스터가 같이 탱키해져서
	-- "빨리 죽이고 지나가기"가 더 어려워지는 역효과가 난다 — 체력은 1.2 유지, 공격력만 1.8로 올린다.
	property number RushTier2StatMultiplier = 1.2

	property number RushTier2DamageMultiplier = 1.8

	property number _rushDamageMultiplier = 1.0

	-- 접근(스케일 확대) 중 보여줄 이동 애니메이션. MonsterSprite는 "지금 화면에 보여야 할 정지 포즈"
	-- 하나만 나타내던 프로퍼티였는데, 이제 접근 중엔 move, 도달(_reachedPlayer)하면 stand로 스스로 갈아끼운다 —
	-- PlayHitAnimation/PlayAttackAnimation이 전부 self.MonsterSprite를 "복귀할 정지 포즈"로 참조하므로, 이렇게
	-- MonsterSprite 자체를 단계별로 바꿔주면 히트/공격 연출 복귀 로직을 손댈 필요가 없다(항상 "지금 단계의
	-- 올바른 포즈"로 자동 복귀됨). 공중형은 스케일 접근이 아니라 자유비행이라 move 연출 자체가 필요 없어
	-- _moveRUID가 빈 문자열로 유지되고(InitializeStats), 그 경우 MonsterSprite는 항상 _standRUID로 고정된다.
	--
	-- @Sync인 이유(2026-09-13): 포커스(에임) 터치 판정 상자를 **스프라이트 원본 크기 기준**으로 잡으면서
	-- 클라이언트(CardManager.ScanMonsterBoxAt — 맵 오브젝트 터치 가드)도 이 RUID로 원본 크기를 읽어야
	-- 한다. 서버와 클라가 같은 상자를 쓰지 않으면 "에임은 잡히는데 오브젝트도 같이 눌리는" 어긋남이 생긴다.
	-- 쓰기는 전부 서버(InitializeStats 계열)라 동기화 방향과 충돌 없음(_isBoss를 @Sync로 바꾼 것과 같은 이유).
	-- MonsterSprite(이미 @Sync) 대신 이걸 쓰는 건, MonsterSprite는 공격/피격 중 클립이 바뀌어서
	-- 상자 크기가 흔들리기 때문 — stand 클립이 크기 기준으로 안정적이다.
	@Sync
	property string _standRUID = ""

	property string _moveRUID = ""

	-- 맵 전용 몬스터 풀 중 원거리(먹물) 공격 종인지 여부 — true면 도달 시 들이받기 대신 화면 잉크 스플랫 연출
	property boolean _isRangedInk = false

	-- 원거리 종이 근접 종보다 "조금 멀리서" 공격하도록, 도달 판정(_reachedPlayer) 스케일 임계값을 낮춰준다.
	-- 근접은 기존과 동일하게 1.5(최대 크기)까지 다가와야 도달 판정, 원거리는 이보다 작은 값에서 멈춘다
	property number _reachedScaleThreshold = 1.5

	property number RangedReachedScale = 1.15

	-- 맵 전용 몬스터 풀 중 원거리(칼자국) 공격 종인지 여부(자이언트 쉐도우) — _isRangedInk와 마찬가지로
	-- 도달 임계값을 낮추지만, 대체 연출이 아니라 기존 attackRUID 스프라이트 스왑 공격 위에 발톱자국
	-- 이펙트(PlaySlashEffect)를 얹는다(OnReachPlayer 참고) — 자이언트 쉐도우는 자체 attack1 애니메이션이
	-- 이미 있어서 대체할 필요가 없다.
	property boolean _isRangedSlash = false

	-- 발톱자국 이펙트 리소스 — 애초에 UI 아이콘 하나를 전 몬스터가 공유하는 방식(_slashMarkActive 가드)
	-- 이었는데, 여러 마리가 동시에 공격하면 첫 번째 것만 보이고 나머지는 씹히는 버그가 있었다(유저 실측:
	-- "지금은 공격 이펙트 1개만 뜨는듯"). "skilleffect" 월드 이펙트(개별 Entity라 마리마다 독립적으로
	-- 동시에 뜰 수 있음)로 바꿔서 해결. RUID는 애니메이션클립 전체(4프레임)를 그대로 써서 발톱이 스치는
	-- 과정 자체가 재생되게 한다(정적 프레임 하나만 쓰던 것보다 자연스러움).
	-- 작게 시작해서(StartScale) 크게(EndScale) 자라나며 화면 쪽으로 다가오는 느낌을 준다(유저 요청 —
	-- "검기 발산하는 것처럼 사이즈가 커지면서 화면에 닿으면 더 좋을듯").
	property string SlashEffectRUID = "954ea7049e454950b7e44643049de099"

	property number SlashEffectStartScale = 0.15

	property number SlashEffectEndScale = 0.6

	-- 0.5초였을 때 "너무 빨리 끝나서 잘 안 보인다"는 피드백 — 0.65초로 늘리고, 스프라이트 자체 재생
	-- 속도(PlayRate)도 늦춰서 이 늘어난 지속시간 내내 (마지막 프레임의 흐릿한 잔광이 아니라) 선명한
	-- 발톱자국 프레임이 계속 보이게 한다.
	property number SlashEffectDuration = 0.65

	property number SlashEffectPlayRate = 0.5

	-- 깊이감 연출: 몬스터 위에 같은 스프라이트를 검게 덧씌운 자식 엔티티(.model의 "DepthOverlay")를
	-- 스폰 시점(뒤쪽, 알파 최대)부터 도달 시점(앞쪽, 알파 0)까지 _currentScale 진행도에 맞춰 점점
	-- 투명하게 만들어 "멀리 있을수록 어둡고 다가올수록 원래 색이 드러나는" 것처럼 보이게 한다.
	-- 몬스터 자체의 Color를 바꾸는 게 아니라 별도 오버레이 레이어라서, 슬로우/빙결 틴트(ApplySlow 등)와
	-- 절대 간섭하지 않는다.
	property number DepthOverlayMaxAlpha = 0.5

	property SpriteRendererComponent _depthOverlayRenderer = nil

	-- 같은 종/같은 웨이브로 스폰된 몬스터는 스폰 직후 스케일이 완전히 동일해서(ApproachSpeedVariance가
	-- 아직 벌려놓기 전) Z값이 겹친다 — 이때 그림자(DepthOverlay, 자기 본체보다 로컬 Z -0.001만큼 항상
	-- 앞에 그려짐)가 Z가 같은 "다른" 몬스터의 본체 앞으로 잘못 겹쳐 보일 수 있다. OnBeginPlay에서
	-- 개체마다 한 번만 뽑는 미세한 고유 오프셋을 깊이 계산에 항상 더해서 서로 다른 개체끼리는 절대
	-- 정확히 같은 Z가 되지 않게 한다(그림자 -0.001 오프셋보다 10배 커서 확실히 갈라놓음).
	property number _depthTieBreak = 0

	-- 히트 리액션(PlayHitAnimation)이 몬스터 본체 스프라이트를 hitRUID로 잠깐 바꾸는 동안, 오버레이가
	-- 여전히 서 있는 포즈 실루엣을 보여주면 서로 어긋나 보인다 — 이 구간만 오버레이를 꺼둔다.
	-- PlayHitAnimation의 복귀 타이머와 반드시 같은 값을 써야 한다(하드코딩 이중관리 방지).
	property number HitFlashDuration = 0.15

	-- 공격 시 살짝 위로 뛰는 모션 높이 — 비행형을 제외한 모든 몬스터의 공격 연출에 공용으로 쓰인다
	property number AttackHopHeight = 0.2

	-- 비행형 종(맵15 박쥐) 전용 — 스케일로 "접근"을 표현하는 대신 화면 안에서 2D로 자유롭게
	-- 날아다니다가(접근/도달 개념 없음) 일정 간격으로 공격한다. "목표점 찍고 걸어가기" 방식은 X범위가
	-- Y범위보다 훨씬 넓어서 사실상 가로로만 움직이는 것처럼 보이는 문제가 있었다(실측 확인) — 대신
	-- X/Y를 각각 다른 주기의 사인파로 동시에 흔들어(리사주 곡선) 항상 두 축이 같이 바뀌는 나풀거리는
	-- 궤적을 만든다. 개체마다 위상/속도를 무작위로 달리해 여러 마리가 같은 패턴으로 겹쳐 보이지 않게 한다.
	property boolean _isFlying = false

	property number FlyRangeX = 3.0  -- 좌우 진폭

	property number FlyingWanderMinY = -0.3

	property number FlyingWanderMaxY = 2.0

	property number FlySpeedX = 1.1  -- 좌우 기본 각속도

	property number FlySpeedY = 1.7  -- 상하 기본 각속도 (좌우와 다르게 잡아 단순 대각선 왕복이 되지 않게 함)

	property number FlyAttackInterval = 1.5  -- 도달 판정 없이 이 간격으로 계속 공격

	-- ── 에피2 보스 전용 거동(엘리쟈·픽시맘 등) ────────────────────────────────────
	-- 공격을 한 번 할 때마다 공속에 더해지는 비율. 피격 성장(_growAtkPerHit)과 **경로만 다르고
	-- 누적처는 같다**(둘 다 _growAtkBonus로 모여 GetEffectiveAttackInterval이 나눠 쓴다).
	property number _atkGrowPerAttack = 0

	-- 위 공격 성장의 상한(0.60 = 최대 +60%). 0이면 성장 안 함.
	property number _atkGrowAttackMax = 0

	-- 공격 직후 잔상을 남기며 좌우로 휙 이동하는가(엘리쟈)
	property boolean _dashAfterAttack = false

	-- 보스 개체별 공격력 배율. 2마리가 같이 뜨는 보스(픽시맘·파파픽시)가 각 0.75로 나눠 갖는다.
	property number _bossAtkMultiplier = 1.0

	-- 동반 보스(파파픽시)인가. 본체(픽시맘)와 함께 뜨고 **둘 다 죽어야** 보스 웨이브가 끝난다 —
	-- 판정은 MonsterSpawner의 파티 카운터가 전담한다(분열체 전멸 판정과 같은 방식).
	property boolean _isBossPartner = false

	-- ── 보스 HP 비율 변신(엘리쟈 → 다크 엘리쟈) ────────────────────────────────────
	-- ⚠ 기존 _hasPhase2 / ReviveAsPhase2(HP가 0이 된 뒤 되살아나는 예티·네펜데스 계열)와는
	-- **완전히 다른 경로**다. 이쪽은 죽지 않고 HP가 일정 비율 아래로 내려간 순간 한 번만 모습이 바뀐다.
	-- 이 값이 0이면 변신 기믹이 없는 보스다.
	property number _bossPhase2HpRatio = 0

	-- 이미 변신했는가(한 번만 발동)
	property boolean _bossPhase2Done = false

	-- 변신 연출이 도는 동안 켜지는 무적 플래그. 유저 지정 "이때 대미지 안 들어감" —
	-- 대미지 진입점 3개(TakeDamage / TakeDamageCrit / TakeDamageCritWithOffset) 전부에서 막는다.
	property boolean _transformLocked = false

	-- 변신 후 공격속도 배수(고정). GetEffectiveAttackInterval이 쓰는 _growAtkBonus로 환산해 넣는다.
	property number _bossPhase2AtkSpeedMult = 1.0

	-- ── 공격 슬롯 순환(에피3 하이레프 리더 / 익스트림 빅풋) ────────────────────────────
	-- 공격할 때마다 attack1 → attack2 → attack3 … 를 **돌아가며** 쓴다. nil이면 기존처럼
	-- _attackRUID 하나만 계속 쓴다(에피1·2 보스 전체가 여기 해당).
	-- 각 슬롯은 { ruid, dur, sfx, isSummon, summonCount } 형태다 — isSummon 슬롯 차례엔
	-- 그 공격이 부하 소환을 겸한다(하이레프 리더의 attack2).
	property any _attackVariants = nil

	-- 다음에 쓸 슬롯 번호(1부터). AdvanceAttackVariant가 매 공격마다 1씩 돌린다.
	property integer _attackVariantIndex = 0

	-- 소환 슬롯의 최소 간격(초). 0이면 제한 없음(슬롯 차례가 올 때마다 무조건 소환).
	-- 유저 지정(하이레프 리더 6초) — 공격 순환 자체는 그대로 돌고 소환만 걸러진다.
	property number _attackVariantSummonCooldown = 0

	-- 마지막으로 소환 슬롯이 실제 소환을 낸 시각(_UtilLogic.ElapsedSeconds). 매 프레임 타이머를
	-- 깎는 대신 시각을 비교한다(무적 프레임 판정과 같은 방식).
	property number _lastVariantSummonTime = -999

	-- 이 보스가 죽을 때 소환 부하도 같이 없앨지(유저 지정 — 하이레프 리더).
	-- 호위병(escort)이 두목과 같이 죽는 것과 같은 규칙이다.
	property boolean _minionDieWithBoss = false

	-- ── HP 임계 소환(에피3 구미호) ────────────────────────────────────────────────────
	-- HP가 이 비율 이하로 떨어지면 부하를 한 번에 소환하고 **다시는 안 한다**.
	-- 쿨타임 소환(_summonCooldown)과는 완전히 별개 경로다. 0이면 없는 보스.
	property number _hpSummonRatio = 0

	property integer _hpSummonCount = 0

	property boolean _hpSummonDone = false
	-- 이 개체가 어떤 보스 def로 만들어졌는지(GetBossDef의 인덱스). 변신 도중 def를 다시 읽어야 하는데
	-- 그때 _MonsterSpawner:GetBossIndex()를 쓰면 순번이 이미 넘어가 있을 수 있어서 스폰 시점 값을 박아둔다.
	property integer _bossDefIndex = 0

	-- 공격 후 대시(잔상)의 좌우 이동 거리(월드 유닛)와 소요 시간
	property number DashAfterAttackDistance = 1.6

	property number DashAfterAttackDuration = 0.18

	-- 대시의 기준 중심 X(보스가 등장한 존 중앙). 여기서 좌우 DashRangeX 안에서만 왔다갔다 한다.
	property number _dashHomeX = 0

	-- 중심에서 좌우로 허용하는 최대 이동 폭. 실측(2026-09-08)에서 방향을 순수 무작위로만 뽑았더니
	-- 6초 만에 한쪽으로 3.2유닛까지 누적돼 보스가 화면 구석에 붙었다 — 화면 밖으로 나가진 않았지만
	-- (가시 반폭 5.56) "중앙에서 싸우는 보스" 그림이 깨져서 중심 복귀 편향 + 범위 클램프를 넣었다.
	property number DashRangeX = 2.5

	-- 에피1 비행 엘리트(블랙 나이트)가 스폰 후 **첫 공격**까지 기다리는 시간. 정상 주기(4.06초)를
	-- 그대로 쓰면 첫 착탄 연출이 스폰 5초 뒤라 그 전에 죽어 한 번도 안 보인다 — 첫 발만 당긴다.
	property number FirstFlyAttackDelay = 0.4

	-- 개체별 비행 공격 주기 오버라이드(0이면 공용 FlyAttackInterval을 그대로 쓴다).
	-- 지상형의 _customAttackInterval에 대응하는 비행형 전용 값 — attack1 재생시간이 1.5초보다 긴
	-- 비행 종(에피소드1 엘리트 "블랙 나이트" attack1 실측 3.36초)이 이전 연출을 스스로 잘라먹지 않게
	-- 한다. 기존 비행 종은 전부 0이라 동작이 바뀌지 않는다(공용 _customAttackInterval을 그대로
	-- 재사용하면 착탄 이펙트가 있는 기존 비행 종(미니빈 등)의 주기까지 같이 바뀌어 버려서 분리했다).
	property number _flyAttackIntervalOverride = 0

	property number _flyCenterX = 0

	property number _flyBaseY = 0

	property number _flyTime = 0

	property number _flyPhaseX = 0

	property number _flyPhaseY = 0

	property number _flySpeedMultX = 1.0

	property number _flySpeedMultY = 1.0

	-- 닌자 컨셉 몬스터(존27~30 지상형) 전용 — 접근 중 좌우로 사인파 지그재그 흔들림을 얹는다(전진 자체는
	-- 기존과 동일하게 _currentScale로 표현, 좌우 흔들림만 별도 X 오프셋으로 분리해서 서로 간섭하지 않는다).
	-- 흔들리는 동안 잔상(반투명 스프라이트 복제)을 주기적으로 남겨 "휙" 하는 느낌을 보탠다.
	property boolean _isZigzag = false

	property number ZigzagAmplitude = 0.5  -- 좌우 진폭(월드 단위) 기본값 — 발판이 이보다 좁으면 실제로는

	-- _zigzagAmplitudeActual로 줄여서 쓴다(아래 참고)
	property number ZigzagFrequency = 3.0  -- 좌우 흔들림 각속도

	property number _zigzagTime = 0

	property number _zigzagPhase = 0

	property number _zigzagBaseX = 0  -- 지그재그 중심(스폰 X)

	-- 실제로 이번 흔들림에 쓸 진폭 — InitializeStats가 스폰된 발판의 실제 xMin/xMax(MonsterSpawner.
	-- GetContainingRunBounds)를 조회해 ZigzagAmplitude를 발판 폭 안으로 클램프한 값. 좁은 공중타일(예:
	-- 에피소드2 map2 존7~10)에서 기본 진폭(0.5)이 타일 경계를 넘어가 "타일 아닌 부분을 밟는 것처럼
	-- 보인다"는 유저 리포트로 추가(2026-08-19). 발판을 못 찾으면(밴드/타일섬 스폰 등) ZigzagAmplitude
	-- 그대로 폴백.
	property number _zigzagAmplitudeActual = 0.5

	-- 재규어(존32/33, 정글 컨셉)도 접근 중 지그재그를 켜지만, 닌자 전용이던 잔상 연출은 같이 얹지 않는다
	-- (유저 요청 — "살짝 지그재그"만, 잔상은 그대로 존27~30 전용). _isZigzag는 공유하되 잔상 여부만 분리.
	property boolean _hasZigzagAfterimage = false

	property number AfterimageInterval = 0.12

	property number _afterimageTimer = 0

	property number AfterimageFadeDuration = 0.2

	property number AfterimageAlpha = 0.35

	-- 이어하기 밀려나는 중 OnUpdate 스킵 플래그
	-- 돌진형 종(맘무트/골든맘무트/트라고스) — 스폰 후 GetMapChargeShakeDuration만큼 제자리에서 위아래로
	-- 떨다가(wind-up), 뒤에 먼지 이펙트를 남기며 ApproachSpeed를 크게 부스트해서 빠르게 접근한다. wind-up이
	-- 끝나고 나면(_chargeDashActive=true) 일반 몬스터의 스케일 접근 로직(OnUpdate 하단)을 그대로 재사용한다 —
	-- 부스트된 ApproachSpeed 하나로 "빠른 접근"이 표현되므로 별도 이동 코드가 필요 없다.
	property boolean _isCharge = false

	property number _chargeWindupTimer = 0

	property boolean _chargeDashActive = false

	property number _chargeSpawnX = 0

	property number _chargeSpawnY = 0

	property number ChargeShakeAmplitude = 0.06  -- 떨림 진폭(월드 단위)

	property number ChargeDashSpeedMultiplier = 7.0  -- wind-up 종료 시 ApproachSpeed에 곱해지는 배수

	property string ChargeDustSortingLayer = "MapLayer0"

	property integer ChargeDustOrderInLayer = 1  -- 몬스터 본체(OrderInLayer=2, platform.md 기본값)보다 낮게 둬서 몬스터가 먼지 위에 그려지게 한다

	property number ChargeDustScale = 0.6  -- 원형 먼지 이펙트 스케일(유저 요청: 기존 1.0 대비 40% 축소)

	property boolean _isPushingBack = false

	-- 플레이어가 이 몬스터가 있는 맵을 떠났을 때 true — 접근/공격 로직을 멈춘다 (MapManager가 제어)
	property boolean _paused = false

	-- true면 Pause()가 호출돼도 무시한다(Ep2MiniBeanEasterEggLogic 전용 — "존을 이동해도 항상 활동"을
	-- 위해 도입. 예전엔 _spawnZoneIndex에 존 범위 밖 예약값(999)을 넣어 SetMonstersPausedForZone의
	-- 매칭 자체를 피해가는 방식이었는데, GetMonstersInCurrentZone(플레이어 카드/스킬 타겟팅이 쓰는
	-- 목록)도 똑같이 _spawnZoneIndex==currentZone으로 걸러서 그 트릭 때문에 플레이어 공격이 얘네를
	-- 영원히 못 때리는 부작용이 있었다 — 유저 리포트: "플레이어가 미니빈 공격을 안한다". 이제
	-- _spawnZoneIndex는 항상 실제 현재 존을 따라가게 하고(RepositionFlyingCenter가 갱신), 대신 이
	-- 플래그로 "일시정지만" 별도로 막는다.)
	property boolean _neverPauses = false

	-- true면 OnReachPlayer의 비행형 공격 분기에서 PlayLungeAnimation(스케일이 확 커졌다 돌아오는
	-- 들이받기 임팩트)을 생략한다(Ep2MiniBeanEasterEggLogic 전용 — 유저 요청: "스케일 작아졌다
	-- 커졌다 안 하고 그냥 날아다녀도 될 듯"). 다른 비행형(뉴그레이 화이트 등)은 기존 그대로 유지.
	property boolean _skipAttackLunge = false

	-- true면 OnReachPlayer 진입 즉시 Ep2MiniBeanEasterEggLogic:TryClaimGroupAttack()을 거쳐, 그 프레임에
	-- 이미 다른 무리원이 먼저 공격을 "선점"했으면 전부 스킵한다(Ep2MiniBeanEasterEggLogic 전용 — 유저
	-- 요청: "핑크빈 무리가 공격할때 무조건 1회 공격 들어가게, 딴 몬스터가 때리는거 관계없이" — 미니빈
	-- 12마리는 전부 같은 시점에 스폰돼 FlyAttackInterval도 동일하므로 공격 타이머가 완전히 동기화돼
	-- 있고, 매 주기마다 12마리가 동시에 OnReachPlayer를 불러 12배 대미지가 들어가고 있었다).
	property boolean _isSwarmMember = false

	-- true면 OnReachPlayer의 대미지 판정이 GameManager._hitImmune(플레이어 피격 후 0.8초 전역 무적 프레임)를
	-- 무시하고 항상 들어간다(_isSwarmMember와 동일한 ignoreHitImmune 경로를 공유 — Tired Knight("지쳐버린
	-- 기사") 전용, 유저 지정: "일반 몬스터가 때릴때 대미지가 안들어가는 부분을 뚫고 공격할수있음(일반
	-- 몬스터가 떄리고 바로 떄려도 대미지 들어감)"). InitializeStatsAsTiredKnight에서 true로 설정.
	property boolean _ignoresHitImmune = false

	-- true면 이 개체가 "지쳐버린 기사"(Tired Knight)다 — Die()에서 일반 잡템 확률 드롭 대신
	-- tired_knight_seal을 100% 확정 지급한다(GameManager.GrantLootItemDrop). ep2_map3 각 존마다
	-- 1마리씩 등장(유저 지정 "존마다 1마리씩 무조건 스폰"). InitializeStatsAsTiredKnight에서 true로 설정.
	property boolean _isTiredKnight = false

	-- true면 이 개체가 ep2_map3 존4 "카페테리아 가마솥"(Cafeteria Cauldron)이다 — 구름(MapObject_17)이
	-- 걷히기 전까지는 _cauldronLocked=true로 TakeDamage 계열 전부를 무시한다(유저 지정: "구름이 있는
	-- 상태에서는 솥단지 눌리면 안됨(공격도 안됨)"). Die()에서 일반 잡템 대신 확률 포션(엘릭서5%/하얀35%/
	-- 빨강60%)을 지급하고 알파 페이드아웃으로 사라진다. Ep2Map3CauldronLogic이 초기화/잠금해제를 담당.
	property boolean _isCauldron = false

	property boolean _cauldronLocked = false

	-- true면 이 개체가 ep2_map4 MapObject_205 이스터에그(Ep2Map4CentaurLogic)로 스폰된 "검은 켄타우로스"
	-- 또는 "타락한 켄타우로스"다 — 둘 다 Die()에서 일반 잡템 드롭을 건너뛴다(유저 지정: "잡템은 나올필요없고").
	-- 타락한 켄타우로스만 별도로 _isCorruptedCentaur도 true가 되어 엘리트처럼(빨간포션+슬롯 스킬 1개) 확정
	-- 드롭을 받는다. InitializeStatsAsBlackCentaur/InitializeStatsAsCorruptedCentaur에서 설정.
	property boolean _isBlackCentaur = false

	property boolean _isCorruptedCentaur = false

	-- true면 원거리 공격을 하지 않는다(_neverAttacks와 별개로 UpdateFlying 비행형 분기에도 적용) +
	-- Die()에서 일반 잡템/카드 드롭 대신 _CardManager:OnYellowMiniBeanCaught로 스킬 1개를 지급한다
	-- (Ep2MiniBeanEasterEggLogic 전용 — 유저 지정: "노란미니빈은 공격은 안하고 잡으면 스킬 1개").
	property boolean _isYellowMiniBean = false

	-- 빙결 스택 (프리징 이펙트 패시브)
	@Sync
	property integer FreezeStack = 0

	property Entity _freezeIndicator = nil

	property boolean _freezeSlowed = false

	@Sync
	property integer ComboStack = 0

	-- 콤보어택 스택(레이온 기본공격 전용) — FreezeStack과 동일하게 "맞는 대상(몬스터)"에게 스택이
	-- 쌓이는 패턴(유저 지정: "캐릭터한테 스택이 쌓이는게 아니라 몬스터한테"). 최대 5스택, 5스택에서
	-- 자동으로 폭발 연출(코마 팩 finish/1~10 무작위, 유저 확인: "코마는 콤보를 터트리는 효과" — 이
	-- 용도로는 정확) 후 스택이 초기화된다.
	-- 오브 연출은 CardManager.ComboOrbRUID(6프레임 클립)를 스택 개수만큼 스폰해서 몬스터 주위를
	-- 시계방향으로 도는 것처럼 표현한다(유저가 실제 게임 스크린샷으로 확인: 슬롯 개수만큼 같은
	-- 오브가 원형으로 돈다). 슬롯 5개를 각각 프로퍼티로 들고(_comboOrb1~5), OnUpdate에서
	-- _comboOrbAngle을 누적해 위치를, _comboOrbReveal1~5를 누적해 프레임(자기 슬롯 번호까지
	-- 0→N 순서 재생 후 정지)을 매 프레임 갱신한다.
	property Entity _comboOrb1 = nil

	property Entity _comboOrb2 = nil

	property Entity _comboOrb3 = nil

	property Entity _comboOrb4 = nil

	property Entity _comboOrb5 = nil

	property number _comboOrbReveal1 = 0

	property number _comboOrbReveal2 = 0

	property number _comboOrbReveal3 = 0

	property number _comboOrbReveal4 = 0

	property number _comboOrbReveal5 = 0

	-- 프레임 1개당 재생 시간(초) — 오브가 생성돼서 자기 목표 프레임까지 세는 데 걸리는 시간
	property number ComboOrbFrameStepDuration = 0.08

	property number _comboOrbAngle = 0

	property number ComboOrbRadius = 0.45

	-- 실제 콤보어택 오브 리소스(44x44px, 작은 아이콘형)로 교체하면서 재조정한 배율(유저 지정:
	-- "지금의 1/2로")
	property number ComboOrbScaleMultiplier = 0.5

	-- 라디안/초. 양수 = 화면 기준 시계방향(각도가 커질수록 -sin 성분이 아래로 향하게 좌표식을 짬)
	property number ComboOrbRotateSpeed = 3.0

	-- 스턴(감전) 중 머리 위에 뺑글뻉글 도는 별 이펙트
	property Entity _stunStarsIndicator = nil

	-- 2026-08-05(유저 지정): 스폰되는 일반 몬스터 중 일부를 "작은 개체"(크기 2/3, 체력 20% 낮음)로 만든다.
	-- MarkElite와 동일하게 InitializeStats 직후(스폰 시점)에 한 번 호출되는 post-hoc 보정 — 덮어쓰지 않고
	-- 곱해서 보스/엘리트 배율과 함께 적용돼도 자연스럽게 누적되게 한다.
	-- 2026-08-05(2차, 유저 지정): 작은 개체는 접근 속도(ApproachSpeed, ="이동속도" — 이 게임은 실제 이동이
	-- 아니라 스케일 증가로 접근을 표현)도 기준(1.0) 대비 +0.3 더 빠르게(1.3배) 만든다. ApproachSpeed는
	-- InitializeStats에서 이미 웨이브별 값+분산까지 정해진 뒤이므로, 그 값에 곱해서 적용해야 웨이브 진행에
	-- 따라 커지는 기본 속도 위에도 비율이 그대로 유지된다.
	property number SmallVariantSpeedMultiplier = 1.3

	-- 성능 최적화(2026-08-24) — _spawnZoneIndex를 설정하는 모든 InitializeStats* 계열이 공통으로
	-- 거치는 지점. MonsterSpawner._zoneMonsterRegistry에 자신을 등록해서, MapManager/CardManager 등이
	-- "이 존의 몬스터만" O(그 존 크기)로 바로 조회할 수 있게 한다(예전엔 map:GetChildComponentsByTypeName로
	-- 맵 전체를 매번 훑었다 — container=nil 공유맵(map3/4)에서 몬스터 100마리 이상까지 실측, 맵이동 한 번에
	-- 1.3초까지 걸렸었다). 재초기화로 다시 불려도 레지스트리는 집합이라 중복 등록 걱정 없다. 짝은
	-- OnEndPlay의 UnregisterZoneMonster.
	method void SetSpawnZone(integer zoneIndex)
		self._spawnZoneIndex = zoneIndex
		_MonsterSpawner:RegisterZoneMonster(zoneIndex, self)
	end

	method void OnBeginPlay()
		if self:IsServer() then
			-- 스탯/외형 초기화는 MonsterSpawner가 스폰 직후 InitializeStats()를 명시적으로 호출해서 처리한다 —
			-- 존(zone)별 몬스터 풀을 고르려면 "이 몬스터가 어느 맵에서 스폰됐는지"가 필요한데
			-- OnBeginPlay는 그 정보를 모른다(스폰 파라미터로 전달받지 않는 한 알 수 없음).
			self._currentScale = 0.85
			self.Entity.TransformComponent.Scale = Vector3(0.85 * self._scaleMultiplier, 0.85 * self._scaleMultiplier, 1.0)
			self._depthTieBreak = _UtilLogic:RandomDouble() * 0.01
			self:GetDepthOverlayRenderer()
			self:UpdateDepth()
		else
			-- 클라이언트: MonsterSprite가 이미 초기 동기화되어 도착해 있을 수 있으므로(스폰 직후 등)
			-- OnSyncProperty의 "값 변경" 이벤트만 기다리지 않고 여기서 바로 적용한다.
			-- 맵 이동 직후처럼 동기화 타이밍이 애매한 경우, OnSyncProperty가 안 불려도
			-- 몬스터가 기본 플레이스홀더 스프라이트로 멈춰있지 않도록 하기 위함.
			self:ApplyBodySprite(self.MonsterSprite)
			-- "길잃은 루돌프" 전용 터치 연결 — TouchReceiveComponent가 없는 일반 몬스터에서는
			-- TouchEvent가 애초에 발생하지 않으므로 이 연결은 무해하다(다른 500여종 몬스터엔 영향 없음).
			self._touchHandler = self.Entity:ConnectEvent(TouchEvent, self.OnLostRudolphClientTouched)
		end
	end

	-- MonsterSpawner가 스폰 직후 호출: zoneIndex(1~3=기존 웨이브 풀, 4~6=신규 몬스터 풀)에 맞춰
	-- 스탯(HP/접근속도)과 외형(스프라이트 RUID)을 초기화한다. HP/접근속도는 존과 무관하게 항상
	-- 웨이브 공식을 따르고, 외형만 존별 규칙으로 고른다.
	-- forcedSpeciesIdx: 맵 전용 풀(zoneIndex>=7)에서 스폰 위치 결정과 같은 종을 쓰기 위해
	-- MonsterSpawner가 미리 뽑아서 넘겨주는 값. 0 이하면 기존처럼 여기서 무작위로 고른다.
	@ExecSpace("ServerOnly")
	method void InitializeStats(integer zoneIndex, integer wave, boolean isBoss, integer forcedSpeciesIdx)
		-- 방금 막 스폰된 몬스터는 절대 죽어있을 수 없다 — 그런데도 스폰 직후 이 값이 이미 true로
		-- 관측되는 경우가 실측 확인됐다(같은 틱에 다른 몬스터가 죽은 직후 엔티티 재사용 시 이전
		-- 점유자의 _dead가 새 스폰에 남아있는 것으로 추정). 남아있으면 얼음 파편처럼 "방금 스폰된
		-- 몬스터"를 신뢰하는 로직이 조용히 무력화되므로, 초기화 맨 앞에서 명시적으로 되돌린다.
		self._dead = false
		-- 자기 몸에서 터지는 공격 이펙트는 특정 종(에피1 보스 머쉬맘)만 쓴다 — 그 엔티티가 나중에
		-- 일반 몬스터로 재사용될 때 포자가 딸려오지 않도록 여기서 매번 지운다. 아래 해당 분기에서
		-- 다시 채워진다(푼코/쿠스코는 InitializeStats를 안 거치는 별도 초기화라 영향 없음).
		self._selfAttackEffectRUID = ""
		self._selfAttackEffectDelay = 0
		-- 착탄 연출 지연 오버라이드/2번째 그림(에피1 엘리트 전용)도 재사용 엔티티에 남으면 안 된다 —
		-- 0/"" 이면 기존 동작(_attackDuration × 0.5 지연, 그림 1장)으로 되돌아간다
		self._hitEffectDelayOverride = 0
		self._hitEffectRUID2 = ""
		-- 착탄 프레임 목록(엘리트 전용)도 재사용 엔티티에 남으면 안 된다 — 남으면 일반 몬스터가
		-- 엘리트의 착탄 연출을 그대로 뿌린다.
		self._hitEffectFrames = nil
		self._hitEffectFrameDelay = 0
		-- 소환기도 마찬가지 — 보스였던 엔티티가 일반 몬스터로 재사용될 때 박쥐를 부르면 안 된다
		self._summonCooldown = 0
		self._summonCount = 0
		-- 피격 성장(다일)도 재사용 엔티티에 남아있으면 안 된다 — 스택과 설정 둘 다 지운다
		self._growScalePerHit = 0
		self._growScaleMax = 0
		self._growAtkPerHit = 0
		self._growAtkMax = 0
		self._growAtkBonus = 0
		self._erdasHitGrowthBonus = 0
		-- 에피2 보스 전용 거동도 재사용 엔티티에 남으면 안 된다(보스였던 몸이 일반 몬스터로 다시 쓰일 때)
		self._atkGrowPerAttack = 0
		self._atkGrowAttackMax = 0
		self._dashAfterAttack = false
		self._bossAtkMultiplier = 1.0
		self._isBossPartner = false
		-- HP 임계 변신(엘리쟈)도 재사용 엔티티에 남으면 안 된다. 특히 _transformLocked가 남으면
		-- 그 몸으로 스폰된 다음 몬스터가 **영구 무적**이 된다.
		self._bossPhase2HpRatio = 0
		self._bossPhase2Done = false
		self._transformLocked = false
		self._bossPhase2AtkSpeedMult = 1.0
		self._bossDefIndex = 0
		-- 공격 슬롯 순환 / HP 임계 소환(에피3 전용)도 재사용 엔티티에 남으면 안 된다
		self._attackVariants = nil
		self._attackVariantIndex = 0
		self._attackVariantSummonCooldown = 0
		self._lastVariantSummonTime = -999
		self._minionDieWithBoss = false
		self._hpSummonRatio = 0
		self._hpSummonCount = 0
		self._hpSummonDone = false
		self:SetSpawnZone(zoneIndex)
		self._isBoss = isBoss
		self._reachedScaleThreshold = 1.5
		-- 2026-08-03 3차 재설계: 체력은 화력 비례 방식을 버리고 순수 시간 "단계" 기반으로 되돌린다
		-- (GameManager.GetTimeStep/GetTimeStepHp) — 3분까지는 강해지지 않고, 그 뒤로 5분마다 한
		-- 계단씩만 오른다. 보스는 그 값에 BossHpMultiplier를 곱한다.
		local hp
		if isBoss then
			-- 첫 보스는 고정 체력(MonsterSpawner.FirstBossHp, 2026-09-12 유저 지정 2500) — 0이면 기존 공식
			local firstBossHp = _MonsterSpawner:GetFirstBossHpOverride()
			if firstBossHp > 0 then
				hp = firstBossHp
			else
				hp = _GameManager:GetTimeStepHp(_GameManager:GetTimeStep()) * _GameManager.BossHpMultiplier
			end
		else
			hp = _GameManager:GetTimeStepHp(_GameManager:GetTimeStep())
		end
		self.MaxHp = hp
		self.CurrentHp = hp
		if isBoss then
			-- 보스는 항상 느린 접근(15초 교전창)을 유지한다 — GetWaveApproachSpeed는 wave==10일 때만
			-- 특수값을 반환하므로, 실제 wave 값과 무관하게 리터럴 10을 넘겨 그 분기를 그대로 재사용한다.
			self.ApproachSpeed = _GameManager:GetWaveApproachSpeed(10)
		else
			self.ApproachSpeed = _GameManager:GetWaveApproachSpeed(wave)
		end
		-- 유물 에오스의 돌(6번) — 적 이동속도 감소. 스폰 시 한 번만 곱해두면 이후 접근 로직이
		-- 전부 이 값을 쓰므로 매 프레임 계산할 필요가 없다(스턴/슬로우는 별도로 또 곱해진다).
		self.ApproachSpeed = self.ApproachSpeed * (1.0 - _RelicInventory:GetEnemySlowRatio())

		-- 보스는 속도 분산 없이 일정하게 접근 + 임팩트를 위해 비주얼 스케일 2.5배(기존 5배가 너무 커서 50% 축소)
		-- (엘리트와 곱연산으로 같이 적용됨)
		if not isBoss then
			local variance = (_UtilLogic:RandomDouble() * 2 - 1) * self.ApproachSpeedVariance
			self.ApproachSpeed = self.ApproachSpeed + variance
			-- 유저 요청으로 "일반(엘리트/보스가 아닌) 몬스터는 웨이브가 올라가도 크기를 키우지 않는다" —
			-- 예전엔 여기서 웨이브10 이후 무한 웨이브 동안 일반 몬스터도 체력처럼 크기가 완만하게
			-- 커지게(최대 ×1.6) 했었는데, 그 성장이 엘리트/보스 여부와 무관하게 전부 적용되다 보니
			-- 웨이브를 빠르게 건너뛰는 테스트에서 "일반 몬스터가 갑자기 커 보인다"는 혼란을 유발했다.
			-- 이제 일반 몬스터는 웨이브와 무관하게 항상 기본 크기(_scaleMultiplier=1.0)를 유지하고,
			-- 엘리트(MarkElite)/보스만 각자의 고정 배율로 커진다.
		else
			self._scaleMultiplier = self._scaleMultiplier * 2.5
		end
		
		if zoneIndex >= 7 then
			-- 맵7~9 전용 몬스터 풀: 맵마다 별도 구성(고스텀프/보어류 등)에서 무작위로 외형을 고른다.
			-- 맵10(보너스 스테이지)은 별도 풀이 없고 맵9 몬스터 풀을 그대로 재사용한다(평소 웨이브 폴백 시).
			local appearanceZone = zoneIndex
			if appearanceZone == 10 then appearanceZone = 9 end
			-- ep2_map2_hidden(존1~4=mapIndex85~88) — MonsterSpawner.ResolveAppearanceZone과 동일한
			-- 별칭 매핑을 여기도 복제한다(이 메서드는 그 헬퍼를 안 거치고 직접 계산하는 별도 경로라
			-- 짝을 맞춰야 함 — 안 맞추면 스폰 위치 판정과 실제 스탯/외형이 서로 다른 존 풀을 보게 됨).
			if appearanceZone == 85 then appearanceZone = 56
			elseif appearanceZone == 86 then appearanceZone = 61
			elseif appearanceZone == 87 then appearanceZone = 63
			elseif appearanceZone == 88 then appearanceZone = 60
			end
			local speciesIdx = forcedSpeciesIdx
			if speciesIdx <= 0 then
				speciesIdx = _UtilLogic:RandomIntegerRange(1, _GameManager:GetMapMonsterCount(appearanceZone))
			end
			self._speciesIdx = speciesIdx
			self._standRUID = _GameManager:GetMapStandRUID(appearanceZone, speciesIdx)
			self._moveRUID = _GameManager:GetMapMoveRUID(appearanceZone, speciesIdx)
			self._dieRUID = _GameManager:GetMapDieRUID(appearanceZone, speciesIdx)
			self._dieDuration = _GameManager:GetMapDieDuration(appearanceZone, speciesIdx)
			self._hitRUID = _GameManager:GetMapHitRUID(appearanceZone, speciesIdx)
			self._attackRUID = _GameManager:GetMapAttackRUID(appearanceZone, speciesIdx)
			self._attackDuration = _GameManager:GetMapAttackDuration(appearanceZone, speciesIdx)
			-- 원거리 히트 이펙트(네펜데스/다크네펜데스 전용, 유저 요청) — 빈 문자열이면 PlayRangedHitEffect가
			-- 자체적으로 아무것도 재생하지 않는다
			self._hitEffectRUID = _GameManager:GetMapHitEffectRUID(appearanceZone, speciesIdx)
			self._hitEffectDuration = _GameManager:GetMapHitEffectDuration(appearanceZone, speciesIdx)
			self._hitEffectMaxConcurrent = _GameManager:GetMapHitEffectMaxConcurrent(appearanceZone, speciesIdx)
			self._projectileRUID = _GameManager:GetMapProjectileRUID(appearanceZone, speciesIdx)
			self._hitEffectScaleMultiplier = _GameManager:GetMapHitEffectScaleMultiplier(appearanceZone, speciesIdx)
			self._hitEffectAlpha = _GameManager:GetMapHitEffectAlpha(appearanceZone, speciesIdx)
			-- 버그 수정(2026-08-27, 유저 리포트: "웨어울프나 라이칸이나 연출이 끝까지 나올때가 있고 그냥
			-- 안나올때가 있는거 같아") — 원래는 원거리 히트 이펙트가 있는 종만 attackDuration에 맞춰
			-- 공격 주기를 늘렸는데, 웨어울프/라이칸스로프(근접, 히트 이펙트 없음)는 attackDuration이
			-- 1.25초인데 기본 AttackInterval은 1.0초라 다음 공격이 이전 공격의 attack1 재생이 끝나기 전에
			-- 겹쳐 들어왔다. PlayAttackAnimation의 복귀 타이머는 "지금 스프라이트가 내가 세팅한 attackRUID와
			-- 같으면" 되돌리는 방식이라 새/구 타이머를 구분 못 해서, 겹치면 구(이전) 타이머가 새로 시작한
			-- attack1을 즉시 stand로 되돌리고 _isPlayingTransientSprite까지 꺼버려 그 순간 마침 도착한
			-- MonsterSprite 동기화가 다시 덮어쓸 수 있는 창이 열렸다 — "가끔은 끝까지 나오고 가끔은 아예
			-- 안 보인다"는 정확히 이 겹침 타이밍(공격 시점이 서로 얼마나 가까운가)에 좌우되는 증상과 일치.
			-- attackRUID가 있는 종은 전부(히트 이펙트 유무 무관) attackDuration이 기본 간격보다 길면
			-- 겹치지 않을 만큼 간격을 늘린다.
			-- 예티류는 화면 히트 이펙트를 뺐지만(2026-09-14) 공격 간격은 예전 그대로 유지한다
			-- (GameManager.GetMapKeepsRangedAttackPace 참고 — 안 보면 1.65초 → 1.0초로 빨라진다).
			local keepsRangedPace = _GameManager:GetMapKeepsRangedAttackPace(appearanceZone, speciesIdx)
			if self._hitEffectRUID ~= "" or keepsRangedPace or (self._attackRUID ~= "" and self._attackDuration > self.AttackInterval) then
				self._customAttackInterval = self._attackDuration + 0.7
			else
				self._customAttackInterval = 0
			end
			-- 존별 시각 크기 배율(그룹G 15% 축소 등) — 보스(×2.5)와 곱연산으로 같이 적용된다
			self._scaleMultiplier = self._scaleMultiplier * _GameManager:GetMapScaleMultiplier(appearanceZone, speciesIdx)
			self._isRangedInk = _GameManager:GetMapIsRanged(appearanceZone, speciesIdx)
			self._isRangedSlash = _GameManager:GetMapIsRangedSlash(appearanceZone, speciesIdx)
			if self._isRangedInk or self._isRangedSlash then
				self._reachedScaleThreshold = self.RangedReachedScale
			end
			-- 에피소드2 거대 네펜데스(고정형/공격안함) — 존 풀에 직접 배치된 경우에만 등장한다. 네펜데스/
			-- 다크네펜데스는 그냥 죽으면 끝 — 별도로 거대 네펜데스를 소환/변신시키지 않는다(유저 요청 최종 확정).
			self._neverAttacks = _GameManager:GetMapNeverAttacks(appearanceZone, speciesIdx)
			-- 에피소드2 종 전용 피격/사망 사운드(그 외 기존 존7+ 풀은 원래 사운드가 없어 빈 문자열 유지)
			self._hitSoundRUID = _GameManager:GetMapHitSoundRUID(appearanceZone, speciesIdx)
			self._dieSoundRUID = _GameManager:GetMapDieSoundRUID(appearanceZone, speciesIdx)
			-- 거대 네펜데스는 항상 1페이즈(패시브, 전용 외형)로 첫 등장한다 — 위에서 읽어온 존 풀 값들은
			-- 사실 2페이즈(부활 후) 외형이므로, 1페이즈 전용 값으로 즉시 덮어쓴다. 부활 시점에
			-- ReviveAsPhase2가 다시 2페이즈 값으로 되돌린다.
			self._isGiantNepenthes = _GameManager:GetMapIsGiantNepenthes(appearanceZone, speciesIdx)
			if self._isGiantNepenthes then
				self._giantNepenthesRevived = false
				self._standRUID = _GameManager.GiantNepenthesPhase1StandRUID
				self._dieRUID = _GameManager.GiantNepenthesPhase1DieRUID
				self._dieDuration = _GameManager.GiantNepenthesPhase1DieDuration
				self._dieSoundRUID = _GameManager.GiantNepenthesPhase1DieSoundRUID
				-- 1페이즈 리소스팩엔 hit1이 없다 — 피격 시 스프라이트/사운드 교체 없이 데미지 숫자만 뜬다
				self._hitRUID = ""
				self._hitSoundRUID = ""
			end
			-- 에피소드3 map2 예티/다크예티/예티와페페/다크예티와페페 전용 범용 2페이즈(유저 지정 —
			-- "거대 네펜데스처럼 페이즈가 나눠져있는 몬스터"). 존 풀 테이블(GetMap*RUID)이 그대로 1페이즈
			-- 외형이라 거대 네펜데스처럼 덮어쓸 필요 없이, hasPhase2 플래그와 부활 여부만 기록해둔다 —
			-- 실제 전환은 Die()에서 DieAndRevivePhase1Generic이 처리한다.
			-- 단, 주니어예티(라이트) 3슬롯(99/1, 100/2, 102/2) + 다크주니어예티 3슬롯(99/2, 101/1, 103/2)만은
			-- 예외다(유저 최종 지정, 2026-08-25 재재정정+다크 추가 요청 — "예티는 죽을때 바로죽거나 페이즈2로
			-- 넘어가 그확률이 50%... 스폰될때 정할꺼면 [페이즈없는 예티]/[페이즈있는 예티] 이거 쓰면 되고,
			-- 페이즈있는 예티는 die1이 변신 모션" + "다크 주니어 예티도 해줘야지"). 이 6슬롯은
			-- GetMapHasPhase2(확정형 종 전용)를 거치지 않고, 스폰 시점에 여기서 직접 50% 코인플립으로
			-- "페이즈있는"/"페이즈없는" 두 리소스팩 중 하나를 확정한다(라이트/다크는 GetMapIsJuniorYetiDark로
			-- 갈라서 각자의 RUID 세트를 쓴다) — 그래서 존 풀 테이블 값(위에서 이미 읽은 pack1=페이즈없는 값)을
			-- 덮어써야 한다. Die()에서는 더 이상 확률을 굴리지 않는다(_phase2Chance=1.0 고정 — 이미 스폰
			-- 시점에 확정됐으므로).
			if _GameManager:GetMapIsJuniorYetiPhase2Roll(appearanceZone, speciesIdx) then
				local isDarkJuniorYeti = _GameManager:GetMapIsJuniorYetiDark(appearanceZone, speciesIdx)
				self._hasPhase2 = _UtilLogic:RandomDouble() < 0.5
				self._phase2Chance = 1.0
				if self._hasPhase2 then
					self._phase2Revived = false
					if isDarkJuniorYeti then
						-- "페이즈있는 다크주니어예티" 팩 — die1(16프레임 실측=1.65초)이 변신 모션. 사운드는 effect.
						self._standRUID = "92b8be5ea1164ccf839ebfc3f76ecb46"
						self._moveRUID = "1e7b429eb65e497db96b0c70defbc971"
						self._hitRUID = "8cab9c536b5347e7b29c62310d9709df"
						self._dieRUID = "5c4af8b63f6d4bb981bd14257751e34c"
						self._dieDuration = 1.65
						self._hitSoundRUID = "19da3f9e06b948f49b8ad43647b3e73a"
						self._dieSoundRUID = "7b1c4562c6564cc5bbf7594f20c95260"
					else
						-- "페이즈있는 예티" 팩 — die1(16프레임 실측=1.65초) 자체가 변신 모션. 사운드는 effect.
						self._standRUID = "48399164e47a4c0ebf7b09332ffee38f"
						self._moveRUID = "6f11483b09a942f4b954e238f86e4d13"
						self._hitRUID = "59be70295ac0403ba16e0ed911920906"
						self._dieRUID = "f7ee11ac35cd4983b592d51cbabc0a55"
						self._dieDuration = 1.65
						self._hitSoundRUID = "a0f695a2323c43378124889d88ef1d1e"
						self._dieSoundRUID = "3f970229ffde4240b129112a59925f93"
					end
					-- 버그 수정(2026-08-25, 유저 리포트 "맵3,맵4에 공격 모션 빠진애들이 보이는데") — 주니어
					-- 예티/다크주니어예티 리소스팩(mob/5100000·5100001·5130105)엔 attack1 서브클립 자체가
					-- 없다(msw-search 실측 확인 — stand/move/hit1/die1/jump뿐). 개체마다 코인플립으로 결정된
					-- hit1을 그대로 "공격" 연출로 재사용한다(리소스가 없는 상태로 방치하면 도달 공격 때마다
					-- 스프라이트가 아예 안 바뀌어 "공격 모션이 빠짐"으로 보인다).
					self._attackRUID = self._hitRUID
				else
					if isDarkJuniorYeti then
						-- "페이즈없는 다크주니어예티" 팩 — die1(5프레임 실측=0.55초)은 진짜 사망. 사운드는 voice.
						self._standRUID = "ce56cf9613174f80976dab5b61f7b604"
						self._moveRUID = "8d2b8951794d406a86cc580e9eeff18d"
						self._hitRUID = "cbe070cdf1fa4611a3529f3d70296a33"
						self._dieRUID = "fad50a0e478c40fcbd383e069bc278da"
						self._dieDuration = 0.55
						self._hitSoundRUID = "f5b7e04a5ac6496cac77b016ea13a16f"
						self._dieSoundRUID = "53324cebb7744fe69b7c972568192375"
					else
						-- "페이즈없는 예티" 팩 — die1(5프레임 실측=0.55초)은 진짜 사망. 사운드는 voice.
						self._standRUID = "1975dd704eec461ab49bdeb0c11c54d9"
						self._moveRUID = "842a6865f7074f94ac4a190ed90e2e21"
						self._hitRUID = "63a1a5f280f04e55b935d6a2155edcef"
						self._dieRUID = "13b9f2b2f7664cc5a08e663f2fe0502b"
						self._dieDuration = 0.55
						self._hitSoundRUID = "6f4dcabb6d9941a38f84c1cc6b5cdad8"
						self._dieSoundRUID = "6f3ab281ca93458d9b122b8d5cbf60df"
					end
					-- "페이즈없는" 팩도 attack1이 없기는 마찬가지라 동일하게 hit1을 재사용한다.
					self._attackRUID = self._hitRUID
				end
			else
				self._hasPhase2 = _GameManager:GetMapHasPhase2(appearanceZone, speciesIdx)
				if self._hasPhase2 then
					self._phase2Revived = false
					self._phase2Chance = _GameManager:GetMapPhase2Chance(appearanceZone, speciesIdx)
				end
			end
			if self._neverAttacks then
				self._currentScale = self._reachedScaleThreshold
				self._reachedPlayer = true
			end
			self._isFlying = _GameManager:GetMapIsFlying(appearanceZone, speciesIdx)
			if self._isFlying then
				-- 접근 애니메이션 없이 스폰 즉시 고정 크기로 보이게 하고, 스폰 X를 중심으로 X/Y 동시
				-- 사인파 비행 시작 (개체별 위상/속도를 무작위로 달리해 여러 마리가 겹쳐 보이지 않게 함).
				-- UpdateFlying은 TransformComponent.Position(부모 기준 로컬)에 직접 쓰므로, 중심값도
				-- 반드시 로컬 Position 기준이어야 한다 — WorldPosition(존 오프셋 포함)을 쓰면 존14/15처럼
				-- 오프셋이 있는 존에서 오프셋이 두 번 겹쳐 적용돼 화면 밖으로 날아가 버린다(실측 확인 —
				-- 존15에서 박쥐가 안 보이던 원인이 바로 이것).
				self._currentScale = 1.0
				self._flyCenterX = self.Entity.TransformComponent.Position.x
				self._flyBaseY = (self.FlyingWanderMinY + self.FlyingWanderMaxY) * 0.5
				self._flyTime = 0
				self._flyPhaseX = _UtilLogic:RandomDouble() * math.pi * 2
				self._flyPhaseY = _UtilLogic:RandomDouble() * math.pi * 2
				self._flySpeedMultX = 0.8 + _UtilLogic:RandomDouble() * 0.4
				self._flySpeedMultY = 0.8 + _UtilLogic:RandomDouble() * 0.4
				self._attackTimer = self.FlyAttackInterval
			end
			-- 돌진형 종(맘무트/골든맘무트/트라고스) — 스폰 위치를 떨림 중심으로 저장하고 wind-up 타이머를 시작한다.
			-- 비행형과는 동시에 성립하지 않는다(현재 종 구성상 겹치지 않음).
			self._isCharge = _GameManager:GetMapIsCharge(appearanceZone, speciesIdx)
			if self._isCharge and not self._isFlying then
				self._chargeWindupTimer = _GameManager:GetMapChargeShakeDuration(appearanceZone, speciesIdx)
				self._chargeDashActive = false
				local chargePos = self.Entity.TransformComponent.Position
				self._chargeSpawnX = chargePos.x
				self._chargeSpawnY = chargePos.y
			else
				self._isCharge = false
			end
			-- 그룹I(존27~30, 닌자 컨셉) 지상형만 접근 중 좌우 지그재그 흔들림을 켠다 — 비행형(스티지)은
			-- 이미 자체 리사주 비행 궤적이 있어서 별도로 흔들 필요가 없다. 흔들림 중심은 스폰 시점의
			-- 로컬 X(발판 위 스폰 위치)로 고정하고, 개체마다 위상을 무작위로 달리해 겹쳐 보이지 않게 한다.
			-- 재규어(존32/존33 지상형=2번째 종)도 유저 요청으로 같은 지그재그를 얹는다 — 단, 잔상은
			-- 닌자 전용으로 남겨두고 재규어는 안 켠다(_hasZigzagAfterimage로 분리).
			-- 판정은 GameManager.GetMapIsZigzag(zoneIndex, speciesIdx)로 위임한다 — 닌자/재규어존은 존
			-- 전체가 대상이지만, 에피소드2 map2(존7~10)는 지그재그 종(루이넬류)과 그렇지 않은 종이 한 존에
			-- 섞여 있어 zoneIndex만으로는 구분할 수 없다(종 idx까지 같이 봐야 함).
			local isNinjaZone = appearanceZone >= 27 and appearanceZone <= 30
			if _GameManager:GetMapIsZigzag(appearanceZone, speciesIdx) and not self._isFlying then
				self._isZigzag = true
				self._zigzagBaseX = self.Entity.TransformComponent.Position.x
				self._zigzagTime = 0
				self._zigzagPhase = _UtilLogic:RandomDouble() * math.pi * 2
				-- 스폰된 발판의 실제 폭 안으로 진폭을 클램프한다 — 좁은 발판에서 기본 진폭(0.5)이 타일
				-- 경계를 넘어가는 것을 막는다. EdgeMarginAerial(0.15)과 동일한 여유를 양쪽에 둔다.
				self._zigzagAmplitudeActual = self.ZigzagAmplitude
				local worldPos = self.Entity.TransformComponent.WorldPosition
				-- 버그 수정(2026-08-24, ep2_map2_hidden 별칭 도입 중 발견) — 여기는 반드시 appearanceZone이
				-- 아니라 zoneIndex(실제 물리 존)를 넘겨야 한다. GetContainingRunBounds는 mapIndex로
				-- _MapManager:GetMapName(mapIndex)를 거쳐 그 "파일"의 FootholdComponent를 조회하는데,
				-- appearanceZone은 외형/스탯 참조용 별칭 존(예: 존86→61)이라 물리적으로 다른 맵 파일이다 —
				-- 실측 확인: ep2_map2_hidden 존86(별칭 61=ep2_map2)에서 이 값을 그대로 쓰면 엔티티는
				-- ep2_map2_hidden에 있는데 발판은 ep2_map2 것을 찾아 좌표가 어긋나 "NO RUN FOUND"로
				-- 조용히 실패(클램프 없이 기본 진폭 0.5 그대로)했다. zoneIndex를 쓰면 항상 엔티티가 실제로
				-- 서 있는 그 맵의 발판을 정확히 찾는다(별칭이 없는 기존 존들은 zoneIndex==appearanceZone이라
				-- 동작 변화 없음).
				local bounds = _MonsterSpawner:GetContainingRunBounds(zoneIndex, worldPos.x, worldPos.y)
				if bounds ~= nil then
					local safeHalfWidth = math.min(worldPos.x - bounds.xMin, bounds.xMax - worldPos.x) - 0.15
					self._zigzagAmplitudeActual = math.max(0, math.min(self.ZigzagAmplitude, safeHalfWidth))
					log("MonsterAI: Zigzag zone=" .. zoneIndex .. " idx=" .. speciesIdx .. " worldX=" .. string.format("%.2f", worldPos.x) .. " worldY=" .. string.format("%.2f", worldPos.y) .. " runXMin=" .. string.format("%.2f", bounds.xMin) .. " runXMax=" .. string.format("%.2f", bounds.xMax) .. " amplitude=" .. string.format("%.2f", self._zigzagAmplitudeActual))
				else
					log("MonsterAI: Zigzag zone=" .. zoneIndex .. " idx=" .. speciesIdx .. " worldX=" .. string.format("%.2f", worldPos.x) .. " worldY=" .. string.format("%.2f", worldPos.y) .. " NO RUN FOUND, amplitude=" .. string.format("%.2f", self._zigzagAmplitudeActual))
				end
				if isNinjaZone then
					self._hasZigzagAfterimage = true
					self._afterimageTimer = self.AfterimageInterval
				end
			end
		elseif zoneIndex >= 4 then
			-- 맵4~6 전용 몬스터 풀: 스폰마다 1~4 중 무작위로 외형을 고른다 (보스도 이 풀에서 고름 — 별도 존 보스는 없음)
			local speciesIdx = _UtilLogic:RandomIntegerRange(1, _GameManager:GetZoneMonsterCount())
			self._speciesIdx = speciesIdx
			self._standRUID = _GameManager:GetZoneStandRUID(speciesIdx)
			self._moveRUID = _GameManager:GetZoneMoveRUID(speciesIdx)
			self._dieRUID = _GameManager:GetZoneDieRUID(speciesIdx)
			self._dieDuration = _GameManager:GetZoneDieDuration(speciesIdx)
			self._hitRUID = _GameManager:GetZoneHitRUID(speciesIdx)
			self._attackRUID = ""
		else
			-- 맵1~3: 웨이브1~9는 웨이브 번호 = 종 인덱스(기존과 동일), 보스는 항상 리본돼지(species=10)
			-- 고정(2026-08-03: 보스가 시간 기반으로 바뀌면서 wave가 더 이상 10이 아닐 수 있어 isBoss로
			-- 직접 판정), 그 외(11부터)는 지금까지 나온 1~9 종 중 무작위로 섞어서 계속 등장시킨다
			local speciesIdx = wave
			if isBoss then
				speciesIdx = 10
			elseif wave > 10 then
				speciesIdx = _UtilLogic:RandomIntegerRange(1, 9)
			end
			self._speciesIdx = speciesIdx
			self._standRUID = _GameManager:GetWaveStandRUID(speciesIdx)
			self._moveRUID = _GameManager:GetWaveMoveRUID(speciesIdx)
			self._dieRUID = _GameManager:GetWaveDieRUID(speciesIdx)
			self._dieDuration = _GameManager:GetWaveDieDuration(speciesIdx)
			self._hitRUID = _GameManager:GetWaveHitRUID(speciesIdx)
			self._attackRUID = _GameManager:GetWaveAttackRUID(speciesIdx)
			-- 버그 수정(2026-09-05): 여기서 _attackDuration을 안 넘겨서 웨이브 몬스터는 attack1이 있어도
			-- 기본 0.25초 만에 stand로 되돌아갔다(주니어 부기 12프레임=1.25초가 4/5 잘림). 맵 몬스터
			-- 분기(GetMapAttackDuration)와 동일하게 실측값을 넘기고, 재생시간이 공격 주기보다 길면
			-- 다음 공격이 겹쳐 이전 타이머가 새 attack1을 즉시 되돌려버리는 문제도 같이 막는다.
			self._attackDuration = _GameManager:GetWaveAttackDuration(speciesIdx)
			if self._attackRUID ~= "" and self._attackDuration > self.AttackInterval then
				self._customAttackInterval = self._attackDuration + 0.7
			else
				self._customAttackInterval = 0
			end
		end

		-- ⚠ 버그 수정(2026-09-14, 유저 리포트 "맞으면 애니메이션이 끊기는데??" — 에피3 map4에 스노우맨
		-- (attack1 2.95초)/레인디어(2.05초)를 섞고 나서 드러났다). 공격 연출이 긴 종은 그 사이 피격될
		-- 때마다 1프레임 hit1로 튀어 공격이 계속 끊겨 보이므로 그때만 피격 연출을 건너뛴다(대미지는 정상
		-- 적용) — 이 규칙은 원래 보스(1322)/엘리트(ApplyEliteSpecies)/보스파트너/미니언 경로에만 있었고
		-- **존 몬스터 풀 경로에는 아예 없었다**. 세 분기(존7+ 풀 / 맵4~6 풀 / 웨이브)가 끝난 이 자리에서
		-- 한 번에 세운다(보스 로스터 분기는 아래에서 자기 값으로 다시 덮어쓴다).
		-- 엔티티 재사용 대비로 항상 양쪽 값을 대입한다 — attackRUID가 없으면 무조건 false
		-- ([[feedback_boss_reuse_flying_flag_inherit]]와 같은 계열의 함정).
		self._noHitAnimDuringAttack = (self._attackRUID ~= "" and self._attackDuration >= 1.0)

		-- 로스터가 있는 에피소드(1·2)의 보스는 "존 몬스터가 커진 것"이 아니라 **정해진 순서대로 나오는
		-- 전용 보스**다 (유저 지정 — 2026-09-06 엔젤 슬라임 단독 → 2026-09-07 에피1 로스터화 →
		-- 2026-09-08 에피2 로스터 추가). 존 풀에서 읽어온 값들을 여기서 통째로 덮어쓴다 —
		-- 거대 네펜데스 1페이즈 덮어쓰기와 같은 방식이다.
		-- HP 배율·접근속도·스케일(×2.5)은 위 isBoss 분기가 이미 처리했으므로 건드리지 않는다.
		-- 몇 번째 보스인지는 스포너가 들고 있고(보스를 잡을 때만 증가), 정의는 GameManager 로스터에 있다.
		-- 에피소드 판정은 GameManager.HasBossRoster()가 단일 진실 소스 — 로스터 없는 에피3은 예전 방식 유지.
		if isBoss and _GameManager:HasBossRoster() then
			local bossIndex = _MonsterSpawner:GetBossIndex()
			local def = _GameManager:GetBossDef(bossIndex)
			self._bossDefIndex = bossIndex
			self._standRUID = def.stand
			self._moveRUID = def.move
			self._attackRUID = def.attack
			self._attackDuration = def.attackDur
			self._attackSoundRUID = def.attackSfx
			self._hitRUID = def.hit
			-- 피격음은 안 쓴다 — 보스는 맞는 횟수가 많아서 같은 클립이 도배된다
			self._hitSoundRUID = ""
			self._dieRUID = def.die
			self._dieDuration = def.dieDur
			self._dieSoundRUID = def.dieSfx
			-- 이 보스가 사망 시 분열하는 종인지(2번 가디언 엔젤 슬라임만 true). Die()가 이 값으로
			-- 분열 경로 진입을 판정한다 — 엔티티 재사용 대비로 보스마다 **매번** 명시적으로 세운다.
			self._hasEp1Split = def.hasSplit
			-- 존 풀에서 딸려온 특수 거동은 전부 끈다 — 원거리/고정형/2페이즈 종이 보스로 뽑혔을 때
			-- 그 성질이 보스에 그대로 묻어오면 안 된다(분열은 별도 경로로 처리한다)
			self._isRangedInk = false
			self._isRangedSlash = false
			self._neverAttacks = false
			self._isGiantNepenthes = false
			self._hasPhase2 = false
			-- 플레이어가 서 있는 자리에 뜨는 착탄 연출(원거리 보스 전용 — 스텀피). 없는 보스는 빈 문자열이라
			-- PlayRangedHitEffect가 그냥 리턴한다. 존 풀에서 딸려올 수 있는 부가값들도 여기서 기본값으로
			-- 되돌린다(안 그러면 그 존 종의 축소/투명도/동시출력 설정이 보스에 묻어온다).
			self._hitEffectRUID = def.hitFx
			self._hitEffectDuration = def.hitFxDur
			-- 보스 def엔 프레임 목록 개념이 없다 — 엘리트였던 몸이 보스로 재사용될 때 딸려오면 안 된다
			self._hitEffectFrames = nil
			self._hitEffectFrameDelay = 0
			self._hitEffectScaleMultiplier = 1.0
			self._hitEffectAlpha = 1.0
			self._hitEffectMaxConcurrent = 1
			self._projectileRUID = ""
			-- 원거리형 보스는 플레이어 코앞까지 붙지 않고 조금 떨어진 데서 멈춰 공격한다
			-- (기존 원거리 종과 같은 임계값 — 위 isBoss 분기가 세운 1.5를 여기서 낮춘다)
			if def.ranged then
				self._reachedScaleThreshold = self.RangedReachedScale
			end
			-- 2번째 공격 = 소환기(스텀피). 쿨타임 0이면 없는 보스라 아래 OnUpdate 틱이 아예 안 돈다.
			-- 유저 지정(2026-09-08): "스텀피 어택2(박쥐 소환)를 맨 처음에 사용하게 해줘, 일반 어택 말고".
			-- 그래서 타이머를 0으로 시작한다 — 플레이어에게 도달하는 순간의 **첫 행동이 일반 공격이
			-- 아니라 소환**이 된다(실제 분기는 도달 처리부의 _summonTimer <= 0 체크).
			-- 존 이동 재배치(RelocateBossToCurrentZone)는 _summonTimer를 저장/복원하므로, 쿨타임이
			-- 남은 채로 옮겨가면 다시 도달해도 공짜 소환이 나가지 않는다.
			self._attack2RUID = def.attack2
			self._attack2Duration = def.attack2Dur
			self._attack2SoundRUID = def.attack2Sfx
			self._summonCooldown = def.summonCooldown
			self._summonCount = def.summonCount
			self._summonTimer = 0
			-- 맞을수록 성장(다일). 전부 0인 보스는 ApplyBossHitGrowth가 즉시 리턴한다.
			self._growScalePerHit = def.growScalePerHit
			self._growScaleMax = def.growScaleMax
			self._growAtkPerHit = def.growAtkPerHit
			self._growAtkMax = def.growAtkMax
			-- 공격할 때 자기 몸에서 터지는 이펙트(머쉬맘 포자). 없는 보스는 빈 문자열이라 아무것도 안 뜬다
			self._selfAttackEffectRUID = def.selfFx
			self._selfAttackEffectDuration = def.selfFxDur
			self._selfAttackEffectDelay = def.selfFxDelay
			-- attack1 재생시간이 공격 주기보다 길면 다음 공격이 이전 연출을 잘라먹는다(엔젤 슬라임 1.8초).
			-- 짧은 종(머쉬맘 0.6초)은 기본 주기를 그대로 쓴다.
			if self._attackDuration > self.AttackInterval then
				self._customAttackInterval = self._attackDuration + 0.7
			else
				self._customAttackInterval = 0
			end
			-- 공격 연출이 긴 종은 그 사이 피격될 때마다 1프레임 hit1로 튀어 공격이 계속 끊겨 보인다
			-- (유저 리포트 — 엔젤 슬라임 1.8초). 그때만 피격 연출을 건너뛴다(대미지는 정상 적용).
			self._noHitAnimDuringAttack = self._attackDuration >= 1.0
			-- 종마다 원본 스프라이트 크기가 크게 달라서(슬라임 494×365 / 머쉬맘 120×112) 보스 공통
			-- 배율(×2.5)만 태우면 화면상 크기가 제각각이 된다 — 종별 보정 배율을 여기서 더 곱한다
			self._scaleMultiplier = self._scaleMultiplier * def.scale
			-- ── 에피2 로스터에서 추가된 필드들 ────────────────────────────────────────
			-- 에피1 def에는 이 키들이 아예 없어서 nil로 읽힌다 → 전부 "없으면 기본값"으로 접어 읽는다.
			-- (엔티티 재사용 대비로 매번 명시적으로 세운다 — 이전 보스의 값이 남으면 안 된다.)
			self._hitEffectDelayOverride = 0
			if def.hitFxDelay ~= nil then self._hitEffectDelayOverride = def.hitFxDelay end
			-- 공격할 때마다 공속이 빨라지는 보스(엘리쟈). 피격 성장(growAtk*)과는 별개 경로다.
			self._atkGrowPerAttack = 0
			self._atkGrowAttackMax = 0
			if def.atkGrowPerAttack ~= nil then self._atkGrowPerAttack = def.atkGrowPerAttack end
			if def.atkGrowMax ~= nil then self._atkGrowAttackMax = def.atkGrowMax end
			-- HP가 일정 비율 아래로 떨어지면 그 자리에서 변신하는 보스(엘리쟈 → 다크 엘리쟈).
			-- phase2HpRatio가 0이면 없는 보스라 CheckBossPhase2Transform이 즉시 리턴한다.
			self._bossPhase2HpRatio = 0
			self._bossPhase2Done = false
			self._transformLocked = false
			self._bossPhase2AtkSpeedMult = 1.0
			if def.phase2HpRatio ~= nil then self._bossPhase2HpRatio = def.phase2HpRatio end
			if def.phase2AtkSpeedMult ~= nil then self._bossPhase2AtkSpeedMult = def.phase2AtkSpeedMult end
			-- 공격 슬롯 순환(에피3 하이레프 리더/익스트림 빅풋). nil이면 기존처럼 한 가지 공격만 쓴다.
			-- 첫 공격이 1번 슬롯이 되도록 인덱스는 0에서 시작한다(AdvanceAttackVariant가 먼저 +1 한다).
			self._attackVariants = def.attackVariants
			self._attackVariantIndex = 0
			self._attackVariantSummonCooldown = 0
			if def.attackVariantSummonCooldown ~= nil then self._attackVariantSummonCooldown = def.attackVariantSummonCooldown end
			-- 첫 소환 슬롯은 바로 나갈 수 있게 "아주 오래 전"으로 초기화한다
			self._lastVariantSummonTime = -999
			self._minionDieWithBoss = false
			if def.minionDieWithBoss ~= nil then self._minionDieWithBoss = def.minionDieWithBoss end
			-- HP 임계 소환(에피3 구미호). 0이면 CheckBossHpSummon이 즉시 리턴한다.
			self._hpSummonRatio = 0
			self._hpSummonCount = 0
			self._hpSummonDone = false
			if def.hpSummonRatio ~= nil then self._hpSummonRatio = def.hpSummonRatio end
			if def.hpSummonCount ~= nil then self._hpSummonCount = def.hpSummonCount end
			-- 공격 직후 잔상을 남기며 좌우로 휙 이동하는 보스(엘리쟈)
			self._dashAfterAttack = false
			if def.dashAfterAttack ~= nil then self._dashAfterAttack = def.dashAfterAttack end
			-- 대시의 기준 중심 = 보스가 등장한 자리(존 중앙). 여기서 ±DashRangeX 안에서만 움직인다.
			self._dashHomeX = self.Entity.TransformComponent.Position.x
			-- 재규어식 지그재그 이동(엘리쟈) — 존 풀 종이 쓰던 _isZigzag 경로를 그대로 재사용한다
			if def.zigzag == true then
				self._isZigzag = true
				self._zigzagAmplitudeActual = self.ZigzagAmplitude
			end
			-- 2마리가 같이 뜨는 보스는 체력/공격력을 나눠 갖는다(픽시맘·파파픽시 각 0.75)
			if def.hpMultiplier ~= nil and def.hpMultiplier ~= 1.0 then
				self.MaxHp = math.floor(self.MaxHp * def.hpMultiplier)
				self.CurrentHp = self.MaxHp
			end
			self._bossAtkMultiplier = 1.0
			if def.atkMultiplier ~= nil then self._bossAtkMultiplier = def.atkMultiplier end
			-- 비행 보스(픽시맘·파파픽시·하이레프 리더) — 지상 접근 대신 사인파 비행으로 전환한다.
			-- ⚠ 좌표 재배치는 **스포너가 이 호출 전에** 끝내둔다(_flyCenterX를 지금 Position에서 읽으므로).
			--
			-- ⚠⚠ 버그 수정(2026-09-08, 전 보스 점검에서 발견) — 예전엔 `if def.flying then _isFlying = true end`
			-- 뿐이라 **false로 되돌리는 경로가 없었다.** 비행 보스가 쓰던 엔티티가 재사용되면 지상 보스가
			-- 그 _isFlying=true를 그대로 물려받아 **허공에 떠서 비행 AI로 움직였다**
			-- (실측: 설산의 마녀가 존 이동 후 fly=true, 바닥 위 2.47유닛 / 익스트림 빅풋도 동일).
			-- 존 풀 몬스터는 위쪽에서 GetMapIsFlying으로 매번 덮어쓰지만 보스 분기는 그 줄을 안 탄다.
			-- ApplyEliteSpecies가 `_isFlying = def.flying`으로 **통째로 덮어쓰는 것**과 같은 규칙으로 맞춘다.
			local bossWasFlying = self._isFlying
			self._isFlying = (def.flying == true)
			if not self._isFlying then
				-- 비행 → 지상으로 바뀐 재사용 엔티티는 접근 상태도 스폰 직후로 되돌려야 한다
				-- (안 그러면 _currentScale/_reachedPlayer가 비행 시절 값으로 남아 접근을 건너뛴다).
				self._skipAttackLunge = false
				if bossWasFlying then
					self._currentScale = 0.3
					self._reachedPlayer = false
					self._attackTimer = 0
				end
			end
			if self._isFlying then
				self._currentScale = 1.0
				self._reachedPlayer = false
				self._skipAttackLunge = true
				self._flyCenterX = self.Entity.TransformComponent.Position.x
				self._flyBaseY = (self.FlyingWanderMinY + self.FlyingWanderMaxY) * 0.5
				self._flyTime = 0
				self._flyPhaseX = _UtilLogic:RandomDouble() * math.pi * 2
				self._flyPhaseY = _UtilLogic:RandomDouble() * math.pi * 2
				self._flySpeedMultX = 0.8 + _UtilLogic:RandomDouble() * 0.4
				self._flySpeedMultY = 0.8 + _UtilLogic:RandomDouble() * 0.4
				-- attack1이 길어(픽시맘 2.73 / 파파픽시 4.29초) 공용 비행 주기(1.5초)를 그대로 쓰면
				-- 연출이 계속 중간에서 다시 시작한다 — 지상형과 같은 공식으로 개체별 주기를 늘린다.
				self._flyAttackIntervalOverride = self._attackDuration + 0.7
				self._attackTimer = self.FirstFlyAttackDelay
			end
			log("MonsterAI: boss #" .. bossIndex .. " = " .. def.name)
		end

		-- 접근 중엔 move, 이미 도달(_reachedPlayer)했거나 애초에 move 연출이 없는 종(빈 문자열 — 공중형은
		-- 항상 여기 해당)은 stand로 시작한다. OnUpdate가 도달하는 순간 다시 stand로 갈아끼운다.
		if not self._isFlying and self._moveRUID ~= "" then
			self.MonsterSprite = self._moveRUID
		else
			self.MonsterSprite = self._standRUID
		end
		
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:UpdateDepth()
		if self._isFlying then
			-- 비행형은 스폰 즉시 고정 크기로 "도달"해 있는 상태라 UpdateDepth의 점진적 페이드가 의미가 없다 — 꺼둔다
			self:HideDepthOverlay()
		end
		-- 얼음 파편 효과가 지속되는 도중에 스폰된 몬스터도 즉시 얼려야 한다(유저 지적 — 발동 시점에
		-- 이미 있던 몬스터만 얼리면, 그 뒤로 계속 스폰되는 몬스터는 안 얼어서 "몬스터가 계속 움직인다"는
		-- 것처럼 보인다). 남은 시간(_globalFreezeRemaining)만큼만 걸어서 원래 종료 시점과 맞춘다.
		if _GameManager._globalFreezeActive and _GameManager._globalFreezeRemaining > 0 then
			self:ApplyHardFreeze(_GameManager._globalFreezeRemaining)
		end
		log("MonsterAI: Zone=" .. zoneIndex .. " Wave=" .. wave .. " HP=" .. self.CurrentHp .. " Speed=" .. self.ApproachSpeed)
	end

	-- ep2_map3 "지쳐버린 기사"(Tired Knight) 전용 초기화 — InitializeAlienInvader와 동일하게 존 몬스터
	-- 풀 시스템(InitializeStats)을 거치지 않고 고정된 전용 리소스팩으로 직접 초기화한다(유저 지정 리소스팩,
	-- 2026-08-22). MonsterSpawner가 존마다 1마리씩 우선 스폰할 때, 그리고 MapObject_67 드래그 트리거가
	-- 존1에서 호출한다.
	-- 체력=일반 몬스터의 3배, 공격력=1배(dmgMultiplier 관여 없음, OnReachPlayer 기본값 그대로),
	-- 크기=1.3배(_scaleMultiplier), 피격 무적 프레임 무시(_ignoresHitImmune — OnReachPlayer 참고),
	-- 처치 시 tired_knight_seal 100% 확정 드롭(_isTiredKnight — Die() 참고).
	-- attackDuration/dieDuration은 attack1(5프레임)/die1 클립의 정확한 실측값이 아니라, 다른 종의 프레임수별
	-- 실측 패턴(GetMapAttackDuration/GetMapDieDuration 주석 참고 — 대략 0.1초/프레임)에 맞춘 추정치다.
	@ExecSpace("ServerOnly")
	method void InitializeStatsAsTiredKnight(integer zoneIndex)
		self._dead = false
		self:SetSpawnZone(zoneIndex)
		self._isBoss = false
		self._isElite = false
		self._isTiredKnight = true
		self._ignoresHitImmune = true
		self._reachedScaleThreshold = 1.5
		
		self.MaxHp = _GameManager:GetTimeStepHp(_GameManager:GetTimeStep()) * 3
		self.CurrentHp = self.MaxHp
		-- 보스와 동일하게 느리고 일정한 접근(변동폭 없이) — 유저 지정 없음, 일반 잡몹과 구분되는 "특별한
		-- 강적" 정체성에 맞춰 안정적으로 다가오게 한다.
		self.ApproachSpeed = _GameManager:GetWaveApproachSpeed(10)
		
		-- 전용 리소스팩(유저 제공 RUID, resource_pack "지쳐버린 기사")
		self._standRUID = "8e4d16ddd74644d8bfafaf422a1f7400"
		self._moveRUID = "009463a95c1f47d8a0c62e2507ff1799"
		self._attackRUID = "ac8d9def0432409eabc96f14c268c8ad"
		self._dieRUID = "5915fd536a8c417693933725d2858118"
		self._hitRUID = "380100b9447542e8a11559ea18d5a5b8"
		self._attackSoundRUID = "5095fddab73842a5af4750a178e4c98d"
		self._hitSoundRUID = "972a7ccd15234882acd9face6fd52d93"
		self._dieSoundRUID = "437dd7114fac4758a1d4195cd541853c"
		self._attackDuration = 0.55
		self._dieDuration = 0.45
		
		-- 재사용 엔티티에 이전 점유자의 특수 플래그가 남아있을 수 있어(위쪽 InitializeStats 주석 참고)
		-- 명시적으로 초기화한다 — 지쳐버린 기사는 평범한 지상형 근접 공격 개체다.
		self._isFlying = false
		self._isRangedInk = false
		self._isRangedSlash = false
		self._isCharge = false
		self._isZigzag = false
		self._neverAttacks = false
		self._isGiantNepenthes = false
		self._hasPhase2 = false
		self._phase2Chance = 1.0
		self._isSwarmMember = false
		self._isYellowMiniBean = false
		self._hitEffectRUID = ""
		self._hitEffectMaxConcurrent = 1
		self._customAttackInterval = 0
		self._accuracyDebuffPercent = 0
		self.FreezeStack = 0
		
		self._scaleMultiplier = 1.3
		self.MonsterSprite = self._moveRUID
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:UpdateDepth()
		if _GameManager._globalFreezeActive and _GameManager._globalFreezeRemaining > 0 then
			self:ApplyHardFreeze(_GameManager._globalFreezeRemaining)
		end
		log("MonsterAI: TiredKnight initialized Zone=" .. zoneIndex .. " HP=" .. self.CurrentHp)
	end

	-- Ep2Map3CauldronLogic.SpawnCauldron()이 스폰 직후 호출: ep2_map3 존4에 고정 배치되는 "카페테리아
	-- 가마솥" 전용 초기화. InitializeTreasureChest(보물상자)와 동일한 패턴 — 이동/공격 리소스가 없는
	-- (stand/hit1/die1만 있는) 완전 고정형 오브젝트라 접근 애니메이션 없이 처음부터 "도달" 상태로
	-- 등장하고 _neverAttacks=true로 플레이어를 절대 공격하지 않는다. 구름(MapObject_17)이 걷히기
	-- 전까지는 _cauldronLocked=true로 모든 피격을 무시한다(Ep2Map3CauldronLogic이 구름 클리어 시 해제).
	-- HP는 유저가 별도 수치를 지정하지 않아 일반 몬스터와 동일한 시간대 기준값(GetTimeStepHp)을 쓴다.
	@ExecSpace("ServerOnly")
	method void InitializeStatsAsCauldron(integer zoneIndex)
		self._dead = false
		self:SetSpawnZone(zoneIndex)
		self._isBoss = false
		self._isElite = false
		self._isCauldron = true
		self._cauldronLocked = true
		self._neverAttacks = true
		self._reachedScaleThreshold = 1.5
		
		self.MaxHp = _GameManager:GetTimeStepHp(_GameManager:GetTimeStep())
		self.CurrentHp = self.MaxHp
		self.ApproachSpeed = 0
		
		-- 전용 리소스팩(유저 제공 RUID, resource_pack "Cafeteria Cauldron") — move/attack 없음
		self._standRUID = "07fda3686b304900bdea6d71e01618d7"
		self._hitRUID = "c2bd674886f6462fbc94de108fa4883b"
		self._dieRUID = "923f98f630cb4a89a144cd5b6bf1c883"
		self._moveRUID = ""
		self._attackRUID = ""
		self._hitSoundRUID = "4cfc46ecd21c4c3382f4dcf470047d29"
		self._dieSoundRUID = "d3652d96e0664d989c3f988f4e5ff7c3"
		self._attackSoundRUID = ""
		-- 프레임 수 정보가 없어 다른 소형 오브젝트 사망연출과 비슷한 수준으로 추정(실측 아님)
		self._dieDuration = 0.35
		
		self._isFlying = false
		self._isRangedInk = false
		self._isRangedSlash = false
		self._isCharge = false
		self._isZigzag = false
		self._isGiantNepenthes = false
		self._hasPhase2 = false
		self._phase2Chance = 1.0
		self._isSwarmMember = false
		self._isYellowMiniBean = false
		self._hitEffectRUID = ""
		self._hitEffectMaxConcurrent = 1
		self._customAttackInterval = 0
		self._accuracyDebuffPercent = 0
		self.FreezeStack = 0
		
		-- InitializeTreasureChest와 동일 — 접근 연출 없이 처음부터 "도달" 상태로 고정, 실제 공격 호출만
		-- _neverAttacks로 막는다
		-- 유저가 CauldronPreview(ep2_map3, 실제 스프라이트 미리보기)를 드래그로 크기 조정한 결과값
		-- (절대 Scale 0.74574697) ÷ _reachedScaleThreshold(1.5) = 이 배율.
		self._scaleMultiplier = 0.497164647
		self._currentScale = self._reachedScaleThreshold
		self._reachedPlayer = true
		
		self.MonsterSprite = self._standRUID
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:HideDepthOverlay()
		if _GameManager._globalFreezeActive and _GameManager._globalFreezeRemaining > 0 then
			self:ApplyHardFreeze(_GameManager._globalFreezeRemaining)
		end
		log("MonsterAI: Cauldron initialized Zone=" .. zoneIndex .. " HP=" .. self.CurrentHp)
	end

	-- Ep1Zone2ManoLogic.SpawnMano()가 스폰 직후 호출 — 존2 trap-44를 누르면 나오는 "마노"(유저 제공
	-- 리소스팩). 미니무르 계열(_isMiniMoore)과 달리 "잡을 수 있는" 몬스터다 — 타격을 정상적으로
	-- 받고 HP가 0이 되면 Die()를 타며, 그때 Ep1Zone2ManoLogic이 보상을 준다(_isMano 플래그로 식별).
	--  · HP는 시간대 기준값이 아니라 유저 지정 고정값 1000(ManoFixedHp)
	--  · _neverAttacks=true — 플레이어를 절대 공격하지 않는다(가마솥과 동일 정책)
	--  · 지상에서 좌우로 배회하다 플레이어 쪽으로 접근한다(일반 몬스터의 접근 이동을 그대로 쓰되
	--    공격만 막는 형태 — 10초 안에 잡아야 해서 사거리 안으로 들어와줘야 한다)
	--  · 10초(ManoLifetime) 안에 못 잡으면 스스로 사라진다(EndManoLife)
	@ExecSpace("ServerOnly")
	method void InitializeStatsAsMano(integer zoneIndex, number spawnX, number groundY)
		self._dead = false
		self:SetSpawnZone(zoneIndex)
		self._isBoss = false
		self._isElite = false
		self._isMano = true
		-- 유저 지정(2026-09-05, "마노도 공격하게") — 원래는 가마솥과 같은 정책으로 절대 공격하지
		-- 않았지만, 전용 attack1(10프레임)을 받으면서 일반 몬스터처럼 공격하도록 바꿨다.
		self._neverAttacks = false

		self.MaxHp = self.ManoFixedHp
		self.CurrentHp = self.MaxHp

		-- 유저 제공 리소스팩 "마노" — hit1/die1/move/stand + 사운드.
		self._standRUID = "e035bb90c053401b88de2159dfa230eb"
		self._moveRUID = "3dcd0dc63d2d491b9b8d39b3b9d0a214"
		self._hitRUID = "452cb740ddcb4837a46b75d7935e2ffc"
		self._dieRUID = "f430051f6fc34f2eb56fe5e62b346eac"
		-- 공격 모션(유저 제공 2026-09-05) — 10프레임짜리 진짜 attack1. 유저 지정으로 마노도 이제
		-- 실제로 플레이어를 공격한다(위 _neverAttacks=false 참고).
		-- 팩에 attack1 전용 사운드 RUID는 아직 못 받아서 _attackSoundRUID는 비워 둔다(무음).
		self._attackRUID = "c05453dd21fd4ed581d193930ab4c331"
		self._attackDuration = 1.05  -- 10프레임(프레임당 0.1초 + 0.05초 기준)
		self._hitSoundRUID = "6de4a479bd344a3688d8c28a8b46c0f2"
		self._dieSoundRUID = "ba4aab7d12af410ea2cc7e3fbc97ec54"
		self._attackSoundRUID = ""
		-- 프레임 수 정보가 없어 다른 소형 몬스터 사망연출과 같은 값으로 둔다(실측 아님)
		self._dieDuration = 0.35

		self._isFlying = false
		self._isRangedInk = false
		self._isRangedSlash = false
		self._isCharge = false
		self._isZigzag = false
		self._isGiantNepenthes = false
		self._hasPhase2 = false
		self._phase2Chance = 0
		self._isSwarmMember = false
		self._isYellowMiniBean = false
		self._hitEffectRUID = ""
		self._hitEffectMaxConcurrent = 1
		-- attack1이 1.05초로 기본 AttackInterval(1.0초)보다 길다 — 그대로 두면 다음 공격이 이전 공격의
		-- attack1 재생이 끝나기 전에 겹쳐 들어와, 구 타이머가 새 attack1을 즉시 stand로 되돌려버린다
		-- (웨어울프/라이칸스로프에서 실측된 "연출이 나올 때도 있고 안 나올 때도 있다" 버그와 동일).
		-- 맵/웨이브 몬스터와 같은 공식으로 간격을 늘린다.
		self._customAttackInterval = self._attackDuration + 0.7
		self._accuracyDebuffPercent = 0
		self.FreezeStack = 0

		self._currentScale = 1.0
		self.MonsterSprite = self._standRUID
		self.Entity.TransformComponent.Position = Vector3(spawnX, groundY, 0)
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:HideDepthOverlay()
		if _GameManager._globalFreezeActive and _GameManager._globalFreezeRemaining > 0 then
			self:ApplyHardFreeze(_GameManager._globalFreezeRemaining)
		end

		self._manoLifeTimerId = _TimerService:SetTimerOnce(self.EndManoLife, self.ManoLifetime)
		log("MonsterAI: Mano initialized Zone=" .. zoneIndex .. " HP=" .. self.CurrentHp)
	end

	-- ManoLifetime이 지날 때까지 못 잡으면 호출 — 보상 없이 조용히 사라진다.
	-- 이미 죽었으면(_dead) 아무것도 하지 않는다 — 처치 보상은 Die() 쪽에서 이미 나갔다.
	@ExecSpace("ServerOnly")
	method void EndManoLife()
		self._manoLifeTimerId = 0
		if self._dead then return end
		if not isvalid(self.Entity) then return end
		log("MonsterAI: Mano despawned (not killed in time)")
		self:PlayDespawnJump()
	end

	-- Ep2Map4CentaurLogic.SpawnCentaurHorde()가 스폰 직후 호출 — ep2_map4 MapObject_205를 2번 클릭하면
	-- 등장하는 무리 중 "검은 켄타우로스"(9마리, 유저 지정: 크기 0.8, 체력은 그 시점 일반 몬스터와 동일).
	-- 전용 리소스팩(msw-search로 확인, resource_pack "mob/8140101.img" — "검은 켄타우로스").
	@ExecSpace("ServerOnly")
	method void InitializeStatsAsBlackCentaur(integer zoneIndex)
		self._dead = false
		self:SetSpawnZone(zoneIndex)
		self._isBoss = false
		self._isElite = false
		self._isBlackCentaur = true
		self._reachedScaleThreshold = 1.5
		
		self.MaxHp = _GameManager:GetTimeStepHp(_GameManager:GetTimeStep())
		self.CurrentHp = self.MaxHp
		self.ApproachSpeed = _GameManager:GetWaveApproachSpeed(_GameManager.Wave)
		
		self._standRUID = "cbb6bd77341b4dceb4c88e70cf524740"
		self._moveRUID = "83c104143ccd4550bd61d180ea70c369"
		self._attackRUID = "bff36d5a39404119a6f8160653fd745a"
		self._dieRUID = "433a8737e1044f21ab6db90ae7864ffc"
		self._hitRUID = "4b2f616d2fe640bab7335c33cf535d3f"
		self._attackSoundRUID = "3c987a84b45a42e9b01d5a5b5404ee66"
		self._hitSoundRUID = "fa7114a0b24b473ba32b1b98aa761606"
		self._dieSoundRUID = "775705f8cc904686a64ed763b93af841"
		-- 프레임 수 실측 없이 일반 지상형 몬스터 관례값 사용(라이브 확인 후 조정 가능)
		self._attackDuration = 0.55
		self._dieDuration = 0.45
		
		self._isFlying = false
		self._isRangedInk = false
		self._isRangedSlash = false
		self._isCharge = false
		self._isZigzag = false
		self._neverAttacks = false
		self._isGiantNepenthes = false
		self._hasPhase2 = false
		self._phase2Chance = 1.0
		self._isSwarmMember = false
		self._isYellowMiniBean = false
		self._hitEffectRUID = ""
		self._hitEffectMaxConcurrent = 1
		self._customAttackInterval = 0
		self._accuracyDebuffPercent = 0
		self.FreezeStack = 0
		
		self._scaleMultiplier = 0.8
		self.MonsterSprite = self._moveRUID
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:UpdateDepth()
		if _GameManager._globalFreezeActive and _GameManager._globalFreezeRemaining > 0 then
			self:ApplyHardFreeze(_GameManager._globalFreezeRemaining)
		end
		log("MonsterAI: BlackCentaur initialized Zone=" .. zoneIndex .. " HP=" .. self.CurrentHp)
	end

	-- Ep2Map4CentaurLogic.SpawnCentaurHorde()가 스폰 직후 호출 — 무리의 우두머리 "타락한 켄타우로스"
	-- (1마리, 유저 지정: 체력=그 시점 일반 몬스터의 2배, 크기 1.2). 처치 시 엘리트와 동일하게 확정
	-- 드롭(빨간 포션 + 슬롯 스킬 1개, CardManager.OnCorruptedCentaurKilled 참고)을 받는다. 전용 리소스팩
	-- (msw-search로 확인, resource_pack "mob/8220019.img" — "타락한 켄타우로스").
	@ExecSpace("ServerOnly")
	method void InitializeStatsAsCorruptedCentaur(integer zoneIndex)
		self._dead = false
		self:SetSpawnZone(zoneIndex)
		self._isBoss = false
		self._isElite = false
		self._isCorruptedCentaur = true
		self._reachedScaleThreshold = 1.5
		
		self.MaxHp = _GameManager:GetTimeStepHp(_GameManager:GetTimeStep()) * 2.0
		self.CurrentHp = self.MaxHp
		self.ApproachSpeed = _GameManager:GetWaveApproachSpeed(_GameManager.Wave)
		
		self._standRUID = "d5b65bd56bcd4f85a87a8ca123abe32f"
		self._moveRUID = "06a3223907a14b64b9e8990c8a30bf72"
		self._attackRUID = "fd9aa2adc8ed47989304af6904d24ccb"
		self._dieRUID = "fcdccdc2a9c04eecaa97f6bf1ebdc0ae"
		self._hitRUID = "6c48dbfea7c542b98309f8e51fe877d1"
		self._attackSoundRUID = "2375c66fa3364e2f9b182c9b7a37ff87"
		self._hitSoundRUID = "700e833db5c245b0bd9100170b071bec"
		self._dieSoundRUID = "9e8683b5c8e84d0485e2053b63d7711b"
		self._attackDuration = 0.55
		self._dieDuration = 0.45
		
		self._isFlying = false
		self._isRangedInk = false
		self._isRangedSlash = false
		self._isCharge = false
		self._isZigzag = false
		self._neverAttacks = false
		self._isGiantNepenthes = false
		self._hasPhase2 = false
		self._phase2Chance = 1.0
		self._isSwarmMember = false
		self._isYellowMiniBean = false
		self._hitEffectRUID = ""
		self._hitEffectMaxConcurrent = 1
		self._customAttackInterval = 0
		self._accuracyDebuffPercent = 0
		self.FreezeStack = 0
		
		self._scaleMultiplier = 1.2
		self.MonsterSprite = self._moveRUID
