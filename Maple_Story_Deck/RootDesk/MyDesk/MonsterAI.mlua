	@ExecSpace("ServerOnly")
	method void InitializeBonusBoss(number minX, number maxX, number groundY, string spriteRUID)
		self:SetSpawnZone(10)
		self._isBonusBoss = true
		-- 유저 지정: 타이머가 보이기 시작하기 전까진 완전히 공격 불가 — 소유측(MonsterSpawner)이
		-- 지연 후 타이머를 실제로 띄우는 시점에 false로 풀어준다.
		self._bonusBossCombatLocked = true
		self._wanderMinX = minX
		self._wanderMaxX = maxX
		self._wanderY = groundY
		self.MonsterSprite = spriteRUID
		self._currentScale = 1.3
		self.Entity.TransformComponent.Position = Vector3(0, groundY, 0)
		self.Entity.TransformComponent.Scale = Vector3(1.3, 1.3, 1.0)
		self:SyncDepthOverlaySprite()
		self:HideDepthOverlay()
		self:PickNewWanderTarget()
		log("MonsterAI: bonus boss initialized, _spawnZoneIndex=" .. self._spawnZoneIndex)
	end

	@ExecSpace("ServerOnly")
	method void InitializeAnimatedBonusBoss(integer zoneIndex, number spawnX, number minX, number maxX, number groundY, string standRUID, string moveRUID, string hitRUID, string dieRUID, string hitSoundRUID, string dieSoundRUID, number hp)
		self:SetSpawnZone(zoneIndex)
		self._isBonusBoss = true
		self._bonusBossKillable = true
		-- 유저 지정: 타이머가 보이기 시작하기 전까진 완전히 공격 불가 — Ep3Map2BonusBossLogic.
		-- StartBossTimer()가 실제로 타이머를 띄우는 시점에 false로 풀어준다.
		self._bonusBossCombatLocked = true
		self.MaxHp = hp
		self.CurrentHp = hp
		self._wanderMinX = minX
		self._wanderMaxX = maxX
		self._wanderY = groundY
		self._standRUID = standRUID
		self._hitRUID = hitRUID
		self._dieRUID = dieRUID
		self._hitSoundRUID = hitSoundRUID
		self._dieSoundRUID = dieSoundRUID
		-- 항상 배회 중(UpdateWander가 매 프레임 계속 이동)이라 "걷는" 스프라이트를 기본으로 유지한다.
		self.MonsterSprite = moveRUID
		self._currentScale = 1.3
		self.Entity.TransformComponent.Position = Vector3(spawnX, groundY, 0)
		self.Entity.TransformComponent.Scale = Vector3(1.3, 1.3, 1.0)
		self:SyncDepthOverlaySprite()
		self:HideDepthOverlay()
		self:PickNewWanderTarget()
		log("MonsterAI: animated bonus boss initialized zone=" .. zoneIndex .. " hp=" .. math.floor(hp))
	end

	@ExecSpace("ServerOnly")
	method void OnBonusBossDefeated()
		self._dead = true
		local worldPos = self.Entity.TransformComponent.WorldPosition
		local dropScale = _CardManager:GetEffectScaleRatio(self)
		_GameManager:GrantWeaponItemDrop(worldPos, 0, worldPos.y, dropScale)
		log("MonsterAI: bonus boss defeated, weapon drop granted")
		_Ep3Map2BonusBossLogic:EndBonusStage()
	end

	@ExecSpace("ServerOnly")
	method void InitializeAlienInvader(integer zoneIndex, number hp, number speed, string standRUID, string hitRUID, string dieRUID, number dieDuration, string attackRUID)
		self:SetSpawnZone(zoneIndex)
		self.MaxHp = hp
		self.CurrentHp = hp
		self.ApproachSpeed = speed
		self.MonsterSprite = standRUID
		self._dieRUID = dieRUID
		self._dieDuration = dieDuration
		self._hitRUID = hitRUID
		self._attackRUID = attackRUID
		self._isFlying = true
		self._currentScale = 1.0
		self._flyCenterX = self.Entity.TransformComponent.Position.x
		self._flyBaseY = (self.FlyingWanderMinY + self.FlyingWanderMaxY) * 0.5
		self._flyTime = 0
		self._flyPhaseX = _UtilLogic:RandomDouble() * math.pi * 2
		self._flyPhaseY = _UtilLogic:RandomDouble() * math.pi * 2
		self._flySpeedMultX = 0.8 + _UtilLogic:RandomDouble() * 0.4
		self._flySpeedMultY = 0.8 + _UtilLogic:RandomDouble() * 0.4
		self._attackTimer = self.FlyAttackInterval
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
		self:HideDepthOverlay()
		log("MonsterAI: alien invader initialized HP=" .. hp)
	end

	@ExecSpace("ServerOnly")
	method void InitializeGroundAlienInvader(integer zoneIndex, number hp, number speed, string standRUID, string moveRUID, string hitRUID, string dieRUID, number dieDuration, string attackRUID, number spawnX, number groundY)
		self:SetSpawnZone(zoneIndex)
		self.MaxHp = hp
		self.CurrentHp = hp
		self.ApproachSpeed = speed
		self._standRUID = standRUID
		self._moveRUID = moveRUID
		self._dieRUID = dieRUID
