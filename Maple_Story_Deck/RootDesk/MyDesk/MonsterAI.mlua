		self._flyBaseY = (self.FlyingWanderMinY + self.FlyingWanderMaxY) * 0.5
		self._flyTime = 0
		self._flyPhaseX = _UtilLogic:RandomDouble() * math.pi * 2
		self._flyPhaseY = _UtilLogic:RandomDouble() * math.pi * 2
		self._flySpeedMultX = 0.8 + _UtilLogic:RandomDouble() * 0.4
		self._flySpeedMultY = 0.8 + _UtilLogic:RandomDouble() * 0.4
		self._attackTimer = self.FlyAttackInterval
		self.Entity.TransformComponent.Scale = Vector3(self._currentScale * self._scaleMultiplier, self._currentScale * self._scaleMultiplier, 1.0)
		self:SyncDepthOverlaySprite()
