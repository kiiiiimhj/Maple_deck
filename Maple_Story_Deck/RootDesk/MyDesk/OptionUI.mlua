@Logic
script OptionUI extends Logic
	-- 인게임 옵션 팝업(ui/OptionGroup.ui) 컨트롤러.
	-- HUD 우상단 원형 "옵션" 버튼 → 옵션 패널(배경음/효과음 토글, 조합, 게임 종료)
	--                              → "조합" → 조합식 패널(스킬 아이콘 + 아이콘 = 결과 아이콘)
	-- 두 패널은 같은 UIGroup 안에 있고 딤드 배경 하나를 공유한다. UI라서 전부 ClientOnly.

	property Entity optionGroup = "286e4e96-7bf6-4463-85ed-27ab4741f26c"
	property Entity optionPanel = "c2c2fbbe-a6e3-405f-ad69-9dc45156952d"
	property Entity fusionPanel = "c869d11a-75f5-44e4-8030-f7c715c6d66a"

	property ButtonComponent btnOption = "dba34531-f159-4ca0-894d-d2bdac2f38c0"
	property ButtonComponent btnOptionClose = "3a206cc6-e186-4c6e-8dec-6484e701614a"
	property ButtonComponent btnFusion = "299f0302-ea44-4645-9521-3b4d80db2bbc"
	property ButtonComponent btnQuit = "cc182cd9-dcbe-4b4d-841d-49c2e97b7e25"
	property ButtonComponent btnFusionClose = "a88d5d00-6c9e-482c-9681-8acfcd7cd353"
	-- 종료 확인창 — 옵션 패널 위에 겹쳐 뜬다(옵션 패널은 뒤에 그대로 남는다)
	-- ── 게임 방법(튜토리얼) 오버레이 ──────────────────────────────────────────
	-- 옵션 그룹이 최상위(GroupOrder 16)라 인게임 화면 위에 확실히 뜨고 딤드도 그대로 재활용된다.
	-- 두 경로로 열린다: (1) 첫 플레이 자동 노출  (2) 옵션 팝업의 "게임 방법" 버튼
	property Entity tutorialPanel = "0edc1972-2214-4308-84c2-1fca505028fb"

	property ButtonComponent btnTutorial = "a28e59ac-7643-440f-8bf5-fbd0b813778e"

	property ButtonComponent btnTutorialClose = "b6809912-9b7b-47f8-a288-420506139039"

	property TextGUIRendererComponent tutorialBody = "f1716cb7-d281-4420-825b-da1707535289"

	property Entity tutorialCatcher = "c091063c-1a87-499c-985c-d038394e3bc2"

	-- 본문이 뷰포트(560)보다 얼마나 더 긴지 = 위아래로 끌 수 있는 총량(px).
	-- 실측: 26줄 x 줄높이 약 29px = 약 762px → 762 - 560 ≈ 210.
	-- BuildTutorialText의 줄 수를 늘리거나 줄이면 이 값도 같이 맞춰야 한다
	-- (너무 크면 빈 나무판만 보일 때까지 끌려 내려가고, 너무 작으면 끝 문단이 안 보인다)
	property number TutorialScrollRange = 210

	-- 본문 맨 위 위치(ScrollArea 기준). 빌더가 만든 초기값과 같아야 한다
	property number TutorialBodyTopY = 280

	-- 옵션 팝업에서 열었으면 true — 닫을 때 옵션 패널로 돌아간다.
	-- 첫 플레이 자동 노출이면 false라 닫는 순간 팝업 전체가 사라지고 바로 게임으로 돌아간다
	property boolean _tutorialFromOption = false

	property any _tutorialDragHandler = nil

	property Entity confirmPanel = "772e6312-1d86-413b-8de5-24fe94c3d09b"
	-- 종료 확인창 전용 딤(2026-09-13 버그 수정). 확인창(640x412)이 옵션 패널(800x800)보다 작아서
	-- 뒤의 BtnClose(우상단)·BtnQuit(하단)가 그대로 노출·클릭됐다. 이 프로젝트에서 뒤 클릭을 막는
	-- 방법은 "1920x1080 스프라이트 + RaycastTarget=true"뿐이라(CanvasGroup.BlocksRaycasts로는 안 막힘)
	-- 확인창과 같이 켜지는 딤을 한 장 더 둔다. displayOrder: OptionPanel(1) < 이 딤(3) < ConfirmPanel(5)
	property Entity confirmDimmer = "ef5fe450-2784-4756-9239-a36bea7bccb7"
	property ButtonComponent btnConfirmYes = "5a71ffe1-5626-456b-b0b9-4a90efb96e8b"
	property ButtonComponent btnConfirmNo = "7f6357af-85b6-474b-b581-3b16a049c2fe"
	property ButtonComponent btnBgm = "c9f7943b-5aec-4810-a245-589a0034884f"
	property ButtonComponent btnSfx = "98665bec-f547-4530-9883-db5eb4f9e279"
	-- 토글 원 안의 ON/OFF 글자 — 버튼과 같은 엔티티(button()이 스프라이트+텍스트를 한 엔티티에 만든다)
	property TextGUIRendererComponent bgmText = "c9f7943b-5aec-4810-a245-589a0034884f"
	property TextGUIRendererComponent sfxText = "98665bec-f547-4530-9883-db5eb4f9e279"

	-- 켜짐/꺼짐 색 — 꺼진 쪽은 회색으로 눌러서 한눈에 구분되게 한다.
	property Color OnColor = Color(1.0, 1.0, 1.0, 1.0)
	property Color OffColor = Color(0.45, 0.45, 0.45, 1.0)

	property integer FusionRowCount = 7

	-- 미발견 조합 가림 연출 — 아이콘은 이 색으로 곱해 실루엣으로 만들고, 같은 엔티티에 "?" 글자를 얹는다
	property Color FusionHiddenTint = Color(0, 0, 0, 1)
	property string FusionHiddenMark = "?"
	property Color FusionHiddenMarkColor = Color(1, 1, 1, 1)
	property number FusionHiddenMarkSize = 36
	property string FusionHiddenName = "???"

	-- 캐릭터별 조합식. { result = 결과 카드, mats = { 재료 카드들 } }
	-- 재료 첫 번째가 Lv5까지 올려야 하는 슬롯 카드, 나머지는 보유만 하면 되는 패시브다.
	-- 원본은 CardManager.GenerateLevelUpChoices의 조합 해금 조건문들 — 거기 조건이 바뀌면 여기도 같이 고칠 것.
	property any _recipes = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼 연결 + 시작 시 팝업 닫힘 상태 보장.
		self:BuildRecipeTable()

		self.btnOption.Entity:ConnectEvent(ButtonClickEvent, function() self:OpenOption() end)
		self.btnOptionClose.Entity:ConnectEvent(ButtonClickEvent, function() self:CloseAll() end)
		self.btnFusionClose.Entity:ConnectEvent(ButtonClickEvent, function() self:CloseFusion() end)
		self.btnFusion.Entity:ConnectEvent(ButtonClickEvent, function() self:OpenFusion() end)
		self.btnQuit.Entity:ConnectEvent(ButtonClickEvent, function() self:OpenQuitConfirm() end)
		self.btnConfirmYes.Entity:ConnectEvent(ButtonClickEvent, function() self:OnQuitConfirmed() end)
		self.btnConfirmNo.Entity:ConnectEvent(ButtonClickEvent, function() self:CloseQuitConfirm() end)
		self.btnBgm.Entity:ConnectEvent(ButtonClickEvent, function() self:ToggleBgm() end)
		self.btnSfx.Entity:ConnectEvent(ButtonClickEvent, function() self:ToggleSfx() end)

		self.btnTutorial.Entity:ConnectEvent(ButtonClickEvent, function() self:OpenTutorial(true) end)
		self.btnTutorialClose.Entity:ConnectEvent(ButtonClickEvent, function() self:CloseTutorial() end)
		self._tutorialDragHandler = self.tutorialCatcher:ConnectEvent(UITouchDragEvent, self.OnTutorialDrag)
		self.tutorialBody.Text = self:BuildTutorialText()

		self.optionGroup:SetEnable(false)
		self.confirmPanel:SetEnable(false)
		self.confirmDimmer:SetEnable(false)
		self.tutorialPanel:SetEnable(false)
		self:RefreshToggleVisual()
		log("OptionUI: ready")
	end

	@ExecSpace("ClientOnly")
	method void BuildRecipeTable()
		-- 캐릭터 인덱스(_GameManager.SelectedCharacter) → 조합식 목록.
		-- 표 원본은 FusionDiscoveryLogic.GetRecipeTable — 서버의 "발견" 기록과 같은 표를 쓰도록 한 곳으로 옮겼다(2026-09-17)
		self._recipes = _FusionDiscoveryLogic:GetRecipeTable()
	end

	@ExecSpace("ClientOnly")
	method void OpenOption()
		-- 게임오버 팝업이 떠 있는 동안엔 옵션을 열지 않는다(둘이 겹쳐서 조작이 꼬인다).
		if _GameManager.GameOver then return end
		self.optionGroup:SetEnable(true)
		self.optionPanel:SetEnable(true)
		self.fusionPanel:SetEnable(false)
		self.confirmPanel:SetEnable(false)
		self.confirmDimmer:SetEnable(false)
		self.tutorialPanel:SetEnable(false)
		self:RefreshToggleVisual()
		-- 유저 지정(2026-09-13): 옵션이 열려 있는 동안 게임은 멈춘다(몬스터 이동·공격, 스폰,
		-- 자동 공격/쿨다운, 타임어택 카운트다운 전부). 정지 플래그는 서버가 소유한다
		_GameManager:RequestSetOptionPaused(true)
	end

	@ExecSpace("ClientOnly")
	method void CloseAll()
		-- X 버튼 / 게임 종료 직전에 팝업 전체를 닫는다.
		self.optionGroup:SetEnable(false)
		-- ⚠ 팝업을 닫는 모든 경로가 이 메서드를 지나므로 정지 해제도 여기 한 곳에만 둔다.
		-- 새 출구를 만들면 여기를 꼭 거치게 할 것 — 안 그러면 게임이 멈춘 채로 남는다
		_GameManager:RequestSetOptionPaused(false)
	end

	@ExecSpace("ClientOnly")
	method string BuildTutorialText()
		-- 안내 본문. 문구를 고치려면 여기만 바꾸면 된다.
		-- 줄 수를 늘리면 TutorialScrollRange도 같이 키울 것(안 그러면 끝까지 안 내려간다)
		return table.concat({
			"[ 전투는 자동입니다 ]",
			"캐릭터가 알아서 몬스터를 공격합니다.",
			"화면에서 몬스터를 한 번 누르면 그 몬스터를 먼저 노립니다.",
			"",
			"[ 레벨업하면 카드를 고릅니다 ]",
			"경험치가 가득 차면 화면 오른쪽에 카드 세 장이 나타납니다.",
			"한 장을 골라 새 스킬을 배우거나 가진 스킬을 강화하세요.",
			"카드를 길게 누르고 있으면 어떤 효과인지 미리 볼 수 있습니다.",
			"",
			"[ 같은 스킬을 모으면 강해집니다 ]",
			"같은 카드를 여러 번 고르면 스킬 레벨이 올라갑니다.",
			"특정 스킬을 함께 갖추면 더 강한 조합 스킬로 바뀌기도 합니다.",
			"어떤 조합이 있는지는 옵션의 \"조합식\"에서 확인하세요.",
			"",
			"[ 좌우 화살표로 구역을 옮깁니다 ]",
			"화면 양옆의 화살표를 누르면 다음 구역으로 넘어갑니다.",
			"자물쇠가 걸린 길은 그 구역의 보스를 쓰러뜨려야 열립니다.",
			"",
			"[ 쓰러져도 끝이 아닙니다 ]",
			"다이아를 쓰면 쓰러진 자리에서 바로 이어할 수 있습니다.",
			"처음부터 다시 시작하면 이번 판에 모은 잡템이 골드로 바뀝니다.",
			"",
			"[ 판이 끝나도 남는 것 ]",
			"장비와 유물, 스킬 강화는 로비에 그대로 남습니다.",
			"인벤토리에서 장비를 장착하고, 합성하고, 필요 없는 것은 팔 수 있습니다.",
		}, "\n")
	end

	@ExecSpace("ClientOnly")
	method void OpenTutorial(boolean fromOption)
		-- 옵션 팝업의 "게임 방법" — 전체 규칙을 한 장에 담은 텍스트 안내다.
		-- 첫 플레이 온보딩(딤+손가락 유도)은 이것과 별개로 TutorialGuideUI가 담당한다.
		-- fromOption=true면 옵션 팝업에서 연 것 — 닫을 때 옵션 패널로 돌아간다.
		-- false면 외부에서 직접 연 것 — 닫으면 팝업 전체가 닫히고 바로 게임으로 돌아간다
		self._tutorialFromOption = fromOption

		self.optionGroup:SetEnable(true)
		self.optionPanel:SetEnable(false)
		self.fusionPanel:SetEnable(false)
		self.confirmPanel:SetEnable(false)
		self.tutorialPanel:SetEnable(true)

		-- 열 때마다 본문을 맨 위로 되돌린다
		self.tutorialBody.Entity.UITransformComponent.anchoredPosition = Vector2(0, self.TutorialBodyTopY)
	end

	@ExecSpace("ClientOnly")
	method void CloseTutorial()
		self.tutorialPanel:SetEnable(false)
		if self._tutorialFromOption then
			self.optionPanel:SetEnable(true)
		else
			self.optionGroup:SetEnable(false)
		end
	end


	@ExecSpace("ClientOnly")
	method void OnTutorialDrag(UITouchDragEvent event)
		-- 본문을 위아래로만 끈다. 맨 위(TutorialBodyTopY)에서 아래로는 못 가고,
		-- 아래로는 TutorialScrollRange 만큼까지만 올라간다
		local tr = self.tutorialBody.Entity.UITransformComponent
		local top = self.TutorialBodyTopY
		local y = tr.anchoredPosition.y + event.TouchDelta.y
		y = math.max(top, math.min(top + self.TutorialScrollRange, y))
		tr.anchoredPosition = Vector2(0, y)
	end

	@ExecSpace("ClientOnly")
	method void OpenFusion()
		-- "조합" — 옵션 패널을 조합식 패널로 갈아끼운다(딤드는 그대로 유지).
		self:RefreshFusionRows()
		self.confirmPanel:SetEnable(false)
		self.optionPanel:SetEnable(false)
		self.fusionPanel:SetEnable(true)
	end

	@ExecSpace("ClientOnly")
	method void CloseFusion()
		-- 조합식 X — 옵션 패널로 되돌아간다.
		self.fusionPanel:SetEnable(false)
		self.optionPanel:SetEnable(true)
	end

	@ExecSpace("ClientOnly")
	method void RefreshFusionRows()
		-- 현재 고른 캐릭터의 조합식만 채운다. 재료가 2~4개로 제각각이라 슬롯/＋는 고정 좌표에 미리
		-- 깔아두고 남는 것만 끈다 — 그래야 "=" 와 결과 아이콘이 모든 행에서 같은 x에 정렬된다.
		local list = self._recipes[_GameManager.SelectedCharacter]
		if list == nil then list = self._recipes[0] end

		for i = 1, self.FusionRowCount do
			local row = self.fusionPanel:GetChildByName("Row" .. i, false)
			if row ~= nil then
				local rec = list[i]
				if rec == nil then
					row:SetEnable(false)
				else
					row:SetEnable(true)
					local mats = rec.mats
					local matCount = #mats
					-- 유저 지정(2026-09-17): 아직 만들어보지 않은 조합은 첫 재료만 공개하고, 나머지 재료·결과는
					-- 검은 실루엣 + "?"로 가린다. 결과 스킬을 한 번 획득하면 FusionDiscoveryLogic이 영구 공개한다
					local discovered = _FusionDiscoveryLogic:IsDiscovered(rec.result)
					for s = 1, 4 do
						local slot = row:GetChildByName("Slot" .. s, false)
						if slot ~= nil then
							if s <= matCount then
								slot:SetEnable(true)
								slot.SpriteGUIRendererComponent.ImageRUID = DataRef(_CardManager:GetCardIconRUID(mats[s]))
								local hideSlot = false
								if not discovered and s >= 2 then hideSlot = true end
								self:ApplyFusionMask(slot, hideSlot)
							else
								slot:SetEnable(false)
							end
						end
					end
					for p = 1, 3 do
						local plus = row:GetChildByName("Plus" .. p, false)
						if plus ~= nil then plus:SetEnable(p < matCount) end
					end
					local res = row:GetChildByName("Result", false)
					if res ~= nil then
						res.SpriteGUIRendererComponent.ImageRUID = DataRef(_CardManager:GetCardIconRUID(rec.result))
						self:ApplyFusionMask(res, not discovered)
					end
					local nameEntity = row:GetChildByName("Name", false)
					if nameEntity ~= nil then
						if discovered then
							nameEntity.TextGUIRendererComponent.Text = _CardManager:GetSlotBaseName(rec.result)
						else
							nameEntity.TextGUIRendererComponent.Text = self.FusionHiddenName
						end
					end
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyFusionMask(Entity iconEntity, boolean hidden)
		-- 아이콘 하나를 가리거나(검은 실루엣 + "?") 원래대로 되돌린다.
		-- "?" 글자는 .ui를 건드리지 않도록 처음 가릴 때 아이콘 엔티티에 TextGUIRendererComponent를 붙여서 쓴다
		local sprite = iconEntity.SpriteGUIRendererComponent
		if sprite ~= nil then
			if hidden then
				sprite.Color = self.FusionHiddenTint
			else
				sprite.Color = Color(1, 1, 1, 1)
			end
		end
		local mark = iconEntity.TextGUIRendererComponent
		if mark == nil then
			if not hidden then return end
			iconEntity:AddComponent(TextGUIRendererComponent)
			mark = iconEntity.TextGUIRendererComponent
			if mark == nil then
				log_warning("OptionUI: failed to add fusion mask text on " .. iconEntity.Name)
				return
			end
			mark.Font = "Maple"
			mark.FontSize = self.FusionHiddenMarkSize
			mark.FontColor = self.FusionHiddenMarkColor
			mark.HorizontalAlignment = TextHorizontalAlignmentOption.Center
			mark.VerticalAlignment = TextVerticalAlignmentOption.Middle
		end
		if hidden then
			mark.Text = self.FusionHiddenMark
		else
			mark.Text = ""
		end
	end

	@ExecSpace("ClientOnly")
	method void ToggleBgm()
		-- 배경음 켜기/끄기.
		_SoundOptionLogic:SetBgmMuted(not _SoundOptionLogic:IsBgmMuted())
		self:RefreshToggleVisual()
	end

	@ExecSpace("ClientOnly")
	method void ToggleSfx()
		-- 효과음 켜기/끄기.
		_SoundOptionLogic:SetSfxMuted(not _SoundOptionLogic:IsSfxMuted())
		self:RefreshToggleVisual()
	end

	@ExecSpace("ClientOnly")
	method void RefreshToggleVisual()
		-- 원 안의 글자(ON/OFF)와 원 색을 현재 음소거 상태에 맞춘다.
		local bgmOn = not _SoundOptionLogic:IsBgmMuted()
		local sfxOn = not _SoundOptionLogic:IsSfxMuted()

		if bgmOn then
			self.bgmText.Text = "ON"
			self.btnBgm.Entity.SpriteGUIRendererComponent.Color = self.OnColor
		else
			self.bgmText.Text = "OFF"
			self.btnBgm.Entity.SpriteGUIRendererComponent.Color = self.OffColor
		end

		if sfxOn then
			self.sfxText.Text = "ON"
			self.btnSfx.Entity.SpriteGUIRendererComponent.Color = self.OnColor
		else
			self.sfxText.Text = "OFF"
			self.btnSfx.Entity.SpriteGUIRendererComponent.Color = self.OffColor
		end
	end

	@ExecSpace("ClientOnly")
	method void OpenQuitConfirm()
		-- "게임 종료"는 되돌릴 수 없으니 바로 끝내지 않고 확인창을 먼저 띄운다(유저 지정 2026-08-30).
		-- 확인창(640x412)이 옵션 패널(800x800)보다 작아서 뒤의 BtnClose/BtnQuit가 그대로 눌렸다 —
		-- 딤을 같이 켜서 확인창 바깥 클릭을 막는다(2026-09-13 버그 수정, confirmDimmer 선언부 참고)
		self.confirmDimmer:SetEnable(true)
		self.confirmPanel:SetEnable(true)
	end

	@ExecSpace("ClientOnly")
	method void CloseQuitConfirm()
		-- "아니오" — 확인창만 닫고 옵션 패널로 돌아간다.
		self.confirmPanel:SetEnable(false)
		self.confirmDimmer:SetEnable(false)
	end

	@ExecSpace("ClientOnly")
	method void OnQuitConfirmed()
		-- "예" — 이번 런을 여기서 끝낸다. 서버가 랭킹 점수를 등록하고 GameOver를 켜면 GameOverUI가
		-- 폴링으로 게임오버 팝업을 띄운다(죽었을 때와 동일 경로). 단, 스스로 끝낸 판은 이어하기가
		-- 없어야 하므로 GameManager._gaveUp 플래그로 "다시하기만" 모드가 된다.
		log("OptionUI: quit(give up) confirmed")
		self:CloseAll()
		_GameManager:RequestGiveUp()
	end
end

