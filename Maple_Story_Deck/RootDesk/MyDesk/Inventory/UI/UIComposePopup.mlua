@Component
script UIComposePopup extends Component

	property SpriteGUIRendererComponent BaseSlotIcon = "5a07ad40-19ce-40d3-92a5-2f820635f824"

	-- 등급색 테두리 대상(유저 지정: 아이콘 자체가 아니라 슬롯 배경에 테두리를 씌워야 함) — 각 슬롯의
	-- 부모 SPR 엔티티(Icon의 부모)를 그대로 재사용, Material1/Material2는 ButtonComponent와 같은
	-- 엔티티라 UUID가 동일하다
	property SpriteGUIRendererComponent BaseSlotFrame = "4216dee6-8e13-4b3f-b52e-77df82a9b185"

	property ButtonComponent Material1 = "2484832f-d6fb-48d5-aabb-993fc9b5274d"

	property SpriteGUIRendererComponent Material1Icon = "dc1a393e-9ae6-4281-828f-c65c7b11a237"

	property SpriteGUIRendererComponent Material1Frame = "2484832f-d6fb-48d5-aabb-993fc9b5274d"

	property ButtonComponent Material2 = "661c11d7-7c05-4ea7-87df-256032283fb0"

	property SpriteGUIRendererComponent Material2Icon = "18d126f9-a00c-4610-99fb-9631a1be9427"

	property SpriteGUIRendererComponent Material2Frame = "661c11d7-7c05-4ea7-87df-256032283fb0"

	property SpriteGUIRendererComponent ResultSlotIcon = "84dea8a2-50b5-4d39-816b-da79c3b480de"

	property SpriteGUIRendererComponent ResultSlotFrame = "7664ae6d-0fc9-43f9-b798-825fdec15e56"

	-- 품질 배지(유저 지정: 베이스/재료 슬롯에도 품질 표시 필요) — 인벤토리 슬롯/장비 정보 팝업과 동일하게
	-- 무기는 실제 품질(F~S), 그 외 장비는 "A" 고정. 재료 슬롯은 선택 안 됐으면 배지 자체를 숨긴다
	property SpriteGUIRendererComponent BaseQualityBg = "061af901-551c-48d8-9ac1-78062c348cca"

	property TextGUIRendererComponent BaseQualityText = "3e7506c1-b133-4748-9563-c7eccd773c39"

	property SpriteGUIRendererComponent Material1QualityBg = "84992153-9b48-4860-bf52-f99ad6e601f3"

	property TextGUIRendererComponent Material1QualityText = "c5e297f8-24b0-4b76-a286-65f4f25ff039"

	property SpriteGUIRendererComponent Material2QualityBg = "20945dde-0fda-477c-9062-dae77549462a"

	property TextGUIRendererComponent Material2QualityText = "bd055143-6491-4dc8-b9b3-35471677e813"

	-- 합성 진행도 뱃지(유저 지정, 2단계로 확정): 베이스 슬롯엔 항상 "지금" 진행도를 보여준다.
	-- 결과 슬롯은 이번 합성으로 실제 등급이 오르는 경우엔 새 등급에서 0으로 리셋되니 뱃지를 안 보여주고,
	-- 안 오르는 경우(같은 등급 내 진행 중)엔 "이번 합성 이후" 진행도(현재+1) 미리보기를 보여준다
	property TextGUIRendererComponent CountText = "8bc4a8b1-21d5-4aaf-b18d-c6ce976b85d0"

	property TextGUIRendererComponent ResultCountText = "20e16cf9-5fdd-4531-9470-c03fece72f9c"

	property TextGUIRendererComponent GradeText = "ca03316c-a85a-4b69-8997-8345837aee8f"

	property TextGUIRendererComponent StatText = "c9cd33fb-5cba-46b9-b089-704dd21fc4e7"

	property TextGUIRendererComponent SkillText = "839c0657-31d9-4237-96fc-9242224df35c"

	property GridViewComponent Grid = "34a7947c-ccae-4f93-97a3-f2c4a0de7eda"

	property ButtonComponent ComposeButton = "a0d42036-263b-4541-a34b-e82eb6e86638"

	property ButtonComponent BtnClose = "334deb82-2aec-438b-8954-85dae52ec58f"

	property TextComponent CapacityText = "1d86768a-e487-468e-b897-e10b475cda0e"

	property Entity TabHolder = "f8ee4e33-b7fd-4a9e-b534-a4be279f5e56"

	-- 품질 손해 경고창(유저 지정, 2026-08-08 신규): 노말→매직(재료 2개) 조합에서 베이스가 셋 중 유일하게
	-- 제일 좋은 품질이면 그 값이 통째로 버려질 수 있어서, 합성 실행 전에 한 번 더 확인받는다
	property Entity RiskWarningPanel = "16acc0f6-1473-4d4f-a38a-e5436d2cbc19"

	property ButtonComponent RiskWarningCancelButton = "1b72de46-80b0-4776-b6fd-3aff41321fd3"

	property ButtonComponent RiskWarningConfirmButton = "ab416671-6a9e-453c-8dea-7566477478a4"

	property UIEquipPopup EquipPopup = nil

	property any BaseItemStruct = nil

	property any Material1Struct = nil

	property any Material2Struct = nil

	property Entity GridCellBaseEntity = nil

	property table CandidateItemStructs = {}

	-- 탭 필터링 — UIInventoryTabHolder와 동일한 InsertFunc 패턴(전량검색계속/찾으면중단/불일치)
	property integer InsertFunc_MatchAndKeepSearch = 1

	property integer InsertFunc_MatchAndStop = 2

	property integer InsertFunc_NotMatch = 3

	property table InsertFunctions = {}

	property integer TabEnum = 1

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self.BtnClose.Entity:ConnectEvent(ButtonClickEvent, function() self:Close() end)
		-- Panel의 다른 자식들(LeftColumn/RightPanel/ComposeButton/LeftPanel/RiskWarning)이 형제 순서상
		-- BtnClose보다 뒤에 있어서 클릭이 이쪽으로 새는 문제가 있었다(유저 리포트: X를 눌러도 안 닫힘) —
		-- BtnClose를 Panel 안에서 확정적으로 맨 앞(마지막 순서)으로 올린다
		_UILogic:SetSiblingIndex(self.BtnClose.Entity.UITransformComponent, 1000000)
		self.ComposeButton.Entity:ConnectEvent(ButtonClickEvent, function() self:OnComposeClicked() end)
		self.Material1.Entity:ConnectEvent(ButtonClickEvent, function() self:OnMaterialSlotClicked(1) end)
		self.Material2.Entity:ConnectEvent(ButtonClickEvent, function() self:OnMaterialSlotClicked(2) end)
		self.RiskWarningCancelButton.Entity:ConnectEvent(ButtonClickEvent, function() self.RiskWarningPanel.Enable = false end)
		self.RiskWarningConfirmButton.Entity:ConnectEvent(ButtonClickEvent, function() self:ConfirmRiskyCompose() end)

		-- 재료 후보 그리드 — 메인 인벤토리 그리드와 동일하게 UIItemSlot을 런타임 스폰해서 셀 템플릿으로 쓴다
		local originalGridCell = _SpawnService:SpawnByModelId(_EntryService:GetModelIdByName("UIItemSlot"), "ComposeGridCell", Vector3.zero, self.Entity)
		originalGridCell.Enable = false
		self.GridCellBaseEntity = originalGridCell

		self.Grid.ItemEntity = originalGridCell
		self.Grid.OnRefresh = function(index, entity) self:OnGridRefresh(index + 1, entity) end
		self.Grid.OnClear = function(index, entity) self:OnGridClear(entity) end

		self:SetupTabs()
	end

	-- 인벤토리와 동일한 All/Weapon/Armor/etc 4탭 — 재료 후보도 부위별로 필터링해서 보여준다(유저 지정)
	@ExecSpace("ClientOnly")
	method void SetupTabs()
		local tabNames = { "All", "Weapon", "Armor", "etc" }
		local children = self.TabHolder.Children
		for i, child in ipairs(children) do
			child.UIComposeTab:Initalize(self, i, tabNames[i])
		end

		local function IsAll(itemData)
			return self.InsertFunc_MatchAndKeepSearch
		end

		local function IsWeapon(itemData)
			local itemGearData = itemData:GetGearData()
			if itemGearData == nil then
				return self.InsertFunc_NotMatch
			end
			if _GearCategoryEnum:IsWeapon(itemGearData.GearCategory) then
				return self.InsertFunc_MatchAndStop
			end
			return self.InsertFunc_NotMatch
		end

		local function IsArmor(itemData)
			local itemGearData = itemData:GetGearData()
			if itemGearData == nil then
				return self.InsertFunc_NotMatch
			end
			if _GearCategoryEnum:IsArmor(itemGearData.GearCategory) then
				return self.InsertFunc_MatchAndStop
			end
			return self.InsertFunc_NotMatch
		end

		local function IsNotGear(itemData)
			if itemData:GetGearData() == nil then
				return self.InsertFunc_MatchAndStop
			end
			return self.InsertFunc_NotMatch
		end

		self.InsertFunctions = { IsAll, IsWeapon, IsArmor, IsNotGear }
	end

	@ExecSpace("ClientOnly")
	method void OnTabClicked(integer tabEnum)
		if self.TabEnum == tabEnum then
			return
		end

		local previousTab = self.TabHolder.Children[self.TabEnum]
		previousTab.UIComposeTab:OnDeselected()

		local currentTab = self.TabHolder.Children[tabEnum]
		currentTab.UIComposeTab:OnSelected()

		self.TabEnum = tabEnum
		self:RefreshCandidates()
	end

	@ExecSpace("ClientOnly")
	method boolean MatchesCurrentTab(any itemStruct)
		local itemData = itemStruct:GetItemData()
		local resultEnum = self.InsertFunctions[self.TabEnum](itemData)
		return resultEnum ~= self.InsertFunc_NotMatch
	end

	@ExecSpace("ClientOnly")
	method void Open(any itemStruct)
		---@type ItemStruct
		local baseItemStruct = itemStruct
		self.BaseItemStruct = baseItemStruct
		self.Material1Struct = nil
		self.Material2Struct = nil

		self.BaseSlotIcon.ImageRUID = baseItemStruct:GetDisplayRUID()
		self:SetQualityBadge(self.BaseQualityBg, self.BaseQualityText, baseItemStruct)

		self.Material1Icon.Entity.Enable = false
		self.Material2Icon.Entity.Enable = false
		self.Material2.Entity.Enable = self:RequiredMaterialCount() >= 2
		self:SetQualityBadge(self.Material1QualityBg, self.Material1QualityText, nil)
		self:SetQualityBadge(self.Material2QualityBg, self.Material2QualityText, nil)

		-- 이전 합성 연출이 X나 에러로 중간에 끊겼을 수도 있으니 안전하게 초기 상태로 리셋
		-- (재료 아이콘이 날아가다 만 스케일/좌표로 남아있던 실제 버그로 발견됨)
		self.ComposeButton.Entity.Enable = true
		self.RiskWarningPanel.Enable = false
		self.BaseSlotIcon.Entity.UITransformComponent.Scale = Vector3(1, 1, 1)
		self.BaseSlotIcon.Color = Color(1, 1, 1, 1)
		self.Material1Icon.Entity.UITransformComponent.Scale = Vector3(1, 1, 1)
		self.Material1Icon.Entity.UITransformComponent.anchoredPosition = Vector2(0, 0)
		self.Material2Icon.Entity.UITransformComponent.Scale = Vector3(1, 1, 1)
		self.Material2Icon.Entity.UITransformComponent.anchoredPosition = Vector2(0, 0)

		local playerInventory = _UserService.LocalPlayer.PkgPlayerInventory
		self.CapacityText.Text = string.format("%d / %d", _Util:TableLen(playerInventory.Items), playerInventory.InventoryCapacity)

		self:RefreshCandidates()
		self:UpdateResultPreview()

		self.Entity.Enable = true
		_UILogic:SetSiblingIndex(self.Entity.UITransformComponent, 1000000)
	end

	-- 합성 팝업은 장착 팝업에서 파고든 하위 화면이라, X로 그냥 나가든 합성에 성공하든 항상 인벤토리
	-- 그리드가 아니라 장착 팝업(아이템 정보창)으로 되돌아간다(유저 지정)
	@ExecSpace("ClientOnly")
	method void Close()
		---@type ItemStruct
		local baseItemStruct = self.BaseItemStruct
		self.BaseItemStruct = nil
		self.Entity.Enable = false

		if baseItemStruct ~= nil then
			local playerInventory = _UserService.LocalPlayer.PkgPlayerInventory
			local freshItemStruct = playerInventory.Items[baseItemStruct.GUID]
			if freshItemStruct ~= nil then
				self.EquipPopup:Open(true, freshItemStruct)
			end
		end
	end

	-- 선택된 재료 수가 이번 등급(즉시합성/진행형)에서 요구하는 수와 정확히 일치하는지 — 합성 버튼
	-- 활성화 조건(유저 지정: 재료 덜 골랐으면 눌러도 아무 일 안 나는 대신 아예 안 눌리게)
	@ExecSpace("ClientOnly")
	method boolean HasEnoughMaterials()
		local count = 0
		if self.Material1Struct ~= nil then count = count + 1 end
		if self.Material2Struct ~= nil then count = count + 1 end
		return count == self:RequiredMaterialCount()
	end

	-- 노말→레어만 "동일 아이템 2개(+베이스 1개=3개) 즉시 합성", 그 외(레어→에픽 이상)는 "동일등급+동일부위
	-- 아이템 1개씩 3회 반복 합성" — GearGradeEnum.IsInstantComposeTier가 이 두 재료 수를 가르는 단일 기준점.
	-- 등급축/품질축이 매번 함께 처리되므로(유저 강한 정정) 재료 품질은 개수에 영향을 주지 않는다
	@ExecSpace("ClientOnly")
	method integer RequiredMaterialCount()
		---@type ItemStruct
		local baseItemStruct = self.BaseItemStruct
		if baseItemStruct == nil then
			return 0
		end

		local gearStruct = baseItemStruct:GetGearStruct()
		if gearStruct == nil then
			return 0
		end

		if _GearGradeEnum:IsInstantComposeTier(gearStruct.Grade) then
			return 2
		end

		return 1
	end

	-- 서버(PkgPlayerInventory.CanComposeItem)와 동일한 판정 로직 — 그리드 유효 하이라이트/선택 차단에 재사용
	@ExecSpace("ClientOnly")
	method boolean IsValidMaterial(any candidateStruct)
		---@type ItemStruct
		local baseItemStruct = self.BaseItemStruct
		---@type ItemStruct
		local candidate = candidateStruct
		if baseItemStruct == nil or candidate == nil then
			return false
		end

		if candidate.GUID == baseItemStruct.GUID then
			return false
		end

		if candidate:IsAttached() then
			return false
		end

		local baseGearStruct = baseItemStruct:GetGearStruct()
		local candidateGearStruct = candidate:GetGearStruct()
		if baseGearStruct == nil or candidateGearStruct == nil then
			return false
		end

		if candidateGearStruct.Grade ~= baseGearStruct.Grade then
			return false
		end

		-- 재료 자체가 이미 진행도(ComposeCount>0)를 갖고 있으면 재료로 못 쓴다(유저 지정, 서버 CanComposeItem과 동일 규칙)
		if candidateGearStruct.ComposeCount ~= 0 then
			return false
		end

		-- 등급축/품질축이 매번 함께 처리되므로(유저 강한 정정) 재료 품질은 서로 달라도 무방하다 —
		-- 목표 품질(베이스+재료들 중 최고)은 서버 ComposeItem이 알아서 계산한다

		if _GearGradeEnum:IsInstantComposeTier(baseGearStruct.Grade) then
			return candidate.ItemId == baseItemStruct.ItemId
		end

		local baseGearData = baseItemStruct:GetGearData()
		local candidateGearData = candidate:GetGearData()
		if baseGearData == nil or candidateGearData == nil then
			return false
		end

		return candidateGearData.GearCategory == baseGearData.GearCategory
	end

	@ExecSpace("ClientOnly")
	method void RefreshCandidates()
		-- 선택된 재료도 목록에서 안 지우고 그대로 남겨둔다 — 대신 OnGridRefresh에서 어둡게+체크마크로
		-- 표시해서 "이게 선택됐다"를 그리드 안에서 바로 보여주고, 다시 누르면 선택 해제되게 한다(유저 지정)
		local playerInventory = _UserService.LocalPlayer.PkgPlayerInventory
		local list = {}
		for guid, itemStruct in pairs(playerInventory.Items) do
			if not self:MatchesCurrentTab(itemStruct) then
				continue
			end
			table.insert(list, itemStruct)
		end

		-- 높은 등급 순으로, 같은 등급이면 같은 종류(ItemId)끼리 묶어서 정렬(유저 지정)
		-- 유저 지정: 등급 높은 순 → (같은 등급이면) 품질 높은 순 → ItemId(최종 동률 안정용)
		table.sort(list, function(a, b)
			local gearA = a:GetGearStruct()
			local gearB = b:GetGearStruct()
			local gradeA = gearA ~= nil and gearA.Grade or -1
			local gradeB = gearB ~= nil and gearB.Grade or -1
			if gradeA ~= gradeB then
				return gradeA > gradeB
			end
			local qualityA = gearA ~= nil and gearA.Quality or -1
			local qualityB = gearB ~= nil and gearB.Quality or -1
			if qualityA ~= qualityB then
				return qualityA > qualityB
			end
			return a.ItemId < b.ItemId
		end)

		self.CandidateItemStructs = list
		self.Grid.TotalCount = #list
		self.Grid:Refresh(true, true)
	end

	@ExecSpace("ClientOnly")
	method void OnGridRefresh(integer index, Entity entity)
		local itemStruct = self.CandidateItemStructs[index]
		entity.UIItemSlot:Set(itemStruct)

		-- 단순화된 표시 규칙(유저 지정): 유효+미선택 = 등급색 테두리만(딤 없음),
		-- 재료로 못 쓰는 아이템 = 딤 처리, 선택된 아이템 = 체크마크 + 더 어두운 딤. 초록 "재료가능" 테두리는 제거.
		local isSelected = self:IsSelectedMaterial(itemStruct)
		local isValid = self:IsValidMaterial(itemStruct)

		entity.UIItemSlot.SelectedCheckText.Enable = isSelected
		entity.UIItemSlot.ImageDim.Enable = isSelected or not isValid

		entity.UIItemSlot.OnItemClickedFunc = function() self:OnCandidateClicked(itemStruct) end
	end

	@ExecSpace("ClientOnly")
	method void OnGridClear(Entity entity)
		entity.UIItemSlot:Clear()
	end

	@ExecSpace("ClientOnly")
	method boolean IsSelectedMaterial(any itemStruct)
		---@type ItemStruct
		local candidate = itemStruct
		if self.Material1Struct ~= nil and self.Material1Struct.GUID == candidate.GUID then
			return true
		end
		if self.Material2Struct ~= nil and self.Material2Struct.GUID == candidate.GUID then
			return true
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method void OnCandidateClicked(any itemStruct)
		---@type ItemStruct
		local candidate = itemStruct

		-- 이미 선택된 아이템을 다시 누르면 선택 해제(토글) — 왼쪽 재료 슬롯을 따로 안 눌러도 됨
		if self.Material1Struct ~= nil and self.Material1Struct.GUID == candidate.GUID then
			self.Material1Struct = nil
			self:RefreshMaterialSlots()
			self:RefreshCandidates()
			self:UpdateResultPreview()
			return
		end
		if self.Material2Struct ~= nil and self.Material2Struct.GUID == candidate.GUID then
			self.Material2Struct = nil
			self:RefreshMaterialSlots()
			self:RefreshCandidates()
			self:UpdateResultPreview()
			return
		end

		if not self:IsValidMaterial(candidate) then
			return
		end

		if self.Material1Struct == nil then
			self.Material1Struct = candidate
		elseif self.Material2Struct == nil and self:RequiredMaterialCount() >= 2 then
			self.Material2Struct = candidate
		else
			return
		end

		self:RefreshMaterialSlots()
		self:RefreshCandidates()
		self:UpdateResultPreview()
	end

	@ExecSpace("ClientOnly")
	method void OnMaterialSlotClicked(integer slotIndex)
		if slotIndex == 1 then
			self.Material1Struct = nil
		else
			self.Material2Struct = nil
		end

		self:RefreshMaterialSlots()
		self:RefreshCandidates()
		self:UpdateResultPreview()
	end

	@ExecSpace("ClientOnly")
	method void RefreshMaterialSlots()
		---@type ItemStruct
		local m1 = self.Material1Struct
		if m1 ~= nil then
			self.Material1Icon.ImageRUID = m1:GetDisplayRUID()
			self.Material1Icon.Entity.Enable = true
			self:ApplyGradeBorder(self.Material1Frame, m1)
		else
			self.Material1Icon.Entity.Enable = false
		end
		self:SetQualityBadge(self.Material1QualityBg, self.Material1QualityText, m1)

		---@type ItemStruct
		local m2 = self.Material2Struct
		if m2 ~= nil then
			self.Material2Icon.ImageRUID = m2:GetDisplayRUID()
			self.Material2Icon.Entity.Enable = true
			self:ApplyGradeBorder(self.Material2Frame, m2)
		else
			self.Material2Icon.Entity.Enable = false
		end
		self:SetQualityBadge(self.Material2QualityBg, self.Material2QualityText, m2)

		-- 필요 재료 수(즉시합성=2/진행형=1)에 따라 2번 슬롯 표시 여부만 결정 — 품질축은 매번 등급축과
		-- 함께 처리되므로 재료 수에 영향을 주지 않는다
		self.Material2.Entity.Enable = self:RequiredMaterialCount() >= 2
	end

	-- 베이스/재료 슬롯 품질 배지(유저 지정: 인벤토리 슬롯/장비 정보 팝업과 동일하게 베이스·재료에도
	-- 품질 표시 필요) — itemStruct가 nil이면(재료 미선택) 배지 자체를 숨긴다
	@ExecSpace("ClientOnly")
	method void SetQualityBadge(SpriteGUIRendererComponent bg, TextGUIRendererComponent text, any itemStruct)
		if itemStruct == nil then
			-- 버그: bg만 끄고 text는 안 꺼서 재료 미선택 상태에서 배경 없이 글자만 떠있던 문제(유저 지적) —
			-- bg/text는 부모-자식이 아니라 형제 엔티티라 bg.Entity.Enable로는 text가 안 꺼진다
			bg.Entity.Enable = false
			text.Entity.Enable = false
			return
		end

		---@type ItemStruct
		local struct = itemStruct
		if struct:GetGearData() == nil then
			bg.Entity.Enable = false
			text.Entity.Enable = false
			return
		end

		bg.Entity.Enable = true
		text.Entity.Enable = true
		if _WeaponTierDataLogic:IsWeaponItem(struct.ItemId) then
			text.Text = _QualityEnum:GetKoreanName(struct:GetGearStruct().Quality)
		else
			text.Text = "A"
		end
	end

	-- 베이스/재료 슬롯 아이콘에 인벤토리 그리드와 동일한 등급색 테두리를 적용(유저 지정)
	@ExecSpace("ClientOnly")
	method void ApplyGradeBorder(SpriteGUIRendererComponent icon, any itemStruct)
		---@type ItemStruct
		local struct = itemStruct
		local gearStruct = struct:GetGearStruct()
		if gearStruct == nil then
			icon.Outline = false
			return
		end

		self:ApplyGradeBorderByGrade(icon, gearStruct.Grade)
	end

	@ExecSpace("ClientOnly")
	method void ApplyGradeBorderByGrade(SpriteGUIRendererComponent icon, integer gradeEnum)
		icon.Outline = true
		icon.OutlineWidth = 4
		icon.OutlineColor = _GearGradeEnum:GetEnumColor(gradeEnum)
	end

	-- 실제 스탯 카탈로그가 아직 없어서(다른 팝업들과 동일 정책) 등급 기반 임시 공식으로 전/후 미리보기만 보여준다
	@ExecSpace("ClientOnly")
	method void UpdateResultPreview()
		---@type ItemStruct
		local baseItemStruct = self.BaseItemStruct
		if baseItemStruct == nil then
			return
		end

		local isWeapon = _WeaponTierDataLogic:IsWeaponItem(baseItemStruct.ItemId)
		local gearStruct = baseItemStruct:GetGearStruct()
		local grade = gearStruct.Grade
		local nextGrade = _GearGradeEnum:GetNextGrade(grade)

		if isWeapon then
			self.ResultSlotIcon.ImageRUID = _WeaponTierDataLogic:GetDisplayRUID(baseItemStruct.ItemId, grade)
		else
			self.ResultSlotIcon.ImageRUID = baseItemStruct:GetItemData().RUID
		end

		self:ApplyGradeBorder(self.BaseSlotFrame, baseItemStruct)

		-- 베이스 슬롯의 합성 진행도 뱃지: 인벤토리 그리드/장착 팝업과 동일 규칙(다음 등급이 있고
		-- ComposeCount>0일 때만 표시) — 결과 미리보기와 무관하게 "지금" 상태만 그대로 보여준다
		if nextGrade ~= -1 and gearStruct.ComposeCount > 0 then
			self.CountText.Text = tostring(gearStruct.ComposeCount)
			self.CountText.Entity.Parent.Enable = true
		else
			self.CountText.Entity.Parent.Enable = false
		end

		-- 품질 축(2026-08-08 전면 교체, gap 기반): 베이스+재료 품질값 중 가장 높은 값은 버려지고,
		-- 남은 값들 중 낮은 값(low)과 두 번째로 낮은 값(higher)의 차이(gap)로 승급 확률이 정해진다
		local previewQualities = self:GetPreviewQualities(gearStruct)
		local previewHigher = _QualityEnum:GetPromoteHigherQuality(previewQualities)
		local previewGap = _QualityEnum:GetPromoteGap(previewQualities)
		local previewPromoteRate = _QualityEnum:GetGapPromoteRate(previewHigher, previewGap)
		local previewPromoteQuality = previewHigher + 1
		if previewPromoteQuality > _QualityEnum.S then
			previewPromoteQuality = _QualityEnum.S
		end

		if nextGrade == -1 then
			self.ResultCountText.Entity.Parent.Enable = false
			self:ApplyGradeBorderByGrade(self.ResultSlotFrame, grade)
			self.GradeText.Text = _GearGradeEnum:GetKoreanName(grade) .. " (최고 등급)"
			self.StatText.Text = ""
			self.SkillText.Enable = false
			self.ComposeButton.Enable = false
			return
		end

		self.ComposeButton.Enable = self:HasEnoughMaterials()
		self.GradeText.Text = _GearGradeEnum:GetKoreanName(grade) .. " → " .. _GearGradeEnum:GetKoreanName(nextGrade)

		if isWeapon then
			local nameChangeText = _WeaponTierDataLogic:GetDisplayName(baseItemStruct.ItemId, grade) .. " → " .. _WeaponTierDataLogic:GetDisplayName(baseItemStruct.ItemId, nextGrade)
			-- 등급축과 품질축이 매번 함께 처리된다(유저 강한 정정) — gap 기반 유지/승급 확률을 같이 보여준다
			if previewHigher >= _QualityEnum.S then
				self.StatText.Text = nameChangeText .. " (품질 S 유지)"
			else
				self.StatText.Text = nameChangeText .. string.format(" (품질 %s 유지 %d%% / %s 승급 %d%%)",
					_QualityEnum:GetKoreanName(previewHigher), 100 - previewPromoteRate,
					_QualityEnum:GetKoreanName(previewPromoteQuality), previewPromoteRate)
			end
		else
			local placeholderHpBefore = 10 + grade * 10
			local placeholderHpAfter = 10 + nextGrade * 10
			self.StatText.Text = string.format("HP %d → %d", placeholderHpBefore, placeholderHpAfter)
		end

		-- 결과 슬롯 테두리는 이번 합성으로 실제 등급이 오르는 경우에만 "완성 후" 등급색을 미리 보여준다
		-- (에픽 이상 진행형은 3번째 합성 때만 실제로 등급이 오르므로, 그 전까진 현재 등급색 유지)
		local isInstant = _GearGradeEnum:IsInstantComposeTier(grade)
		local willGradeUp = isInstant or (gearStruct.ComposeCount + 1 >= 3)
		self:ApplyGradeBorderByGrade(self.ResultSlotFrame, willGradeUp and nextGrade or grade)
		if isWeapon then
			local displayGrade = grade
			if willGradeUp then
				displayGrade = nextGrade
			end
			self.ResultSlotIcon.ImageRUID = _WeaponTierDataLogic:GetDisplayRUID(baseItemStruct.ItemId, displayGrade)
		end
		self.SkillText.Enable = willGradeUp

		-- 결과 슬롯 진행도 뱃지: 이번 합성으로 등급이 오르면 새 등급에서 0부터 시작하니 뱃지 없음,
		-- 안 오르면 "이번 합성 이후" 진행도(현재+1) 미리보기를 보여준다
		if willGradeUp then
			self.ResultCountText.Entity.Parent.Enable = false
		else
			self.ResultCountText.Text = tostring(gearStruct.ComposeCount + 1)
			self.ResultCountText.Entity.Parent.Enable = true
		end
	end

	@ExecSpace("ClientOnly")
	method void OnComposeClicked()
		---@type ItemStruct
		local baseItemStruct = self.BaseItemStruct
		if baseItemStruct == nil then
			return
		end

		local requiredCount = self:RequiredMaterialCount()
		local materialGUIDs = {}
		if self.Material1Struct ~= nil then
			table.insert(materialGUIDs, self.Material1Struct.GUID)
		end
		if self.Material2Struct ~= nil then
			table.insert(materialGUIDs, self.Material2Struct.GUID)
		end

		if #materialGUIDs ~= requiredCount then
			return
		end

		-- 품질 손해 위험 조합(유저 지정): 베이스가 셋 중 유일하게 제일 좋은 품질이면 그 값이 계산에서
		-- 통째로 버려질 수 있다 — 실행 전에 한 번 더 확인받는다
		if self:IsRiskyCombination(baseItemStruct) then
			self.RiskWarningPanel.Enable = true
			return
		end

		self:ExecuteCompose(materialGUIDs)
	end

	-- 유저 강한 정정: 베이스가 손해보는 경우만 잡던 예전 판정은 비대칭이었음(베이스=S+재료F,F는 걸리는데
	-- 베이스=F+재료S,F는 안 걸림 — 둘 다 품질값 집합이 {S,F,F}로 동일해서 기댓값도 완전히 같은데도).
	-- 지금은 역할(베이스/재료) 상관없이 "입력 중 가장 높은 값이 계산에서 통째로 버려지는가"만 본다
	@ExecSpace("ClientOnly")
	method boolean IsRiskyCombination(any baseItemStruct)
		local gearStruct = baseItemStruct:GetGearStruct()
		if gearStruct == nil then
			return false
		end
		local qualities = self:GetPreviewQualities(gearStruct)
		local higher = _QualityEnum:GetPromoteHigherQuality(qualities)
		local discarded = _QualityEnum:GetPromoteDiscardedQuality(qualities)
		return discarded > higher
	end

	-- 경고창의 "그래도 합성" 버튼
	@ExecSpace("ClientOnly")
	method void ConfirmRiskyCompose()
		self.RiskWarningPanel.Enable = false

		---@type ItemStruct
		local baseItemStruct = self.BaseItemStruct
		if baseItemStruct == nil then
			return
		end

		local materialGUIDs = {}
		if self.Material1Struct ~= nil then
			table.insert(materialGUIDs, self.Material1Struct.GUID)
		end
		if self.Material2Struct ~= nil then
			table.insert(materialGUIDs, self.Material2Struct.GUID)
		end

		self:ExecuteCompose(materialGUIDs)
	end

	@ExecSpace("ClientOnly")
	method void ExecuteCompose(table materialGUIDs)
		---@type ItemStruct
		local baseItemStruct = self.BaseItemStruct
		if baseItemStruct == nil then
			return
		end

		self.ComposeButton.Enable = false
		self:PlayComposeEffect(function()
			_UserService.LocalPlayer.PkgPlayerInventory:RequestComposeItem(baseItemStruct.GUID, materialGUIDs)
		end)
	end

	-- 이번 합성에 들어가는 품질값들(베이스 + 선택된 재료) — 서버 ComposeItem의 계산과 동일한 규칙
	@ExecSpace("ClientOnly")
	method table GetPreviewQualities(any gearStruct)
		local qualities = { gearStruct.Quality }
		---@type ItemStruct
		local m1 = self.Material1Struct
		if m1 ~= nil then
			local m1GearStruct = m1:GetGearStruct()
			if m1GearStruct ~= nil then
				table.insert(qualities, m1GearStruct.Quality)
			end
		end
		---@type ItemStruct
		local m2 = self.Material2Struct
		if m2 ~= nil then
			local m2GearStruct = m2:GetGearStruct()
			if m2GearStruct ~= nil then
				table.insert(qualities, m2GearStruct.Quality)
			end
		end
		return qualities
	end

	-- 합성 연출(유저 지정, 포션→HP바 연출과 동일 패턴 재사용): 베이스가 은은하게 커졌다 작아지며 차지되는
	-- 동안 선택된 재료 "아이콘만"(슬롯 전체 아님) 스케일이 점점 작아지면서 베이스로 날아간다. 슬롯 하나가
	-- 도착할 때마다 베이스가 탁 펀치되며 흰색 플래시가 튀고, 재료가 2개면 순차적으로(동시 아님) 탁~탁~ 두 번.
	-- 서버 응답이 애니메이션 도중 먼저 도착해서 팝업이 잘리는 걸 막으려고, 실제 RequestComposeItem 호출은
	-- 연출이 다 끝난 뒤(onDone)에 보낸다.
	-- 원래 Charge/Firework 파티클(UIBasicParticleComponent)로 만들었는데, Enable/EnabledInHierarchy/
	-- IsEmitting 전부 정상인데도 화면에 전혀 안 그려지는 원인불명 렌더링 문제가 있어서(이 세션에서 반복
	-- 확인된 패턴), 이미 검증된 스케일+색상 트윈 방식(PunchHpBar와 동일 패턴)으로 대체했다
	@ExecSpace("ClientOnly")
	method void PlayComposeEffect(any onDone)
		_TweenLogic:ScaleTo(self.BaseSlotIcon.Entity, Vector2(1.08, 1.08), 0.25, EaseType.SineEaseInOut)

		local materials = {}
		table.insert(materials, { icon = self.Material1Icon, slot = self.Material1.Entity })
		if self.Material2Struct ~= nil then
			table.insert(materials, { icon = self.Material2Icon, slot = self.Material2.Entity })
		end

		self:FlyMaterialSequential(materials, 1, onDone)
	end

	@ExecSpace("ClientOnly")
	method void FlyMaterialSequential(table materials, integer index, any onDone)
		if index > #materials then
			_TweenLogic:ScaleTo(self.BaseSlotIcon.Entity, Vector2(1, 1), 0.15, EaseType.QuadEaseOut)
			self.ComposeButton.Enable = self:HasEnoughMaterials()
			if onDone ~= nil then
				onDone()
			end
			return
		end

		local flyDuration = 0.28
		---@type SpriteGUIRendererComponent
		local icon = materials[index].icon
		---@type Entity
		local slot = materials[index].slot
		local iconTransform = icon.Entity.UITransformComponent
		local startPos = iconTransform.anchoredPosition

		-- Icon은 자기 슬롯(Material1/Material2) 기준 로컬 좌표라, 베이스 슬롯의 화면 위치로 보내려면
		-- "슬롯 대 슬롯" 오프셋(같은 부모 LeftColumn 기준)을 Icon의 로컬 좌표로 변환해서 써야 한다
		local slotPos = slot.UITransformComponent.anchoredPosition
		local baseSlotPos = self.BaseSlotIcon.Entity.Parent.UITransformComponent.anchoredPosition
		local endPos = Vector2(startPos.x + (baseSlotPos.x - slotPos.x), startPos.y + (baseSlotPos.y - slotPos.y))

		local tween = _TweenLogic:PlayTween(0.0, 1.0, flyDuration, EaseType.QuadEaseIn, function(t)
			local x = startPos.x + (endPos.x - startPos.x) * t
			local y = startPos.y + (endPos.y - startPos.y) * t
			iconTransform.anchoredPosition = Vector2(x, y)
			local scale = 1.0 - 0.5 * t
			iconTransform.Scale = Vector3(scale, scale, 1)
		end)

		-- 별도 타이머(같은 duration)로 리셋을 걸었더니 트윈의 "마지막 프레임 갱신"이 타이머 콜백보다
		-- 늦게 실행돼서 리셋이 덮어써지는 경쟁 상태가 실측으로 확인됨(재료가 도착 좌표에 눌어붙음) —
		-- 트윈 자기 자신의 완료 콜백을 써서 반드시 트윈의 마지막 갱신 "다음"에 리셋이 실행되게 한다
		tween:SetOnEndCallback(function()
			icon.Entity.Enable = false
			iconTransform.Scale = Vector3(1, 1, 1)
			iconTransform.anchoredPosition = startPos

			self:PlayFireworkPop()
			self:FlyMaterialSequential(materials, index + 1, onDone)
		end)
	end

	-- 재료 도착 "탁" 연출: 베이스를 짧게 펀치(확대→축소)하고 흰색으로 살짝 플래시했다가 원래 색으로 되돌린다
	@ExecSpace("ClientOnly")
	method void PlayFireworkPop()
		_TweenLogic:ScaleTo(self.BaseSlotIcon.Entity, Vector2(1.18, 1.18), 0.08, EaseType.BackEaseOut)
		_TimerService:SetTimerOnce(function()
			_TweenLogic:ScaleTo(self.BaseSlotIcon.Entity, Vector2(1.08, 1.08), 0.12, EaseType.QuadEaseOut)
		end, 0.08)

		local originalColor = self.BaseSlotIcon.Color
		self.BaseSlotIcon.Color = Color(2, 2, 2, 1)
		_TweenLogic:PlayTween(0.0, 1.0, 0.2, EaseType.QuadEaseIn, function(t)
			self.BaseSlotIcon.Color = Color(
				2 - (2 - originalColor.r) * t,
				2 - (2 - originalColor.g) * t,
				2 - (2 - originalColor.b) * t,
				1
			)
		end)
	end

	@ExecSpace("ClientOnly")
	@EventSender("LocalPlayer")
	handler HandleInvenItemModifiedEvent(InvenItemModifiedEvent event)
		-- Parameters
		local GUIDs = event.GUIDs
		---------------------------------------------------------

		if self.Entity.Enable == false then
			return
		end

		---@type ItemStruct
		local baseItemStruct = self.BaseItemStruct
		if baseItemStruct == nil then
			return
		end

		for i, guid in ipairs(GUIDs) do
			if guid == baseItemStruct.GUID then
				-- 합성 성공: 토스트만 띄우고 팝업은 안 닫고 그대로 머문다(유저 지정) — 최신 아이템 struct로
				-- 다시 Open()해서 등급/스탯/테두리/재료 슬롯을 갱신, 이어서 바로 다음 합성을 계속할 수 있다
				_UIToast:ShowMessage("합성 성공!")

				local playerInventory = _UserService.LocalPlayer.PkgPlayerInventory
				local freshItemStruct = playerInventory.Items[baseItemStruct.GUID]
				if freshItemStruct ~= nil then
					self:Open(freshItemStruct)
				end
				return
			end
		end
	end

end
