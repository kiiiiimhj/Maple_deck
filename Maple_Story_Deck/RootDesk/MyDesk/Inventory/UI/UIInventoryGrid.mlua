@Component
script UIInventoryGrid extends Component

	property GridViewComponent GridView = nil

	property Entity GridCellBaseEntity = nil

	property UIInventory Inventory = nil

	property table SortedItemStructs = {}

	-- 마지막으로 그린 목록의 GUID 순서(목록 구성이 바뀌었는지 판정용 — Update 참고)
	property table _shownGUIDs = {}

	property UIEquipPopup EquipPopup = nil

	property UIUsePopup UsePopup = nil

	-- 판매 모드에서 선택된 슬롯에 찍히는 체크마크("V") 색. 딤이 깔린 위에서도 잘 보이는 밝은 연두
	property Color SellCheckColor = Color(0.42, 1, 0.51, 1)

	-- 목록 맨 끝에 붙는 확장("+") 슬롯의 인덱스. 0이면 이번 탭엔 확장 슬롯이 없다(All 탭)
	property integer PlusSlotIndex = 0

	-- 확장 칸에 그릴 "+" 아이콘(유저 지정 이미지, 초록 원형 플러스). 아이템 아이콘 자리(IconItem)에 얹는다
	-- 2026-09-16: 로비 다이아 배지의 (+) 버튼과 같은 이미지로 통일(유저 지정)
	property string PlusSlotRUID = "861ec5c06c5c477c8aa10c79f040dcec"

	-- "+" 아이콘 크기/위치(유저 지정 2026-09-10): 아이템 아이콘(80x80)보다 60% 작은 32x32에서
	-- 다시 20% 키워 38.4x38.4. 위치는 슬롯(115x115) 정중앙 —
	-- 아이템 아이콘은 원래 중앙보다 8px 아래에 놓여 있다
	property Vector2 PlusIconSize = Vector2(38.4, 38.4)

	property Vector2 PlusIconPos = Vector2(0, 0)

	-- 아이템을 그릴 때 되돌려야 하는 IconItem 원래 값(UIItemSlot.model 기본값 실측).
	-- GridView가 셀을 재활용하므로 "+" 칸이었던 셀에 아이템이 들어오면 크기/위치가 그대로 남는다 —
	-- QualityBg를 주문서 심볼로 재활용할 때와 같은 이유로 매번 복구한다
	property Vector2 ItemIconSize = Vector2(80, 80)

	property Vector2 ItemIconPos = Vector2(0, -8)

	-- 장비가 아닌 아이템(강화 주문서 등)을 누르면 그 칸 위에 말풍선으로 이름을 잠깐 띄운다(유저 지정 2026-09-19).
	-- 말풍선은 EquipmentGroup.ui의 Inventory/Panel/ItemNameTooltip(유저 리소스 823c09…)
	property Entity itemNameTooltip = "783b6c15-db07-4702-886d-48d75fd308b1"

	property TextGUIRendererComponent itemNameTooltipText = "0d0aa8a2-f34d-4dda-804c-a9dbf5b31ced"

	property number ItemNameTooltipDuration = 1.5

	-- 칸 중심에서 말풍선 중심까지 위로 띄우는 거리(칸 반높이 56 + 말풍선 반높이 + 여유)
	property number ItemNameTooltipOffsetY = 100

	-- 말풍선 꼬리(왼쪽 아래)가 칸 중앙을 가리키도록 오른쪽으로 미는 거리
	property number ItemNameTooltipOffsetX = 80

	property integer _tooltipTimerId = 0

	@ExecSpace("ClientOnly")
	method void OnInitialize()
		self.GridView = self.Entity.GridViewComponent
		self.GridView.OnRefresh = function(index, entity) self:OnRefresh(index + 1, entity) end
		self.GridView.OnClear = function(index, entity) self:OnClear(entity) end
	end

	@ExecSpace("ClientOnly")
	method void SetGridViewItem(Entity baseEntity)
		-- TotalCount는 여기서 고정하지 않는다 — 탭마다 정원이 다르고 보유 수도 계속 바뀌므로
		-- 매 Update()에서 다시 계산한다(아래 주석 참고)
		self.GridCellBaseEntity = baseEntity
		self.GridView.ItemEntity = baseEntity
	end

	-- resetPos: 탭 전환/최초 오픈처럼 목록 자체가 바뀌는 경우에만 true. 장착/해제처럼 같은 탭 안에서
	-- 상태만 바뀌는 경우 false — 스크롤 위치를 유지한다.
	-- force를 완전히 빼봤더니(이전 버전) 장착/해제 플리커는 없어졌지만, 탭 전환 시 내부 데이터
	-- (SortedItemStructs)는 정확히 필터링되는데도 그리드 화면은 이전 탭 내용 그대로 남는 새 버그가
	-- 생겼다(유저 실측 확인 — Weapon 탭 눌러도 9개 그대로 보임, 그런데 SortedItemStructs count는
	-- 정확히 2). 즉 force=false만으로는 목록이 실제로 바뀌는 경우(resetPos=true) 화면 갱신이
	-- 보장되지 않는다. resetPos와 force를 다시 묶어서, 목록 자체가 바뀌는 경우만 force로 완전히
	-- 다시 그리고 상태만 바뀌는 장착/해제는 force 없이(플리커 방지) 처리한다.
	@ExecSpace("ClientOnly")
	method void Update(table itemStructs, boolean resetPos)
		table.sort(itemStructs, _InventorySortEnum:GetSortFunc(self.Inventory.SortEnum))
		-- 목록 구성(개수/순서)이 바뀌었는지 — 바뀌었으면 스크롤은 유지한 채 셀을 전부 다시 그린다(force).
		-- ⚠ 2026-09-20 유저 리포트: 합성 재료로 소모된 장비가 그리드 칸에 그대로 남아(이미 그려진 셀은
		-- force 없이는 OnRefresh를 안 탄다), 그 칸을 눌러 합성하면 없는 아이템이라 "아이템을 찾을 수 없어요"가 떴다.
		-- 실측: 합성 3번 뒤 보이는 30칸 중 6칸이 이미 지워진 아이템. 장착/해제처럼 목록이 그대로인 갱신은
		-- 예전처럼 force 없이(플리커 방지) 처리한다
		-- ⚠ 비교 대상은 SortedItemStructs가 아니라 따로 떠 둔 GUID 목록이다 — UIInventoryTabHolder가 같은 테이블을
		-- 비우고 다시 채워서 넘기므로(CacheItemsByEnum) SortedItemStructs와 itemStructs는 늘 같은 객체다(실측)
		local listChanged = #itemStructs ~= #self._shownGUIDs
		if not listChanged then
			for i, st in ipairs(itemStructs) do
				if self._shownGUIDs[i] ~= st.GUID then
					listChanged = true
					break
				end
			end
		end
		local guids = {}
		for i, st in ipairs(itemStructs) do guids[i] = st.GUID end
		self._shownGUIDs = guids
		self.SortedItemStructs = itemStructs
		-- 목록이 바뀌면 떠 있던 이름 말풍선이 엉뚱한 칸을 가리키므로 닫는다
		if resetPos then self:HideItemNameTooltip() end

		-- ⚠ 예전엔 TotalCount를 SetGridViewItem에서 InventoryCapacity(100)로 딱 한 번만 박아뒀다.
		-- 그래서 (1) 탭별 정원이 달라져도 항상 100칸만 그렸고 (2) 보유 아이템이 정원을 넘으면
		-- 넘친 만큼이 **아예 안 보였다**(유저 리포트: "All에 150개인데 100개만 보임").
		-- 이제 "그 탭 정원"과 "실제 보유 수" 중 큰 쪽으로 잡아서, 정원을 넘겨 들고 있어도 전부 보인다.
		local tabEnum = self.Inventory:GetCurrentTabEnum()
		local capacity = _InventoryExpandLogic:GetCapacity(tabEnum)
		local shown = math.max(capacity, #itemStructs)

		-- 확장 가능한 탭(무기/방어구/기타)이면 맨 끝에 "+" 칸을 한 칸 더 붙인다
		if _InventoryExpandLogic:IsExpandableTab(tabEnum) then
			self.PlusSlotIndex = shown + 1
			shown = shown + 1
		else
			self.PlusSlotIndex = 0
		end

		self.GridView.TotalCount = shown
		self.GridView:Refresh(resetPos, resetPos or listChanged)
		if listChanged and not resetPos then
			log("UIInventoryGrid: list changed (" .. tostring(#itemStructs) .. " items), cells redrawn")
		end
		-- 장착/해제처럼 force 없이 갱신될 때는 이미 그려진 셀이 OnRefresh를 안 타므로 장착 표시만 따로 맞춘다
		self:RefreshEquippedMarks()
	end

	-- 목록 구성(개수/정렬)은 그대로인데 특정 아이템의 표시 내용만 바뀐 경우(합성으로 등급이 올라
	-- 이름·아이콘·테두리색이 바뀐 경우) 전용 — 그 셀 하나만 다시 그린다.
	-- 전체 Refresh(force=true)를 쓰면 화면이 한 번 깜빡이고(플리커), force=false를 쓰면 이미 그려진
	-- 셀은 갱신을 건너뛰어서 아이콘이 옛 등급 그대로 남는다(유저 리포트: "케이그로 업글했는데 슬롯
	-- 이미지가 안 바뀌고 착용해야 바뀜"). RefreshIndex는 둘 다 피한다.
	@ExecSpace("ClientOnly")
	method void RefreshItemByGUID(string guid)
		for i, itemStruct in ipairs(self.SortedItemStructs) do
			if itemStruct.GUID == guid then
				-- OnRefresh가 index+1로 보정해 받으므로 여기서는 0-based로 되돌려 넘긴다
				self.GridView:RefreshIndex(i - 1)
				return
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnRefresh(integer index, Entity entity)
		local slot = entity.UIItemSlot
		entity.UIInventoryGridCell.GridIndex = index

		-- 맨 끝 "+" 칸 — 아이템이 아니라 확장 버튼이다
		if self.PlusSlotIndex > 0 and index == self.PlusSlotIndex then
			entity.UIInventoryGridCell.IsPlusSlot = true
			slot:Clear()
			-- Clear()가 버튼을 꺼버리므로 다시 켠다(빈 칸은 못 누르지만 이 칸은 눌려야 한다)
			entity.ButtonComponent.Enable = true
			-- 아이템 아이콘 자리에 "+" 스프라이트를 얹는다. 셀이 재활용돼 아이템이 들어올 때는
			-- UIItemSlot.Set()이 ImageRUID를 그 아이템 것으로 덮어쓰므로 따로 되돌릴 필요가 없다
			slot.IconItem.ImageRUID = DataRef(self.PlusSlotRUID)
			slot.IconItem.Enable = true

			local plusTr = slot.IconItem.Entity.UITransformComponent
			plusTr.RectSize = self.PlusIconSize
			plusTr.anchoredPosition = self.PlusIconPos
			return
		end

		entity.UIInventoryGridCell.IsPlusSlot = false

		-- 이 셀이 직전에 "+" 칸이었을 수 있으므로 아이콘 크기/위치를 아이템 기준으로 되돌린다
		local iconTr = slot.IconItem.Entity.UITransformComponent
		iconTr.RectSize = self.ItemIconSize
		iconTr.anchoredPosition = self.ItemIconPos

		local itemStruct = self.SortedItemStructs[index]
		slot:Set(itemStruct)

		-- 판매 모드 표시: 선택한 장비는 체크마크 + 딤, 팔 수 없는 아이템(장착 중/잠금/장비 아님)은
		-- 딤만 씌워 눌러도 소용없다는 걸 보여준다.
		--
		-- ⚠ 체크마크(SelectedCheckText)는 UIItemSlot.model에서 **엔티티 자체가 꺼진 채로** 들어있다.
		-- TextComponent의 Enable만 켜면 화면에 아무것도 안 나온다(실측) — RedDot 배지와 같은 이유로
		-- 반드시 엔티티까지 같이 토글해야 한다.
		local isSelected = false
		if itemStruct ~= nil and self.Inventory ~= nil and self.Inventory.IsSellMode then
			isSelected = self.Inventory:IsSellSelected(itemStruct.GUID)
		end

		slot.SelectedCheckText.Entity.Enable = isSelected
		slot.SelectedCheckText.Enable = isSelected
		if isSelected then
			-- ⚠ .model에 저장된 FontColor가 스폰 시점에 적용되지 않아 알파 0(완전 투명)으로 들어온다
			-- (UIItemSlot의 QualityText와 같은 TextComponent Values 한계 — 실측). 켤 때마다 직접 칠한다
			slot.SelectedCheckText.FontColor = self.SellCheckColor
		end

		if itemStruct ~= nil and self.Inventory ~= nil and self.Inventory.IsSellMode then
			slot.ImageDim.Enable = isSelected or not _GearSellLogic:CanSell(itemStruct)
		end

		self:ApplyEquippedMark(slot)
	end

	-- 장착 중인 장비 표시(2026-09-15 유저 요청): 반투명 검정 딤 + "장착중" 글자. 인벤토리 그리드에서만
	-- 켠다 — UIItemSlot은 장착 칸/합성 팝업에서도 쓰이므로 Set()은 항상 끄고 여기서만 다시 켠다.
	-- 판매 모드의 딤은 선택/판매불가 규칙(OnRefresh)이 정하므로 여기서는 장착 장비만 켜고 끄지 않는다
	@ExecSpace("ClientOnly")
	method void ApplyEquippedMark(UIItemSlot slot)
		local equipped = false
		if slot.ItemStruct ~= nil then equipped = slot.ItemStruct:IsAttached() end
		slot:SetEquippedMark(equipped)
		if equipped then
			slot.ImageDim.Enable = true
		elseif self.Inventory == nil or not self.Inventory.IsSellMode then
			slot.ImageDim.Enable = false
		end
	end

	-- 장착/해제는 force 없이 갱신돼(Update 참고) 이미 그려진 셀은 OnRefresh를 다시 안 탄다 — 그대로 두면
	-- 해제한 장비에 "장착중"이 남는다(실측). 보이는 셀 전부에 장착 표시만 다시 적용한다
	@ExecSpace("ClientOnly")
	method void RefreshEquippedMarks()
		for _, comp in ipairs(self.Entity:GetChildComponentsByTypeName("script.UIItemSlot", false)) do
			local slot = comp.Entity.UIItemSlot
			if slot ~= nil then self:ApplyEquippedMark(slot) end
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowItemNameTooltip(Entity cellEntity, string itemName)
		-- 누른 칸 바로 위에 말풍선을 띄우고 ItemNameTooltipDuration초 뒤 닫는다(다시 누르면 시간 연장)
		if not isvalid(self.itemNameTooltip) or not isvalid(cellEntity) then return end
		local tooltipTr = self.itemNameTooltip.UITransformComponent
		local parentTr = self.itemNameTooltip.Parent.UITransformComponent
		-- ⚠ GridView 셀의 UITransform.WorldPosition은 실제 화면 위치와 다르고(셀 전부 같은 값 — 2026-09-19 실측),
		-- 커서 좌표도 칸과 어긋났다(유저 실측 "왼쪽으로 밀림"). 그래서 그리드 배치(칸 번호 → 행/열, 칸 크기,
		-- 간격, 패딩, 스크롤)로 칸 중심을 직접 계산한다. 말풍선 부모(Panel) 기준 좌표.
		local center = self:GetCellCenterInTooltipParent(cellEntity.UIInventoryGridCell.GridIndex)
		-- 말풍선 꼬리가 왼쪽 아래에 있어서 꼬리 끝이 칸을 가리키게 오른쪽으로 민다. 화면(1920 기준) 밖으로는 안 나가게 자른다
		-- (패널 끝으로 자르면 맨 오른쪽 칸에서 꼬리가 옆 칸을 가리켰다 — 실측)
		local x = center.x + self.ItemNameTooltipOffsetX
		local maxX = 960 - parentTr.Position.x - tooltipTr.RectSize.x * 0.5 - 10
		if x > maxX then x = maxX end
		tooltipTr.anchoredPosition = Vector2(x, center.y + self.ItemNameTooltipOffsetY)
		if isvalid(self.itemNameTooltipText) then self.itemNameTooltipText.Text = itemName end
		self.itemNameTooltip:SetEnable(true)
		_UILogic:SetSiblingIndex(tooltipTr, 1000000)

		if self._tooltipTimerId ~= 0 then _TimerService:ClearTimer(self._tooltipTimerId) end
		self._tooltipTimerId = _TimerService:SetTimerOnce(function()
			self._tooltipTimerId = 0
			self:HideItemNameTooltip()
		end, self.ItemNameTooltipDuration)
		log("UIInventoryGrid: item name tooltip '" .. itemName .. "' cell#" .. tostring(cellEntity.UIInventoryGridCell.GridIndex)
			.. " at " .. tostring(center.x) .. "," .. tostring(center.y))
	end

	@ExecSpace("ClientOnly")
	method Vector2 GetCellCenterInTooltipParent(integer index)
		-- index(1부터)번 칸의 중심을 Panel(= 이 그리드의 부모의 부모, 말풍선 부모) 기준 좌표로 돌려준다.
		-- 구조: Panel > InventoryPanel > Grid. UITransform.Position은 부모 기준 실제 로컬 위치(피벗 점)다
		local gridTr = self.Entity.UITransformComponent
		local holderTr = self.Entity.Parent.UITransformComponent
		local gv = self.GridView
		local cols = gv.FixedCount
		if cols < 1 then cols = 1 end
		local cell = gv.CellSize
		local gap = gv.Spacing
		local pad = gv.Padding

		local col = (index - 1) % cols
		local row = math.floor((index - 1) / cols)

		-- 그리드 좌상단(Panel 기준)
		local gridSize = gridTr.RectSize
		local left = holderTr.Position.x + gridTr.Position.x - gridSize.x * gridTr.Pivot.x
		local top = holderTr.Position.y + gridTr.Position.y + gridSize.y * (1 - gridTr.Pivot.y)

		-- 세로 스크롤만큼 내용이 위로 올라간다(정규화 0 = 맨 위, 1 = 맨 아래)
		local rows = math.ceil(gv.TotalCount / cols)
		local contentH = pad.top + pad.bottom + rows * cell.y + math.max(0, rows - 1) * gap.y
		local scrollable = math.max(0, contentH - gridSize.y)
		local norm = gv:GetScrollNormalizedPosition(UITransformAxis.Vertical)
		local scrollPx = scrollable * math.max(0, math.min(1, norm))

		local x = left + pad.left + col * (cell.x + gap.x) + cell.x * 0.5
		local y = top - pad.top - row * (cell.y + gap.y) - cell.y * 0.5 + scrollPx
		return Vector2(x, y)
	end

	@ExecSpace("ClientOnly")
	method void HideItemNameTooltip()
		-- 말풍선 닫기(탭 전환/목록 갱신 때도 부른다)
		if isvalid(self.itemNameTooltip) then self.itemNameTooltip:SetEnable(false) end
	end

	@ExecSpace("ClientOnly")
	method void OnPlusSlotClicked()
		-- "+" 칸 클릭 — 확장 확인창은 인벤토리(UIInventory)가 들고 있는 공용 확인창을 쓴다
		if self.Inventory == nil then
			return
		end

		self.Inventory:OpenExpandConfirm(self.Inventory:GetCurrentTabEnum())
	end

	@ExecSpace("ClientOnly")
	method void OnClear(Entity entity)
		entity.UIItemSlot:Clear()
	end

end