-- MSW 공식 inventory-package 통합 — 로비 장비 버튼에서 열리는 인벤토리/장착 UI의 진입점.
-- 패키지 원본 Sample/InventorySampleLogic.mlua를 이 프로젝트에 맞게 정리한 버전:
-- GM 디버그 툴(O키/스태미나 테스트 아이템)은 제거하고, 모든 플레이어가 입장 시 자동으로
-- Adele 직업을 해금해 기본 장비(DefaultGearItemIds)가 자동 장착되도록 했다(관리자 전용이 아님).
@Logic
script InventoryBootstrap extends Logic

	-- 유저 요청으로 런타임 스폰(.model) 방식을 버리고 이 프로젝트의 다른 팝업(유물/가챠/스킬)과
	-- 동일하게 ui/EquipmentGroup.ui에 고정 배치된 정적 엔티티로 바꿨다 — 하이어라키에서 바로
	-- 보이고 Maker에서 직접 편집 가능. 로비 화면(TitleGroup, displayOrder=5)보다 위에 그려져야
	-- 해서 전용 그룹(EquipmentGroup, displayOrder=11)을 쓴다. 이 장비 시스템은 유물/스킬처럼
	-- "로비에서 장착 → 게임 시작 시 효과 적용" 개념이라 로비 전용으로 취급한다(인게임에서 얻는
	-- 잡템용 인게임 가방 InventoryUI와는 완전히 별개).
	property Entity InventoryEntity = "f5cb1fa3-87bb-4968-8af4-4d682d6eb199"

	@ExecSpace("ClientOnly")
	method void OpenInventory()
		self.InventoryEntity.UIInventory:Toggle()
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleKeyDownEvent(KeyDownEvent event)
		if event.key == KeyboardKey.I then
			if _UserService.LocalPlayer.PkgPlayerInventory.InitSyncEnd == false then
				return
			end
			self:OpenInventory()
		end
	end

	-- 월드에 입장한 모든 플레이어에게 Adele 직업을 자동 해금한다 — 이 프로젝트엔 별도 직업
	-- 선택 시스템이 없으므로, 인벤토리 패키지의 기본 장비(JobDataSet.DefaultGearItemIds)가
	-- 자동으로 생성+장착되게 하는 트리거로만 쓴다(PkgPlayerInventory:CreateAndAttachDefaultGear).
	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserEnterEvent(UserEnterEvent event)
		local user = _UserService:GetUserEntityByUserId(event.UserId)
		if _DataLoadLogic:IsLoadSuccessAndWait(user) == false then
			return
		end

		if user.PlayerJob:IsJobLockedAll() then
			user.PlayerJob:UnlockJob(_PlayerJobCodeEnum.Adele)
		end
	end

end
