@Logic
script CharacterUnlockLogic extends Logic

	-- 실피드(2번 캐릭터 슬롯) 해금 여부 — 계정에 영구 저장된다. 클라이언트(WorldCharacterSelectUI,
	-- 타이틀 화면)가 캐릭터 슬롯 잠금 상태를 결정하는 데 이 값을 읽으므로 @Sync 필요.
	@Sync property boolean SylphUnlocked = false

	property any _unlockStorage = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- GameManager.TotalCoins(PlayerCoins 글로벌 스토리지)와 동일한 패턴 — 이 게임은 월드 인스턴스당
		-- 플레이어가 1명이라 계정 단위 값도 전역 스토리지로 관리한다.
		self._unlockStorage = _DataStorageService:GetGlobalDataStorage("CharacterUnlocks")
		local errorCode, raw = self._unlockStorage:GetAndWait("SylphUnlocked")
		if errorCode == 0 and raw == "1" then
			self.SylphUnlocked = true
		end
		log("CharacterUnlockLogic: SylphUnlocked=" .. tostring(self.SylphUnlocked))

		-- 이전 세션에서 이미 실피드를 획득했다면(영구 저장된 값), 맵21 퍼즐/오브젝트가 새 세션에서
		-- 다시 미해결 상태로 보이지 않도록 여기서 곧바로 "이미 해결됨" 상태를 적용한다. 두 Logic의
		-- 자체 OnBeginPlay(스크립트 간 실행 순서 비보장)에 맡기지 않고, 저장소 값을 확정한 이 시점에서
		-- 직접 호출해 순서를 보장한다.
		if self.SylphUnlocked then
			_Map21RelicEasterEgg:ApplyAlreadyUnlockedState()
			_Map21TreePuzzleLogic:ApplyAlreadyUnlockedState()
		end
	end

	@ExecSpace("ServerOnly")
	method void UnlockSylph()
		if self.SylphUnlocked then return end
		self.SylphUnlocked = true
		self._unlockStorage:SetAndWait("SylphUnlocked", "1")
		log("CharacterUnlockLogic: Sylph unlocked and saved")
	end

	-- [DEBUG] O키 → 실피드 해금 상태를 미해금으로 되돌린다(재테스트용). CardManager.DebugMode
	-- 게이트를 거쳐서만 호출된다(CardManager.DebugResetSylphUnlock 참고).
	@ExecSpace("ServerOnly")
	method void DebugResetSylphUnlock()
		self.SylphUnlocked = false
		self._unlockStorage:SetAndWait("SylphUnlocked", "0")
		log("CharacterUnlockLogic: [DEBUG] Sylph unlock reset")
	end

end
