@Logic
script CharacterUnlockLogic extends Logic

	-- 실피드(2번 캐릭터 슬롯) 해금 여부 — 계정에 영구 저장된다. 클라이언트(WorldCharacterSelectUI,
	-- 타이틀 화면)가 캐릭터 슬롯 잠금 상태를 결정하는 데 이 값을 읽으므로 @Sync 필요.
	@Sync property boolean SylphUnlocked = false
	-- 레이온 해금 여부 — 몬스터 갤러리(ep2_map2_estermap_1) 전투 미니게임에서 고른 몬스터가 1등을
	-- 하면 해금된다(Ep2Map2ArenaLogic.GrantVictoryReward). 실피드와 동일한 영구 저장 패턴.
	@Sync property boolean LeionUnlocked = false
	-- 쉐이드 해금 여부 — 누적 장비 획득 250개(유저 지정 2026-09-16). 실피드/레이온과 달리 "특정 장소에서
	-- 한 번" 이 아니라 누적 카운터라, 진행도(_gearCollected)를 같이 저장하고 선택 팝업에 (n/250)으로 보여준다.
	@Sync property boolean ShadeUnlocked = false
	-- 린 해금 여부 — 누적 몬스터 처치 100,000마리(유저 지정 2026-09-16). 쉐이드와 동일한 누적 카운터 방식.
	@Sync property boolean RinUnlocked = false
	@Sync property boolean BenoaUnlocked = false
	property boolean _benoaLoadReady = false
	-- 아직 못 보여준 해금 축하 팝업(유저 지정 2026-09-30: "게임 도중에 뜨면 안 되고, 조건 완료 후 로비에 가면 떠야 한다").
	-- "shade", "rin"을 쉼표로 이어 둔다. 진행도 JSON("pp")에 같이 저장되어 판 도중에 꺼도 다음 로비에서 뜬다.
	-- 실제 표시는 클라(CharacterUnlockUI.TryShowPending)가 로비가 보일 때만 한다.
	@Sync property string PendingUnlockPopups = ""

	-- 해금 목표치. 조건 문구(WorldCharacterSelectUI의 unlockHint — _characters 초기값과
	-- RefreshShadeSlot/RefreshRinSlot 두 곳)와 반드시 같이 고칠 것
	-- 2026-09-29 유저 지정 완화: 쉐이드 250 → 100개, 린 100,000 → 10,000마리
	property integer ShadeGearGoal = 100
	property integer RinKillGoal = 10000

	-- ⚠ 테스트용 ON(2026-09-28 유저 지정 "캐릭터 다 열어줘") — 입장 시 4캐릭 전부 해금(메모리에서만, 저장 안 함). 출시 전 false
	property boolean TestUnlockAllCharacters = false
	-- ⚠ 테스트용 ON(2026-10-01 유저 지정 "실피드 레이온 해금") — 입장 시 실피드·레이온만 해금(메모리에서만, 저장 안 함).
	-- 쉐이드/린과 그 진행도 저장은 건드리지 않는다. 출시 전 false
	property boolean TestUnlockSylphLeion = false

	property any _unlockStorage = nil

	-- 누적 진행도. 킬 카운터는 초당 몇 번씩 오르므로 @Sync를 걸지 않는다(매 킬마다 서버→클라 동기화가
	-- 나간다). 선택 팝업이 열릴 때 RequestProgress로 한 번만 내려보낸다.
	property integer _gearCollected = 0
	property integer _monsterKilled = 0
	property boolean _progressDirty = false
	property integer _flushTimerId = 0
	-- 진행도는 {g,k,s,r} JSON 1개 키로 모아서 저장한다(출석/방치 보상과 같은 패턴 — 키당 1크레딧).
	property string ProgressKey = "Unlock.Progress"
	property number FlushInterval = 10.0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 킬/장비 카운터는 판을 도는 내내 오르므로 매번 저장하지 않고 10초마다 모아서 한 번 쓴다
		-- (DataStorage 크레딧 — 둘 다 해금되면 카운트 자체를 멈춰서 쓰기가 0이 된다).
		self._flushTimerId = _TimerService:SetTimerRepeat(function()
			self:FlushProgressIfDirty()
		end, self.FlushInterval)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserEnterEvent(UserEnterEvent event)
		-- 입장한 유저의 해금 상태/진행도를 **유저별 저장소**에서 읽는다(키 "Unlock.*").
		-- 출시 전 수정(2026-09-20): 예전엔 "인스턴스당 1명이니 전역이면 된다"고 보고 전역 저장소("CharacterUnlocks")를
		-- 썼는데, 전역 저장소는 인스턴스와 무관하게 월드 전체가 하나라 한 명이 해금하면 전 유저가 해금됐다
		local user = _UserService:GetUserEntityByUserId(event.UserId)
		if user == nil then return end
		self._unlockStorage = _DataStorageService:GetUserDataStorage(user.PlayerComponent.ProfileCode)
		local errorCode, raw = self._unlockStorage:GetAndWait("Unlock.Sylph")
		if errorCode == 0 and raw == "1" then
			self.SylphUnlocked = true
		end
		local leionErrorCode, leionRaw = self._unlockStorage:GetAndWait("Unlock.Leion")
		if leionErrorCode == 0 and leionRaw == "1" then
			self.LeionUnlocked = true
		end
		self:LoadBenoaUnlock()
		self:LoadProgress()
		-- 입장 시점에 이미 목표를 넘겨 있으면 바로 해금한다(유저 리포트 2026-09-30: 목표를 낮춘 업데이트 뒤 이미
		-- 달성한 계정이 로비에선 안 풀리고, 판에 들어가 다음 처치가 나와서야 인게임 팝업이 떴다).
		-- 팝업은 대기 목록으로 가서 로비에서 뜬다(CharacterUnlockUI.TryShowPending)
		if not self.ShadeUnlocked and self._gearCollected >= self.ShadeGearGoal then self:UnlockShade() end
		if not self.RinUnlocked and self._monsterKilled >= self.RinKillGoal then self:UnlockRin() end
		log("CharacterUnlockLogic: SylphUnlocked=" .. tostring(self.SylphUnlocked) .. " LeionUnlocked=" .. tostring(self.LeionUnlocked) .. " ShadeUnlocked=" .. tostring(self.ShadeUnlocked) .. "(" .. self._gearCollected .. "/" .. self.ShadeGearGoal .. ")" .. " RinUnlocked=" .. tostring(self.RinUnlocked) .. "(" .. self._monsterKilled .. "/" .. self.RinKillGoal .. ")")

		-- 이전 세션에서 이미 실피드를 획득했다면(영구 저장된 값), 맵21 퍼즐/오브젝트가 새 세션에서
		-- 다시 미해결 상태로 보이지 않도록 여기서 곧바로 "이미 해결됨" 상태를 적용한다. 두 Logic의
		-- 자체 OnBeginPlay(스크립트 간 실행 순서 비보장)에 맡기지 않고, 저장소 값을 확정한 이 시점에서
		-- 직접 호출해 순서를 보장한다.
		if self.SylphUnlocked then
			_Map21RelicEasterEgg:ApplyAlreadyUnlockedState()
			_Map21TreePuzzleLogic:ApplyAlreadyUnlockedState()
		end

		-- 테스트용 전체 해금 — 저장된 실제 값을 읽은 **뒤** 메모리에서만 켠다(맵21 퍼즐 상태는 위에서 실제 값으로 이미 처리).
		-- SaveProgress도 이 스위치가 켜져 있으면 쓰지 않아서 계정 저장값은 그대로 남는다.
		if self.TestUnlockAllCharacters then
			self.SylphUnlocked = true
			self.LeionUnlocked = true
			self.ShadeUnlocked = true
			self.RinUnlocked = true
			self.BenoaUnlocked = true
			log("CharacterUnlockLogic: [TEST] all characters unlocked (not saved)")
		end
		-- 테스트용 실피드·레이온만 해금 — 위와 같이 실제 값을 읽은 뒤 메모리에서만 켠다(계정 저장값은 그대로)
		if self.TestUnlockSylphLeion then
			self.SylphUnlocked = true
			self.LeionUnlocked = true
			log("CharacterUnlockLogic: [TEST] sylph + leion unlocked (not saved)")
		end
	end

	method boolean IsBenoaUnlocked()
		return self.BenoaUnlocked
	end

	@ExecSpace("ServerOnly")
	method void LoadBenoaUnlock()
		self._benoaLoadReady=false
		if self._unlockStorage==nil then return end
		local code,raw=self._unlockStorage:GetAndWait("Unlock.Benoa")
		if code==0 or code==1000002 then
			self.BenoaUnlocked=raw=="1" self._benoaLoadReady=true
		else log_warning("CharacterUnlockLogic: Benoa load failed code="..tostring(code)) end
		log("CharacterUnlockLogic: Benoa loaded="..tostring(self.BenoaUnlocked))
	end

	@ExecSpace("ServerOnly")
	method boolean UnlockBenoa()
		if self.BenoaUnlocked then return true end
		if not self._benoaLoadReady then self:LoadBenoaUnlock() end
		if self.BenoaUnlocked then return true end
		if not self._benoaLoadReady or self._unlockStorage==nil then return false end
		local code=self._unlockStorage:SetAndWait("Unlock.Benoa","1")
		if code~=0 then log_warning("CharacterUnlockLogic: Benoa save failed code="..tostring(code)) return false end
		self.BenoaUnlocked=true
		log("CharacterUnlockLogic: Benoa unlocked and saved")
		return true
	end

	-- ── 접근자(다른 Logic/UI에서 property 직접 읽기 금지 — 이걸로 읽는다) ────────
	method integer GetShadeGearGoal()
		return self.ShadeGearGoal
	end

	method integer GetRinKillGoal()
		return self.RinKillGoal
	end

	-- ── 누적 진행도(쉐이드/린) ────────────────────────────────────────────────
	@ExecSpace("ServerOnly")
	method void LoadProgress()
		local code, raw = self._unlockStorage:GetAndWait(self.ProgressKey)
		if code == 0 and raw ~= nil and raw ~= "" then
			local t = _HttpService:JSONDecode(raw)
			if t ~= nil then
				self._gearCollected = math.floor(tonumber(t["g"]) or 0)
				self._monsterKilled = math.floor(tonumber(t["k"]) or 0)
				self.ShadeUnlocked = math.floor(tonumber(t["s"]) or 0) == 1
				self.RinUnlocked = math.floor(tonumber(t["r"]) or 0) == 1
				local pp = t["pp"]
				if pp ~= nil then self.PendingUnlockPopups = tostring(pp) end
			end
		elseif code ~= 0 and code ~= 1000002 then
			-- 1000002(NotFound)는 아직 한 번도 안 센 계정 — 정상이므로 경고하지 않는다
			log_warning("CharacterUnlockLogic: progress load failed code=" .. tostring(code))
		end
	end

	@ExecSpace("ServerOnly")
	method void SaveProgress(boolean blocking)
		-- blocking=true는 해금 순간/월드 종료처럼 반드시 남아야 하는 시점에만 쓴다(마지막 기회 저장).
		-- 유저 입장(로드) 전이면 저장하지 않는다 — 0으로 유저 진행도를 덮으면 안 된다
		if self._unlockStorage == nil then return end
		-- 테스트 전체 해금 중엔 s/r=1이 계정에 박히면 안 된다
		if self.TestUnlockAllCharacters then return end
		self._progressDirty = false
		local t = {}
		t["g"] = self._gearCollected
		t["k"] = self._monsterKilled
		local s = 0
		if self.ShadeUnlocked then s = 1 end
		local r = 0
		if self.RinUnlocked then r = 1 end
		t["s"] = s
		t["r"] = r
		t["pp"] = self.PendingUnlockPopups
		local raw = _HttpService:JSONEncode(t)
		if blocking then
			local code = self._unlockStorage:SetAndWait(self.ProgressKey, raw)
			if code ~= 0 then log_warning("CharacterUnlockLogic: progress save failed code=" .. tostring(code)) end
		else
			self._unlockStorage:SetAsync(self.ProgressKey, raw, function(code, key)
				if code ~= 0 then log_warning("CharacterUnlockLogic: progress save failed code=" .. tostring(code)) end
			end)
		end
	end

	@ExecSpace("ServerOnly")
	method void FlushProgressIfDirty()
		if not self._progressDirty then return end
		self:SaveProgress(false)
	end

	@ExecSpace("ServerOnly")
	method void AddGearCollected(integer count)
		-- 장비를 실제로 인벤에 넣는 데 성공한 시점에만 부른다 — 몬스터 드롭(GameManager.TryDropWeaponItem),
		-- 방치 보상(IdleRewardLogic.ClaimFor), 레벨업 보상(LevelRewardLogic.GrantGear) 세 곳.
		-- 인벤이 꽉 차서 버려진 장비는 "획득"이 아니므로 세지 않는다.
		if self.ShadeUnlocked then return end
		if count <= 0 then return end
		self._gearCollected = self._gearCollected + count
		self._progressDirty = true
		if self._gearCollected >= self.ShadeGearGoal then
			self:UnlockShade()
		end
	end

	@ExecSpace("ServerOnly")
	method void AddMonsterKill(integer count)
		-- 일반/엘리트/보스 가리지 않고 "아무 몬스터" 1마리 — GameManager.OnMonsterKilled / OnBossDefeated.
		-- 목표 100,000마리라 한 판에 수백~수천씩 쌓인다(저장은 10초 모아쓰기라 호출 빈도와 무관).
		if self.RinUnlocked then return end
		if count <= 0 then return end
		self._monsterKilled = self._monsterKilled + count
		self._progressDirty = true
		if self._monsterKilled >= self.RinKillGoal then
			self:UnlockRin()
		end
	end

	-- 선택 팝업(WorldCharacterSelectUI.Open)이 열릴 때 1회 요청한다. 카운터에 @Sync를 걸지 않는 대신
	-- 필요한 순간에만 내려보내는 방식 — 킬마다 동기화가 나가는 걸 피한다.
	@ExecSpace("Server")
	method void RequestProgress()
		_WorldCharacterSelectUI:OnProgressSynced(self._gearCollected, self._monsterKilled, senderUserId)
	end

	-- 해금 축하 팝업(CharacterUnlockUI)을 띄울 대상. 이 월드는 인스턴스당 1명이라 첫 유저를 쓴다
	-- (GameManager.TryDropWeaponItem과 동일 패턴).
	@ExecSpace("ServerOnly")
	method string GetSoleUserId()
		for _, u in pairs(_UserService.UserEntities) do
			return u.PlayerComponent.UserId
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method void UnlockShade()
		if self.ShadeUnlocked then return end
		self.ShadeUnlocked = true
		-- 축하 팝업은 바로 띄우지 않고 로비에서(CharacterUnlockUI.TryShowPending) — 판 도중에 뜨지 않게
		self:AddPendingPopup("shade")
		self:SaveProgress(true)
		log("CharacterUnlockLogic: Shade unlocked and saved (gear " .. self._gearCollected .. ") — popup pending for lobby")
	end

	@ExecSpace("ServerOnly")
	method void UnlockRin()
		if self.RinUnlocked then return end
		self.RinUnlocked = true
		-- 축하 팝업은 바로 띄우지 않고 로비에서(CharacterUnlockUI.TryShowPending) — 판 도중에 뜨지 않게
		self:AddPendingPopup("rin")
		self:SaveProgress(true)
		log("CharacterUnlockLogic: Rin unlocked and saved (kills " .. self._monsterKilled .. ") — popup pending for lobby")
	end

	@ExecSpace("ServerOnly")
	method void AddPendingPopup(string name)
		-- 보여줄 해금 팝업 목록에 추가(중복 없이)
		for part in string.gmatch(self.PendingUnlockPopups, "[^,]+") do
			if part == name then return end
		end
		if self.PendingUnlockPopups == "" then
			self.PendingUnlockPopups = name
		else
			self.PendingUnlockPopups = self.PendingUnlockPopups .. "," .. name
		end
	end

	@ExecSpace("Server")
	method void ConsumePendingPopup(string name)
		-- 클라가 로비에서 팝업을 띄운 뒤 호출 — 목록에서 빼고 저장한다
		local rest = {}
		for part in string.gmatch(self.PendingUnlockPopups, "[^,]+") do
			if part ~= name then table.insert(rest, part) end
		end
		self.PendingUnlockPopups = table.concat(rest, ",")
		self:SaveProgress(false)
		log("CharacterUnlockLogic: unlock popup shown in lobby: " .. name .. " (left: \"" .. self.PendingUnlockPopups .. "\")")
	end

	method string GetPendingUnlockPopups()
		-- 클라 UI가 읽는다(다른 Logic 필드 직접 읽기 대신)
		return self.PendingUnlockPopups
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- 보여줄 해금 팝업이 생기면 로비가 떠 있을 때 바로 띄운다(판 중이면 로비로 갈 때 TitleUI.ShowLobby가 부른다)
		if name == "PendingUnlockPopups" then _CharacterUnlockUI:TryShowPending() end
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		if self._flushTimerId ~= 0 then
			_TimerService:ClearTimer(self._flushTimerId)
			self._flushTimerId = 0
		end
		-- 마지막 기회 저장 — 여기서 Async로 던지면 월드가 내려가면서 요청이 씹힌다
		if self._progressDirty then self:SaveProgress(true) end
	end

	@ExecSpace("ServerOnly")
	method boolean UnlockSylph()
		if self.SylphUnlocked then return true end
		if self._unlockStorage==nil then return false end
		local code=self._unlockStorage:SetAndWait("Unlock.Sylph","1")
		if code~=0 then log_warning("CharacterUnlockLogic: Sylph save failed code="..tostring(code)) return false end
		self.SylphUnlocked=true
		log("CharacterUnlockLogic: Sylph unlocked and saved")
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean UnlockLeion()
		if self.LeionUnlocked then return true end
		if self._unlockStorage==nil then return false end
		local code=self._unlockStorage:SetAndWait("Unlock.Leion","1")
		if code~=0 then log_warning("CharacterUnlockLogic: Leion save failed code="..tostring(code)) return false end
		self.LeionUnlocked=true
		log("CharacterUnlockLogic: Leion unlocked and saved")
		return true
	end

	-- [DEBUG] O키 → 실피드 해금 상태를 미해금으로 되돌린다(재테스트용). CardManager.DebugMode
	-- 게이트를 거쳐서만 호출된다(CardManager.DebugResetSylphUnlock 참고).
	@ExecSpace("ServerOnly")
	method void DebugResetSylphUnlock()
		self.SylphUnlocked = false
		if self._unlockStorage ~= nil then self._unlockStorage:SetAndWait("Unlock.Sylph", "0") end
		log("CharacterUnlockLogic: [DEBUG] Sylph unlock reset")
	end

	-- [DEBUG] 레이온 해금 상태 리셋(재테스트용) — Sylph와 동일 게이트로 CardManager에서 호출.
	@ExecSpace("ServerOnly")
	method void DebugResetLeionUnlock()
		self.LeionUnlocked = false
		if self._unlockStorage ~= nil then self._unlockStorage:SetAndWait("Unlock.Leion", "0") end
		log("CharacterUnlockLogic: [DEBUG] Leion unlock reset")
	end

	-- [DEBUG] 쉐이드/린은 누적 카운터라 해금 플래그만 끄면 다음 1킬에 바로 다시 해금된다 —
	-- 진행도까지 같이 0으로 되돌린다. 서버 스크립트에서 직접 호출(재테스트용).
	@ExecSpace("ServerOnly")
	method void DebugResetProgressUnlocks()
		self.ShadeUnlocked = false
		self.RinUnlocked = false
		self._gearCollected = 0
		self._monsterKilled = 0
		self:SaveProgress(true)
		log("CharacterUnlockLogic: [DEBUG] Shade/Rin unlock + progress reset")
	end

	-- [DEBUG] 진행도만 원하는 값으로 밀어넣는다(목표치 근처 테스트용). 목표를 넘기면 그 자리에서 해금된다.
	@ExecSpace("ServerOnly")
	method void DebugSetProgress(integer gear, integer kills)
		self._gearCollected = gear
		self._monsterKilled = kills
		self._progressDirty = true
		log("CharacterUnlockLogic: [DEBUG] progress set gear=" .. gear .. " kills=" .. kills)
		if not self.ShadeUnlocked and self._gearCollected >= self.ShadeGearGoal then self:UnlockShade() end
		if not self.RinUnlocked and self._monsterKilled >= self.RinKillGoal then self:UnlockRin() end
		self:SaveProgress(true)
	end

end
