@Logic
script InventoryExpandLogic extends Logic

	-- 인벤토리 칸 확장(유저 지정 2026-09-10). 정원은 **탭별로 따로** 관리한다 —
	-- 무기 / 방어구 / 기타 각각 기본 100칸이고, 확장할 때마다 그 탭만 5칸씩 늘어난다.
	-- All 탭은 세 탭의 합계를 보여주는 뷰라 자체 정원도 없고 확장 버튼도 없다.
	--
	-- 탭 번호는 UIInventoryTabHolder.TabNames 순서를 그대로 쓴다: 1=All / 2=Weapon / 3=Armor / 4=etc / 5=Acc(장신구)
	-- 장신구 탭(2026-09-23 추가)은 화면상 방어구 오른쪽이지만 번호는 5다 — 기타(4)의 번호와 저장 키를 그대로 두려고.

	property integer TabAll = 1

	property integer TabWeapon = 2

	property integer TabArmor = 3

	property integer TabEtc = 4

	property integer TabAcc = 5

	property integer BaseCapacity = 100

	property integer SlotsPerExpand = 5

	-- 확장 비용(다이아): 1회 100 → 2회 150 → 3회 200 … 50씩 오르다가 500에서 고정(유저 지정).
	-- 탭마다 확장 횟수를 따로 세므로 비용도 탭별로 따로 올라간다
	property integer CostBase = 100

	property integer CostStep = 50

	property integer CostMax = 500

	-- 탭별 확장 횟수(0부터). 서버가 DataStorage에서 불러와 채우고 클라에는 @Sync로 내려간다
	@Sync
	property integer WeaponExpandCount = 0

	@Sync
	property integer ArmorExpandCount = 0

	@Sync
	property integer EtcExpandCount = 0

	@Sync
	property integer AccExpandCount = 0

	property any _storage = nil

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserEnterEvent(UserEnterEvent event)
		-- 입장한 유저의 **유저별 저장소**에서 탭별 확장 횟수를 읽는다(키는 "InvExpand*").
		-- 출시 전 수정(2026-09-20): 예전엔 월드 시작 때 전역 저장소("PlayerCoins")라 전 유저가 확장 칸을 공유했다
		local user = _UserService:GetUserEntityByUserId(event.UserId)
		if user == nil then return end
		self._storage = _DataStorageService:GetUserDataStorage(user.PlayerComponent.ProfileCode)
		self.WeaponExpandCount = self:LoadCount("InvExpandWeapon")
		self.ArmorExpandCount = self:LoadCount("InvExpandArmor")
		self.EtcExpandCount = self:LoadCount("InvExpandEtc")
		self.AccExpandCount = self:LoadCount("InvExpandAcc")
		log("InventoryExpandLogic started (weapon=" .. self.WeaponExpandCount
			.. " armor=" .. self.ArmorExpandCount .. " etc=" .. self.EtcExpandCount .. " acc=" .. self.AccExpandCount .. ")")
	end

	@ExecSpace("ServerOnly")
	method integer LoadCount(string key)
		-- 저장된 확장 횟수. 값이 없거나 읽기에 실패하면 0(미확장)으로 본다
		local errorCode, raw = self._storage:GetAndWait(key)
		if errorCode ~= 0 or raw == nil or raw == "" then
			return 0
		end

		local loaded = tonumber(raw)
		if loaded == nil then
			return 0
		end

		return loaded
	end

	method integer GetExpandCount(integer tabEnum)
		-- 그 탭이 지금까지 확장한 횟수. 확장 대상이 아닌 탭(All)이면 0
		if tabEnum == self.TabWeapon then return self.WeaponExpandCount end
		if tabEnum == self.TabArmor then return self.ArmorExpandCount end
		if tabEnum == self.TabEtc then return self.EtcExpandCount end
		if tabEnum == self.TabAcc then return self.AccExpandCount end
		return 0
	end

	method boolean IsExpandableTab(integer tabEnum)
		-- All은 세 탭을 합쳐 보여주는 뷰라 확장 버튼(+)을 붙이지 않는다
		return tabEnum == self.TabWeapon or tabEnum == self.TabArmor or tabEnum == self.TabEtc or tabEnum == self.TabAcc
	end

	method integer GetCapacity(integer tabEnum)
		-- 그 탭의 현재 정원. All은 나머지 네 탭 정원의 합
		if tabEnum == self.TabAll then
			return self:GetCapacity(self.TabWeapon) + self:GetCapacity(self.TabArmor) + self:GetCapacity(self.TabEtc)
				+ self:GetCapacity(self.TabAcc)
		end

		if not self:IsExpandableTab(tabEnum) then
			return self.BaseCapacity
		end

		return self.BaseCapacity + self:GetExpandCount(tabEnum) * self.SlotsPerExpand
	end

	method integer GetExpandCost(integer tabEnum)
		-- 이번에 확장할 때 드는 다이아. 500에서 상한에 걸린 뒤로는 계속 500
		local cost = self.CostBase + self:GetExpandCount(tabEnum) * self.CostStep
		if cost > self.CostMax then
			return self.CostMax
		end

		return cost
	end

	method string GetTabDisplayName(integer tabEnum)
		-- 확인창 문구에 쓰는 한글 탭 이름
		if tabEnum == self.TabWeapon then return "MLUA_EPISODEREWARDLOGIC_004" end
		if tabEnum == self.TabArmor then return "MLUA_EPISODEREWARDLOGIC_003" end
		if tabEnum == self.TabEtc then return "MLUA_INVENTORYEXPANDLOGIC_001" end
		if tabEnum == self.TabAcc then return "MLUA_INVENTORYEXPANDLOGIC_003" end
		return "MLUA_INVENTORYEXPANDLOGIC_002"
	end

	@ExecSpace("ServerOnly")
	method integer GetItemTab(integer itemId)
		-- 아이템이 인벤 창 어느 탭에 보이는지(UIInventoryTabHolder.SetCachingItemsFunctions와 같은 분류) —
		-- 2=무기 / 3=방어구 / 4=기타(장비 아님) / 5=장신구. 어디에도 안 붙으면 전체 탭에만 보이고 탭 정원이 없다 → 0
		local itemData = _ItemDataLogic:GetData(itemId)
		if itemData == nil then return 0 end
		local gear = itemData:GetGearData()
		if gear == nil then return self.TabEtc end
		if _GearCategoryEnum:IsWeapon(gear.GearCategory) then return self.TabWeapon end
		if _GearCategoryEnum:IsArmor(gear.GearCategory) then return self.TabArmor end
		-- 장신구(반지)는 장신구 탭(2026-09-23 유저 지정 — 그 전엔 기타 탭에 묶여 있었다).
		-- ⚠ UIInventoryTabHolder의 탭 조건과 **한 쌍**이다. 여기만 바꾸면
		--   정원에는 세는데 탭에는 안 보이고, 저쪽만 바꾸면 그 반대가 된다
		if _GearCategoryEnum:IsAccessory(gear.GearCategory) then return self.TabAcc end
		return 0
	end

	@ExecSpace("ServerOnly")
	method table CountItemsByTab(string userId)
		-- 탭별 보유 수 {[2]=n, [3]=n, [4]=n, [5]=n} — 인벤 창 "N / M"과 같은 기준(장착 중인 장비 포함)
		local used = {}
		local user = _UserService:GetUserEntityByUserId(userId)
		if not isvalid(user) or not isvalid(user.PkgPlayerInventory) then return used end
		for _, itemStruct in pairs(user.PkgPlayerInventory.Items) do
			local tab = self:GetItemTab(itemStruct.ItemId)
			if tab ~= 0 then used[tab] = (used[tab] or 0) + 1 end
		end
		return used
	end

	@ExecSpace("ServerOnly")
	method boolean HasRoomFor(string userId, integer itemId)
		-- 이 아이템 1개가 들어갈 탭 자리가 남았는지. ItemFactory는 정원을 안 보므로(IsIgnoreInvenCapacity 기본 true)
		-- 정원 제한이 필요한 곳(몬스터 드롭 등)은 여기서 직접 판정한다
		local tab = self:GetItemTab(itemId)
		if tab == 0 then return true end
		local used = self:CountItemsByTab(userId)
		return (used[tab] or 0) < self:GetCapacity(tab)
	end

	@ExecSpace("Server")
	method void RequestExpand(integer tabEnum)
		-- 확장 요청. 다이아 차감과 저장은 전부 여기(서버)에서만 하고, 결과는 @Sync로 클라에 내려간다
		if not self:IsExpandableTab(tabEnum) then
			return
		end

		local cost = self:GetExpandCost(tabEnum)
		if not _GameManager:SpendDiamond(cost) then
			log("InventoryExpandLogic: not enough diamond (cost=" .. cost .. ", have=" .. _GameManager.Diamond .. ")")
			return
		end

		local key = ""
		if tabEnum == self.TabWeapon then
			self.WeaponExpandCount = self.WeaponExpandCount + 1
			key = "InvExpandWeapon"
		elseif tabEnum == self.TabArmor then
			self.ArmorExpandCount = self.ArmorExpandCount + 1
			key = "InvExpandArmor"
		elseif tabEnum == self.TabAcc then
			self.AccExpandCount = self.AccExpandCount + 1
			key = "InvExpandAcc"
		else
			self.EtcExpandCount = self.EtcExpandCount + 1
			key = "InvExpandEtc"
		end

		-- 확장은 아주 드문 조작이라(연타 대상이 아님) 지연 flush 없이 그 자리에서 저장한다
		if self._storage ~= nil then self._storage:SetAndWait(key, tostring(self:GetExpandCount(tabEnum))) end

		log("InventoryExpandLogic: expanded " .. self:GetTabDisplayName(tabEnum)
			.. " -> capacity " .. self:GetCapacity(tabEnum) .. " (paid " .. cost .. " diamond)")
	end

end
