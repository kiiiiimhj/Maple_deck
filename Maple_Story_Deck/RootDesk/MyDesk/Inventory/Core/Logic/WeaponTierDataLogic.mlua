-- 무기 티어(GearGradeEnum 6단계) ↔ 실제 무기 데이터(이름/아이콘/스탯) 매핑(유저 지정).
-- 무기 아이템은 전부 같은 ItemId(하나의 GUID)를 유지하고, Grade(티어)에 따라 이름/아이콘이
-- 동적으로 바뀐다 — 헬멧처럼 이름 고정+등급값만 내부 변화하는 기존 합성 시스템을 그대로 재사용하면서,
-- 표시(이름/아이콘)만 이 테이블을 거쳐 동적으로 결정한다.
@Logic
script WeaponTierDataLogic extends Logic

	-- 무기 카테고리 아이템의 고정 ItemId — 드롭/합성 전 과정에서 이 하나의 ItemId만 쓰인다
	property integer WeaponItemId = 60002

	property table TierDataTable = {}

	method void Init()
		local t = {}
		self.TierDataTable = t

		-- 각 티어: Name, RUID(avataritem이라 thumbnail:// 접두사 필요),
		-- QualityStats[QualityEnum] = {AtkMin,AtkMax, [BonusPercentMin,BonusPercentMax]},
		-- BonusLabel = 수치형 보너스 접두어("공격력"/"쿨타임", 매직/에픽/유니크만),
		-- SkillTexts = 등급 스킬 4행(레어=스킬명+수량 문구 고정, 레전더리=스킬명만·확률은 별도 굴림)
		t[_GearGradeEnum.None] = {
			Name = "나무 스태프",
			RUID = "thumbnail://7380b5e5754a4e338e65fa232a8a095b",
			QualityStats = {
				[_QualityEnum.F] = { AtkMin = 5, AtkMax = 5, BonusText = "" },
				[_QualityEnum.E] = { AtkMin = 5, AtkMax = 6, BonusText = "" },
				[_QualityEnum.D] = { AtkMin = 6, AtkMax = 7, BonusText = "" },
				[_QualityEnum.C] = { AtkMin = 7, AtkMax = 8, BonusText = "" },
				[_QualityEnum.B] = { AtkMin = 8, AtkMax = 9, BonusText = "" },
				[_QualityEnum.A] = { AtkMin = 9, AtkMax = 10, BonusText = "" },
				[_QualityEnum.S] = { AtkMin = 10, AtkMax = 10, BonusText = "" },
			},
			SkillTexts = { "-", "-", "-", "-" },
		}

		-- BonusPercentMin/Max(1000분율)는 "이 아이템이 실제로 갖는 하나의 확정값"을 드롭/등급업 시
		-- RollBonusPercentPerMille로 굴려서 ItemGearStruct.BonusPercentPerMille에 영구 저장하기 위한
		-- 구간이다(ATK/ProcChancePerMille와 동일 패턴, 유저 정정: 범위 문구를 그대로 보여주면 안 되고
		-- 그 범위 안에서 실제로 굴린 값을 보여줘야 함). BonusLabel은 그 수치 앞에 붙는 고정 접두어
		t[_GearGradeEnum.Magic] = {
			Name = "아크 스태프",
			RUID = "thumbnail://3ed87f7c028c49f9b72eaa68dfa83646",
			BonusLabel = "공격력",
			QualityStats = {
				[_QualityEnum.F] = { AtkMin = 10, AtkMax = 10, BonusPercentMin = 20, BonusPercentMax = 20 },
				[_QualityEnum.E] = { AtkMin = 10, AtkMax = 11, BonusPercentMin = 20, BonusPercentMax = 30 },
				[_QualityEnum.D] = { AtkMin = 11, AtkMax = 12, BonusPercentMin = 20, BonusPercentMax = 30 },
				[_QualityEnum.C] = { AtkMin = 12, AtkMax = 13, BonusPercentMin = 30, BonusPercentMax = 40 },
				[_QualityEnum.B] = { AtkMin = 13, AtkMax = 14, BonusPercentMin = 40, BonusPercentMax = 40 },
				[_QualityEnum.A] = { AtkMin = 14, AtkMax = 15, BonusPercentMin = 40, BonusPercentMax = 50 },
				[_QualityEnum.S] = { AtkMin = 15, AtkMax = 15, BonusPercentMin = 50, BonusPercentMax = 50 },
			},
		}

		t[_GearGradeEnum.Rare] = {
			Name = "이블윙즈",
			RUID = "thumbnail://364ee9432c284089a568d1b51059d795",
			QualityStats = {
				[_QualityEnum.F] = { AtkMin = 15, AtkMax = 17, BonusText = "" },
				[_QualityEnum.E] = { AtkMin = 17, AtkMax = 19, BonusText = "" },
				[_QualityEnum.D] = { AtkMin = 19, AtkMax = 21, BonusText = "" },
				[_QualityEnum.C] = { AtkMin = 21, AtkMax = 24, BonusText = "" },
				[_QualityEnum.B] = { AtkMin = 24, AtkMax = 26, BonusText = "" },
				[_QualityEnum.A] = { AtkMin = 26, AtkMax = 28, BonusText = "" },
				[_QualityEnum.S] = { AtkMin = 28, AtkMax = 30, BonusText = "" },
			},
			SkillTexts = {
				"적 100마리 처치 시 Lv.1 썬더 볼트",
				"적 100마리 처치 시 Lv.1 썬더 커터",
				"적 100마리 처치 시 Lv.1 에너지 볼트",
				"적 100마리 처치 시 Lv.1 페페",
			},
		}

		t[_GearGradeEnum.Epic] = {
			Name = "케이그",
			RUID = "thumbnail://545adac7949b48cf9c14fcf1823ea9f4",
			BonusLabel = "공격력",
			QualityStats = {
				[_QualityEnum.F] = { AtkMin = 30, AtkMax = 34, BonusPercentMin = 50, BonusPercentMax = 60 },
				[_QualityEnum.E] = { AtkMin = 34, AtkMax = 39, BonusPercentMin = 50, BonusPercentMax = 60 },
				[_QualityEnum.D] = { AtkMin = 39, AtkMax = 43, BonusPercentMin = 60, BonusPercentMax = 70 },
				[_QualityEnum.C] = { AtkMin = 43, AtkMax = 48, BonusPercentMin = 70, BonusPercentMax = 80 },
				[_QualityEnum.B] = { AtkMin = 48, AtkMax = 52, BonusPercentMin = 80, BonusPercentMax = 90 },
				[_QualityEnum.A] = { AtkMin = 52, AtkMax = 57, BonusPercentMin = 90, BonusPercentMax = 90 },
				[_QualityEnum.S] = { AtkMin = 57, AtkMax = 60, BonusPercentMin = 100, BonusPercentMax = 100 },
			},
		}

		t[_GearGradeEnum.Unique] = {
			Name = "드래곤 스태프",
			RUID = "thumbnail://8c026c5e308e4977892f97bc6e2d012b",
			BonusLabel = "쿨타임",
			QualityStats = {
				[_QualityEnum.F] = { AtkMin = 60, AtkMax = 66, BonusPercentMin = 10, BonusPercentMax = 20 },
				[_QualityEnum.E] = { AtkMin = 66, AtkMax = 72, BonusPercentMin = 10, BonusPercentMax = 20 },
				[_QualityEnum.D] = { AtkMin = 72, AtkMax = 78, BonusPercentMin = 20, BonusPercentMax = 30 },
				[_QualityEnum.C] = { AtkMin = 78, AtkMax = 84, BonusPercentMin = 30, BonusPercentMax = 40 },
				[_QualityEnum.B] = { AtkMin = 84, AtkMax = 90, BonusPercentMin = 30, BonusPercentMax = 40 },
				[_QualityEnum.A] = { AtkMin = 90, AtkMax = 96, BonusPercentMin = 40, BonusPercentMax = 50 },
				[_QualityEnum.S] = { AtkMin = 96, AtkMax = 100, BonusPercentMin = 50, BonusPercentMax = 50 },
			},
		}

		t[_GearGradeEnum.Legendary] = {
			Name = "쟈이힌 스태프",
			RUID = "thumbnail://7664c56f5bac487ba4076423575e9b57",
			-- 확률(%) 부분은 ProcChancePerMille(아이템별 드롭 시 확정 롤, RollProcChancePerMille 참고)로
			-- 실제 값을 관리하므로 QualityStats엔 ATK만 있으면 된다
			QualityStats = {
				[_QualityEnum.F] = { AtkMin = 100, AtkMax = 108 },
				[_QualityEnum.E] = { AtkMin = 108, AtkMax = 115 },
				[_QualityEnum.D] = { AtkMin = 115, AtkMax = 123 },
				[_QualityEnum.C] = { AtkMin = 123, AtkMax = 130 },
				[_QualityEnum.B] = { AtkMin = 130, AtkMax = 138 },
				[_QualityEnum.A] = { AtkMin = 138, AtkMax = 145 },
				[_QualityEnum.S] = { AtkMin = 145, AtkMax = 150 },
			},
			-- 레전더리는 확률(%) 부분이 아이템마다 다른 실제 값(ProcChancePerMille)이라 여기엔 스킬명만
			-- 남겨두고, 등급 스킬 박스(UIEquipPopup.UpdateGradeSkillBox)에서 "기본 공격시 X% 확률 " +
			-- 이 스킬명을 조합해서 보여준다
			SkillTexts = {
				"Lv.3 썬더 볼트",
				"Lv.3 썬더 커터",
				"Lv.3 에너지 볼트",
				"Lv.3 페페",
			},
		}
	end

	method boolean IsWeaponItem(integer itemId)
		return itemId == self.WeaponItemId
	end

	method table GetTierData(integer gradeEnum)
		return self.TierDataTable[gradeEnum]
	end

	method string GetDisplayName(integer gradeEnum)
		local data = self.TierDataTable[gradeEnum]
		if data == nil then
			return "?"
		end
		return data.Name
	end

	method string GetDisplayRUID(integer gradeEnum)
		local data = self.TierDataTable[gradeEnum]
		if data == nil then
			return ""
		end
		return data.RUID
	end

	-- 해당 티어+품질에서 ATK를 그 품질 구간 내 정수로 무작위 굴린다
	method integer RollAtk(integer gradeEnum, integer qualityEnum)
		local data = self.TierDataTable[gradeEnum]
		if data == nil then
			return 0
		end
		local stat = data.QualityStats[qualityEnum]
		if stat == nil then
			return 0
		end
		if stat.AtkMin >= stat.AtkMax then
			return stat.AtkMin
		end
		return math.random(stat.AtkMin, stat.AtkMax)
	end

	-- None/Rare 전용 — 이 두 등급은 수치형 보너스가 없어서 항상 빈 문자열이다(수치형 보너스가 있는
	-- 매직/에픽/유니크/레전더리는 GetActualBonusText를 쓸 것 — 범위가 아니라 그 아이템의 확정값을 보여줌)
	method string GetBonusText(integer gradeEnum, integer qualityEnum)
		return ""
	end

	method string GetBonusLabel(integer gradeEnum)
		local data = self.TierDataTable[gradeEnum]
		if data == nil then
			return nil
		end
		return data.BonusLabel
	end

	-- 해당 티어+품질에서 "공격력/쿨타임 X%" 보너스를 그 품질 구간 내 1000분율로 무작위 굴린다
	-- (ATK/ProcChancePerMille와 동일 패턴 — 드롭/등급업 시 1회 굴려서 아이템에 영구 저장)
	method integer RollBonusPercentPerMille(integer gradeEnum, integer qualityEnum)
		local data = self.TierDataTable[gradeEnum]
		if data == nil then
			return 0
		end
		local stat = data.QualityStats[qualityEnum]
		if stat == nil or stat.BonusPercentMin == nil then
			return 0
		end
		if stat.BonusPercentMin >= stat.BonusPercentMax then
			return stat.BonusPercentMin
		end
		return math.random(stat.BonusPercentMin, stat.BonusPercentMax)
	end

	-- 1000분율 정수를 퍼센트 문자열로 변환(예: 35 -> "3.5", 50 -> "5") — 정수면 소수점을 떼고 보여준다
	method string FormatPercentPerMille(integer perMille)
		local percent = perMille / 10
		if percent == math.floor(percent) then
			return tostring(math.floor(percent))
		end
		return string.format("%.1f", percent)
	end

	-- 등급 스킬 박스/설명에 보여줄 "이 아이템이 실제로 갖는" 확정 텍스트(범위 아님).
	-- bonusPercentPerMille/procChancePerMille는 그 아이템(또는 미리보기 굴림)의 실제 롤 값을 그대로 받는다
	method string GetActualBonusText(integer gradeEnum, integer skillVariant, integer bonusPercentPerMille, integer procChancePerMille)
		if gradeEnum == _GearGradeEnum.Rare then
			return self:GetSkillText(gradeEnum, skillVariant)
		end

		if gradeEnum == _GearGradeEnum.Legendary then
			local skillName = self:GetSkillText(gradeEnum, skillVariant)
			return string.format("기본 공격시 %s%% 확률 %s", self:FormatPercentPerMille(procChancePerMille), skillName)
		end

		local label = self:GetBonusLabel(gradeEnum)
		if label == nil then
			return ""
		end
		return label .. " " .. self:FormatPercentPerMille(bonusPercentPerMille) .. "%"
	end

	method table GetSkillTexts(integer gradeEnum)
		local data = self.TierDataTable[gradeEnum]
		if data == nil then
			return { "-", "-", "-", "-" }
		end
		return data.SkillTexts
	end

	-- 이 아이템 인스턴스가 실제로 부여하는 등급 스킬 텍스트 1개(4개 중 SkillVariant번째) — 표시용
	method string GetSkillText(integer gradeEnum, integer skillVariant)
		local texts = self:GetSkillTexts(gradeEnum)
		local text = texts[skillVariant]
		if text == nil then
			return "-"
		end
		return text
	end

	-- 레어/레전더리만 등급 스킬 1~4가 서로 다른 실제 스킬(썬더볼트/썬더커터/에너지볼트/페페)이라
	-- SkillVariant가 게임플레이에 의미를 가진다. 그 외 등급(매직/에픽/유니크)은 4칸이 전부 동일한
	-- 수치형 보너스(공격력%/쿨타임%)라 어느 변형이 걸리든 결과가 같다.
	method boolean IsSkillVariantMeaningful(integer gradeEnum)
		return gradeEnum == _GearGradeEnum.Rare or gradeEnum == _GearGradeEnum.Legendary
	end

	-- 무기 드롭 시 등급 스킬 변형(1~4)을 균등 랜덤으로 굴린다(유저 지정)
	method integer RollSkillVariant()
		return _UtilLogic:RandomIntegerRange(1, 4)
	end

	-- 레전더리 전용 "기본공격 확률발동" 수치(1000분율) — BonusText 표(품질별 "확률 X~Y%")의 구간 안에서
	-- ATK와 동일하게 드롭 시 1회 확정 롤(중앙값 고정 아님, 유저 지정: 아이템마다 실제 값이 달라야 함).
	-- S는 구간이 아니라 "5%" 고정 텍스트라 그대로 50 고정
	method integer RollProcChancePerMille(integer qualityEnum)
		local ranges = {
			[_QualityEnum.F] = { 10, 20 },
			[_QualityEnum.E] = { 10, 20 },
			[_QualityEnum.D] = { 20, 30 },
			[_QualityEnum.C] = { 30, 40 },
			[_QualityEnum.B] = { 30, 40 },
			[_QualityEnum.A] = { 40, 50 },
			[_QualityEnum.S] = { 50, 50 },
		}
		local r = ranges[qualityEnum]
		if r == nil then return 10 end
		if r[1] >= r[2] then return r[1] end
		return math.random(r[1], r[2])
	end

	-- 유저 강한 정정: 등급업 때마다 새로 굴리면 미리보기(등급 스킬 박스)에서 본 값과 실제로 그 등급에
	-- 도달했을 때 받는 값이 달라질 수 있다 — "F품질이면 F품질에 해당하는 값을 승계받아야지, 등급업했다고
	-- 갑자기 엉뚱한 값이 나오면 안 된다"는 요구. 그래서 드롭 시 이 아이템의 Quality로 None~레전더리
	-- "모든" 등급의 ATK/보너스를 한 번에 굴려서 영구 저장해두고(ItemGearStruct.AtkByGrade /
	-- BonusPercentPerMilleByGrade), 등급업은 그중 이미 정해진 값을 꺼내 쓰기만 한다(재굴림 없음).
	-- 미리보기(등급 스킬 박스)도 이 표를 그대로 읽으므로 "미리 본 값 = 실제로 받는 값"이 항상 보장된다.
	method table RollAtkByGrade(integer qualityEnum)
		local result = {}
		for grade = _GearGradeEnum.None, _GearGradeEnum.Legendary do
			result[grade] = self:RollAtk(grade, qualityEnum)
		end
		return result
	end

	method table RollBonusPercentPerMilleByGrade(integer qualityEnum)
		local result = {}
		for grade = _GearGradeEnum.None, _GearGradeEnum.Legendary do
			result[grade] = self:RollBonusPercentPerMille(grade, qualityEnum)
		end
		return result
	end

end
