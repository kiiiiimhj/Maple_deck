	-- 신규 8개 라인 — 등급당: Name, RUID, StatMin/StatMax(스탯 있는 라인만),
	-- Template(등급 스킬 텍스트, "{P}"=BonusPercentPerMille 자리·"{C}"=ProcChancePerMille 자리),
	-- PercentMin/Max({P} 굴림 구간, %), Percent2Min/Max({C} 굴림 구간, % — 자마다르 레전더리만 사용)
	--
	-- RUID는 전부 avataritem이라 렌더러에 넣을 땐 "thumbnail://" 접두사가 필요하다(스태프와 동일).
	-- 48개 전부 실존 리소스로 확인 완료 — 초안 이름 중 리소스에 없던 것들은 유저가 실존 아이템명으로
	-- 재지정했다(장갑/망토 라인 전체, 슈트A 매직·에픽·유니크, 투구 유니크).
	method void InitNewItemTierData()
		local t = {}
		self.NewItemTierDataTable = t

		-- 반지 (유저 표 2026-09-21: ATK 5~10/10~15/15~30/30~60/60~100/100~150,
		--                          HP  5~10/10~15/15~25/25~50/50~70/70~100)
		-- ⚠ 이름은 유저가 "이미지에 어울리게 네가 정해라"고 해서 아이콘 생김새를 직접 보고 붙였다.
		-- ⚠ RUID는 avataritem이 아니라 **item 카테고리 sprite**지만 "thumbnail://"를 반드시 붙인다.
		--   넥슨 인덱스의 아이템 스프라이트는 pivot 메타데이터가 중앙(0.5,0.5)이 아니라 0 근처거나
		--   음수다(실측: 0abf98bb nx=0.0556/ny=0.0278, 2c7af7dc nx=-0.0625/ny=-0.0312). 그대로 넣으면
		--   슬롯 안에서 오른쪽 위로 밀려 그려진다(유저 스크린샷 2026-09-21). thumbnail://은 원본이
		--   아니라 정규화된 썸네일을 그려서 이 pivot 문제를 우회한다 — 다른 8개 라인이 전부
		--   thumbnail://를 쓰는 것과 결과적으로 같은 형태가 된다.
		-- ⚠ Template은 여기 두지 않는다 — 반지는 등급마다 5종 중 1종이 따로 정해지므로
		--   GetActualBonusText가 RingSkillTemplates에서 꺼내 쓴다. 노말은 스킬 없음(유저 표의 "x").
		t[self.RingItemId] = {
			[_GearGradeEnum.None] = { Name = "MLUA_WEAPONTIERDATALOGIC_082", RUID = "thumbnail://0abf98bb5e4f49bb8fb3b3cf84929812",
				StatMin = 5, StatMax = 10, HpMin = 5, HpMax = 10, Template = "-" },
			[_GearGradeEnum.Magic] = { Name = "MLUA_WEAPONTIERDATALOGIC_083", RUID = "thumbnail://73ca0e4627034d4ca324255bce6bab9d",
				StatMin = 10, StatMax = 15, HpMin = 10, HpMax = 15, PercentMin = 1, PercentMax = 3 },
			[_GearGradeEnum.Rare] = { Name = "MLUA_WEAPONTIERDATALOGIC_084", RUID = "thumbnail://880f1e8546a54adbaeac8fc1dae23d75",
				StatMin = 15, StatMax = 30, HpMin = 15, HpMax = 25, PercentMin = 1, PercentMax = 3 },
			[_GearGradeEnum.Epic] = { Name = "MLUA_WEAPONTIERDATALOGIC_085", RUID = "thumbnail://575ec64c7f314bdbb9d084c46dc87e8b",
				StatMin = 30, StatMax = 60, HpMin = 25, HpMax = 50, PercentMin = 1, PercentMax = 3 },
			[_GearGradeEnum.Unique] = { Name = "MLUA_WEAPONTIERDATALOGIC_086", RUID = "thumbnail://1336531df5f84ce6935c41abe4526928",
				StatMin = 60, StatMax = 100, HpMin = 50, HpMax = 70, PercentMin = 1, PercentMax = 3 },
			[_GearGradeEnum.Legendary] = { Name = "MLUA_WEAPONTIERDATALOGIC_087", RUID = "thumbnail://2c7af7dc133643fd8913bd64a5192b34",
				StatMin = 100, StatMax = 150, HpMin = 70, HpMax = 100, PercentMin = 1, PercentMax = 3 },
		}

		-- 목걸이(자쿰 레이드 보상) — 수치·등급 스킬 범위는 반지와 똑같다(유저 지정 "옵션은 반지랑 동일").
		-- 아이콘은 등급이 오를수록 화려해지게 골랐다(2026-09-23, 썸네일 직접 확인):
		--   노멀 은 펜던트 → 매직 푸른 구슬 → 레어 황금 로켓 → 에픽 무지개 하트 → 유니크 보라 보석 → 레전더리 혼테일 펜던트.
		-- 반지와 같은 이유로 item sprite에도 "thumbnail://"를 붙인다(넥슨 아이템 스프라이트 pivot 문제 우회).
		t[self.NecklaceItemId] = {
			[_GearGradeEnum.None] = { Name = "MLUA_WEAPONTIERDATALOGIC_165", RUID = "thumbnail://15e6bf4685634c6981c2c1d6963e95fa",
