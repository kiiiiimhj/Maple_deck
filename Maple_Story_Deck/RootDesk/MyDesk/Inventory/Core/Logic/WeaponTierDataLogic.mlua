-- 장비 티어(GearGradeEnum 6단계) ↔ 실제 장비 데이터(이름/아이콘/스탯/등급 스킬) 매핑(유저 지정).
-- 각 장비 "라인"(스태프/활/양손검/자마다르/슈트A/슈트B/투구/장갑/망토)은 전부 같은 ItemId(하나의
-- GUID)를 유지하고, Grade(티어)에 따라 이름/아이콘/스탯/텍스트가 동적으로 바뀐다.
--
-- 2026-08-17 확장: 원래 스태프(ItemId 60002) 하나만 관리하던 구조를 여러 장비 라인으로 일반화했다.
-- 스태프는 기존 검증된 데이터(SkillVariant 4종 + 실제 스킬카드 프록, ProcChancePerMille)를 한 글자도
-- 안 건드리고 LegacyTierDataTable에 그대로 남겨뒀고, 새로 추가된 8개 라인(전부 공용 아이템, 캐릭터
-- 구분 없음)은 NewItemTierDataTable에 훨씬 단순한 스키마로 들어간다 — 등급 스킬은 실제 스킬카드를
-- 프록시키지 않고, "{P}"/"{C}" 플레이스홀더가 있는 텍스트 템플릿에 롤한 값을 끼워넣기만 한다.
-- ⚠ 등급 스킬 효과(치명타%, 회복, 무적 등)의 실제 전투 로직 연결은 이번 패스 범위 밖 — 데이터/UI만 완성.
@Logic
script WeaponTierDataLogic extends Logic

	-- 레거시 무기(스태프) 전용 — SkillVariant 기반 실제 스킬카드 프록(TryProcWeaponSkill, CardManager)이
	-- 걸려있는 유일한 아이템. IsWeaponItem은 신규 라인까지 전부 포함하도록 넓어졌으므로, "진짜 스킬 프록
	-- 대상인지"를 구분해야 하는 호출부(CardManager.InitWeaponSkillForRun)는 이 프로퍼티와 직접 비교할 것.
	property integer WeaponItemId = 60002

	-- 반지(2026-09-21 신설, 레이드 보상 전용 라인). 다른 라인과 다른 점 두 가지:
	--   ① 메인 옵션이 **공격력이거나 최대 체력이거나 둘 중 하나**다(유저 지정 2026-09-21 정정).
	--      이름·등급·아이콘은 전부 같고 옵션만 갈린다. 등급 데이터에 ATK용 StatMin/StatMax와
	--      HP용 HpMin/HpMax를 둘 다 적어두고, 드롭 시 `ItemGearStruct.MainStatType`(1=ATK/2=HP)로
	--      한쪽을 확정한 뒤 **반대쪽 수치와 등급별 표를 0으로 눌러서** 저장한다.
	--      ⚠ 처음(2026-09-21 오전)엔 ATK+HP를 동시에 주는 구조였다 — 옛 반지는 MainStatType 0이라
	--        PkgPlayerInventory.BackfillMissingGearStats가 로그인 때 굴려서 한쪽으로 정리한다.
	--   ② 등급 스킬이 등급마다 고정 문구가 아니라 **등급마다 5종 중 1종이 랜덤으로 확정**된다
	--      (1~5 = 공격력/치명타 확률/치명타 피해/최대 체력/스킬 쿨타임, 값은 1~3%).
	--      드롭 시 전 등급을 한 번에 굴려 `ItemGearStruct.SkillVariantByGrade`에 저장한다 —
	--      그래서 한 반지 안에서도 "매직은 치확, 레어는 쿨감…"처럼 줄마다 다르다.
	--      ⚠ 처음(2026-09-21 오전)엔 아이템당 1종이라 등급 표 5줄이 전부 같은 문구로 나왔다(유저 지적).
	--      ⚠ 이건 메인 옵션(MainStatType)과 **별개 축**이다 — 이름이 비슷해 헷갈리기 쉽다.
	-- ⚠ 아바타에 반지 슬롯이 없어 AvatarCategoryTable에 일부러 넣지 않았다(인벤/스탯 전용).
	-- ⚠ GearItemIdsByEpisode 어디에도 넣지 않는다 — 몬스터 드롭/방치 보상으로는 나오지 않고 레이드 전용.
	property integer RingItemId = 110002

	-- 목걸이(2026-09-23 유저 지정, **자쿰 레이드 보상 전용**). 옵션 구조는 반지와 완전히 같다 —
	-- 메인 옵션 공격/체력 택1(MainStatType) + 등급마다 5종 중 1종 등급 스킬(SkillVariantByGrade).
	-- 그래서 IsRing()이 목걸이도 true를 돌려준다(반지 전용 처리 전부를 그대로 탄다). 부위는 Pendant.
	-- 반지처럼 아바타 슬롯이 없어 AvatarCategoryTable에 넣지 않았고, 몬스터 드롭 풀에도 넣지 않는다.
	property integer NecklaceItemId = 100002

	-- ItemGearStruct.MainStatType 값(반지 전용). 0은 "미지정"이라 여기 없다
	property integer RingMainStatAtk = 1

	property integer RingMainStatHp = 2

	-- 신규 8개 라인의 ItemId(전부 공용 아이템)
	property integer BowItemId = 60003

	property integer TwoHandSwordItemId = 60004

	property integer JamadarItemId = 60005

	property integer SuitAItemId = 20002

	property integer SuitBItemId = 20003

	property integer HelmItemId = 10002

	property integer GloveItemId = 30002

	property integer CapeItemId = 50002

	-- 이 로직이 관리하는 전체 ItemId 집합(멤버십 체크에 사용)
	property table GearItemIds = {}

	-- 에피소드(= 월드 선택 팝업의 _worldIndex) -> 그 맵에서만 드롭되는 장비 ItemId 목록.
	-- 유저 지정: 태초의 마을=무기만 / 구름정원=갑옷·모자만 / 엘라스 산맥=나머지 2개(장갑·망토).
	-- 월드 선택 팝업의 맵 사진 우측 하단 부위 아이콘 배지가 이 분배와 같은 내용을 보여준다
	-- (WorldCharacterSelectUI._worlds.partIcons) — 한쪽만 고치면 표시와 실제가 어긋나므로 같이 고칠 것.
	property table GearItemIdsByEpisode = {}

	-- itemId -> "Atk" | "Hp" | nil(스탯 없음, 등급 스킬 텍스트만 있는 아이템)
	property table StatFieldTable = {}

	-- itemId -> 그 라인 아바타 아이템의 실제 카테고리(GearCategoryEnum 값). 인벤토리 슬롯 배치용
	-- GearCategory와 별개다 — 유저 지정으로 무기 4종을 전부 한 슬롯(OneHandedWeapon)에서 경쟁시키지만,
	-- 아바타 리소스상 활/양손검은 twohandweapon이라 SetEquip에 OneHandedWeapon을 넘기면
	-- "[LEA-3005] 유효한 아이템 카테고리가 아닙니다"로 거부당한다(실측 확인).
	property table AvatarCategoryTable = {}

	-- 레거시 스태프 전용 데이터(기존 그대로, 절대 수정 금지)
	property table LegacyTierDataTable = {}

	-- 신규 8개 라인 데이터(+ 반지)
	property table NewItemTierDataTable = {}

	-- 반지 등급 스킬 5종 템플릿(SkillVariant 1~5 순서) — Init에서 채운다
	property table RingSkillTemplates = {}

	-- itemId -> grade -> 아이템 플레이버 설명(장비 정보 팝업 상단 설명란에 그대로 출력).
	-- 등급마다 이름이 달라지는(= 사실상 다른 아이템인) 구조라 등급별로 각각 쓴다.
	-- 유저 지정: 품질(F~SS) 관련 내용은 넣지 않는다 — 순수 아이템 설정 문구만.
	property table DescTable = {}

	method void Init()
		local gearItemIds = { self.WeaponItemId, self.BowItemId, self.TwoHandSwordItemId, self.JamadarItemId,
			self.SuitAItemId, self.SuitBItemId, self.HelmItemId, self.GloveItemId, self.CapeItemId,
			self.RingItemId, self.NecklaceItemId }
		self.GearItemIds = gearItemIds

		-- 반지 등급 스킬 5종(1~5). 드롭 시 **등급마다** 1종씩 확정돼 영구 저장된다.
		-- 쿨타임만 "감소"라 문구가 달라서 라벨이 아니라 템플릿 통째로 들고 있는다.
		self.RingSkillTemplates = {
			"MLUA_WEAPONTIERDATALOGIC_001",
			"MLUA_WEAPONTIERDATALOGIC_002",
			"MLUA_WEAPONTIERDATALOGIC_003",
			"MLUA_WEAPONTIERDATALOGIC_004",
			"MLUA_WEAPONTIERDATALOGIC_005",
		}

		local byEpisode = {}
		self.GearItemIdsByEpisode = byEpisode
		-- 태초의 마을: 무기 4종(스태프/활/양손검/자마다르)
		byEpisode[1] = { self.WeaponItemId, self.BowItemId, self.TwoHandSwordItemId, self.JamadarItemId }
		-- 구름정원: 갑옷 2종(슈트A/슈트B) + 모자
		byEpisode[2] = { self.SuitAItemId, self.SuitBItemId, self.HelmItemId }
		-- 엘라스 산맥: 장갑 + 망토
		byEpisode[3] = { self.GloveItemId, self.CapeItemId }

		local statFieldTable = {}
		self.StatFieldTable = statFieldTable
		statFieldTable[self.WeaponItemId] = "Atk"
		statFieldTable[self.BowItemId] = "Atk"
		statFieldTable[self.TwoHandSwordItemId] = "Atk"
		statFieldTable[self.JamadarItemId] = "Atk"
		statFieldTable[self.SuitAItemId] = "Hp"
		statFieldTable[self.SuitBItemId] = "Hp"
		-- 2026-09-02 유저 지정: 투구/장갑/망토도 기본 스탯을 갖는다(예전엔 등급 스킬 텍스트만 있었다).
		--   투구 = 공격력(무기의 절반), 장갑/망토 = 체력(갑옷의 절반).
		-- 실제 수치 구간은 InitNewItemTierData 의 StatMin/StatMax 참고.
		statFieldTable[self.HelmItemId] = "Atk"
		statFieldTable[self.GloveItemId] = "Hp"
		statFieldTable[self.CapeItemId] = "Hp"
		-- 반지는 ATK/HP를 둘 다 갖는 유일한 라인이다. StatFieldTable은 한 칸뿐이라 ATK만 등록하고,
		-- HP는 등급 데이터의 HpMin/HpMax를 RollHp가 직접 읽는다(아래 RollHp 주석 참고).
		statFieldTable[self.RingItemId] = "Atk"
		statFieldTable[self.NecklaceItemId] = "Atk"

		-- 아바타 리소스 실측(2026-08-17 batch 조회)으로 확정한 라인별 실제 카테고리
		local avatarCategoryTable = {}
		self.AvatarCategoryTable = avatarCategoryTable
		avatarCategoryTable[self.WeaponItemId] = _GearCategoryEnum.OneHandedWeapon      -- 스태프: weapon
		avatarCategoryTable[self.JamadarItemId] = _GearCategoryEnum.OneHandedWeapon     -- 자마다르: weapon
		avatarCategoryTable[self.BowItemId] = _GearCategoryEnum.TwoHandedWeapon         -- 활: twohandweapon
		avatarCategoryTable[self.TwoHandSwordItemId] = _GearCategoryEnum.TwoHandedWeapon -- 양손검: twohandweapon
		avatarCategoryTable[self.SuitAItemId] = _GearCategoryEnum.Longcoat
		avatarCategoryTable[self.SuitBItemId] = _GearCategoryEnum.Longcoat
		avatarCategoryTable[self.HelmItemId] = _GearCategoryEnum.Cap
		avatarCategoryTable[self.GloveItemId] = _GearCategoryEnum.Glove
		avatarCategoryTable[self.CapeItemId] = _GearCategoryEnum.Cape

		self:InitLegacyTierData()
		self:InitNewItemTierData()
		self:InitDescriptions()
	end

	-- 9개 라인 × 6등급 = 54개 아이템의 설명 문구. 이름이 등급마다 바뀌므로 등급별로 따로 쓴다.
	method void InitDescriptions()
		local d = {}
		self.DescTable = d

		-- 스태프(레거시)
		d[self.WeaponItemId] = {
			[_GearGradeEnum.None] = "MLUA_WEAPONTIERDATALOGIC_006",
			[_GearGradeEnum.Magic] = "MLUA_WEAPONTIERDATALOGIC_007",
			[_GearGradeEnum.Rare] = "MLUA_WEAPONTIERDATALOGIC_008",
			[_GearGradeEnum.Epic] = "MLUA_WEAPONTIERDATALOGIC_009",
			[_GearGradeEnum.Unique] = "MLUA_WEAPONTIERDATALOGIC_010",
			[_GearGradeEnum.Legendary] = "MLUA_WEAPONTIERDATALOGIC_011",
		}

		-- 활
		d[self.BowItemId] = {
			[_GearGradeEnum.None] = "MLUA_WEAPONTIERDATALOGIC_012",
			[_GearGradeEnum.Magic] = "MLUA_WEAPONTIERDATALOGIC_013",
			[_GearGradeEnum.Rare] = "MLUA_WEAPONTIERDATALOGIC_014",
			[_GearGradeEnum.Epic] = "MLUA_WEAPONTIERDATALOGIC_015",
			[_GearGradeEnum.Unique] = "MLUA_WEAPONTIERDATALOGIC_016",
			[_GearGradeEnum.Legendary] = "MLUA_WEAPONTIERDATALOGIC_017",
		}

		-- 양손검
		d[self.TwoHandSwordItemId] = {
			[_GearGradeEnum.None] = "MLUA_WEAPONTIERDATALOGIC_018",
			[_GearGradeEnum.Magic] = "MLUA_WEAPONTIERDATALOGIC_019",
			[_GearGradeEnum.Rare] = "MLUA_WEAPONTIERDATALOGIC_020",
			[_GearGradeEnum.Epic] = "MLUA_WEAPONTIERDATALOGIC_021",
			[_GearGradeEnum.Unique] = "MLUA_WEAPONTIERDATALOGIC_022",
			[_GearGradeEnum.Legendary] = "MLUA_WEAPONTIERDATALOGIC_023",
		}

		-- 자마다르(단검)
		d[self.JamadarItemId] = {
			[_GearGradeEnum.None] = "MLUA_WEAPONTIERDATALOGIC_024",
			[_GearGradeEnum.Magic] = "MLUA_WEAPONTIERDATALOGIC_025",
			[_GearGradeEnum.Rare] = "MLUA_WEAPONTIERDATALOGIC_026",
			[_GearGradeEnum.Epic] = "MLUA_WEAPONTIERDATALOGIC_027",
			[_GearGradeEnum.Unique] = "MLUA_WEAPONTIERDATALOGIC_028",
			[_GearGradeEnum.Legendary] = "MLUA_WEAPONTIERDATALOGIC_029",
		}

		-- 슈트A(드라카즈 제복 계열)
		-- ⚠ 유니크/에픽은 유저가 준 목록의 이름("프로스티 슈트"/"여제의 훌륭한 로브")과 실제 등록명
		-- ("템페스트 후드로브"/"여제의 쓸만한 로브")이 다르다. 등급 순서 기준으로 그대로 배치했다.
		d[self.SuitAItemId] = {
			[_GearGradeEnum.None] = "MLUA_WEAPONTIERDATALOGIC_030",
			[_GearGradeEnum.Magic] = "MLUA_WEAPONTIERDATALOGIC_031",
			[_GearGradeEnum.Rare] = "MLUA_WEAPONTIERDATALOGIC_032",
			[_GearGradeEnum.Epic] = "MLUA_WEAPONTIERDATALOGIC_033",
			[_GearGradeEnum.Unique] = "MLUA_WEAPONTIERDATALOGIC_034",
			[_GearGradeEnum.Legendary] = "MLUA_WEAPONTIERDATALOGIC_035",
		}

		-- 슈트B(기사단 제복 계열)
		-- ⚠ 갑옷 라인은 슈트A/슈트B 두 줄인데 유저가 준 목록에는 슈트A 6개만 있었다.
		-- 이 6개는 유저 문구 톤(짧은 한 줄 + 가벼운 유머)에 맞춰 임시로 채운 것 — 확인 후 교체 필요.
		d[self.SuitBItemId] = {
			[_GearGradeEnum.None] = "MLUA_WEAPONTIERDATALOGIC_036",
			[_GearGradeEnum.Magic] = "MLUA_WEAPONTIERDATALOGIC_037",
			[_GearGradeEnum.Rare] = "MLUA_WEAPONTIERDATALOGIC_038",
			[_GearGradeEnum.Epic] = "MLUA_WEAPONTIERDATALOGIC_039",
			[_GearGradeEnum.Unique] = "MLUA_WEAPONTIERDATALOGIC_040",
			[_GearGradeEnum.Legendary] = "MLUA_WEAPONTIERDATALOGIC_041",
		}

		-- 투구
		-- ⚠ 유니크는 유저 목록의 이름("스텔라 깃털모자")과 실제 등록명("템페스트 깃털모자")이 다르다.
		d[self.HelmItemId] = {
			[_GearGradeEnum.None] = "MLUA_WEAPONTIERDATALOGIC_042",
			[_GearGradeEnum.Magic] = "MLUA_WEAPONTIERDATALOGIC_043",
			[_GearGradeEnum.Rare] = "MLUA_WEAPONTIERDATALOGIC_044",
			[_GearGradeEnum.Epic] = "MLUA_WEAPONTIERDATALOGIC_045",
			[_GearGradeEnum.Unique] = "MLUA_WEAPONTIERDATALOGIC_046",
			[_GearGradeEnum.Legendary] = "MLUA_WEAPONTIERDATALOGIC_047",
		}

		-- 장갑
		-- ⚠ 레어는 유저 목록의 이름("레더 글로브")과 실제 등록명("하드레더 글로브")이 다르다.
		d[self.GloveItemId] = {
			[_GearGradeEnum.None] = "MLUA_WEAPONTIERDATALOGIC_048",
			[_GearGradeEnum.Magic] = "MLUA_WEAPONTIERDATALOGIC_049",
			[_GearGradeEnum.Rare] = "MLUA_WEAPONTIERDATALOGIC_050",
			[_GearGradeEnum.Epic] = "MLUA_WEAPONTIERDATALOGIC_051",
			[_GearGradeEnum.Unique] = "MLUA_WEAPONTIERDATALOGIC_052",
			[_GearGradeEnum.Legendary] = "MLUA_WEAPONTIERDATALOGIC_053",
		}

		-- 반지(레이드 보상 전용)
		d[self.RingItemId] = {
			[_GearGradeEnum.None] = "MLUA_WEAPONTIERDATALOGIC_054",
			[_GearGradeEnum.Magic] = "MLUA_WEAPONTIERDATALOGIC_055",
			[_GearGradeEnum.Rare] = "MLUA_WEAPONTIERDATALOGIC_056",
			[_GearGradeEnum.Epic] = "MLUA_WEAPONTIERDATALOGIC_057",
			[_GearGradeEnum.Unique] = "MLUA_WEAPONTIERDATALOGIC_058",
			[_GearGradeEnum.Legendary] = "MLUA_WEAPONTIERDATALOGIC_059",
		}

		-- 목걸이(자쿰 레이드 보상 전용)
		d[self.NecklaceItemId] = {
			[_GearGradeEnum.None] = "MLUA_WEAPONTIERDATALOGIC_171",
			[_GearGradeEnum.Magic] = "MLUA_WEAPONTIERDATALOGIC_172",
			[_GearGradeEnum.Rare] = "MLUA_WEAPONTIERDATALOGIC_173",
			[_GearGradeEnum.Epic] = "MLUA_WEAPONTIERDATALOGIC_174",
			[_GearGradeEnum.Unique] = "MLUA_WEAPONTIERDATALOGIC_175",
			[_GearGradeEnum.Legendary] = "MLUA_WEAPONTIERDATALOGIC_176",
		}

		-- 망토
		d[self.CapeItemId] = {
			[_GearGradeEnum.None] = "MLUA_WEAPONTIERDATALOGIC_060",
			[_GearGradeEnum.Magic] = "MLUA_WEAPONTIERDATALOGIC_061",
			[_GearGradeEnum.Rare] = "MLUA_WEAPONTIERDATALOGIC_062",
			[_GearGradeEnum.Epic] = "MLUA_WEAPONTIERDATALOGIC_063",
			[_GearGradeEnum.Unique] = "MLUA_WEAPONTIERDATALOGIC_064",
			[_GearGradeEnum.Legendary] = "MLUA_WEAPONTIERDATALOGIC_065",
		}
	end

	-- 팝업 설명란용. 등록되지 않은 조합이면 빈 문자열을 돌려준다(호출부에서 대체 문구 처리)
	method string GetDescription(integer itemId, integer gradeEnum)
		local byItem = self.DescTable[itemId]
		if byItem == nil then
			return ""
		end

		local text = byItem[gradeEnum]
		if text == nil then
			return ""
		end

		return text
	end

