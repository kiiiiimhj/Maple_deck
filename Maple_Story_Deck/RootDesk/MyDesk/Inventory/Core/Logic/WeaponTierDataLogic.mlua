			[_GearGradeEnum.Magic] = { Name = "MLUA_WEAPONTIERDATALOGIC_089", RUID = "thumbnail://d1df8ca59a99400c97a98668c183b283", StatMin = 20, StatMax = 30, Template = "MLUA_WEAPONTIERDATALOGIC_090", PercentMin = 5, PercentMax = 10 },
