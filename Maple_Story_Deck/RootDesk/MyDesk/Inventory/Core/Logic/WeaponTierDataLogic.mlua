			RUID = "thumbnail://3ed87f7c028c49f9b72eaa68dfa83646",
			QualityStats = {
				[_QualityEnum.F] = { AtkMin = 10, AtkMax = 10, BonusText = "공격력 2%" },
				[_QualityEnum.E] = { AtkMin = 10, AtkMax = 11, BonusText = "공격력 2~3%" },
				[_QualityEnum.D] = { AtkMin = 11, AtkMax = 12, BonusText = "공격력 2~3%" },
				[_QualityEnum.C] = { AtkMin = 12, AtkMax = 13, BonusText = "공격력 3~4%" },
				[_QualityEnum.B] = { AtkMin = 13, AtkMax = 14, BonusText = "공격력 4%" },
				[_QualityEnum.A] = { AtkMin = 14, AtkMax = 15, BonusText = "공격력 4~5%" },
				[_QualityEnum.S] = { AtkMin = 15, AtkMax = 15, BonusText = "공격력 5%" },
			},
			SkillTexts = { "공격력 2~5%", "공격력 2~5%", "공격력 2~5%", "공격력 2~5%" },
		}

		t[_GearGradeEnum.Rare] = {
			Name = "이블윙즈",
			RUID = "thumbnail://364ee9432c284089a568d1b51059d795",
			QualityStats = {
				[_QualityEnum.F] = { AtkMin = 15, AtkMax = 17, BonusText = "" },
				[_QualityEnum.E] = { AtkMin = 17, AtkMax = 19, BonusText = "" },
				[_QualityEnum.D] = { AtkMin = 19, AtkMax = 21, BonusText = "" },
				[_QualityEnum.C] = { AtkMin = 21, AtkMax = 24, BonusText = "" },
