			-- 리소스상 정식명은 "이카루스의 망토"(조사 차이) — 동일 아이템으로 판단해 사용
			[_GearGradeEnum.Rare] = { Name = "이카루스 망토", RUID = "thumbnail://06f3692b69e24e98b3a267cfb3a7ffa6", StatMin = 12, StatMax = 20, Template = "몬스터 50마리 처치 시 피해량 +{P}% (10초)", PercentMin = 5, PercentMax = 10 },
			[_GearGradeEnum.Epic] = { Name = "검은색 가이아의 망토", RUID = "thumbnail://ce304b7a79fd4a848c1a8a077cc7c7f2", StatMin = 20, StatMax = 40, Template = "엘리트/보스 몬스터에게 주는 피해량 +{P}%", PercentMin = 5, PercentMax = 10 },
			[_GearGradeEnum.Unique] = { Name = "빨간색 세라프의 망토", RUID = "thumbnail://4bec629a08ea405ab4c70dec185a66b4", StatMin = 40, StatMax = 56, Template = "체력 +{P}%", PercentMin = 3, PercentMax = 8 },
			[_GearGradeEnum.Legendary] = { Name = "파란색 자일즈의 망토", RUID = "thumbnail://e63d1cda980b4f6d897b38bbd54d02f8", StatMin = 56, StatMax = 80, Template = "엘리트/보스 몬스터에게 주는 피해량 +{P}%", PercentMin = 10, PercentMax = 15 },
		}
	end

	-- ── 공용 조회 ──────────────────────────────────────────────────────────

	method boolean IsWeaponItem(integer itemId)
		if self.GearItemIds == nil then
			return false
		end
		for i, id in ipairs(self.GearItemIds) do
			if id == itemId then
				return true
			end
		end
		return false
	end

	method boolean IsLegacyWeapon(integer itemId)
		return itemId == self.WeaponItemId
	end

	-- 그 에피소드에서 드롭될 수 있는 장비 ItemId 목록. 알 수 없는 에피소드 값이면 전체 풀로 폴백한다
	-- (분배 표에 없는 신규 에피소드가 생겨도 드롭이 통째로 막히지 않게)
	method table GetGearItemIdsByEpisode(integer episode)
		local ids = self.GearItemIdsByEpisode[episode]
		if ids == nil then
			return self.GearItemIds
		end

		return ids
	end

	-- "Atk" | "Hp" | nil
	method string GetStatField(integer itemId)
		return self.StatFieldTable[itemId]
	end

	-- 아바타 착용 시 SetEquip에 넘겨야 하는 카테고리(GearCategoryEnum 값). 인벤토리 슬롯 배치용
	-- GearCategory와 다를 수 있다(활/양손검) — 반드시 이걸 거쳐서 MapleAvatarItemCategory로 변환할 것.
	-- 등록되지 않은 아이템이면 -1
	method integer GetAvatarGearCategory(integer itemId)
		local c = self.AvatarCategoryTable[itemId]
		if c == nil then
			return -1
		end
		return c
	end

	method table GetTierData(integer itemId, integer gradeEnum)
		if self:IsLegacyWeapon(itemId) then
			return self.LegacyTierDataTable[gradeEnum]
		end
		local line = self.NewItemTierDataTable[itemId]
		if line == nil then
			return nil
		end
		return line[gradeEnum]
	end

	method string GetDisplayName(integer itemId, integer gradeEnum)
		local data = self:GetTierData(itemId, gradeEnum)
		if data == nil then
			return "?"
		end
		return data.Name
	end

	method string GetDisplayRUID(integer itemId, integer gradeEnum)
		local data = self:GetTierData(itemId, gradeEnum)
		if data == nil then
			return ""
		end
		return data.RUID
	end

	-- 아바타 착용(CostumeManagerComponent.SetEquip)용 RUID — UI 아이콘용 GetDisplayRUID와 달리
	-- "thumbnail://" 접두사를 반드시 떼야 한다. Custom*Equip 슬롯은 접두사가 붙은 값을 조용히
	-- 거부해서(에러/경고 없이 미착용) 아바타에 아무것도 안 입혀지는 무증상 실패가 난다.
	-- 등급마다 실제 외형이 다르므로 UI 아이콘과 동일하게 등급별 RUID를 그대로 쓴다.
	method string GetAvatarRUID(integer itemId, integer gradeEnum)
		local ruid = self:GetDisplayRUID(itemId, gradeEnum)
		if ruid == nil or ruid == "" then
			return ""
		end
		if string.sub(ruid, 1, 12) == "thumbnail://" then
			return string.sub(ruid, 13)
		end
		return ruid
	end

	-- ── 품질 구간 분배(신규 라인 전용) ────────────────────────────────────
	-- 기존 스태프 QualityStats는 손으로 튜닝한 값을 그대로 유지하고, 신규 라인은 등급의 [min,max]
	-- 구간을 F~S 7단계로 균등 분배해서(경계가 이어지는 방식, 기존 스태프 수작업 곡선과 동일 스타일)
	-- 계산으로 산출한다 — 라인 9개 x 등급 6개 x 품질 7단계 숫자를 일일이 손으로 안 채워도 된다.
	method table SplitQualityBands(number min, number max)
		local order = { _QualityEnum.F, _QualityEnum.E, _QualityEnum.D, _QualityEnum.C, _QualityEnum.B, _QualityEnum.A, _QualityEnum.S }
		local bands = {}
		local span = max - min
		local prevMax = min
		for i = 1, 7 do
			local bandMax = min + math.floor(span * i / 7 + 0.5)
			if i == 7 then
				bandMax = max
			end
			bands[order[i]] = { Min = prevMax, Max = bandMax }
			prevMax = bandMax
		end
		return bands
	end

	method integer RollInBand(number min, number max, integer qualityEnum)
		if min == nil or max == nil then
			return 0
		end
		local bands = self:SplitQualityBands(min, max)
		local band = bands[qualityEnum]
		if band == nil then
			return math.floor(min)
		end
		if band.Min >= band.Max then
			return math.floor(band.Min)
		end
		return math.random(math.floor(band.Min), math.floor(band.Max))
	end

	-- ── ATK ────────────────────────────────────────────────────────────────

	method integer RollAtk(integer itemId, integer gradeEnum, integer qualityEnum)
		if self:IsLegacyWeapon(itemId) then
			local data = self.LegacyTierDataTable[gradeEnum]
			if data == nil then
				return 0
			end
			local stat = data.QualityStats[qualityEnum]
			if stat == nil or stat.AtkMin == nil then
				return 0
			end
			if stat.AtkMin >= stat.AtkMax then
				return stat.AtkMin
			end
			return math.random(stat.AtkMin, stat.AtkMax)
		end

		if self:GetStatField(itemId) ~= "Atk" then
			return 0
		end
		local data = self:GetTierData(itemId, gradeEnum)
		if data == nil then
			return 0
		end
		return self:RollInBand(data.StatMin, data.StatMax, qualityEnum)
	end

	method table RollAtkByGrade(integer itemId, integer qualityEnum)
		local result = {}
		for grade = _GearGradeEnum.None, _GearGradeEnum.Legendary do
			result[grade] = self:RollAtk(itemId, grade, qualityEnum)
		end
		return result
	end

	-- ── HP(신규 라인 전용) ───────────────────────────────────────────────

	method integer RollHp(integer itemId, integer gradeEnum, integer qualityEnum)
		if self:GetStatField(itemId) ~= "Hp" then
			return 0
		end
		local data = self:GetTierData(itemId, gradeEnum)
		if data == nil then
			return 0
		end
		return self:RollInBand(data.StatMin, data.StatMax, qualityEnum)
	end

	method table RollHpByGrade(integer itemId, integer qualityEnum)
		local result = {}
		for grade = _GearGradeEnum.None, _GearGradeEnum.Legendary do
			result[grade] = self:RollHp(itemId, grade, qualityEnum)
		end
		return result
	end

	-- ── 보너스 %(BonusPercentPerMille = "{P}" 자리) ─────────────────────

	method string GetBonusLabel(integer itemId, integer gradeEnum)
		if not self:IsLegacyWeapon(itemId) then
			return nil
		end
		local data = self.LegacyTierDataTable[gradeEnum]
		if data == nil then
			return nil
		end
		return data.BonusLabel
	end

	method integer RollBonusPercentPerMille(integer itemId, integer gradeEnum, integer qualityEnum)
		if self:IsLegacyWeapon(itemId) then
			local data = self.LegacyTierDataTable[gradeEnum]
			if data == nil then
				return 0
			end
			local stat = data.QualityStats[qualityEnum]
			if stat == nil or stat.BonusPercentMin == nil then
				return 0
			end
			if stat.BonusPercentMin >= stat.BonusPercentMax then
				return stat.BonusPercentMin
			end
			return math.random(stat.BonusPercentMin, stat.BonusPercentMax)
		end

		local data = self:GetTierData(itemId, gradeEnum)
		if data == nil or data.PercentMin == nil then
			return 0
		end
		return self:RollInBand(data.PercentMin * 10, data.PercentMax * 10, qualityEnum)
	end

	method table RollBonusPercentPerMilleByGrade(integer itemId, integer qualityEnum)
		local result = {}
		for grade = _GearGradeEnum.None, _GearGradeEnum.Legendary do
			result[grade] = self:RollBonusPercentPerMille(itemId, grade, qualityEnum)
		end
		return result
	end

	-- 1000분율 정수를 퍼센트 문자열로 변환(예: 35 -> "3.5", 50 -> "5") — 정수면 소수점을 떼고 보여준다
	method string FormatPercentPerMille(integer perMille)
		local percent = perMille / 10
		if percent == math.floor(percent) then
			return tostring(math.floor(percent))
		end
		return string.format("%.1f", percent)
	end

	-- ── 프록 확률 %(ProcChancePerMille = 레거시 스태프 레전더리 전용 / 신규 라인 "{C}" 자리) ────

	-- 레거시 스태프 레전더리 전용 "기본공격 확률발동" 수치(1000분율) — BonusText 표(품질별
	-- "확률 X~Y%")의 구간 안에서 ATK와 동일하게 드롭 시 1회 확정 롤
	method integer RollProcChancePerMille(integer itemId, integer qualityEnum)
		if self:IsLegacyWeapon(itemId) then
			local ranges = {
				[_QualityEnum.F] = { 10, 20 },
				[_QualityEnum.E] = { 10, 20 },
				[_QualityEnum.D] = { 20, 30 },
				[_QualityEnum.C] = { 30, 40 },
				[_QualityEnum.B] = { 30, 40 },
				[_QualityEnum.A] = { 40, 50 },
				[_QualityEnum.S] = { 50, 50 },
			}
			local r = ranges[qualityEnum]
			if r == nil then return 10 end
			if r[1] >= r[2] then return r[1] end
			return math.random(r[1], r[2])
		end

		-- 신규 라인은 자마다르 레전더리처럼 "{C}" 자리를 쓰는 딱 한 등급에서만 의미가 있다 — 레전더리
		-- 고정 조회(다른 등급은 항상 0)
		local data = self:GetTierData(itemId, _GearGradeEnum.Legendary)
		if data == nil or data.Percent2Min == nil then
			return 0
		end
		return self:RollInBand(data.Percent2Min * 10, data.Percent2Max * 10, qualityEnum)
	end

	-- ── 등급 스킬 텍스트(표시용, 확정값) ────────────────────────────────

	method table GetSkillTexts(integer itemId, integer gradeEnum)
		if not self:IsLegacyWeapon(itemId) then
			return { "-", "-", "-", "-" }
		end
		local data = self.LegacyTierDataTable[gradeEnum]
		if data == nil then
			return { "-", "-", "-", "-" }
		end
		return data.SkillTexts
	end

	-- 이 아이템 인스턴스가 실제로 부여하는 등급 스킬 텍스트 1개(4개 중 SkillVariant번째, 레거시 전용) — 표시용
	method string GetSkillText(integer itemId, integer gradeEnum, integer skillVariant)
		local texts = self:GetSkillTexts(itemId, gradeEnum)
		local text = texts[skillVariant]
		if text == nil then
			return "-"
		end
		return text
	end

	-- 레거시 스태프의 레어/레전더리만 등급 스킬 1~4가 서로 다른 실제 스킬이라 SkillVariant가 의미를
	-- 가진다. 신규 라인은 전부 SkillVariant 무관(항상 1개 텍스트)
	method boolean IsSkillVariantMeaningful(integer itemId, integer gradeEnum)
		return self:IsLegacyWeapon(itemId) and (gradeEnum == _GearGradeEnum.Rare or gradeEnum == _GearGradeEnum.Legendary)
	end

	-- 레거시 스태프 드롭 시 등급 스킬 변형(1~4)을 균등 랜덤으로 굴린다(유저 지정). 신규 라인은 항상 1
	method integer RollSkillVariant()
		return _UtilLogic:RandomIntegerRange(1, 4)
	end

	-- 등급 스킬 박스/설명에 보여줄 "이 아이템이 실제로 갖는" 확정 텍스트(범위 아님).
	-- bonusPercentPerMille/procChancePerMille는 그 아이템(또는 미리보기 굴림)의 실제 롤 값을 그대로 받는다
	method string GetActualBonusText(integer itemId, integer gradeEnum, integer skillVariant, integer bonusPercentPerMille, integer procChancePerMille)
		if self:IsLegacyWeapon(itemId) then
			if gradeEnum == _GearGradeEnum.Rare then
				return self:GetSkillText(itemId, gradeEnum, skillVariant)
			end

			if gradeEnum == _GearGradeEnum.Legendary then
				local skillName = self:GetSkillText(itemId, gradeEnum, skillVariant)
				return string.format("기본 공격시 %s%% 확률 %s", self:FormatPercentPerMille(procChancePerMille), skillName)
			end

			local label = self:GetBonusLabel(itemId, gradeEnum)
			if label == nil then
				return ""
			end
			return label .. " " .. self:FormatPercentPerMille(bonusPercentPerMille) .. "%"
		end

		-- 신규 라인: 템플릿에 "{P}"/"{C}"가 있으면 롤값으로 치환, 없으면 그대로(문자열 고정 효과 or "-")
		local data = self:GetTierData(itemId, gradeEnum)
		if data == nil or data.Template == nil then
			return "-"
		end
		-- ⚠ 템플릿 문자열이 이미 "{P}%" 형태로 퍼센트 기호를 갖고 있다 — 치환값에 "%"를 또 붙이면
		-- 화면에 "5.4%%"로 이중 출력된다(라이브 검증에서 실제로 발견). 숫자만 넣을 것
		local result = data.Template
		result = self:ReplacePlaceholder(result, "{P}", self:FormatPercentPerMille(bonusPercentPerMille))
		result = self:ReplacePlaceholder(result, "{C}", self:FormatPercentPerMille(procChancePerMille))
		return result
	end

	-- string.gsub은 (문자열, 치환횟수) 2개를 반환해서 그대로 대입하면 LSP 경고가 뜬다 — 여기서 한 번만
	-- 받아 문자열만 돌려준다. 치환값에 %가 들어가므로 패턴 치환 대신 find+sub로 직접 잘라 붙인다
	method string ReplacePlaceholder(string source, string token, string value)
		-- 템플릿 문자열의 토큰("{P}"/"{C}") 첫 등장을 value로 바꿔 돌려준다(패턴 해석 없는 평문 치환).
		local startIdx, endIdx = string.find(source, token, 1, true)
		if startIdx == nil then
			return source
		end
		return string.sub(source, 1, startIdx - 1) .. value .. string.sub(source, endIdx + 1)
	end

end
