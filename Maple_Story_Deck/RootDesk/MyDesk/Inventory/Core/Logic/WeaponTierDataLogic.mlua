				"적 100마리 처치 시 Lv.1 썬더 커터",
				"적 100마리 처치 시 Lv.1 에너지 볼트",
				"적 100마리 처치 시 Lv.1 페페",
			},
		}

		t[_GearGradeEnum.Epic] = {
			Name = "케이그",
			RUID = "thumbnail://545adac7949b48cf9c14fcf1823ea9f4",
			QualityStats = {
				[_QualityEnum.F] = { AtkMin = 30, AtkMax = 34, BonusText = "공격력 5~6%" },
				[_QualityEnum.E] = { AtkMin = 34, AtkMax = 39, BonusText = "공격력 5~6%" },
				[_QualityEnum.D] = { AtkMin = 39, AtkMax = 43, BonusText = "공격력 6~7%" },
				[_QualityEnum.C] = { AtkMin = 43, AtkMax = 48, BonusText = "공격력 7~8%" },
