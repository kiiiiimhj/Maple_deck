@Component
script PlayerDBManager extends Component

	property integer TimerId = 0
	property boolean SavingBatch = false

	property boolean IsLoadAttempted = false

	@TargetUserSync
	property boolean IsLoadSuccess = false

	@ExecSpace("ServerOnly")
	method void SaveToDB(boolean isLeaving)
		-- Serialize batches so an old asynchronous snapshot cannot overwrite a newer pet purchase.
		if not self.IsLoadSuccess then
			return
		end
		
		if self.SavingBatch then
			if not isLeaving then return end
			while self.SavingBatch do wait(0.05) end
		end
		self.SavingBatch = true
		local saveData = {}
		local petGenerations = {}
		-------------------------------------------------------------------
		local playerEntity = self.Entity
		playerEntity.PlayerJob:SaveToDB(saveData)
		playerEntity.PkgPlayerInventory:SaveToDB(saveData)
		playerEntity.PlayerRanking:SaveToDB(saveData)
		_PetLogic:SaveFor(playerEntity, saveData, petGenerations)
		-------------------------------------------------------------------
		
		local profileCode = self.Entity.PlayerComponent.ProfileCode
		local ds = _DataStorageService:GetUserDataStorage(profileCode)
		if isLeaving == true then
			local errorCode, values = ds:BatchSetAndWait(saveData)
			self.SavingBatch = false
			if errorCode == 0 then
				local confirmed = {}
				for _, key in ipairs(values) do table.insert(confirmed, key) end
				_PetLogic:ConfirmSaveFor(playerEntity, confirmed, petGenerations)
			end
		else
			local callback = function(errorCode, values)
				self.SavingBatch = false
				if errorCode == 0 then
					local confirmed = {}
					for _, key in ipairs(values) do table.insert(confirmed, key) end
					_PetLogic:ConfirmSaveFor(playerEntity, confirmed, petGenerations)
					return
				end
				
				-- Error handling
			end
			ds:BatchSetAsync(saveData, callback)
		end
	end

	@ExecSpace("ServerOnly")
	method boolean LoadFromDB()
		local playerEntity = self.Entity
		local profileCode = playerEntity.PlayerComponent.ProfileCode
		local ds = _DataStorageService:GetUserDataStorage(profileCode)
		local loadKey = {}
		local loadedData = {}
		
		-------------------------------------------------------------------
		playerEntity.PlayerJob:LoadFromDB(loadKey)
		playerEntity.PkgPlayerInventory:LoadFromDB(loadKey)
		playerEntity.PlayerRanking:LoadFromDB(loadKey)
		_PetLogic:CollectLoadKeys(loadKey)
		-------------------------------------------------------------------
		
		local returnCode, itemPages = ds:BatchGetAndWait(loadKey)
		if returnCode ~= 0 then
			return false
		end
		
		while true do
			local datas = itemPages:GetCurrentPageDatas()
			if datas == nil then
				break
			end
			
			for i=1, #datas do
				loadedData[datas[i].KeyInfo.Key] = datas[i]
			end
			
			if itemPages.IsLastPage == true then
				break
			end
			itemPages:MoveToNextPageAndWait()
		end
		
		if not self:OnLoadedDataFromDB(loadedData) then
			return false
		end
		
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean OnLoadedDataFromDB(table datas)
		local playerEntity = self.Entity
		
		if not playerEntity.PlayerJob:OnLoadedDataFromDB(datas) then
			return false
		end
		
		if not playerEntity.PkgPlayerInventory:OnLoadedDataFromDB(datas) then
			return false
		end

		if not playerEntity.PlayerRanking:OnLoadedDataFromDB(datas) then
			return false
		end

		if not _PetLogic:LoadFor(playerEntity, datas) then return false end
		return true
	end

	@ExecSpace("Server")
	method void NotifyWorldDataLoadCompleted()
		if self.IsLoadAttempted then
			return
		end
		self.IsLoadAttempted = true
		
		if not _DataLoadLogic:IsLoadSuccessAndWait(self.Entity) then
			return
		end
		
		if not self:LoadFromDB() then
			return
		end
		
		self.IsLoadSuccess = true
		
		-- Database save interval
		local period = 60
		
		local dbfunction = function()
			self:SaveToDB(false)
		end
		
		self.TimerId = _TimerService:SetTimerRepeat(dbfunction, period, period)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserLeaveEvent(UserLeaveEvent event)
		local UserId = event.UserId
		
		if UserId == self.Entity.PlayerComponent.UserId then
			_TimerService:ClearTimer(self.TimerId)
			self:SaveToDB(true)
		end
	end

	@ExecSpace("ServerOnly")
	method boolean SavePetPurchaseAndWait()
		-- Confirm the single pet save before the native purchase callback accepts payment.
		if not self.IsLoadSuccess then return false end
		while self.SavingBatch do wait(0.05) end
		self.SavingBatch = true
		local saveData = {} local generations = {}
		_PetLogic:SaveFor(self.Entity, saveData, generations)
		if next(saveData) == nil then self.SavingBatch = false return true end
		local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		local code, keys = ds:BatchSetAndWait(saveData)
		self.SavingBatch = false
		if code ~= 0 then return false end
		local confirmed = {}
		for _, key in ipairs(keys) do table.insert(confirmed, key) end
		_PetLogic:ConfirmSaveFor(self.Entity, confirmed, generations)
		for _, key in ipairs(confirmed) do
			if key == _PetLogic.StorageKey then return true end
		end
		return false
	end

end
