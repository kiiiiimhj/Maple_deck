@Logic
script GearGradeEnum extends Logic

	property table StringToEnumTable = {}

	property table EnumToStringTable = {}

	property table ColorTable = {}

	property table EnumToBackRUIDTable = {}

	-- 합성(장비 등급업) 시스템용 한글 표기 — 노말/레어/에픽/레전드/미스틱 5단계를 기존 5개 등급값에 그대로 매핑
	property table EnumToKoreanNameTable = {}

	property integer None = 0

	property integer Magic = 1

	property integer Rare = 2

	property integer Epic = 3

	property integer Unique = 4

	property integer Legendary = 5

	method void Init()
		local stringToEnumTable = {}
		self.StringToEnumTable = stringToEnumTable
		stringToEnumTable["None"] = self.None
		stringToEnumTable["Magic"] = self.Magic
		stringToEnumTable["Rare"] = self.Rare
		stringToEnumTable["Epic"] = self.Epic
		stringToEnumTable["Unique"] = self.Unique
		stringToEnumTable["Legendary"] = self.Legendary

		local enumToUIString = {}
		self.EnumToStringTable = enumToUIString
		enumToUIString[self.None] = "None"
		enumToUIString[self.Magic] = "Magic"
		enumToUIString[self.Rare] = "Rare"
		enumToUIString[self.Epic] = "Epic"
		enumToUIString[self.Unique] = "Unique"
		enumToUIString[self.Legendary] = "Legendary"

		-- 인벤토리 슬롯 테두리색(유저 지정, 무기 티어 6단계로 확장): 노말=회색/매직=초록/레어=노랑/
		-- 에픽=보라/유니크=주황/레전더리=빨강
		local colorTable = {}
		self.ColorTable = colorTable
		colorTable[self.None] = Color.FromHexCode('#9E9E9E')
		colorTable[self.Magic] = Color.FromHexCode('#4CAF50')
		colorTable[self.Rare] = Color.FromHexCode('#FFD600')
		colorTable[self.Epic] = Color.FromHexCode('#9C27B0')
		colorTable[self.Unique] = Color.FromHexCode('#FF6D00')
		colorTable[self.Legendary] = Color.FromHexCode('#F44336')

		local enumToBackRUIDTable = {}
		self.EnumToBackRUIDTable = enumToBackRUIDTable
		enumToBackRUIDTable[self.None] = "aa931a755e5949699233b817029a3e36"
		enumToBackRUIDTable[self.Magic] = "aa931a755e5949699233b817029a3e36"
		enumToBackRUIDTable[self.Rare] = "dcbbede8a7a0478b97e2ffa23b7fc14a"
		enumToBackRUIDTable[self.Epic] = "90c4bb16c95a4ae3916098b6ffb4d0e4"
		enumToBackRUIDTable[self.Unique] = "74d4021ef1794501acb73b78d267574e"
		enumToBackRUIDTable[self.Legendary] = "70565cb756634ae7a168975f7a18fb1d"

		-- 무기 티어 한글 표기(유저 지정): 노말/매직/레어/에픽/유니크/레전더리 6단계
		local enumToKoreanNameTable = {}
		self.EnumToKoreanNameTable = enumToKoreanNameTable
		enumToKoreanNameTable[self.None] = "노말"
		enumToKoreanNameTable[self.Magic] = "매직"
		enumToKoreanNameTable[self.Rare] = "레어"
		enumToKoreanNameTable[self.Epic] = "에픽"
		enumToKoreanNameTable[self.Unique] = "유니크"
		enumToKoreanNameTable[self.Legendary] = "레전더리"
	end

	method string GetKoreanName(integer gradeEnum)
		local str = self.EnumToKoreanNameTable[gradeEnum]
		if str == nil then
			return "?"
		end
		return str
	end

	-- 미스틱(Legendary)이 최고 등급 — 그 이상은 합성 불가(-1 반환)
	method integer GetNextGrade(integer gradeEnum)
		if gradeEnum >= self.Legendary then
			return -1
		end
		return gradeEnum + 1
	end

	-- 노말→레어만 "동일 아이템 3개 1회성" 규칙, 그 이상(레어→에픽~레전드→미스틱)은 전부
	-- "동일등급+동일부위 3회 반복" 규칙 — 합성 팝업/서버 검증이 공통으로 참조하는 단일 판단 지점
	method boolean IsInstantComposeTier(integer gradeEnum)
		return gradeEnum == self.None
	end

	method integer ToInt(string typeStr)
		local enum = self.StringToEnumTable[typeStr]
		if enum == nil then
			return self.None
		end
		return enum
	end

	method string EnumToStr(integer gradeEnum)
		local str = self.EnumToStringTable[gradeEnum]
		if str == nil then
			return "Unknown"
		end
		return str
	end

	method Color GetEnumColor(integer gradeEnum)
		local color = self.ColorTable[gradeEnum]
		if color == nil then
			return Color.white
		end
		return color
	end

	method integer StrToEnum(string gradeString)
		if self.StringToEnumTable[gradeString] == nil then
			return self.None
		end
		
		return self.StringToEnumTable[gradeString]
	end

	method string GetBackgroundRUID(integer gradeEnum)
		if self.EnumToBackRUIDTable[gradeEnum] == nil then
			return self.EnumToBackRUIDTable[self.None]
		end
		
		return self.EnumToBackRUIDTable[gradeEnum]
	end

end