@Logic
script QualityEnum extends Logic

	property table EnumToKoreanNameTable = {}

	property table WeaponTierSuccessRateTable = {}

	property integer F = 0

	property integer E = 1

	property integer D = 2

	property integer C = 3

	property integer B = 4

	property integer A = 5

	property integer S = 6

	method void Init()
		local enumToKoreanNameTable = {}
		self.EnumToKoreanNameTable = enumToKoreanNameTable
		enumToKoreanNameTable[self.F] = "F"
		enumToKoreanNameTable[self.E] = "E"
		enumToKoreanNameTable[self.D] = "D"
		enumToKoreanNameTable[self.C] = "C"
		enumToKoreanNameTable[self.B] = "B"
		enumToKoreanNameTable[self.A] = "A"
		enumToKoreanNameTable[self.S] = "S"

		-- 품질 합성(같은 무기, 다른 품질끼리) 성공확률(유저 지정) — 무기 티어(GearGradeEnum)별로
		-- 고정이고 두 재료의 품질 칸수 차이와는 무관하다. 성공하면 [두 재료 중 높은 품질] 그대로,
		-- 실패하면 [높은 품질 -1단계]가 나온다
		local rateTable = {}
		self.WeaponTierSuccessRateTable = rateTable
		rateTable[_GearGradeEnum.None] = 70
		rateTable[_GearGradeEnum.Magic] = 75
		rateTable[_GearGradeEnum.Rare] = 80
		rateTable[_GearGradeEnum.Epic] = 85
		rateTable[_GearGradeEnum.Unique] = 90
		rateTable[_GearGradeEnum.Legendary] = 95
	end

	method string GetKoreanName(integer qualityEnum)
		local str = self.EnumToKoreanNameTable[qualityEnum]
		if str == nil then
			return "?"
		end
		return str
	end

	method integer GetWeaponTierSuccessRate(integer weaponTierGrade)
		local rate = self.WeaponTierSuccessRateTable[weaponTierGrade]
		if rate == nil then
			return 70
		end
		return rate
	end

	-- 무기 드롭 시 품질(F~S) 판정(유저 지정 확률표): F 35% / E 25% / D 18% / C 12% / B 6% / A 3% / S 1%
	method integer RollDropQuality()
		local roll = math.random(1, 100)
		if roll <= 35 then
			return self.F
		elseif roll <= 60 then
			return self.E
		elseif roll <= 78 then
			return self.D
		elseif roll <= 90 then
			return self.C
		elseif roll <= 96 then
			return self.B
		elseif roll <= 99 then
			return self.A
		else
			return self.S
		end
	end

end
