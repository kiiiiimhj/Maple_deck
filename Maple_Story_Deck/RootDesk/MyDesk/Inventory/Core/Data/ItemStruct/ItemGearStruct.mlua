@Struct
script ItemGearStruct

	property boolean IsAttached = false

	property integer Grade = 0

	-- 레어→에픽 이상 등급업은 "같은 등급+같은 부위 아이템으로 3회 합성" 방식이라, 3회 채워질 때까지의
	-- 누적 진행도를 아이템 자체에 영구 저장한다(유저 지정: 세션 끊겨도 이어져야 함). 3에 도달하면
	-- Grade를 1단계 올리고 0으로 리셋한다. 노말→레어(동일 아이템 3개 1회성 합성)에는 쓰이지 않는다.
	property integer ComposeCount = 0

	-- 무기 전용 품질(F~S, 유저 지정) — 같은 무기 티어 안에서 스탯 롤 폭을 결정. 방어구 등 품질 개념이
	-- 없는 아이템은 항상 0(F)로 무시된다. QualityEnum.F(0)이 기본값
	property integer Quality = 0

	-- 무기 전용 ATK(유저 지정: 드롭 시 딱 1회만 굴려서 영구 저장, 매번 재롤 금지) — WeaponTierDataLogic의
	-- Grade+Quality 구간에서 드롭 시점에 굴린 값을 그대로 들고 다닌다. 방어구는 항상 0로 무시
	property integer Atk = 0

	-- 방어구(HP 스탯 계열, 슈트류) 전용 — Atk와 완전히 동일한 패턴(드롭 시 1회 확정 롤, 영구 저장).
	-- ATK 계열 아이템(스태프/활/양손검/자마다르)은 항상 0으로 무시
	property integer Hp = 0

	-- 무기 전용 등급 스킬 변형(1~4, 유저 지정: 레어/레전더리는 등급 스킬1~4가 서로 다른 스킬 — 예:
	-- 이블윙즈 변형1=썬더볼트/변형2=썬더커터/변형3=에너지볼트/변형4=페페). 드롭 시 1회 균등 랜덤(1~4) 후
	-- 영구 저장, 합성(티어업/품질합성 둘 다)에도 그대로 승계된다. 품질과 마찬가지로 합성 재료 자격에는
	-- 영향 없음(유저 지정: "스킬은 달라도 재료로 상관없다"). 방어구는 의미 없음(항상 기본값 1)
	property integer SkillVariant = 1

	-- 레전더리 전용 "기본공격 확률발동" 수치(유저 지정: 중앙값 상수 말고 아이템 자체에 고정된 값을 읽어야
	-- 함) — ATK와 동일한 패턴으로 드롭 시 품질 구간 내에서 1회 확정 롤 후 영구 저장. 1000분율 정수로 저장
	-- (예: 35 = 3.5%), 사용할 땐 /1000로 환산. 방어구/무기라도 레전더리가 아니면 사용되지 않지만 값 자체는
	-- 드롭 시 품질 기준으로 항상 굴려둔다(등급은 합성으로만 오르고 품질 범위 자체는 등급과 무관하므로 재롤 불필요)
	property integer ProcChancePerMille = 0

	-- 매직/에픽/유니크 전용 "공격력%/쿨타임%" 보너스 — 현재 Grade에서 실제로 적용 중인 값(1000분율,
	-- 예: 35 = 3.5%). AtkByGrade/BonusPercentPerMilleByGrade에서 그대로 꺼내온 값이라 등급업해도
	-- 재굴림되지 않는다. 레어/레전더리/노말은 사용하지 않음(항상 0)
	property integer BonusPercentPerMille = 0

	-- 유저 강한 정정: 등급업마다 새로 굴리면 미리보기(등급 스킬 박스)에서 본 값과 실제로 그 등급에
	-- 도달했을 때 받는 값이 어긋날 수 있다 — "품질 F는 등급이 바뀌어도 F에 해당하는 값을 그대로
	-- 승계받아야지, 등급업했다고 엉뚱한 값이 나오면 안 된다"는 요구. 그래서 드롭 시 이 아이템의
	-- Quality로 None~레전더리 전 등급의 ATK/보너스를 한 번에 굴려서 여기 영구 저장해두고(정수 키
	-- 0~5 = GearGradeEnum 값), 등급업(PkgPlayerInventory.ComposeItem)과 미리보기
	-- (UIEquipPopup.UpdateGradeSkillBox) 둘 다 재굴림 없이 이 표에서 값을 꺼내 쓰기만 한다.
	property table AtkByGrade = {}

	property table BonusPercentPerMilleByGrade = {}

	-- Hp 버전(AtkByGrade와 동일 패턴) — HP 스탯 계열 아이템만 채워진다
	property table HpByGrade = {}

	-- 장비 강화 레벨(1부터 시작). 부위별 강화 주문서 + 골드를 먹여 올린다(EnhanceScrollLogic 비용표).
	-- 상한은 등급이 열어준다(노말5 / 매직10 / 레어20 / 에픽30 / 유니크40 / 레전더리50) —
	-- 유저 지정: 등급업(합성)해도 레벨은 리셋되지 않고 그대로 유지되고 상한만 올라간다
	property integer Level = 1

	-- 반지 전용 "메인 옵션 종류"(유저 지정 2026-09-21) — 1 = 공격력 / 2 = 최대 체력.
	-- 반지는 이름·등급·아이콘이 전부 같고 **메인 옵션만 둘 중 하나로 갈린다**. 드롭 시 1회 확정해
	-- 영구 저장하고, 합성(등급업/품질)으로도 바뀌지 않는다. 안 쓰는 쪽의 수치(Atk 또는 Hp)와
	-- 등급별 표(AtkByGrade/HpByGrade)는 생성 시점에 통째로 0으로 눌러둔다 — 등급업이 표에서
	-- 값을 꺼내 쓰기만 하므로 이렇게 해두면 이후 어느 경로로도 반대쪽 스탯이 살아나지 않는다.
	-- 0 = 미지정(반지가 아닌 장비 / 이 필드 추가 이전에 드롭된 반지).
	-- 옛 반지는 PkgPlayerInventory.BackfillMissingGearStats가 로그인 때 한 번 굴려서 채운다.
	property integer MainStatType = 0

	-- 반지 전용 "등급별" 등급 스킬 변형(유저 지정 2026-09-21 정정) — AtkByGrade와 같은 패턴으로
	-- 정수 키 0~5(GearGradeEnum)에 각각 1~5(공격력/치확/치피/최대체력/쿨타임)가 들어간다.
	-- ⚠ 처음엔 아이템 하나에 SkillVariant 하나였는데, 그러면 장비 정보 팝업의 등급 표 5줄이
	--   **전부 같은 효과**로 나온다(유저 지적). 등급마다 따로 굴려야 "매직은 치확, 레어는 쿨감…"
	--   처럼 등급별로 다른 효과가 나온다.
	-- 드롭 시 전 등급을 한 번에 굴려 영구 저장 — 등급업해도 재굴림하지 않아 미리 본 값이 그대로 온다.
	-- 빈 테이블 = 이 필드 추가 이전 아이템 → GetSkillVariantForGrade가 SkillVariant로 폴백한다.
	property table SkillVariantByGrade = {}

	method void CopyFrom(ItemGearStruct other)
		self.IsAttached = other.IsAttached
		self.Grade = other.Grade
		self.ComposeCount = other.ComposeCount
		self.Quality = other.Quality
		self.Atk = other.Atk
		self.Hp = other.Hp
		self.SkillVariant = other.SkillVariant
		self.ProcChancePerMille = other.ProcChancePerMille
		self.BonusPercentPerMille = other.BonusPercentPerMille
		self.Level = other.Level
		self.MainStatType = other.MainStatType

		local atkByGrade = {}
		for grade, v in pairs(other.AtkByGrade) do
			atkByGrade[grade] = v
		end
		self.AtkByGrade = atkByGrade

		local hpByGrade = {}
		for grade, v in pairs(other.HpByGrade) do
			hpByGrade[grade] = v
		end
		self.HpByGrade = hpByGrade

		local bonusByGrade = {}
		for grade, v in pairs(other.BonusPercentPerMilleByGrade) do
			bonusByGrade[grade] = v
		end
		self.BonusPercentPerMilleByGrade = bonusByGrade

		local variantByGrade = {}
		for grade, v in pairs(other.SkillVariantByGrade) do
			variantByGrade[grade] = v
		end
		self.SkillVariantByGrade = variantByGrade
	end

	method ItemGearStruct Clone()
		local cloneStruct = ItemGearStruct()
		cloneStruct:CopyFrom(self)
		
		return cloneStruct
	end

	method boolean Deserialize(table dbItem)
		local hasDeserializedData = false
		
		local gradeStr = dbItem['G']
		if not _Util:IsNilorEmptyString(gradeStr) then
			local strs = _UtilLogic:Split(gradeStr, ',')
			self.Grade = math.tointeger(tonumber(strs[1]))
			if self.Grade == nil then
				self.Grade = 0
			end

			-- strs[2]는 이 필드 추가 이전 저장 데이터엔 없을 수 있어 nil이면 0으로 취급(하위호환)
			self.ComposeCount = math.tointeger(tonumber(strs[2]))
			if self.ComposeCount == nil then
				self.ComposeCount = 0
			end

			-- strs[3](Quality)도 동일하게 이 필드 추가 이전 데이터엔 없을 수 있어 하위호환 처리
			self.Quality = math.tointeger(tonumber(strs[3]))
			if self.Quality == nil then
				self.Quality = 0
			end

			-- strs[4](Atk)도 동일하게 하위호환 처리
			self.Atk = math.tointeger(tonumber(strs[4]))
			if self.Atk == nil then
				self.Atk = 0
			end

			-- strs[5](SkillVariant)도 동일하게 하위호환 처리(기본값 1)
			self.SkillVariant = math.tointeger(tonumber(strs[5]))
			if self.SkillVariant == nil then
				self.SkillVariant = 1
			end

			-- strs[6](ProcChancePerMille)도 동일하게 하위호환 처리(기본값 0)
			self.ProcChancePerMille = math.tointeger(tonumber(strs[6]))
			if self.ProcChancePerMille == nil then
				self.ProcChancePerMille = 0
			end

			-- strs[7](BonusPercentPerMille)도 동일하게 하위호환 처리(기본값 0)
			self.BonusPercentPerMille = math.tointeger(tonumber(strs[7]))
			if self.BonusPercentPerMille == nil then
				self.BonusPercentPerMille = 0
			end

			-- strs[8]/strs[9](AtkByGrade/BonusPercentPerMilleByGrade) — 이 필드 추가 이전 저장
			-- 데이터엔 없을 수 있어 빈 테이블로 하위호환 처리
			self.AtkByGrade = self:DeserializeByGradeTable(strs[8])
			self.BonusPercentPerMilleByGrade = self:DeserializeByGradeTable(strs[9])

			-- strs[10](Hp)/strs[11](HpByGrade) — 이 필드 추가 이전 저장 데이터엔 없을 수 있어 하위호환 처리
			self.Hp = math.tointeger(tonumber(strs[10]))
			if self.Hp == nil then
				self.Hp = 0
			end
			self.HpByGrade = self:DeserializeByGradeTable(strs[11])

			-- strs[12](Level) — 이 필드 추가 이전에 저장된 장비는 없으므로 기본값 1(=미강화)로 취급
			self.Level = math.tointeger(tonumber(strs[12]))
			if self.Level == nil then
				self.Level = 1
			end

			-- strs[13](MainStatType) — 이 필드 추가 이전 데이터엔 없다. 0(미지정)으로 두면
			-- BackfillMissingGearStats가 반지에 한해 로그인 때 굴려서 채운다
			self.MainStatType = math.tointeger(tonumber(strs[13]))
			if self.MainStatType == nil then
				self.MainStatType = 0
			end

			-- strs[14](SkillVariantByGrade) — 없으면 빈 테이블(폴백은 GetSkillVariantForGrade가 처리)
			self.SkillVariantByGrade = self:DeserializeByGradeTable(strs[14])

			hasDeserializedData = true
		end

		return hasDeserializedData
	end

	-- "-"로 이은 GearGradeEnum 0~5 순서의 6개 정수를 정수 키(0~5) 테이블로 되돌린다
	method table DeserializeByGradeTable(string str)
		local result = {}
		if _Util:IsNilorEmptyString(str) then
			return result
		end

		local parts = _UtilLogic:Split(str, '-')
		for i = 1, #parts do
			local v = math.tointeger(tonumber(parts[i]))
			if v == nil then
				v = 0
			end
			result[i - 1] = v
		end

		return result
	end

	-- GearGradeEnum 0~5 순서로 값을 뽑아 "-"로 이어붙인다(빠진 등급은 0으로 채움)
	method string SerializeByGradeTable(table byGradeTable)
		local parts = {}
		for grade = 0, 5 do
			local v = byGradeTable[grade]
			if v == nil then
				v = 0
			end
			table.insert(parts, tostring(v))
		end

		return table.concat(parts, '-')
	end

	method boolean Serialize(table dbItem)
		-- Level도 판정에 포함해야 한다 — 다른 값이 전부 기본값인 장비를 강화만 해둔 경우에도 저장되어야 하므로
		if self.Grade ~= 0 or self.ComposeCount ~= 0 or self.Quality ~= 0 or self.Atk ~= 0 or self.Hp ~= 0 or self.SkillVariant ~= 1 or self.ProcChancePerMille ~= 0 or self.BonusPercentPerMille ~= 0 or self.Level ~= 1 or self.MainStatType ~= 0 then
			local strs = {}
			table.insert(strs, tostring(self.Grade))
			table.insert(strs, tostring(self.ComposeCount))
			table.insert(strs, tostring(self.Quality))
			table.insert(strs, tostring(self.Atk))
			table.insert(strs, tostring(self.SkillVariant))
			table.insert(strs, tostring(self.ProcChancePerMille))
			table.insert(strs, tostring(self.BonusPercentPerMille))
			table.insert(strs, self:SerializeByGradeTable(self.AtkByGrade))
			table.insert(strs, self:SerializeByGradeTable(self.BonusPercentPerMilleByGrade))
			table.insert(strs, tostring(self.Hp))
			table.insert(strs, self:SerializeByGradeTable(self.HpByGrade))
			table.insert(strs, tostring(self.Level))
			table.insert(strs, tostring(self.MainStatType))
			table.insert(strs, self:SerializeByGradeTable(self.SkillVariantByGrade))

			local str = table.concat(strs, ',')
			dbItem['G'] = str
		end

		return true
	end

end