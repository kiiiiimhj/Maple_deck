@Logic
script PlayerInventory extends Logic

	-- 몬스터 드랍/상점 구매로 얻는 잡템 개수. 이번 런 동안만 유지되고, 게임오버 시점에 골드로 일괄 환전된다
	@Sync property SyncTable<string, integer> ItemCounts
	-- itemId별 "처음 획득한 순번" — 인벤토리 UI가 획득한 순서대로 슬롯을 채우는 데 쓴다
	@Sync property SyncTable<string, integer> AcquisitionOrder
	property integer _nextOrderIndex = 1

	@ExecSpace("ServerOnly")
	method void AddItem(string itemId, integer amount)
		-- 가방에 아이템을 지급한다. 존재하지 않던 itemId면 0에서부터 시작한다
		self:ReserveAcquisitionOrder(itemId)
		local current = self:GetItemCount(itemId)
		self.ItemCounts[itemId] = current + amount
		log("Inventory: " .. itemId .. " +" .. amount .. " -> " .. tostring(self.ItemCounts[itemId]))
	end

	@ExecSpace("ServerOnly")
	method void ReserveAcquisitionOrder(string itemId)
		-- 실제 지급(AddItem)은 드롭 연출이 도착하는 시점까지 지연되는데, 그때 순번을 매기면
		-- 나중에 죽은 몬스터의 아이템이 랜덤 딜레이가 짧아서 먼저 도착해 순서가 뒤바뀔 수 있다.
		-- 그래서 드롭이 확정되는 즉시(연출 시작 전) 순번부터 미리 예약해둔다
		if self.AcquisitionOrder[itemId] ~= nil then return end
		self.AcquisitionOrder[itemId] = self._nextOrderIndex
		self._nextOrderIndex = self._nextOrderIndex + 1
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- 인벤토리를 연 상태에서 아이템을 획득해도 실시간으로 개수가 반영되도록 알려준다
		if name == "ItemCounts" then
			_InventoryUI:NotifyInventoryChanged()
		end
	end

	method table GetOrderedItemIds()
		-- 현재 보유 중인(개수>0) 잡템 id를 "처음 획득한 순서"대로 정렬해 돌려준다
		local allIds = {
			"slime_ooze", "old_leather", "evileye_tail", "curseeye_tail",
			"snail_shell", "blue_snail_shell", "mushroom_spore", "red_snail_shell",
			"pig_tail", "jr_boogie_horn", "stump_tear", "octopus_leg", "ribbon",
			"fox_tail", "orange_mushroom_cap",
			"lorang_claw", "umti_shell", "klang_claw",
			"flying_fish", "clam_shell", "starfish_leg",
			"horned_mushroom_cap", "zombie_mushmom_spore", "bat_wing",
			"stone_golem_fragment", "dark_stone_golem_fragment", "mix_golem_piece",
			"ice_mix_golem_piece", "fairy_antenna", "royal_fairy_wing", "grey_tentacle",
			"firefly_slime_gel", "fairy_slime_gel", "water_elemental_essence",
			"tree_elemental_leaf", "mystic_wisp_dust", "lesser_spellbook_page",
			"lupin_banana", "jaguar_claw", "banana_gull_feather", "zombie_lupin_peel",
			"jr_necki_hide", "ligator_hide", "croco_hide", "swamp_mud", "sprout_mud",
			"melody_broom", "steagy_wing",
			"jr_wraith_bone", "wraith_bone", "skeledog_bone", "mummydog_bandage",
			"unknown_ticket",
		}
		local owned = {}
		for _, itemId in ipairs(allIds) do
			if self:GetItemCount(itemId) > 0 and self.AcquisitionOrder[itemId] ~= nil then
				table.insert(owned, { id = itemId, order = self.AcquisitionOrder[itemId] })
			end
		end
		table.sort(owned, function(a, b) return a.order < b.order end)
		local result = {}
		for _, entry in ipairs(owned) do table.insert(result, entry.id) end
		return result
	end

	method integer GetItemCount(string itemId)
		if self.ItemCounts[itemId] == nil then return 0 end
		return self.ItemCounts[itemId]
	end

	method table GetItemDef(string itemId)
		local defs = self:GetAllItemDefs()
		return defs[itemId]
	end

	method table GetAllItemDefs()
		-- 아이템 카탈로그(이름/아이콘/골드 환전가). 신규 아이템은 여기에만 등록하면 가방/상점/환전 로직이 전부 따라온다
		-- 존1~15 몬스터별 실제 메이플스토리 드롭템으로 교체(GameManager.GetMonsterLootItemId 참고) — 존16~17(그림자 존)은
		-- 야누스의 검 교환권 전용이라 이 카탈로그와 무관하다. 기존 범용 5종 중 컨셉이 맞는 것만 재사용하고
		-- (수상한 점액→슬라임, 낡은 가죽→와일드보어 계열), 나머지(마물의 뼈/몬스터 발톱)는 대응되는 실제
		-- 몬스터가 없어 폐기했다. 마정석 조각도 이블아이/커즈아이 전용 정확한 드롭템(꼬리)이 확인되어 폐기.
		return {
			-- 재사용(기존 5종 중 컨셉이 맞는 것)
			slime_ooze = { name = "수상한 점액", icon = "0c4f4c97ae3d4e76b85dc954ee05e061", coinValue = 2 },       -- 슬라임
			old_leather = { name = "낡은 가죽", icon = "7cb8bfdc6e754fcfa6b5df522c085d0d", coinValue = 4 },        -- 와일드보어/아이언호그/아이언보어/파이어보어

			-- 존14/15 (이블아이/커즈아이)
			evileye_tail = { name = "이블아이의 꼬리", icon = "20e1e0458ad145dfbc1dc233a9203ff7", coinValue = 6 },
			curseeye_tail = { name = "커즈아이의 꼬리", icon = "32db142486e540a9b4edcd0a7fd95358", coinValue = 6 },

			-- 존1~3 (웨이브1~10)
			snail_shell = { name = "달팽이의 껍질", icon = "927d463a046b48869cffa1eeaf8e3f5a", coinValue = 2 },              -- 달팽이
			blue_snail_shell = { name = "변형된 달팽이의 껍질", icon = "949561b1a5cf40ca8de72e66b9df3e6d", coinValue = 2 },  -- 파란 달팽이
			mushroom_spore = { name = "버섯의 포자", icon = "606b873258264a8291238074f707f5c3", coinValue = 2 },            -- 스포아
			red_snail_shell = { name = "빨간 달팽이의 껍질", icon = "b0c221e18dc546f0ac516895fb5704d0", coinValue = 3 },    -- 빨간 달팽이
			pig_tail = { name = "돼지의 꼬리", icon = "f5b37d26a2694bddac2fbdabfe3c4cec", coinValue = 3 },                  -- 돼지 / 이상한 돼지
			jr_boogie_horn = { name = "주니어 부기의 뿔", icon = "9406c1bafd4f4939af1167bd73a227a1", coinValue = 4 },       -- 주니어 부기
			stump_tear = { name = "스텀프의 눈물", icon = "2dc235bd7f664c75aea092387af57ce9", coinValue = 4 },              -- 스텀프 / 고스텀프 / 엑스텀프 / 히죽대는 고스텀프
			octopus_leg = { name = "옥토퍼스의 다리", icon = "294ce4fd15bb405b8c57f0ae6f7a0bce", coinValue = 4 },           -- 옥토퍼스
			ribbon = { name = "리본", icon = "bda3fa8698e44515b7828895e3e6c3bf", coinValue = 8 },                          -- 리본 돼지(보스)

			-- 존4~6
			fox_tail = { name = "음흉한 여우의 꼬리", icon = "8cbdfd31e953492fbcbd8371954c6f2d", coinValue = 3 },          -- 음흉한 여우
			orange_mushroom_cap = { name = "주황버섯의 갓", icon = "0ed1b7cbeece48fa87e5f9ea37096d8d", coinValue = 3 },     -- 주황버섯 / 시니컬한 주황버섯

			-- 존11 (해변, 로랑/엄티/클랑)
			lorang_claw = { name = "로랑의 집게발", icon = "729b348979354dd89216a1590cffaa1b", coinValue = 5 },
			umti_shell = { name = "엄티의 등껍질", icon = "025104e7790a4748bfbb542bc6512e82", coinValue = 5 },
			klang_claw = { name = "클랑의 집게발", icon = "d2f6f00b08d84f88927d2ad6c6b30683", coinValue = 5 },

			-- 존12 (날치/보라조개/불가사리문어 슬라임)
			flying_fish = { name = "날치", icon = "61b0ac59d5e747feb8b3155dab2b3b55", coinValue = 5 },
			clam_shell = { name = "조개껍데기", icon = "9b5407b7608942dca798829c54b7cc5c", coinValue = 5 },
			starfish_leg = { name = "노란 불가사리의 다리", icon = "634164726462400d96b201432d0bfdba", coinValue = 5 },

			-- 존13 (뿔버섯/좀비버섯)
			horned_mushroom_cap = { name = "뿔버섯의 갓", icon = "49b3f12c200044b591eeada1ae93a38d", coinValue = 6 },
			zombie_mushmom_spore = { name = "좀비 머쉬맘의 포자", icon = "48c0812e0f8f4f77bdc850b956feeb11", coinValue = 6 },

			-- 존15 (박쥐, 비행형)
			bat_wing = { name = "빛나는 박쥐 날개", icon = "7b16a771f90e49b7a99c8c4f54e25f96", coinValue = 6 },

			-- 존19~22 (그룹G: 스톤골렘/다크 스톤골렘/페어리/믹스골렘/아이스 믹스골렘/로얄 페어리)
			stone_golem_fragment = { name = "스톤골렘의 돌조각", icon = "b1c0fd8c12b245958131db55e4d502e4", coinValue = 7 },
			dark_stone_golem_fragment = { name = "다크 스톤골렘의 돌조각", icon = "3f6354432d094c199bfb2f48bda8b973", coinValue = 7 },
			mix_golem_piece = { name = "믹스골렘의 조각", icon = "591604d0287d4505aeeb3b0cee6a8ca1", coinValue = 7 },
			ice_mix_golem_piece = { name = "아이스 믹스골렘의 조각", icon = "d37cede700ac4816b0adef78be1bdb7c", coinValue = 7 },
			fairy_antenna = { name = "페어리의 더듬이", icon = "33920cdae3ae40f6a78b8d1f149f03c2", coinValue = 7 },
			royal_fairy_wing = { name = "로얄페어리의 날개", icon = "e7e2c58d8de94196a816e04a94a59095", coinValue = 7 },

			-- 존21 이스터에그(뉴그레이 화이트, 외계인 습격) 전용 드롭템
			grey_tentacle = { name = "그레이의 촉수", icon = "a3a03dcab5bf4f669e0694baabde027c", coinValue = 10 },

			-- 존23~26 (그룹H: 반딧불 슬라임/페어리 슬라임/워터 엘리먼트/트리 엘리먼트/미스틱 위습/하급 마법책)
			firefly_slime_gel = { name = "반딧불 슬라임의 방울", icon = "268e3700408e470cbce39e11e61e2f3f", coinValue = 8 },
			fairy_slime_gel = { name = "페어리 슬라임의 방울", icon = "10caa1f4a2644af5bc9050ccf0c3bd53", coinValue = 8 },
			water_elemental_essence = { name = "워터 엘리먼트의 정수", icon = "11b681ebfd454ca5b773a3486bad7d05", coinValue = 8 },
			tree_elemental_leaf = { name = "트리 엘리먼트의 나뭇잎", icon = "5e1d4e3045e34112ae743469df9b9b94", coinValue = 8 },
			mystic_wisp_dust = { name = "미스틱 위습의 신비한 가루", icon = "0105f66915fe4938ba8c7713ac410982", coinValue = 8 },
			lesser_spellbook_page = { name = "하급 마법책", icon = "f63f4a7d42a54fb697f53b5608e9001d", coinValue = 8 },

			-- 존31~34 (그룹J: 루팡/재규어/바나나갈매기/좀비루팡)
			lupin_banana = { name = "루팡의 바나나", icon = "19cb5a8c16654c00bfb6d153fadece14", coinValue = 8 },
			jaguar_claw = { name = "재규어의 발톱", icon = "6510196b6e7442e4b0d46adba7fca98b", coinValue = 8 },
			banana_gull_feather = { name = "바나나 갈매기의 깃털", icon = "32a4e9037d38445a994915c689051182", coinValue = 8 },
			zombie_lupin_peel = { name = "좀비루팡이 남긴 바나나 껍질", icon = "cf3f13f9911f400c807ab4b1867e93ab", coinValue = 8 },

			-- 존36~39 (그룹K: 주니어 네키/리게이터/크로코/늪진흙괴물/새싹진흙괴물/멜러디/스티지)
			jr_necki_hide = { name = "주니어 네키의 가죽", icon = "5c44b6a6385040cea09a0b3dd50884d1", coinValue = 9 },
			ligator_hide = { name = "리게이터의 가죽", icon = "94d658f1595d47559a3a0f9c24817b71", coinValue = 9 },
			croco_hide = { name = "크로코의 가죽", icon = "5fd2c7faba50451f90da92bcf84dc10d", coinValue = 9 },
			swamp_mud = { name = "늪진흙괴물의 진흙", icon = "4331d77c50d948d798d2e008dd5287b5", coinValue = 9 },
			sprout_mud = { name = "새싹진흙괴물의 새싹", icon = "a8e73ba8121046b18e761c666eef133c", coinValue = 9 },
			melody_broom = { name = "멜러디의 빗자루", icon = "5095fbc35d3f44d0a69ed5fa85d5840e", coinValue = 9 },
			steagy_wing = { name = "스티지의 날개", icon = "663913cb59df4ce9af570523df0c9d18", coinValue = 9 },

			-- 존40~43 (그룹L: 주니어 레이스/레이스/스켈독/머미독)
			jr_wraith_bone = { name = "주니어 레이스의 뼈", icon = "24eaf4db239642f5bcbe794e2da8a34f", coinValue = 10 },
			wraith_bone = { name = "레이스의 뼈", icon = "24eaf4db239642f5bcbe794e2da8a34f", coinValue = 10 },
			skeledog_bone = { name = "스켈독의 뼈", icon = "2202746413d64700bb6e09b6b9a8f4e0", coinValue = 10 },
			mummydog_bandage = { name = "머미독의 붕대", icon = "0db9f5281dc44a07a33038baaf426d66", coinValue = 10 },

			unknown_ticket = { name = "알 수 없는 티켓", icon = "5d9d14a961464c0da4c2dae7ed99b8a0", coinValue = 0 },
		}
	end

	@ExecSpace("ServerOnly")
	method void ConvertAllToCoins()
		-- 이번 런에 가방에 쌓인 잡템을 전부 골드로 환전하고 비운다.
		-- "이어하기"는 가방을 그대로 유지해야 하므로, "처음부터 다시하기"(RestartGame)에서만 호출한다
		local defs = self:GetAllItemDefs()
		local itemIds = {
			"slime_ooze", "old_leather", "evileye_tail", "curseeye_tail",
			"snail_shell", "blue_snail_shell", "mushroom_spore", "red_snail_shell",
			"pig_tail", "jr_boogie_horn", "stump_tear", "octopus_leg", "ribbon",
			"fox_tail", "orange_mushroom_cap",
			"lorang_claw", "umti_shell", "klang_claw",
			"flying_fish", "clam_shell", "starfish_leg",
			"horned_mushroom_cap", "zombie_mushmom_spore", "bat_wing",
			"stone_golem_fragment", "dark_stone_golem_fragment", "mix_golem_piece",
			"ice_mix_golem_piece", "fairy_antenna", "royal_fairy_wing", "grey_tentacle",
			"firefly_slime_gel", "fairy_slime_gel", "water_elemental_essence",
			"tree_elemental_leaf", "mystic_wisp_dust", "lesser_spellbook_page",
			"lupin_banana", "jaguar_claw", "banana_gull_feather", "zombie_lupin_peel",
			"jr_necki_hide", "ligator_hide", "croco_hide", "swamp_mud", "sprout_mud",
			"melody_broom", "steagy_wing",
			"jr_wraith_bone", "wraith_bone", "skeledog_bone", "mummydog_bandage",
			"unknown_ticket",
		}
		local totalValue = 0
		for _, itemId in ipairs(itemIds) do
			local count = self:GetItemCount(itemId)
			if count > 0 then
				totalValue = totalValue + count * defs[itemId].coinValue
				self.ItemCounts[itemId] = 0
				self.AcquisitionOrder[itemId] = nil
			end
		end
		self._nextOrderIndex = 1
		if totalValue > 0 then
			_GameManager:AddGold(totalValue)
			log("Inventory converted to coins: +" .. totalValue)
		end
	end

end
