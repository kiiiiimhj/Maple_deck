@Logic
script PlayerInventory extends Logic

	-- 몬스터 드랍/상점 구매로 얻는 잡템 개수. 이번 런 동안만 유지되고, 게임오버 시점에 골드로 일괄 환전된다
	@Sync property SyncTable<string, integer> ItemCounts
	-- itemId별 "처음 획득한 순번" — 인벤토리 UI가 획득한 순서대로 슬롯을 채우는 데 쓴다
	@Sync property SyncTable<string, integer> AcquisitionOrder
	property integer _nextOrderIndex = 1

	@ExecSpace("ServerOnly")
	method void AddItem(string itemId, integer amount)
		-- 가방에 아이템을 지급한다. 존재하지 않던 itemId면 0에서부터 시작한다
		self:ReserveAcquisitionOrder(itemId)
		local current = self:GetItemCount(itemId)
		self.ItemCounts[itemId] = current + amount
		log("Inventory: " .. itemId .. " +" .. amount .. " -> " .. tostring(self.ItemCounts[itemId]))
	end

	@ExecSpace("ServerOnly")
	method void ReserveAcquisitionOrder(string itemId)
		-- 실제 지급(AddItem)은 드롭 연출이 도착하는 시점까지 지연되는데, 그때 순번을 매기면
		-- 나중에 죽은 몬스터의 아이템이 랜덤 딜레이가 짧아서 먼저 도착해 순서가 뒤바뀔 수 있다.
		-- 그래서 드롭이 확정되는 즉시(연출 시작 전) 순번부터 미리 예약해둔다
		if self.AcquisitionOrder[itemId] ~= nil then return end
		self.AcquisitionOrder[itemId] = self._nextOrderIndex
		self._nextOrderIndex = self._nextOrderIndex + 1
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- 인벤토리를 연 상태에서 아이템을 획득해도 실시간으로 개수가 반영되도록 알려준다
		if name == "ItemCounts" then
			_InventoryUI:NotifyInventoryChanged()
		end
	end

	method table GetOrderedItemIds()
		-- 현재 보유 중인(개수>0) 잡템 id를 "처음 획득한 순서"대로 정렬해 돌려준다
		local allIds = { "slime_ooze", "monster_bone", "monster_claw", "old_leather", "mana_crystal", "unknown_ticket" }
		local owned = {}
		for _, itemId in ipairs(allIds) do
			if self:GetItemCount(itemId) > 0 and self.AcquisitionOrder[itemId] ~= nil then
				table.insert(owned, { id = itemId, order = self.AcquisitionOrder[itemId] })
			end
		end
		table.sort(owned, function(a, b) return a.order < b.order end)
		local result = {}
		for _, entry in ipairs(owned) do table.insert(result, entry.id) end
		return result
	end

	method integer GetItemCount(string itemId)
		if self.ItemCounts[itemId] == nil then return 0 end
		return self.ItemCounts[itemId]
	end

	method table GetItemDef(string itemId)
		local defs = self:GetAllItemDefs()
		return defs[itemId]
	end

	method table GetAllItemDefs()
		-- 아이템 카탈로그(이름/아이콘/골드 환전가). 신규 아이템은 여기에만 등록하면 가방/상점/환전 로직이 전부 따라온다
		return {
			slime_ooze = { name = "수상한 점액", icon = "0a5bb1c16e8948118239a1f126cfdc5a", coinValue = 2 },
			monster_bone = { name = "마물의 뼈", icon = "37ac021b7018490db650f93ee43d1e60", coinValue = 3 },
			monster_claw = { name = "몬스터 발톱", icon = "1ea52570e8154fcbb3944e3c2665bb7a", coinValue = 3 },
			old_leather = { name = "낡은 가죽", icon = "7cb8bfdc6e754fcfa6b5df522c085d0d", coinValue = 4 },
			mana_crystal = { name = "마정석 조각", icon = "12c94942740e4fe594ac1bb94c2b9fa2", coinValue = 6 },
			unknown_ticket = { name = "알 수 없는 티켓", icon = "5d9d14a961464c0da4c2dae7ed99b8a0", coinValue = 0 },
		}
	end

	@ExecSpace("ServerOnly")
	method void ConvertAllToCoins()
		-- 이번 런에 가방에 쌓인 잡템을 전부 골드로 환전하고 비운다.
		-- "이어하기"는 가방을 그대로 유지해야 하므로, "처음부터 다시하기"(RestartGame)에서만 호출한다
		local defs = self:GetAllItemDefs()
		local itemIds = { "slime_ooze", "monster_bone", "monster_claw", "old_leather", "mana_crystal", "unknown_ticket" }
		local totalValue = 0
		for _, itemId in ipairs(itemIds) do
			local count = self:GetItemCount(itemId)
			if count > 0 then
				totalValue = totalValue + count * defs[itemId].coinValue
				self.ItemCounts[itemId] = 0
				self.AcquisitionOrder[itemId] = nil
			end
		end
		self._nextOrderIndex = 1
		if totalValue > 0 then
			_GameManager:AddGold(totalValue)
			log("Inventory converted to coins: +" .. totalValue)
		end
	end

end
