@Logic
script GachaUI extends Logic

	property Entity gachaGroup = "52f1ba6e-e680-446b-80cd-16a417d3b766"

	property ButtonComponent btnOpen = "5e347139-8e1c-4aa2-8cad-b71126d93f1c"

	property ButtonComponent btnClose = "63097ce5-4b6e-47ba-a0c9-ef9f4cd4a602"

	property ButtonComponent btnPull1 = "a0d524d7-1c98-45fc-aeda-262624d9bf47"

	property ButtonComponent btnPull10 = "9200c775-1054-4b14-ae05-a9c3c9a70535"

	property Entity monsterTemplate = "02e50ccf-8670-40d3-9289-d314de3c9e99"

	property Entity magicEffectTemplate = "6152b0ff-3767-4bb3-8cbb-508a879cb7bb"

	property Entity magicImpactTemplate = "5335103c-6880-41cc-bed6-4f77e97f2af5"

	property Entity relicDropTemplate = "e79b0aae-286d-472b-9cc5-2827b34250cc"

	property Entity characterIcon = "4f95f489-53d3-4b53-9c80-d118abd5b2a0"

	property Entity bossTemplate = "20e9b44e-c462-49e0-ab65-652587283c76"

	property Entity damageTextTemplate = "acd7d340-c967-45ed-9bc4-bd099a42d850"

	property Entity teleportEffectTemplate = "f3f2e301-a772-4b31-9cc9-d63aa6282aac"

	-- 소환 마법진 템플릿. 보스용(skill/400021060)과 일반 몬스터용(skill/65001002) 두 가지를
	-- 같은 템플릿으로 돌려쓴다 — 클론할 때 RUID와 크기를 갈아끼운다. 소환 대상보다 뒤에 그려진다
	property Entity summonEffectTemplate = "a6d27f77-812f-44b7-814e-4e5a0b84c583"

	property string SummonBossRUID = "988f0dece4814e3c917626021bad2347"

	property Vector2 SummonBossSize = Vector2(310, 289)

	property string SummonSoundRUID = "a4f0e688b3fd429aa11ae8397784769a"

	-- 유물 뽑기(일반 몬스터) 소환 — 노란 룬 원. 몬스터가 70x70이라 보스보다 훨씬 작게 쓴다
	property string SummonMobRUID = "d5fba2e62a05435e807dbafd9dc3a695"

	property Vector2 SummonMobSize = Vector2(120, 115)

	property string SummonMobSoundRUID = "ca5671be6505481d92b6376167a3285f"

	-- 몬스터 소환 연출 길이. 이만큼 지난 뒤에 전투(공격 타이머)가 시작된다
	property number _mobSummonIntro = 0.55

	-- 소환 연출 길이. 이 시간이 끝난 뒤에 전투 타이머가 돌기 시작하므로 패는 시간(duration)은 그대로 보장된다
	property number _raidIntroDuration = 1.15

	property any _raidIntroTimerId = nil

	-- 텔레포트 스킬팩(skill/20011293) 리소스. 퇴장은 바닥 마법진+빛기둥(effect0), 등장은
	-- 컴팩트한 파란 폭발(effect)로 나눠 쓴다
	property string TeleportDepartRUID = "a1a1e8bc400642c9ba4d7ac2c3089829"

	property Vector2 TeleportDepartSize = Vector2(210, 130)

	property string TeleportArriveRUID = "b7c276a23c2948a2a541420285f1773e"

	property Vector2 TeleportArriveSize = Vector2(165, 122)

	-- 마법진이 발밑에 오도록 캐릭터 중심에서 아래로 내린다
	property number TeleportEffectYOffset = -34

	-- 스킬팩의 audio/Use. 보스별 사운드는 _bossSpecies의 sfx에 들어 있다
	property string TeleportSoundRUID = "38de97f216814bf4ab85107c2cdb5b92"

	property Entity bgCover = "08fe0c58-c75d-4415-827d-bb6f9381f30d"

	property Entity resultSlotTemplate = "58b478c3-efa9-422a-a587-aa1ff73e3a60"

	property Entity resultTitle = "9f2dba68-7c6c-40dc-9988-ed588530d3a3"

	property ButtonComponent btnSkip = "cf78fd7c-c466-482f-8218-97978aa80d59"

	-- 좌측 탭 레일 — 스킬 뽑기 / 유물 뽑기를 고른다. 고른 탭에 따라 필드에서 떨어지는 보상 종류와
	-- 지급처(_SkillInventory / _RelicInventory)가 통째로 갈린다. 연출/전투 로직은 완전히 공유한다.
	property ButtonComponent btnTabSkill = "92704f1e-bbb1-4427-af65-9d4abd526aed"

	property ButtonComponent btnTabRelic = "5023b0ab-b8bd-44e9-be09-85ff6ec8f958"

	property TextComponent titleText = "28d0c5aa-0d27-43c9-8793-2029bb79cda9"

	property TextComponent pull1Text = "a0d524d7-1c98-45fc-aeda-262624d9bf47"

	property TextComponent pull10Text = "9200c775-1054-4b14-ae05-a9c3c9a70535"

	-- 현재 탭. true면 스킬 뽑기, false면 유물 뽑기(기존 동작). 기본값은 스킬 — 목업 기준
	property boolean _skillMode = true

	-- 뽑기 비용(다이아). 버튼 라벨도 이 값으로 만들어진다
	property integer Pull1Cost = 100

	property integer Pull10Cost = 1000

	-- 스킬 뽑기 등급 가중치 — 1=일반 / 2=매직 / 3=레어. 합이 100일 필요는 없다(비율로만 쓴다)
	property any _gradeWeights = { 70, 25, 5 }

	property any _skillBuckets = nil  -- { [grade] = { 0-based 스킬 인덱스, ... } }

	property any _tabSkillHandler = nil

	property any _tabRelicHandler = nil

	property any _tabSkillStateHandler = nil

	property any _tabRelicStateHandler = nil

	-- Bg_cover가 위로 올라가는 거리 / 열고 닫을 때 걸리는 시간 (팝 연출 0.08초는 별도)
	property number _coverLiftDistance = 140

	property number _coverAnimDuration = 0.32

	property any _coverBasePos = nil

	property any _coverBaseColor = nil

	-- BeginPull부터 결과 아이콘 표시가 끝날 때까지 true. 이 동안 탭 전환을 완전히 막는다
	property boolean _pullInProgress = false

	property integer _pullTotal = 0

	property integer _pullDropsDone = 0

	property any _pullResultCounts = nil  -- { [slotIndex]=count, ... }

	property any _pullResultOrder = nil  -- { slotIndex, ... } 처음 나온 순서

	property any _resultIcons = nil  -- 이번에 Clone된 결과 아이콘들, 다음 뽑기 시작 시 정리한다

	property any _openHandler = nil

	property any _closeHandler = nil

	property any _pull1Handler = nil

	property any _pull10Handler = nil

	property any _openStateHandler = nil

	property any _closeStateHandler = nil

	property any _pull1StateHandler = nil

	property any _pull10StateHandler = nil

	property any _skipHandler = nil

	property any _skipStateHandler = nil

	-- 잔디(Panel/Field/Bg) 엔티티. 장식(Deco_*)이 이 아래에 붙어 있어서, 몬스터 진입금지 영역을
	-- 여기서 직접 읽어 만든다 (Maker에서 장식을 옮겨도 자동으로 따라온다)
	property Entity fieldBg = "dba5b261-4ac3-4bb9-b27d-5f536bd92018"

	-- 필드 좌표는 전부 Field 로컬 기준이다. 잔디가 Field 원점에 있지 않으므로(디자인 변경으로
	-- (188, 58)만큼 밀려 있다) 중심을 따로 들고 있어야 한다 — 예전엔 (0,0) 가정이라 캐릭터와
	-- 몬스터 스폰 원이 통째로 잔디 밖으로 어긋나 있었다
	property Vector2 _fieldCenter = Vector2(188, 58)

	-- 잔디 반크기(440 x 251)에서 몬스터 스프라이트 반폭(35)만큼 뺀 값. 이보다 크게 잡으면
	-- 배회하다 몬스터가 잔디 밖 나무 프레임 위로 삐져나온다
	property number _fieldHalfWidth = 385

	property number _fieldHalfHeight = 205

	-- 아바타가 "지금" 서 있는 자리 — CharacterIcon의 anchoredPosition과 항상 일치해야 마법/텔레포트
	-- 연출이 정확히 발밑에서 시작한다. 보스 레이드 중에는 궤도를 돌며 계속 바뀌고, 끝나면
	-- _avatarHomePosition으로 되돌린다
	property Vector2 _avatarPosition = Vector2(188, 58)

	-- 몬스터가 이 반경 안으로는 들어오지 못하게 밀어내서 아바타를 그냥 관통하지 않게 한다
	property number _avatarAvoidRadius = 95

	-- 한 번에 이동하는 거리를 필드 전체가 아니라 이 정도로 짧게 제한해서 자연스럽게 배회하도록 한다
	property number _wanderStepRadius = 140

	-- 10뽑 때 아바타를 둘러싸는 등장 원의 반경
	property number _spawnRingRadiusX = 300

	property number _spawnRingRadiusY = 150

	-- 장식 오브젝트가 차지한 사각형 목록(Field 로컬). BuildBlockedRects()가 채운다
	property table _blockedRects = {}

	-- 몬스터가 장식에 겹쳐 보이지 않도록 사각형을 이만큼 부풀려 판정한다
	property number _blockedMargin = 12

	-- 아바타의 원래 자리(잔디 정중앙). 보스 레이드에서 아바타가 돌아다니므로 _avatarPosition은
	-- "지금 서 있는 자리"로 계속 바뀌고, 레이드가 끝나면 이 값으로 되돌린다
	property Vector2 _avatarHomePosition = Vector2(188, 58)

	-- 스킬 뽑기 전용 보스 레이드 상태
	property any _boss = nil

	property any _raidPlayerTimerId = nil

	property any _raidBossTimerId = nil

	property any _raidEndTimerId = nil

	property integer _raidAttackIndex = 0

	property integer _raidDropEvery = 2

	property integer _raidDropsDuringLeft = 0

	property integer _raidDropsOnDeath = 0

	property boolean _raidActive = false

	-- 아바타가 보스 주위를 도는 반경 / 공격 간격 / 보스 공격 간격
	-- 보스 스프라이트가 커서(가로 약 300px) 궤도가 좁으면 아바타가 계속 보스 몸통 안에 겹쳐 보인다.
	-- 보스 반폭보다 확실히 바깥을 돌도록 넉넉히 잡는다
	property number _raidOrbitRadiusX = 215

	property number _raidOrbitRadiusY = 95

	property number _raidPlayerInterval = 0.55

	property number _raidBossInterval = 1.6

	-- 보스는 잔디 중앙보다 살짝 위에 자리잡는다(아바타가 아래쪽을 돌 공간을 준다)
	property Vector2 _bossPosition = Vector2(188, 108)

	-- 두 보스의 원본 크기가 크게 달라서(식신 186x155 / 슬라임 494x365) 액션마다 원본 비율을 지킨 채
	-- 화면상 크기만 맞추도록, 종별 배율을 미리 곱한 액션별 RectSize를 들고 있는다.
	-- 기준: stand 높이 ≈ 185px (일반 몬스터 70px보다 확실히 크다)
	property any _bossSpecies = {
