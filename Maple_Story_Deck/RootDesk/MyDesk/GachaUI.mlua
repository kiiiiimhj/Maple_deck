		{
			name = "가디언 엔젤 슬라임",
			stand = { ruid = "96af297ca7ff4bbc9fc58849ac3ba473", w = 252, h = 186 },
			move = { ruid = "b7085b82b6224790a0bd5c8b2c844778", w = 251, h = 186 },
			attack1 = { ruid = "5126d2297418481894fc9f22456559c4", w = 297, h = 283 },
