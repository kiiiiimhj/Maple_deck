			-- 식신 리소스팩에는 오디오 엘리먼트가 없어서(팩 확인 완료) 범용 몬스터 효과음을 붙였다
			sfx = {
				attack1 = "d018873e22394e95af330c8a5443129f",
				attack2 = "1b639cf75e084e0a85f4a18d21eab90e",
