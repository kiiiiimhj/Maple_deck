	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 팝업은 기본적으로 닫힌 상태로 시작한다
		self.gachaGroup.Enable = false
		self._monsters = {}
		self._pullResultCounts = {}
		self._pullResultOrder = {}
		self._resultIcons = {}
		-- Bg_cover의 "닫힌(덮인)" 상태 기준값을 미리 기억해둔다 - 열기/닫기 애니메이션이 항상 이 값을 기준으로 움직인다
		if isvalid(self.bgCover) then
			self._coverBasePos = self.bgCover.UITransformComponent.anchoredPosition
			self._coverBaseColor = self.bgCover.SpriteGUIRendererComponent.Color
		end
		self:BuildBlockedRects()
		if isvalid(self.resultSlotTemplate) then self.resultSlotTemplate:SetEnable(false) end
		if isvalid(self.resultTitle) then self.resultTitle.Enable = false end
		self.btnSkip.Entity.Enable = false
		self._openHandler = self.btnOpen.Entity:ConnectEvent(ButtonClickEvent, self.Open)
		self._closeHandler = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, self.Close)
		self._pull1Handler = self.btnPull1.Entity:ConnectEvent(ButtonClickEvent, self.OnPull1Clicked)
		self._pull10Handler = self.btnPull10.Entity:ConnectEvent(ButtonClickEvent, self.OnPull10Clicked)
		self._skipHandler = self.btnSkip.Entity:ConnectEvent(ButtonClickEvent, self.OnSkipClicked)
		-- 패딩(눌림) 연출 — 누르는 순간 작아지고 떼는 순간 원래 크기로 돌아온다 (클릭 시점이 아니라 프레스/릴리즈 상태 자체에 붙인다)
		self._openStateHandler = self.btnOpen.Entity:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnButtonStateChanged(event, self.btnOpen.Entity) end)
		self._closeStateHandler = self.btnClose.Entity:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnButtonStateChanged(event, self.btnClose.Entity) end)
		self._pull1StateHandler = self.btnPull1.Entity:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnButtonStateChanged(event, self.btnPull1.Entity) end)
		self._pull10StateHandler = self.btnPull10.Entity:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnButtonStateChanged(event, self.btnPull10.Entity) end)
		self._skipStateHandler = self.btnSkip.Entity:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnButtonStateChanged(event, self.btnSkip.Entity) end)
		self._tabSkillHandler = self.btnTabSkill.Entity:ConnectEvent(ButtonClickEvent, function() self:SetMode(true) end)
		self._tabRelicHandler = self.btnTabRelic.Entity:ConnectEvent(ButtonClickEvent, function() self:SetMode(false) end)
		self._tabSkillStateHandler = self.btnTabSkill.Entity:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnButtonStateChanged(event, self.btnTabSkill.Entity) end)
		self._tabRelicStateHandler = self.btnTabRelic.Entity:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnButtonStateChanged(event, self.btnTabRelic.Entity) end)
		self:ApplyModeVisual()
		log("GachaUI started")
	end

	@ExecSpace("ClientOnly")
	method void SetMode(boolean skillMode)
		-- 탭 전환. 연출이 도는 중에는(_fieldActive) 보상 종류가 중간에 바뀌면 안 되므로 무시한다.
		-- ⚠ _fieldActive만으로는 부족하다 — 필드 연출이 끝난 뒤에도 결과 아이콘을 그리기까지 0.32초의
		-- 공백이 있고, 그 사이 탭을 바꾸면 GetRewardIconRuid가 바뀐 _skillMode를 보고 스킬 결과를
		-- 유물 아이콘으로 그려버린다(유저 리포트: "결과창 뜰 때 빠르게 유물 누르면 유물이 뽑은 걸로 나온다").
		-- 결과 표시까지 완전히 끝나야 풀리는 _pullInProgress로 그 구간을 막는다
		if self._pullInProgress then return end
		-- 탭 전환. 연출이 도는 중에는(_fieldActive) 보상 종류가 중간에 바뀌면 안 되므로 무시한다
		if self._fieldActive then return end
		if self._skillMode == skillMode then return end
		self._skillMode = skillMode
		-- 이전 탭에서 띄워둔 결과 아이콘은 다른 종류라 그대로 두면 헷갈린다 — 같이 치운다
		self:ClearResultIcons()
		self:ApplyModeVisual()
		log("GachaUI: mode = " .. self:GetModeName())
	end

	@ExecSpace("ClientOnly")
	method string GetModeName()
		-- 타이틀/버튼 라벨에 쓰는 현재 탭 이름
		if self._skillMode then return "스킬" end
		return "유물"
	end

	@ExecSpace("ClientOnly")
	method void ApplyModeVisual()
		-- 선택된 탭만 원색으로 밝히고 나머지는 어둡게 눌러둔다. 타이틀과 두 뽑기 버튼 라벨도
		-- 현재 탭 이름으로 다시 쓴다(버튼 아트는 공용이고 글자만 바뀐다)
		local name = self:GetModeName()
		local onColor = Color(1, 1, 1, 1)
		local offColor = Color(0.55, 0.5, 0.42, 1)
		local skillSprite = self.btnTabSkill.Entity.SpriteGUIRendererComponent
		local relicSprite = self.btnTabRelic.Entity.SpriteGUIRendererComponent
		if isvalid(skillSprite) then
			if self._skillMode then skillSprite.Color = onColor else skillSprite.Color = offColor end
		end
		if isvalid(relicSprite) then
			if self._skillMode then relicSprite.Color = offColor else relicSprite.Color = onColor end
		end
		if isvalid(self.titleText) then self.titleText.Text = name .. " 뽑기" end
		-- 결과창 타이틀("획득한 유물!")도 같은 이름을 따라간다
		if isvalid(self.resultTitle) then self.resultTitle.TextComponent.Text = "획득한 " .. name .. "!" end
		if isvalid(self.pull1Text) then self.pull1Text.Text = name .. " 뽑기 X1\n다이아 : " .. tostring(self.Pull1Cost) end
		if isvalid(self.pull10Text) then self.pull10Text.Text = name .. " 뽑기 X10\n다이아 : " .. tostring(self.Pull10Cost) end
	end

	@ExecSpace("ClientOnly")
	method void Open()
		-- 이전에 어떤 이유로 결과 연출이 끊겨 잠금이 남아 있었더라도, 다시 열 때는 반드시 풀린 상태로 시작한다
		if self._pullInProgress and not self._fieldActive then
			self:FinishPullPresentation()
		end
		self.gachaGroup.Enable = true
		-- 열 때마다 현재 탭 표시와 다이아 잔액 기준 버튼 상태를 다시 맞춘다
		self:ApplyModeVisual()
		self:SetPullButtonsEnabled(true)
		-- 인벤토리에서 장착 중인 장비를 뽑기 캐릭터에 반영한다(연 사이에 장비를 바꿨을 수 있다)
		self:ApplyPlayerAvatar()
	end

	@ExecSpace("ClientOnly")
	method void ApplyPlayerAvatar()
		-- 인벤토리에서 장착한 장비를 뽑기 캐릭터 아바타에도 그대로 입힌다.
		-- UIEquippedGearPanel:Update()와 완전히 같은 규칙을 따라야 한다 — 그 파일에 기록된 함정 두 가지:
		--  (1) SetEquip은 "thumbnail://" 접두사가 붙은 RUID를 조용히 미착용 처리하므로, 장비 라인
		--      아이템은 GetAvatarRUID로 접두사를 뗀 순수 Guid를 넘겨야 한다
		--  (2) 인벤 카테고리와 아바타 카테고리가 1:1이 아니다(활/양손검은 인벤상 OneHandedWeapon이지만
		--      아바타상 TwoHandedWeapon). 순회하며 즉시 SetEquip하면 나중 순회가 앞서 입힌 걸 ""로
		--      덮어써서 아바타가 벗겨지므로, 전부 모은 뒤 한 번에 반영한다
		if not isvalid(self.characterIcon) then return end
		local costume = self.characterIcon.CostumeManagerComponent
		if not isvalid(costume) then return end

		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local inventory = player.PkgPlayerInventory
		if not isvalid(inventory) then return end

		-- CurrentJob은 UIInventory.Open()에서만 세팅돼서 인벤을 한 번도 안 열면 nil이다 — ResolveCurrentJob을 쓴다
		local job = inventory:ResolveCurrentJob()
		if job == nil then return end
		local gearGUIDByCategory = inventory.AttachedNormalGearItems[job]
		if gearGUIDByCategory == nil then gearGUIDByCategory = {} end

		local avatarEquipByCategory = {}
		for i, gearEnum in ipairs(_GearCategoryEnum:GetEnums()) do
			local lookupEnum = gearEnum
			if lookupEnum == _GearCategoryEnum.TwoHandedWeapon then
				lookupEnum = _GearCategoryEnum.OneHandedWeapon
			end

			local gearGUID = gearGUIDByCategory[lookupEnum]
			---@type ItemStruct
			local itemStruct = nil
			-- 장착 목록에 GUID만 남고 실제 아이템이 사라진 "댕글링 장착"이 있을 수 있어 itemStruct 유무로 분기한다
			if gearGUID then itemStruct = inventory.Items[gearGUID] end
			if itemStruct ~= nil then
				if _WeaponTierDataLogic:IsWeaponItem(itemStruct.ItemId) then
					local gearStruct = itemStruct:GetGearStruct()
					local grade = 0
					if gearStruct ~= nil then grade = gearStruct.Grade end
					local avatarGearEnum = _WeaponTierDataLogic:GetAvatarGearCategory(itemStruct.ItemId)
					if avatarGearEnum ~= -1 then
						avatarEquipByCategory[avatarGearEnum] = _WeaponTierDataLogic:GetAvatarRUID(itemStruct.ItemId, grade)
					end
				else
					local gearData = itemStruct:GetGearData()
					if gearData ~= nil then
						avatarEquipByCategory[lookupEnum] = gearData.AvatarRUID
					end
				end
			end
		end

		local equippedCount = 0
		for i, gearEnum in ipairs(_GearCategoryEnum:GetEnums()) do
			---@type MapleAvatarItemCategory
			local avatarCategoryEnum = _GearCategoryEnum:ToAvatarCategory(gearEnum)
			if avatarCategoryEnum ~= _GearCategoryEnum.None then
				local ruid = avatarEquipByCategory[gearEnum]
				if ruid == nil then ruid = "" end
				if ruid ~= "" then equippedCount = equippedCount + 1 end
				costume:SetEquip(avatarCategoryEnum, ruid)
			end
		end
		log("GachaUI: avatar synced from inventory, job=" .. tostring(job) .. " equippedSlots=" .. tostring(equippedCount))
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 뽑기 도중에 닫으면(전투/드롭 애니메이션이 아직 안 끝난 채로) 다음에 다시 열었을 때
		-- Bg_cover가 반쯤 들린 채로 남아있지 않도록 덮인 기본 상태로 즉시 되돌려놓는다
		self:ResetCoverToClosedState()
		self.gachaGroup.Enable = false
	end

	@ExecSpace("ClientOnly")
	method void OnPull1Clicked()
		-- 이미 진행 중인 뽑기가 있으면 무시 — 버튼이 비활성화되어 있어도 이중 안전장치로 한 번 더 막는다
		if self._fieldActive then return end
		_GameManager:RequestGachaSpend(self.Pull1Cost, 1, self._skillMode)
	end

	@ExecSpace("ClientOnly")
	method void OnPull10Clicked()
		if self._fieldActive then return end
		_GameManager:RequestGachaSpend(self.Pull10Cost, 10, self._skillMode)
	end

	@ExecSpace("Client")
	method void OnGachaSpendApproved(integer count, boolean isSkill)
		-- 서버가 다이아를 실제로 깎은 뒤에만 도착한다 — 여기서부터가 기존 연출 흐름 그대로다.
		-- 요청과 응답 사이에 탭을 바꿨을 가능성은 없지만(연출 중 탭 잠금), 결제된 종류를 그대로 따른다
		if self._fieldActive then return end
		self._skillMode = isSkill
		self:ApplyModeVisual()
		self:BeginPull(count)
		if isSkill then
			-- 스킬 뽑기는 보스 레이드 연출. 1뽑은 짧게, 10뽑은 길게 돌린다
			local duration = 10.0
			if count <= 1 then duration = 4.0 end
			self:StartBossRaid(count, duration)
		elseif count <= 1 then
			self:StartField(1, 1.0)
		else
			self:StartField(count, 0.35)
		end
	end

	@ExecSpace("ClientOnly")
	method void NotifyDiamondChanged(integer newTotal)
		-- TitleUI의 다이아 배지 갱신과 같은 타이밍에 호출된다. 팝업 쪽엔 잔액 라벨이 따로 없으므로
		-- 뽑기 버튼의 "살 수 있는지"만 다시 반영한다
		if self._fieldActive then return end
		self:SetPullButtonsEnabled(true)
	end

	@ExecSpace("ClientOnly")
	method void BuildSkillBuckets()
		-- SkillInventory의 스킬을 등급별 바구니로 한 번만 분류해둔다(뽑을 때마다 60개를 다시 훑지 않도록).
		-- 다른 Logic의 프로퍼티(_skillDefs / skillCount)를 직접 읽으면 런타임에 nil이 잡히므로
		-- 반드시 SkillInventory가 노출한 접근자 메서드만 쓴다
		if self._skillBuckets ~= nil then return end
		self._skillBuckets = { {}, {}, {} }
		local count = _SkillInventory:GetSkillCount()
		for i = 0, count - 1 do
			local g = _SkillInventory:GetSkillGrade(i)
			if g >= 1 and g <= 3 then
				table.insert(self._skillBuckets[g], i)
			end
		end
		log("GachaUI: skill buckets = " .. tostring(#self._skillBuckets[1]) .. "/" .. tostring(#self._skillBuckets[2]) .. "/" .. tostring(#self._skillBuckets[3]))
	end

	@ExecSpace("ClientOnly")
	method integer RollSkillIndex()
		-- 등급을 가중 추첨한 뒤 그 등급 안에서는 균등하게 하나 고른다. 해당 등급이 비어 있으면 일반(1)로 내린다
		self:BuildSkillBuckets()
		local total = 0
		for i = 1, 3 do total = total + self._gradeWeights[i] end
		local roll = _UtilLogic:RandomDouble() * total
		local grade = 1
		local acc = 0
		for i = 1, 3 do
			acc = acc + self._gradeWeights[i]
			if roll < acc then
				grade = i
				break
			end
		end
		local bucket = self._skillBuckets[grade]
		if bucket == nil or #bucket == 0 then bucket = self._skillBuckets[1] end
		if bucket == nil or #bucket == 0 then return 0 end
		return bucket[_UtilLogic:RandomIntegerRange(1, #bucket)]
	end

	@ExecSpace("ClientOnly")
	method integer RollRewardIndex()
		-- 현재 탭에 맞는 보상 하나를 뽑아 0-based 인덱스로 돌려준다.
		-- 유물은 기존과 동일한 균등 추첨, 스킬은 등급 가중 추첨이다
		if self._skillMode then return self:RollSkillIndex() end
		return _UtilLogic:RandomIntegerRange(1, #self._relicIconRuids) - 1
	end

	@ExecSpace("ClientOnly")
	method string GetRewardIconRuid(integer index)
		-- 필드 드롭 아이콘과 결과창 아이콘이 같은 이 함수를 쓴다(둘이 어긋나지 않도록)
		if not self._skillMode then return self._relicIconRuids[index + 1] end
		return _SkillInventory:GetSkillIconRuid(index)
	end

	@ExecSpace("ClientOnly")
	method void GrantReward(integer index)
		-- 보상이 아바타에 도착하는 시점에 실제 지급까지 서버에 요청한다
		if self._skillMode then
			_SkillInventory:RequestAddSkill(index)
		else
			_RelicInventory:RequestAddRelic(index)
		end
		self:RegisterPullResult(index)
	end

	@ExecSpace("ClientOnly")
	method void OnButtonStateChanged(ButtonStateChangeEvent event, Entity buttonEntity)
		-- Pressed 상태가 되는 순간 작아지고, 그 외(뗐을 때 등) 상태로 돌아오면 원래 크기로 복귀한다
		if not isvalid(buttonEntity) then return end
		if event.state == ButtonState.Pressed then
			_TweenLogic:ScaleTo(buttonEntity, Vector2(0.9, 0.9), 0.06, EaseType.QuadEaseOut)
		else
			_TweenLogic:ScaleTo(buttonEntity, Vector2(1, 1), 0.12, EaseType.QuadEaseOut)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetPullButtonsEnabled(boolean enabled)
		-- 뽑기 진행 중에는 두 버튼을 눌러도 반응하지 않도록 막고, 흐릿하게 비활성 상태를 보여준다.
		-- 진행 중이 아니어도 다이아가 모자라는 쪽은 같은 방식으로 눌러 끈다(서버에서 어차피 거절된다)
		local can1 = false
		local can10 = false
		if enabled then
			can1 = _GameManager.Diamond >= self.Pull1Cost
			can10 = _GameManager.Diamond >= self.Pull10Cost
		end
		self.btnPull1.Enable = can1
		self.btnPull10.Enable = can10
		self:ApplyButtonDim(self.btnPull1.Entity, can1)
		self:ApplyButtonDim(self.btnPull10.Entity, can10)
	end

	@ExecSpace("ClientOnly")
	method void ApplyButtonDim(Entity buttonEntity, boolean active)
		-- 배경 알파만 낮춰서 "지금은 못 누른다"를 보여준다(버튼 아트 자체는 그대로 둔다)
		if not isvalid(buttonEntity) then return end
		local sprite = buttonEntity.SpriteGUIRendererComponent
		if not isvalid(sprite) then return end
		local alpha = 1.0
		if not active then alpha = 0.5 end
		sprite.Color = Color(sprite.Color.r, sprite.Color.g, sprite.Color.b, alpha)
	end

	@ExecSpace("ClientOnly")
	method void BeginPull(integer count)
		-- 이번 뽑기에서 몇 개를 기대하는지 기록해두고(전부 도착해야 결과창을 띄운다), 결과 집계를 초기화한 뒤
		-- Bg_cover를 들어올려 뽑기 연출이 보이도록 연다
		self._pullInProgress = true
		self._pullTotal = count
		self._pullDropsDone = 0
		self._pullResultCounts = {}
		self._pullResultOrder = {}
		self:ClearResultIcons()
		-- 뽑기 진행 중에는 닫기 버튼을 아예 눌러 끄고 숨긴다 - 연출 도중 나가버리는 것을 막는다
		self.btnClose.Entity.Enable = false
		-- 대신 스킵 버튼을 켜서 필드 연출을 건너뛸 수 있게 한다
		self.btnSkip.Entity.Enable = true
		-- 연출 도중 탭을 바꾸면 보상 종류가 어긋나므로 탭 버튼도 같이 잠근다(엔티티는 켜둔 채
		-- ButtonComponent만 끈다 — DisabledColor가 자동으로 적용되어 잠긴 게 보인다)
		self.btnTabSkill.Enable = false
		self.btnTabRelic.Enable = false
		self:PlayCoverOpen()
	end

	@ExecSpace("ClientOnly")
	method void OnSkipClicked()
		-- 남아있는 몬스터는 사망 연출(다이 클립 + 축소)만 재생하고 전투 없이 즉시 죽는다.
		-- 유물은 각자 자리에서 톡 튀어오른 뒤, 전부 착지하면 한 번에 다같이 아바타로 모여든다(개별로 하나씩 날아가지 않는다).
		-- 이미 죽어서 드롭 연출이 날아가는 중인 몬스터는 건드리지 않는다(중복 지급 방지, 그쪽은 스스로 끝까지 흐른다)
		if not self._fieldActive then return end
		-- 보스 레이드 중이면 남은 시간을 기다리지 않고 즉시 사망 처리한다.
		-- FinishBossRaid가 못 뿌린 도중 보상까지 사망 보상에 합쳐서 터뜨리므로 개수는 그대로 맞는다
		if self._raidActive then
			self:FinishBossRaid()
			return
		end
		if self._attackTimerId then _TimerService:ClearTimer(self._attackTimerId) end
		self._attackTimerId = nil

		local dropPositions = {}
		for _, m in ipairs(self._monsters) do
			if isvalid(m.entity) and not m.dead then
				m.dead = true
				if m.stateTimerId then _TimerService:ClearTimer(m.stateTimerId) end
				local sprite = m.entity.SpriteGUIRendererComponent
				sprite.ImageRUID = DataRef(m.clips.die)
				sprite.AnimClipPlayType = SpriteAnimClipPlayType.Onetime
				table.insert(dropPositions, m.entity.UITransformComponent.anchoredPosition)
				_TweenLogic:ScaleTo(m.entity, Vector2(0, 0), 0.3, EaseType.QuadEaseIn)
				m.entity:Destroy(0.3)
			end
		end
		self._monsters = {}
		self.btnSkip.Entity.Enable = false
		
		if #dropPositions > 0 then
			self:PlaySkipRelicCollect(dropPositions)
		end
		log("GachaUI: skipped, " .. tostring(#dropPositions) .. " monster(s) instant-killed, relics collecting together")
	end

	@ExecSpace("ClientOnly")
	method void PlaySkipRelicCollect(table positions)
		-- 각 위치에서 유물이 톡 튀어올랐다가 착지하고, 잠깐 멈춘 뒤 전부 동시에 아바타로 빨려들어간다.
		-- 획득 연출/지급도 다같이 도착하는 그 순간 한 번에 처리한다(하나씩 순서대로가 아니라)
		local pickedSlots = {}
		local relics = {}
		local popDuration = 0.15
		local fallDuration = 0.2
		
		for _, pos in ipairs(positions) do
			local popPos = Vector2(pos.x, pos.y + 35)
			local relic = self.relicDropTemplate:Clone("SkipRelicDrop_" .. tostring(_UtilLogic.ElapsedSeconds) .. "_" .. tostring(#relics))
			relic.Enable = true
			relic.UITransformComponent.anchoredPosition = pos
			local pickedIndex = self:RollRewardIndex()
			relic.SpriteGUIRendererComponent.ImageRUID = DataRef(self:GetRewardIconRuid(pickedIndex))
			table.insert(pickedSlots, pickedIndex)
			table.insert(relics, relic)
		
			local capturedRelic = relic
			_TweenLogic:PlayTween(pos, popPos, popDuration, EaseType.QuadEaseOut, function(value)
				if isvalid(capturedRelic) then capturedRelic.UITransformComponent.anchoredPosition = value end
			end)
			_TimerService:SetTimerOnce(function()
				if isvalid(capturedRelic) then
					_TweenLogic:PlayTween(popPos, pos, fallDuration, EaseType.QuadEaseIn, function(value)
						if isvalid(capturedRelic) then capturedRelic.UITransformComponent.anchoredPosition = value end
					end)
				end
			end, popDuration)
		end
		
		-- 전부 착지할 시간을 준 뒤 짧게 멈췄다가, 한 번에 다같이 아바타로 모여든다
		local landDuration = popDuration + fallDuration
		_TimerService:SetTimerOnce(function()
			local flyDuration = 0.3
			for _, relic in ipairs(relics) do
				if isvalid(relic) then
					local fromPos = relic.UITransformComponent.anchoredPosition
					local capturedRelic = relic
					_TweenLogic:ScaleTo(capturedRelic, Vector2(0.5, 0.5), flyDuration, EaseType.QuadEaseIn)
					_TweenLogic:PlayTween(fromPos, self._avatarPosition, flyDuration, EaseType.QuadEaseIn, function(value)
						if isvalid(capturedRelic) then capturedRelic.UITransformComponent.anchoredPosition = value end
					end)
					capturedRelic:Destroy(flyDuration)
				end
			end
			_TimerService:SetTimerOnce(function()
				-- 다같이 도착했으니 획득 연출도 한 번만, 지급도 한 번에 몰아서 처리한다
				self:PlayAcquireEffect()
				for _, pickedIndex in ipairs(pickedSlots) do
					self:GrantReward(pickedIndex)
				end
			end, flyDuration)
		end, landDuration + 0.25)
	end

	@ExecSpace("ClientOnly")
	method void ResetCoverToClosedState()
		-- 애니메이션 도중이든 아니든 상관없이 Bg_cover를 "닫힌" 기본 상태로 즉시 되돌린다 (팝업을 도중에 닫을 때 사용)
		if not isvalid(self.bgCover) or self._coverBasePos == nil then return end
		self.bgCover.Enable = true
		self.bgCover.UITransformComponent.anchoredPosition = self._coverBasePos
		local baseColor = self._coverBaseColor
		self.bgCover.SpriteGUIRendererComponent.Color = Color(baseColor.r, baseColor.g, baseColor.b, baseColor.a)
		self.bgCover.UITransformComponent.Scale = Vector3(1, 1, 1)
		self:ClearResultIcons()
		self.btnClose.Entity.Enable = true
		self.btnSkip.Entity.Enable = false
		self.btnTabSkill.Enable = true
		self.btnTabRelic.Enable = true
	end

	@ExecSpace("ClientOnly")
	method void PlayCoverOpen()
		-- 살짝 들썩이는 팝 연출 이후, 위로 슥 올라가면서 알파가 빠져 사라진다 -> 그 뒤로 뽑기 필드가 드러난다
		if not isvalid(self.bgCover) or self._coverBasePos == nil then return end
		self.bgCover.Enable = true
		local basePos = self._coverBasePos
		local baseColor = self._coverBaseColor
		self.bgCover.UITransformComponent.anchoredPosition = basePos
		self.bgCover.SpriteGUIRendererComponent.Color = Color(baseColor.r, baseColor.g, baseColor.b, baseColor.a)
		local liftPos = Vector2(basePos.x, basePos.y + self._coverLiftDistance)
		local capturedCover = self.bgCover
		local duration = self._coverAnimDuration
		
		_TweenLogic:ScaleTo(capturedCover, Vector2(1.04, 1.04), 0.08, EaseType.QuadEaseOut)
		_TimerService:SetTimerOnce(function()
			if not isvalid(capturedCover) then return end
			_TweenLogic:ScaleTo(capturedCover, Vector2(1, 1), 0.1, EaseType.QuadEaseOut)
			_TweenLogic:PlayTween(basePos, liftPos, duration, EaseType.QuadEaseOut, function(value)
				if isvalid(capturedCover) then capturedCover.UITransformComponent.anchoredPosition = value end
			end)
			_TweenLogic:PlayTween(baseColor.a, 0.0, duration, EaseType.QuadEaseOut, function(value)
				if isvalid(capturedCover) then
					capturedCover.SpriteGUIRendererComponent.Color = Color(baseColor.r, baseColor.g, baseColor.b, value)
				end
			end)
			_TimerService:SetTimerOnce(function()
				if isvalid(capturedCover) then capturedCover.Enable = false end
			end, duration)
		end, 0.08)
	end

	@ExecSpace("ClientOnly")
	method void StartField(integer monsterCount, number attackInterval)
		-- 팝업(Panel/Field) 초록 영역 안에서만 몬스터가 등장/배회/전투/드롭까지 전부 일어난다 (맵 이동 없음)
		self:ClearMonsters()
		self._fieldActive = true
		self:SetPullButtonsEnabled(false)
		
		-- 소환음은 마릿수와 무관하게 한 번만 울린다(10마리분이 겹치면 소음이 된다)
		_SoundOptionLogic:PlaySfx(self.SummonMobSoundRUID, 0.75)

		for i = 1, monsterCount do
			local clone = self.monsterTemplate:Clone("GachaMonster_" .. tostring(i) .. "_" .. tostring(_UtilLogic.ElapsedSeconds))
			clone.Enable = true
			local spawnPos = self:SpawnPosition(i, monsterCount)
			clone.UITransformComponent.anchoredPosition = spawnPos
			-- 각 몬스터 자리에 소환 마법진이 퍼지고, 그 안에서 몬스터가 확대되며 나타난다
			self:PlaySummonCircle(spawnPos, false)
			clone.UITransformComponent.Scale = Vector3(0, 0, 1)
			local capturedClone = clone
			_TimerService:SetTimerOnce(function()
				if isvalid(capturedClone) then
					_TweenLogic:ScaleTo(capturedClone, Vector2(1, 1), 0.22, EaseType.BackEaseOut)
				end
			end, 0.22)
			local species = self._monsterSpecies[_UtilLogic:RandomIntegerRange(1, #self._monsterSpecies)]
			-- 템플릿의 기본 스프라이트(주황버섯)가 잠깐 보였다가 바뀌는 걸 막기 위해, 배회 타이머를 기다리지 않고
			-- 클론 직후 바로 해당 종족의 stand 클립으로 덮어씌운다
			local cloneSprite = clone.SpriteGUIRendererComponent
			cloneSprite.ImageRUID = DataRef(species.stand)
			cloneSprite.AnimClipPlayType = SpriteAnimClipPlayType.Loop
			local monsterData = { entity = clone, hp = 1, stateTimerId = nil, clips = species, dead = false }
			table.insert(self._monsters, monsterData)
			-- 몬스터마다 살짝 다른 타이밍에 배회를 시작하도록 약간의 지연을 준다
			local capturedData = monsterData
			_TimerService:SetTimerOnce(function() self:SetMonsterIdle(capturedData) end, _UtilLogic:RandomDouble() * 0.5)
		end
		
		-- 소환 연출이 끝난 뒤에 전투를 시작한다 — 안 그러면 몬스터가 나타나기도 전에 맞아 죽는다
		local capturedInterval = attackInterval
		_TimerService:SetTimerOnce(function()
			if not self._fieldActive then return end
			self._attackTimerId = _TimerService:SetTimerRepeat(self.TickAttack, capturedInterval)
		end, self._mobSummonIntro)
		log("GachaUI: field started, monsterCount=" .. tostring(monsterCount))
	end

	@ExecSpace("ClientOnly")
	method void SetArenaMode(boolean on)
		-- 평화로운 헤네시스 장식(Deco_)과 보스 아레나 소품(Arena_)을 맞바꾼다.
		-- 상단 덤불줄(Deco_Hedge*)은 지평선 역할이라 양쪽 모드에서 계속 켜둔다
		if not isvalid(self.fieldBg) then return end
		for _, child in pairs(self.fieldBg.Children) do
			local name = child.Name
			if string.sub(name, 1, 10) == "Deco_Hedge" then
				child.Enable = true
			elseif string.sub(name, 1, 5) == "Deco_" then
				child.Enable = not on
			elseif string.sub(name, 1, 6) == "Arena_" then
				child.Enable = on
			end
		end
		-- 켜진 장식이 바뀌었으니 진입금지 사각형도 다시 만든다
		self:BuildBlockedRects()
	end

	@ExecSpace("ClientOnly")
	method void SetBossAction(table bossData, string actionKey, boolean loop)
		-- 보스 스프라이트를 해당 액션 클립으로 바꾸고, 그 액션의 원본 비율에 맞춰 RectSize까지 같이 조정한다.
		-- (액션마다 원본 크기가 달라서 RectSize를 고정하면 클립이 바뀔 때마다 늘어나 보인다)
		if not isvalid(bossData.entity) then return end
		local action = bossData.species[actionKey]
		if action == nil then return end
		local sprite = bossData.entity.SpriteGUIRendererComponent
		sprite.ImageRUID = DataRef(action.ruid)
		if loop then
			sprite.AnimClipPlayType = SpriteAnimClipPlayType.Loop
		else
			sprite.AnimClipPlayType = SpriteAnimClipPlayType.Onetime
		end
		bossData.entity.UITransformComponent.RectSize = Vector2(action.w, action.h)
	end

	@ExecSpace("ClientOnly")
	method void SpawnDamageText(Vector2 pos, integer amount, boolean isPlayerHit)
		-- 피격 지점 위로 데미지 숫자가 떠올랐다 사라진다. 내가 때린 건 노란색, 내가 맞은 건 빨간색
		if not isvalid(self.damageTextTemplate) then return end
		local label = self.damageTextTemplate:Clone("DamageText_" .. tostring(_UtilLogic.ElapsedSeconds))
		label.Enable = true
		local jitter = (_UtilLogic:RandomDouble() * 2 - 1) * 34
		local startPos = Vector2(pos.x + jitter, pos.y + 30)
		local endPos = Vector2(startPos.x, startPos.y + 62)
		label.UITransformComponent.anchoredPosition = startPos
		local renderer = label.TextGUIRendererComponent
		if isvalid(renderer) then
			renderer.Text = tostring(amount)
			if isPlayerHit then
				renderer.FontColor = Color(1.0, 0.94, 0.42, 1.0)
			else
				renderer.FontColor = Color(1.0, 0.36, 0.32, 1.0)
			end
		end
		local captured = label
		_TweenLogic:PlayTween(startPos, endPos, 0.55, EaseType.QuadEaseOut, function(value)
			if isvalid(captured) then captured.UITransformComponent.anchoredPosition = value end
		end)
		_TweenLogic:ScaleTo(captured, Vector2(1.35, 1.35), 0.12, EaseType.QuadEaseOut)
		_TimerService:SetTimerOnce(function()
			if isvalid(captured) then _TweenLogic:ScaleTo(captured, Vector2(0.75, 0.75), 0.4, EaseType.QuadEaseIn) end
		end, 0.14)
		captured:Destroy(0.6)
	end

	@ExecSpace("ClientOnly")
	method void PlaySummonCircle(Vector2 pos, boolean isBoss)
		-- 소환 대상이 등장하는 자리에 마법진이 퍼진다(대상보다 뒤 레이어에 그려진다).
		-- 보스는 크고 푸른 룬 원, 일반 몬스터는 작고 노란 룬 원을 쓴다
		if not isvalid(self.summonEffectTemplate) then return end
		local fx = self.summonEffectTemplate:Clone("SummonFx_" .. tostring(_UtilLogic.ElapsedSeconds))
		fx.Enable = true
		local ut = fx.UITransformComponent
		ut.anchoredPosition = pos
		local sprite = fx.SpriteGUIRendererComponent
		if isBoss then
			sprite.ImageRUID = DataRef(self.SummonBossRUID)
			ut.RectSize = self.SummonBossSize
		else
			sprite.ImageRUID = DataRef(self.SummonMobRUID)
			ut.RectSize = self.SummonMobSize
		end
		sprite.AnimClipPlayType = SpriteAnimClipPlayType.Onetime
		fx:Destroy(1.3)
	end

	@ExecSpace("ClientOnly")
	method void PlayTeleportPuff(Vector2 pos, boolean isArrival)
		-- 텔레포트 연출. 떠나는 자리엔 마법진+빛기둥, 도착하는 자리엔 파란 폭발이 터진다
		if not isvalid(self.teleportEffectTemplate) then return end
		local fx = self.teleportEffectTemplate:Clone("TeleportFx_" .. tostring(_UtilLogic.ElapsedSeconds))
		fx.Enable = true
		local ut = fx.UITransformComponent
		ut.anchoredPosition = Vector2(pos.x, pos.y + self.TeleportEffectYOffset)
		local sprite = fx.SpriteGUIRendererComponent
		if isArrival then
			sprite.ImageRUID = DataRef(self.TeleportArriveRUID)
			ut.RectSize = self.TeleportArriveSize
		else
			sprite.ImageRUID = DataRef(self.TeleportDepartRUID)
			ut.RectSize = self.TeleportDepartSize
		end
		sprite.AnimClipPlayType = SpriteAnimClipPlayType.Onetime
		fx:Destroy(0.5)
	end

	@ExecSpace("ClientOnly")
	method void MoveAvatarTo(Vector2 dest, number duration)
		-- 마법사 텔레포트로 자리를 옮긴다 — 미끄러지지 않고 세로로 쭉 빨려들어갔다가 새 자리에서 튀어나온다.
		-- _avatarPosition을 즉시 목적지로 갱신해두면 뒤이어 오는 공격 연출/유물 회수 지점이
		-- 전부 새 자리를 기준으로 잡힌다
		local from = self._avatarPosition
		self._avatarPosition = dest
		local icon = self.characterIcon
		if not isvalid(icon) then return end

		self:PlayTeleportPuff(from, false)
		_SoundOptionLogic:PlaySfx(self.TeleportSoundRUID, 0.55)
		-- 전체 이동이 다음 공격 타이밍 안에 끝나야 해서 duration에 맞춰 줄인다
		local shrink = math.min(0.09, duration * 0.4)
		_TweenLogic:ScaleTo(icon, Vector2(0.12, 1.08), shrink, EaseType.QuadEaseIn)
		local capturedIcon = icon
		local capturedDest = dest
		_TimerService:SetTimerOnce(function()
			if not isvalid(capturedIcon) then return end
			capturedIcon.UITransformComponent.anchoredPosition = capturedDest
			self:PlayTeleportPuff(capturedDest, true)
			_TweenLogic:ScaleTo(capturedIcon, Vector2(1, 1), shrink * 1.4, EaseType.QuadEaseOut)
		end, shrink)
	end

	@ExecSpace("ClientOnly")
	method void PlayBossSfx(table bossData, string actionKey)
		-- 보스 액션에 대응하는 효과음. 해당 키가 없으면 조용히 넘어간다
		local sfx = bossData.species.sfx
		if sfx == nil then return end
		local ruid = sfx[actionKey]
		if ruid == nil or ruid == "" then return end
		_SoundOptionLogic:PlaySfx(ruid, 0.8)
	end

	@ExecSpace("ClientOnly")
	method void StartBossRaid(integer rewardCount, number duration)
		-- 스킬 뽑기 전용 연출. 일반 몬스터 대신 보스 한 마리가 등장하고, 정해진 시간 동안 아바타가
		-- 보스 주위를 돌며 두들긴다. 보상은 때리는 동안 조금씩 떨어지고 마지막 사망 연출에서 3개가 터진다.
		-- HP 개념은 없다 — 죽는 시점은 오로지 duration이 정한다
		self:ClearMonsters()
		self:ClearBoss()
		self._fieldActive = true
		self._raidActive = true
		self:SetPullButtonsEnabled(false)
		self:SetArenaMode(true)
		-- 팝업을 연 뒤 장비를 갈아끼웠을 수 있으니 레이드 직전에 한 번 더 맞춘다
		self:ApplyPlayerAvatar()

		local species = self._bossSpecies[_UtilLogic:RandomIntegerRange(1, #self._bossSpecies)]
		local clone = self.bossTemplate:Clone("GachaBoss_" .. tostring(_UtilLogic.ElapsedSeconds))
		clone.Enable = true
		clone.UITransformComponent.anchoredPosition = self._bossPosition
		local bossData = { entity = clone, species = species, dead = false }
		self._boss = bossData
		self:SetBossAction(bossData, "stand", true)

		-- 소환 연출: 마법진이 먼저 퍼지고 그 안에서 보스가 확대되며 나타난다
		clone.UITransformComponent.Scale = Vector3(0, 0, 1)
		self:PlaySummonCircle(self._bossPosition, true)
		_SoundOptionLogic:PlaySfx(self.SummonSoundRUID, 0.9)
		local capturedClone = clone
		_TimerService:SetTimerOnce(function()
			if not isvalid(capturedClone) then return end
			-- 살짝 크게 부풀었다가 제 크기로 돌아오는 등장감
			_TweenLogic:ScaleTo(capturedClone, Vector2(1.18, 1.18), 0.38, EaseType.QuadEaseOut)
		end, 0.42)
		_TimerService:SetTimerOnce(function()
			if not isvalid(capturedClone) then return end
			_TweenLogic:ScaleTo(capturedClone, Vector2(1, 1), 0.22, EaseType.QuadEaseIn)
		end, 0.80)

		-- 사망시 3개, 나머지는 때리는 동안. 1뽑처럼 총량이 3 이하면 전부 사망시에 몰아준다
		self._raidDropsOnDeath = math.min(3, rewardCount)
		self._raidDropsDuringLeft = rewardCount - self._raidDropsOnDeath
		self._raidAttackIndex = 0
		local plannedAttacks = math.max(1, math.floor(duration / self._raidPlayerInterval))
		if self._raidDropsDuringLeft > 0 then
			self._raidDropEvery = math.max(1, math.floor(plannedAttacks / self._raidDropsDuringLeft))
		else
			self._raidDropEvery = 9999
		end

		-- 소환 연출이 끝난 뒤에 전투를 시작한다 — 이렇게 해야 "패는 시간"이 duration만큼 온전히 보장된다
		local capturedDuration = duration
		self._raidIntroTimerId = _TimerService:SetTimerOnce(function()
			if not self._raidActive then return end
			if self._boss == nil or self._boss.dead then return end
			self._raidPlayerTimerId = _TimerService:SetTimerRepeat(self.TickRaidPlayerAttack, self._raidPlayerInterval)
			self._raidBossTimerId = _TimerService:SetTimerRepeat(self.TickRaidBossAttack, self._raidBossInterval)
			self._raidEndTimerId = _TimerService:SetTimerOnce(self.FinishBossRaid, capturedDuration)
		end, self._raidIntroDuration)
		log("GachaUI: boss raid started boss=" .. species.name .. " rewards=" .. tostring(rewardCount) .. " during=" .. tostring(self._raidDropsDuringLeft) .. " onDeath=" .. tostring(self._raidDropsOnDeath) .. " duration=" .. tostring(duration))
	end

	@ExecSpace("ClientOnly")
	method void TickRaidPlayerAttack()
		-- 아바타가 보스 주위 궤도의 다음 지점으로 옮겨간 뒤 때린다. 매번 각도를 바꿔서 계속 움직이게 한다
		if not self._raidActive then return end
		local bossData = self._boss
		if bossData == nil or bossData.dead or not isvalid(bossData.entity) then return end
		self._raidAttackIndex = self._raidAttackIndex + 1

		local angle = _UtilLogic:RandomDouble() * 2 * math.pi
		local dest = self:ClampToField(Vector2(self._bossPosition.x + math.cos(angle) * self._raidOrbitRadiusX, self._bossPosition.y + math.sin(angle) * self._raidOrbitRadiusY))
		if self:IsPositionBlocked(dest) then
			dest = self:ClampToField(Vector2(self._bossPosition.x - math.cos(angle) * self._raidOrbitRadiusX, self._bossPosition.y - math.sin(angle) * self._raidOrbitRadiusY))
		end
		self:MoveAvatarTo(dest, self._raidPlayerInterval * 0.45)

		local capturedIndex = self._raidAttackIndex
		-- 이동이 끝난 뒤에 때려야 자연스럽다
		_TimerService:SetTimerOnce(function()
			if not self._raidActive then return end
			local boss = self._boss
			if boss == nil or boss.dead or not isvalid(boss.entity) then return end
			local bossPos = boss.entity.UITransformComponent.anchoredPosition
			self:PlayAvatarAttack(bossPos)
			self:PlayMagicImpact(bossPos)
			self:SpawnDamageText(bossPos, _UtilLogic:RandomIntegerRange(180, 940), true)
			self:FlashBoss(boss)
			if self._raidDropsDuringLeft > 0 and capturedIndex % self._raidDropEvery == 0 then
				self._raidDropsDuringLeft = self._raidDropsDuringLeft - 1
				self:PlayRelicDrop(Vector2(bossPos.x + (_UtilLogic:RandomDouble() * 2 - 1) * 70, bossPos.y - 40))
			end
		end, self._raidPlayerInterval * 0.5)
	end

	@ExecSpace("ClientOnly")
	method void FlashBoss(table bossData)
		-- 맞을 때 hit1 클립을 잠깐 재생했다가 다시 서있기로 돌아온다
		if not isvalid(bossData.entity) then return end
		if bossData.busy then return end
		bossData.busy = true
		self:SetBossAction(bossData, "hit1", false)
		_TimerService:SetTimerOnce(function()
			if bossData.dead or not isvalid(bossData.entity) then return end
			bossData.busy = false
			self:SetBossAction(bossData, "stand", true)
		end, 0.28)
	end

	@ExecSpace("ClientOnly")
	method void TickRaidBossAttack()
		-- 보스도 아바타를 공격한다. 실제 체력은 없고 데미지 숫자만 뜨는 페이크 피격이다
		if not self._raidActive then return end
		local bossData = self._boss
		if bossData == nil or bossData.dead or not isvalid(bossData.entity) then return end

		local actionKey = "attack1"
		local roll = _UtilLogic:RandomDouble()
		if roll > 0.72 then
			actionKey = "skill1"
		elseif roll > 0.4 then
			actionKey = "attack2"
		end
		bossData.busy = true
		self:SetBossAction(bossData, actionKey, false)
		self:PlayBossSfx(bossData, actionKey)

		local capturedBoss = bossData
		_TimerService:SetTimerOnce(function()
			if not self._raidActive then return end
			if capturedBoss.dead or not isvalid(capturedBoss.entity) then return end
			-- 아바타가 맞는 연출 — 살짝 밀렸다 돌아오고 빨간 데미지 숫자가 뜬다
			self:PlayAvatarHit()
			self:SpawnDamageText(self._avatarPosition, _UtilLogic:RandomIntegerRange(40, 260), false)
		end, 0.35)

		_TimerService:SetTimerOnce(function()
			if capturedBoss.dead or not isvalid(capturedBoss.entity) then return end
			capturedBoss.busy = false
			self:SetBossAction(capturedBoss, "stand", true)
		end, 0.75)
	end

	@ExecSpace("ClientOnly")
	method void PlayAvatarHit()
		-- 보스에게 맞았을 때 아바타가 보스 반대쪽으로 살짝 밀렸다가 제자리로 돌아온다
		if not isvalid(self.characterIcon) then return end
		local home = self._avatarPosition
		local dx = home.x - self._bossPosition.x
		local dy = home.y - self._bossPosition.y
		local dist = math.sqrt(dx * dx + dy * dy)
		if dist < 0.001 then
			dx = 1
			dy = 0
			dist = 1
		end
		local knockPos = self:ClampToField(Vector2(home.x + dx / dist * 26, home.y + dy / dist * 26))
		local icon = self.characterIcon
		_TweenLogic:PlayTween(home, knockPos, 0.09, EaseType.QuadEaseOut, function(value)
			if isvalid(icon) then icon.UITransformComponent.anchoredPosition = value end
		end)
		_TimerService:SetTimerOnce(function()
			if not isvalid(icon) then return end
			_TweenLogic:PlayTween(knockPos, home, 0.18, EaseType.QuadEaseIn, function(value)
				if isvalid(icon) then icon.UITransformComponent.anchoredPosition = value end
			end)
		end, 0.09)
	end

	@ExecSpace("ClientOnly")
	method void FinishBossRaid()
		-- 정해진 시간이 다 되면 보스가 죽는다. 사망 연출과 함께 남은 보상을 한꺼번에 뿌린다
		if not self._raidActive then return end
		self._raidActive = false
		local bossData = self._boss
		-- 소환 연출 도중 스킵을 눌렀을 수 있으니 인트로 타이머도 같이 끈다
		if self._raidIntroTimerId then _TimerService:ClearTimer(self._raidIntroTimerId) end
		if self._raidPlayerTimerId then _TimerService:ClearTimer(self._raidPlayerTimerId) end
		if self._raidBossTimerId then _TimerService:ClearTimer(self._raidBossTimerId) end
		self._raidIntroTimerId = nil
		self._raidPlayerTimerId = nil
		self._raidBossTimerId = nil
		self._raidEndTimerId = nil

		if bossData == nil or bossData.dead or not isvalid(bossData.entity) then return end
		bossData.dead = true
		local bossPos = bossData.entity.UITransformComponent.anchoredPosition
		self:SetBossAction(bossData, "die1", false)
		self:PlayBossSfx(bossData, "die1")

		-- 못 뿌린 도중 보상이 남아 있으면(스킵 등) 사망 보상에 합쳐서 하나도 잃지 않게 한다
		local burst = self._raidDropsOnDeath + self._raidDropsDuringLeft
		self._raidDropsDuringLeft = 0
		self._raidDropsOnDeath = 0
		for i = 1, burst do
			local capturedAngle = (i - 1) / math.max(1, burst) * 2 * math.pi
			_TimerService:SetTimerOnce(function()
				self:PlayRelicDrop(Vector2(bossPos.x + math.cos(capturedAngle) * 95, bossPos.y + math.sin(capturedAngle) * 45 - 20))
			end, 0.12 * i)
		end

		_TweenLogic:ScaleTo(bossData.entity, Vector2(0, 0), 0.6, EaseType.QuadEaseIn)
		bossData.entity:Destroy(0.6)
		log("GachaUI: boss raid finished, death drops=" .. tostring(burst))
	end

	@ExecSpace("ClientOnly")
	method void ClearBoss()
		-- 레이드 상태와 보스 엔티티를 완전히 정리하고 아바타를 원래 자리로 되돌린다
		self._raidActive = false
		if self._raidIntroTimerId then _TimerService:ClearTimer(self._raidIntroTimerId) end
		if self._raidPlayerTimerId then _TimerService:ClearTimer(self._raidPlayerTimerId) end
		if self._raidBossTimerId then _TimerService:ClearTimer(self._raidBossTimerId) end
		if self._raidEndTimerId then _TimerService:ClearTimer(self._raidEndTimerId) end
		self._raidIntroTimerId = nil
		self._raidPlayerTimerId = nil
		self._raidBossTimerId = nil
		self._raidEndTimerId = nil
		if self._boss ~= nil and isvalid(self._boss.entity) then
			self._boss.entity:Destroy()
		end
		self._boss = nil
		self:MoveAvatarTo(self._avatarHomePosition, 0.2)
	end

	@ExecSpace("ClientOnly")
	method void BuildBlockedRects()
		-- 잔디의 Deco_* 자식(헤네시스 장식)을 훑어 몬스터 진입금지 사각형 목록을 만든다.
		-- .ui를 직접 읽으므로 Maker에서 장식을 옮기거나 추가해도 코드 수정 없이 반영된다
		self._blockedRects = {}
		if not isvalid(self.fieldBg) then
			log_warning("GachaUI: fieldBg is not bound, monsters will ignore decorations")
			return
		end
		-- 장식은 Bg의 자식이라 좌표가 Bg 로컬이다. Field 로컬로 올리려면 Bg 자신의 위치를 더한다
		local bgPos = self.fieldBg.UITransformComponent.anchoredPosition
		for _, child in pairs(self.fieldBg.Children) do
			-- 평상시 장식(Deco_)과 보스 아레나 소품(Arena_)은 서로 배타적으로 켜진다.
			-- 지금 꺼져 있는 쪽은 막을 필요가 없으므로 Enable을 함께 본다
			local isDeco = string.sub(child.Name, 1, 5) == "Deco_" or string.sub(child.Name, 1, 6) == "Arena_"
			if isDeco and child.Enable then
				local t = child.UITransformComponent
				local halfW = t.RectSize.x * 0.5 + self._blockedMargin
				local halfH = t.RectSize.y * 0.5 + self._blockedMargin
				local cx = bgPos.x + t.anchoredPosition.x
				local cy = bgPos.y + t.anchoredPosition.y
				table.insert(self._blockedRects, { minX = cx - halfW, maxX = cx + halfW, minY = cy - halfH, maxY = cy + halfH })
			end
		end
		log("GachaUI: blocked deco rects = " .. tostring(#self._blockedRects))
	end

	@ExecSpace("ClientOnly")
	method boolean IsPositionBlocked(Vector2 pos)
		-- 해당 좌표가 장식 오브젝트 위인지 판정한다
		for _, r in ipairs(self._blockedRects) do
			if pos.x >= r.minX and pos.x <= r.maxX and pos.y >= r.minY and pos.y <= r.maxY then
				return true
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method Vector2 ClampToField(Vector2 pos)
		-- 잔디 사각형 안으로 물린다 (중심이 원점이 아니므로 _fieldCenter 기준으로 계산)
		local x = math.max(self._fieldCenter.x - self._fieldHalfWidth, math.min(self._fieldCenter.x + self._fieldHalfWidth, pos.x))
		local y = math.max(self._fieldCenter.y - self._fieldHalfHeight, math.min(self._fieldCenter.y + self._fieldHalfHeight, pos.y))
		return Vector2(x, y)
	end

	@ExecSpace("ClientOnly")
	method boolean IsInsideField(Vector2 pos)
		-- 잔디 사각형 안에 있는지 여부
		if pos.x < self._fieldCenter.x - self._fieldHalfWidth then return false end
		if pos.x > self._fieldCenter.x + self._fieldHalfWidth then return false end
		if pos.y < self._fieldCenter.y - self._fieldHalfHeight then return false end
		if pos.y > self._fieldCenter.y + self._fieldHalfHeight then return false end
		return true
	end

	@ExecSpace("ClientOnly")
	method Vector2 RandomFieldPosition()
		-- 잔디 범위 안 무작위 좌표. 장식 위에 걸리면 다시 뽑는다
		for attempt = 1, 16 do
			local x = self._fieldCenter.x + (_UtilLogic:RandomDouble() * 2 - 1) * self._fieldHalfWidth
			local y = self._fieldCenter.y + (_UtilLogic:RandomDouble() * 2 - 1) * self._fieldHalfHeight
			local candidate = Vector2(x, y)
			if not self:IsPositionBlocked(candidate) then
				return candidate
			end
		end
		-- 16번 다 실패하면(장식이 과하게 깔린 경우) 중앙으로 — 뒤이어 AvoidAvatarPosition이 밀어낸다
		return self._fieldCenter
	end

	@ExecSpace("ClientOnly")
	method Vector2 AvoidAvatarPosition(Vector2 pos)
		-- pos가 아바타 회피 반경 안에 있으면 그 방향 그대로 반경 밖으로 밀어낸다
		local dx = pos.x - self._avatarPosition.x
		local dy = pos.y - self._avatarPosition.y
		local dist = math.sqrt(dx * dx + dy * dy)
		if dist >= self._avatarAvoidRadius then
			return pos
		end
		if dist < 0.001 then
			dx = 1
			dy = 0
			dist = 1
		end
		local scale = self._avatarAvoidRadius / dist
		-- 밀어낸 결과가 잔디 밖으로 튀어나가지 않도록 다시 물린다
		return self:ClampToField(Vector2(self._avatarPosition.x + dx * scale, self._avatarPosition.y + dy * scale))
	end

	@ExecSpace("ClientOnly")
	method number DistancePointToSegment(Vector2 point, Vector2 segA, Vector2 segB)
		-- point에서 segA-segB 선분까지의 최단 거리 (지나가는 경로가 아바타를 스치는지 확인하는 데 쓰인다)
		local abx = segB.x - segA.x
		local aby = segB.y - segA.y
		local lenSq = abx * abx + aby * aby
		local t = 0
		if lenSq > 0.0001 then
			t = ((point.x - segA.x) * abx + (point.y - segA.y) * aby) / lenSq
			t = math.max(0, math.min(1, t))
		end
		local closestX = segA.x + abx * t
		local closestY = segA.y + aby * t
		local dx = point.x - closestX
		local dy = point.y - closestY
		return math.sqrt(dx * dx + dy * dy)
	end

	@ExecSpace("ClientOnly")
	method Vector2 NextWanderPosition(Vector2 fromPos)
		-- 필드 전체를 크게 가로지르지 않고, 현재 위치에서 가까운 곳으로 짧게 이동해 자연스럽게 배회한다.
		-- 도착 지점뿐 아니라 이동 "경로"가 아바타를 스치지 않는 후보가 나올 때까지 다시 뽑는다
		-- (도착 지점만 밀어내면 지나가는 길에는 여전히 아바타를 관통할 수 있었음)
		local candidate = nil
		for attempt = 1, 12 do
			local dx = (_UtilLogic:RandomDouble() * 2 - 1) * self._wanderStepRadius
			local dy = (_UtilLogic:RandomDouble() * 2 - 1) * self._wanderStepRadius
			local test = self:ClampToField(Vector2(fromPos.x + dx, fromPos.y + dy))
			-- 도착 지점이 장식 위여도 안 되고, 지나가는 경로가 아바타를 스쳐도 안 된다
			if not self:IsPositionBlocked(test) and self:DistancePointToSegment(self._avatarPosition, fromPos, test) >= self._avatarAvoidRadius then
				candidate = test
				break
			end
		end
		if candidate == nil then
			-- 여러 번 시도해도 실패하면 아바타 반대 방향으로 강제 이동시킨다
			local dx = fromPos.x - self._avatarPosition.x
			local dy = fromPos.y - self._avatarPosition.y
			local dist = math.sqrt(dx * dx + dy * dy)
			if dist < 0.001 then
				dx = 1
				dy = 0
				dist = 1
			end
			candidate = self:ClampToField(Vector2(fromPos.x + dx / dist * self._wanderStepRadius, fromPos.y + dy / dist * self._wanderStepRadius))
			-- 밀어낸 자리마저 장식 위라면 제자리에 머문다 (장식에 파묻히는 것보다 낫다)
			if self:IsPositionBlocked(candidate) then
				candidate = fromPos
			end
		end
		return self:AvoidAvatarPosition(candidate)
	end

	@ExecSpace("ClientOnly")
	method Vector2 SpawnPosition(integer index, integer totalCount)
		-- 여러 마리가 한 번에 나올 때는(10뽑) 아바타를 삥 둘러싼 원형으로 등장시키고, 1마리면 무작위 위치로 등장한다.
		-- 원 위의 자리가 잔디 밖이거나 장식 위면 반경을 조금씩 줄여 안쪽 빈자리를 찾는다
		-- 여러 마리가 한 번에 나올 때는(10뽑) 아바타를 삥 둘러싼 원형으로 등장시키고, 1마리면 무작위 위치로 등장한다
		if totalCount <= 1 then
			return self:AvoidAvatarPosition(self:RandomFieldPosition())
		end
		local angle = (index - 1) / totalCount * 2 * math.pi
		local cosA = math.cos(angle)
		local sinA = math.sin(angle)
		for step = 0, 4 do
			local shrink = 1.0 - step * 0.12
			local candidate = Vector2(self._avatarPosition.x + cosA * self._spawnRingRadiusX * shrink, self._avatarPosition.y + sinA * self._spawnRingRadiusY * shrink)
			if self:IsInsideField(candidate) and not self:IsPositionBlocked(candidate) then
				return candidate
			end
		end
		return self:AvoidAvatarPosition(self:RandomFieldPosition())
	end

	@ExecSpace("ClientOnly")
	method void SetMonsterIdle(table monsterData)
		-- 가만히 서있는 상태(IDLE) -> 잠시 후 다시 걷기 시작
		if not isvalid(monsterData.entity) then return end
		local sprite = monsterData.entity.SpriteGUIRendererComponent
		sprite.ImageRUID = DataRef(monsterData.clips.stand)
		sprite.AnimClipPlayType = SpriteAnimClipPlayType.Loop
		monsterData.stateTimerId = _TimerService:SetTimerOnce(function()
			self:StartMonsterMove(monsterData)
		end, 0.7 + _UtilLogic:RandomDouble() * 0.6)
	end

	@ExecSpace("ClientOnly")
	method void StartMonsterMove(table monsterData)
		-- 새 목표 지점으로 걷는 애니메이션을 재생하며 이동, 도착하면 다시 IDLE로
		-- (TweenLogic:MoveTo는 UI anchoredPosition을 제대로 못 다뤄서 화면 밖으로 튀는 문제가 있었음 -> anchoredPosition을 직접 갱신하는 PlayTween으로 대체)
		if not isvalid(monsterData.entity) then return end
		local ut = monsterData.entity.UITransformComponent
		local fromPos = ut.anchoredPosition
		local toPos = self:NextWanderPosition(fromPos)
		local sprite = monsterData.entity.SpriteGUIRendererComponent
		-- 스프라이트는 기본적으로 왼쪽을 보고 있으므로 오른쪽으로 갈 때만 뒤집는다
		if toPos.x - fromPos.x > 0 then
			sprite.FlipX = true
		elseif toPos.x - fromPos.x < 0 then
			sprite.FlipX = false
		end
		sprite.ImageRUID = DataRef(monsterData.clips.move)
		sprite.AnimClipPlayType = SpriteAnimClipPlayType.Loop
		
		-- 짧은 거리를 천천히 걷도록(필드 안에서처럼 자연스럽게) 이동 거리에 비례해 소요 시간을 정한다
		local dx = toPos.x - fromPos.x
		local dy = toPos.y - fromPos.y
		local distance = math.sqrt(dx * dx + dy * dy)
		local duration = math.max(0.8, distance / 60)
		local capturedEntity = monsterData.entity
		_TweenLogic:PlayTween(fromPos, toPos, duration, EaseType.Linear, function(value)
			if isvalid(capturedEntity) then
				capturedEntity.UITransformComponent.anchoredPosition = value
			end
		end)
		
		monsterData.stateTimerId = _TimerService:SetTimerOnce(function()
			self:SetMonsterIdle(monsterData)
		end, duration)
	end

	@ExecSpace("ClientOnly")
	method void TickAttack()
		-- 살아있는 몬스터 중 하나를 무작위로 골라, 아바타가 마법을 쏴서 공격한다
		-- (죽어서 Destroy 대기 중인 몬스터는 entity가 아직 valid해도 dead 플래그로 걸러서 중복 처치/중복 드롭을 막는다)
		local alive = {}
		for _, m in ipairs(self._monsters) do
			if isvalid(m.entity) and not m.dead then table.insert(alive, m) end
		end
		if #alive == 0 then
			self:StopField()
			return
		end
		
		local target = alive[_UtilLogic:RandomIntegerRange(1, #alive)]
		target.hp = target.hp - 1
		self:PlayMagicEffect(target)
	end

	@ExecSpace("ClientOnly")
	method void PlayAvatarAttack(Vector2 targetPos)
		-- 아바타가 적 쪽으로 살짝 다가섰다가 되돌아오면서 무기 휘두르기 모션(swingO1)을 재생한다
		if not isvalid(self.characterIcon) then return end
		local ut = self.characterIcon.UITransformComponent
		local avatarRenderer = self.characterIcon.AvatarGUIRendererComponent
		
		local dx = targetPos.x - self._avatarPosition.x
		local dy = targetPos.y - self._avatarPosition.y
		local dist = math.sqrt(dx * dx + dy * dy)
		if isvalid(avatarRenderer) then
			if dx > 0 then avatarRenderer.FlipX = true
			elseif dx < 0 then avatarRenderer.FlipX = false end
		end
		
		local lungePos = self._avatarPosition
		if dist > 0.001 then
			local stepDist = math.min(45, dist * 0.3)
			lungePos = Vector2(self._avatarPosition.x + dx / dist * stepDist, self._avatarPosition.y + dy / dist * stepDist)
		end
		
		local capturedIcon = self.characterIcon
		_TweenLogic:PlayTween(self._avatarPosition, lungePos, 0.12, EaseType.QuadEaseOut, function(value)
			if isvalid(capturedIcon) then capturedIcon.UITransformComponent.anchoredPosition = value end
		end)
		_TimerService:SetTimerOnce(function()
			if isvalid(capturedIcon) then
				_TweenLogic:PlayTween(lungePos, self._avatarPosition, 0.2, EaseType.QuadEaseIn, function(value)
					if isvalid(capturedIcon) then capturedIcon.UITransformComponent.anchoredPosition = value end
				end)
			end
		end, 0.12)
		
		if isvalid(avatarRenderer) then
			local body = avatarRenderer:GetBodyEntity()
			if isvalid(body) then
				local swingEvent = ActionStateChangedEvent()
				swingEvent.CoreActionName = "swingO1"
				swingEvent.PartsActionName = "swingO1"
				swingEvent.PlayRate = 1.4
				swingEvent.PlayType = SpriteAnimClipPlayType.Onetime
				body:SendEvent(swingEvent)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void PlayMagicEffect(table monsterData)
		-- 아바타가 적 쪽으로 다가서며 무기를 휘두르고, 마법 구슬이 대상까지 날아간 뒤 명중 처리를 실행한다
		if not isvalid(monsterData.entity) then return end
		local targetPos = monsterData.entity.UITransformComponent.anchoredPosition
		self:PlayAvatarAttack(targetPos)
		
		local bolt = self.magicEffectTemplate:Clone("MagicBolt_" .. tostring(_UtilLogic.ElapsedSeconds))
		bolt.Enable = true
		bolt.UITransformComponent.anchoredPosition = self._avatarPosition
		
		local duration = 0.2
		local capturedBolt = bolt
		_TweenLogic:PlayTween(self._avatarPosition, targetPos, duration, EaseType.QuadEaseIn, function(value)
			if isvalid(capturedBolt) then
				capturedBolt.UITransformComponent.anchoredPosition = value
			end
		end)
		
		_TimerService:SetTimerOnce(function()
			if isvalid(capturedBolt) then capturedBolt:Destroy() end
			-- 이 화살이 날아가는 동안 다른 공격이 먼저 같은 몬스터를 처치했을 수 있으니 dead도 다시 확인한다
			if isvalid(monsterData.entity) and not monsterData.dead then
				self:PlayMagicImpact(monsterData.entity.UITransformComponent.anchoredPosition)
				if monsterData.hp <= 0 then
					self:KillMonster(monsterData)
				else
					self:FlashMonster(monsterData)
				end
			end
		end, duration)
	end

	@ExecSpace("ClientOnly")
	method void PlayMagicImpact(Vector2 position)
		-- 매번 스킬 후보군(에너지 폭풍/파이어 오라/와일드 발칸) 중 하나를 무작위로 골라 재생한다
		local impact = self.magicImpactTemplate:Clone("MagicImpact_" .. tostring(_UtilLogic.ElapsedSeconds))
		impact.Enable = true
		impact.UITransformComponent.anchoredPosition = position
		local sprite = impact.SpriteGUIRendererComponent
		local pickedRuid = self._skillImpactRuids[_UtilLogic:RandomIntegerRange(1, #self._skillImpactRuids)]
		sprite.ImageRUID = DataRef(pickedRuid)
		sprite.AnimClipPlayType = SpriteAnimClipPlayType.Onetime
		impact:Destroy(0.5)
	end

	@ExecSpace("ClientOnly")
	method void FlashMonster(table monsterData)
		-- 피격 애니메이션을 한 번 재생한 뒤 IDLE로 되돌아가고, 거기서 다시 배회 사이클이 이어진다
		if monsterData.stateTimerId then _TimerService:ClearTimer(monsterData.stateTimerId) end
		local sprite = monsterData.entity.SpriteGUIRendererComponent
		sprite.ImageRUID = DataRef(monsterData.clips.hit)
		sprite.AnimClipPlayType = SpriteAnimClipPlayType.Onetime
		monsterData.stateTimerId = _TimerService:SetTimerOnce(function()
			self:SetMonsterIdle(monsterData)
		end, 0.3)
	end

	@ExecSpace("ClientOnly")
	method void KillMonster(table monsterData)
		-- TODO: 유물 등급/레벨업 시스템은 나중에 붙인다 (지금은 종류당 1개 획득 카운트만 RelicInventory에 기록)
		-- dead를 가장 먼저 세워서, 아직 날아오고 있는 다른 공격이 이 몬스터를 또 처치 처리하지 못하게 막는다
		if monsterData.dead then return end
		monsterData.dead = true
		if monsterData.stateTimerId then _TimerService:ClearTimer(monsterData.stateTimerId) end
		local sprite = monsterData.entity.SpriteGUIRendererComponent
		sprite.ImageRUID = DataRef(monsterData.clips.die)
		sprite.AnimClipPlayType = SpriteAnimClipPlayType.Onetime
		self:PlayRelicDrop(monsterData.entity.UITransformComponent.anchoredPosition)
		_TweenLogic:ScaleTo(monsterData.entity, Vector2(0, 0), 0.45, EaseType.QuadEaseIn)
		monsterData.entity:Destroy(0.45)
	end

	@ExecSpace("ClientOnly")
	method void PlayRelicDrop(Vector2 position)
		-- 메이플스토리 실제 아이템 드롭처럼 회전 없이 위로 톡 튀어올랐다가 포물선으로 떨어져 착지한다.
		-- 착지 후 1초 동안 가만히 있다가 아바타 쪽으로 빨려들어가며 사라진다(그 도착 시점에 획득 연출이 재생된다)
		local popPos = Vector2(position.x, position.y + 35)
		local popDuration = 0.15
		local fallDuration = 0.25
		
		local relic = self.relicDropTemplate:Clone("RelicDrop_" .. tostring(_UtilLogic.ElapsedSeconds))
		relic.Enable = true
		relic.UITransformComponent.anchoredPosition = position
		local sprite = relic.SpriteGUIRendererComponent
		-- pickedIndex는 0-based 보상 인덱스 — 유물탭(RelicSlot_0.."17") / 스킬탭(SkillSlot_0..59) 둘 다
		-- 0-based를 쓰므로 그대로 넘긴다. 어떤 종류인지는 RollRewardIndex/GetRewardIconRuid가 판단한다
		local pickedIndex = self:RollRewardIndex()
		sprite.ImageRUID = DataRef(self:GetRewardIconRuid(pickedIndex))
		
		local capturedRelic = relic
		-- 톡 튀어오름
		_TweenLogic:PlayTween(position, popPos, popDuration, EaseType.QuadEaseOut, function(value)
			if isvalid(capturedRelic) then
				capturedRelic.UITransformComponent.anchoredPosition = value
			end
		end)
		-- 중력에 끌리듯 떨어져 착지
		_TimerService:SetTimerOnce(function()
			if not isvalid(capturedRelic) then return end
			_TweenLogic:PlayTween(popPos, position, fallDuration, EaseType.QuadEaseIn, function(value)
				if isvalid(capturedRelic) then
					capturedRelic.UITransformComponent.anchoredPosition = value
				end
			end)
		end, popDuration)
		
		local landDuration = popDuration + fallDuration
		-- 착지 후 1초간 그대로 머물렀다가 획득 단계로 넘어간다
		_TimerService:SetTimerOnce(function()
			if not isvalid(capturedRelic) then return end
			local flyDuration = 0.35
			_TweenLogic:ScaleTo(capturedRelic, Vector2(0.5, 0.5), flyDuration, EaseType.QuadEaseIn)
			_TweenLogic:PlayTween(position, self._avatarPosition, flyDuration, EaseType.QuadEaseIn, function(value)
				if isvalid(capturedRelic) then
					capturedRelic.UITransformComponent.anchoredPosition = value
				end
			end)
			capturedRelic:Destroy(flyDuration)
			-- 유물이 아바타에게 도착하는 시점에 맞춰 획득 연출을 재생하고, 서버에 실제 획득을 기록해 유물 탭에 반영한다
			_TimerService:SetTimerOnce(function()
				self:PlayAcquireEffect()
				self:GrantReward(pickedIndex)
			end, flyDuration)
		end, landDuration + 1.0)
	end

	@ExecSpace("ClientOnly")
	method void PlayAcquireEffect()
		-- 유물이 아바타에게 도착할 때마다 재생되는 획득 연출. 공격 마법 구슬과 같은 이펙트를 쓰면
		-- 마치 유물이 하나 더 나온 것처럼 헷갈려서, 별도 이펙트 없이 아바타 스케일 펀치만 재생한다
		if not isvalid(self.characterIcon) then return end
		local capturedIcon = self.characterIcon
		_TweenLogic:ScaleTo(capturedIcon, Vector2(1.25, 1.25), 0.15, EaseType.QuadEaseOut)
		_TimerService:SetTimerOnce(function()
			if isvalid(capturedIcon) then
				_TweenLogic:ScaleTo(capturedIcon, Vector2(1, 1), 0.25, EaseType.QuadEaseIn)
			end
		end, 0.15)
	end

	@ExecSpace("ClientOnly")
	method void RegisterPullResult(integer slotIndex)
		-- 유물이 아바타에게 도착할 때마다(= PlayAcquireEffect가 재생되는 시점마다) 호출되어 이번 뽑기 결과에 누적한다.
		-- 이번 뽑기에서 기대한 개수(_pullTotal)만큼 전부 모이면 그 시점에 결과창을 띄운다
		if self._pullTotal <= 0 then return end
		if self._pullResultCounts[slotIndex] == nil then
			self._pullResultCounts[slotIndex] = 0
			table.insert(self._pullResultOrder, slotIndex)
		end
		self._pullResultCounts[slotIndex] = self._pullResultCounts[slotIndex] + 1
		self._pullDropsDone = self._pullDropsDone + 1
		if self._pullDropsDone >= self._pullTotal then
			self:ShowPullResults()
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowPullResults()
		-- 이 시점이 진짜 "이번 뽑기가 완전히 끝난" 시점이다(마지막 유물까지 전부 도착) — 여기서 필드 활성 상태를
		-- 풀어주고 뽑기 버튼을 다시 켠다. StopField()는 전투(공격 타이머)만 멈출 뿐 아직 날아오는 중인 유물
		-- 드롭 연출까지는 기다려주지 않으므로, 여기서 풀지 않으면 이전 결과창이 채 안 덮였는데 다음 뽑기를
		-- 시작할 수 있어 Bg_cover 애니메이션끼리 충돌한다
		self._fieldActive = false
		-- 보스 레이드였다면 여기서 아레나를 걷고 평상시 잔디 장식으로 되돌린다(아바타도 원래 자리로)
		self:ClearBoss()
		self:SetArenaMode(false)
		self:SetPullButtonsEnabled(true)
		-- 뽑기가 완전히 끝났으니 닫기 버튼을 다시 켜고, 더 이상 스킵할 게 없으니 스킵 버튼은 끈다
		self.btnClose.Entity.Enable = true
		self.btnSkip.Entity.Enable = false
		-- ⚠ 탭 버튼은 여기서 켜면 안 된다 — 결과 아이콘은 아래 타이머로 0.32초 뒤에야 그려지고,
		-- 그 사이 탭을 바꾸면 결과가 반대 종류 아이콘으로 그려진다. FinishPullPresentation()에서 켠다
		-- Bg_cover가 열 때와 반대로(위/투명 -> 제자리/불투명) 다시 덮이고, 다 덮인 뒤 그 위에 획득한 유물들을 보여준다
		if not isvalid(self.bgCover) or self._coverBasePos == nil then
			-- 커버가 없어 결과 연출을 못 하는 예외 경로에서도 탭은 반드시 풀어준다(영구 잠김 방지)
			self:FinishPullPresentation()
			return
		end
		local basePos = self._coverBasePos
		local baseColor = self._coverBaseColor
		local liftPos = Vector2(basePos.x, basePos.y + self._coverLiftDistance)
		self.bgCover.Enable = true
		self.bgCover.UITransformComponent.anchoredPosition = liftPos
		self.bgCover.SpriteGUIRendererComponent.Color = Color(baseColor.r, baseColor.g, baseColor.b, 0)
		local capturedCover = self.bgCover
		local duration = self._coverAnimDuration
		
		_TweenLogic:PlayTween(liftPos, basePos, duration, EaseType.QuadEaseIn, function(value)
			if isvalid(capturedCover) then capturedCover.UITransformComponent.anchoredPosition = value end
		end)
		_TweenLogic:PlayTween(0.0, baseColor.a, duration, EaseType.QuadEaseIn, function(value)
			if isvalid(capturedCover) then
				capturedCover.SpriteGUIRendererComponent.Color = Color(baseColor.r, baseColor.g, baseColor.b, value)
			end
		end)
		_TimerService:SetTimerOnce(function()
			self:DisplayResultIcons()
		end, duration)
		log("GachaUI: pull finished, total=" .. tostring(self._pullTotal) .. ", uniqueRelics=" .. tostring(#self._pullResultOrder))
	end

	@ExecSpace("ClientOnly")
	method void FinishPullPresentation()
		-- "뽑기가 온전히 끝난" 유일한 지점. 여기서만 탭 잠금을 푼다
		self._pullInProgress = false
		self.btnTabSkill.Enable = true
		self.btnTabRelic.Enable = true
	end

	@ExecSpace("ClientOnly")
	method void DisplayResultIcons()
		-- Bg_cover 위에 이번에 획득한 유물 종류마다 아이콘 + "xN" 개수를 가로로 나열해 보여준다
		if not isvalid(self.resultSlotTemplate) then
			self:FinishPullPresentation()
			return
		end
		local uniqueCount = #self._pullResultOrder
		if uniqueCount == 0 then
			self:FinishPullPresentation()
			return
		end
		
		-- "획득한 유물!" 타이틀은 뽑기가 실제로 완료되어 아이콘이 나타나는 이 순간에만 같이 보여준다
		if isvalid(self.resultTitle) then self.resultTitle.Enable = true end
		
		-- 한 줄에 최대 maxPerRow개까지만 놓고, 그보다 많으면(예: 유물 종류가 늘어나거나 더 큰 뽑기가 생기면)
		-- 다음 줄로 넘긴다 — 계속 줄여서 한 줄에 욱여넣지 않는다. 각 줄은 그 줄의 개수 기준으로 가운데 정렬하고,
		-- 줄 전체 블록은 세로로도 가운데 정렬한다
		local maxPerRow = 6
		local cellWidth = 128
		local cellHeight = 128
		local rowCount = math.ceil(uniqueCount / maxPerRow)
		local topY = (rowCount - 1) * cellHeight / 2
		
		for i, slotIndex in ipairs(self._pullResultOrder) do
			local rowIndex = math.floor((i - 1) / maxPerRow)
			local colIndex = (i - 1) % maxPerRow
			local itemsInRow = math.min(maxPerRow, uniqueCount - rowIndex * maxPerRow)
			local rowWidth = itemsInRow * cellWidth
			local rowStartX = -rowWidth / 2 + cellWidth / 2
		
			local clone = self.resultSlotTemplate:Clone("ResultIcon_" .. tostring(i) .. "_" .. tostring(_UtilLogic.ElapsedSeconds))
			clone.Enable = true
			local x = rowStartX + colIndex * cellWidth
			local y = topY - rowIndex * cellHeight - 10
			clone.UITransformComponent.anchoredPosition = Vector2(x, y)
		
			local icon = clone:GetChildByName("Icon", false)
			if isvalid(icon) then
				icon.SpriteGUIRendererComponent.ImageRUID = DataRef(self:GetRewardIconRuid(slotIndex))
			end
			local countText = clone:GetChildByName("CountText", false)
			if isvalid(countText) then
				countText.TextComponent.Text = "x" .. tostring(self._pullResultCounts[slotIndex])
			end
		
			-- 톡 하고 튀어나오는 팝 연출로 하나씩 나타난다
			clone.UITransformComponent.Scale = Vector3(0, 0, 1)
			local capturedClone = clone
			_TimerService:SetTimerOnce(function()
				if isvalid(capturedClone) then
					_TweenLogic:ScaleTo(capturedClone, Vector2(1, 1), 0.2, EaseType.BackEaseOut)
				end
			end, (i - 1) * 0.05)
		
			table.insert(self._resultIcons, clone)
		end

		-- 마지막 아이콘까지 팝 연출이 끝난 뒤에 탭 잠금을 푼다
		_TimerService:SetTimerOnce(function()
			self:FinishPullPresentation()
		end, (uniqueCount - 1) * 0.05 + 0.25)
	end

	@ExecSpace("ClientOnly")
	method void ClearResultIcons()
		if self._resultIcons == nil then self._resultIcons = {} end
		for _, icon in ipairs(self._resultIcons) do
			if isvalid(icon) then icon:Destroy() end
		end
		self._resultIcons = {}
		-- 결과 아이콘을 치울 때는 항상 타이틀도 같이 숨긴다 (다음 뽑기가 끝나기 전까지는 다시 뜨면 안 된다)
		if isvalid(self.resultTitle) then self.resultTitle.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void StopField()
		-- 전투(공격 타이머)만 멈춘다. _fieldActive 해제와 뽑기 버튼 재활성화는 유물 드롭 연출까지 전부 끝나는
		-- ShowPullResults()에서 처리한다 — 그래야 결과 수집이 덜 끝난 상태로 다음 뽑기가 시작되지 않는다
		if self._attackTimerId then _TimerService:ClearTimer(self._attackTimerId) end
		self._attackTimerId = nil
		log("GachaUI: field cleared, all monsters defeated")
	end

	@ExecSpace("ClientOnly")
	method void ClearMonsters()
		self:StopField()
		for _, m in ipairs(self._monsters) do
			if m.stateTimerId then _TimerService:ClearTimer(m.stateTimerId) end
			if isvalid(m.entity) then m.entity:Destroy() end
		end
		self._monsters = {}
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		self:ClearMonsters()
		self:ClearBoss()
		if self._openHandler then self.btnOpen.Entity:DisconnectEvent(ButtonClickEvent, self._openHandler) end
		if self._closeHandler then self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self._closeHandler) end
		if self._pull1Handler then self.btnPull1.Entity:DisconnectEvent(ButtonClickEvent, self._pull1Handler) end
		if self._pull10Handler then self.btnPull10.Entity:DisconnectEvent(ButtonClickEvent, self._pull10Handler) end
		if self._openStateHandler then self.btnOpen.Entity:DisconnectEvent(ButtonStateChangeEvent, self._openStateHandler) end
		if self._closeStateHandler then self.btnClose.Entity:DisconnectEvent(ButtonStateChangeEvent, self._closeStateHandler) end
		if self._pull1StateHandler then self.btnPull1.Entity:DisconnectEvent(ButtonStateChangeEvent, self._pull1StateHandler) end
		if self._pull10StateHandler then self.btnPull10.Entity:DisconnectEvent(ButtonStateChangeEvent, self._pull10StateHandler) end
		if self._skipHandler then self.btnSkip.Entity:DisconnectEvent(ButtonClickEvent, self._skipHandler) end
		if self._skipStateHandler then self.btnSkip.Entity:DisconnectEvent(ButtonStateChangeEvent, self._skipStateHandler) end
		if self._tabSkillHandler then self.btnTabSkill.Entity:DisconnectEvent(ButtonClickEvent, self._tabSkillHandler) end
		if self._tabRelicHandler then self.btnTabRelic.Entity:DisconnectEvent(ButtonClickEvent, self._tabRelicHandler) end
		if self._tabSkillStateHandler then self.btnTabSkill.Entity:DisconnectEvent(ButtonStateChangeEvent, self._tabSkillStateHandler) end
		if self._tabRelicStateHandler then self.btnTabRelic.Entity:DisconnectEvent(ButtonStateChangeEvent, self._tabRelicStateHandler) end
	end

end