@Logic
script Ep2Map1SkillEasterEggLogic extends Logic

	@Sync
	property boolean Triggered = false

	-- 에피소드2 map1 이스터에그: object-3428_19(Ep2Map1SkillEasterEggTrigger가 붙은 터치 오브젝트)를
	-- 3번 터치하면 엘리트 처치/보물상자와 완전히 동일한 방식으로 진짜 인게임 스킬 강화 1회를 지급한다
	-- (유저 정정: 인벤토리로 날아가는 잡템 연출이 아니라 CardManager.BuildActiveUpgradePool +
	-- GrantCardUpgradesFromPool을 그대로 재사용 — 카드가 실제 슬롯으로 날아가서 레벨업됨).
	-- Zone21AlienEasterEggLogic과 동일한 런 정책: "다시하기"/"새로 시작"에서는 GameManager.RestartGame()이
	-- ResetForNewRun()을 호출해 다시 도전할 수 있게 초기화되지만, "이어하기"(ContinueGame)는 이 플래그를
	-- 건드리지 않으므로 같은 런 안에서는(이미 발동했다면) 다시 뜨지 않는다.
	property integer _touchCount = 0

	property integer RequiredTouchCount = 3

	-- Ep2Map1SkillEasterEggTrigger.RequestTouch()가 호출 — 터치된 오브젝트 엔티티를 그대로 받는다
	-- (Logic에 UUID를 property로 박아두면 맵 미로드 시점에 nil이 되는 문제 회피, Map21RelicEasterEgg와 동일 이유)
	@ExecSpace("ServerOnly")
	method void OnObjectTouched(Entity touchedObject)
		if self.Triggered then return end
		self._touchCount = self._touchCount + 1
		log("Ep2Map1SkillEasterEgg: touch " .. self._touchCount .. "/" .. self.RequiredTouchCount)
		if self._touchCount < self.RequiredTouchCount then return end
		
		local pool = _CardManager:BuildActiveUpgradePool()
		if #pool == 0 then
			-- 강화할 카드가 하나도 없는(전부 만렙이거나 아직 아무것도 해금 안 한) 상태 — 트리거는
			-- 소모하지 않고 카운트만 되돌려서 나중에 다시 3번 눌러 재도전할 수 있게 한다
			self._touchCount = 0
			log("Ep2Map1SkillEasterEgg: nothing to upgrade yet, retry later")
			return
		end
		
		self.Triggered = true
		local worldPos = touchedObject.TransformComponent.WorldPosition
		_CardManager:GrantCardUpgradesFromPool(pool, worldPos, 0, worldPos.y, 1.0, 1, 0)
		log("Ep2Map1SkillEasterEgg: triggered, granted 1 card upgrade from active pool")
	end

	-- GameManager.RestartGame()이 호출 — 새 런에서는 오브젝트를 다시 세 번 눌러 재도전할 수 있다
	@ExecSpace("ServerOnly")
	method void ResetForNewRun()
		self.Triggered = false
		self._touchCount = 0
	end

end