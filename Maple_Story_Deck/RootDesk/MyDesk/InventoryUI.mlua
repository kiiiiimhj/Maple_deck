@Logic
script InventoryUI extends Logic

	-- UI 바인딩 (클라이언트 전용)
	property Entity inventoryGroup = "6e428b67-5349-4903-8189-29b867f505d9"

	property ButtonComponent btnClose = "d61aef80-bbd3-46f6-8920-97286e648070"

	property ButtonComponent btnInventory = "22519eca-9947-4040-bbd4-45afb7d9f95a"

	-- 창을 드래그로 옮기는 데 쓰는 바인딩 — 타이틀바를 잡고 끌면 Panel 전체가 같이 움직인다
	property Entity panel = "dd851708-25f4-42d7-96b9-1d7bf85085b9"

	property Entity titleBar = "72f54432-68f5-454d-9764-95086df18cbb"

	-- 슬롯 스크롤 바인딩 — 유물/상점 패널과 동일한 구조(터치드래그 + 커스텀 슬라이더)
	property Entity slotList = "cbdf58ee-5ede-42e9-abf6-2be578c29043"

	property Entity scrollTouchArea = "a78e53db-e4bb-4a8e-939c-e087d45fa098"

	property SliderComponent scrollBar = "2aafc23e-d8c1-4829-a477-a23847b1d305"

	property integer slotCount = 75

	-- 콘텐츠 높이(15줄*96 + 14간격*14) - 뷰포트 높이(460) = 실제로 드래그 가능한 스크롤 폭(px)
	property number scrollableRangePx = 1176

	property any _openHandler = nil

	property any _closeHandler = nil

	property any _dragHandler = nil

	property any _scrollDragHandler = nil

	property any _scrollBarHandler = nil

	-- SyncScrollBar()가 코드로 scrollBar.Value를 갱신할 때 true로 세워서, 그 갱신이 다시
	-- SliderValueChangedEvent로 되돌아와 리스트를 또 움직이는 무한 루프를 막는다
	property boolean _syncingScrollBar = false

	-- 슬롯 아이콘별 .ui 원래 PreserveSprite 값(ApplyIconAspect가 처음 만질 때 기록) — keepAspect 잡템이 쓰던
	-- 슬롯을 다른 잡템이 재사용할 때 원래 설정으로 되돌리기 위해
	property any _iconPreserveDefaults = nil

	-- 슬롯 아이콘별 .ui 원래 RectSize — keepAspect 잡템은 이 크기 안에 원본 비율로 줄여 넣고,
	-- 일반 잡템이 그 슬롯을 재사용할 때 원래 크기로 되돌린다
	property any _iconSizeDefaults = nil

	property string _shadowVoucherIcon = "b4ef5ecaa6584954831a86bd844e287e"

	-- itemId별 마지막으로 확인한 개수 — 실시간 갱신 시 "늘어났는지"를 판단해 획득 연출을 재생하는 데 쓴다
	property any _lastKnownCounts = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self.inventoryGroup.Enable = false
		self._openHandler = self.btnInventory.Entity:ConnectEvent(ButtonClickEvent, self.Open)
		self._closeHandler = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, self.Close)
		self._dragHandler = self.titleBar:ConnectEvent(UITouchDragEvent, self.OnTitleBarDrag)
		-- GroupOrder만으로는 다른 UIGroup(DefaultGroup 등)보다 항상 앞에 그려진다는 보장이 없어서,
		-- 실제 렌더 순서를 결정하는 형제 인덱스를 확정적으로 맨 뒤(=맨 앞)로 올려둔다
		_UILogic:SetSiblingIndex(self.inventoryGroup.UITransformComponent, 1000000)
		
		self._scrollDragHandler = self.scrollTouchArea:ConnectEvent(UITouchDragEvent, self.OnScrollDrag)
		self._scrollBarHandler = self.scrollBar.Entity:ConnectEvent(SliderValueChangedEvent, self.OnScrollBarChanged)
		-- 슬롯 리스트/스크롤바가 항상 맨 위(첫 줄)부터 시작하도록 확정적으로 리셋한다
		-- (세로축은 0=맨 위, 1=맨 아래 — 가로 스크롤의 0=시작점과 같은 의미)
		self.slotList.ScrollLayoutGroupComponent:SetScrollNormalizedPosition(UITransformAxis.Vertical, 0)
		self:SyncScrollBar(0)
	end

	@ExecSpace("ClientOnly")
	method void OnTitleBarDrag(UITouchDragEvent event)
		-- 타이틀바를 끌면 그만큼 인벤토리 창(Panel) 전체를 같이 옮긴다
		local tc = self.panel.UITransformComponent
		local pos = tc.anchoredPosition
		tc.anchoredPosition = Vector2(pos.x + event.TouchDelta.x, pos.y + event.TouchDelta.y)
	end

	@ExecSpace("ClientOnly")
	method void OnScrollDrag(UITouchDragEvent event)
		-- 세로축은 0=맨 위, 1=맨 아래. 위로 끌면(TouchDelta.y > 0) 아래쪽 슬롯이 보이도록
		-- (정규화 값 증가) 스크롤한다
		local layout = self.slotList.ScrollLayoutGroupComponent
		local current = layout:GetScrollNormalizedPosition(UITransformAxis.Vertical)
		local delta = event.TouchDelta.y / self.scrollableRangePx
		local newValue = math.max(0, math.min(1, current + delta))
		layout:SetScrollNormalizedPosition(UITransformAxis.Vertical, newValue)
		self:SyncScrollBar(newValue)
	end

	@ExecSpace("ClientOnly")
	method void SyncScrollBar(number normalizedValue)
		-- 리스트 쪽 스크롤(드래그)이 바뀔 때 오른쪽 스크롤바 핸들 위치를 따라오게 한다
		self._syncingScrollBar = true
		self.scrollBar.Value = normalizedValue
		self._syncingScrollBar = false
	end

	@ExecSpace("ClientOnly")
	method void OnScrollBarChanged(SliderValueChangedEvent event)
		-- 방금 SyncScrollBar()가 코드로 쓴 값이 되돌아온 것이면 무시 — 사용자가 직접 핸들을 끈 경우만 처리
		if self._syncingScrollBar then return end
		self.slotList.ScrollLayoutGroupComponent:SetScrollNormalizedPosition(UITransformAxis.Vertical, event.Value)
	end

	@ExecSpace("ClientOnly")
	method void Open()
		self.inventoryGroup.Enable = true
		-- 처음 여는 시점엔 그동안 쌓인 아이템이 한꺼번에 "획득 연출"로 팝핑되면 안 되니 조용히 채운다
		self:RefreshSlots(false)
	end

	@ExecSpace("ClientOnly")
	method void NotifyInventoryChanged()
		-- 인벤토리를 열어둔 상태에서 아이템을 실시간으로 얻었을 때 호출됨 — 늘어난 슬롯만 획득 연출과 함께 갱신
		if not self.inventoryGroup.Enable then return end
		self:RefreshSlots(true)
	end

	@ExecSpace("ClientOnly")
	method void RefreshSlots(boolean playPopEffect)
		-- "획득한 순서대로" PlayerInventory 잡템을 채우고, 그 뒤에 야누스의 검 교환권을 표시한다
		local displayItemIds = _PlayerInventory:GetOrderedItemIds()
		-- 교환권 수는 @Sync(GameManager.ShadowVoucher)가 아니라 서버 알림값 — 알림 직후 여기가 불려서 @Sync는 아직 옛 값일 수 있다
		if _ShadowShopUI:GetLastVoucher() > 0 then
			table.insert(displayItemIds, "shadow_voucher")
		end
		if not isvalid(self.slotList) then return end
		
		for i = 0, self.slotCount - 1 do
			local slot = self.slotList:GetChildByName("Slot_" .. tostring(i))
			if isvalid(slot) then
				local itemId = nil
				if i < #displayItemIds then itemId = displayItemIds[i + 1] end
				self:RefreshSlot(slot, itemId, playPopEffect)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyIconAspect(Entity iconEntity, boolean keepAspect)
		-- keepAspect 잡템(가로로 긴 발광 박쥐의 날개 등)을 칸 안에 원본 비율 그대로 보여준다.
		--
		-- ⚠ 예전에는 PreserveSprite=AspectOnly로 했는데, 그러면 **아이콘이 칸 밖으로 밀려 나온다**
		-- (유저 리포트 2026-09-18: "인벤토리에 아이템이 어긋나 있는 게 있다" — 실측: 꼬리/철판/돌 등
		-- keepAspect 잡템만 위/오른쪽으로 치우쳐 잘림). AspectOnly가 스프라이트 자체 피벗을 기준으로
		-- 맞추는데 메이플 아이템 아이콘은 피벗이 가운데가 아니기 때문이다.
		-- → PreserveSprite는 항상 .ui 원래값(None)으로 두고, **칸(RectSize)을 원본 비율에 맞게 줄여서**
		-- 늘어짐 없이 가운데 정렬되게 한다(칸 자체가 가운데 앵커라 자동으로 중앙).
		local renderer = iconEntity.SpriteGUIRendererComponent
		if self._iconPreserveDefaults == nil then self._iconPreserveDefaults = {} end
		if self._iconSizeDefaults == nil then self._iconSizeDefaults = {} end
		local key = iconEntity.Id
		local t = iconEntity.UITransformComponent
		if self._iconPreserveDefaults[key] == nil then self._iconPreserveDefaults[key] = renderer.PreserveSprite end
		if self._iconSizeDefaults[key] == nil then self._iconSizeDefaults[key] = t.RectSize end
		renderer.PreserveSprite = self._iconPreserveDefaults[key]

		local baseSize = self._iconSizeDefaults[key]
		if not keepAspect then
			t.RectSize = baseSize
			return
		end

		-- 원본 가로/세로 비율로 칸 안에 맞춘다(둘 중 넘치는 쪽을 기준으로 축소)
		local m = _CardManager:GetSpriteMetrics(tostring(renderer.ImageRUID.DataId))
		if m.w <= 0 or m.h <= 0 then
			t.RectSize = baseSize
			return
		end
		local scale = math.min(baseSize.x / m.w, baseSize.y / m.h)
		t.RectSize = Vector2(m.w * scale, m.h * scale)
	end

	@ExecSpace("ClientOnly")
	method void RefreshSlot(Entity slot, any itemId, boolean playPopEffect)
		local iconEntity = slot:GetChildByName("Icon")
		local countEntity = slot:GetChildByName("Count")
		
		local count = 0
		local iconRuid = ""
		local keepAspect = false
		if itemId ~= nil then
			if itemId == "shadow_voucher" then
				count = _ShadowShopUI:GetLastVoucher()
				iconRuid = self._shadowVoucherIcon
			else
				count = _PlayerInventory:GetItemCount(itemId)
				local def = _PlayerInventory:GetItemDef(itemId)
				if def ~= nil then
					iconRuid = def.icon
					keepAspect = def.keepAspect == true
				end
			end
		end
		
		if isvalid(iconEntity) then
			local show = count > 0 and iconRuid ~= ""
			if show then
				iconEntity.SpriteGUIRendererComponent.ImageRUID = iconRuid
				self:ApplyIconAspect(iconEntity, keepAspect)
			end
			-- Icon은 빌드 시점에 SpriteGUIRendererComponent 자체가 Disable로 만들어져 있어서,
			-- Entity:SetEnable이 아니라 그 컴포넌트의 Enable을 직접 켜줘야 한다
			iconEntity.SpriteGUIRendererComponent.Enable = show
		end
		if isvalid(countEntity) then
			if count > 0 then
				countEntity.TextComponent.Text = tostring(count)
			else
				countEntity.TextComponent.Text = ""
			end
		end
		
		if itemId ~= nil then
			if self._lastKnownCounts == nil then self._lastKnownCounts = {} end
			local previousCount = 0
			if self._lastKnownCounts[itemId] ~= nil then previousCount = self._lastKnownCounts[itemId] end
			if playPopEffect and count > previousCount then
				self:PlayItemPopEffect(iconEntity)
			end
			self._lastKnownCounts[itemId] = count
		end
	end

	@ExecSpace("ClientOnly")
	method void PlayItemPopEffect(Entity iconEntity)
		-- 아이템을 새로 획득/추가로 얻었을 때 그 슬롯 자리에서 살짝 커졌다 작아지는 연출
		if not isvalid(iconEntity) then return end
		_TweenLogic:ScaleTo(iconEntity, Vector2(1.35, 1.35), 0.12, EaseType.BackEaseOut)
		_TimerService:SetTimerOnce(function()
			if isvalid(iconEntity) then
				_TweenLogic:ScaleTo(iconEntity, Vector2(1, 1), 0.15, EaseType.QuadEaseOut)
			end
		end, 0.12)
	end

	@ExecSpace("ClientOnly")
	method void Close()
		self.inventoryGroup.Enable = false
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._openHandler then self.btnInventory.Entity:DisconnectEvent(ButtonClickEvent, self._openHandler) end
		if self._closeHandler then self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self._closeHandler) end
		if self._dragHandler then self.titleBar:DisconnectEvent(UITouchDragEvent, self._dragHandler) end
		if self._scrollDragHandler then self.scrollTouchArea:DisconnectEvent(UITouchDragEvent, self._scrollDragHandler) end
		if self._scrollBarHandler then self.scrollBar.Entity:DisconnectEvent(SliderValueChangedEvent, self._scrollBarHandler) end
	end

end