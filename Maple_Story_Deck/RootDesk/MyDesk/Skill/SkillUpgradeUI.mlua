@Logic
script SkillUpgradeUI extends Logic

	property Entity popupGroup = "7233983e-f2c7-43f2-aacd-64596ab2459a"
	property ButtonComponent btnClose = "f6a7377b-4b3e-4e45-9213-b43726e21a70"
	property ButtonComponent btnUpgrade = "a80001a0-bc09-43fd-85e3-b7ed893c76e2"
	property TextComponent levelText = "7b32452e-e9b1-4dfc-a51d-0957bd542e50"
	property SpriteGUIRendererComponent iconSprite = "6f8a9bb9-bbfa-4def-99d8-08f38fb4294b"
	property TextComponent nameText = "d23ee014-65a4-4fd9-aee3-daa1d85dfbf6"
	property TextComponent optionText = "eabf1a42-e091-4aa6-8563-a8a4a825f7ef"
	property TextComponent costText = "331ebb1e-6f3c-4ef5-ba3c-68e81329fa7c"
	property TextComponent upgradeTitleText = "ad2fc439-017d-4b24-8987-26239f239b5d"
	-- 스킬명 아래 조각 진행바 — 버튼의 코인 비용과 분리해서 여기서 "N/다음레벨요구치"를 보여준다
	property SpriteGUIRendererComponent fragmentBarFill = "a02b3b4a-e856-492f-a83e-145d3a1038e6"
	property TextComponent fragmentBarText = "ce3a08fc-06cf-4454-bad3-b6c2e755b64f"
	-- 팝업 배경 프레임 — 스킬 등급(1=일반/2=매직/3=레어)에 맞춰 스킬탭 카드와 동일한 이미지로 갈아끼운다
	property SpriteGUIRendererComponent bgSprite = "d4c348db-b828-4d48-95a1-315405dbb02c"
	property string _normalBgRuid = "4f157354c9eb4aa4bd5923dc781b7540"
	property string _magicBgRuid = "ac461c7f65994d02a160a6d676828409"
	property string _rareBgRuid = "6b93ccab69c5485aae20d694a0a472bd"

	property integer _currentSkillIndex = -1
	property any _closeHandler = nil
	property any _upgradeHandler = nil
	property any _closeStateHandler = nil
	property any _upgradeStateHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self._closeHandler = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, self.Close)
		self._upgradeHandler = self.btnUpgrade.Entity:ConnectEvent(ButtonClickEvent, self.OnUpgradeClicked)
		-- 패딩(눌림) 연출 — 누르는 순간 작아지고 떼는 순간 원래 크기로 돌아온다
		self._closeStateHandler = self.btnClose.Entity:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnButtonStateChanged(event, self.btnClose.Entity) end)
		self._upgradeStateHandler = self.btnUpgrade.Entity:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnButtonStateChanged(event, self.btnUpgrade.Entity) end)
		log("SkillUpgradeUI started")
	end

	@ExecSpace("ClientOnly")
	method void OpenForSkill(integer skillIndex)
		-- 스킬 탭에서 아이콘을 눌렀을 때 SkillUI가 호출 — 상세/업그레이드 팝업을 연다
		self._currentSkillIndex = skillIndex
		self.popupGroup.Enable = true
		self:ApplyGradeBackground(skillIndex)
		self:RefreshPanel()
	end

	@ExecSpace("ClientOnly")
	method void ApplyGradeBackground(integer skillIndex)
		-- 1=일반 / 2=매직 / 3=레어 — 스킬탭 카드와 동일한 등급별 배경으로 맞춘다
		local grade = _SkillInventory:GetSkillGrade(skillIndex)
		local ruid = self._rareBgRuid
		if grade == 1 then
			ruid = self._normalBgRuid
		elseif grade == 2 then
			ruid = self._magicBgRuid
		end
		self.bgSprite.ImageRUID = DataRef(ruid)
		log("SkillUpgradeUI: popup bg for skill " .. tostring(skillIndex) .. " grade=" .. tostring(grade) .. " ruid=" .. ruid)
	end

	@ExecSpace("ClientOnly")
	method void Close()
		self._currentSkillIndex = -1
		self.popupGroup.Enable = false
	end

	@ExecSpace("ClientOnly")
	method void OnButtonStateChanged(ButtonStateChangeEvent event, Entity buttonEntity)
		if not isvalid(buttonEntity) then return end
		if event.state == ButtonState.Pressed then
			_TweenLogic:ScaleTo(buttonEntity, Vector2(0.9, 0.9), 0.06, EaseType.QuadEaseOut)
		else
			_TweenLogic:ScaleTo(buttonEntity, Vector2(1, 1), 0.12, EaseType.QuadEaseOut)
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshPanel()
		-- 현재 선택된 스킬의 레벨/조각/골드 상태를 다시 그린다. 업그레이드 성공 후에도 이 메서드로 갱신한다
		if self._currentSkillIndex < 0 then return end
		local key = tostring(self._currentSkillIndex)

		-- 강화 안 한 기본 상태는 Lv.1(0이 아니다)
		local level = 1
		if _SkillInventory.Levels[key] ~= nil then level = _SkillInventory.Levels[key] end
		local fragments = 0
		if _SkillInventory.Counts[key] ~= nil then fragments = _SkillInventory.Counts[key] end

		self.levelText.Text = "Lv." .. tostring(level)
		self.nameText.Text = _SkillUI:GetSkillBaseName(self._currentSkillIndex)
		self.iconSprite.ImageRUID = DataRef(_SkillUI:GetSkillIconRuid(self._currentSkillIndex))

		-- 레벨/조각/코인 흐름은 유물과 동일하게 동작하고, 실제 게임 효과는 CardManager가 카드 자체
		-- 레벨과 별개로 가산 적용한다(ApplyGradeBackground 근처 참고 없음 — CardManager Get* 게이트웨이 참고)
		local maxLevel = _SkillInventory:GetMaxLevelForSkill(self._currentSkillIndex)
		if level >= maxLevel then
			self.optionText.Text = "최대 레벨입니다"
			self.costText.Text = "MAX"
			self.fragmentBarText.Text = "MAX"
			self.fragmentBarFill.FillAmount = 1
			self:SetUpgradeEnabled(false)
			return
		end

		local nextLevel = level + 1
		local grade = _SkillInventory:GetSkillGrade(self._currentSkillIndex)
		local fragmentCost = _SkillInventory:GetFragmentCostForLevel(level, grade)
		local coinCost = _SkillInventory:GetGoldCostForLevel(level, grade)
		self.optionText.Text = "다음 레벨: Lv." .. tostring(nextLevel) .. "\n" .. self:GetSkillLevelUpDescription(self._currentSkillIndex, nextLevel)
		self.costText.Text = tostring(coinCost) .. "코인"

		self.fragmentBarText.Text = tostring(fragments) .. "/" .. tostring(fragmentCost)
		local fragmentRatio = fragments / fragmentCost
		if fragmentRatio > 1 then fragmentRatio = 1 end
		self.fragmentBarFill.FillAmount = fragmentRatio

		local canAfford = fragments >= fragmentCost and _GameManager.TotalCoins >= coinCost
		self:SetUpgradeEnabled(canAfford)
	end

	-- 스킬탭 카드 자체 레벨과 별개로 항상 가산되는 SkillInventory 레벨업 보너스 설명(CardManager 실제
	-- 적용 로직과 1:1로 맞춘 텍스트). 20개 전부 최대레벨9, 보너스는 Lv3/6/9에서만 상승 —
	-- Lv1,2,4,5,7,8은 조각/골드만 소모하고 효과는 없다.
	@ExecSpace("ClientOnly")
	method string GetSkillLevelUpDescription(integer skillIndex, integer nextLevel)
		if nextLevel ~= 3 and nextLevel ~= 6 and nextLevel ~= 9 then
			return "다음 효과 상승 구간(Lv3/6/9)까지의 축적 단계 (효과 없음)"
		end
		if skillIndex == 0 then -- 매직 부스터
			if nextLevel == 3 then return "전체 쿨타임 2% 감소"
			elseif nextLevel == 6 then return "전체 쿨타임 4% 감소"
			else return "전체 쿨타임 6% 감소" end
		elseif skillIndex == 1 then -- 포션
			if nextLevel == 3 then return "회복량 5% 증가"
			elseif nextLevel == 6 then return "회복량 7% 증가"
			else return "회복량 9% 증가" end
		elseif skillIndex == 2 then -- 매직 아머
			if nextLevel == 3 then return "받는 피해 3% 감소"
			elseif nextLevel == 6 then return "받는 피해 6% 감소"
			else return "받는 피해 9% 감소" end
		elseif skillIndex == 3 then -- 썬더볼트
			if nextLevel == 3 then return "대미지 10% 증가"
			elseif nextLevel == 6 then return "스턴 지속시간 1초 증가"
			else return "스턴 확률 10% 증가" end
		elseif skillIndex == 4 then -- 콜드빔
			if nextLevel == 3 then return "대미지 10% 증가"
			elseif nextLevel == 6 then return "쿨타임 5% 감소"
			else return "20% 확률로 빙결 스택 +1" end
		elseif skillIndex == 5 then -- 아이스커터
			if nextLevel == 3 then return "대미지 10% 증가"
			elseif nextLevel == 6 then return "쿨타임 5% 감소"
			else return "출혈 대미지 2% 증가" end
		elseif skillIndex == 6 then -- 에너지볼트
			if nextLevel == 3 then return "대미지 10% 증가"
			elseif nextLevel == 6 then return "쿨타임 5% 감소"
			else return "크리티컬 확률 5% 증가" end
		elseif skillIndex == 7 then -- 썬더커터
			if nextLevel == 3 then return "대미지 10% 증가"
			elseif nextLevel == 6 then return "쿨타임 5% 감소"
			else return "크리티컬 확률 5% 증가" end
		elseif skillIndex == 8 then -- 매직 크리티컬
			if nextLevel == 3 then return "크리티컬 확률 +2%"
			elseif nextLevel == 6 then return "크리티컬 확률 +4%"
			else return "크리티컬 확률 +6%" end
		elseif skillIndex == 9 then -- 프리징 이펙트
			if nextLevel == 3 then return "빙결 스택당 보너스대미지 +3%"
			elseif nextLevel == 6 then return "빙결 스택당 보너스대미지 +6%"
			else return "빙결 스택당 보너스대미지 +9%" end
		elseif skillIndex == 10 then -- 메디테이션
			if nextLevel == 3 then return "전체 스킬 피해량 2% 증가"
			elseif nextLevel == 6 then return "전체 스킬 피해량 4% 증가"
			else return "전체 스킬 피해량 6% 증가" end
		elseif skillIndex == 11 then -- 페페
			if nextLevel == 3 then return "대미지 10% 증가"
			elseif nextLevel == 6 then return "쿨타임 5% 감소"
			else return "2연타 확률 +5%" end
		elseif skillIndex == 12 then -- 헤일 스톤
			if nextLevel == 3 then return "대미지 10% 증가"
			elseif nextLevel == 6 then return "쿨타임 5% 감소"
			else return "10% 확률로 빙결 스택 +1" end
		elseif skillIndex == 13 then -- 아쿠아 트랩
			if nextLevel == 3 then return "대미지 10% 증가"
			elseif nextLevel == 6 then return "쿨타임 5% 감소"
			else return "크리티컬 확률 5% 증가" end
		elseif skillIndex == 14 then -- 썬더스톰
			if nextLevel == 3 then return "대미지 10% 증가"
			elseif nextLevel == 6 then return "쿨타임 5% 감소"
			else return "스턴 확률 10% 증가" end
		elseif skillIndex == 15 then -- 아이스 스트라이크
			if nextLevel == 3 then return "대미지 10% 증가"
			elseif nextLevel == 6 then return "쿨타임 5% 감소"
			else return "10% 확률로 빙결 스택 +2" end
		elseif skillIndex == 16 then -- 체인 라이트닝
			if nextLevel == 3 then return "대미지 10% 증가"
			elseif nextLevel == 6 then return "쿨타임 5% 감소"
			else return "크리티컬 확률 10% 추가" end
		elseif skillIndex == 17 then -- 더블 커터
			if nextLevel == 3 then return "대미지 10% 증가"
			elseif nextLevel == 6 then return "쿨타임 5% 감소"
			else return "크리티컬 확률 10% 추가" end
		elseif skillIndex == 18 then -- 킹페페
			if nextLevel == 3 then return "대미지 10% 증가"
			elseif nextLevel == 6 then return "쿨타임 5% 감소"
			else return "2연타 확률 +10%" end
		elseif skillIndex == 19 then -- 헤일 버스트
			if nextLevel == 3 then return "대미지 10% 증가"
			elseif nextLevel == 6 then return "쿨타임 5% 감소"
			else return "10% 확률로 빙결 스택 +3" end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void SetUpgradeEnabled(boolean enabled)
		self.btnUpgrade.Enable = enabled
		local sprite = self.btnUpgrade.Entity.SpriteGUIRendererComponent
		if enabled then
			sprite.Color = Color(0.94, 0.78, 0.32, 1.0)
			self.upgradeTitleText.FontColor = Color(0.169, 0.141, 0.071, 1.0)
			self.costText.FontColor = Color(0.169, 0.141, 0.071, 1.0)
		else
			sprite.Color = Color(0.94 * 0.4, 0.78 * 0.4, 0.32 * 0.4, 1.0)
			self.upgradeTitleText.FontColor = Color(1.0, 1.0, 1.0, 1.0)
			self.costText.FontColor = Color(1.0, 1.0, 1.0, 1.0)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpgradeClicked()
		_SkillInventory:RequestLevelUpSkill(self._currentSkillIndex)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._closeHandler then self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self._closeHandler) end
		if self._upgradeHandler then self.btnUpgrade.Entity:DisconnectEvent(ButtonClickEvent, self._upgradeHandler) end
		if self._closeStateHandler then self.btnClose.Entity:DisconnectEvent(ButtonStateChangeEvent, self._closeStateHandler) end
		if self._upgradeStateHandler then self.btnUpgrade.Entity:DisconnectEvent(ButtonStateChangeEvent, self._upgradeStateHandler) end
	end

end
