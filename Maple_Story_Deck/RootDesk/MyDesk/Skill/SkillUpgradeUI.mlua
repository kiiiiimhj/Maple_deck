@Logic
script SkillUpgradeUI extends Logic

	property Entity popupGroup = "7233983e-f2c7-43f2-aacd-64596ab2459a"
	property ButtonComponent btnClose = "f6a7377b-4b3e-4e45-9213-b43726e21a70"
	property ButtonComponent btnUpgrade = "a80001a0-bc09-43fd-85e3-b7ed893c76e2"
	property TextComponent levelText = "7b32452e-e9b1-4dfc-a51d-0957bd542e50"
	property SpriteGUIRendererComponent iconSprite = "6f8a9bb9-bbfa-4def-99d8-08f38fb4294b"
	property TextComponent nameText = "d23ee014-65a4-4fd9-aee3-daa1d85dfbf6"
	property TextComponent optionText = "eabf1a42-e091-4aa6-8563-a8a4a825f7ef"
	property TextComponent costText = "331ebb1e-6f3c-4ef5-ba3c-68e81329fa7c"
	property TextComponent upgradeTitleText = "ad2fc439-017d-4b24-8987-26239f239b5d"
	-- 스킬명 아래 조각 진행바 — 버튼의 코인 비용과 분리해서 여기서 "N/다음레벨요구치"를 보여준다
	property SpriteGUIRendererComponent fragmentBarFill = "a02b3b4a-e856-492f-a83e-145d3a1038e6"
	property TextComponent fragmentBarText = "ce3a08fc-06cf-4454-bad3-b6c2e755b64f"
	-- 팝업 배경 프레임 — 스킬 등급(1=일반/2=매직/3=레어)에 맞춰 스킬탭 카드와 동일한 이미지로 갈아끼운다
	property SpriteGUIRendererComponent bgSprite = "d4c348db-b828-4d48-95a1-315405dbb02c"
	property string _normalBgRuid = "4f157354c9eb4aa4bd5923dc781b7540"
	property string _magicBgRuid = "ac461c7f65994d02a160a6d676828409"
	property string _rareBgRuid = "6b93ccab69c5485aae20d694a0a472bd"

	property integer _currentSkillIndex = -1
	property any _closeHandler = nil
	property any _upgradeHandler = nil
	property any _closeStateHandler = nil
	property any _upgradeStateHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 월드 시작 시점엔 무조건 숨겨둔다 — CharacterUnlockUI/GachaUI 등과 동일한 이유(유저 지적:
		-- "팝업같은 UI가 떴다 로비화면으로 변경되는 경우가있어" — SkillUpgradeGroup의 displayOrder가
		-- TitleGroup보다 높아서 .ui 저장 기본값(Enable=true)이 그대로면 로비 위에 덮여 그려진다).
		self.popupGroup.Enable = false
		self._closeHandler = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, self.Close)
		self._upgradeHandler = self.btnUpgrade.Entity:ConnectEvent(ButtonClickEvent, self.OnUpgradeClicked)
		-- 패딩(눌림) 연출 — 누르는 순간 작아지고 떼는 순간 원래 크기로 돌아온다
		self._closeStateHandler = self.btnClose.Entity:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnButtonStateChanged(event, self.btnClose.Entity) end)
		self._upgradeStateHandler = self.btnUpgrade.Entity:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnButtonStateChanged(event, self.btnUpgrade.Entity) end)
		log("SkillUpgradeUI started")
	end

	@ExecSpace("ClientOnly")
	method void OpenForSkill(integer skillIndex)
		-- 스킬 탭에서 아이콘을 눌렀을 때 SkillUI가 호출 — 상세/업그레이드 팝업을 연다
		self._currentSkillIndex = skillIndex
		self.popupGroup.Enable = true
		self:ApplyGradeBackground(skillIndex)
		self:RefreshPanel()
	end

	@ExecSpace("ClientOnly")
	method void ApplyGradeBackground(integer skillIndex)
		-- 1=일반 / 2=매직 / 3=레어 — 스킬탭 카드와 동일한 등급별 배경으로 맞춘다
		local grade = _SkillInventory:GetSkillGrade(skillIndex)
		local ruid = self._rareBgRuid
		if grade == 1 then
			ruid = self._normalBgRuid
		elseif grade == 2 then
			ruid = self._magicBgRuid
		end
		self.bgSprite.ImageRUID = DataRef(ruid)
		log("SkillUpgradeUI: popup bg for skill " .. tostring(skillIndex) .. " grade=" .. tostring(grade) .. " ruid=" .. ruid)
	end

	@ExecSpace("ClientOnly")
	method void Close()
		self._currentSkillIndex = -1
		self.popupGroup.Enable = false
	end

	@ExecSpace("ClientOnly")
	method void OnButtonStateChanged(ButtonStateChangeEvent event, Entity buttonEntity)
		if not isvalid(buttonEntity) then return end
		-- 눌림 연출은 이제 공용 ButtonPressFxLogic이 모든 버튼에 건다(2026-09-26) — 여기서 또 크기를 바꾸면
		-- 같은 버튼을 두 곳이 다퉈 중심 보정이 틀어진다. 연결은 남겨두되 아무것도 하지 않는다
	end

	@ExecSpace("ClientOnly")
	method void RefreshPanel()
		-- 현재 선택된 스킬의 레벨/조각/골드 상태를 다시 그린다. 업그레이드 성공 후에도 이 메서드로 갱신한다
		if self._currentSkillIndex < 0 then return end
		local key = tostring(self._currentSkillIndex)

		-- 강화 안 한 기본 상태는 Lv.1(0이 아니다). 서버(SkillInventory.RequestLevelUpSkill)와 같은 규칙으로
		-- nil이 아니라 "0보다 큰가"를 본다 — 저장된 0이 기본 레벨을 덮으면 Lv.0으로 표시된다
		local level = 1
		local storedLevel = _SkillInventory.Levels[key]
		if storedLevel ~= nil and storedLevel > 0 then level = storedLevel end
		local fragments = 0
		if _SkillInventory.Counts[key] ~= nil then fragments = _SkillInventory.Counts[key] end

		self.levelText.Text = "Lv." .. tostring(level)
		self.nameText.Text = _SkillUI:GetSkillBaseName(self._currentSkillIndex)
		self.iconSprite.ImageRUID = DataRef(_SkillUI:GetSkillIconRuid(self._currentSkillIndex))

		-- 레벨/조각/코인 흐름은 유물과 동일하게 동작하고, 실제 게임 효과는 CardManager가 카드 자체
		-- 레벨과 별개로 가산 적용한다(ApplyGradeBackground 근처 참고 없음 — CardManager Get* 게이트웨이 참고)
		local maxLevel = _SkillInventory:GetMaxLevelForSkill(self._currentSkillIndex)
		if level >= maxLevel then
			self.optionText.Text = _LocalizationService:GetText("MLUA_RELICUPGRADEUI_003")
			self.costText.Text = "MAX"
			self.fragmentBarText.Text = "MAX"
			self.fragmentBarFill.FillAmount = 1
			self:SetUpgradeEnabled(false)
			return
		end

		local nextLevel = level + 1
		local grade = _SkillInventory:GetSkillGrade(self._currentSkillIndex)
		local fragmentCost = _SkillInventory:GetFragmentCostForLevel(level, grade)
		local coinCost = _SkillInventory:GetGoldCostForLevel(level, grade)
		self.optionText.Text = _LocalizationService:GetTextFormat("FMT_SKILLUPGRADEUI_001", tostring(nextLevel), self:GetSkillLevelUpDescription(self._currentSkillIndex, nextLevel))
		self.costText.Text = _LocalizationService:GetTextFormat("FMT_RELICUPGRADEUI_003", tostring(coinCost))

		self.fragmentBarText.Text = tostring(fragments) .. "/" .. tostring(fragmentCost)
		local fragmentRatio = fragments / fragmentCost
		if fragmentRatio > 1 then fragmentRatio = 1 end
		self.fragmentBarFill.FillAmount = fragmentRatio

		local canAfford = fragments >= fragmentCost and _TitleUI:GetLastCurrency("gold") >= coinCost
		self:SetUpgradeEnabled(canAfford)
	end

	-- 스킬탭 카드 자체 레벨과 별개로 항상 가산되는 SkillInventory 레벨업 보너스 설명(CardManager 실제
	-- 적용 로직과 1:1로 맞춘 텍스트). 20개 전부 최대레벨9, 보너스는 Lv3/6/9에서만 상승 —
	-- Lv1,2,4,5,7,8은 조각/골드만 소모하고 효과는 없다.
	@ExecSpace("ClientOnly")
	method string GetSkillLevelUpDescription(integer skillIndex, integer nextLevel)
		if nextLevel ~= 3 and nextLevel ~= 6 and nextLevel ~= 9 then
			return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_002")
		end
		if skillIndex == 0 then -- 매직 부스터
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_003")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_004")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_005") end
		elseif skillIndex == 1 then -- 포션
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_006")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_007")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_008") end
		elseif skillIndex == 2 then -- 매직 아머
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_009")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_010")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_011") end
		elseif skillIndex == 3 then -- 썬더볼트
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_013")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_014") end
		elseif skillIndex == 4 then -- 콜드빔
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_016") end
		elseif skillIndex == 5 then -- 아이스커터
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_017") end
		elseif skillIndex == 6 then -- 에너지볼트
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_018") end
		elseif skillIndex == 7 then -- 썬더커터
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_018") end
		elseif skillIndex == 8 then -- 매직 크리티컬
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_CARDMANAGER_077")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_019")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_020") end
		elseif skillIndex == 9 then -- 프리징 이펙트
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_021")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_022")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_023") end
		elseif skillIndex == 10 then -- 메디테이션
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_024")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_025")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_026") end
		elseif skillIndex == 11 then -- 페페
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_027") end
		elseif skillIndex == 12 then -- 헤일 스톤
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_028") end
		elseif skillIndex == 13 then -- 아쿠아 트랩
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_018") end
		elseif skillIndex == 14 then -- 썬더스톰
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_014") end
		elseif skillIndex == 15 then -- 아이스 스트라이크
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_029") end
		elseif skillIndex == 16 then -- 체인 라이트닝
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_030") end
		elseif skillIndex == 17 then -- 더블 커터
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_030") end
		elseif skillIndex == 18 then -- 킹페페
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_031") end
		elseif skillIndex == 19 then -- 헤일 버스트
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_032") end

		-- 실피드 전용 20종(인덱스 20~39) — 유저 확정표. 바람의 시/폭풍의 시는 원본 표에서 Lv6/Lv9
		-- 효과가 서로 뒤바뀌어 있었던 것을 다른 18개와 동일한 (대미지/쿨타임/고유효과) 패턴으로
		-- 정규화했다(유저 확인 필요 — CardManager 적용 로직도 동일하게 정규화된 텍스트 기준).
		elseif skillIndex == 20 then -- 바람의 시
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_033") end
		elseif skillIndex == 21 then -- 애로우 블로우
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_033") end
		elseif skillIndex == 22 then -- 아이스 퀴버
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_034") end
		elseif skillIndex == 23 then -- 파이어 퀴버
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_035") end
		elseif skillIndex == 24 then -- 피닉스
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_036") end
		elseif skillIndex == 25 then -- 리트리트 샷
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_037") end
		elseif skillIndex == 26 then -- 언카운터 에로우
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_037") end
		elseif skillIndex == 27 then -- 플레시 미라주
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_015")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_038") end
		elseif skillIndex == 28 then -- 에로우 일루전
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_039")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_040") end
		elseif skillIndex == 29 then -- 이볼브
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_041")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_039")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_036") end
		elseif skillIndex == 30 then -- 폭풍의 시
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_041")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_039")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_042") end
		elseif skillIndex == 31 then -- 강화 애로우 블로우
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_041")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_039")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_042") end
		elseif skillIndex == 32 then -- 에로우 플레터
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_041")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_039")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_043") end
		elseif skillIndex == 33 then -- 언카운트에로우V
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_041")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_039")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_043") end
		elseif skillIndex == 34 then -- 플레시 봄버
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_041")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_039")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_043") end
		elseif skillIndex == 35 then -- 보우 액셀레이션
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_044")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_045")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_046") end
		elseif skillIndex == 36 then -- 꿰뚫는 의지
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_CARDMANAGER_077")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_019")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_020") end
		elseif skillIndex == 37 then -- 크리티컬 샷
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_047")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_048")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_049") end
		elseif skillIndex == 38 then -- 파이널 어택 : 활
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_050")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_051")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_052") end
		elseif skillIndex == 39 then -- 연속 사격
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_053")
			elseif nextLevel == 6 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_054")
			else return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_055") end

		-- 레이온 전용 20종(인덱스 40~59) — 유저 확정표
		elseif skillIndex == 40 then -- 슬래시
			if nextLevel == 3 then return _LocalizationService:GetText("MLUA_SKILLUPGRADEUI_012")
