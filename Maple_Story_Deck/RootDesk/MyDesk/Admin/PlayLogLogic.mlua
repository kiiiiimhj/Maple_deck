@Logic
script PlayLogLogic extends Logic

	-- 접속 기록(유저 지정 2026-09-25: "진짜 플레이했는지, 핸드폰 기종이 궁금").
	-- MSW는 기종 이름을 주지 않는다 — 대신 모바일/PC, 화면 해상도, 앱 버전(앞에 android./ios./win. 등이 붙음), 언어를 남긴다.
	-- 저장: 전역 저장소 "PlayLog"
	--   "N:<닉네임>"  = JSON {nick, profile, uid, first, last, count, mobile, w, h, ver, lang}  (시각은 한국 시간 문자열)
	--   "_recent"     = 최근 접속 RecentMax명, 한 줄에 한 명 "닉네임\t시각\t모바일(1/0)\t가로\t세로\t앱버전" (최신이 위)
	-- 비용: 접속 1회당 Get 2 + Set 2(세션당 한 번만). 여러 인스턴스가 동시에 _recent를 쓰면 늦게 쓴 쪽이 이긴다(목록에서 한 명 빠질 수 있음).
	-- 조회: 운영자(AdminUserIds)에게만 "관리" 버튼이 보이고, 닉네임 조회 / 최근 접속 목록을 연다. 서버도 운영자인지 다시 확인한다.

	property string StorageName = "PlayLog"
	property string RecentKey = "_recent"
	property integer RecentMax = 50
	property integer RecentShowCount = 20
	-- 운영자 UserId(쉼표로 여러 명). Maker와 라이브가 같은 MSW 계정 ID를 쓴다(2026-09-25 확인: 20372100009920522)
	property string AdminUserIds = "20372100009920522"
	property number ReportDelay = 3.0
	property integer ReportMaxTries = 5

	-- UI (ui/AdminLookupGroup.ui)
	property ButtonComponent openBtn = "d19ea89a-1801-4d50-adbb-f0dc47b54e46"
	property Entity window = "b15efe9e-52c1-4999-b112-c78c0fd31189"
	property TextGUIRendererInputComponent input = "6e80ee1d-3c71-41bf-963f-5538a7c78fef"
	property ButtonComponent btnLookup = "cb242b40-08c6-4c26-84c0-8e59f398edd1"
	property ButtonComponent btnRecent = "2cead8d9-4a2d-400b-b202-3c473dd5fee7"
	property ButtonComponent btnClose = "d1c9927b-ba7f-493a-ba71-00cb05bee4bc"
	property TextGUIRendererComponent resultText = "e02c8a7c-675d-47fd-ba96-03afd2fa3d93"
	-- 랭킹 상위 + 생존 시간 보기(2026-09-29 — "3만점 유저" 확인용). 랭킹 저장값 = 점수*RankScoreTimeScale + 생존초
	-- (GameManager.EncodeRankScore)라 이미 쌓인 기록에서도 생존 시간을 꺼낼 수 있다. 입력칸에 닉네임이 있으면 그 사람만.
	property ButtonComponent btnRank = "4b2ffa19-9dc7-4d4d-86b8-b3cc5cbae3ca"
	property integer RankShowUnlimited = 15
	property integer RankShowTimeAttack = 5
	-- ⚠ GameManager.RankBoardIdUnlimited/TimeAttack·RankScoreTimeScale, RankUI와 같은 값 — 바꾸면 같이 바꿀 것
	-- (다른 Logic 필드를 직접 읽으면 nil이 올 수 있어서 복제해 둠)
	property integer RankBoardUnlimited = 1
	property integer RankBoardTimeAttack = 2
	property integer RankScoreTimeScale = 10000
	property any _rankHandler = nil

	property any _reportedUsers = nil
	property integer _reportTries = 0
	property any _openHandler = nil
	property any _lookupHandler = nil
	property any _recentHandler = nil
	property any _closeHandler = nil
	property any _submitHandler = nil

	method void OnBeginPlay()
		-- 서버: 세션당 1회 저장용 표 / 클라: 창 닫아 두고 버튼 연결, 잠시 뒤 기기 정보 보고
		if self:IsServer() then
			self._reportedUsers = {}
			log("PlayLogLogic started (server)")
			return
		end
		self:SetupClient()
	end

	@ExecSpace("ClientOnly")
	method void SetupClient()
		-- 조회 창 초기 상태 + 버튼 연결 + 기기 정보 보고 예약
		if isvalid(self.window) then self.window.Enable = false end
		if isvalid(self.openBtn) then
			self.openBtn.Entity.Enable = false
			self._openHandler = self.openBtn.Entity:ConnectEvent(ButtonClickEvent, function() self:OpenWindow() end)
		end
		if isvalid(self.btnLookup) then
			self._lookupHandler = self.btnLookup.Entity:ConnectEvent(ButtonClickEvent, function() self:OnLookupClicked() end)
		end
		if isvalid(self.btnRecent) then
			self._recentHandler = self.btnRecent.Entity:ConnectEvent(ButtonClickEvent, function() self:OnRecentClicked() end)
		end
		if isvalid(self.btnClose) then
			self._closeHandler = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, function() self:CloseWindow() end)
		end
		if isvalid(self.btnRank) then
			self._rankHandler = self.btnRank.Entity:ConnectEvent(ButtonClickEvent, function() self:OnRankClicked() end)
		end
		if isvalid(self.input) then
			self.input.PlaceHolder = _LocText:Resolve("MLUA_PLAYLOGLOGIC_001")
			self._submitHandler = self.input.Entity:ConnectEvent(TextInputSubmitEvent, function() self:OnLookupClicked() end)
		end
		self._reportTries = 0
		self:ScheduleReport()
	end

	@ExecSpace("ClientOnly")
	method void ScheduleReport()
		-- 로컬 플레이어가 잡힌 뒤에 서버로 기기 정보를 보낸다(안 잡히면 몇 번 더 기다림)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self._reportTries = self._reportTries + 1
			if not isvalid(_UserService.LocalPlayer) then
				if self._reportTries < self.ReportMaxTries then self:ScheduleReport() end
				return
			end
			local isMobile = Environment:IsMobilePlatform()
			local w = _UILogic.ScreenWidth
			local h = _UILogic.ScreenHeight
			local ver = Environment:GetApplicationVersion()
			if ver == nil then ver = "" end
			local lang = _LocalizationService.CurrentLocaleId
			if lang == nil then lang = "" end
			log(string.format("PlayLogLogic: report device mobile=%s %dx%d ver=%s lang=%s", tostring(isMobile), w, h, ver, lang))
			self:ReportDevice(isMobile, w, h, ver, lang)
		end, self.ReportDelay)
	end

	@ExecSpace("Server")
	method void ReportDevice(boolean isMobile, integer w, integer h, string ver, string lang)
		-- 클라가 보낸 기기 정보 + 서버가 아는 닉네임/프로필코드를 저장한다(세션당 1회)
		local userId = senderUserId
		if self._reportedUsers == nil then self._reportedUsers = {} end
		if self._reportedUsers[userId] then return end
		self._reportedUsers[userId] = true

		local user = _UserService:GetUserEntityByUserId(userId)
		if not isvalid(user) then
			log_warning("PlayLogLogic: user entity not found for " .. tostring(userId))
			return
		end
		local pc = user.PlayerComponent
		local nick = pc.Nickname
		if nick == nil or nick == "" then nick = tostring(userId) end
		local now = self:GetKstString()

		local storage = _DataStorageService:GetGlobalDataStorage(self.StorageName)
		local recKey = "N:" .. nick

		local rec = nil
		local code, raw = storage:GetAndWait(recKey)
		if code == 0 and raw ~= nil and raw ~= "" then rec = _HttpService:JSONDecode(raw) end
		if rec == nil then rec = { first = now, count = 0 } end
		rec.nick = nick
		rec.profile = pc.ProfileCode
		rec.uid = tostring(userId)
		rec.last = now
		rec.count = (rec.count or 0) + 1
		rec.mobile = isMobile
		rec.w = w
		rec.h = h
		rec.ver = ver
		rec.lang = lang
		if rec.first == nil then rec.first = now end

		local mobileFlag = "0"
		if isMobile then mobileFlag = "1" end
		local line = table.concat({ nick, now, mobileFlag, tostring(w), tostring(h), ver }, "\t")
		local lines = { line }
		local rCode, rRaw = storage:GetAndWait(self.RecentKey)
		if rCode == 0 and rRaw ~= nil and rRaw ~= "" then
			for old in string.gmatch(rRaw, "[^\n]+") do
				if #lines >= self.RecentMax then break end
				local oldNick = string.match(old, "^([^\t]*)")
				if oldNick ~= nick then table.insert(lines, old) end
			end
		end

		local kv = {}
		kv[recKey] = _HttpService:JSONEncode(rec)
		kv[self.RecentKey] = table.concat(lines, "\n")
		storage:BatchSetAsync(kv, function(errorCode, successKeys)
			if errorCode ~= 0 then
				log_warning("PlayLogLogic: save failed code=" .. tostring(errorCode))
			end
		end)
		log(string.format("PlayLogLogic: logged %s (count=%d, mobile=%s, %dx%d, ver=%s)", nick, rec.count, tostring(isMobile), w, h, ver))

		if self:IsAdmin(userId) then self:NotifyAdmin(userId) end
	end

	@ExecSpace("ServerOnly")
	method boolean IsAdmin(string userId)
		-- AdminUserIds(쉼표 구분)에 들어 있는 계정인가
		for id in string.gmatch(self.AdminUserIds, "[^,%s]+") do
			if id == tostring(userId) then return true end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method string GetKstString()
		-- 한국 시간 "yyyy-mm-dd hh:mm"
		local kst = DateTime.UtcNow + TimeSpan.FromHours(9)
		return string.format("%04d-%02d-%02d %02d:%02d", kst.Year, kst.Month, kst.Day, kst.Hour, kst.Minute)
	end

	@ExecSpace("Client")
	method void NotifyAdmin()
		-- 운영자에게만 "관리" 버튼을 보여 준다
		if isvalid(self.openBtn) then self.openBtn.Entity.Enable = true end
		log("PlayLogLogic: admin button enabled")
	end

	@ExecSpace("ClientOnly")
	method void OpenWindow()
		-- 조회 창 열기 — 열자마자 최근 접속 목록을 불러온다
		if not isvalid(self.window) then return end
		self.window.Enable = true
		self:OnRecentClicked()
	end

	@ExecSpace("ClientOnly")
	method void CloseWindow()
		if isvalid(self.window) then self.window.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void OnLookupClicked()
		-- 입력한 닉네임 조회(비어 있으면 최근 목록)
		local nick = ""
		if isvalid(self.input) and self.input.Text ~= nil then nick = self.input.Text end
		nick = string.match(nick, "^%s*(.-)%s*$")
		if nick == "" then
			self:OnRecentClicked()
			return
		end
		self:SetResult(_LocText:Resolve("MLUA_PLAYLOGLOGIC_002"))
		self:RequestLookup(nick)
	end

	@ExecSpace("ClientOnly")
	method void OnRecentClicked()
		self:SetResult(_LocText:Resolve("MLUA_PLAYLOGLOGIC_002"))
		self:RequestLookup("")
	end

	@ExecSpace("Server")
	method void RequestLookup(string nick)
		-- 운영자만: nick이 비면 최근 접속 목록, 아니면 그 닉네임 기록을 돌려준다
		local userId = senderUserId
		if not self:IsAdmin(userId) then
			log_warning("PlayLogLogic: lookup denied for " .. tostring(userId))
			return
		end
		local storage = _DataStorageService:GetGlobalDataStorage(self.StorageName)
		local key = self.RecentKey
		if nick ~= "" then key = "N:" .. nick end
		local code, raw = storage:GetAndWait(key)
		if code ~= 0 or raw == nil then raw = "" end
		log(string.format("PlayLogLogic: lookup '%s' code=%d len=%d", nick, code, #raw))
		self:ShowResult(nick, raw, userId)
	end

	@ExecSpace("Client")
	method void ShowResult(string nick, string raw)
		-- 서버가 보낸 원본을 현재 언어로 풀어서 보여 준다
		if raw == "" then
			self:SetResult(_LocText:Resolve("MLUA_PLAYLOGLOGIC_003"))
			return
		end
		if nick == "" then
			self:SetResult(self:FormatRecent(raw))
		else
			self:SetResult(self:FormatRecord(raw))
		end
	end

	@ExecSpace("ClientOnly")
	method string PlatformName(boolean isMobile)
		if isMobile then return _LocText:Resolve("MLUA_PLAYLOGLOGIC_004") end
		return _LocText:Resolve("MLUA_PLAYLOGLOGIC_005")
	end

	@ExecSpace("ClientOnly")
	method string FormatRecord(string raw)
		-- 닉네임 1명의 기록
		local rec = _HttpService:JSONDecode(raw)
		if rec == nil then return raw end
		local L = _LocalizationService
		local out = {
			L:GetTextFormat("FMT_PLAYLOGLOGIC_001", tostring(rec.nick), tostring(rec.profile)),
			L:GetTextFormat("FMT_PLAYLOGLOGIC_002", tostring(rec.first)),
			L:GetTextFormat("FMT_PLAYLOGLOGIC_003", tostring(rec.last)),
			L:GetTextFormat("FMT_PLAYLOGLOGIC_004", tostring(rec.count)),
			L:GetTextFormat("FMT_PLAYLOGLOGIC_005", self:PlatformName(rec.mobile == true), tostring(rec.w), tostring(rec.h)),
			L:GetTextFormat("FMT_PLAYLOGLOGIC_006", tostring(rec.ver), tostring(rec.lang)),
			"UserId " .. tostring(rec.uid),
		}
		return table.concat(out, "\n")
	end

	@ExecSpace("ClientOnly")
	method string FormatRecent(string raw)
		-- 최근 접속 목록(최신이 위)
		local rows = {}
		local total = 0
		for line in string.gmatch(raw, "[^\n]+") do
			total = total + 1
			if #rows < self.RecentShowCount then
				local parts = {}
				for p in string.gmatch(line .. "\t", "([^\t]*)\t") do table.insert(parts, p) end
				local platform = self:PlatformName(parts[3] == "1")
				table.insert(rows, string.format("%s   %s   %s %sx%s   %s",
					tostring(parts[2]), tostring(parts[1]), platform, tostring(parts[4]), tostring(parts[5]), tostring(parts[6])))
			end
		end
		table.insert(rows, 1, _LocalizationService:GetTextFormat("FMT_PLAYLOGLOGIC_007", tostring(total)))
		return table.concat(rows, "\n")
	end

	@ExecSpace("ClientOnly")
	method void OnRankClicked()
		-- 랭킹 상위 목록(입력칸에 닉네임이 있으면 그 사람 기록만)
		local nick = ""
		if isvalid(self.input) and self.input.Text ~= nil then nick = self.input.Text end
		nick = string.match(nick, "^%s*(.-)%s*$")
		self:SetResult(_LocText:Resolve("MLUA_PLAYLOGLOGIC_002"))
		self:RequestRankLookup(nick)
	end

	@ExecSpace("ServerOnly")
	method void SaveRankMeta(integer boardId, string profileCode, integer episode, integer character, integer continues, integer kills, integer level)
		-- GameManager.SubmitRankingScore가 기록 갱신 시 호출 — 그 판 정보를 전역 저장소 "R:<보드>:<프로필>"에 남긴다
		if profileCode == nil or profileCode == "" then return end
		local meta = { ep = episode, ch = character, c = continues, k = kills, lv = level, t = self:GetKstString() }
		local storage = _DataStorageService:GetGlobalDataStorage(self.StorageName)
		local key = "R:" .. tostring(boardId) .. ":" .. profileCode
		storage:SetAsync(key, _HttpService:JSONEncode(meta), function(errorCode)
			if errorCode ~= 0 then log_warning("PlayLogLogic: rank meta save failed code=" .. tostring(errorCode)) end
		end)
		log(string.format("PlayLogLogic: rank meta saved board=%d ep=%d ch=%d continues=%d kills=%d lv=%d", boardId, episode, character, continues, kills, level))
	end

	@ExecSpace("Server")
	method void RequestRankLookup(string nick)
		-- 운영자만: 무제한/타임어택 보드의 저장값을 "보드\t순위\t닉네임\t저장값" 줄로 돌려준다(풀이는 클라)
		local userId = senderUserId
		if not self:IsAdmin(userId) then
			log_warning("PlayLogLogic: rank lookup denied for " .. tostring(userId))
			return
		end
		local lines = {}
		local storage = _DataStorageService:GetGlobalDataStorage(self.StorageName)
		-- 보드 id는 GameManager.RankBoardId* / RankUI.BoardId*와 같은 값(1=무제한, 2=타임어택)
		local boards = { self.RankBoardUnlimited, self.RankBoardTimeAttack }
		for _, boardId in ipairs(boards) do
			local configData = _RankingConfigDataSetLogic:GetData(boardId)
			if configData ~= nil then
				local cycleIndex = configData:GetCycleIndex(_DateTimeLogic:GetTimeElapsed())
				local entries = _RankingViewLogic:GetLiveEntriesAndWait(boardId, cycleIndex, configData)
				local limit = self.RankShowUnlimited
				if boardId == self.RankBoardTimeAttack then limit = self.RankShowTimeAttack end
				local shown = 0
				for i, e in ipairs(entries) do
					local name = tostring(e.name)
					local match = (nick == "" and shown < limit) or (nick ~= "" and name == nick)
					if match then
						shown = shown + 1
						-- 판 정보(SaveRankMeta) — 이 기능 이전에 세워진 기록은 없다(빈 칸)
						local metaRaw = ""
						if e.profileCode ~= nil and e.profileCode ~= "" then
							local code, raw = storage:GetAndWait("R:" .. tostring(boardId) .. ":" .. tostring(e.profileCode))
							if code == 0 and raw ~= nil then metaRaw = raw end
						end
						table.insert(lines, table.concat({ tostring(boardId), tostring(i), name, tostring(e.score), metaRaw }, "\t"))
					end
				end
				log(string.format("PlayLogLogic: rank lookup board=%d entries=%d shown=%d nick='%s'", boardId, #entries, shown, nick))
			end
		end
		self:ShowRankResult(nick, table.concat(lines, "\n"), userId)
	end

	@ExecSpace("Client")
	method void ShowRankResult(string nick, string raw)
		-- 저장값을 점수 / 생존 시간으로 풀어서 보여 준다
		if raw == "" then
			self:SetResult(_LocText:Resolve("MLUA_PLAYLOGLOGIC_003"))
			return
		end
		local scale = self.RankScoreTimeScale
		local groups = {}
		local order = {}
		for line in string.gmatch(raw, "[^\n]+") do
			local parts = {}
			for p in string.gmatch(line .. "\t", "([^\t]*)\t") do table.insert(parts, p) end
			local boardId = tonumber(parts[1]) or 0
			local stored = math.tointeger(tonumber(parts[4]) or 0) or 0
			local score = stored // scale
			local sec = stored % scale
			local timeText = string.format("%d:%02d:%02d", sec // 3600, (sec % 3600) // 60, sec % 60)
			if sec >= scale - 1 then timeText = timeText .. "+" end
			if groups[boardId] == nil then
				groups[boardId] = {}
				table.insert(order, boardId)
			end
			local row = string.format("%3s.  %8d   %s   %s", tostring(parts[2]), score, timeText, tostring(parts[3]))
			local metaText = self:FormatRankMeta(parts[5])
			if metaText ~= "" then row = row .. "   | " .. metaText end
			table.insert(groups[boardId], row)
		end
		local out = {}
		for _, boardId in ipairs(order) do
			local boardKey = "UI_TITLEGROUP_013"
			if boardId == self.RankBoardTimeAttack then boardKey = "UI_TITLEGROUP_012" end
			if #out > 0 then table.insert(out, "") end
			table.insert(out, _LocalizationService:GetTextFormat("FMT_PLAYLOGLOGIC_008", _LocText:Resolve(boardKey), tostring(#groups[boardId])))
			for _, row in ipairs(groups[boardId]) do table.insert(out, row) end
		end
		self:SetResult(table.concat(out, "\n"))
	end

	@ExecSpace("ClientOnly")
	method string FormatRankMeta(string raw)
		-- SaveRankMeta JSON → "에피1 · 레이온 · 이어하기 3회 · 처치 8412 · Lv 58 · 날짜" (없으면 "")
		if raw == nil or raw == "" then return "" end
		local meta = _HttpService:JSONDecode(raw)
		if meta == nil then return "" end
		local charKeys = { "MLUA_WORLDCHARACTERSELECTUI_001", "MLUA_MAP21RELICEASTEREGG_001", "MLUA_EP2MAP2ARENALOGIC_006", "MLUA_CHARACTERUNLOCKLOGIC_001", "MLUA_CHARACTERUNLOCKLOGIC_003", "MLUA_WORLDCHARACTERSELECTUI_013" }
		local ch = math.tointeger(tonumber(meta.ch) or -1) or -1
		local charName = tostring(ch)
		if charKeys[ch + 1] ~= nil then charName = _LocText:Resolve(charKeys[ch + 1]) end
		return _LocalizationService:GetTextFormat("FMT_PLAYLOGLOGIC_009", tostring(meta.ep), charName, tostring(meta.c), tostring(meta.k), tostring(meta.lv), tostring(meta.t))
	end

	@ExecSpace("ClientOnly")
	method void SetResult(string text)
		if isvalid(self.resultText) then self.resultText.Text = text end
	end

	method void OnEndPlay()
		-- 클라: 버튼 연결 해제
		if self:IsServer() then return end
		if self._openHandler and isvalid(self.openBtn) then self.openBtn.Entity:DisconnectEvent(ButtonClickEvent, self._openHandler) end
		if self._lookupHandler and isvalid(self.btnLookup) then self.btnLookup.Entity:DisconnectEvent(ButtonClickEvent, self._lookupHandler) end
		if self._recentHandler and isvalid(self.btnRecent) then self.btnRecent.Entity:DisconnectEvent(ButtonClickEvent, self._recentHandler) end
		if self._closeHandler and isvalid(self.btnClose) then self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self._closeHandler) end
		if self._submitHandler and isvalid(self.input) then self.input.Entity:DisconnectEvent(TextInputSubmitEvent, self._submitHandler) end
		if self._rankHandler and isvalid(self.btnRank) then self.btnRank.Entity:DisconnectEvent(ButtonClickEvent, self._rankHandler) end
	end

end
