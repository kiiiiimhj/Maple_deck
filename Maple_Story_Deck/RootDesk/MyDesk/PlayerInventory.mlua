@Logic
script PlayerInventory extends Logic

	@Sync
	property SyncTable<string, integer> ItemCounts

	@Sync
	property SyncTable<string, integer> AcquisitionOrder

	-- 몬스터 드랍/상점 구매로 얻는 잡템 개수. 이번 런 동안만 유지되고, 게임오버 시점에 골드로 일괄 환전된다
	-- itemId별 "처음 획득한 순번" — 인벤토리 UI가 획득한 순서대로 슬롯을 채우는 데 쓴다
	property integer _nextOrderIndex = 1

	@ExecSpace("ServerOnly")
	method void AddItem(string itemId, integer amount)
		-- 가방에 아이템을 지급한다. 존재하지 않던 itemId면 0에서부터 시작한다
		self:ReserveAcquisitionOrder(itemId)
		local current = self:GetItemCount(itemId)
		self.ItemCounts[itemId] = current + amount
		log("Inventory: " .. itemId .. " +" .. amount .. " -> " .. tostring(self.ItemCounts[itemId]))
	end

	-- 잡템을 소모한다(교환/제작 등) — amount보다 적게 가지고 있으면 아무 일도 하지 않고 false를 돌려준다.
	-- 호출측이 항상 먼저 GetItemCount로 충분한지 확인한 뒤에만 부르는 게 기본이지만, 방어적으로 다시 확인한다.
	@ExecSpace("ServerOnly")
	method boolean RemoveItem(string itemId, integer amount)
		local current = self:GetItemCount(itemId)
		if current < amount then return false end
		self.ItemCounts[itemId] = current - amount
		log("Inventory: " .. itemId .. " -" .. amount .. " -> " .. tostring(self.ItemCounts[itemId]))
		return true
	end

	@ExecSpace("ServerOnly")
	method void ReserveAcquisitionOrder(string itemId)
		-- 실제 지급(AddItem)은 드롭 연출이 도착하는 시점까지 지연되는데, 그때 순번을 매기면
		-- 나중에 죽은 몬스터의 아이템이 랜덤 딜레이가 짧아서 먼저 도착해 순서가 뒤바뀔 수 있다.
		-- 그래서 드롭이 확정되는 즉시(연출 시작 전) 순번부터 미리 예약해둔다
		if self.AcquisitionOrder[itemId] ~= nil then return end
		self.AcquisitionOrder[itemId] = self._nextOrderIndex
		self._nextOrderIndex = self._nextOrderIndex + 1
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- 인벤토리를 연 상태에서 아이템을 획득해도 실시간으로 개수가 반영되도록 알려준다
		if name == "ItemCounts" then
			_InventoryUI:NotifyInventoryChanged()
		end
	end

	method table GetOrderedItemIds()
		-- 현재 보유 중인(개수>0) 잡템 id를 "처음 획득한 순서"대로 정렬해 돌려준다
		local allIds = {
			"slime_ooze", "old_leather", "evileye_tail", "curseeye_tail",
			"snail_shell", "blue_snail_shell", "mushroom_spore", "red_snail_shell",
			"pig_tail", "jr_boogie_horn", "stump_tear", "octopus_leg", "ribbon",
			"fox_tail", "orange_mushroom_cap",
			"lorang_claw", "umti_shell", "klang_claw",
			"flying_fish", "clam_shell", "starfish_leg",
			"horned_mushroom_cap", "zombie_mushmom_spore", "bat_wing",
			"stone_golem_fragment", "dark_stone_golem_fragment", "mix_golem_piece",
			"ice_mix_golem_piece", "fairy_antenna", "royal_fairy_wing", "grey_tentacle",
			"firefly_slime_gel", "fairy_slime_gel", "water_elemental_essence",
			"tree_elemental_leaf", "mystic_wisp_dust", "lesser_spellbook_page",
			"lupin_banana", "jaguar_claw", "banana_gull_feather", "zombie_lupin_peel",
			"jr_necki_hide", "ligator_hide", "croco_hide", "swamp_mud", "sprout_mud",
			"melody_broom", "steagy_wing",
			"jr_wraith_bone", "wraith_bone", "skeledog_bone", "mummydog_bandage",
			"star_pixie_dust", "luna_pixie_moon_shard", "nepenthes_seed", "luster_pixie_wing",
			"ghost_pixie_veil", "dark_nepenthes_seed", "giant_nepenthes_seed",
			"erdas_essence",
			"unknown_ticket", "unknown_key", "unknown_medal", "tired_knight_seal",
			-- 에피소드3 map1(존1~10 = mapIndex 89~98) 신규 몬스터 10종 잡템
			"lity_fur", "dark_lity_fur", "jr_pepe_feather", "jr_yeti_snowball", "dark_jr_yeti_hide",
			"pepe_coin", "dark_pepe_beak", "hector_tail", "white_fang_tail", "whipped_cream",
			-- 에피소드3 map2(존1~10 = mapIndex 99~108) 신규 잡템(리티/다크리티/주니어예티/다크주니어예티는
			-- map1과 동일 종이라 위 아이템을 그대로 재사용)
			"paranmini_bean_jelly", "yeti_horn", "dark_yeti_horn", "yeti_pepe_ice_shard", "dark_yeti_pepe_ice_shard",
			-- 에피소드3 map3(존1~10 = mapIndex 109~118) 신규 몬스터 4종 잡템(예티류는 map2와 동일 종이라
			-- 위 아이템을 그대로 재사용)
			"werewolf_fang", "lycan_claw", "snowman_crystal", "flyeye_eyeball",
			-- 에피소드3 map4(존1~10 = mapIndex 119~128) 신규 몬스터 2종 잡템
			"reindeer_antler", "blood_reindeer_bell",
			-- 에피소드2 map2~4(55~84) / 에피소드3 히든맵(129~133) 잡템(2026-09-16 누락 수정)
			"cellion_tail", "lioner_tail", "lucida_tail",
			"jerbil_tooth", "golden_jerbil_cape", "fennec_spear", "golden_fennec_shield",
			"scorpy_helmet", "golden_scorpy_helmet", "mammoth_tail", "golden_mammoth_tusk",
			"zombie_lost_molar", "zombie_lost_gold_tooth",
			-- 실제 드롭템 없는 11종용 대체 아이콘 잡템(2026-09-16)
			"shadow_dueler_crystal", "giant_shadow_shard", "shadow_blade_orb", "oda_scout_plate",
			"jr_cellion_orb", "jr_lioner_coin", "jr_grupin_stone", "jr_lucida_coin", "tragos_stone", "capybara_crystal",
			"mimic_jar", "neon_bat_wing",
			-- 에피4 map1 이스터에그 준비 작업(Ep3Map1InvitationEasterEggLogic) 전용
			"ep4_invitation_ticket",
			-- 에피3 map3 이스터에그(Ep3Map3ItemEasterEggLogic, object-15_108 등 16개 중 매런 1개 당첨) 전용
			"ep3_map3_qualification_token",
		}
		local owned = {}
		for _, itemId in ipairs(allIds) do
			if self:GetItemCount(itemId) > 0 and self.AcquisitionOrder[itemId] ~= nil then
				table.insert(owned, { id = itemId, order = self.AcquisitionOrder[itemId] })
			end
		end
		table.sort(owned, function(a, b) return a.order < b.order end)
		local result = {}
		for _, entry in ipairs(owned) do table.insert(result, entry.id) end
		return result
	end

	method integer GetItemCount(string itemId)
		if self.ItemCounts[itemId] == nil then return 0 end
		return self.ItemCounts[itemId]
	end

	method table GetItemDef(string itemId)
		local defs = self:GetAllItemDefs()
		return defs[itemId]
	end

	method table GetAllItemDefs()
		-- 아이템 카탈로그(이름/아이콘/골드 환전가). 신규 아이템은 여기에만 등록하면 가방/상점/환전 로직이 전부 따라온다
		-- 존1~15 몬스터별 실제 메이플스토리 드롭템으로 교체(GameManager.GetMonsterLootItemId 참고) — 존16~17(그림자 존)은
		-- 야누스의 검 교환권 전용이라 이 카탈로그와 무관하다. 기존 범용 5종 중 컨셉이 맞는 것만 재사용하고
		-- (수상한 점액→슬라임, 낡은 가죽→와일드보어 계열), 나머지(마물의 뼈/몬스터 발톱)는 대응되는 실제
		-- 몬스터가 없어 폐기했다. 마정석 조각도 이블아이/커즈아이 전용 정확한 드롭템(꼬리)이 확인되어 폐기.
		--
		-- coinValue = 랭킹 점수이자 골드 환전가. 에피소드별 평균 비율은 에피1 : 에피2 : 에피3 = 1 : 1.8 : 2.6
		-- (유저 지정 2026-09-16, 보스·이스터에그 전용 잡템 제외 단순 평균 6.43 : 11.60 : 16.71 — 같은 날 잡템 풀 누락 존
		-- 실제 드롭템 13종 + 대체 아이콘 11종 + 발광 박쥐 전용 1종 추가 후 재계산). 에피3을 3.29배
		-- → 2.6배로 내려 맞췄다. 에피 신규 잡템을 추가할 땐 이 비율이 유지되도록 값을 정할 것.
		return {
			-- 재사용(기존 5종 중 컨셉이 맞는 것)
			slime_ooze = { name = "MLUA_PLAYERINVENTORY_001", icon = "0c4f4c97ae3d4e76b85dc954ee05e061", coinValue = 2 },       -- 슬라임
			old_leather = { name = "MLUA_PLAYERINVENTORY_002", icon = "7cb8bfdc6e754fcfa6b5df522c085d0d", coinValue = 4 },        -- 와일드보어/아이언호그/아이언보어/파이어보어
		
			-- 존14/15 (이블아이/커즈아이)
			evileye_tail = { name = "MLUA_PLAYERINVENTORY_003", icon = "20e1e0458ad145dfbc1dc233a9203ff7", coinValue = 6 },
			curseeye_tail = { name = "MLUA_PLAYERINVENTORY_004", icon = "32db142486e540a9b4edcd0a7fd95358", coinValue = 6 },
		
			-- 존1~3 (웨이브1~10)
			snail_shell = { name = "MLUA_PLAYERINVENTORY_005", icon = "927d463a046b48869cffa1eeaf8e3f5a", coinValue = 2 },              -- 달팽이
			blue_snail_shell = { name = "MLUA_PLAYERINVENTORY_006", icon = "949561b1a5cf40ca8de72e66b9df3e6d", coinValue = 2 },  -- 파란 달팽이
			mushroom_spore = { name = "MLUA_PLAYERINVENTORY_007", icon = "606b873258264a8291238074f707f5c3", coinValue = 2 },            -- 스포아
			red_snail_shell = { name = "MLUA_PLAYERINVENTORY_008", icon = "b0c221e18dc546f0ac516895fb5704d0", coinValue = 3 },    -- 빨간 달팽이
			pig_tail = { name = "MLUA_PLAYERINVENTORY_009", icon = "f5b37d26a2694bddac2fbdabfe3c4cec", coinValue = 3 },                  -- 돼지 / 이상한 돼지
			jr_boogie_horn = { name = "MLUA_PLAYERINVENTORY_010", icon = "9406c1bafd4f4939af1167bd73a227a1", coinValue = 4 },       -- 주니어 부기
			stump_tear = { name = "MLUA_PLAYERINVENTORY_011", icon = "2dc235bd7f664c75aea092387af57ce9", coinValue = 4 },              -- 스텀프 / 고스텀프 / 엑스텀프 / 히죽대는 고스텀프
			octopus_leg = { name = "MLUA_PLAYERINVENTORY_012", icon = "294ce4fd15bb405b8c57f0ae6f7a0bce", coinValue = 4 },           -- 옥토퍼스
			ribbon = { name = "MLUA_PLAYERINVENTORY_013", icon = "bda3fa8698e44515b7828895e3e6c3bf", coinValue = 8 },                          -- 리본 돼지(보스)
		
			-- 존4~6
			fox_tail = { name = "MLUA_PLAYERINVENTORY_014", icon = "8cbdfd31e953492fbcbd8371954c6f2d", coinValue = 3 },          -- 음흉한 여우
			orange_mushroom_cap = { name = "MLUA_PLAYERINVENTORY_015", icon = "0ed1b7cbeece48fa87e5f9ea37096d8d", coinValue = 3 },     -- 주황버섯 / 시니컬한 주황버섯
		
			-- 존11 (해변, 로랑/엄티/클랑)
			lorang_claw = { name = "MLUA_PLAYERINVENTORY_016", icon = "729b348979354dd89216a1590cffaa1b", coinValue = 5 },
			umti_shell = { name = "MLUA_PLAYERINVENTORY_017", icon = "025104e7790a4748bfbb542bc6512e82", coinValue = 5 },
			klang_claw = { name = "MLUA_PLAYERINVENTORY_018", icon = "d2f6f00b08d84f88927d2ad6c6b30683", coinValue = 5 },
		
			-- 존12 (날치/보라조개/불가사리문어 슬라임)
			flying_fish = { name = "MLUA_PLAYERINVENTORY_019", icon = "61b0ac59d5e747feb8b3155dab2b3b55", coinValue = 5 },
			clam_shell = { name = "MLUA_PLAYERINVENTORY_020", icon = "9b5407b7608942dca798829c54b7cc5c", coinValue = 5 },
			starfish_leg = { name = "MLUA_PLAYERINVENTORY_021", icon = "634164726462400d96b201432d0bfdba", coinValue = 5 },
		
			-- 존13 (뿔버섯/좀비버섯)
			horned_mushroom_cap = { name = "MLUA_PLAYERINVENTORY_022", icon = "49b3f12c200044b591eeada1ae93a38d", coinValue = 6 },
			zombie_mushmom_spore = { name = "MLUA_PLAYERINVENTORY_023", icon = "48c0812e0f8f4f77bdc850b956feeb11", coinValue = 6 },
		
			-- 존15 (박쥐, 비행형)
			bat_wing = { name = "MLUA_PLAYERINVENTORY_024", icon = "7b16a771f90e49b7a99c8c4f54e25f96", coinValue = 6 },
		
			-- 존19~22 (그룹G: 스톤골렘/다크 스톤골렘/페어리/믹스골렘/아이스 믹스골렘/로얄 페어리)
			stone_golem_fragment = { name = "MLUA_PLAYERINVENTORY_025", icon = "b1c0fd8c12b245958131db55e4d502e4", coinValue = 7 },
			dark_stone_golem_fragment = { name = "MLUA_PLAYERINVENTORY_026", icon = "3f6354432d094c199bfb2f48bda8b973", coinValue = 7 },
			mix_golem_piece = { name = "MLUA_PLAYERINVENTORY_027", icon = "591604d0287d4505aeeb3b0cee6a8ca1", coinValue = 7 },
			ice_mix_golem_piece = { name = "MLUA_PLAYERINVENTORY_028", icon = "d37cede700ac4816b0adef78be1bdb7c", coinValue = 7 },
			fairy_antenna = { name = "MLUA_PLAYERINVENTORY_029", icon = "33920cdae3ae40f6a78b8d1f149f03c2", coinValue = 7 },
			royal_fairy_wing = { name = "MLUA_PLAYERINVENTORY_030", icon = "e7e2c58d8de94196a816e04a94a59095", coinValue = 7 },
		
			-- 존21 이스터에그(뉴그레이 화이트, 외계인 습격) 전용 드롭템
			grey_tentacle = { name = "MLUA_PLAYERINVENTORY_031", icon = "a3a03dcab5bf4f669e0694baabde027c", coinValue = 10 },
		
			-- 존23~26 (그룹H: 반딧불 슬라임/페어리 슬라임/워터 엘리먼트/트리 엘리먼트/미스틱 위습/하급 마법책)
			firefly_slime_gel = { name = "MLUA_PLAYERINVENTORY_032", icon = "268e3700408e470cbce39e11e61e2f3f", coinValue = 8 },
			fairy_slime_gel = { name = "MLUA_PLAYERINVENTORY_033", icon = "10caa1f4a2644af5bc9050ccf0c3bd53", coinValue = 8 },
			water_elemental_essence = { name = "MLUA_PLAYERINVENTORY_034", icon = "11b681ebfd454ca5b773a3486bad7d05", coinValue = 8 },
			tree_elemental_leaf = { name = "MLUA_PLAYERINVENTORY_035", icon = "5e1d4e3045e34112ae743469df9b9b94", coinValue = 8 },
			mystic_wisp_dust = { name = "MLUA_PLAYERINVENTORY_036", icon = "0105f66915fe4938ba8c7713ac410982", coinValue = 8 },
			lesser_spellbook_page = { name = "MLUA_PLAYERINVENTORY_037", icon = "f63f4a7d42a54fb697f53b5608e9001d", coinValue = 8 },
		
			-- 존31~34 (그룹J: 루팡/재규어/바나나갈매기/좀비루팡)
			lupin_banana = { name = "MLUA_PLAYERINVENTORY_038", icon = "19cb5a8c16654c00bfb6d153fadece14", coinValue = 8 },
			jaguar_claw = { name = "MLUA_PLAYERINVENTORY_039", icon = "6510196b6e7442e4b0d46adba7fca98b", coinValue = 8 },
			banana_gull_feather = { name = "MLUA_PLAYERINVENTORY_040", icon = "32a4e9037d38445a994915c689051182", coinValue = 8 },
			zombie_lupin_peel = { name = "MLUA_PLAYERINVENTORY_041", icon = "cf3f13f9911f400c807ab4b1867e93ab", coinValue = 8 },
		
			-- 존36~39 (그룹K: 주니어 네키/리게이터/크로코/늪진흙괴물/새싹진흙괴물/멜러디/스티지)
			jr_necki_hide = { name = "MLUA_PLAYERINVENTORY_042", icon = "5c44b6a6385040cea09a0b3dd50884d1", coinValue = 9 },
			ligator_hide = { name = "MLUA_PLAYERINVENTORY_043", icon = "94d658f1595d47559a3a0f9c24817b71", coinValue = 9 },
			croco_hide = { name = "MLUA_PLAYERINVENTORY_044", icon = "5fd2c7faba50451f90da92bcf84dc10d", coinValue = 9 },
			swamp_mud = { name = "MLUA_PLAYERINVENTORY_045", icon = "4331d77c50d948d798d2e008dd5287b5", coinValue = 9 },
			sprout_mud = { name = "MLUA_PLAYERINVENTORY_046", icon = "a8e73ba8121046b18e761c666eef133c", coinValue = 9 },
			melody_broom = { name = "MLUA_PLAYERINVENTORY_047", icon = "5095fbc35d3f44d0a69ed5fa85d5840e", coinValue = 9 },
			steagy_wing = { name = "MLUA_PLAYERINVENTORY_048", icon = "663913cb59df4ce9af570523df0c9d18", coinValue = 9 },
		
			-- 존40~43 (그룹L: 주니어 레이스/레이스/스켈독/머미독)
			jr_wraith_bone = { name = "MLUA_PLAYERINVENTORY_049", icon = "24eaf4db239642f5bcbe794e2da8a34f", coinValue = 10 },
			wraith_bone = { name = "MLUA_PLAYERINVENTORY_050", icon = "24eaf4db239642f5bcbe794e2da8a34f", coinValue = 10 },
			skeledog_bone = { name = "MLUA_PLAYERINVENTORY_051", icon = "2202746413d64700bb6e09b6b9a8f4e0", coinValue = 10 },
			mummydog_bandage = { name = "MLUA_PLAYERINVENTORY_052", icon = "0db9f5281dc44a07a33038baaf426d66", coinValue = 10 },

			-- 존27~30 (그룹I 닌자: 쉐도우 듀어러/자이언트 쉐도우/쉐도우 블레이드/훈련된 오다군 정찰병) — 실제 메이플 드롭템이
			-- 없는 종이라 유저가 지정한 대체 아이콘 11개 중에서 분위기 맞춰 배정(2026-09-16). 값은 에피1 평균(6.43) 유지용 6~7.
