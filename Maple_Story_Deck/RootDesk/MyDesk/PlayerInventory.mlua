			ep4_invitation_ticket = { name = "MLUA_PLAYERINVENTORY_111", icon = "630fda6160a44e3b85038eee2266bba0", coinValue = 0 },
		
			-- 에피3 map3 이스터에그 전용(Ep3Map3ItemEasterEggLogic) — 위 초대권과 동일한 정책
			-- (coinValue=0 + ConvertAllToCoins 목록 포함, "다시하기" 시 초기화)
			ep3_map3_qualification_token = { name = "MLUA_PLAYERINVENTORY_112", icon = "613d49a35f90479c905e9265305a09b8", coinValue = 0 },
		}
	end

	@ExecSpace("ServerOnly")
	method void ConvertAllToCoins()
		-- 이번 런에 가방에 쌓인 잡템을 전부 골드로 환전하고 비운다.
		-- "이어하기"는 가방을 그대로 유지해야 하므로, "처음부터 다시하기"(RestartGame)에서만 호출한다
		local defs = self:GetAllItemDefs()
		local itemIds = {
			"slime_ooze", "old_leather", "evileye_tail", "curseeye_tail",
			"snail_shell", "blue_snail_shell", "mushroom_spore", "red_snail_shell",
			"pig_tail", "jr_boogie_horn", "stump_tear", "octopus_leg", "ribbon",
			"fox_tail", "orange_mushroom_cap",
			"lorang_claw", "umti_shell", "klang_claw",
			"flying_fish", "clam_shell", "starfish_leg",
			"horned_mushroom_cap", "zombie_mushmom_spore", "bat_wing",
			"stone_golem_fragment", "dark_stone_golem_fragment", "mix_golem_piece",
			"ice_mix_golem_piece", "fairy_antenna", "royal_fairy_wing", "grey_tentacle",
			"firefly_slime_gel", "fairy_slime_gel", "water_elemental_essence",
			"tree_elemental_leaf", "mystic_wisp_dust", "lesser_spellbook_page",
			"lupin_banana", "jaguar_claw", "banana_gull_feather", "zombie_lupin_peel",
			"jr_necki_hide", "ligator_hide", "croco_hide", "swamp_mud", "sprout_mud",
			"melody_broom", "steagy_wing",
			"jr_wraith_bone", "wraith_bone", "skeledog_bone", "mummydog_bandage",
			"star_pixie_dust", "luna_pixie_moon_shard", "nepenthes_seed", "luster_pixie_wing",
			"ghost_pixie_veil", "dark_nepenthes_seed", "giant_nepenthes_seed",
			"erdas_essence",
			"unknown_ticket", "unknown_key", "unknown_medal", "tired_knight_seal",
			"lity_fur", "dark_lity_fur", "jr_pepe_feather", "jr_yeti_snowball", "dark_jr_yeti_hide",
			"pepe_coin", "dark_pepe_beak", "hector_tail", "white_fang_tail", "whipped_cream",
			"paranmini_bean_jelly", "yeti_horn", "dark_yeti_horn", "yeti_pepe_ice_shard", "dark_yeti_pepe_ice_shard",
			"werewolf_fang", "lycan_claw", "snowman_crystal", "flyeye_eyeball",
			-- 에피소드3 map4(존1~10 = mapIndex 119~128) 신규 몬스터 2종 잡템
			"reindeer_antler", "blood_reindeer_bell",
			"cellion_tail", "lioner_tail", "lucida_tail",
			"jerbil_tooth", "golden_jerbil_cape", "fennec_spear", "golden_fennec_shield",
			"scorpy_helmet", "golden_scorpy_helmet", "mammoth_tail", "golden_mammoth_tusk",
			"zombie_lost_molar", "zombie_lost_gold_tooth",
			"shadow_dueler_crystal", "giant_shadow_shard", "shadow_blade_orb", "oda_scout_plate",
			"jr_cellion_orb", "jr_lioner_coin", "jr_grupin_stone", "jr_lucida_coin", "tragos_stone", "capybara_crystal",
			"mimic_jar", "neon_bat_wing",
			"ep4_invitation_ticket",
			"ep3_map3_qualification_token",
		}
		local totalValue = 0
		for _, itemId in ipairs(itemIds) do
			local count = self:GetItemCount(itemId)
			if count > 0 then
				totalValue = totalValue + count * defs[itemId].coinValue
				self.ItemCounts[itemId] = 0
				self.AcquisitionOrder[itemId] = nil
			end
		end
		self._nextOrderIndex = 1
		if totalValue > 0 then
			_GameManager:AddGold(totalValue)
			log("Inventory converted to coins: +" .. totalValue)
		end
	end

end