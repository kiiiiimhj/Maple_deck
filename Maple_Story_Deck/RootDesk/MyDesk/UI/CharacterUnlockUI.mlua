@Logic
script CharacterUnlockUI extends Logic

	property Entity popupGroup = "165adbd9-c20e-4c0b-9422-7b44e1925ac1"
	property SpriteGUIRendererComponent iconSprite = "97eaef1c-8bc4-4b51-baa1-df02ee4dfae0"
	property TextComponent nameText = "c33cd1a6-e581-4614-8769-f8e9e03296e1"
	property TextComponent descText = "5f429510-1a13-409e-9347-308a8c28aabf"
	property ButtonComponent btnAcquire = "b1db473c-60ea-4c12-aed3-e42ec5123e75"
	property ButtonComponent btnClose = "9863bb69-05e5-4a24-b8b1-5b730d3796e7"

	property any _acquireHandler = nil
	property any _closeHandler = nil
	-- Open()에서 받은 캐릭터 이름을 그대로 저장해뒀다가 획득 클릭 시 서버로 넘긴다 — 실피드는
	-- 맵21 비밀구역 탈출 이동이 따라붙고, 그 외(레이온 등)는 이미 해금 처리가 끝난 뒤 팝업만
	-- 닫으면 된다(Ep2Map2ArenaLogic 참고).
	property string _pendingCharacterName = ""

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 월드 시작 시점엔 무조건 숨겨둔다 — 이걸 빠뜨리면 이스터에그를 깨기 전에도(심지어 메인/타이틀
		-- 화면에서도) 팝업이 그냥 떠 있는 상태로 시작해버린다(유저 실측 지적).
		self.popupGroup.Enable = false
		self._acquireHandler = self.btnAcquire.Entity:ConnectEvent(ButtonClickEvent, self.OnAcquireClicked)
		-- 닫기(X)도 획득과 동일하게 처리한다 — object-236_2는 이미 사라진 뒤라 다시 눌러서 팝업을 재소환할
		-- 방법이 없다. X로 그냥 닫아버리면 실피드를 영영 못 받는 상태로 갇히므로, 안전하게 동일 취급한다.
		self._closeHandler = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, self.OnAcquireClicked)
		log("CharacterUnlockUI started")
	end

	-- Map21RelicEasterEgg / Ep2Map2ArenaLogic(둘 다 서버)가 직접 호출한다 — Client ExecSpace라
	-- 서버에서 불러도 클라이언트에서 실행된다. 아이콘/이름/설명을 파라미터로 받아 캐릭터마다
	-- 재사용한다(유저 지정: "실피드처럼 팝업 동일 이미지는 레이온").
	@ExecSpace("Client")
	method void Open(string iconRuid, string characterName, string desc)
		self._pendingCharacterName = characterName
		self.iconSprite.ImageRUID = DataRef(iconRuid)
		self.nameText.Text = characterName
		self.descText.Text = desc
		self.popupGroup.Enable = true
	end

	@ExecSpace("ClientOnly")
	method void OnAcquireClicked()
		self.popupGroup.Enable = false
		self:RequestAcquire(self._pendingCharacterName)
	end

	-- 실피드는 맵21 비밀구역이라 해금 후 탈출 이동까지 같이 처리해야 한다. 그 외 캐릭터(레이온 등)는
	-- 호출부에서 해금이 이미 끝난 뒤 팝업을 띄운 것이므로 여기서는 닫는 것 외에 할 일이 없다.
	@ExecSpace("Server")
	method void RequestAcquire(string characterName)
		if characterName == "실피드" then
			_Map21RelicEasterEgg:AcquireAndTravel()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._acquireHandler then self.btnAcquire.Entity:DisconnectEvent(ButtonClickEvent, self._acquireHandler) end
		if self._closeHandler then self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self._closeHandler) end
	end

end
