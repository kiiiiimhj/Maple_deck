@Logic
script ShadowShopUI extends Logic

	-- UI 바인딩 (클라이언트 전용)
	property Entity shopGroup = "ef5d731e-f12a-4016-8611-340f354753ac"
	property ButtonComponent btnClose = "0648b8e6-ec4b-4be0-ad94-10595c7ad586"
	property ButtonComponent btnCloseBacking = "1897883c-4c9a-4fab-91a7-e7ca0b6c3763"
	property ButtonComponent btnPurchase = "0feddb8c-2cfe-4813-ac47-c56e0f600b0a"
	property TextComponent currencyCountText = "1ff93e83-a105-49bb-9e00-142436698cb2"

	-- 상품1: 엘릭서 포션(고정), 상품2: 알 수 없는 티켓(고정), 상품3~5: 보유 스킬 중 랜덤(최대 3개)
	property ButtonComponent item1Btn = "60b8d93c-b00f-4763-afb5-bc8758908684"
	property ButtonComponent item2Btn = "79b2f0b0-ae31-451c-ab7d-9556ff68aabf"
	property ButtonComponent item3Btn = "1e01070f-d70f-47f8-b127-ece25f11ae0b"
	property ButtonComponent item4Btn = "62ee2827-c0af-44fe-98ce-ac4887a22d1f"
	property ButtonComponent item5Btn = "300837d6-66dd-40ad-922e-26cf3f27d60f"
	property SpriteGUIRendererComponent item3Icon = "bb2b6a39-8db4-4be9-b432-50bc597ffda1"
	property SpriteGUIRendererComponent item4Icon = "b30e582c-08ba-4474-b576-92dececef3e7"
	property SpriteGUIRendererComponent item5Icon = "32cbacd0-87c6-49fb-8a46-c55e2c58b932"
	property TextComponent item3Name = "e9d62e51-fa83-459d-a084-04c882224582"
	property TextComponent item4Name = "a8f7088d-6220-4bc0-9bc1-0d529794451e"
	property TextComponent item5Name = "d63862b8-c56c-42ad-9516-f040caff25da"

	property integer PotionPrice = 2
	property integer TicketPrice = 3
	property integer SkillPrice = 2

	property string PotionIconRUID = "4fd08a6fa90b45448435cf22dba91c1f"
	property string TicketIconRUID = "5d9d14a961464c0da4c2dae7ed99b8a0"
	-- 팝업이 닫힌 뒤 화면 중앙 부근에 등장해 실제 위치로 날아가는 구매 보상 연출 전용 아이콘 풀(최대 5개 동시 재생)
	property SpriteGUIRendererComponent shopRewardIcon1 = "b9b95851-a175-4d94-beed-960c69399e72"
	property SpriteGUIRendererComponent shopRewardIcon2 = "e4a5dec1-9cbf-497d-a776-cf1442f07ad0"
	property SpriteGUIRendererComponent shopRewardIcon3 = "76af1dd6-dfcb-4a62-930c-c79aa6d16ba4"
	property SpriteGUIRendererComponent shopRewardIcon4 = "980bec9b-b7ab-43d5-aeb8-28a4447c5a12"
	property SpriteGUIRendererComponent shopRewardIcon5 = "81e33600-e330-40f9-af8d-fbcf7490a543"
	-- 팝업이 열려있는 동안 클릭한 구매 건들을 쌓아뒀다가, 팝업이 닫힌 뒤 한꺼번에 연출한다
	property any _pendingRewards = nil
	-- 여러 개를 연달아 살 때 "파파파팍" 하고 순서대로 등장하도록 각 건 사이에 두는 간격(초)
	property number RewardPopStagger = 0.12

	property any _closeHandler = nil
	property any _closeBackingHandler = nil
	property any _purchaseHandler = nil
	-- 지금 선택된 아이템 슬롯(1~5) — 0이면 선택 없음. 클릭 한 번으로는 선택만 하고, 실제 구매는
	-- 구매 버튼을 눌러야 실행된다(캐릭터 선택 팝업의 "선택 후 확인" 패턴과 동일)
	property integer _selectedSlotIndex = 0
	property any _item1Handler = nil
	property any _item2Handler = nil
	property any _item3Handler = nil
	property any _item4Handler = nil
	property any _item5Handler = nil

	-- 3/4/5번 스킬 슬롯 — 이번 "런"(다시하기 전까지) 동안 고정되는 서버 권위 상태. 상점을 몇 번을
	-- 다시 열어도 재추첨되지 않고, 산 슬롯은 매진 상태로 계속 유지된다(이어하기에도 유지). 다시하기
	-- (GameManager.RestartGame → ForceReroll)에서만 초기화 + 재추첨된다.
	@Sync property integer LockedSlot3Card = 0
	@Sync property integer LockedSlot4Card = 0
	@Sync property integer LockedSlot5Card = 0
	@Sync property boolean Slot3SoldOut = false
	@Sync property boolean Slot4SoldOut = false
	@Sync property boolean Slot5SoldOut = false
	@Sync property boolean _rolledThisRun = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self.shopGroup.Enable = false
		self._closeHandler = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, self.OnCloseClicked)
		-- CloseBtnBacking(닫기 버튼 뒤에 까는 이미지, 유저가 직접 이미지/크기 커스터마이징함)도 눌렀을 때
		-- 닫기 버튼과 동일하게 팝업이 닫히도록 클릭을 연결한다
		self._closeBackingHandler = self.btnCloseBacking.Entity:ConnectEvent(ButtonClickEvent, self.OnCloseClicked)
		self._item1Handler = self.item1Btn.Entity:ConnectEvent(ButtonClickEvent, self.OnBuyPotion)
		self._item2Handler = self.item2Btn.Entity:ConnectEvent(ButtonClickEvent, self.OnBuyTicket)
		self._item3Handler = self.item3Btn.Entity:ConnectEvent(ButtonClickEvent, self.OnBuySlot3)
		self._item4Handler = self.item4Btn.Entity:ConnectEvent(ButtonClickEvent, self.OnBuySlot4)
		self._item5Handler = self.item5Btn.Entity:ConnectEvent(ButtonClickEvent, self.OnBuySlot5)
		self._purchaseHandler = self.btnPurchase.Entity:ConnectEvent(ButtonClickEvent, self.OnPurchaseClicked)
		-- CloseBtnBacking(닫기 버튼 뒤에 까는 흰 스프라이트)이 형제 엔티티라 배치 순서에 따라
		-- 버튼 위로 그려질 수 있어, 닫기 버튼을 항상 맨 앞으로 확정적으로 올려둔다
		_UILogic:SetSiblingIndex(self.btnClose.Entity.UITransformComponent, 1000000)
		-- GroupOrder만으로는 다른 UIGroup(DefaultGroup 등)보다 항상 앞에 그려진다는 보장이 없어서,
		-- 실제 렌더 순서를 결정하는 형제 인덱스를 확정적으로 맨 뒤(=맨 앞)로 올려둔다
		_UILogic:SetSiblingIndex(self.shopGroup.UITransformComponent, 1000000)
	end

	-- 상점을 여는 것 자체(팝업 표시)는 서버 상태를 바꾸지 않는 순수 UI 동작이지만, 슬롯 추첨은 이번
	-- 런에서 아직 한 번도 안 뽑았을 수 있으므로(월드 시작 후 첫 오픈) 서버에 "필요하면 추첨" 요청을
	-- 같이 보낸다 — 이미 뽑혀 있으면 서버에서 즉시 no-op하고, 화면은 지금 동기화된 값으로 우선 채운다.
	@ExecSpace("ClientOnly")
	method void Open()
		self.currencyCountText.Text = tostring(_GameManager.ShadowVoucher)
		self:RequestRollIfNeeded()
		self:RefreshSlotDisplay()
		self.shopGroup.Enable = true
		self._selectedSlotIndex = 0
		self:RefreshItemSelection()
		self:RefreshPurchaseButtonState()
	end

	@ExecSpace("Server")
	method void RequestRollIfNeeded()
		self:RollSkillSlotsIfNeeded()
	end

	@ExecSpace("ServerOnly")
	method void RollSkillSlotsIfNeeded()
		if self._rolledThisRun then return end
		self:RollSkillSlotsServer()
	end

	-- 다시하기(GameManager.RestartGame)에서만 호출 — 이미 뽑혀 있어도 강제로 초기화 후 재추첨한다.
	@ExecSpace("ServerOnly")
	method void ForceReroll()
		self._rolledThisRun = false
		self:RollSkillSlotsServer()
	end

	-- 캐릭터별 판매 후보 카드 목록 — 조합(퓨전) 결과 카드는 제외한다(아르카나가 16/17/19/20/21/23/24를
	-- 빼는 것과 동일한 규칙). 실피드는 101~113(114~120은 조합 결과라 제외), 레이온은 151~159,161~164
	-- (160 브레이브 슬래시는 브랜디쉬+리프 어택 조합 결과라 제외).
	@ExecSpace("ServerOnly")
	method table GetShopCandidates()
		if _GameManager.SelectedCharacter == 1 then
			return { 101, 102, 103, 104, 105, 106, 107, 108, 109, 110, 111, 112, 113 }
		elseif _GameManager.SelectedCharacter == 2 then
			return { 151, 152, 153, 154, 155, 156, 157, 158, 159, 161, 162, 163, 164 }
		end
		-- 22(메디테이션)는 융합 결과가 아닌 일반 패시브인데 처음 추가할 때 여기 반영을 빠뜨렸었다(유저 지적:
		-- "신규 스킬 추가하면 아이템 나오는 곳 다 추가해야지" — 신규 카드 추가 시 이 목록도 항상 같이 확인할 것)
		return { 2, 3, 4, 5, 7, 8, 9, 10, 11, 12, 13, 14, 15, 18, 22 }
	end

	@ExecSpace("ServerOnly")
	method void RollSkillSlotsServer()
		-- 현재 보유 중인 스킬(패시브 포함) 중 최대 3개를 무작위로 뽑아 3~5번 슬롯에 고정 배정한다.
		-- 보유 스킬이 3개 미만이면 남는 슬롯은 0(비활성)으로 둔다 — 무조건 3개를 채우지 않는다.
		local candidates = self:GetShopCandidates()
		local pool = {}
		for _, cardIdx in ipairs(candidates) do
			if _CardManager:IsCardUnlocked(cardIdx) then table.insert(pool, cardIdx) end
		end
		for i = #pool, 2, -1 do
			local j = math.floor(_UtilLogic:RandomDouble() * i) + 1
			local tmp = pool[i] ; pool[i] = pool[j] ; pool[j] = tmp
		end

		self.LockedSlot3Card = 0
		self.LockedSlot4Card = 0
		self.LockedSlot5Card = 0
		self.Slot3SoldOut = false
		self.Slot4SoldOut = false
		self.Slot5SoldOut = false
		if #pool >= 1 then self.LockedSlot3Card = pool[1] end
		if #pool >= 2 then self.LockedSlot4Card = pool[2] end
		if #pool >= 3 then self.LockedSlot5Card = pool[3] end
		self._rolledThisRun = true
	end

	-- LockedSlot{3,4,5}Card / Slot{3,4,5}SoldOut의 @Sync 갱신이 도착할 때마다(추첨 완료, 구매로 매진
	-- 전환) 자동으로 다시 그린다 — Open() 시점에 아직 서버 응답이 안 왔어도 곧 이걸로 채워진다.
	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		if name == "LockedSlot3Card" or name == "LockedSlot4Card" or name == "LockedSlot5Card"
			or name == "Slot3SoldOut" or name == "Slot4SoldOut" or name == "Slot5SoldOut" then
			self:RefreshSlotDisplay()
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshSlotDisplay()
		self:ApplySlotDisplay(self.LockedSlot3Card, self.Slot3SoldOut, self.item3Btn, self.item3Icon, self.item3Name)
		self:ApplySlotDisplay(self.LockedSlot4Card, self.Slot4SoldOut, self.item4Btn, self.item4Icon, self.item4Name)
		self:ApplySlotDisplay(self.LockedSlot5Card, self.Slot5SoldOut, self.item5Btn, self.item5Icon, self.item5Name)
		self:RefreshPurchaseButtonState()
	end

	@ExecSpace("ClientOnly")
	method void ApplySlotDisplay(integer cardIdx, boolean soldOut, ButtonComponent btn, SpriteGUIRendererComponent icon, TextComponent nameText)
		if cardIdx == 0 then
			btn.Entity:SetEnable(false)
			return
		end
		btn.Entity:SetEnable(true)
		icon.ImageRUID = self:GetCardIconRUID(cardIdx)
		if soldOut then
			-- 이미 구매한 슬롯 — 다시 사지 못하게 비활성화하고 매진으로 표시(콘티뉴 버튼이 재화 부족일 때
			-- 쓰는 것과 동일한 "톤 낮추고 비활성" 패턴)
			nameText.Text = "매진"
			btn.Enable = false
			icon.Color = Color(0.4, 0.4, 0.4, 1)
		else
			nameText.Text = self:GetCardName(cardIdx)
			btn.Enable = true
			icon.Color = Color(1, 1, 1, 1)
		end
	end

	@ExecSpace("ClientOnly")
	method string GetCardName(integer cardIdx)
		if cardIdx == 2 then return _CardManager.Card2Name
		elseif cardIdx == 3 then return _CardManager.Card3Name
		elseif cardIdx == 4 then return _CardManager.Card4Name
		elseif cardIdx == 5 then return _CardManager.Card5Name
		elseif cardIdx == 7 then return _CardManager.Card7Name
		elseif cardIdx == 8 then return _CardManager.Card8Name
		elseif cardIdx == 9 then return _CardManager.Card9Name
		elseif cardIdx == 10 then return _CardManager.Card10Name
		elseif cardIdx == 11 then return _CardManager.Card11Name
		elseif cardIdx == 12 then return _CardManager.Card12Name
		elseif cardIdx == 13 then return _CardManager.Card13Name
		elseif cardIdx == 14 then return _CardManager.Card14Name
		elseif cardIdx == 15 then return _CardManager.Card15Name
		elseif cardIdx == 18 then return _CardManager.Card18Name
		elseif cardIdx == 101 then return _CardManager.Card101Name
		elseif cardIdx == 102 then return _CardManager.Card102Name
		elseif cardIdx == 103 then return _CardManager.Card103Name
		elseif cardIdx == 104 then return _CardManager.Card104Name
		elseif cardIdx == 105 then return _CardManager.Card105Name
		elseif cardIdx == 106 then return _CardManager.Card106Name
		elseif cardIdx == 107 then return _CardManager.Card107Name
		elseif cardIdx == 108 then return _CardManager.Card108Name
		elseif cardIdx == 109 then return _CardManager.Card109Name
		elseif cardIdx == 110 then return _CardManager.Card110Name
		elseif cardIdx == 111 then return _CardManager.Card111Name
		elseif cardIdx == 112 then return _CardManager.Card112Name
		elseif cardIdx == 113 then return _CardManager.Card113Name
		elseif _CardRegistry:HasCard(cardIdx) then return _CardRegistry:GetName(cardIdx)
		end
		return "???"
	end

	@ExecSpace("ClientOnly")
	method string GetCardIconRUID(integer cardIdx)
		if cardIdx == 2 then return _CardManager.Card2IconRUID
		elseif cardIdx == 3 then return _CardManager.Card3IconRUID
		elseif cardIdx == 4 then return _CardManager.Card4IconRUID
		elseif cardIdx == 5 then return _CardManager.Card5IconRUID
		elseif cardIdx == 7 then return _CardManager.Card7IconRUID
		elseif cardIdx == 8 then return _CardManager.Card8IconRUID
		elseif cardIdx == 9 then return _CardManager.Card9IconRUID
		elseif cardIdx == 10 then return _CardManager.Card10IconRUID
		elseif cardIdx == 11 then return _CardManager.Card11IconRUID
		elseif cardIdx == 12 then return _CardManager.Card12IconRUID
		elseif cardIdx == 13 then return _CardManager.Card13IconRUID
		elseif cardIdx == 14 then return _CardManager.Card14IconRUID
		elseif cardIdx == 15 then return _CardManager.Card15IconRUID
		elseif cardIdx == 18 then return _CardManager.Card18IconRUID
		elseif cardIdx == 101 then return _CardManager.Card101IconRUID
		elseif cardIdx == 102 then return _CardManager.Card102IconRUID
		elseif cardIdx == 103 then return _CardManager.Card103IconRUID
		elseif cardIdx == 104 then return _CardManager.Card104IconRUID
		elseif cardIdx == 105 then return _CardManager.Card105IconRUID
		elseif cardIdx == 106 then return _CardManager.Card106IconRUID
		elseif cardIdx == 107 then return _CardManager.Card107IconRUID
		elseif cardIdx == 108 then return _CardManager.Card108IconRUID
		elseif cardIdx == 109 then return _CardManager.Card109IconRUID
		elseif cardIdx == 110 then return _CardManager.Card110IconRUID
		elseif cardIdx == 111 then return _CardManager.Card111IconRUID
		elseif cardIdx == 112 then return _CardManager.Card112IconRUID
		elseif cardIdx == 113 then return _CardManager.Card113IconRUID
		elseif _CardRegistry:HasCard(cardIdx) then return _CardRegistry:GetIcon(cardIdx)
		end
		return ""
	end

	-- 아이템을 눌러도 바로 구매하지 않고 "선택"만 한다 — 실제 구매는 구매 버튼(OnPurchaseClicked)에서
	@ExecSpace("ClientOnly")
	method void OnBuyPotion()
		self:SelectSlot(1)
	end

	@ExecSpace("ClientOnly")
	method void OnBuyTicket()
		self:SelectSlot(2)
	end

	@ExecSpace("ClientOnly")
	method void OnBuySlot3()
		self:SelectSlot(3)
	end

	@ExecSpace("ClientOnly")
	method void OnBuySlot4()
		self:SelectSlot(4)
	end

	@ExecSpace("ClientOnly")
	method void OnBuySlot5()
		self:SelectSlot(5)
	end

	@ExecSpace("ClientOnly")
	method void SelectSlot(integer slotIndex)
		self._selectedSlotIndex = slotIndex
		self:RefreshItemSelection()
		self:RefreshPurchaseButtonState()
	end

	@ExecSpace("ClientOnly")
	method ButtonComponent GetItemBtn(integer slotIndex)
		if slotIndex == 1 then return self.item1Btn
		elseif slotIndex == 2 then return self.item2Btn
		elseif slotIndex == 3 then return self.item3Btn
		elseif slotIndex == 4 then return self.item4Btn
		elseif slotIndex == 5 then return self.item5Btn
		end
		return self.item1Btn
	end

	-- 캐릭터 선택 팝업(WorldCharacterSelectUI.RefreshCharSelection)과 동일한 파란 네온 테두리 패턴
	@ExecSpace("ClientOnly")
	method void RefreshItemSelection()
		for i = 1, 5 do
			local btn = self:GetItemBtn(i)
			if isvalid(btn) then
				local sp = btn.Entity.SpriteGUIRendererComponent
				if i == self._selectedSlotIndex then
					sp.Outline = true
					sp.OutlineColor = Color(0.2, 0.6, 1.0, 0.75)
					sp.OutlineWidth = 4
				else
					sp.Outline = false
				end
			end
		end
	end

	-- 선택된 슬롯이 실제로 구매 가능한 상태인지(재화 충분 + 3~5번은 비어있지 않고 매진도 아님) 확인해서
	-- 구매 버튼의 Enable/색상을 갱신한다
	@ExecSpace("ClientOnly")
	method void RefreshPurchaseButtonState()
		local canBuy = false
		if self._selectedSlotIndex == 1 then
			canBuy = _GameManager.ShadowVoucher >= self.PotionPrice
		elseif self._selectedSlotIndex == 2 then
			canBuy = _GameManager.ShadowVoucher >= self.TicketPrice
		elseif self._selectedSlotIndex == 3 then
			canBuy = self.LockedSlot3Card ~= 0 and not self.Slot3SoldOut and _GameManager.ShadowVoucher >= self.SkillPrice
		elseif self._selectedSlotIndex == 4 then
			canBuy = self.LockedSlot4Card ~= 0 and not self.Slot4SoldOut and _GameManager.ShadowVoucher >= self.SkillPrice
		elseif self._selectedSlotIndex == 5 then
			canBuy = self.LockedSlot5Card ~= 0 and not self.Slot5SoldOut and _GameManager.ShadowVoucher >= self.SkillPrice
		end
		self.btnPurchase.Enable = canBuy
		local sprite = self.btnPurchase.Entity.SpriteGUIRendererComponent
		sprite.Color = canBuy and Color(1, 1, 1, 1) or Color(0.4, 0.4, 0.4, 1)
	end

	-- 구매 버튼을 눌렀을 때 실제로 결제+지급 예약을 실행한다(예전엔 아이템을 누르는 즉시 여기가 실행됐다)
	@ExecSpace("ClientOnly")
	method void OnPurchaseClicked()
		if self._selectedSlotIndex == 1 then
			if _GameManager.ShadowVoucher < self.PotionPrice then return end
			self:QueueReward(self.PotionIconRUID, _GameManager.HpBarFlyTargetUI, "potion", 0)
			self:RequestBuyPotion()
		elseif self._selectedSlotIndex == 2 then
			if _GameManager.ShadowVoucher < self.TicketPrice then return end
			self:QueueReward(self.TicketIconRUID, _GameManager.LootFlyTargetUI, "ticket", 0)
			self:RequestBuyTicket()
		elseif self._selectedSlotIndex == 3 then
			self:OnBuySkillSlot(self.LockedSlot3Card, self.Slot3SoldOut)
		elseif self._selectedSlotIndex == 4 then
			self:OnBuySkillSlot(self.LockedSlot4Card, self.Slot4SoldOut)
		elseif self._selectedSlotIndex == 5 then
			self:OnBuySkillSlot(self.LockedSlot5Card, self.Slot5SoldOut)
		else
			return
		end
		-- 구매 즉시 재선택하지 않으면 3~5번 매진 상태 등이 바로 반영되지 않아 보인다
		self:RefreshPurchaseButtonState()
	end

	@ExecSpace("ClientOnly")
	method void OnBuySkillSlot(integer cardIdx, boolean soldOut)
		if cardIdx == 0 or soldOut then return end
		if _GameManager.ShadowVoucher < self.SkillPrice then return end
		self:QueueReward(self:GetCardIconRUID(cardIdx), self:GetSkillFlyTargetUI(cardIdx), "skill", cardIdx)
		self:RequestBuySkill(cardIdx)
	end

	@ExecSpace("ClientOnly")
	method Vector2 GetSkillFlyTargetUI(integer cardIdx)
		-- 2~5, 9는 카드 슬롯(1~5번)에 배치되므로 그 위치로, 패시브(슬롯 없는 카드)는 화면 좌하단의
		-- 버프 아이콘(ui/DefaultGroup.ui) 위치로 보낸다. 정확한 개별 좌표 대신 근사 좌표 하나로
		-- 수렴시킨다 — 패시브는 도착 시 펀치 연출 대상에서도 제외되어(FlyRewardToTarget 참고)
		-- 정확한 착지 좌표가 크게 중요하지 않다.
		if self:IsNoSlotPassive(cardIdx) then return Vector2(-915, -320) end
		local slotIdx = _CardManager:GetSlotForCard(cardIdx)
		return _CardManager:GetSlotUIPosition(slotIdx)
	end

	@ExecSpace("ClientOnly")
	method boolean IsNoSlotPassive(integer cardIdx)
		return cardIdx == 7 or cardIdx == 8 or cardIdx == 10 or cardIdx == 18 or cardIdx == 22
			or cardIdx == 109 or cardIdx == 110 or cardIdx == 111 or cardIdx == 112 or cardIdx == 113
			or cardIdx == 151 or cardIdx == 161 or cardIdx == 162 or cardIdx == 163 or cardIdx == 164
	end

	@ExecSpace("ClientOnly")
	method void QueueReward(string iconRuid, Vector2 targetUI, string kind, integer cardIdx)
		if self._pendingRewards == nil then self._pendingRewards = {} end
		table.insert(self._pendingRewards, { icon = iconRuid, target = targetUI, kind = kind, cardIdx = cardIdx })
	end

	@ExecSpace("ClientOnly")
	method SpriteGUIRendererComponent GetRewardIcon(integer poolIndex)
		if poolIndex == 2 then return self.shopRewardIcon2
		elseif poolIndex == 3 then return self.shopRewardIcon3
		elseif poolIndex == 4 then return self.shopRewardIcon4
		elseif poolIndex == 5 then return self.shopRewardIcon5
		end
		return self.shopRewardIcon1
	end

	@ExecSpace("ClientOnly")
	method void PlayAllRewardFlourishes()
		-- 팝업이 닫힌 뒤: 산 개수만큼 "파파파팍" 순서대로 화면 중앙 부근에 등장하고, 각자 자기 목적지로 동시에 날아간다.
		-- 아이템마다 서로 다른 아이콘 슬롯 + 좌표를 써서 겹치지 않게 하고, 등장 순서가 곧 지급 순서(RequestCloseShop)와 같다
		if self._pendingRewards == nil then return end
		local count = #self._pendingRewards
		for i, reward in ipairs(self._pendingRewards) do
			local icon = self:GetRewardIcon(((i - 1) % 5) + 1)
			local spawnX = (i - (count + 1) / 2.0) * 90
			local spawnUI = Vector2(spawnX, 0)
			local popDelay = (i - 1) * self.RewardPopStagger
			_TimerService:SetTimerOnce(function()
				self:PopRewardIcon(icon, reward, spawnUI)
			end, popDelay)
		end
		self._pendingRewards = {}
	end

	@ExecSpace("ClientOnly")
	method void PopRewardIcon(SpriteGUIRendererComponent icon, any reward, Vector2 spawnUI)
		icon.ImageRUID = reward.icon
		icon.Color = Color(1, 1, 1, 1)
		icon.Entity:SetEnable(true)
		local tc = icon.Entity.UITransformComponent
		tc.anchoredPosition = spawnUI
		tc.Scale = Vector3(0.3, 0.3, 1)
		-- 등장 순간 자기 중심에서 살짝 통통 튀듯 팝(작게 시작 → 확 커졌다가 → 원래 크기로)
		_TweenLogic:PlayTween(0.3, 1.2, 0.12, EaseType.BackEaseOut, function(scale)
			if isvalid(icon) then icon.Entity.UITransformComponent.Scale = Vector3(scale, scale, 1) end
		end)
		_TimerService:SetTimerOnce(function()
			if isvalid(icon) then icon.Entity.UITransformComponent.Scale = Vector3(1, 1, 1) end
			self:FlyRewardToTarget(icon, spawnUI, reward.target, reward.kind, reward.cardIdx)
		end, 0.35)
	end

	@ExecSpace("ClientOnly")
	method void FlyRewardToTarget(SpriteGUIRendererComponent icon, Vector2 startUI, Vector2 endUI, string kind, integer cardIdx)
		if not isvalid(icon) then return end
		local duration = 0.5
		local arcHeight = 150
		_TweenLogic:PlayTween(0.0, 1.0, duration, EaseType.QuadEaseOut, function(t)
			if not isvalid(icon) then return end
			local x = startUI.x + (endUI.x - startUI.x) * t
			local y = startUI.y + (endUI.y - startUI.y) * t + math.sin(t * math.pi) * arcHeight
			icon.Entity.UITransformComponent.anchoredPosition = Vector2(x, y)
			local scale = 1.0 - 0.5 * t
			icon.Entity.UITransformComponent.Scale = Vector3(scale, scale, 1)
			icon.Color = Color(1, 1, 1, 1.0 - 0.6 * t)
		end)
		_TimerService:SetTimerOnce(function()
			if isvalid(icon) then icon.Entity:SetEnable(false) end
			-- 드롭으로 얻을 때와 동일한 도착 연출: 포션은 HP바, 티켓은 가방 아이콘을 살짝 펀치.
			-- 스킬(카드 슬롯 2/3/4/5/9)은 CardManager가 몬스터 드롭 강화 때 쓰는 것과 동일한
			-- 슬롯 확대-축소+반짝이 연출(PunchSlotScale)을 그대로 재사용한다 — 패시브(7/8/10)는
			-- 슬롯이 없어 대응되는 펀치 연출이 없으므로 대상에서 제외한다.
			if kind == "potion" then
				_GameManager:PunchHpBar()
			elseif kind == "ticket" then
				_GameManager:PunchBagIcon()
			elseif kind == "skill" then
				local slotIdx = _CardManager:GetSlotForCard(cardIdx)
				if slotIdx > 0 then _CardManager:PunchSlotScale(slotIdx) end
			end
		end, duration)
	end

	-- 팝업이 열려있는 동안 결제(화폐 차감)만 즉시 처리하고, 실제 지급(체력회복/가방/스킬강화)은
	-- 여기에 쌓아뒀다가 팝업이 닫힌 뒤(RequestCloseShop) 클라이언트 연출 도착 시점에 맞춰 적용한다
	property any _pendingGrants = nil

	@ExecSpace("ServerOnly")
	method void QueueGrant(any grant)
		if self._pendingGrants == nil then self._pendingGrants = {} end
		table.insert(self._pendingGrants, grant)
	end

	@ExecSpace("Server")
	method void RequestBuyPotion()
		if not _GameManager:SpendShadowVoucher(self.PotionPrice) then return end
		self:QueueGrant({ kind = "potion" })
	end

	@ExecSpace("Server")
	method void RequestBuyTicket()
		if not _GameManager:SpendShadowVoucher(self.TicketPrice) then return end
		self:QueueGrant({ kind = "ticket" })
	end

	@ExecSpace("Server")
	method void RequestBuySkill(integer cardIdx)
		-- 클라이언트가 보낸 cardIdx를 그대로 신뢰하지 않고, 서버가 이번 런에 실제로 고정 배정한
		-- 슬롯(LockedSlot{3,4,5}Card) 중 하나인지 + 아직 매진이 아닌지부터 확인한다. 스킬 하나당
		-- 이번 런에 딱 1번만 구매 가능 — 매진된 슬롯은 다시하기 전까지 재구매 불가.
		local matchedSlot = 0
		if cardIdx ~= 0 and cardIdx == self.LockedSlot3Card then matchedSlot = 3
		elseif cardIdx ~= 0 and cardIdx == self.LockedSlot4Card then matchedSlot = 4
		elseif cardIdx ~= 0 and cardIdx == self.LockedSlot5Card then matchedSlot = 5
		end
		if matchedSlot == 0 then return end
		if matchedSlot == 3 and self.Slot3SoldOut then return end
		if matchedSlot == 4 and self.Slot4SoldOut then return end
		if matchedSlot == 5 and self.Slot5SoldOut then return end

		if not _CardManager:IsCardUnlocked(cardIdx) then return end
		if not _GameManager:SpendShadowVoucher(self.SkillPrice) then return end

		if matchedSlot == 3 then self.Slot3SoldOut = true
		elseif matchedSlot == 4 then self.Slot4SoldOut = true
		elseif matchedSlot == 5 then self.Slot5SoldOut = true
		end

		local upgradeType = "dmg"
		if cardIdx == 3 then upgradeType = "coldbeam_up"
		elseif cardIdx == 4 then upgradeType = "thunderbolt_up"
		elseif cardIdx == 7 then upgradeType = "booster_up"
		elseif cardIdx == 8 then upgradeType = "critical_up"
		elseif cardIdx == 9 then upgradeType = "energybolt_up"
		elseif cardIdx == 10 then upgradeType = "freeze_up"
		elseif cardIdx == 11 then upgradeType = "icecutter_up"
		elseif cardIdx == 12 then upgradeType = "kingpepe_up"
		elseif cardIdx == 13 then upgradeType = "thundercutter_up"
		elseif cardIdx == 14 then upgradeType = "aquatrap_up"
		elseif cardIdx == 15 then upgradeType = "hailstone_up"
		elseif cardIdx == 18 then upgradeType = "armor_up"
		elseif cardIdx == 101 then upgradeType = "windpoem_up"
		elseif cardIdx == 102 then upgradeType = "arrowblow_up"
		elseif cardIdx == 103 then upgradeType = "icequiver_up"
		elseif cardIdx == 104 then upgradeType = "firequiver_up"
		elseif cardIdx == 105 then upgradeType = "phoenix_up"
		elseif cardIdx == 106 then upgradeType = "retreatshot_up"
		elseif cardIdx == 107 then upgradeType = "uncounterarrow_up"
		elseif cardIdx == 108 then upgradeType = "fleshmirage_up"
		elseif cardIdx == 109 then upgradeType = "bowaccel_up"
		elseif cardIdx == 110 then upgradeType = "piercingwill_up"
		elseif cardIdx == 111 then upgradeType = "criticalshot_up"
		elseif cardIdx == 112 then upgradeType = "finalattackbow_up"
		elseif cardIdx == 113 then upgradeType = "rapidfire_up"
		elseif cardIdx == 151 then upgradeType = "comboattack_up"
		elseif cardIdx == 152 then upgradeType = "slash_up"
		elseif cardIdx == 153 then upgradeType = "brandish_up"
		elseif cardIdx == 154 then upgradeType = "flashslash_up"
		elseif cardIdx == 155 then upgradeType = "charge_up"
		elseif cardIdx == 156 then upgradeType = "aurablade_up"
		elseif cardIdx == 157 then upgradeType = "ragingblow_up"
		elseif cardIdx == 158 then upgradeType = "leapattack_up"
		elseif cardIdx == 159 then upgradeType = "scarringsword_up"
		elseif cardIdx == 161 then upgradeType = "chanceattack_up"
		elseif cardIdx == 162 then upgradeType = "coma_up"
		elseif cardIdx == 163 then upgradeType = "selfrecovery_up"
		elseif cardIdx == 164 then upgradeType = "warriormastery_up"
		end
		self:QueueGrant({ kind = "skill", cardIdx = cardIdx, upgradeType = upgradeType })
	end

	-- 팝업을 닫을 때 클라이언트가 호출 — 쌓아둔 구매 건을 클라이언트 연출(등장 간격 RewardPopStagger초 +
	-- 등장 후 0.35초 대기 + 비행 0.5초)이 실제로 도착하는 시점에 맞춰 각각 지급한다
	@ExecSpace("Server")
	method void RequestCloseShop()
		if self._pendingGrants == nil then return end
		for i, grant in ipairs(self._pendingGrants) do
			local delay = (i - 1) * self.RewardPopStagger + 0.85
			_TimerService:SetTimerOnce(function()
				if isvalid(self) then self:ApplyGrant(grant) end
			end, delay)
		end
		self._pendingGrants = {}
	end

	@ExecSpace("ServerOnly")
	method void ApplyGrant(any grant)
		if grant.kind == "potion" then
			-- 엘릭서 포션: 스킬이 아니라 체력을 가득 채우는 소모품
			_GameManager:HealPlayer(_GameManager.PlayerMaxHp)
		elseif grant.kind == "ticket" then
			_PlayerInventory:AddItem("unknown_ticket", 1)
		elseif grant.kind == "skill" then
			_CardManager:ApplyCardUpgrade(grant.cardIdx, grant.upgradeType)
		end
	end

	@ExecSpace("Multicast")
	method void NotifyVoucherChanged(integer newTotal)
		-- GameManager.AddShadowVoucher/SpendShadowVoucher가 호출 — ShadowVoucher의 @Sync 전파와
		-- 이 Multicast 호출은 서로 다른 채널이라 순서 보장이 없어서, 파라미터로 직접 받은 값을 쓴다
		if not self:IsClient() then return end
		self.currencyCountText.Text = tostring(newTotal)
		_InventoryUI:NotifyInventoryChanged()
		self:RefreshPurchaseButtonState()
	end

	@ExecSpace("ClientOnly")
	method void OnCloseClicked()
		self.shopGroup.Enable = false
		self:RequestCloseShop()
		self:PlayAllRewardFlourishes()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._closeHandler then self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self._closeHandler) end
		if self._closeBackingHandler then self.btnCloseBacking.Entity:DisconnectEvent(ButtonClickEvent, self._closeBackingHandler) end
		if self._purchaseHandler then self.btnPurchase.Entity:DisconnectEvent(ButtonClickEvent, self._purchaseHandler) end
		if self._item1Handler then self.item1Btn.Entity:DisconnectEvent(ButtonClickEvent, self._item1Handler) end
		if self._item2Handler then self.item2Btn.Entity:DisconnectEvent(ButtonClickEvent, self._item2Handler) end
		if self._item3Handler then self.item3Btn.Entity:DisconnectEvent(ButtonClickEvent, self._item3Handler) end
		if self._item4Handler then self.item4Btn.Entity:DisconnectEvent(ButtonClickEvent, self._item4Handler) end
		if self._item5Handler then self.item5Btn.Entity:DisconnectEvent(ButtonClickEvent, self._item5Handler) end
	end

end
