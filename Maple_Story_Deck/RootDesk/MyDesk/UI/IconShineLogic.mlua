@Logic
script IconShineLogic extends Logic

	-- 필드 드롭 아이콘 6종(얼음 파편/허수아비/토네이도 아이템 + 버프 포션 3종)에 사선 흰 빛이 훑고 지나가는
	-- 반짝임을 반복 재생한다(유저 지정 2026-09-18, 로얄매치 뱃지 느낌). MSW에는 스프라이트 모양대로 잘리는
	-- 샤인 셰이더가 없어서, 아이콘 자식 Shine(MaskComponent — 아이콘 가운데 몸통 크기만큼, 가장자리 Softness)
	-- 안에 기울인 흰 막대(Bar)를 좌→우로 이동시킨다. 아이콘 엔티티가 켜져 있을 때만 움직인다.

	property Entity freezeShineBar = "e875d25a-8e3f-420f-9235-e69e1ac9af64"
	property Entity scarecrowShineBar = "86b0482d-794e-4831-b459-7c7bf768f910"
	property Entity bounceShineBar = "130d5109-fbd8-4fa9-9bcf-0930dec839b9"
	property Entity potionShineBar = "19a93564-64be-4b12-94a0-e195049472d2"

	-- 한 번 훑는 시간 + 다음 훑기까지 쉬는 시간, 막대 이동 범위(Shine 마스크 중심 기준 ±)
	property number SweepDuration = 0.45
	property number SweepInterval = 0.55
	property number SweepRange = 70

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 모든 막대를 같은 시계로 움직인다(아이콘이 꺼져 있으면 건너뜀)
		local period = self.SweepDuration + self.SweepInterval
		local t = _UtilLogic.ElapsedSeconds % period
		local x = self.SweepRange + 40
		if t < self.SweepDuration then
			local k = t / self.SweepDuration
			x = -self.SweepRange + 2 * self.SweepRange * k
		end
		self:MoveBar(self.freezeShineBar, x)
		self:MoveBar(self.scarecrowShineBar, x)
		self:MoveBar(self.bounceShineBar, x)
		self:MoveBar(self.potionShineBar, x)
	end

	@ExecSpace("ClientOnly")
	method void MoveBar(Entity bar, number x)
		-- 막대 하나의 가로 위치만 갱신한다
		if not isvalid(bar) then return end
		if not bar.EnabledInHierarchy then return end
		bar.UITransformComponent.anchoredPosition = Vector2(x, 0)
	end

end
