@Logic
script ShopPurchaseLogic extends Logic

	-- 상점 인앱 상품의 단일 원본.
	--
	-- id       : Maker 포털에 등록된 실제 productId(월드 아이템 ID). 2026-09-06 등록 완료.
	--            바꾸려면 포털에서 상품을 다시 만들고 여기 ID를 갈아끼워야 한다.
	-- name/desc/price : 카드에 찍히는 문구. ShopUI:ApplyProducts()가 여기서 읽어간다.
	--            price는 원화가 아니라 **월드 코인**이다 — MSW 월드 상점은 코인으로만 값을 매기고
	--            (상한 10,000), 결제창도 코인으로 뜬다. 1코인 = 7.5원이라 카드에 원화를 적어두면
	--            결제창 숫자와 어긋나 보이므로 코인으로 통일했다.
	-- diamond/coin    : 결제 성공 시 실제로 지급할 양. 표시 문구와 지급량이 갈라지지 않게 한 테이블에 같이 둔다.
	-- badge    : 우상단 배지 문구(없으면 nil). 배지 색은 .ui에 박혀 있는 순수 스타일이라 여기서 안 다룬다.
	-- bg/icon  : 카드 배경 아트와 상품 아이콘의 RUID. **상품을 따라다녀야 하는 값**이라 여기에 둔다 —
	--            스타터팩을 사면 카드가 한 칸씩 당겨지는데, 이 둘이 .ui에 박혀 있으면 글씨만 바뀌고
	--            그림은 그 자리에 남아 "다이아 300인데 스타터팩 그림"이 된다(실제로 그랬다).
	-- showSub  : 다이아 아이콘 옆에 보조 아이콘(IconSub)을 같이 띄울지. 상품 아트가 한 장에 다 담기게
	--            바뀌어서 지금은 전부 false — 카드에 덧붙일 보조 아이콘이 다시 생기면 그때 켠다.
	--
	-- 카드 순서 = ProductCard_0 ~ ProductCard_6 순서다. 항목을 늘리면 .ui의 카드와 함께
	-- ShopUI의 itemCount / scrollableRangePx도 같이 고쳐야 스크롤이 안 어긋난다.
	method table GetProducts()
		-- 상품표를 매번 새로 만들어 돌려준다(7줄짜리라 비용이 없고, OnBeginPlay 순서에 안 얽힌다)
		return {
			-- 골드는 인게임에서 넘쳐서(보유 900만 규모) 유료 상품 가치가 없다는 판단으로 뺐다.
			-- 대신 유료 전용 코스메틱인 대미지 스킨(구미호)을 끼워준다 — 상점에서는 안 파는 전용 보상
			-- 이 항목만 상품 타입이 PASS다. PASS는 엔진이 계정당 1회 구매를 강제하므로
			-- "1회 한정"이 상점 단계에서 보장된다(ITEM이었다면 몇 번이든 다시 살 수 있었다).
			-- bg도 이 항목만 다른 아트(iap_bg)를 쓴다 — 나머지는 전부 iap_bg_2.
			{ id = "0M79W2RB9", name = "스타터 패키지", desc = "다이아 500\n구미호 대미지 스킨", price = "160 코인",    diamond = 500,  coin = 0, skin = "gumiho", badge = "1회 한정", showSub = false, bg = "7288e1aee7344cf2b859a5885ad29c36", icon = "6f47aba257d94d6eb64945c6aaf406fd" },
			{ id = "72AXY5T77", name = "다이아 300",   desc = "",                            price = "440 코인",    diamond = 300,  coin = 0, badge = nil,        showSub = false, bg = "93b3a76ac0d64ab3816ccb43573aed46", icon = "7f6f95fcfe0648efbb991fba1d615f1b" },
			{ id = "ZS4B71VTC", name = "다이아 600",   desc = "",                            price = "880 코인",    diamond = 600,  coin = 0, badge = nil,        showSub = false, bg = "93b3a76ac0d64ab3816ccb43573aed46", icon = "30bc9296c38a4e6c992af828ad001252" },
			{ id = "X1B3IBVJV", name = "다이아 1,300", desc = "보너스 100 포함",             price = "1,760 코인",  diamond = 1300, coin = 0, badge = "+8%",      showSub = false, bg = "93b3a76ac0d64ab3816ccb43573aed46", icon = "4c4b8fa5038c4aa7a95ef21719bcca25" },
			{ id = "4MHFHQ3AW", name = "다이아 2,800", desc = "보너스 300 포함",             price = "3,480 코인",  diamond = 2800, coin = 0, badge = "+12%",     showSub = false, bg = "93b3a76ac0d64ab3816ccb43573aed46", icon = "2d30ba6e3c73414dafc4332a10e1a2f1" },
			{ id = "XPFIAW027", name = "다이아 6,500", desc = "보너스 1,100 포함",           price = "7,880 코인",  diamond = 6500, coin = 0, badge = "+20%",     showSub = false, bg = "93b3a76ac0d64ab3816ccb43573aed46", icon = "69fcac87cfca413e8a162b0aa3ed4c7a" },
			-- 최상위 티어. 포털 가격 상한이 10,000코인이라 원래 계획한 다이아 10,000(11,867코인 필요)은
			-- 등록 자체가 안 된다. 상한에 맞춰 10,000코인으로 두고 지급량을 8,500으로 잡았다 —
			-- 기본 6,800 + 보너스 1,700이라 배지 +25%가 기준가(다이아 300) 대비 정확히 맞는다
			{ id = "X7V6M0VVZ", name = "다이아 8,500", desc = "보너스 1,700 포함",           price = "10,000 코인", diamond = 8500, coin = 0, badge = "+25%",     showSub = false, bg = "93b3a76ac0d64ab3816ccb43573aed46", icon = "427df8aa4e9a47d1a5b7fd762133d86f" },
		}
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 결제가 승인되면 엔진이 ProcessPurchase를 부른다. true를 돌려줘야 결제가 확정되고,
		-- false면 결제가 취소 처리되므로 지급에 실패했을 때만 false를 준다
		_WorldShopService:SetProcessPurchaseCallback(self.ProcessPurchase)
		log("ShopPurchaseLogic: purchase callback registered")
	end

	method string GetStarterProductId()
		-- 스타터 패키지(PASS)의 productId. 카드 0번 = 상품표 1번이 항상 스타터다
		return self:GetProducts()[1].id
	end

	@ExecSpace("Server")
	method void RequestStarterOwned()
		-- 클라가 상점을 열 때 부른다. 보유 조회(UserHasPassAndWait)는 Yield 호출이고 유저 신원이
		-- 필요한데, senderUserId는 엔진이 채워주는 값이라 클라가 위조할 수 없다 — 그래서 서버에서 묻는다
		local owned = _WorldShopService:UserHasPassAndWait(senderUserId, self:GetStarterProductId())
		log("ShopPurchaseLogic: starter pass owned=" .. tostring(owned) .. " user=" .. senderUserId)
		self:ReplyStarterOwned(owned, senderUserId)
	end

	@ExecSpace("Client")
	method void ReplyStarterOwned(boolean owned)
		-- 물어본 그 클라이언트에게만 돌아온다(호출부에서 마지막 인자로 UserId를 넘겼다)
		_ShopUI:SetStarterOwned(owned)
	end

	-- 인자 타입을 WorldShopPurchaseInfo로 못 적는다(@Misc 타입이라 'type is unavailable' 컴파일 에러).
	-- any로 받고 필드(.ProductId / .UserId)만 읽는다
	method boolean ProcessPurchase(any info)
		-- 결제 성공 콜백(서버). productId로 상품표를 뒤져 해당하는 재화를 지급한다.
		-- 모르는 productId면 지급할 게 없으므로 false를 반환해 결제를 확정하지 않는다

		-- 구매자가 아직 월드에 없으면 지급을 미룬다. false를 돌려주면 엔진이 다음 입장 때 이 콜백을
		-- 다시 부르므로 결제가 사라지지 않는다. 이 가드가 없으면 GameManager가 DataStorage에서 잔액을
		-- 읽어오기 전에 AddDiamond가 끼어들어, 뒤늦게 도착한 로드 값이 지급분을 덮어쓸 수 있다
		local userEntity = _UserService:GetUserEntityByUserId(info.UserId)
		if not isvalid(userEntity) then
			log_error("ShopPurchaseLogic: user entity not found, deferring grant. userId=" .. info.UserId)
			return false
		end

		local products = self:GetProducts()
		for i = 1, #products do
			local p = products[i]
			if p.id == info.ProductId then
				if p.diamond > 0 then _GameManager:AddDiamond(p.diamond) end
				if p.coin > 0 then _GameManager:AddCoins(p.coin) end
				if p.skin ~= nil then _DamageSkinLogic:GrantSkin(p.skin) end
				-- 스타터팩을 방금 샀으면 상점을 다시 열지 않아도 카드가 바로 "구매 완료"로 바뀌게 한다.
				-- (엔진의 재구매 차단과 별개로, 화면이 옛 상태로 남아 있는 걸 막는 용도)
				if p.id == self:GetStarterProductId() then self:ReplyStarterOwned(true, info.UserId) end
				-- 구매 이력을 남긴다. 환불 요청이 들어오면 이 기록으로 주문을 확인해야 하므로
				-- 유료 상품에는 필수다(@ReleaseOnly라 Maker 테스트 구매에서는 아무 일도 하지 않는다)
				_LogStorageService:LogPurchaseInfo(info, "granted " .. p.id)
				log("ShopPurchaseLogic: granted " .. p.id .. " (diamond=" .. p.diamond .. ", coin=" .. p.coin .. ", skin=" .. tostring(p.skin) .. ") user=" .. info.UserId)
				return true
			end
		end

		log_error("ShopPurchaseLogic: unknown productId '" .. info.ProductId .. "' — purchase not granted")
		return false
	end

end
