@Logic
script RankUI extends Logic

	-- 로비(TitleGroup.ui) 랭킹 탭 화면.
	--
	-- 레이아웃은 전부 .ui 하이라키에 실제 엔티티로 만들어져 있고(RankPanel/Tabs, RankPanel/Board/...),
	-- 이 스크립트는 값만 채운다 — 이미지/크기/폰트/색은 Maker 하이라키에서 직접 수정하면 된다.
	-- 4~100위 목록은 GridView가 RowTemplate 하나를 복제해 채우므로, 행 디자인을 바꾸고 싶으면
	-- RankPanel/Board/ListArea/RowTemplate 하나만 고치면 전체에 반영된다.

	property Entity rankPanel = "06fe7223-8b8e-403a-a901-295fcdda2a77"

	property ButtonComponent tabUnlimited = "b4ce6bf5-e92e-479d-8783-34080848824b"
	property ButtonComponent tabTimeAttack = "02564745-7f21-47af-aeef-2c08bd7e9453"
	property TextComponent tabUnlimitedLabel = "37a7365e-1424-435a-bcce-fe816903a99f"
	property TextComponent tabTimeAttackLabel = "ded1412e-795a-46ef-a858-82787b61348b"

	property GridViewComponent listArea = "f5830545-edb1-43a6-bcee-c3e633cbb41c"
	property Entity rowTemplate = "927dad8f-69f8-4235-909e-7c418535fcb5"
	property SliderComponent scrollBar = "e978609f-86a6-4de5-a0ca-a5b3c5d84217"

	property Entity medalRow1 = "d7689069-b5a6-4d9a-bc3d-b67ab8984a82"
	property Entity medalRow2 = "b78cffb5-3763-4cc6-a938-d49dd948945b"
	property Entity medalRow3 = "c7c7daf4-080a-417b-ab6d-cd41d941dc60"
	property Entity myRankRow = "33c462ee-8288-4045-8059-a1450d66b5d5"
	property Entity emptyText = "5aade462-f3ef-44e5-af91-97e11385b98d"

	-- RankingConfigDataSet.csv의 Id 열과 일치해야 한다(GameManager의 RankBoardId* 와도 동일)
	property integer BoardIdUnlimited = 1
	property integer BoardIdTimeAttack = 2
	-- GameManager:EncodeRankScore가 하위 4자리에 생존 초를 넣어 저장한다 — 표시할 땐 이 값으로 나눈다
	property integer RankScoreTimeScale = 10000
	property integer ViewCount = 100
	-- 기록이 적어도 목록은 최소 이 순위까지 빈 칸으로 채운다(유저 지정 2026-10-06 "20등까지는 칸이 있어야")
	property integer MinRows = 20

	-- 선택된 탭 색 (하이라키에서 색을 바꾸고 싶으면 이 값을 고치면 된다)
	property Color TabOnColor = Color(0.85, 0.63, 0.24, 1)
	property Color TabOffColor = Color(0.34, 0.21, 0.11, 1)

	-- 서버가 "아직 준비 안 됨"(myRank=-1)을 보냈을 때 다시 물어보는 간격/횟수.
	-- 로비 진입 직후엔 플레이어 DB 로드가 안 끝나 있어서 첫 요청이 이 경로를 탄다
	property number RetryDelaySeconds = 1.0
	property integer MaxRetryCount = 10
	property integer _retryCount = 0

	property integer _boardId = 1
	-- 4위 이하만 담긴 목록 (1~3위는 위쪽 메달 고정행이 따로 표시한다)
	property table _restList = {}

	property any _tabUnlimitedHandler = nil
	property any _tabTimeAttackHandler = nil
	property any _sliderHandler = nil
	property any _gridHandler = nil

	-- UIGridScrollBar와 같은 echo 상쇄 카운터. "값이 얼마나 다른가"가 아니라 "내가 보낸 게 몇 개
	-- 아직 안 돌아왔는가"로 거른다 — 값 비교 방식은 늦게 도착한 echo를 진짜 변경으로 오인해 핸들이
	-- 튀는 문제가 이 프로젝트에서 이미 확인됐다(UIGridScrollBar 주석 참고).
	property integer _pendingFromSlider = 0
	property integer _pendingFromGrid = 0
	property number _lastScrollValue = 0

	-- ── 주간 시즌 + 시즌 보상(2026-10-06, 서버는 RankSeasonLogic) ──
	property TextGUIRendererComponent seasonText = "89080adb-b133-4d2a-8a4c-9767757c0436"
	-- 받기 버튼은 내 순위 줄 보상 칸 자리(MyRankRow/ClaimButton) — 유저 지정, 다이아 개수 표시 없음.
	-- .ui에서는 켜 둬서 에디터에서 보이고, 실행하면 OnBeginPlay가 숨긴다
	property ButtonComponent seasonClaimButton = "edba9cba-0d47-4e27-9719-d67762c0c823"
	-- 버튼 글자 "받기" (MyRankRow/ClaimButton/Label)
	property TextGUIRendererComponent seasonClaimRankText = "080d2b35-785d-40b8-8ebb-b96392245113"
	-- 보상이 보일 때의 내 순위(받기 버튼이 사라지면 보상 칸을 다시 그릴 때 쓴다)
	property integer _myRewardRank = 0
	property string DiamondIconRUID = "81462aeb825b4660991cef05651271cf"
	property integer KstOffsetMs = 32400000
	property integer WeekMs = 604800000
	-- 게임 시작 때 시즌 상태 응답을 이 시간 안에 못 받으면 묻지 않고 진행한다
	property number SeasonReplyTimeout = 2.0
	-- 보드 → { season, rank, amount } (받을 보상이 남은 보드만)
	property table _seasonPending = {}
	property integer _seasonEndMs = 0
	-- 서버 시각 - 내 기기 시각(남은 시간 계산을 서버 기준으로)
	property integer _clockOffsetMs = 0
	property boolean _claimSent = false
	-- 받았지만 아직 날리지 않은 다이아(랭킹 탭을 나가 로비로 갈 때 날린다)
	property integer _flyPendingDiamond = 0
	property integer _seasonTimerId = 0
	property any _claimHandler = nil
	property integer _seasonSeq = 0
	property any _seasonProceed = nil
	property integer _seasonTimeoutId = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self._boardId = self.BoardIdUnlimited

		self._tabUnlimitedHandler = self.tabUnlimited.Entity:ConnectEvent(ButtonClickEvent, function() self:SelectBoard(self.BoardIdUnlimited) end)
		self._tabTimeAttackHandler = self.tabTimeAttack.Entity:ConnectEvent(ButtonClickEvent, function() self:SelectBoard(self.BoardIdTimeAttack) end)

		-- GridView는 RowTemplate을 복제해서 보이는 만큼만 그린다. index는 0-based로 들어온다.
		self.listArea.ItemEntity = self.rowTemplate
		self.listArea.OnRefresh = function(index, entity) self:OnRowRefresh(index + 1, entity) end
		self.listArea.TotalCount = 0

		self._sliderHandler = self.scrollBar.Entity:ConnectEvent(SliderValueChangedEvent, self.OnSliderChanged)
		self._gridHandler = self.listArea.Entity:ConnectEvent(ScrollPositionChangedEvent, self.OnGridScrolled)

		self:RefreshTabVisual()
		self:ClearRows()

		if isvalid(self.seasonClaimButton) then
			self.seasonClaimButton.Entity.Enable = false
			self._claimHandler = self.seasonClaimButton.Entity:ConnectEvent(ButtonClickEvent, function() self:OnSeasonClaimClicked() end)
		end
		-- 남은 시간 문구는 랭킹 탭이 보일 때만 1초마다 다시 쓴다
		self._seasonTimerId = _TimerService:SetTimerRepeat(function()
			if isvalid(self) and isvalid(self.rankPanel) and self.rankPanel.EnabledInHierarchy then self:RefreshSeasonText() end
		end, 1)
		self:RefreshSeasonText()
		log("RankUI started")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._tabUnlimitedHandler then self.tabUnlimited.Entity:DisconnectEvent(ButtonClickEvent, self._tabUnlimitedHandler) end
		if self._tabTimeAttackHandler then self.tabTimeAttack.Entity:DisconnectEvent(ButtonClickEvent, self._tabTimeAttackHandler) end
		if self._sliderHandler then self.scrollBar.Entity:DisconnectEvent(SliderValueChangedEvent, self._sliderHandler) end
		if self._gridHandler then self.listArea.Entity:DisconnectEvent(ScrollPositionChangedEvent, self._gridHandler) end
		if self._claimHandler and isvalid(self.seasonClaimButton) then self.seasonClaimButton.Entity:DisconnectEvent(ButtonClickEvent, self._claimHandler) end
		if self._seasonTimerId ~= 0 then _TimerService:ClearTimer(self._seasonTimerId) end
		if self._seasonTimeoutId ~= 0 then _TimerService:ClearTimer(self._seasonTimeoutId) end
	end

	-- TitleUI가 랭킹 탭을 눌렀을 때 호출 — 현재 선택된 보드를 서버에 다시 요청한다.
	@ExecSpace("ClientOnly")
	method void Open()
		self:Request()
		self:RefreshSeasonText()
		_RankSeasonLogic:RequestStatus(0)
	end

	-- ── 시즌 ────────────────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void OnSeasonStatus(table pending, integer season, integer endMs, integer nowMs, integer seq)
		-- 서버(RankSeasonLogic.PushStatus) 응답 — 받을 보상 목록 + 이번 시즌 끝나는 시각
		self._seasonPending = {}
		if pending ~= nil then
			for _, p in ipairs(pending) do
				self._seasonPending[p.board] = { season = p.season, rank = p.rank, amount = p.amount }
			end
		end
		self._seasonEndMs = endMs
		self._clockOffsetMs = nowMs - DateTime.UtcNow.Elapsed
		self._claimSent = false
		log("RankUI: season status season=" .. tostring(season) .. " pending=" .. tostring(pending and #pending or 0) .. " seq=" .. tostring(seq))
		self:RefreshSeasonText()
		self:RefreshClaim()
		-- 게임 시작 버튼이 기다리던 응답이면 여기서 이어간다
		if seq ~= 0 and seq == self._seasonSeq and self._seasonProceed ~= nil then
			self:ResolveSeasonCheck(pending ~= nil and #pending > 0)
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshSeasonText()
		-- "시즌 기간 10.05 ~ 10.11 / 남은 시간 4일 12시간" (날짜는 한국 시간 기준)
		if not isvalid(self.seasonText) then return end
		local now = DateTime.UtcNow.Elapsed + self._clockOffsetMs
		local endMs = self._seasonEndMs
		if endMs <= now then
			endMs = _RankSeasonLogic:GetSeasonEndMs(_RankSeasonLogic:GetSeasonIndex(now))
			self._seasonEndMs = endMs
		end
		local startDay = DateTime(endMs - self.WeekMs + self.KstOffsetMs)
		local lastDay = DateTime(endMs - 1 + self.KstOffsetMs)
		local period = _LocalizationService:GetTextFormat("FMT_RANKSEASON_001",
			string.format("%02d.%02d", startDay.Month, startDay.Day), string.format("%02d.%02d", lastDay.Month, lastDay.Day))
		local left = math.max(0, endMs - now) // 1000
		local remain = ""
		if left >= 86400 then
			remain = _LocalizationService:GetTextFormat("FMT_RANKSEASON_002", tostring(left // 86400), tostring((left % 86400) // 3600))
		else
			remain = _LocalizationService:GetTextFormat("FMT_RANKSEASON_003", tostring(left // 3600), tostring((left % 3600) // 60))
		end
		-- 알림판 위에는 기간, 아래에는 남은 시간을 표시한다. 기존 번역/시즌 계산과 텍스트 바인딩을 유지한다.
		local periodText = self.seasonText.Entity:GetChildByName("Period", false)
		if isvalid(periodText) then
			periodText.TextGUIRendererComponent.Text = period
			self.seasonText.Text = remain
		else
			self.seasonText.Text = period .. "\n" .. remain
		end
		if left < 86400 then
			self.seasonText.FontColor = Color(1, 0.76, 0.42, 1)
		else
			self.seasonText.FontColor = Color(1, 0.95, 0.82, 1)
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshClaim()
		-- 지금 보고 있는 보드에 받을 보상이 있을 때만 받기 버튼을 보인다(평소엔 숨김)
		if not isvalid(self.seasonClaimButton) then return end
		local p = self._seasonPending[self._boardId]
		self.seasonClaimButton.Entity.Enable = (p ~= nil)
		-- 버튼이 보상 칸 자리를 쓰므로, 버튼이 있으면 칸을 숨기고 없으면 다시 그린다
		self:SetRewardCell(self.myRankRow, self._myRewardRank)
		if p == nil then return end
		-- 버튼 글자는 "받기"만(유저 지정) — 번역 키 그대로
		if isvalid(self.seasonClaimRankText) then self.seasonClaimRankText.Text = "UI_TITLEGROUP_RANK_CLAIM" end
	end

	@ExecSpace("ClientOnly")
	method void OnSeasonClaimClicked()
		if self._claimSent or self._seasonPending[self._boardId] == nil then return end
		self._claimSent = true
		log("RankUI: season claim requested board=" .. tostring(self._boardId))
		_RankSeasonLogic:RequestClaim(self._boardId)
	end

	@ExecSpace("ClientOnly")
	method void OnSeasonClaimResult(integer boardId, integer amount)
		-- 서버는 이미 다이아를 넣었다. 숫자는 보류해 두고 로비로 나갈 때 날려 보낸다(유저 지정)
		self._claimSent = false
		if amount <= 0 then
			log("RankUI: season claim rejected board=" .. tostring(boardId))
			return
		end
		_RewardFlyUI:Hold("diamond", amount)
		self._flyPendingDiamond = self._flyPendingDiamond + amount
		self._seasonPending[boardId] = nil
		self:RefreshClaim()
		log("RankUI: season reward claimed board=" .. tostring(boardId) .. " +" .. tostring(amount))
	end

	@ExecSpace("ClientOnly")
	method void FlushRewardFly()
		-- TitleUI가 랭킹 탭에서 다른 탭으로 바꿀 때 부른다 — 화면 가운데에서 다이아가 배지로 날아간다
		if self._flyPendingDiamond <= 0 then return end
		local amount = self._flyPendingDiamond
		self._flyPendingDiamond = 0
		_RewardFlyUI:Fly("diamond", amount, self.DiamondIconRUID, Vector2(0, 0), 0)
		log("RankUI: season reward fly " .. tostring(amount))
	end

	@ExecSpace("ClientOnly")
	method void CheckSeasonThen(any proceed)
		-- 게임 시작 버튼: 받을 시즌 보상이 있으면 먼저 묻는다. [예] → 랭킹 탭(보상 있는 보드), [아니오] → 그대로 시작
		if self._seasonProceed ~= nil then return end
		self._seasonProceed = proceed
		self._seasonSeq = self._seasonSeq + 1
		local seq = self._seasonSeq
		_RankSeasonLogic:RequestStatus(seq)
		if self._seasonTimeoutId ~= 0 then _TimerService:ClearTimer(self._seasonTimeoutId) end
		self._seasonTimeoutId = _TimerService:SetTimerOnce(function()
			self._seasonTimeoutId = 0
			if not isvalid(self) or self._seasonSeq ~= seq or self._seasonProceed == nil then return end
			log("RankUI: season status timeout, proceeding")
			self:ResolveSeasonCheck(false)
		end, self.SeasonReplyTimeout)
	end

	@ExecSpace("ClientOnly")
	method void ResolveSeasonCheck(boolean hasPending)
		local proceed = self._seasonProceed
		self._seasonProceed = nil
		if self._seasonTimeoutId ~= 0 then
			_TimerService:ClearTimer(self._seasonTimeoutId)
			self._seasonTimeoutId = 0
		end
		if not hasPending then
			if proceed ~= nil then proceed() end
			return
		end
		_RunStartConfirmUI:ShowCustom(
			_LocalizationService:GetText("MLUA_RANKSEASON_001"),
			_LocalizationService:GetText("MLUA_RANKSEASON_002"),
			"UI_EQUIPMENTGROUP_009", "UI_EQUIPMENTGROUP_008",
			function() self:OpenForClaim() end,
			function() if proceed ~= nil then proceed() end end)
	end

	@ExecSpace("ClientOnly")
	method void OpenForClaim()
		-- [예] — 랭킹 탭을 열고, 보상이 있는 보드를 보여준다
		local board = self._boardId
		if self._seasonPending[board] == nil then
			for id, _ in pairs(self._seasonPending) do board = id break end
		end
		_TitleUI:ShowTab("rank")
		if board ~= self._boardId then
			self:SelectBoard(board)
			self:RefreshSeasonText()
		else
			self:Open()
		end
		self:RefreshClaim()
	end

	@ExecSpace("ClientOnly")
	method void SetRewardCell(Entity row, integer rank)
		-- 행의 보상 칸(다이아 + 오른쪽 아래 "2k"). rank 0 = 보상 표시 안 함
		if not isvalid(row) then return end
		local cell = row:GetChildByName("Reward")
		if not isvalid(cell) then return end
		local amount = _RankSeasonLogic:GetRewardForRank(rank)
		if row == self.myRankRow then
			self._myRewardRank = rank
			-- 받기 버튼이 떠 있으면 그 자리를 버튼이 쓴다
			if isvalid(self.seasonClaimButton) and self.seasonClaimButton.Entity.Enable then amount = 0 end
		end
		cell.Enable = amount > 0
		if amount <= 0 then return end
		local amountText = cell:GetChildByName("Amount")
		if isvalid(amountText) then amountText.TextGUIRendererComponent.Text = "x" .. self:FormatShort(amount) end
	end

	@ExecSpace("ClientOnly")
	method string FormatShort(integer n)
		-- 2000 → "2k", 1500 → "1.5k", 500 → "500" (유저 지정)
		if n >= 1000 then
			if n % 1000 == 0 then return tostring(n // 1000) .. "k" end
			return string.format("%.1fk", n / 1000)
		end
		return tostring(n)
	end

	@ExecSpace("ClientOnly")
	method void SelectBoard(integer boardId)
		-- 상단 탭(무제한/타임어택) 전환
		if self._boardId == boardId then return end
		self._boardId = boardId
		self._retryCount = 0
		self:RefreshClaim()
		self:RefreshTabVisual()
		self:ClearRows()
		self:Request()
		log("RankUI: board switched to " .. tostring(boardId))
	end

	@ExecSpace("ClientOnly")
	method void RefreshTabVisual()
		-- 선택 탭은 초록색 아트, 나머지는 나무 아트로 구분한다. 리소스의 원래 색을 유지한다.
		local selected = (self._boardId == self.BoardIdUnlimited)
		local a = self.tabUnlimited.Entity.SpriteGUIRendererComponent
		local b = self.tabTimeAttack.Entity.SpriteGUIRendererComponent
		a.ImageRUID = DataRef(selected and "0cfbd6e3aa6845abb4a42659d01b6078" or "df45bdb1640949c9b5269bbd4cee7a66")
		b.ImageRUID = DataRef(selected and "df45bdb1640949c9b5269bbd4cee7a66" or "0cfbd6e3aa6845abb4a42659d01b6078")
		a.Color = Color(1, 1, 1, 1)
		b.Color = Color(1, 1, 1, 1)
	end

	@ExecSpace("ClientOnly")
	method void Request()
		-- 서버에 상위 100명 + 내 기록을 요청한다. 응답은 RankingViewLogic이 SetRanking으로 돌려준다.
		_RankingViewLogic:RequestDataListWithUserData(self._boardId, 1, self.ViewCount)
		log("RankUI: requested boardId=" .. tostring(self._boardId))
	end

	-- 서버 응답 진입점 (RankingViewLogic:ResponseDataListWithUserData가 호출)
	-- rows: { { rank, name, score }, ... } 순수 테이블. @Struct는 RPC로 못 넘기므로 서버가 펼쳐서 보낸다.
	-- myRank 0 = 상위 목록 밖이라 순위 미상 / myScore 0 = 아직 기록 없음
	@ExecSpace("ClientOnly")
	method void SetRanking(integer id, table rows, integer myRank, integer myScore)
		-- 탭을 빠르게 여러 번 눌러 이전 보드의 응답이 늦게 도착한 경우는 버린다
		if id ~= self._boardId then
			log("RankUI: stale response ignored (id=" .. tostring(id) .. ")")
			return
		end

		-- 서버가 "아직 플레이어 DB 로딩 중"이라고 답한 경우 — 화면을 건드리지 않고 잠시 뒤 다시 요청한다.
		-- 로비에 들어가자마자 랭킹 탭을 열면 이 경로를 탄다
		if myRank < 0 then
			if self._retryCount >= self.MaxRetryCount then
				log("RankUI: give up retrying (id=" .. tostring(id) .. ")")
				return
			end
			self._retryCount = self._retryCount + 1
			log("RankUI: server not ready, retry #" .. tostring(self._retryCount))
			_TimerService:SetTimerOnce(function()
				if isvalid(self) and self._boardId == id then self:Request() end
			end, self.RetryDelaySeconds)
			return
		end
		self._retryCount = 0

		local count = 0
		if rows ~= nil then count = #rows end
		log(string.format("RankUI: SetRanking id=%d count=%d myRank=%d", id, count, myRank))

		-- 1~3위는 메달 고정행에
		self:SetMedalRow(self.medalRow1, rows, 1)
		self:SetMedalRow(self.medalRow2, rows, 2)
		self:SetMedalRow(self.medalRow3, rows, 3)

		-- 4위 이하는 스크롤 목록에. 기록이 모자라도 MinRows위까지는 빈 칸("-" + 그 순위 보상)을 깐다(유저 지정)
		self._restList = self:BuildRestList(rows)
		local rest = self._restList
		self.listArea.TotalCount = #rest
		-- 목록 자체가 바뀌는 갱신이므로 resetPos와 force를 같은 값으로 묶는다
		-- (둘을 다르게 주면 이전 내용이 남거나 플리커가 생긴다 — UIInventoryGrid 주석 참고)
		self.listArea:Refresh(true, true)
		self:SyncSliderFromGrid()

		self:SetMyRow(myRank, myScore, count)

		-- 빈 칸이 항상 깔리므로 "아직 기록 없음" 문구는 쓰지 않는다
		if isvalid(self.emptyText) then
			self.emptyText.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method table BuildRestList(table rows)
		-- 4위부터의 목록 + 모자라면 MinRows위까지 빈 칸(empty=true)
		local rest = {}
		local lastRank = 3
		if rows ~= nil then
			for i = 4, #rows do
				rest[#rest + 1] = rows[i]
				lastRank = math.max(lastRank, rows[i].rank)
			end
		end
		for r = math.max(lastRank, #rest + 3) + 1, self.MinRows do
			rest[#rest + 1] = { rank = r, empty = true }
		end
		return rest
	end

	@ExecSpace("ClientOnly")
	method void SetMedalRow(Entity row, table rows, integer index)
		-- 상위 3위 고정행 하나를 채운다. 해당 순위가 비어 있으면 이름/점수만 "-"로 두고 행은 남긴다
		-- (행 자체를 끄면 표 모양이 무너져서 빈 자리로 보이게 유지한다)
		if not isvalid(row) then return end

		local data = nil
		if rows ~= nil then data = rows[index] end

		local rankText = row:GetChildByName("RankText")
		local nameText = row:GetChildByName("NameText")
		local scoreText = row:GetChildByName("ScoreText")

		if data == nil then
			if isvalid(rankText) then rankText.TextComponent.Text = tostring(index) end
			if isvalid(nameText) then nameText.TextComponent.Text = "-" end
			if isvalid(scoreText) then scoreText.TextComponent.Text = "-" end
			-- 빈 자리도 그 순위의 보상은 보여준다
			self:SetRewardCell(row, index)
			return
		end

		self:SetRewardCell(row, data.rank)
		if isvalid(rankText) then rankText.TextComponent.Text = tostring(data.rank) end
		if isvalid(nameText) then nameText.TextComponent.Text = self:DisplayName(data.name) end
		if isvalid(scoreText) then scoreText.TextComponent.Text = self:FormatNumber(self:DecodeScore(data.score)) end
	end

	@ExecSpace("ClientOnly")
	method void SetMyRow(integer myRank, integer myScore, integer listCount)
		-- 하단 "내 순위" 고정행. 상위 100 안에 들면 순위까지, 밖이면 점수만 보여준다.
		-- listCount는 이번에 받은 목록 길이 — "N위 밖"이라고 단정해도 되는지 판단하는 데 쓴다
		if not isvalid(self.myRankRow) then return end

		local rankText = self.myRankRow:GetChildByName("RankText")
		local nameText = self.myRankRow:GetChildByName("NameText")
		local scoreText = self.myRankRow:GetChildByName("ScoreText")

		local myName = "-"
		if isvalid(_UserService.LocalPlayer) then
			myName = _UserService.LocalPlayer.PlayerComponent.Nickname
		end
		if isvalid(nameText) then nameText.TextComponent.Text = myName end

		if myScore <= 0 then
			if isvalid(rankText) then rankText.TextComponent.Text = "-" end
			if isvalid(scoreText) then scoreText.TextComponent.Text = _LocalizationService:GetText("MLUA_RANKUI_001") end
			self:SetRewardCell(self.myRankRow, 0)
			return
		end

		if isvalid(scoreText) then scoreText.TextComponent.Text = self:FormatNumber(self:DecodeScore(myScore)) end

		-- 보상 칸: 순위가 잡히면 그 순위, 100위 밖이 확실하면 "그 밖" 보상, 집계가 덜 됐으면 숨김
		if myRank > 0 then
			self:SetRewardCell(self.myRankRow, myRank)
		elseif listCount >= self.ViewCount then
			self:SetRewardCell(self.myRankRow, self.ViewCount + 1)
		else
			self:SetRewardCell(self.myRankRow, 0)
		end

		if myRank > 0 then
			if isvalid(rankText) then rankText.TextComponent.Text = tostring(myRank) end
			return
		end

		-- 기록은 있는데 순위가 안 잡힌 경우. 목록이 꽉 찼을 때만 진짜로 "밖"이라고 단정할 수 있다 —
		-- 목록이 ViewCount보다 짧은데 내가 없다면 그건 순위 밖이 아니라 집계가 아직 안 따라온 것이다
		-- (예전에 "혼자 플레이했는데 100위 밖"으로 잘못 표시된 원인)
		if isvalid(rankText) then
			if listCount >= self.ViewCount then
				rankText.TextComponent.Text = _LocalizationService:GetTextFormat("FMT_RANKUI_001", tostring(self.ViewCount))
			else
				rankText.TextComponent.Text = _LocalizationService:GetText("MLUA_RANKUI_003")
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnRowRefresh(integer index, Entity entity)
		-- GridView가 보이는 행을 그릴 때마다 호출 — DataStorage 접근 금지, 캐시(_restList)만 읽는다
		local data = self._restList[index]
		if data == nil then return end

		local rankText = entity:GetChildByName("RankText")
		local nameText = entity:GetChildByName("NameText")
		local scoreText = entity:GetChildByName("ScoreText")

		if isvalid(rankText) then rankText.TextComponent.Text = tostring(data.rank) end
		self:SetRewardCell(entity, data.rank)
		if data.empty then
			-- 기록 없는 빈 칸
			if isvalid(nameText) then nameText.TextComponent.Text = "-" end
			if isvalid(scoreText) then scoreText.TextComponent.Text = "-" end
			return
		end
		if isvalid(nameText) then nameText.TextComponent.Text = self:DisplayName(data.name) end
		if isvalid(scoreText) then scoreText.TextComponent.Text = self:FormatNumber(self:DecodeScore(data.score)) end
	end

	@ExecSpace("ClientOnly")
	method void ClearRows()
		-- 탭 전환 직후 이전 보드 내용이 잠깐 남아 보이지 않게 비운다
		self._restList = self:BuildRestList(nil)
		self.listArea.TotalCount = #self._restList
		self.listArea:Refresh(true, true)
		self:SetMedalRow(self.medalRow1, nil, 1)
		self:SetMedalRow(self.medalRow2, nil, 2)
		self:SetMedalRow(self.medalRow3, nil, 3)
	end

	-- 저장값은 (환산값 * RankScoreTimeScale + 생존초)라 표시할 땐 상위 자리만 쓴다.
	-- 하위 자리는 동점 시 생존 시간이 긴 쪽이 위로 오게 하려고 넣은 것이라 화면에는 보이지 않는다.
	@ExecSpace("ClientOnly")
	method integer DecodeScore(integer stored)
		return stored // self.RankScoreTimeScale
	end

	@ExecSpace("ClientOnly")
	method string DisplayName(string tag)
		if tag == nil or tag == "" then return _LocalizationService:GetText("MLUA_RANKUI_004") end
		return tag
	end

	@ExecSpace("ClientOnly")
	method string FormatNumber(integer n)
		-- 천 단위 콤마: 253353 -> "253,353" (GameOverUI와 동일한 방식)
		local s = tostring(n)
		local formatted = s
		local count = 0
		formatted, count = s:reverse():gsub("(%d%d%d)", "%1,")
		formatted = formatted:reverse()
		if formatted:sub(1, 1) == "," then formatted = formatted:sub(2) end
		return formatted
	end

	-- ── 스크롤바 ↔ GridView 양방향 동기화 (UIGridScrollBar와 동일한 카운터 방식) ──

	@ExecSpace("ClientOnly")
	method void SyncSliderFromGrid()
		self._pendingFromSlider = 0
		local pos = self.listArea:GetScrollNormalizedPosition(UITransformAxis.Vertical)
		self._pendingFromGrid = self._pendingFromGrid + 1
		self.scrollBar.Value = pos
		self._lastScrollValue = pos
	end

	@ExecSpace("ClientOnly")
	method void OnSliderChanged(SliderValueChangedEvent event)
		if self._pendingFromGrid > 0 then
			self._pendingFromGrid = self._pendingFromGrid - 1
			return
		end
		local currentGridPos = self.listArea:GetScrollNormalizedPosition(UITransformAxis.Vertical)
		if math.abs(event.Value - currentGridPos) < 0.0001 then
			self._lastScrollValue = event.Value
			return
		end
		self._pendingFromSlider = self._pendingFromSlider + 1
		self.listArea:SetScrollNormalizedPosition(UITransformAxis.Vertical, event.Value)
		-- 값이 한 번에 크게 뛴 경우(트랙 직접 클릭 등)만 안전장치로 다시 그린다 — 매 이벤트마다 부르면
		-- 핸들은 매끄럽게 움직이는데 내용만 뚝뚝 갱신돼 떨려 보인다
		if math.abs(event.Value - self._lastScrollValue) > 0.05 then
			self.listArea:Refresh(false, false)
		end
		self._lastScrollValue = event.Value
	end

	@ExecSpace("ClientOnly")
	method void OnGridScrolled(ScrollPositionChangedEvent event)
		if self._pendingFromSlider > 0 then
			self._pendingFromSlider = self._pendingFromSlider - 1
			return
		end
		local currentSliderValue = self.scrollBar.Value
		if math.abs(event.NormalizedPosition.y - currentSliderValue) < 0.0001 then
			self._lastScrollValue = event.NormalizedPosition.y
			return
		end
		self._pendingFromGrid = self._pendingFromGrid + 1
		self.scrollBar.Value = event.NormalizedPosition.y
		self._lastScrollValue = event.NormalizedPosition.y
	end

end
