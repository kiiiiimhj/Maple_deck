@Logic
script MobileScreenFitLogic extends Logic

	-- 모바일 해상도 대응(2026-09-17, 유저 리포트 "모바일에서 해상도가 개판" + 아이폰15 프로맥스 스샷 4장).
	-- 실측으로 밝혀진 원인:
	--   ① 아이폰은 UI 캔버스를 안전영역(다이나믹 아일랜드/홈바 제외, 가로 2000px 스샷 기준 좌우 127px·아래 45px)
	--      안쪽에만 깐다. 월드는 화면 끝까지 그려지므로 "stretch로 꽉 채운" 배경·딤도 그 띠만큼 모자라서
	--      뒤의 맵이 비친다(로비/로딩 좌우 틈).
	--   ② 네이티브 카메라가 모바일에서 세로 5.4칸(PC 7.2칸)만 보여줘서 같은 줌(115)이어도 37% 확대돼 보인다.
	--   ③ MSW 기본 버튼(친구/⋯)이 모바일에선 안전영역 우상단 끝에 붙어 로비 재화 배지를 가린다.
	-- 전부 IsActive()(= 모바일) 일 때만 실행한다 → PC 화면은 불변.
	-- 와이프 패널(좌우 검은 띠)은 MapTransitionLogic이 GetWipeCover()를 불러 처리한다.

	-- Maker(PC)에서 코드 경로만 시험할 때 잠깐 true로 켠다. 배포 시 반드시 false.
	property boolean DebugForceMobile = false

	-- 모바일 카메라 줌 배율 — 네이티브 세로 시야 PC 3.6 / 모바일 2.7(OrthographicSize).
	-- ⚠ ZoomRatio는 값이 클수록 "확대(줌인)"다(보이는 범위 ∝ 1/ZoomRatio). 2026-09-17 실측: 줌 115 폰 세로 5.8칸 →
	-- 153으로 올리니 4.7칸으로 더 좁아짐. 그래서 모바일은 2.7/3.6 = 0.75를 곱해(115 → 86.25) 세로 범위를 PC와 맞춘다.
	property number MobileZoomMultiplier = 0.75

	-- 화면 끝 좌표 측정이 실패하거나 모자랄 때를 대비한 최소 확장량(UI 단위). 아이폰 가로 안전영역 ≈ 좌우 150 / 아래 55.
	property Vector2 MinBleed = Vector2(160, 60)

	-- 배경 이미지 원본 비율(16:9). 런타임 RectSize는 캔버스 비율(아이패드 4:3 → 1920×1440)이라 기준으로 쓰면 찌그러짐이 그대로 남는다
	-- (2026-09-17 Maker 모바일 시뮬레이터 2048×1536에서 로비 배경이 좌우로 눌린 것 확인).
	property number BackgroundAspect = 1.7778

	-- 배경 이미지 비율 허용 오차(원본 대비 ±배율). 벗어나면 넘치는 쪽을 잘라 비율을 지킨다.
	property number BackgroundMaxStretch = 1.08

	-- 로비 재화 배지를 모바일에서 왼쪽으로 미는 양(MSW 기본 버튼 2개 폭 ≈ 180 + 여유)
	property number LobbyBadgeShiftX = 200

	-- UI 레이아웃이 한 프레임 이상 잡힌 뒤에 재야 stretch RectSize가 실제 캔버스 크기로 채워져 있다
	property number ApplyDelay = 0.5

	property boolean _applied = false
	property integer _lastScreenW = 0
	property integer _lastScreenH = 0
	property number _screenCheckTimer = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 모바일일 때만 화면 맞춤을 예약한다(PC는 아무것도 안 함).
		if not self:IsActive() then return end
		log(string.format("MobileScreenFitLogic: mobile fit scheduled (screen %dx%d)", _UILogic.ScreenWidth, _UILogic.ScreenHeight))
		_TimerService:SetTimerOnce(function()
			if isvalid(self) then self:ApplyAll() end
		end, self.ApplyDelay)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 화면 크기가 바뀌면(회전/창 크기) 원본 기준으로 다시 맞춘다. 1초에 한 번만 확인.
		if not self._applied then return end
		self._screenCheckTimer = self._screenCheckTimer + delta
		if self._screenCheckTimer < 1 then return end
		self._screenCheckTimer = 0
		if _UILogic.ScreenWidth ~= self._lastScreenW or _UILogic.ScreenHeight ~= self._lastScreenH then
			self:ApplyAll()
		end
	end

	method boolean IsActive()
		-- 모바일 보정을 적용할지 — 실제 모바일이거나 디버그 강제일 때만 true.
		if self.DebugForceMobile then return true end
		return Environment:IsMobilePlatform()
	end

	method number GetZoomMultiplier()
		-- MapManager.ApplyDefaultZoomImmediate가 기본 줌에 곱하는 값. PC는 1.
		if self:IsActive() then return self.MobileZoomMultiplier end
		return 1
	end

	method table GetBackgroundPaths()
		-- 원본 비율을 지키며 넓힐 배경 이미지들.
		return {
			"/ui/TitleGroup/LobbyBackdrop",
			"/ui/TitleGroup/BattlePanel/Background",
			"/ui/LoadingGroup/Screen/Bg",
		}
	end

	method table GetDimmerPaths()
		-- 비율 무관하게 화면 끝까지 넓힐 단색 딤/플래시 — 자식 없는 1920×1080 엔티티만 골랐다.
		return {
			"/ui/AttendanceGroup/Dimmer",
			"/ui/CharacterUnlockGroup/Dimmer",
			"/ui/DefaultGroup/FreezeScreenBack",
			"/ui/DefaultGroup/TutorialDim",
			"/ui/EpisodeRewardGroup/Dimmer",
			"/ui/EquipmentGroup/Inventory/SellConfirm/Dim",
			"/ui/GachaGroup/Dimmer",
			"/ui/GachaGroup/GachaProbInfo/Dim",
			"/ui/GameOverGroup/Dimmer",
			"/ui/GameOverGroup/DiaShop/Dim",
			"/ui/IdleRewardGroup/Dimmer",
			"/ui/IdleRewardGroup/ConfirmDimmer",
			"/ui/InventoryGroup/Dimmer",
			"/ui/LevelRewardGroup/Dimmer",
			"/ui/OptionGroup/Dimmer",
			"/ui/OptionGroup/ConfirmDimmer",
			"/ui/RelicUpgradeGroup/Dimmer",
			"/ui/RunStartConfirmGroup/Dimmer",
			"/ui/ShadowShopGroup/Dimmer",
			"/ui/SkillUpgradeGroup/Dimmer",
			"/ui/ToastGroup/BossAlertFlash",
			"/ui/WorldCharacterSelectGroup/Dimmer",
		}
	end

	method table GetLobbyBadgePaths()
		-- 모바일에서 MSW 기본 버튼을 피해 왼쪽으로 옮길 로비 우상단 배지들.
		return {
			"/ui/TitleGroup/CoinBadge",
			"/ui/TitleGroup/DiamondBadge",
		}
	end

	-- 화면 전체 사각형을 "요소 자신의 pivot 기준 로컬 좌표"로 잰다. 측정 불가/비정상이면 nil.
	@ExecSpace("ClientOnly")
	method table MeasureScreenLocal(UITransformComponent t, number refW, number refH)
		-- 화면 (0,0)과 (ScreenWidth,ScreenHeight)를 로컬 UI 좌표로 변환한다. 원점 방향은 min/max로 흡수.
		local sw = _UILogic.ScreenWidth
		local sh = _UILogic.ScreenHeight
		if sw <= 0 or sh <= 0 then return nil end
		local a = _UILogic:ScreenToLocalUIPosition(Vector2(0, 0), t)
		local b = _UILogic:ScreenToLocalUIPosition(Vector2(sw, sh), t)
		if a == nil or b == nil then return nil end
		local x0 = math.min(a.x, b.x)
		local x1 = math.max(a.x, b.x)
		local y0 = math.min(a.y, b.y)
		local y1 = math.max(a.y, b.y)
		-- 부모가 스케일 트윈 중이면 값이 폭주할 수 있다 — 상식 범위(기준 크기의 0.5~4배) 안일 때만 채택
		if (x1 - x0) > refW * 4 or (y1 - y0) > refH * 4 then return nil end
		if (x1 - x0) < refW * 0.5 or (y1 - y0) < refH * 0.5 then return nil end
		return { x0 = x0, x1 = x1, y0 = y0, y1 = y1 }
	end

	-- 기준 좌표계(원점 = 원본 중심)에서 화면 전체를 덮는 사각형. offset = 로컬→기준 좌표 변환량.
	@ExecSpace("ClientOnly")
	method table BuildCoverRect(UITransformComponent t, number w, number h, Vector2 offset)
		-- 원본 사각형 + 최소 확장량을 기본으로 깔고, 실측한 화면 끝이 더 넓으면 그만큼 넓힌다.
		local x0 = -w / 2 - self.MinBleed.x
		local x1 = w / 2 + self.MinBleed.x
		local y0 = -h / 2 - self.MinBleed.y
		local y1 = h / 2 + self.MinBleed.y
		local m = self:MeasureScreenLocal(t, w, h)
		if m ~= nil then
			x0 = math.min(x0, m.x0 + offset.x)
			x1 = math.max(x1, m.x1 + offset.x)
			y0 = math.min(y0, m.y0 + offset.y)
			y1 = math.max(y1, m.y1 + offset.y)
		end
		return { x0 = x0, x1 = x1, y0 = y0, y1 = y1, measured = (m ~= nil) }
	end

	@ExecSpace("ClientOnly")
	method void ApplyAll()
		-- 배경·딤·로비 배지를 모바일 화면에 맞춘다. 원본 값은 한 번만 저장하고 매번 원본 기준으로 다시 계산한다.
		self._lastScreenW = _UILogic.ScreenWidth
		self._lastScreenH = _UILogic.ScreenHeight
		local bgCount = 0
		local dimCount = 0
		local badgeCount = 0
		local bgPaths = self:GetBackgroundPaths()
		local dimPaths = self:GetDimmerPaths()
		local badgePaths = self:GetLobbyBadgePaths()
		for _, path in ipairs(bgPaths) do
			if self:FitToScreen(path, true) then bgCount = bgCount + 1 end
		end
		for _, path in ipairs(dimPaths) do
			if self:FitToScreen(path, false) then dimCount = dimCount + 1 end
		end
		if self._T.badgeOrig == nil then self._T.badgeOrig = {} end
		for _, path in ipairs(badgePaths) do
			local e = _EntityService:GetEntityByPath(path)
			if isvalid(e) then
				local t = e.UITransformComponent
				if self._T.badgeOrig[path] == nil then self._T.badgeOrig[path] = t.anchoredPosition end
				local orig = self._T.badgeOrig[path]
				t.anchoredPosition = Vector2(orig.x - self.LobbyBadgeShiftX, orig.y)
				badgeCount = badgeCount + 1
			end
		end
		self:FitTabBarTopLine()
		self._applied = true
		log(string.format("MobileScreenFitLogic: applied bg=%d/%d dim=%d/%d badge=%d/%d (screen %dx%d)",
			bgCount, #bgPaths, dimCount, #dimPaths, badgeCount, #badgePaths,
			self._lastScreenW, self._lastScreenH))
	end

	@ExecSpace("ClientOnly")
	method void FitTabBarTopLine()
		-- 로비 하단 탭바 윗선(TopLine, 고정 1920폭)을 탭바 실제 폭에 맞춘다 — 탭바 배경은 stretch라 모바일 캔버스
		-- (아이폰/갤럭시 ≈2040)만큼 넓어지는데 선만 1920이라 양끝이 끊겨 보였다(2026-09-17 유저 스샷).
		local bar = _EntityService:GetEntityByPath("/ui/TitleGroup/TabBar")
		local line = _EntityService:GetEntityByPath("/ui/TitleGroup/TabBar/TopLine")
		if not isvalid(bar) or not isvalid(line) then
			log_warning("MobileScreenFitLogic: TabBar/TopLine not found")
			return
		end
		local barWidth = bar.UITransformComponent.RectSize.x
		local t = line.UITransformComponent
		if barWidth > t.RectSize.x then
			t.RectSize = Vector2(barWidth, t.RectSize.y)
		end
		log(string.format("MobileScreenFitLogic: tab top line width -> %.0f (bar %.0f)", t.RectSize.x, barWidth))
	end

	@ExecSpace("ClientOnly")
	method boolean FitToScreen(string path, boolean keepAspect)
		-- 한 엔티티를 실제 화면 끝까지 넓힌다. stretch 앵커는 Offset, 고정 앵커는 RectSize+anchoredPosition으로.
		local e = _EntityService:GetEntityByPath(path)
		if not isvalid(e) then
			log_warning("MobileScreenFitLogic: not found " .. path)
			return false
		end
		local t = e.UITransformComponent
		if t == nil then return false end
		if t.Pivot.x ~= 0.5 or t.Pivot.y ~= 0.5 then return false end

		if self._T.orig == nil then self._T.orig = {} end
		local o = self._T.orig[path]
		if o == nil then
			o = {
				offMin = t.OffsetMin, offMax = t.OffsetMax,
				size = t.RectSize, pos = t.anchoredPosition,
				stretch = (t.AnchorsMin.x ~= t.AnchorsMax.x) or (t.AnchorsMin.y ~= t.AnchorsMax.y),
			}
			self._T.orig[path] = o
		end

		local w = o.size.x
		local h = o.size.y
		if w <= 0 or h <= 0 then return false end

		-- 측정은 "현재" 요소 중심 기준 → 원본 중심 기준으로 옮기는 변환량(이미 한 번 적용했다면 그 이동분)
		local offset = Vector2(t.anchoredPosition.x - o.pos.x, t.anchoredPosition.y - o.pos.y)
		if o.stretch then
			offset = Vector2(((t.OffsetMin.x + t.OffsetMax.x) - (o.offMin.x + o.offMax.x)) / 2,
				((t.OffsetMin.y + t.OffsetMax.y) - (o.offMin.y + o.offMax.y)) / 2)
		end
		local r = self:BuildCoverRect(t, w, h, offset)

		local cx = (r.x0 + r.x1) / 2
		local cy = (r.y0 + r.y1) / 2
		local W = r.x1 - r.x0
		local H = r.y1 - r.y0
		if keepAspect then
			-- 이미지 원본 비율(BackgroundAspect) ±BackgroundMaxStretch 안으로 맞춘다 — 가로가 넘치면 위아래를,
			-- 세로가 넘치면(아이패드 4:3) 좌우를 잘라 찌그러짐 없이 화면을 덮는다
			local minAspect = self.BackgroundAspect / self.BackgroundMaxStretch
			local maxAspect = self.BackgroundAspect * self.BackgroundMaxStretch
			local aspect = W / H
			if aspect > maxAspect then
				H = W / maxAspect
			elseif aspect < minAspect then
				W = H * minAspect
			end
		end

		if o.stretch then
			local left = cx - W / 2
			local right = cx + W / 2
			local bottom = cy - H / 2
			local top = cy + H / 2
			t.OffsetMin = Vector2(o.offMin.x + (left + w / 2), o.offMin.y + (bottom + h / 2))
			t.OffsetMax = Vector2(o.offMax.x + (right - w / 2), o.offMax.y + (top - h / 2))
		else
			t.RectSize = Vector2(W, H)
			t.anchoredPosition = Vector2(o.pos.x + cx, o.pos.y + cy)
		end
		log(string.format("MobileScreenFitLogic: fit %s stretch=%s measured=%s orig=%.0fx%.0f -> %.0fx%.0f center(%.0f,%.0f)",
			path, tostring(o.stretch), tostring(r.measured), w, h, W, H, cx, cy))
		return true
	end

	-- MapTransitionLogic 와이프 패널용: 화면 전체를 덮는 크기와 중심(anchoredPosition 좌표)을 돌려준다.
	-- 모바일이 아니면 nil → 호출측은 기존 1920×1080 / 이동거리 1920을 그대로 쓴다.
	@ExecSpace("ClientOnly")
	method table GetWipeCover(UITransformComponent t)
		-- 패널 기준 크기 1920×1080(중앙 앵커)로 화면 끝까지 덮는 사각형(+여유 40)을 계산한다.
		if not self:IsActive() then return nil end
		local pos = t.anchoredPosition
		local r = self:BuildCoverRect(t, 1920, 1080, pos)
		local cover = {
			width = (r.x1 - r.x0) + 40,
			height = (r.y1 - r.y0) + 40,
			cx = (r.x0 + r.x1) / 2,
			cy = (r.y0 + r.y1) / 2,
		}
		log(string.format("MobileScreenFitLogic: wipe cover %.0fx%.0f center(%.0f,%.0f) measured=%s",
			cover.width, cover.height, cover.cx, cover.cy, tostring(r.measured)))
		return cover
	end

end
