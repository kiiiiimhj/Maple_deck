@Logic
script GameOverUI extends Logic

	-- UI 바인딩 (클라이언트 전용)
	-- gameOverGroup은 반드시 .ui의 진짜 루트 엔티티(UIGroup+CanvasGroup 붙은 것)를 가리켜야 한다 —
	-- 예전엔 안쪽 패널(GameOverBack)을 가리키고 있었는데, 그때는 자식이 GameOverBack 하나뿐이라 문제가
	-- 안 보이다가, Dimmer를 루트의 형제로 추가하고 나서 Enable 토글이 Dimmer까지 전파되지 않는 버그로
	-- 드러났다(게임오버 아닐 때도 Dimmer가 계속 화면을 덮고 있음). 루트를 토글해야 GameOverBack과
	-- Dimmer가 둘 다 자식이라 같이 켜지고 꺼진다.
	property Entity gameOverGroup = "481d8642-e741-4155-b940-463a755816b5"
	property TextComponent statsText = "1f4dd02c-dcf3-4a2f-9f01-27939d3ad424"
	property TextComponent scoreValueText = "a339fc14-faa5-4c63-baf9-b9a85313905b"
	property Entity itemList = "e7c2fb10-720a-49c4-8790-d00695cd8635"
	property Entity itemScrollTouchArea = "f3ed1070-d413-4def-9228-0adf9c4a750a"
	property SliderComponent itemScrollBar = "f0e09184-2970-406f-88ff-97b738fb5816"
	property ButtonComponent btnContinue = "fe47e2f9-a3d9-4dc3-a1f0-11907891ae05"
	-- 이어하기/다시하기 없이 그냥 로비(타이틀 화면)로 돌아가고 싶을 때 누르는 X 버튼
	property ButtonComponent btnClose = "18fdab71-ac7c-4dc0-b262-dbc4a0c9c63e"
	-- 처음부터 다시 시작 (RestartGame — 웨이브/레벨/골드 전부 초기화)
	property ButtonComponent btnRestart = "da399efa-56ea-4acb-b554-c644ba4ce665"
	-- 버튼 이미지와 완전히 분리된 라벨 텍스트(유저가 이미지/텍스트 위치를 독립적으로 조정할 수 있게)
	property TextComponent restartLabelText = "4f56cf6f-f92d-4b00-bb27-acaf0570b0df"
	property TextComponent continueLabelText = "60406bc4-8f21-491f-9520-02e43ea5a010"
	-- 타임어택 20분 오버타임(절망의 칼날) 도중 죽었을 때만 노출되는 전용 "다시하기" — 이어하기/
	-- 다시하기 버튼 사이(중앙)에 위치. 그 순간엔 원래 두 버튼을 숨기고 이것만 보여준다.
	property ButtonComponent btnRestartOvertime = "e4d263f1-004c-49b3-b97b-cab030ab1b1c"

	property integer itemSlotCount = 26
	property number scrollableRangePx = 670

	-- 내부 상태
	property boolean _prevGameOver = false
	property any _continueHandler = nil
	property any _closeHandler = nil
	property any _restartHandler = nil
	property any _restartOvertimeHandler = nil
	property any _dragHandler = nil
	property any _scrollBarHandler = nil
	property boolean _syncingScrollBar = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 게임오버 패널을 숨기고 버튼 클릭 이벤트를 연결한다
		self.gameOverGroup.Enable = false
		self._continueHandler = self.btnContinue.Entity:ConnectEvent(ButtonClickEvent, self.OnContinueClicked)
		self._closeHandler = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, self.OnCloseClicked)
		self._restartHandler = self.btnRestart.Entity:ConnectEvent(ButtonClickEvent, self.OnRestartClicked)
		self._restartOvertimeHandler = self.btnRestartOvertime.Entity:ConnectEvent(ButtonClickEvent, self.OnRestartOvertimeClicked)
		self._dragHandler = self.itemScrollTouchArea:ConnectEvent(UITouchDragEvent, self.OnScrollDrag)
		self._scrollBarHandler = self.itemScrollBar.Entity:ConnectEvent(SliderValueChangedEvent, self.OnScrollBarChanged)
		log("GameOverUI started")
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- GameManager.GameOver는 @Sync지만 OnSyncProperty는 자기 자신의 속성에만 호출되므로 매 프레임 폴링한다.
		-- ContinueCount/TotalCoins가 서버에서 바뀌어도(이어하기 성공 등) 여기서 같이 갱신된다
		local isOver = _GameManager.GameOver
		if isOver ~= self._prevGameOver then
			self._prevGameOver = isOver
			if isOver then
				self:ShowGameOver()
			else
				self.gameOverGroup.Enable = false
			end
		end
		if isOver and isvalid(self.gameOverGroup) and self.gameOverGroup.Enable then
			self:RefreshContinueButton()
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowGameOver()
		-- 최종 웨이브/레벨/스코어 정보를 표시하고 패널을 연다
		self.statsText.Text = "Wave " .. _GameManager.Wave .. "  |  Lv." .. _GameManager.Level
		self:RefreshScore()
		self:RefreshContinueButton()
		self:RefreshOvertimeButtons()
		self.gameOverGroup.Enable = true
		self.itemList.ScrollLayoutGroupComponent:SetScrollNormalizedPosition(UITransformAxis.Horizontal, 0)
		self:SyncScrollBar(0)
		log("GameOverUI: shown (Wave " .. _GameManager.Wave .. ", Lv." .. _GameManager.Level .. ")")
	end

	-- 이번 런에 가방에 쌓인 잡템을 "획득 스코어"로 환산해 보여준다 — 아직 실제로 환전/차감하지는
	-- 않는다("이어하기"는 가방을 그대로 유지해야 하므로). 실제 환전은 "다시하기"(RestartGame)에서만 일어난다
	@ExecSpace("ClientOnly")
	method void RefreshScore()
		local defs = _PlayerInventory:GetAllItemDefs()
		local orderedIds = _PlayerInventory:GetOrderedItemIds()
		local totalScore = 0
		for i, itemId in ipairs(orderedIds) do
			local count = _PlayerInventory:GetItemCount(itemId)
			local def = defs[itemId]
			totalScore = totalScore + count * def.coinValue
			local slot = self.itemList:GetChildByName("ItemSlot_" .. tostring(i - 1))
			if isvalid(slot) then
				slot.Enable = true
				local icon = slot:GetChildByName("Icon")
				if isvalid(icon) then icon.SpriteGUIRendererComponent.ImageRUID = DataRef(def.icon) end
				local countText = slot:GetChildByName("CountText")
				if isvalid(countText) then countText.TextComponent.Text = "x" .. tostring(count) end
			end
		end
		-- 이번 런에 안 나온 아이템 슬롯은 숨긴다
		for i = #orderedIds, self.itemSlotCount - 1 do
			local slot = self.itemList:GetChildByName("ItemSlot_" .. tostring(i))
			if isvalid(slot) then slot.Enable = false end
		end
		self.scoreValueText.Text = self:FormatNumber(totalScore) .. " 점"
	end

	@ExecSpace("ClientOnly")
	method string FormatNumber(integer n)
		-- 천 단위 콤마: 253353 -> "253,353"
		local s = tostring(n)
		local formatted = s
		local count = 0
		formatted, count = s:reverse():gsub("(%d%d%d)", "%1,")
		formatted = formatted:reverse()
		if formatted:sub(1, 1) == "," then formatted = formatted:sub(2) end
		return formatted
	end

	@ExecSpace("ClientOnly")
	method void RefreshContinueButton()
		local cost = _GameManager:GetContinueCost()
		if isvalid(self.continueLabelText) then
			self.continueLabelText.Text = "이어하기\n재화 " .. self:FormatNumber(cost)
		end
		-- 예전엔 플랫 색상 버튼이라 어포더빌리티에 따라 sprite.Color를 직접 짙게 튜닝했는데, 지금은
		-- 이미지 자체가 녹색 그래픽이라 그 위에 짙은 남색 틴트를 곱하면 나무 배경과 구분이 안 될 만큼
		-- 어두워진다(유저 실측 확인 — "버튼이 사라짐"). sprite.Color는 항상 원본 그대로(흰색) 두고,
		-- 재화 부족 상태는 ButtonComponent 자체의 DisabledColor(Enable=false일 때 자동 적용)에 맡긴다.
		local canAfford = _GameManager.TotalCoins >= cost
		self.btnContinue.Enable = canAfford
		local sprite = self.btnContinue.Entity.SpriteGUIRendererComponent
		sprite.Color = Color(1, 1, 1, 1)
	end

	@ExecSpace("ClientOnly")
	method void OnContinueClicked()
		-- 실제 차감/검증은 서버(GameManager.RequestContinue)에서 한다. 성공하면 GameOver가 false로
		-- 바뀌고 OnUpdate 폴링이 패널을 자동으로 닫는다 — 여기서 직접 닫지 않는다(실패 시 계속 보여야 함)
		log("GameOverUI: Continue clicked")
		_GameManager:RequestContinue()
	end

	@ExecSpace("ClientOnly")
	method void OnCloseClicked()
		-- 이어하기/다시하기 없이 그냥 로비(타이틀 화면)로 돌아간다. 런 상태(웨이브/레벨/골드)는
		-- 건드리지 않고 그대로 둔다 — 나중에 로비에서 "게임 시작"을 다시 누르면 그때 TitleUI가 새로 시작할지 판단한다
		log("GameOverUI: Close(X) clicked, returning to lobby")
		self.gameOverGroup.Enable = false
		_TitleUI:ShowLobby()
	end

	@ExecSpace("ClientOnly")
	method void OnRestartClicked()
		-- 처음부터 다시 시작. 성공하면 GameOver가 false로 바뀌고 OnUpdate 폴링이 패널을 자동으로 닫는다.
		-- 새로 모드를 고르는 게 아니라 방금 끝난 런과 같은 모드로 그대로 재시작한다.
		log("GameOverUI: Restart clicked")
		_GameManager:RequestRestart(_GameManager.TimeAttackMode, _GameManager.SelectedCharacter)
	end

	@ExecSpace("ClientOnly")
	method void OnRestartOvertimeClicked()
		-- 이어하기/다시하기 사이에 뜨는 오버타임 전용 다시하기 — 동작은 OnRestartClicked와 동일하다.
		log("GameOverUI: Restart(overtime) clicked")
		_GameManager:RequestRestart(_GameManager.TimeAttackMode, _GameManager.SelectedCharacter)
	end

	-- 타임어택 오버타임(절망의 칼날) 도중 죽었으면 이어하기/다시하기 버튼을 숨기고 중앙의 전용
	-- 다시하기 버튼만 보여준다. 20분 전에 죽었으면 반대로 기존 두 버튼만 보여준다.
	@ExecSpace("ClientOnly")
	method void RefreshOvertimeButtons()
		local overtime = _GameManager._timeAttackOvertimeDeath
		self.btnContinue.Entity.Enable = not overtime
		self.btnRestart.Entity.Enable = not overtime
		self.btnRestartOvertime.Entity.Enable = overtime
	end

	@ExecSpace("ClientOnly")
	method void OnScrollDrag(UITouchDragEvent event)
		local current = self.itemList.ScrollLayoutGroupComponent:GetScrollNormalizedPosition(UITransformAxis.Horizontal)
		local delta = -event.TouchDelta.x / self.scrollableRangePx
		local newValue = math.max(0, math.min(1, current + delta))
		self.itemList.ScrollLayoutGroupComponent:SetScrollNormalizedPosition(UITransformAxis.Horizontal, newValue)
		self:SyncScrollBar(newValue)
	end

	@ExecSpace("ClientOnly")
	method void SyncScrollBar(number normalizedValue)
		self._syncingScrollBar = true
		self.itemScrollBar.Value = normalizedValue
		self._syncingScrollBar = false
	end

	@ExecSpace("ClientOnly")
	method void OnScrollBarChanged(SliderValueChangedEvent event)
		if self._syncingScrollBar then return end
		self.itemList.ScrollLayoutGroupComponent:SetScrollNormalizedPosition(UITransformAxis.Horizontal, event.Value)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._continueHandler then self.btnContinue.Entity:DisconnectEvent(ButtonClickEvent, self._continueHandler) end
		if self._closeHandler then self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self._closeHandler) end
		if self._restartHandler then self.btnRestart.Entity:DisconnectEvent(ButtonClickEvent, self._restartHandler) end
		if self._restartOvertimeHandler then self.btnRestartOvertime.Entity:DisconnectEvent(ButtonClickEvent, self._restartOvertimeHandler) end
		if self._dragHandler then self.itemScrollTouchArea:DisconnectEvent(UITouchDragEvent, self._dragHandler) end
		if self._scrollBarHandler then self.itemScrollBar.Entity:DisconnectEvent(SliderValueChangedEvent, self._scrollBarHandler) end
	end

end
