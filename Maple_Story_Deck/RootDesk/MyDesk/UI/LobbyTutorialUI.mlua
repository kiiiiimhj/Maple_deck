@Logic
script LobbyTutorialUI extends Logic

	-- 로비 튜토리얼(유저 지정 2026-09-29) — ui/LobbyTutorialGroup.ui.
	--   · 첫 설치 유저가 인트로 만화(IntroComicUI)를 다 보고 로비가 보이면 시작한다. 만화보다 먼저 뜨는 일이 없도록
	--     "인트로 봤음이 서버에 저장됨 + 만화 재생 끝 + 로딩 화면 걷힘 + 로비 전투 탭이 보임"이 StartDelay 동안 계속 참일 때만 연다.
	--   · 캐릭터 초상화 + 대화 상자에 대사 9단계. 글자는 한 자씩 찍히고(탭하면 즉시 전부), 다 찍히면 ▽ 삼각형이 깜빡이고
	--     탭하면 다음 단계. 핵심 키워드는 번역문 안의 <color> 태그로 빨간색.
	--   · 단계마다 설명하는 아이콘(하단 탭바 포함)만 딤 위에 원래 모습 그대로 보인다.
	--     ⚠ TitleGroup 안에서 딤 위로 위젯을 올리는 방식(SetSiblingIndex/displayOrder)은 이 엔진에서 안 통했다
	--     ([[project_raid_tutorial_onboarding]]) → 이 그룹의 Highlight 층에 원본을 **복제**(SpawnByEntity)해서 같은 자리에 놓는다.
	--     복제본은 .ui 기본 상태로 나오므로 켜짐/이미지/글자를 원본에서 다시 복사한다(SyncState). 입력은 맨 위 Touch가 다 받는다.
	--   · 마지막 단계를 넘기면 서버(TutorialLogic.RequestFinishLobbyTutorial)가 봤음 저장 + 다이아 1,000 지급,
	--     배지 숫자는 보류(Hold)했다가 대화 상자 자리에서 다이아가 날아가 도착할 때 오른다.

	-- UI 바인딩(빌더가 UUID를 넣는다 — .builder-work/lobby_tutorial_ui.cjs)
	property Entity group = "39161750-b585-46e3-acca-f6ca57cf1b12"
	property Entity highlight = "d303c748-38c4-4423-8475-503ae53a3b03"
	property Entity dialog = "dfbf5a26-e962-49ff-9cb2-eccac67318d1"
	property Entity box = "f1e88b3f-d99a-4053-95f9-e0953637b49d"
	property TextGUIRendererComponent text = "bf8c41f0-1ffc-4ec6-9973-505061dd3d46"
	property Entity triangle = "ccd9b091-d030-4cd5-972d-9c9414ee2dc3"
	property ButtonComponent touch = "c9d6a9ce-4cbe-44fe-aa0b-aa58a86af1c2"

	property string TitleGroupPath = "/ui/TitleGroup"
	property string BattlePanelPath = "/ui/TitleGroup/BattlePanel"
	property string LoadingScreenPath = "/ui/LoadingGroup/Screen"
	property string DiamondIconRUID = "81462aeb825b4660991cef05651271cf"
	-- 보상 다이아(숫자 보류용) — 서버 TutorialLogic.LobbyRewardDiamond와 같은 값으로 둘 것
	property integer RewardDiamond = 1000

	-- 조건이 이만큼 계속 참이어야 시작한다(인트로 페이드아웃·로비 첫 그리기와 겹치지 않게)
	property number StartDelay = 0.8
	-- 대사 글자 크기 범위와 폭 어림 여유(FitFontSize)
	property number TextMaxSize = 40
	property number TextMinSize = 16
	-- 폭 어림 여유 — 1.05에서 4단계 "높여 / 봐."가 엔진 자동 줄바꿈으로 넘쳤다(2026-09-29 실측) → 1보다 조금 작게
	property number TextWidthSafety = 0.97
	property number TextLineHeight = 1.2
	-- false(유저 지정): 대사는 번역문 줄바꿈 그대로, 긴 줄은 글자를 줄여 맞춘다 / true: 띄어쓰기에서 자동으로 더 나눠 글자를 키운다
	property boolean UseAutoWrap = false
	-- 초당 글자 수(타자 효과)
	property number CharsPerSecond = 32
	-- ▽ 깜빡임 주기(초)
	property number BlinkPeriod = 0.9
	property number DialogPopSeconds = 0.25
	property number CloseFadeSeconds = 0.25
	-- 서버 지급 응답이 끝내 안 오면 보류한 다이아 숫자를 푼다
	property number RewardTimeout = 3.0

	-- 테스트 전용: "en"/"zh-tw"/"ja"를 넣으면 그 언어 대사로 보여준다(평소 "")
	property string DebugLocale = ""

	property boolean _active = false
	property boolean _seenLocal = false
	property number _readyTime = 0
	property integer _step = 0
	property table _tokens = {}
	-- FitFontSize가 고른 줄바꿈 자리(토큰 번호 → "space"/"before")
	property table _breaks = {}
	-- 9단계 공통 글자 크기(ComputeUniformSize — Begin 때마다 다시 잰다). 0이면 아직 안 잼
	property number _uniformSize = 0
	property integer _total = 0
	property number _shown = 0
	property boolean _typing = false
	property number _blinkTime = 0
	property table _clones = {}
	property boolean _finishing = false
	property boolean _rewardPending = false
	property Vector2 _flyFrom = Vector2(0, 0)
	property any _touchHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 그룹은 평소 꺼 두고, 전체 화면 터치(Touch)로 진행한다
		if not isvalid(self.group) then
			log_error("LobbyTutorialUI: group entity missing")
			return
		end
		self.group.Enable = false
		if isvalid(self.touch) then
			self._touchHandler = self.touch.Entity:ConnectEvent(ButtonClickEvent, self.OnTouch)
		end
		log("LobbyTutorialUI started")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._touchHandler ~= nil and isvalid(self.touch) then
			self.touch.Entity:DisconnectEvent(ButtonClickEvent, self._touchHandler)
		end
		self:ClearClones()
	end

	-- ── 시작 조건 ──────────────────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method boolean IsPending()
		-- 서버가 저장값을 읽었고 아직 안 봤는가
		if self._seenLocal then return false end
		if not _TutorialLogic.LobbyLoaded then return false end
		return not _TutorialLogic.LobbySeen
	end

	@ExecSpace("ClientOnly")
	method boolean IsLobbyReady()
		-- 인트로 만화가 확실히 끝났고(봤음 저장 + 재생 끝) 로비 전투 탭이 화면에 보이는가
		if not _TutorialLogic.IntroLoaded or not _TutorialLogic.IntroSeen then return false end
		if _IntroComicUI:IsPlaying() then return false end
		local title = _EntityService:GetEntityByPath(self.TitleGroupPath)
		if not isvalid(title) or not title.Enable then return false end
		local loading = _EntityService:GetEntityByPath(self.LoadingScreenPath)
		if isvalid(loading) and loading.Enable then return false end
		local battle = _EntityService:GetEntityByPath(self.BattlePanelPath)
		if not isvalid(battle) or not battle.EnabledInHierarchy then return false end
		if _RaidUI:IsOpen() then return false end
		return true
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		if self._active then
			self:TickDialog(delta)
			return
		end
		if not self:IsPending() or not self:IsLobbyReady() then
			self._readyTime = 0
			return
		end
		self._readyTime = self._readyTime + delta
		if self._readyTime >= self.StartDelay then
			self:Begin()
		end
	end

	-- ── 진행 ──────────────────────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void Begin()
		-- 딤 + 대화 상자를 띄우고 1단계부터
		if self._active or not isvalid(self.group) then return end
		self._active = true
		self._finishing = false
		self.group.Enable = true
		-- 다른 팝업 그룹보다 확실히 위로(이 프로젝트 공통 패턴)
		_UILogic:SetSiblingIndex(self.group.UITransformComponent, 1000000)
		if isvalid(self.dialog) then
			local tr = self.dialog.UITransformComponent
			tr.Scale = Vector3(0.9, 0.9, 1)
			_TweenLogic:PlayTween(0.9, 1.0, self.DialogPopSeconds, EaseType.BackEaseOut, function(v)
				if isvalid(self.dialog) then self.dialog.UITransformComponent.Scale = Vector3(v, v, 1) end
			end)
		end
		log("LobbyTutorialUI: begin")
		self._uniformSize = 0
		self:ShowStep(1)
	end

	@ExecSpace("ClientOnly")
	method table GetStepTargets(integer step)
		-- 단계마다 딤 위로 보여줄 로비 요소(원본 경로)
		if step == 2 then return { "/ui/TitleGroup/AttendanceButton" } end
		if step == 3 then return { "/ui/TitleGroup/BattlePanel/GachaIcon" } end
		if step == 4 then return { "/ui/TitleGroup/EquipButton" } end
		if step == 5 then return { "/ui/TitleGroup/AchievementButton", "/ui/TitleGroup/MonsterBookButton" } end
		if step == 6 then return { "/ui/TitleGroup/BattlePanel/EpisodeRewardButton" } end
		if step == 7 then return { "/ui/TitleGroup/BattlePanel/IdleRewardButton" } end
		if step == 8 then return { "/ui/TitleGroup/TabBar" } end
		return {}
	end

	@ExecSpace("ClientOnly")
	method integer GetStepCount()
		return 9
	end

	@ExecSpace("ClientOnly")
	method void ShowStep(integer step)
		-- 대사를 처음부터 찍기 시작하고, 그 단계의 아이콘을 딤 위에 복제해 둔다
		self._step = step
		self:ClearClones()
		for _, path in ipairs(self:GetStepTargets(step)) do
			self:CloneTarget(path)
		end
		if self._uniformSize <= 0 then self:ComputeUniformSize() end
		self._tokens = self:Tokenize(self:GetStepLine(step))
		self._total = self:CountChars(self._tokens)
		self:FitFontSize()
		self._shown = 0
		self._typing = true
		self._blinkTime = 0
		if isvalid(self.triangle) then self.triangle.Enable = false end
		self:RenderText()
		log("LobbyTutorialUI: step " .. step .. " (chars=" .. self._total .. ", highlights=" .. #self._clones .. ")")
	end

	@ExecSpace("ClientOnly")
	method void OnTouch()
		-- 찍는 중이면 한 번에 전부, 다 찍혔으면 다음 단계(마지막이면 끝내기)
		if not self._active or self._finishing then return end
		if self._typing then
			self._shown = self._total
			self._typing = false
			self:RenderText()
			self:ShowTriangle()
			return
		end
		if self._step >= self:GetStepCount() then
			self:Finish()
			return
		end
		self:ShowStep(self._step + 1)
	end

	@ExecSpace("ClientOnly")
	method void TickDialog(number delta)
		-- 타자 효과 + 다 찍힌 뒤 ▽ 깜빡임
		if self._finishing then return end
		if self._typing then
			local before = math.floor(self._shown)
			self._shown = self._shown + delta * self.CharsPerSecond
			if self._shown >= self._total then
				self._shown = self._total
				self._typing = false
				self:RenderText()
				self:ShowTriangle()
			elseif math.floor(self._shown) ~= before then
				self:RenderText()
			end
			return
		end
		if isvalid(self.triangle) and self.triangle.Enable then
			self._blinkTime = self._blinkTime + delta
			local phase = (self._blinkTime % self.BlinkPeriod) / self.BlinkPeriod
			local a = 1.0
			if phase >= 0.5 then a = 0.15 end
			self.triangle.SpriteGUIRendererComponent.Color = Color(1, 1, 1, a)
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowTriangle()
		if not isvalid(self.triangle) then return end
		self._blinkTime = 0
		self.triangle.Enable = true
		self.triangle.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
	end

	-- ── 타자 효과(리치 텍스트) ──────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method table Tokenize(string s)
		-- "<...>" 태그와 글자(UTF-8 한 글자씩)로 쪼갠다. 태그는 글자 수에 안 센다
		local tokens = {}
		local i = 1
		local n = #s
		while i <= n do
			local b = string.byte(s, i)
			if b == 60 then
				local j = string.find(s, ">", i, true)
				if j == nil then j = n end
				table.insert(tokens, { tag = true, v = string.sub(s, i, j) })
				i = j + 1
			else
				local len = 1
				if b >= 240 then len = 4 elseif b >= 224 then len = 3 elseif b >= 192 then len = 2 end
				table.insert(tokens, { tag = false, v = string.sub(s, i, i + len - 1) })
				i = i + len
			end
		end
		return tokens
	end

	@ExecSpace("ClientOnly")
	method number GetCharEm(string ch)
		-- 글자 폭(글자 크기 대비 배율). Maple 글꼴 30px 실측(SizeFit): 한글 0.88 / 영문 0.6 / 한자·가나 1.0 / 공백 0.26 / 문장부호 0.34
		local b = string.byte(ch, 1)
		if #ch == 1 then
			if b == 32 then return 0.26 end
			if (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) then return 0.6 end
			return 0.36
		end
		if #ch == 2 then return 0.3 end
		if #ch == 3 then
			-- 한글 음절 U+AC00~U+D7A3 = UTF-8 EA B0 80 ~ ED 9E A3
			if b >= 234 and b <= 237 then return 0.88 end
			return 1.0
		end
		return 1.0
	end

	@ExecSpace("ClientOnly")
	method table WrapAt(number availEm)
		-- 이 폭(글자 크기 배율 단위)으로 줄을 나눈 결과 { lines = 줄 수, breaks = { [토큰 번호] = "space"(그 공백을 줄바꿈으로) | "before"(그 글자 앞에서 줄바꿈) } }.
		-- 띄어쓰기 자리에서 먼저 나누고, 띄어쓰기 없이 한 줄이 넘치면(중국어·일본어) 글자 앞에서 나눈다
		local breaks = {}
		local lines = 1
		local lineEm = 0
		local lastSpace = 0
		local emAfterSpace = 0
		for i, t in ipairs(self._tokens) do
			if not t.tag then
				if t.v == "\n" then
					lines = lines + 1
					lineEm = 0
					lastSpace = 0
					emAfterSpace = 0
				else
					local em = self:GetCharEm(t.v)
					if lineEm + em > availEm and lineEm > 0 then
						if t.v == " " then
							breaks[i] = "space"
							lines = lines + 1
							lineEm = 0
							lastSpace = 0
							emAfterSpace = 0
							em = 0
						elseif lastSpace > 0 then
							breaks[lastSpace] = "space"
							lines = lines + 1
							lineEm = emAfterSpace
							lastSpace = 0
							emAfterSpace = 0
						else
							breaks[i] = "before"
							lines = lines + 1
							lineEm = 0
						end
					end
					if t.v == " " and em > 0 then
						lastSpace = i
						emAfterSpace = 0
					else
						emAfterSpace = emAfterSpace + em
					end
					lineEm = lineEm + em
				end
			end
		end
		return { lines = lines, breaks = breaks }
	end

	@ExecSpace("ClientOnly")
	method void FitFontSize()
		-- 한글은 엔진이 글자 단위로 자동 줄바꿈해서("보상이/야!") BestFit만으로는 줄이 어색하게 끊긴다 →
		-- 큰 글자부터 내려가며 "띄어쓰기에서 직접 줄을 나눴을 때 세로로 다 들어가는" 가장 큰 크기를 고르고, 그 줄바꿈을 대사에 넣는다.
		-- (번역문의 \n 줄은 그대로 두고 너무 긴 줄만 더 나눈다.) BestFit은 켜 둔 채 MaxSize를 이 값으로 — 어림이 조금 커서 넘치면 엔진이 더 줄인다
		if not isvalid(self.text) then return end
		local rect = self.text.Entity.UITransformComponent.RectSize
		-- 2026-09-29 유저 지정 "내가 준 대로 줄바꿈": 번역문의 \n 줄만 쓰고 직접 줄을 더 나누지 않는다 →
		-- 가장 긴 줄이 한 줄에 들어가는 크기로 줄인다(WrapAt 자동 줄 나누기는 UseAutoWrap=true일 때만)
		local size = math.floor(self.TextMaxSize)
		local wrap = nil
		while true do
			wrap = self:WrapAt(rect.x * self.TextWidthSafety / size)
			local fits = wrap.lines * size * self.TextLineHeight <= rect.y
			if not self.UseAutoWrap then
				-- 줄을 더 나눠야 한다 = 이 크기로는 어떤 줄이 폭을 넘는다
				local extra = 0
				for _ in pairs(wrap.breaks) do extra = extra + 1 end
				fits = extra == 0 and fits
			end
			if fits or size <= self.TextMinSize then break end
			size = size - 1
		end
		if self.UseAutoWrap then
			self._breaks = wrap.breaks
		else
			self._breaks = {}
		end
		-- 유저 지정(2026-09-29) "삐져나가는 거 아니면 크기 동일": 9단계 전체 중 가장 작은 크기로 통일(ComputeUniformSize)
		if self._uniformSize > 0 and self._uniformSize < size then size = self._uniformSize end
		self.text.MaxSize = size
		self.text.FontSize = size
	end

	@ExecSpace("ClientOnly")
	method string GetStepLine(integer step)
		-- 단계 대사(번역문). DebugLocale이 있으면 그 언어로
		local key = "MLUA_LOBBYTUTORIALUI_" .. string.format("%03d", step)
		if self.DebugLocale ~= "" then
			local tr = _LocalizationService:GetTranslatorForLocale(self.DebugLocale)
			if tr ~= nil then return tr:GetText(key) end
		end
		return _LocalizationService:GetText(key)
	end

	@ExecSpace("ClientOnly")
	method void ComputeUniformSize()
		-- 모든 단계가 칸에 들어가는 크기 중 가장 작은 값을 공통 글자 크기로 잡는다(언어마다 다르게 나온다)
		self._uniformSize = 0
		local minSize = 0
		for s = 1, self:GetStepCount() do
			self._tokens = self:Tokenize(self:GetStepLine(s))
			self:FitFontSize()
			local fs = self.text.FontSize
			if minSize == 0 or fs < minSize then minSize = fs end
		end
		self._uniformSize = minSize
		log("LobbyTutorialUI: uniform font size " .. tostring(minSize))
	end

	@ExecSpace("ClientOnly")
	method integer CountChars(table tokens)
		local c = 0
		for _, t in ipairs(tokens) do
			if not t.tag then c = c + 1 end
		end
		return c
	end

	@ExecSpace("ClientOnly")
	method void RenderText()
		-- 앞 n글자는 원래 색(태그 포함), 나머지는 투명 색으로 미리 깔아 둔다 — 전체 문장 기준으로 줄바꿈·BestFit 크기가
		-- 처음부터 정해져서 찍히는 도중에 글자 크기/줄이 흔들리지 않는다
		if not isvalid(self.text) then return end
		-- 줄은 FitFontSize가 정한 자리(_breaks)에서만 나눈다. 나머지 띄어쓰기는 줄바꿈 안 되는 공백(U+00A0)으로 —
		-- 엔진 자동 줄바꿈이 끼어들지 않게(유저 지정: 영역 밖으로 나가면 안 됨, 최대한 크게)
		local n = math.floor(self._shown)
		local shown = ""
		local rest = ""
		local count = 0
		local open = false
		for i, t in ipairs(self._tokens) do
			local v = t.v
			local br = self._breaks[i]
			if br == "space" then
				v = "\n"
			elseif br == "before" then
				v = "\n" .. v
			elseif not t.tag and v == " " then
				v = "\194\160"
			end
			if count < n then
				if t.tag then
					shown = shown .. v
					if string.sub(v, 1, 7) == "<color=" then open = true end
					if v == "</color>" then open = false end
				else
					shown = shown .. v
					count = count + 1
				end
			elseif not t.tag then
				rest = rest .. v
			end
		end
		if open then shown = shown .. "</color>" end
		if rest ~= "" then
			shown = shown .. "<color=#00000000>" .. rest .. "</color>"
		end
		self.text.Text = shown
	end

	-- ── 강조(딤 위 복제본) ─────────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void CloneTarget(string path)
		-- 원본과 같은 화면 자리·크기로 Highlight 층에 복제한다. 원본이 안 보이는 상태면 건너뛴다
		local src = _EntityService:GetEntityByPath(path)
		if not isvalid(src) or not src.EnabledInHierarchy or not isvalid(self.highlight) then return end
		local clone = _SpawnService:SpawnByEntity(src, src.Name .. "_Tut", Vector3(0, 0, 0), self.highlight, true)
		if not isvalid(clone) then
			log_warning("LobbyTutorialUI: clone failed " .. path)
			return
		end
		self:SyncState(src, clone)
		-- ⚠ 월드 좌표를 그대로 옮기면 안 된다 — UI 그룹마다 캔버스가 따로라 게임 창 크기가 바뀌면(메이커 창 조정 등)
		-- 두 그룹의 월드 기준이 어긋나 복제본이 작아지고 밀렸다(2026-09-29 실측: 월드 좌표는 같은데 화면에선 80px 차이).
		-- → 원본을 "자기 그룹 화면 안 비율(0~1)"로 재고, Highlight 층에 같은 비율로 놓는다. 크기는 Scale로 맞춰 자식 배치가 그대로 따라온다
		local root = src
		while isvalid(root.Parent) and root.UIGroupComponent == nil do root = root.Parent end
		local rc = root.UITransformComponent:GetWorldCorners()
		local sc4 = src.UITransformComponent:GetWorldCorners()
		local rw = rc[3].x - rc[1].x
		local rh = rc[3].y - rc[1].y
		if rw == 0 or rh == 0 then return end
		local u0 = (sc4[1].x - rc[1].x) / rw
		local v0 = (sc4[1].y - rc[1].y) / rh
		local u1 = (sc4[3].x - rc[1].x) / rw
		local v1 = (sc4[3].y - rc[1].y) / rh
		local hs = self.highlight.UITransformComponent.RectSize
		local x0 = (u0 - 0.5) * hs.x
		local y0 = (v0 - 0.5) * hs.y
		local w = (u1 - u0) * hs.x
		local h = (v1 - v0) * hs.y
		local srcTr = src.UITransformComponent
		local tr = clone.UITransformComponent
		local k = 1
		if srcTr.RectSize.x > 0 and srcTr.Scale.x ~= 0 then k = w / (srcTr.RectSize.x * srcTr.Scale.x) end
		local pv = tr.Pivot
		tr.AnchorsMin = Vector2(0.5, 0.5)
		tr.AnchorsMax = Vector2(0.5, 0.5)
		tr.RectSize = srcTr.RectSize
		tr.Scale = Vector3(srcTr.Scale.x * k, srcTr.Scale.y * k, 1)
		tr.anchoredPosition = Vector2(x0 + pv.x * w, y0 + pv.y * h)
		table.insert(self._clones, clone)
	end

	@ExecSpace("ClientOnly")
	method void SyncState(Entity src, Entity dst)
		-- 복제본은 .ui 기본 상태로 나온다(빨간 점이 원본과 다르게 켜져 있던 것 실측) → 원본의 현재 상태를 자식까지 복사
		dst.Enable = src.Enable
		local ss = src.SpriteGUIRendererComponent
		local ds = dst.SpriteGUIRendererComponent
		if ss ~= nil and ds ~= nil then
			ds.ImageRUID = ss.ImageRUID
			ds.Color = ss.Color
		end
		local st = src.TextGUIRendererComponent
		local dt = dst.TextGUIRendererComponent
		if st ~= nil and dt ~= nil then dt.Text = st.Text end
		local sl = src.TextComponent
		local dl = dst.TextComponent
		if sl ~= nil and dl ~= nil then dl.Text = sl.Text end
		for _, child in ipairs(src.Children) do
			local other = dst:GetChildByName(child.Name)
			if isvalid(other) then self:SyncState(child, other) end
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearClones()
		for _, c in ipairs(self._clones) do
			if isvalid(c) then c:Destroy() end
		end
		self._clones = {}
	end

	-- ── 끝 ────────────────────────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void Finish()
		-- 서버에 완료 알림(봤음 저장 + 다이아 지급) → 창 닫기. 다이아는 지급 응답(OnRewardGranted) 때 대화 상자 자리에서 날아간다
		self._finishing = true
		self._seenLocal = true
		if isvalid(self.triangle) then self.triangle.Enable = false end
		if isvalid(self.box) then self._flyFrom = _RewardFlyUI:GetLayerPosOf(self.box, 0, 0) end
		local amount = self.RewardDiamond
		_RewardFlyUI:Hold("diamond", amount)
		self._rewardPending = true
		_TimerService:SetTimerOnce(function()
			if not self._rewardPending then return end
			self._rewardPending = false
			_RewardFlyUI:Release("diamond", amount)
			log_warning("LobbyTutorialUI: reward response timed out")
		end, self.RewardTimeout)
		_TutorialLogic:RequestFinishLobbyTutorial()
		self:Close()
		log("LobbyTutorialUI: finish requested")
	end

	@ExecSpace("ClientOnly")
	method void Close()
		self:ClearClones()
		local canvas = nil
		if isvalid(self.group) then canvas = self.group.CanvasGroupComponent end
		if canvas ~= nil then
			_TweenLogic:PlayTween(1.0, 0.0, self.CloseFadeSeconds, EaseType.QuadEaseIn, function(v)
				if isvalid(self.group) and self.group.CanvasGroupComponent ~= nil then self.group.CanvasGroupComponent.GroupAlpha = v end
			end)
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(self.group) then
				self.group.Enable = false
				if self.group.CanvasGroupComponent ~= nil then self.group.CanvasGroupComponent.GroupAlpha = 1 end
			end
			self._active = false
			self._finishing = false
		end, self.CloseFadeSeconds)
	end

	@ExecSpace("Client")
	method void OnRewardGranted(integer amount)
		-- 서버가 다이아를 지급했다 — 대화 상자 자리에서 상단 다이아 배지로 날린다(도착할 때 숫자가 오른다)
		if not self._rewardPending then return end
		self._rewardPending = false
		_RewardFlyUI:Fly("diamond", amount, self.DiamondIconRUID, self._flyFrom, 0)
		log("LobbyTutorialUI: reward granted " .. amount)
	end

	-- 테스트 전용(클라 콘솔): 저장과 무관하게 지금 바로 1단계부터 다시 보여준다(끝까지 넘기면 서버가 이미 봤음이면 지급 안 함)
	@ExecSpace("ClientOnly")
	method void DebugReplay()
		self._seenLocal = false
		self._active = false
		self:Begin()
	end

end
