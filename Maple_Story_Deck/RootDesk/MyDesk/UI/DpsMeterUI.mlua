@Logic
script DpsMeterUI extends Logic

	-- 인게임 대미지 미터 화면(유저 지정 2026-09-17) — 좌측 반투명 패널, 버튼으로 접기/펼치기.
	-- 한 줄 = 스킬 아이콘 + 가로 막대 + 이번 판 누적 대미지 + 전체 대비 비율(%). 스킬 이름은 표시하지 않는다(유저 지정).
	-- 상위 TopSkillCount개 스킬만 따로 보여주고 나머지(출처 없는 대미지 포함)는 "기타" 한 줄(아이콘 없음, 회색 막대)로 묶는다.
	-- 맨 아래 "총 대미지". 처음엔 DPS(누적÷시간)였는데 시간이 갈수록 숫자가 내려가 이상하다는 피드백으로 누적 대미지로 바꿨다.
	-- 데이터는 DpsMeterLogic.Snapshot(@Sync, 1초 갱신)을 읽기만 한다. UI 엔티티: ui/DefaultGroup.ui 의 DpsMeter 하위.

	property Entity dpsMeterRoot = "1eb31807-458a-4c1f-859d-e0094ec3aff7"
	property ButtonComponent toggleBtn = "65e2e01f-7e7d-427e-9778-d422f81553fd"
	property TextGUIRendererComponent toggleText = "65e2e01f-7e7d-427e-9778-d422f81553fd"
	property Entity dpsPanel = "390635d6-1377-4cc8-b909-4e07b9d23b09"
	property TextGUIRendererComponent totalText = "d47d0701-50ce-4a2f-9106-94351935e0b6"

	-- .ui에 만들어 둔 줄 수(Board/Line1~Line7) = 스킬 TopSkillCount개 + 기타 1줄
	-- ⚠ 패널 경로가 Panel이 아니라 Board, 줄이 Row가 아니라 Line인 이유: 같은 경로를 remove 후 재생성하면 Maker가 자식을
	--   임포트하지 않아(2026-09-17 재현 — 줄 0개) 새 이름으로 다시 만들었다. Panel/Row 이름은 재사용하지 말 것.
	property integer RowCount = 7
	property integer TopSkillCount = 6
	property number BarFullWidth = 130
	property number RefreshInterval = 0.5
	-- 패널 높이 = 위 여백(제목 줄) + 줄 수 × 줄 간격 + 아래 여백(총 대미지 줄) — DefaultGroup.ui 배치와 같은 값
	property number PanelTopPadding = 44
	property number RowSpacing = 44
	property number PanelBottomPadding = 42
	-- 유저 지정(2026-09-18): 미터를 화면 왼쪽 끝에 붙였더니 줄이 늘어나면 좌측 이동 버튼(BtnMapLeft,
	-- 화면 중앙 높이 x40~130)과 겹친다 → 한 열에 RowsPerColumn줄까지만 쌓고, 넘치면 오른쪽에 열을 하나 더 만든다.
	-- 줄 위치는 이 값들로 매 갱신마다 다시 계산하므로 .ui의 Line1~7 원래 좌표는 무시된다.
	property integer RowsPerColumn = 4
	property number ColumnSpacing = 350
	property number RowStartX = 10
	-- 패널 가로 = 열 수 × ColumnSpacing + 좌우 여백
	property number PanelSidePadding = 20
	property string ToggleOpenLabel = "DPS 접기"
	property string ToggleClosedLabel = "DPS 보기"
	property Color SkillBarColor = Color(1.0, 0.604, 0.235, 1.0)
	property Color EtcBarColor = Color(0.6, 0.6, 0.6, 1.0)

	property boolean _collapsed = false
	property boolean _shown = false
	property integer _timerId = 0
	property any _toggleHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼 연결 + 주기 갱신 시작. 인게임이 아니면 숨겨 둔다
		if not isvalid(self.dpsMeterRoot) then
			log_warning("DpsMeterUI: root entity not bound")
			return
		end
		self._T.rows = {}
		if not isvalid(self.dpsPanel) or not isvalid(self.totalText) then
			log_warning("DpsMeterUI: board/total not bound")
			return
		end
		for i = 1, self.RowCount do
			local row = self.dpsPanel:GetChildByName("Line" .. i, false)
			if row ~= nil then
				self._T.rows[i] = {
					entity = row,
					icon = row:GetChildByName("Icon", false),
					bar = row:GetChildByName("Bar", false),
					value = row:GetChildByName("Value", false),
					percent = row:GetChildByName("Percent", false),
					etcLabel = row:GetChildByName("EtcLabel", false),
					card = -1,
				}
				row:SetEnable(false)
			end
		end
		self._toggleHandler = self.toggleBtn.Entity:ConnectEvent(ButtonClickEvent, function() self:ToggleCollapsed() end)
		self.dpsMeterRoot:SetEnable(false)
		self._shown = false
		self:ApplyCollapsedVisual()
		self._timerId = _TimerService:SetTimerRepeat(function()
			if isvalid(self) then self:Refresh() end
		end, self.RefreshInterval)
		log("DpsMeterUI: ready (rows=" .. #self._T.rows .. ")")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 타이머/이벤트 정리
		if self._timerId ~= 0 then _TimerService:ClearTimer(self._timerId) end
		if self._toggleHandler ~= nil and isvalid(self.toggleBtn) then
			self.toggleBtn.Entity:DisconnectEvent(ButtonClickEvent, self._toggleHandler)
		end
	end

	@ExecSpace("ClientOnly")
	method void ToggleCollapsed()
		-- 접기/펼치기 — 접으면 버튼만 남는다(한 판이 끝나도 상태 유지)
		self._collapsed = not self._collapsed
		self:ApplyCollapsedVisual()
		if not self._collapsed then self:Refresh() end
		log("DpsMeterUI: collapsed=" .. tostring(self._collapsed))
	end

	@ExecSpace("ClientOnly")
	method void ApplyCollapsedVisual()
		-- 패널 on/off + 버튼 문구
		self.dpsPanel:SetEnable(not self._collapsed)
		if self._collapsed then
			self.toggleText.Text = self.ToggleClosedLabel
		else
			self.toggleText.Text = self.ToggleOpenLabel
		end
	end

	@ExecSpace("ClientOnly")
	method string FormatNumber(number value)
		-- 천 단위 콤마(12,450)
		local s = tostring(math.floor(value + 0.5))
		local formatted = s
		while true do
			local replaced, count = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
			formatted = replaced
			if count == 0 then break end
		end
		return formatted
	end

	@ExecSpace("ClientOnly")
	method void Refresh()
		-- 인게임일 때만 보이고, 펼친 상태면 상위 스킬 + 기타 + 총 대미지를 그린다
		local inRun = _GameManager.GameStarted and not _GameManager.GameOver
		if inRun ~= self._shown then
			self._shown = inRun
			self.dpsMeterRoot:SetEnable(inRun)
		end
		if not inRun or self._collapsed then return end

		local snap = _DpsMeterLogic:ParseSnapshot()
		local total = 0
		local etc = 0
		local shown = {}
		for _, r in ipairs(snap.rows) do
			total = total + r.damage
			if r.card ~= 0 and #shown < self.TopSkillCount then
				table.insert(shown, { card = r.card, damage = r.damage })
			else
				etc = etc + r.damage
			end
		end
		if etc > 0 then table.insert(shown, { card = 0, damage = etc }) end
		self.totalText.Text = self:FormatNumber(total)

		-- 패널 크기를 표시 중인 줄 수에 맞춘다. 한 열에 RowsPerColumn줄까지만 쌓고 넘치면 오른쪽 열로
		-- 넘어가므로(이동 버튼과 겹치지 않게), 높이는 "가장 긴 열"의 줄 수로, 가로는 열 수로 정한다.
		local rowsPerCol = math.max(1, self.RowsPerColumn)
		local columns = math.max(1, math.ceil(#shown / rowsPerCol))
		local rowsInFirstColumn = math.min(#shown, rowsPerCol)
		local panelT = self.dpsPanel.UITransformComponent
		local wantHeight = self.PanelTopPadding + rowsInFirstColumn * self.RowSpacing + self.PanelBottomPadding
		local wantWidth = columns * self.ColumnSpacing + self.PanelSidePadding
		if math.abs(panelT.RectSize.y - wantHeight) > 0.5 or math.abs(panelT.RectSize.x - wantWidth) > 0.5 then
			panelT.RectSize = Vector2(wantWidth, wantHeight)
		end

		-- 막대 길이는 가장 큰 줄 기준(기타가 제일 클 수도 있으니 전체에서 최대값)
		local maxDamage = 1
		for _, d in ipairs(shown) do
			if d.damage > maxDamage then maxDamage = d.damage end
		end
		local safeTotal = total
		if safeTotal <= 0 then safeTotal = 1 end

		for i, rowInfo in ipairs(self._T.rows) do
			local data = shown[i]
			if data == nil then
				if rowInfo.entity.Enable then rowInfo.entity:SetEnable(false) end
				rowInfo.card = -1
			else
				if not rowInfo.entity.Enable then rowInfo.entity:SetEnable(true) end
				-- 열/행 배치 — i번째 줄은 (i-1)을 RowsPerColumn으로 나눈 몫이 열, 나머지가 그 열 안의 순번
				local col = math.floor((i - 1) / rowsPerCol)
				local rowInCol = (i - 1) % rowsPerCol
				local rowT = rowInfo.entity.UITransformComponent
				local wantPos = Vector2(self.RowStartX + col * self.ColumnSpacing, -(self.PanelTopPadding + rowInCol * self.RowSpacing))
				if math.abs(rowT.anchoredPosition.x - wantPos.x) > 0.5 or math.abs(rowT.anchoredPosition.y - wantPos.y) > 0.5 then
					rowT.anchoredPosition = wantPos
				end
				if rowInfo.card ~= data.card then
					rowInfo.card = data.card
					if rowInfo.icon ~= nil then
						if data.card == 0 then
							rowInfo.icon:SetEnable(false)
						else
							rowInfo.icon:SetEnable(true)
							rowInfo.icon.SpriteGUIRendererComponent.ImageRUID = DataRef(_CardManager:GetCardIconRUID(data.card))
						end
					end
					if rowInfo.etcLabel ~= nil then
						rowInfo.etcLabel:SetEnable(data.card == 0)
					end
					if rowInfo.bar ~= nil then
						if data.card == 0 then
							rowInfo.bar.SpriteGUIRendererComponent.Color = self.EtcBarColor
						else
							rowInfo.bar.SpriteGUIRendererComponent.Color = self.SkillBarColor
						end
					end
				end
				if rowInfo.bar ~= nil then
					local t = rowInfo.bar.UITransformComponent
					t.RectSize = Vector2(math.max(4, self.BarFullWidth * data.damage / maxDamage), t.RectSize.y)
				end
				if rowInfo.value ~= nil then
					rowInfo.value.TextGUIRendererComponent.Text = self:FormatNumber(data.damage)
				end
				if rowInfo.percent ~= nil then
					rowInfo.percent.TextGUIRendererComponent.Text = string.format("%.1f%%", data.damage * 100 / safeTotal)
				end
			end
		end
	end

end
