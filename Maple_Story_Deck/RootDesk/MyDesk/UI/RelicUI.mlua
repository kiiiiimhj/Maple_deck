@Logic
script RelicUI extends Logic

	property ScrollLayoutGroupComponent relicScroll = "e7c58f67-b7f5-461b-89fb-3f7e16dd64bc"
	property Entity scrollTouchArea = "9481ea28-3f0f-4b9c-9d7c-73ae0f3b267e"
	property SliderComponent scrollBar = "238ef981-ac51-4d81-a81e-3546a41ea4b9"
	-- 그리드 총 폭(2342) - 뷰포트 폭(1300) = 실제로 드래그 가능한 스크롤 폭(px)
	property number scrollableRangePx = 1042

	property any _dragHandler = nil
	property any _scrollBarHandler = nil
	-- 카드 쪽 스크롤(드래그)이 스크롤바 핸들 위치를 코드로 갱신할 때 true로 세워서,
	-- 그 갱신이 다시 SliderValueChangedEvent로 되돌아와 카드를 또 움직이는 무한 루프를 막는다
	property boolean _syncingScrollBar = false

	-- 유물 원래 이름 캐시 — 업그레이드 팝업(GetRelicBaseName)에서 재사용하기 위해 최초 1회만 읽어서 저장해둔다
	property any _relicBaseNames = nil

	-- 드래그(스크롤)와 탭(클릭)을 구분하는 최대 이동 거리(px) — 이보다 적게 움직였으면 탭으로 간주
	property number _tapMoveThreshold = 12
	-- 슬롯별 Down/Up/Drag 핸들러 목록 — OnEndPlay에서 전부 해제한다
	property any _slotHandlers = nil
	-- 슬롯별 터치 시작 좌표 (한 번에 하나의 터치만 가정)
	property any _slotTouchDownPoints = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 유물 그리드를 좌우로 끌면 스크롤되고, 하단 스크롤바를 직접 끌어도 그리드가 같이 움직이도록 연결한다
		self._dragHandler = self.scrollTouchArea:ConnectEvent(UITouchDragEvent, self.OnScrollDrag)
		self._scrollBarHandler = self.scrollBar.Entity:ConnectEvent(SliderValueChangedEvent, self.OnScrollBarChanged)
		self._relicBaseNames = {}
		self._slotHandlers = {}
		self._slotTouchDownPoints = {}
		self:CacheRelicBaseNamesAndConnectSlots()
		self:RefreshAllRelicSlots()
		-- 스크롤/스크롤바가 항상 맨 처음(왼쪽)부터 시작하도록 강제한다 - .ui에 저장된 기본값에
		-- 기대지 않고 코드에서 확정적으로 리셋한다
		self.relicScroll:SetScrollNormalizedPosition(UITransformAxis.Horizontal, 0)
		self:SyncScrollBar(0)
		log("RelicUI started")
	end

	@ExecSpace("ClientOnly")
	method void CacheRelicBaseNamesAndConnectSlots()
		-- RelicSlot_N에는 ButtonComponent 대신 UITouchReceiveComponent가 붙어있다 — Down/Up/Drag를
		-- 슬롯 자신에게서 직접 받으므로(스크롤이 얼마나 됐든 event.Entity=그 슬롯 자체), 화면 좌표를
		-- 역산해서 어느 슬롯인지 추측할 필요가 없다. Drag는 그대로 부모 스크롤 핸들러로 전달해
		-- 카드 위에서 시작된 스와이프도 정상적으로 스크롤되게 한다.
		local list = self.relicScroll.Entity
		if not isvalid(list) then return end
		for i = 0, _RelicInventory.relicCount - 1 do
			local slot = list:GetChildByName("RelicSlot_" .. tostring(i))
			if isvalid(slot) then
				local nameEntity = slot:GetChildByName("Name")
				if isvalid(nameEntity) then
					self._relicBaseNames[tostring(i)] = nameEntity.TextComponent.Text
				end
				local capturedIndex = i
				local downH = slot:ConnectEvent(UITouchDownEvent, function(event) self:OnSlotTouchDown(event, capturedIndex) end)
				local upH = slot:ConnectEvent(UITouchUpEvent, function(event) self:OnSlotTouchUp(event, capturedIndex) end)
				local dragH = slot:ConnectEvent(UITouchDragEvent, self.OnScrollDrag)
				table.insert(self._slotHandlers, { entity = slot, downHandler = downH, upHandler = upH, dragHandler = dragH })
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnSlotTouchDown(UITouchDownEvent event, integer relicIndex)
		self._slotTouchDownPoints[tostring(relicIndex)] = event.TouchPoint
	end

	@ExecSpace("ClientOnly")
	method void OnSlotTouchUp(UITouchUpEvent event, integer relicIndex)
		-- 누른 지점과 뗀 지점이 거의 같으면(드래그가 아니면) 탭으로 판정한다
		local downPoint = self._slotTouchDownPoints[tostring(relicIndex)]
		if downPoint == nil then return end
		local dx = event.TouchPoint.x - downPoint.x
		local dy = event.TouchPoint.y - downPoint.y
		local distance = math.sqrt(dx * dx + dy * dy)
		if distance > self._tapMoveThreshold then return end
		self:OnRelicSlotClicked(relicIndex)
	end

	@ExecSpace("ClientOnly")
	method void OnRelicSlotClicked(integer relicIndex)
		-- 유물을 누르면 바로 레벨업하지 않고, 상세/업그레이드 팝업을 띄운다
		_RelicUpgradeUI:OpenForRelic(relicIndex)
	end

	@ExecSpace("ClientOnly")
	method string GetRelicBaseName(integer relicIndex)
		-- 레벨 표기가 안 붙은 원래 유물명을 돌려준다 (업그레이드 팝업에서 재사용)
		local baseName = self._relicBaseNames[tostring(relicIndex)]
		if baseName ~= nil then return baseName end
		return "유물"
	end

	@ExecSpace("ClientOnly")
	method string GetRelicIconRuid(integer relicIndex)
		-- RelicSlot_N/Icon에서 실제 사용 중인 아이콘 RUID를 그대로 읽어온다 (업그레이드 팝업에서 재사용)
		local list = self.relicScroll.Entity
		if not isvalid(list) then return "" end
		local slot = list:GetChildByName("RelicSlot_" .. tostring(relicIndex))
		if not isvalid(slot) then return "" end
		local icon = slot:GetChildByName("Icon")
		if not isvalid(icon) then return "" end
		return icon.SpriteGUIRendererComponent.ImageRUID.DataId
	end

	@ExecSpace("ClientOnly")
	method void RefreshAllRelicSlots()
		-- 유물 획득 개수/레벨(RelicInventory.Counts/Levels)이 바뀔 때마다 18개 슬롯을 전부 다시 그린다
		local list = self.relicScroll.Entity
		if not isvalid(list) then return end
		for i = 0, _RelicInventory.relicCount - 1 do
			local slot = list:GetChildByName("RelicSlot_" .. tostring(i))
			if isvalid(slot) then
				local key = tostring(i)
				local count = 0
				if _RelicInventory.Counts[key] ~= nil then count = _RelicInventory.Counts[key] end
				-- 최소 1개를 뽑아 소유하는 순간부터 Lv1(강화 전), 한 번도 못 뽑았으면 0
				local level = _RelicInventory:GetEffectiveLevel(i)
				local maxLevel = _RelicInventory.maxLevel

				-- 진행바는 "다음 레벨에 필요한 조각 수"를 분모로 삼는다 — 레벨마다 요구치가 다르므로
				-- (Lv1=2, Lv2=4, Lv3=10...) 레벨업할 때마다 분모 자체가 커지면서 자연스럽게 다시 채워나가는
				-- 모습으로 보인다(강화 직후 조각을 소비하면 분자도 줄어서 실제로 "초기화"된 것처럼 보임)
				-- 한 번도 못 뽑은 유물은 카드 전체를 어둡게 덮고 자물쇠를 얹는다(유저 요청).
				-- Dim은 슬롯의 "마지막" 자식이라 아이콘뿐 아니라 레벨/이름/진행바 텍스트 위에까지 덮인다
				-- (형제 배열 순서가 곧 그리는 순서 — Icon의 자식으로 두면 텍스트가 딤 위로 떠버린다).
				-- Lock은 Dim의 자식이라 같이 켜지고 꺼진다
				local dim = slot:GetChildByName("Dim")
				if isvalid(dim) then dim.Enable = level <= 0 end

				local progressText = slot:GetChildByName("ProgressText")
				local progressFill = slot:GetChildByName("ProgressFill")
				if level <= 0 then
					if isvalid(progressText) then progressText.TextComponent.Text = "미보유" end
					if isvalid(progressFill) then progressFill.SpriteGUIRendererComponent.FillAmount = 0 end
				elseif level >= maxLevel then
					if isvalid(progressText) then progressText.TextComponent.Text = "MAX" end
					if isvalid(progressFill) then progressFill.SpriteGUIRendererComponent.FillAmount = 1 end
				else
					local nextFragmentCost = _RelicInventory:GetFragmentCostForLevel(level)
					if isvalid(progressText) then
						progressText.TextComponent.Text = tostring(count) .. "/" .. tostring(nextFragmentCost)
					end
					if isvalid(progressFill) then
						local amount = count / nextFragmentCost
						if amount > 1 then amount = 1 end
						progressFill.SpriteGUIRendererComponent.FillAmount = amount
					end
				end

				local nameEntity = slot:GetChildByName("Name")
				if isvalid(nameEntity) then
					local baseName = self._relicBaseNames[key]
					if baseName == nil then baseName = nameEntity.TextComponent.Text end
					nameEntity.TextComponent.Text = baseName
				end

				-- 아이콘 프레임 위에 별도로 얹힌 레벨 표시 — 레벨은 여기서만 보여준다
				local levelEntity = slot:GetChildByName("Level")
				if isvalid(levelEntity) then
					levelEntity.TextComponent.Text = "Lv." .. tostring(level)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnScrollDrag(UITouchDragEvent event)
		-- 좌로 끌면(TouchDelta.x < 0) 오른쪽 열 쪽(정규화 값 증가)으로, 우로 끌면 반대로 스크롤한다
		local current = self.relicScroll:GetScrollNormalizedPosition(UITransformAxis.Horizontal)
		local delta = -event.TouchDelta.x / self.scrollableRangePx
		local newValue = math.max(0, math.min(1, current + delta))
		self.relicScroll:SetScrollNormalizedPosition(UITransformAxis.Horizontal, newValue)
		self:SyncScrollBar(newValue)
	end

	@ExecSpace("ClientOnly")
	method void SyncScrollBar(number normalizedValue)
		-- 드래그로 바뀐 스크롤 위치를 하단 슬라이더 핸들에 반영한다
		self._syncingScrollBar = true
		self.scrollBar.Value = normalizedValue
		self._syncingScrollBar = false
	end

	@ExecSpace("ClientOnly")
	method void OnScrollBarChanged(SliderValueChangedEvent event)
		-- 방금 SyncScrollBar()가 코드로 쓴 값이 되돌아온 것이면 무시 — 사용자가 직접 핸들을 끈 경우만 처리
		if self._syncingScrollBar then return end
		self.relicScroll:SetScrollNormalizedPosition(UITransformAxis.Horizontal, event.Value)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._dragHandler then self.scrollTouchArea:DisconnectEvent(UITouchDragEvent, self._dragHandler) end
		if self._scrollBarHandler then self.scrollBar.Entity:DisconnectEvent(SliderValueChangedEvent, self._scrollBarHandler) end
		if self._slotHandlers then
			for _, rec in ipairs(self._slotHandlers) do
				if isvalid(rec.entity) then
					rec.entity:DisconnectEvent(UITouchDownEvent, rec.downHandler)
					rec.entity:DisconnectEvent(UITouchUpEvent, rec.upHandler)
					rec.entity:DisconnectEvent(UITouchDragEvent, rec.dragHandler)
				end
			end
		end
	end

end
