@Logic
script TutorialGuideUI extends Logic

	-- 첫 플레이 온보딩 튜토리얼의 화면 연출 담당(클라이언트 전용).
	-- 진행 단계는 서버(TutorialLogic)가 정하고 Multicast로 내려주며, 여기서는 그리기만 한다.
	--
	--   Step1  상단 배너만 노출 — "몬스터를 잡아서 레벨을 올려보세요!"
	--   Step2  딤 + 배너 + 손가락. 레벨업 카드 3장(Card6~8)과 미리보기 툴팁만 딤 위로 올려서 살린다
	--   Step3  딤/손가락 해제 후 마무리 배너, Step3Seconds 뒤 자동으로 사라짐
	--
	-- ⚠ 딤이 카드를 가리지 않게 하는 건 _UILogic:SetSiblingIndex다. .ui 파일에 형제 순서를 박아두면
	--   다른 HUD 요소 순서까지 흔들리므로(ToastGroup 사고 참고) 런타임에만 올린다. 한 번 올라간
	--   카드/툴팁은 되돌리지 않는다 — 둘 다 평소엔 꺼져 있는 오버레이라 맨 앞에 있어도 무해하고,
	--   되돌리면 오히려 툴팁이 카드 뒤로 가는 순서 사고가 난다.

	property Entity dimEntity = "912c0579-4e58-4f26-bf8e-a4381830a99a"

	property Entity bannerEntity = "5b182aaa-4d27-4b79-8098-c94529cc0379"

	property TextGUIRendererComponent bannerText = "e03f8f8e-c70f-4038-9a91-4a79ffaf2663"

	property Entity fingerEntity = "b57218f3-b1b6-477b-9a0a-2aa0f4cb7c85"

	-- 레벨업 선택 카드 3장 + 홀드 미리보기 툴팁(CardManager 소유) — 딤 위로 올릴 대상
	property Entity choiceCard1 = "dca81800-b071-410b-b2cb-d33ec977488a"

	property Entity choiceCard2 = "a8324fff-1c67-492e-a60f-ee76c786a2e3"

	property Entity choiceCard3 = "2a1cbc75-3a0a-46fe-a2a4-e5f24a707167"

	property Entity cardTooltip = "4615be3c-8628-4e55-ab57-ef285284d988"

	property string StepAimText = "MLUA_TUTORIALGUIDEUI_001"

	-- ── 에임 단계 시연(유저 지정 2026-09-20) ────────────────────────────────────
	-- 실제 몬스터 대신 화면 중앙의 "가짜" 초록 달팽이(UI)를 크게 띄워 손가락으로 가리키고,
	-- 누르면 에임 표식 → 썬더볼트 → 다이 연출까지 보여준 뒤 서버에 끝났다고 알린다.
	-- UI 딤이 전부 덮으므로 뒤의 진짜 몬스터는 어둡게 깔리고 눌리지 않는다.
	property Entity aimStage = "8c356b00-ef31-4b7c-92d9-997d381f7638"
	property ButtonComponent aimMob = "f9006698-7e9c-4cab-a9af-5ee2da41c64e"
	property Entity aimMark = "b52654ab-1eeb-412a-a195-f57783061f8f"
	property Entity aimBolt = "89aa0128-7e51-4c12-80c0-c2149c3c66ba"
	property string AimMobStandRUID = "2db94405cf0445f5be2b60a02c21dda5"
	property string AimMobHitRUID = "a3feafdb656943baa3f8897a7042b21f"
	property string AimMobDieRUID = "a25ed762135448ccb2307604f3179565"
	property Vector2 AimMobStandSize = Vector2(40, 28)
	property Vector2 AimMobHitSize = Vector2(44, 36)
	property Vector2 AimMobDieSize = Vector2(38, 22)
	-- 달팽이 확대 배율(원본 픽셀 × 이 값 = 화면 UI px)
	property number AimMobScale = 6
	property Vector2 AimMobPos = Vector2(0, -40)
	property string AimMarkRUID = "47ea73beb91641cf99c982e95f7fb0d9"
	property string AimBoltRUID = "33fc60d9910448a2b36035277b28c354"
	property string AimBoltSoundRUID = "2a0ed76e4fd344368bad3691347a6006"
	-- 에임 표식: 원본 71px × 이 배율, 등장할 때 PopScale배 크게 나왔다가 줄어든다(실제 PlayFocusMark와 같은 팝)
	property number AimMarkScale = 3.2
	property number AimMarkPopScale = 1.6
	property number AimMarkPopDuration = 0.22
	-- 연출 타이밍(초): 누름 → 표식 → (BoltDelay) 번개+피격 → (DieDelay) 다이 → (DieDuration) 끝
	property number AimBoltDelay = 0.35
	property number AimDieDelay = 0.4
	property number AimDieDuration = 0.95
	-- 가짜 달팽이를 가리킬 때 손가락 미세 보정(UI px) — 몬스터 손가락과 같은 규칙(y 음수 = 아래로)
	-- 0,0이면 손바닥이 달팽이 머리를 가려서(스샷 실측) 왼쪽 아래로 뺐다
	property Vector2 AimMobFingerNudge = Vector2(-40, -70)
	property boolean _aimDemoPlaying = false
	property any _aimMobHandler = nil

	property string Step1Text = "MLUA_TUTORIALGUIDEUI_002"

	property string Step2Text = "MLUA_TUTORIALGUIDEUI_003"

	-- ⚠ 이 문구를 더 길게 고칠 거면 .ui의 TutorialBanner(폭 1400) / Label(폭 1340)도 같이 키울 것.
	-- 34pt 기준 한 글자가 약 25px이라 1340px ≈ 53자까지가 한 줄로 들어간다
	property string Step3Text = "MLUA_TUTORIALGUIDEUI_004"

	-- 마무리 배너가 화면에 남아 있는 시간(초)
	property number Step3Seconds = 4.0

	-- 이스터에그 튜토리얼(TutorialLogic.BeginEggTutorial) 안내 문구 — 유저 지정 2026-09-17
	property string EggText = "MLUA_TUTORIALGUIDEUI_005"

	-- 손가락이 처음 나타난 뒤 배너가 뜨기까지 기다리는 시간(초) — 유저 지정 2026-09-17
	property number EggBannerDelaySeconds = 0.3

	-- 손가락이 나타나면 배너 예약을 한 번만 걸기 위한 플래그
	property boolean _eggBannerScheduled = false

	-- 손가락이 가리킬 이스터에그 오브젝트(손가락 모드 3). 스프라이트는 발밑 기준이라 몸통쯤을 가리키도록 이만큼 올린다
	property any _eggTarget = nil
	property string _eggTargetPath = ""
	property number EggTargetWorldYOffset = 0.5

	property integer _step3TimerId = 0

	-- 손가락 위치 수동 조정 모드(유저 요청 2026-09-11: "내가 손가락은 직접 움직일 테니").
	-- true면 아래 FingerRestPos를 무시하고 **.ui에 저장된 TutorialFinger의 위치**를 그대로 기준으로
	-- 삼는다 — Maker 에디터에서 TutorialFinger를 끌어다 놓은 자리가 곧 손가락 자리가 된다
	-- (그때는 .ui의 TutorialFinger를 enable=true로 저장해야 에디터에서 보이고 잡힌다).
	-- 2026-09-15 유저가 (638, -57)로 확정 → FingerRestPos에 박고 끔, .ui TutorialFinger도 enable=false로 저장.
	property boolean ManualFingerPlacement = false

	-- 손가락 "콕콕" — 쉬는 자리에서 카드 쪽으로 찍었다가 돌아오는 왕복.
	-- 첫 번째 카드(Card6)는 화면 우측 x 660~790 / y -40~125 구간이고, 가이드는 그 **왼쪽 바깥**에서
	-- 오른쪽(카드 쪽)을 가리킨다. ManualFingerPlacement=false일 때 이 값이 기준 자리다(유저 확정 2026-09-15)
	-- 2026-09-19: 선택 카드 3장을 60 올려서(다시뽑기 버튼 자리) 손가락도 (638,-57) → (638,3)
	property Vector2 FingerRestPos = Vector2(638, 3)

	-- 찍는 방향/거리. 왼쪽에서 카드를 향해 찌르므로 오른쪽 위로 움직인다
	property Vector2 FingerTapOffset = Vector2(22, 20)

	property number FingerTapPeriod = 0.7

	-- 실제로 왕복의 기준이 되는 자리. ManualFingerPlacement면 .ui에 저장된 위치를 OnBeginPlay에서
	-- 한 번 읽어 여기에 담는다(애니메이션이 좌표를 덮어쓰기 전에 읽어야 하므로 반드시 시작 시점에)
	property Vector2 _fingerBasePos = Vector2(0, 0)

	property number _fingerTime = 0

	property boolean _fingerActive = false

	-- 손가락이 무엇을 가리키는가: 0 = 꺼짐, 1 = 몬스터 추적(예전 에임 단계, 지금은 안 씀), 2 = 카드 고정(카드 단계),
	-- 3 = 이스터에그 오브젝트, 4 = 에임 시연 가짜 달팽이(2026-09-20~)
	property integer _fingerMode = 0

	-- ── 에임 단계: 손가락이 살아있는 몬스터를 따라다닌다 ─────────────────────────────
	-- 손끝이 스프라이트 중심에서 얼마나 떨어져 있는지(UI px). 추적할 때 이 값만큼 빼서 배치해야
	-- **손끝**이 몬스터 위에 오고 손바닥이 몬스터를 가리지 않는다. 카드 단계는 유저가 직접 맞춘
	-- 고정 좌표를 쓰므로 이 값과 무관하다
	property Vector2 FingerTipOffset = Vector2(86, 40)

	-- 몬스터 엔티티 좌표는 **발밑**이고 스프라이트는 그 위로 그려진다(FocusMarkYOffset과 같은 이유).
	-- 몸통쯤을 가리키도록 월드 기준으로 이만큼 올린다
	property number AimTargetWorldYOffset = 0.5

	-- ★ 에임 단계 손가락 위치 미세 보정(UI px) — **여기만 고치면 된다**.
	--   y를 더 **작게**(음수로 크게) = 아래로,  y를 더 **크게** = 위로
	--   x를 더 크게 = 오른쪽,                   x를 더 작게 = 왼쪽
	-- 몬스터 추적 좌표(FindAimAnchor)를 계산한 뒤 마지막에 그대로 더해주는 값이라,
	-- 이 숫자만 바꾸고 refresh하면 바로 반영된다(카드 단계 손가락은 .ui 쪽 TutorialFinger 위치를 쓰므로 무관).
	property Vector2 FingerAimNudge = Vector2(0, -64)

	-- 몬스터가 화면 가장자리에 걸쳐 있으면 손가락이 화면 밖으로 나가므로 안쪽으로 가둔다
	property number AimClampX = 860

	property number AimClampY = 460

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 손가락의 기준 자리를 먼저 확정한다. 수동 배치 모드면 .ui에 저장된(=Maker에서 끌어다 놓은)
		-- 좌표를 그대로 읽는다 — 아래 HideAll/애니메이션이 좌표를 덮어쓰기 전에 읽어야 한다
		if self.ManualFingerPlacement and isvalid(self.fingerEntity) then
			self._fingerBasePos = self.fingerEntity.UITransformComponent.anchoredPosition
		else
			self._fingerBasePos = self.FingerRestPos
		end

		-- 에임 단계 가짜 달팽이 누르기
		if isvalid(self.aimMob) then
			self._aimMobHandler = self.aimMob.Entity:ConnectEvent(ButtonClickEvent, self.OnAimMobClicked)
		end
		-- 세 요소 모두 꺼진 상태로 시작한다(수동 배치 모드로 .ui에 손가락을 켜서 저장해 둔 경우에도 여기서 끈다)
		self:HideAll()
		log("TutorialGuideUI: ready (finger base = " .. self._fingerBasePos.x .. ", " .. self._fingerBasePos.y .. ")")
	end

	@ExecSpace("ClientOnly")
	method void TryStartFirstPlay()
		-- TitleUI가 인게임 진입 연출이 끝난 직후 호출한다. 이미 본 유저면 아무 일도 하지 않는다
		if _TutorialLogic:HasSeenTutorial() then return end
		if _TutorialLogic:IsActive() then return end

		_TutorialLogic:RequestBegin()
	end

	@ExecSpace("ClientOnly")
	method void ShowStepAim()
		-- 에임 안내(유저 지정 2026-09-20 개편). 서버가 게임 전체를 멈춘 상태에서
		-- UI 딤(터치 차단) 위에 가짜 초록 달팽이를 화면 중앙에 크게 띄우고 손가락으로 가리킨다.
		-- 달팽이를 누르면 PlayAimDemo가 에임 → 썬더볼트 → 다이를 보여주고 서버에 끝났다고 알린다.
		-- (예전 방식: 월드 딤 + 진짜 몬스터를 눌러 포커스 — 진짜 몬스터는 이제 딤 아래에 깔린다)
		self:ClearStep3Timer()
		self._aimDemoPlaying = false
		-- ⚠ 딤은 TutorialDim이 아니라 **AimStage 자신의 배경 스프라이트**다(2026-09-24 모바일 리포트
		--   "달팽이가 딤드 뒤에 있다"). .ui 형제 순서가 AimStage < TutorialDim이라, 런타임 SetSiblingIndex로
		--   올리는 게 기기에서 안 먹으면 달팽이가 딤 밑에 깔렸다. 부모 배경은 항상 자식(달팽이) 밑에 그려진다.
		self.dimEntity:SetEnable(false)
		self:ResetAimStage()
		_UILogic:SetSiblingIndex(self.aimStage.UITransformComponent, 1000000)
		self:ShowBanner(self.StepAimText)

		self._fingerTime = 0
		self._fingerMode = 4
		self._fingerActive = true
		self.fingerEntity:SetEnable(true)
		_UILogic:SetSiblingIndex(self.fingerEntity.UITransformComponent, 1000000)
		log("TutorialGuideUI: aim demo shown")
	end

	@ExecSpace("ClientOnly")
	method void ResetAimStage()
		-- 가짜 달팽이를 서 있는 모습으로 되돌리고 표식/번개는 숨긴다
		if not isvalid(self.aimStage) then return end
		self.aimStage:SetEnable(true)
		self:SetAimMobClip(self.AimMobStandRUID, self.AimMobStandSize, true)
		local mobTf = self.aimMob.Entity.UITransformComponent
		mobTf.anchoredPosition = self.AimMobPos
		mobTf.Scale = Vector3(1, 1, 1)
		self.aimMob.Entity.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
		self.aimMob.Entity:SetEnable(true)
		self.aimMark:SetEnable(false)
		self.aimBolt:SetEnable(false)
	end

	@ExecSpace("ClientOnly")
	method void SetAimMobClip(string ruid, Vector2 nativeSize, boolean loop)
		-- 액션마다 원본 크기가 달라서 RectSize도 같이 맞춘다(GachaUI.SetBossAction과 같은 방식)
		local sprite = self.aimMob.Entity.SpriteGUIRendererComponent
		sprite.ImageRUID = DataRef(ruid)
		if loop then
			sprite.AnimClipPlayType = SpriteAnimClipPlayType.Loop
		else
			sprite.AnimClipPlayType = SpriteAnimClipPlayType.Onetime
		end
		self.aimMob.Entity.UITransformComponent.RectSize = Vector2(nativeSize.x * self.AimMobScale, nativeSize.y * self.AimMobScale)
	end

	@ExecSpace("ClientOnly")
	method void OnAimMobClicked()
		-- 가짜 달팽이를 눌렀다 — 연출은 한 번만
		if self._fingerMode ~= 4 or self._aimDemoPlaying then return end
		self._aimDemoPlaying = true
		self:PlayAimDemo()
	end

	@ExecSpace("ClientOnly")
	method void PlayAimDemo()
		-- 에임 표식 팝 → 썬더볼트 + 피격 → 다이 → 서버에 완료 알림
		self._fingerActive = false
		self.fingerEntity:SetEnable(false)
		local mobPos = self.AimMobPos
		local markSize = 71 * self.AimMarkScale

		-- 1) 에임 표식: 크게 나왔다가 원래 크기로(실제 포커스 표식과 같은 팝)
		local mark = self.aimMark
		local markTf = mark.UITransformComponent
		markTf.anchoredPosition = mobPos
		markTf.RectSize = Vector2(markSize, markSize)
		mark.SpriteGUIRendererComponent.ImageRUID = DataRef(self.AimMarkRUID)
		mark.SpriteGUIRendererComponent.AnimClipPlayType = SpriteAnimClipPlayType.Loop
		markTf.Scale = Vector3(self.AimMarkPopScale, self.AimMarkPopScale, 1)
		mark:SetEnable(true)
		_TweenLogic:ScaleTo(mark, Vector2(1, 1), self.AimMarkPopDuration, EaseType.QuadEaseOut)
		log("TutorialGuideUI: aim demo — mark")

		-- 2) 썬더볼트: 번개 한 번(Onetime) + 달팽이 피격 모습 + 효과음
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not self._aimDemoPlaying then return end
			local bolt = self.aimBolt
			bolt.UITransformComponent.anchoredPosition = mobPos
			local boltSprite = bolt.SpriteGUIRendererComponent
			boltSprite.ImageRUID = DataRef(self.AimBoltRUID)
			boltSprite.AnimClipPlayType = SpriteAnimClipPlayType.Onetime
			bolt:SetEnable(true)
			_SoundOptionLogic:PlaySfx(self.AimBoltSoundRUID, 1.0)
			self:SetAimMobClip(self.AimMobHitRUID, self.AimMobHitSize, false)
			log("TutorialGuideUI: aim demo — thunderbolt")

			-- 3) 다이 연출: 표식을 걷고 달팽이 die1 한 번
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) or not self._aimDemoPlaying then return end
				self.aimMark:SetEnable(false)
				self:SetAimMobClip(self.AimMobDieRUID, self.AimMobDieSize, false)
				log("TutorialGuideUI: aim demo — die")

				-- 4) 끝: 무대/딤 정리는 서버 ResumeFromAim → ShowStep1이 한다
				_TimerService:SetTimerOnce(function()
					if not isvalid(self) or not self._aimDemoPlaying then return end
					self.aimMob.Entity:SetEnable(false)
					self.aimBolt:SetEnable(false)
					_TutorialLogic:RequestAimDemoDone()
					log("TutorialGuideUI: aim demo — done")
				end, self.AimDieDuration)
			end, self.AimDieDelay)
		end, self.AimBoltDelay)
	end

	@ExecSpace("ClientOnly")
	method void HideAimStage()
		-- 가짜 달팽이 무대 전체를 끈다(단계 전환/종료/게임오버 공용)
		self._aimDemoPlaying = false
		if isvalid(self.aimStage) then self.aimStage:SetEnable(false) end
	end

	@ExecSpace("ClientOnly")
	method any FindAimMobAnchor()
		-- 손가락 모드 4 — 가짜 달팽이 몸통을 손끝이 가리키는 자리(UI 좌표)
		local target = self.AimMobPos
		local x = target.x - self.FingerTipOffset.x + self.AimMobFingerNudge.x
		local y = target.y - self.FingerTipOffset.y + self.AimMobFingerNudge.y
		return Vector2(x, y)
	end

	@ExecSpace("ClientOnly")
	method void ShowStep1()
		-- 안내 배너만. 정지가 풀려 게임이 다시 굴러가고 플레이어는 평소처럼 싸운다
		self:ClearStep3Timer()
		self:HideAimStage()
		self._fingerMode = 0
		self._fingerActive = false
		self.fingerEntity:SetEnable(false)
		self.dimEntity:SetEnable(false)
		self:ShowBanner(self.Step1Text)
	end

	@ExecSpace("ClientOnly")
	method void ShowStep2()
		-- 딤을 깔고 카드 3장 + 툴팁만 그 위로 올린 뒤, 손가락으로 카드를 찍는다.
		-- 이 단계의 딤은 터치를 막아야 한다 — 카드 말고는 아무것도 못 누르게 하는 게 목적
		self:ClearStep3Timer()
		-- ⚠ UI 딤은 켜지 않는다 — 딤은 서버가 월드 딤(CardManager.ShowTutorialAimDim)으로 깐다(2026-09-24).
		--   UI 딤 위로 카드를 올리는 SetSiblingIndex가 실제 그리기 순서를 보장하지 못해 카드가 딤 밑에 깔렸다
		self.dimEntity:SetEnable(false)
		-- (카드/툴팁 순서 올리기는 해롭지 않아 그대로 둔다 — 툴팁이 카드 위에 오게 하는 용도)
		_UILogic:SetSiblingIndex(self.choiceCard1.UITransformComponent, 1000000)
		_UILogic:SetSiblingIndex(self.choiceCard2.UITransformComponent, 1000000)
		_UILogic:SetSiblingIndex(self.choiceCard3.UITransformComponent, 1000000)
		_UILogic:SetSiblingIndex(self.cardTooltip.UITransformComponent, 1000000)

		self:ShowBanner(self.Step2Text)

		self._fingerTime = 0
		self._fingerMode = 2
		self._fingerActive = true
		self.fingerEntity:SetEnable(true)
		self.fingerEntity.UITransformComponent.anchoredPosition = self._fingerBasePos
		_UILogic:SetSiblingIndex(self.fingerEntity.UITransformComponent, 1000000)
	end

	@ExecSpace("ClientOnly")
	method void ShowStep3()
		-- 정지가 풀리는 시점. 딤/손가락을 걷고 마무리 문구만 잠깐 남긴다
		self._fingerMode = 0
		self._fingerActive = false
		self.fingerEntity:SetEnable(false)
		self.dimEntity:SetEnable(false)
		self:ShowBanner(self.Step3Text)

		self:ClearStep3Timer()
		self._step3TimerId = _TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self._step3TimerId = 0
			self:HideAll()
		end, self.Step3Seconds)
	end

	@ExecSpace("ClientOnly")
	method void ShowEggStep(string objectPath)
		-- 이스터에그 튜토리얼. 서버가 게임을 멈추고 월드 딤을 깔았다 — UI 딤은 끈 채로(버섯이 딤 위에 보여야 하고
		-- 버섯을 눌러야 하므로) 배너 + 버섯을 따라가는 손가락만 띄운다
		-- 배너는 여기서 안 띄운다 — 손가락이 실제로 나타난 뒤 EggBannerDelaySeconds 후에 뜬다(OnUpdate)
		self:ClearStep3Timer()
		self.dimEntity:SetEnable(false)
		self.bannerEntity:SetEnable(false)
		self._eggBannerScheduled = false
		self._eggTargetPath = objectPath
		self._eggTarget = _EntityService:GetEntityByPath(objectPath)
		self._fingerTime = 0
		self._fingerMode = 3
		self._fingerActive = true
		_UILogic:SetSiblingIndex(self.fingerEntity.UITransformComponent, 1000000)
		-- 실제 노출은 OnUpdate가 결정한다(대상이 아직 안 잡혔으면 꺼둔 채로 기다린다)
		self.fingerEntity:SetEnable(false)
		log("TutorialGuideUI: egg step shown (target=" .. tostring(self._eggTarget ~= nil) .. ")")
	end

	@ExecSpace("ClientOnly")
	method void HideEggStep()
		-- 버섯을 눌렀다(또는 취소) — 손가락/배너를 딤과 같은 순간에 한꺼번에 걷는다(유저 지정 2026-09-17).
		-- 아직 안 뜬 배너 예약(ClearStep3Timer)도 같이 취소된다
		self._eggTarget = nil
		self._eggTargetPath = ""
		self._eggBannerScheduled = false
		self:HideAll()
		log("TutorialGuideUI: egg step hidden")
	end

	@ExecSpace("ClientOnly")
	method any FindEggAnchor()
		-- 손가락 모드 3 — 이스터에그 오브젝트 위(UI 좌표). 대상이 없거나 숨겨졌으면 nil
		local target = self._eggTarget
		-- 맵 로드가 늦어 시작 시점에 못 찾았으면 경로로 다시 찾는다
		if not isvalid(target) and self._eggTargetPath ~= "" then
			target = _EntityService:GetEntityByPath(self._eggTargetPath)
			self._eggTarget = target
		end
		if not isvalid(target) or not target.Enable or target.TransformComponent == nil then return nil end
		local wp = target.TransformComponent.WorldPosition
		local targetUI = _UILogic:ScreenToUIPosition(
			_UILogic:WorldToScreenPosition(Vector2(wp.x, wp.y + self.EggTargetWorldYOffset)))
		local x = targetUI.x - self.FingerTipOffset.x + self.FingerAimNudge.x
		local y = targetUI.y - self.FingerTipOffset.y + self.FingerAimNudge.y
		x = math.max(-self.AimClampX, math.min(self.AimClampX, x))
		y = math.max(-self.AimClampY, math.min(self.AimClampY, y))
		return Vector2(x, y)
	end

	@ExecSpace("ClientOnly")
	method void ShowBanner(string message)
		-- 배너는 단계가 바뀔 때마다 문구만 갈아끼운다. 딤보다 항상 앞에 있어야 읽힌다
		self.bannerText.Text = _LocText:Resolve(message)
		self.bannerEntity:SetEnable(true)
		_UILogic:SetSiblingIndex(self.bannerEntity.UITransformComponent, 1000000)
	end

	@ExecSpace("ClientOnly")
	method void HideAll()
		-- 튜토리얼 종료(또는 게임오버) — 세 요소 + 에임 시연 무대를 전부 끈다
		self:ClearStep3Timer()
		self:HideAimStage()
		self._fingerMode = 0
		self._fingerActive = false
		self.dimEntity:SetEnable(false)
		self.bannerEntity:SetEnable(false)
		self.fingerEntity:SetEnable(false)
	end

	@ExecSpace("ClientOnly")
	method void SetDimBlocksTouch(boolean blocks)
		-- 딤이 터치를 가로챌지 여부. 에임 단계는 false(몬스터를 눌러야 하므로),
		-- 카드 단계는 true(카드 말고는 못 누르게)
		local sprite = self.dimEntity.SpriteGUIRendererComponent
		if sprite == nil then return end
		sprite.RaycastTarget = blocks
	end

	@ExecSpace("ClientOnly")
	method void ClearStep3Timer()
		-- 마무리 배너 자동 닫기 타이머 정리(단계가 겹칠 때 이전 타이머가 새 배너를 지우는 걸 막는다)
		if self._step3TimerId ~= 0 then
			_TimerService:ClearTimer(self._step3TimerId)
			self._step3TimerId = 0
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 손가락 왕복. 게임오버가 나면 튜토리얼 연출을 통째로 걷는다(정지 해제는 서버 안전장치가 담당)
		if _GameManager.GameOver then
			if self._fingerActive or self.bannerEntity.Enable then
				self:HideAll()
			end
			return
		end

		if not self._fingerActive then return end
		if not isvalid(self.fingerEntity) then return end

		self._fingerTime = self._fingerTime + delta
		if self._fingerTime >= self.FingerTapPeriod then
			self._fingerTime = self._fingerTime - self.FingerTapPeriod
		end

		-- 0~0.35 구간에서 빠르게 찍고, 나머지 구간에서 천천히 돌아온다("콕" 하는 느낌)
		local half = self.FingerTapPeriod * 0.35
		local t = 0
		if self._fingerTime < half then
			t = self._fingerTime / half
		else
			t = 1 - (self._fingerTime - half) / (self.FingerTapPeriod - half)
		end
		-- 부드럽게 (ease-in-out)
		local eased = t * t * (3 - 2 * t)

		-- 에임 단계에서는 기준 자리 자체가 매 프레임 몬스터를 따라간다
		local pos = self._fingerBasePos
		if self._fingerMode == 4 then
			-- 에임 시연: 화면 중앙 가짜 달팽이를 가리킨다(고정 좌표)
			pos = self:FindAimMobAnchor()
		elseif self._fingerMode == 1 or self._fingerMode == 3 then
			local aim = nil
			if self._fingerMode == 3 then aim = self:FindEggAnchor() else aim = self:FindAimAnchor() end
			if aim == nil then
				-- 가리킬 몬스터가 아직 없다 — 손가락을 숨기고 다음 프레임에 다시 찾는다
				if self.fingerEntity.Enable then self.fingerEntity:SetEnable(false) end
				return
			end
			if not self.fingerEntity.Enable then self.fingerEntity:SetEnable(true) end
			-- 이스터에그 단계: 손가락이 처음 나타난 순간 배너를 0.3초 뒤로 예약(한 번만)
			if self._fingerMode == 3 and not self._eggBannerScheduled then
				self._eggBannerScheduled = true
				self:ClearStep3Timer()
				self._step3TimerId = _TimerService:SetTimerOnce(function()
					if not isvalid(self) then return end
					self._step3TimerId = 0
					if self._fingerMode ~= 3 then return end
					self:ShowBanner(self.EggText)
					log("TutorialGuideUI: egg banner shown")
				end, self.EggBannerDelaySeconds)
			end
			pos = aim
		end

		local off = self.FingerTapOffset
		self.fingerEntity.UITransformComponent.anchoredPosition =
			Vector2(pos.x + off.x * eased, pos.y + off.y * eased)
	end

	-- 손가락이 붙을 자리(UI 좌표)를 돌려준다. 가리킬 몬스터가 없으면 nil.
	-- 손"끝"이 몬스터 위에 오도록 FingerTipOffset만큼 빼서 스프라이트 중심 자리를 계산한다.
	@ExecSpace("ClientOnly")
	method any FindAimAnchor()
		local mob = self:FindNearestMonsterEntity()
		if mob == nil then return nil end

		local wp = mob.TransformComponent.WorldPosition
		local targetUI = _UILogic:ScreenToUIPosition(
			_UILogic:WorldToScreenPosition(Vector2(wp.x, wp.y + self.AimTargetWorldYOffset)))

		local x = targetUI.x - self.FingerTipOffset.x + self.FingerAimNudge.x
		local y = targetUI.y - self.FingerTipOffset.y + self.FingerAimNudge.y
		-- 몬스터가 화면 끝에 걸쳐 있어도 손가락은 화면 안에 남긴다
		x = math.max(-self.AimClampX, math.min(self.AimClampX, x))
		y = math.max(-self.AimClampY, math.min(self.AimClampY, y))
		return Vector2(x, y)
	end

	-- 현재 맵에서 가장 "앞에 있는"(스케일이 큰 = 가까운) 살아있는 몬스터 엔티티를 찾는다.
	-- CardManager.GetClosestTargets가 쓰는 것과 같은 기준이라 실제 공격 대상과 어긋나지 않는다.
	-- 병합 존은 맵 루트의 자식 컨테이너라 한 단계 더 내려가야 한다(ScanMonsterBoxAt과 동일).
	@ExecSpace("ClientOnly")
	method any FindNearestMonsterEntity()
		local player = _UserService.LocalPlayer
		if player == nil then return nil end
		local map = player.CurrentMap
		if map == nil then return nil end
		return self:ScanNearestMonster(map, nil, -1, 0)
	end

	@ExecSpace("ClientOnly")
	method any ScanNearestMonster(Entity parent, any best, number bestScale, integer depth)
		-- parent의 자식들을 훑어 스케일이 가장 큰 살아있는 몬스터를 고른다
		local children = parent.Children:ToTable()
		for i = 1, #children do
			local c = children[i]
			if isvalid(c) then
				---@type MonsterAI
				local ai = c:GetComponent("script.MonsterAI")
				if ai ~= nil then
					if not ai._dead and c.TransformComponent ~= nil then
						local s = c.TransformComponent.Scale.x
						if s > bestScale then
							best = c
							bestScale = s
						end
					end
				elseif depth < 1 then
					local sub = self:ScanNearestMonster(c, best, bestScale, depth + 1)
					if sub ~= nil and sub ~= best then
						best = sub
						bestScale = sub.TransformComponent.Scale.x
					end
				end
			end
		end
		return best
	end

end
