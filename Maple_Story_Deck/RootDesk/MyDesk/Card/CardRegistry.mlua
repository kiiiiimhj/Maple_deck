	-- cardIdx가 어느 캐릭터의 카드 정의 테이블에 있는지 찾아 돌려준다 (없으면 nil)
	method table FindCardDefs(integer cardIdx)
		local reion = self:GetReionCardDefs()[cardIdx]
		if reion ~= nil then return reion end
		local shade = self:GetShadeCardDefs()[cardIdx]
		if shade ~= nil then return shade end
		return self:GetRinCardDefs()[cardIdx]
	end

	-- 린(5번째 캐릭터) 카드 — 기본공격부터 이 레지스트리 구조로 시작한다(레이온 이후 신규 캐릭터 규칙).
	method table GetRinCardDefs()
		return {
			-- 기본공격(Card200, 상시 발동) — 표창을 던지는 발사체형. 실제 데미지/쿨타임/연출은
			-- CardManager의 RinAttack* 프로퍼티와 RinBasicAttack에서 관리(레지스트리는 표시 데이터만).
			[200] = {
				name = "기본공격",
				icon = "0af95ff09be14c389c1854f03c575e2e",
				tags = "기본공격,발사체",
