@Logic
script CardRegistry extends Logic

	-- 레이온(3번째 캐릭터) 이후 신규 카드는 CardManager의 touchpoint 함수(아이콘/이름/태그/레벨업 팝업 등)
	-- 마다 if/elseif를 추가하는 대신, 여기 테이블에 항목 하나만 추가하면 되도록 만든 레지스트리(기존
	-- 아르카나 1-24/실피드 100+ 카드는 이미 touchpoint 방식이라 마이그레이션하지 않는다 — 결정 사항).
	-- CardManager 쪽 터치포인트들은 cardIdx가 여기 테이블에 있으면 이 레지스트리로 위임하는 라우팅
	-- 한 줄만 추가하고, 실제 데이터/레벨별 수치는 전부 이 파일에서만 관리한다.
	method table GetReionCardDefs()
		return {
			-- 콤보 어택(Card151, 패시브·슬롯 없음) — 기본공격(Card150) 적중 시 이 확률만큼 대상
			-- 몬스터에게 콤보 스택이 쌓인다(레벨업 시 확률만 오른다. 스택 자체에는 데미지 보너스가
			-- 없고, 5스택 도달 시 마지막 타격 데미지의 200%를 폭발 데미지로 추가 적용한다 —
			-- MonsterAI.ComboStack + CardManager.PlayComboFinishBurst에서 처리)
			[151] = {
				name = "콤보 어택",
				icon = "d714c4d5a90a43a7b5a7bfb3b49c4628",
				tags = "패시브,확률스택",
				chancePerLevel = { 0.10, 0.15, 0.20, 0.30, 0.35 },
			},
			-- 슬래시(Card152, 슬롯형 액티브) — "슬래시 블러스트" 리소스팩 아이콘 재사용. 데미지/타겟
			-- 수/쿨타임은 레벨별 표가 단순 배율이 아니라 CardManager.GetSlashDamage/GetSlashTargetCount
			-- 고정 테이블로 관리(레지스트리는 정적 표시 데이터만 담당)
			[152] = {
				name = "슬래시",
				icon = "3c9bcefb5e6941adb3e3dfd342639164",
				tags = "다중타격,콤보스택",
			},
			-- 브랜디쉬(Card153, 슬롯형 액티브 2호) — 슬래시와 데미지 테이블은 같지만 방식이 다르다.
			-- 슬래시는 맞은 대상마다 스윙+타격 연출을 각각 재생하는 반면, 브랜디쉬는 스윙 연출을
			-- 캐스터 위치 1곳에서 한 번만 재생하고 그 범위 안의 몬스터가 맞는다(타격 연출은 개별).
			[153] = {
				name = "브랜디쉬",
				icon = "f01f2a399af5468cabccba2eb25ed523",
				tags = "다중타격,콤보스택",
			},
			-- 플래시 슬래시(Card154, 슬롯형 액티브 3호) — 슬래시/브랜디쉬와 달리 "고정 대상 한정 타격"이
			-- 아니라, GetClosestTargets로 뽑힌 대상 수만큼 각각 그 위치에서 좌/우 랜덤 방향으로 이동하는
			-- 연출을 띄우고, 그 연출이 지나가는 경로에 닿는 몬스터는(원래 대상이 아니어도) 전부 맞는
			-- 관통형 이동 판정이다(더블 커터의 LaunchDoubleCutterTravel과 동일 패턴, 단 거리가 아니라
			-- 지속시간으로 종료).
			[154] = {
				name = "플래시 슬래시",
				icon = "cd91e94eee914c7d94908c5d4994efe1",
				tags = "관통이동,콤보스택",
			},
			-- 돌진(Card155, 슬롯형 액티브 4호) — 실피드의 플레시 미라주(Card108)와 완전히 동일한
			-- 시스템(좌/우 최외곽 대상 중앙으로 넉백+충돌 대미지, 전부 중앙 근방이면 양끝으로 대신
			-- 밀어냄)을 재사용한 스킬. 데미지/타겟수/충돌비율 표까지 플레시 미라주와 완전히 동일(유저
			-- 지정: "플레시 미라쥬랑 동일 시스템"), 연출/아이콘/사운드만 레이온 전용으로 교체. 콤보스택은
			-- 붙지 않는다(표에 콤보스택 항목 없음).
			[155] = {
				name = "돌진",
				icon = "5250cebd192a41fab47ffde667facda7",
				tags = "넉백,충돌피해",
			},
			-- 오라 블레이드(Card156, 슬롯형 액티브 5호) — 연출이 동시에 2개 나가는 유일한 레이온 스킬.
			-- 1) GetClosestTargets로 뽑힌 대상 각각의 위치에서 슬래시(Card152)처럼 즉시 재생되는 근접
			-- 타격 연출, 2) 플레이어 위치에서 화면 위(경험치바 방향)로 수직 상승하며 경로의 몬스터를
			-- 전부 관통 타격하는 연출(화면을 벗어나면 소멸). 실제 데미지/타겟수/발동 로직은
			-- CardManager.AuraBladeAttack/LaunchAuraBladeVertical에서 관리(레지스트리는 이름/아이콘/
			-- 태그 표시 데이터만 담당).
			[156] = {
				name = "오라 블레이드",
				icon = "483690e55c974444aef84df3a6331d93",
				tags = "관통이동,콤보스택",
			},
			-- 레이징 블로우(Card157, 슬롯형 액티브 6호) — GetClosestTargets로 뽑힌 각 타겟마다 독립적으로
			-- 콤보(타겟당 90% 확률 2연타/10% 확률 4연타)를 건다. 확률·타수·타격 간격은 레벨 무관 고정이고
			-- 레벨은 기준 데미지와 타겟 수만 바꾼다. 실제 데미지/연출 타이밍은
			-- CardManager.RagingBlowAttack에서 관리(레지스트리는 이름/아이콘/태그 표시 데이터만 담당).
			[157] = {
				name = "레이징 블로우",
				icon = "acedd37044c746c5b932cc61c4359de4",
				tags = "다중타격",
			},
			-- 리프 어택(Card158, 슬롯형 액티브 7호) — GetClosestTargets로 뽑힌 타겟에게 데미지+콤보스택 후
			-- ApplyStun+ApplyLevitate(아쿠아 트랩과 동일 API)로 1초간 살짝 띄워 행동불가로 만든다(속박).
			-- 실제 데미지/연출/타이밍은 CardManager.LeapAttackAttack에서 관리.
			[158] = {
				name = "리프 어택",
				icon = "96cba170e5684708a5e5263a4f9c1666",
				tags = "속박,콤보스택",
			},
			-- 스카링 소드(Card159, 슬롯형 액티브 8호) — 피닉스(실피드 105)와 동일한 소환수 패턴. 시전 시
			-- 최근접 적 근처에서 검이 소환되어 유지시간(4~5초) 동안 고정 간격(2초)으로 그 시점 최근접
			-- 적에게 날아가 2연타(각 50%)를 꽂는다. 반경 판정 없이 항상 단일 대상(타겟수 1, 유저 표
			-- 고정값)만 공격 — 실제 로직은 CardManager.ScarringSwordAttack에서 관리.
			[159] = {
				name = "스카링 소드",
				icon = "f97f557e480f482db24679f0d53e6e30",
				tags = "소환수,단일타격",
			},
			-- 브레이브 슬래시(Card160, 조합 스킬) — 브랜디쉬(153) Lv5 + 리프 어택(158) Lv5 보유 시
			-- 등장. 더블 커터와 동일한 "선행카드 2개 동시소모" 패턴(브랜디쉬 슬롯을 그대로 넘겨받고
			-- 리프 어택 슬롯은 비운다). 브랜디쉬처럼 대상마다 개별 스윙+타격 연출을 재생하되, 콤보스택은
			-- +2(AddComboStack 2회)로 두 배, 리프 어택의 ApplyLevitate 없이 스턴만 2초 100% 적용한다.
			-- 실제 데미지/연출/발동 로직은 CardManager.BraveSlashAttack에서 관리.
			[160] = {
				name = "브레이브 슬래시",
				icon = "880efe8e26bd41c18e08e8813463977c",
				tags = "다중타격,콤보스택,스턴",
			},
			-- 찬스 어택(Card161, 패시브·슬롯 없음) — 해금 즉시 영구 적용. 레벨별 크리티컬 확률만
			-- 오른다(10/12/15/17/20%, 매직 크리티컬과 동일 수치 트랙). CardManager.RollCrit에서
			-- GetChance(161, level)로 가산.
			[161] = {
				name = "찬스 어택",
				icon = "50a17d6899e04e2eab21fe0f2d315519",
				tags = "패시브,크리티컬",
				chancePerLevel = { 0.10, 0.12, 0.15, 0.17, 0.20 },
			},
			-- 코마(Card162, 패시브·슬롯 없음) — 5스택 콤보 폭발(PlayComboFinishBurst)의 데미지 배율을
			-- 강화(기본 200%→레벨별 220~260%)하고, 미해금 시 일반 연출/해금 시 강화 연출로 교체한다.
			-- 실제 배율/연출 전환은 CardManager.GetComaBurstMult/PlayComboFinishBurst에서 관리.
			[162] = {
				name = "코마",
				icon = "6a4b4c93ebf14ea1ad480a836c741205",
				tags = "패시브,폭발강화",
			},
			-- 셀프 리커버리(Card163, 패시브·슬롯 없음) — 10초마다 최대 체력의 %를 회복한다
			-- (3/4/5/6/7%). 실제 틱 로직은 CardManager.OnUpdate에서 관리.
			[163] = {
				name = "셀프 리커버리",
				icon = "7bd3582353ea4c5981c26190fe43d360",
				tags = "패시브,회복",
			},
			-- 워리어 마스터리(Card164, 패시브·슬롯 없음) — 모든 스킬 데미지를 % 증가(메디테이션과
			-- 동일한 전역 적용 패턴, CardManager.GetCardDamage에서 공통 적용), 5/8/12/16/20%.
			[164] = {
				name = "워리어 마스터리",
				icon = "77895755199f4f9eb8dc7073acd05756",
				tags = "패시브,피해증가",
			},
			-- 스피릿 블레이드(Card165, 조합 스킬) — 플래시 슬래시(154) Lv5 + 찬스 어택(161) 보유 시
			-- 등장. 아쿠아 서지와 동일한 "슬롯형 액티브 + 슬롯 없는 패시브" 조합 패턴(플래시 슬래시
			-- 슬롯을 그대로 넘겨받는다). 실제 데미지/연출/발동 로직은 CardManager.SpiritBladeAttack에서 관리.
			[165] = {
				name = "스피릿 블레이드",
				icon = "e9e9dea63a5545a692459fa1cd4a11e4",
				tags = "다중타격,콤보스택",
			},
			-- 버닝 러시(Card166, 조합 스킬) — 돌진(155) Lv5 + 워리어 마스터리(164) + 셀프 리커버리
			-- (163, 둘 다 슬롯 없는 패시브) 보유 시 등장. 돌진과 동일한 넉백 매커니즘 + 착지 시점
			-- 범위 폭발(신규)이 추가된다. 실제 데미지/연출/발동 로직은 CardManager.BurningRushAttack에서 관리.
			[166] = {
				name = "버닝 러시",
				icon = "89e5b77cdcb1434ea65748251c921825",
				tags = "넉백,충돌피해,범위폭발",
			},
			-- 슬래시 스톰(Card167, 조합 스킬) — 슬래시(152) Lv5 + 콤보 어택(151) + 코마(162, 둘 다
			-- 슬롯 없는 패시브) 보유 시 등장. 슬래시와 동일한 개별 타겟 스윙+타격 패턴 + 대상당
			-- 콤보스택 +2. 실제 데미지/연출/발동 로직은 CardManager.SlashStormAttack에서 관리.
			[167] = {
				name = "슬래시 스톰",
				icon = "a1f571fb695a46baabe8d64aef29a410",
				tags = "다중타격,콤보스택",
			},
			-- 솔라 블레이드(Card168, 조합 스킬) — 오라 블레이드(156) Lv5 + 워리어 마스터리(164) + 콤보
			-- 어택(151, 둘 다 슬롯 없는 패시브) 보유 시 등장. 오라 블레이드와 동일한 "슬롯형 액티브 + 슬롯
			-- 없는 패시브 2개" 조합 패턴(버닝 러시와 동일 구조, 오라 블레이드 슬롯을 그대로 넘겨받는다).
			-- 근접 슬래시 연출1 + "검기" 연출2가 동시에 나가되, 연출은 신규 리소스로 교체되고 검기는 부채꼴
			-- 발사각으로 갈라져 날아간다. 실제 데미지/연출/발동 로직은 CardManager.SolarBladeAttack에서 관리.
			[168] = {
				name = "솔라 블레이드",
				icon = "70afb0ab485a44638c446ba65e7e0cd5",
				tags = "관통이동,콤보스택",
			},
			-- 스카링 블레이드(Card169, 조합 스킬) — 스카링 소드(159) Lv5 + 찬스 어택(161) + 워리어
			-- 마스터리(164, 둘 다 슬롯 없는 패시브) 보유 시 등장. 스카링 소드와 동일한 "소환수" 패턴
			-- (근처 적 소환 + 유지시간 동안 최근접 적에게 날아가 2연타)을 그대로 재사용, 스카링 소드
			-- 슬롯을 그대로 넘겨받는다. 공격/타격 연출만 신규 리소스로 교체(소환/이동/사라짐 연출·사운드는
			-- 스카링 소드와 동일). 아이콘은 원본 이미지가 가로로 누워 있어 -90도 회전해서 표시한다
			-- (CardManager.GetCardIconRotation). 실제 데미지/연출/발동 로직은 CardManager.ScarringBladeAttack에서 관리.
			[169] = {
				name = "스카링 블레이드",
				icon = "1613665fd8154996b48c69f1fcf7cf93",
				tags = "소환수,단일타격",
			},
			-- 퓨리어스 블로우(Card170, 조합 스킬) — 레이징 블로우(157) Lv5 + 셀프 리커버리(163) + 워리어
			-- 마스터리(164, 둘 다 슬롯 없는 패시브) 보유 시 등장. 레이징 블로우와 동일한 매커니즘(타겟마다
			-- 일반 2연타/확률적 강화 4연타)을 재사용, 레이징 블로우 슬롯을 그대로 넘겨받는다. 타겟 수는
			-- 레벨 무관 3명 고정, 강화 확률은 레벨별 상승(15/20/30%). 연출 4종은 신규 리소스로 교체,
			-- 사운드는 레이징 블로우와 동일. 실제 데미지/연출/발동 로직은 CardManager.FuriousBlowAttack에서 관리.
			[170] = {
				name = "퓨리어스 블로우",
				icon = "5bd391d75bbe4d97a25d6ac506b82d7d",
				tags = "다중타격,확률강화",
			},
		}
	end

	-- 쉐이드(4번째 캐릭터) 전용 카드 — 레이온(150~170)과 번호가 겹치지 않도록 171부터 시작한다.
	method table GetShadeCardDefs()
		return {
			-- 더블 스탭(Card171, 슬롯형 액티브 1호 — 쉐이드의 첫 스킬). 대상마다 즉시 1타 + 0.3초 뒤 2타를
			-- 꽂는 2연타 스킬. dmg는 GetCardDamage(171)의 기준값(GetDoubleStepDamage), 실제 1타/2타
			-- 데미지는 그 기준값에 레벨별 비율(CardManager.GetDoubleStepPercent)을 곱해서 계산한다
			-- (레벨이 오를수록 기준값과 비율이 함께 올라 이중으로 강해짐 — 유저 지정 표 그대로).
			-- 실제 데미지/연출/발동 로직은 CardManager.DoubleStepAttack에서 관리(레지스트리는 이름/아이콘/
			-- 태그 표시 데이터만 담당).
			[171] = {
				name = "더블 스탭",
