			-- 레벨별 대미지/타겟수는 CardManager.GetLuckySeven* 고정 테이블이 관리한다.
			[201] = {
				name = "럭키 세븐",
				icon = "1b1ac0cdfa4042679aa4caa6fcd0fc0b",
				tags = "다중타격,낙하",
			},
			-- 슈리켄 버스트(Card202) — 관통형. 첫 대상 100% + 뒤로 뚫으며 레벨별 비율로 추가 타격.
			[202] = {
				name = "슈리켄 버스트",
				icon = "826e34ac444542ed81138d8f3c600eb4",
				tags = "관통,다중타격",
			},
			-- 윈드 탈리스만(Card203) — 광역형. 부적이 날아가 터지며 타원 범위 안 몬스터를 한 번에 때린다.
			[203] = {
				name = "윈드 탈리스만",
				icon = "2dbfbe5629b54d4bb23709ff0f996976",
				tags = "광역,투사체",
			},
			-- 쉐도우 스플릿(Card204) — 분열형. 원본 표창이 꽂히면 1타, 거기서 표창 3개가 위로
			-- 포물선을 그리며 흩어져 경로에 걸린 몬스터에게 분열 대미지를 넣는다.
			[204] = {
				name = "쉐도우 스플릿",
				icon = "8c55ca7af6994b0cabce15f01641c91b",
				tags = "분열,투사체",
			},
			-- 스로잉 윙대거(Card205) — 추적 지속형. 3초 동안 가장 가까운 적을 차례로 쫓아가 때리고,
			-- 접근하는 이동 경로에 걸린 적도 같이 맞는다.
			[205] = {
				name = "스로잉 윙대거",
				icon = "15995c8c9dc44d3ca9bfc76ce0f605b9",
				tags = "추적,지속",
			},
			-- 쇼다운 챌린지(Card206) — 즉발 광역형. 타겟 자리에 연출이 뜨고 그 범위 안 몬스터를
			-- 한 번에 때린다. 투사체 없음.
			[206] = {
				name = "쇼다운 챌린지",
				icon = "956727b76287433c80ddfd9c0dd9dd2f",
				tags = "광역,즉발",
			},
		}
	end

	method boolean HasCard(integer cardIdx)
		return self:FindCardDefs(cardIdx) ~= nil
	end

	method string GetName(integer cardIdx)
		local c = self:FindCardDefs(cardIdx)
		if c == nil then return "" end
		return c.name
	end

	method string GetIcon(integer cardIdx)
		local c = self:FindCardDefs(cardIdx)
		if c == nil then return "" end
		return c.icon
	end

	method string GetTags(integer cardIdx)
		local c = self:FindCardDefs(cardIdx)
		if c == nil then return "" end
		return c.tags
	end

	-- level이 표에 없는 범위(0 이하/최대 초과)면 각각 0과 마지막 레벨 값으로 클램프한다
	method number GetChance(integer cardIdx, integer level)
		local c = self:FindCardDefs(cardIdx)
		if c == nil or level <= 0 or c.chancePerLevel == nil then return 0 end
		local idx = math.min(level, #c.chancePerLevel)
		return c.chancePerLevel[idx]
	end

end
