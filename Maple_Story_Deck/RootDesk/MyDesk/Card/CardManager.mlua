	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 전용 리소스팩 번들 오디오(_audio/Use) 사용
	property string Card13SoundRUID = "3533266a70c24471bedfc773569fdd8f"

	method void PlayThunderCutterSound()
		_SoundService:PlaySound(self.Card13SoundRUID, 1.0)
	end
	property number Card13Radius = 0.96  -- 판정 반경(아이스 커터 Lv1과 동일) — 연출 시각 크기와는 별도로 유지
	property number Card13EffectScale = 0.4  -- 연출 시각 크기 — 아이스 커터 산식(반경/1.2=0.8) 대비 50% 축소
	property number Card13EffectXOffset = -0.8  -- 연출 중심 보정값(좌우 미세조정 완료)
	property number Card13EffectYOffset = 0.2
	property number Card13Cooldown = 4.0
	property number Card13ShotInterval = 0.15  -- 연속 타격(2타/3타) 사이 간격
	property number Card13KnockbackScale = 0.85  -- 넉백 시 되돌아가는 스케일 — 스폰 직후 값과 동일("맨 뒤")

	-- ── 더블 커터 (Card 20) — 아이스커터 Lv5 + 썬더커터 Lv5 보유 시 등장하는 조합 스킬.
	-- 두 원본 카드 모두 사라지고, 더블커터가 아이스커터 슬롯을 그대로 넘겨받는다(썬더커터 슬롯은
	-- 완전히 비워져서 다음 레벨업 때 새 카드가 들어올 수 있음). Lv1~3까지만 존재.
	-- 1단계(제자리, Card20StationaryDuration=1초): 아이스+썬더 이펙트가 겹쳐 재생되며 광역 판정
	-- (출혈+넉백 동시 적용). 2단계: 그 뒤 화면 좌우로 서로 반대 방향(아이스/썬더 중 어느 쪽이 좌/우로
	-- 갈지는 매 캐스트 랜덤)으로 갈라져 이동하며 경로에 걸린 몬스터를 계속 타격 — 아이스 쪽 경로는
	-- 출혈, 썬더 쪽 경로는 넉백을 그대로 적용.
	@Sync property integer DoubleCutterLevel = 0
	property string Card20Name = "더블 커터"
	property string Card20IconRUID = "f1af72d7a9fe463db574a4afc1bc7a40"
	property number Card20Cooldown = 4.0  -- 레벨 무관 고정
	property number Card20StationaryDuration = 1.0  -- 1단계(제자리 겹침 연출) 지속시간
	property number Card20HitRadius = 0.96  -- 아이스 커터와 동일 반경
	property number Card20BleedPercent = 0.05  -- 아이스커터 Lv5와 동일
	property number Card20KnockbackScale = 0.85  -- 썬더커터와 동일
	property number Card20TravelSpeed = 7.0  -- 좌우 이동 속도(유닛/초) — 추정치, 어색하면 조정
	property number Card20TravelDistance = 7.0  -- 이 거리만큼 이동하면 소멸(화면 밖으로 간주)
	property number Card20TravelTickInterval = 0.1  -- 이동 중 피격 판정 주기
	property number Card20ThunderXOffset = 0.4  -- 1단계 겹침 연출에서 썬더 이펙트의 첫 등장 X좌표 보정값(더블 커터 전용, 썬더커터 단독 연출에는 영향 없음)
	property number Card20IceScaleMult = 1.1  -- 더블 커터 전용 아이스 이펙트 크기 배율(아이스커터 단독 연출에는 영향 없음)
	property number Card20YOffsetAdjust = -0.2  -- 더블 커터 전용 두 연출의 Y좌표 보정(아래로 내림, 아이스/썬더커터 단독 연출에는 영향 없음)

	-- ── 킹페페 (Card 21) — 매직 부스터 + 매직 아머(둘 다 슬롯 없는 패시브) + 페페(Card12) Lv5 보유 시
	-- 등장하는 조합 스킬. 페페와 이름이 겹치지만(과거 페페의 이름이 "킹페페"였다가 이번에 "페페"로
	-- 바뀌면서 이 이름을 새 조합 스킬이 물려받음) 내부 심볼은 전부 GrandPepe/Card21로 분리해서
	-- 기존 Card12의 KingPepeLevel/GetKingPepeDamage 등과 절대 충돌하지 않는다. 페페의 슬롯을 그대로
	-- 넘겨받고(패시브 2개는 슬롯이 없어 비울 슬롯이 없음) Lv1~3까지만 존재. 좌/우 펭귄(페페 Lv5 기준
	-- 항상 둘 다 활성)은 그대로 유지하고, Lv1에 좌펭귄보다 더 바깥쪽(추가 3번째), Lv3에 우펭귄보다 더
	-- 바깥쪽(추가 4번째) 펭귄을 새로 띄운다 — 4곳 모두 판정 반경/데미지는 동일, 한 몬스터는 여러 존이
	-- 겹쳐도 한 번만 맞는다(기존 페페와 동일한 "or" 판정 방식). 2연타(100%/50%)는 페페 Lv5와 같은
	-- 구성이지만 100% 확정 발동이 아니라 레벨별 확률(Lv1:25%/Lv2:30%/Lv3:40%)로 발동한다.
	@Sync property integer GrandPepeLevel = 0
	property string Card21Name = "킹페페"
	property string Card21IconRUID = "d56f3132d8b74e08b3861902228717df"
	property string Card21EffectRUID_C = "bc4bfd66e0804e7e9eb47c4b168a7b2a"  -- Lv1 추가: 좌펭귄보다 더 바깥쪽
	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 원본 페페(Card12)와 동일 사운드 재사용
	property string Card21SoundRUID = "7acd3b60c15a43beb2689191cc0d3fcf"

	method void PlayGrandPepeSound()
		_SoundService:PlaySound(self.Card21SoundRUID, 1.0)
	end
	property string Card21EffectRUID_D = "827dcba166a24d558abd80c9460cf071"  -- Lv3 추가: 우펭귄보다 더 바깥쪽
	property number Card21FarLeftX = -2.9  -- Lv1 추가분(유저 직접 지정)
	property number Card21FarRightX = 2.8  -- Lv3 추가분(유저 직접 지정)
	property number Card21FarLeftYOffset = 0.7  -- Lv1 추가분만 위로 보정(다른 3개 펭귄에는 영향 없음)
	property number Card21FarRightYOffset = 0.7  -- Lv3 추가분만 위로 보정(다른 3개 펭귄에는 영향 없음)
	property number Card21Cooldown = 7.0  -- 레벨 무관 고정값(페페 Lv5 감소 체인과 무관)
	property number Card21RepeatDelay = 0.5  -- 페페와 동일한 2타 타이밍

	method number GetGrandPepeDamage()
		if self.GrandPepeLevel >= 3 then return 500
		elseif self.GrandPepeLevel >= 2 then return 450
		end
		return 400
	end

	method number GetGrandPepeProcChance()
		local base = 0.25
		if self.GrandPepeLevel >= 3 then base = 0.40
		elseif self.GrandPepeLevel >= 2 then base = 0.30
		end
		-- SkillInventory 킹페페(인덱스18) Lv9: 2연타 확률 +10%, 카드 자체 레벨과 별개로 항상 가산
		if self:GetSkillInvLevel(21) >= 9 then base = base + 0.10 end
		return base
	end

	@ExecSpace("ServerOnly")
	method void GrandPepeAttack(number damage, boolean isCrit, MonsterAI primaryTarget, boolean isRepeat)
		if not isRepeat then self:PlayGrandPepeSound() end
		local map = self:GetCurrentMap()
		if map == nil or not isvalid(map) then return end
		local level = self.GrandPepeLevel
		local farLeftActive = level >= 1
		local farRightActive = level >= 3
		local mapWorldPos = Vector3(0, 0, 0)
		if isvalid(map.TransformComponent) then
			mapWorldPos = map.TransformComponent.WorldPosition
		end
		local centerX = self:GetPlayerCenterX() - mapWorldPos.x
		local groundY = self.Card12FixedGroundY - mapWorldPos.y

		local leftPos = Vector3(centerX + self.Card12LeftX, groundY, 0)
		self:SpawnEffect(self.Card12EffectRUID_A, leftPos, 0, 1, self.Card12EffectScale, 1)
		local rightPos = Vector3(centerX + self.Card12RightX, groundY + self.Card12RightYOffset, 0)
		self:SpawnEffect(self.Card12EffectRUID_B, rightPos, 0, 1, self.Card12EffectScale, 1)
		local farLeftPos = nil
		if farLeftActive then
			farLeftPos = Vector3(centerX + self.Card21FarLeftX, groundY + self.Card21FarLeftYOffset, 0)
			self:SpawnEffect(self.Card21EffectRUID_C, farLeftPos, 0, 1, self.Card12EffectScale, 1)
		end
		local farRightPos = nil
		if farRightActive then
			farRightPos = Vector3(centerX + self.Card21FarRightX, groundY + self.Card21FarRightYOffset, 0)
			self:SpawnEffect(self.Card21EffectRUID_D, farRightPos, 0, 1, self.Card12EffectScale, 1)
		end

		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(map) then return end
			local radius = self.Card12HitRadius
			local monsters = self:GetMonstersInCurrentZone(map)
			local hitCount = 0
			for _, mob in ipairs(monsters) do
				---@type MonsterAI
				local m = mob
				if not m._dead and isvalid(m) and isvalid(m.Entity) and isvalid(m.Entity.TransformComponent) then
					local mp = m.Entity.TransformComponent.Position
					local dxL = mp.x - leftPos.x
					local dyL = mp.y - leftPos.y
					local hitLeft = (dxL * dxL + dyL * dyL) <= (radius * radius)
					local dxR = mp.x - rightPos.x
					local dyR = mp.y - rightPos.y
					local hitRight = (dxR * dxR + dyR * dyR) <= (radius * radius)
					local hitFarLeft = false
					if farLeftActive then
						local dxFL = mp.x - farLeftPos.x
						local dyFL = mp.y - farLeftPos.y
						hitFarLeft = (dxFL * dxFL + dyFL * dyFL) <= (radius * radius)
					end
					local hitFarRight = false
					if farRightActive then
						local dxFR = mp.x - farRightPos.x
						local dyFR = mp.y - farRightPos.y
						hitFarRight = (dxFR * dxFR + dyFR * dyFR) <= (radius * radius)
					end
					if (hitLeft or hitRight or hitFarLeft or hitFarRight) and self:IsSameDepthBand(primaryTarget, m) then
						if isCrit then m:TakeDamageCrit(damage * 2)
						else m:TakeDamage(damage) end
						hitCount = hitCount + 1
					end
				end
			end
			log("GrandPepeAttack: hit=" .. hitCount .. " dmg=" .. math.floor(isCrit and damage * 2 or damage))
		end, self.Card12HitDelay)

		if not isRepeat and _UtilLogic:RandomDouble() < self:GetGrandPepeProcChance() then
			_TimerService:SetTimerOnce(function()
				if isvalid(self) then
					self:GrandPepeAttack(damage * 0.5, isCrit, primaryTarget, true)
				end
			end, self.Card21RepeatDelay)
		end
	end

	-- 아쿠아 트랩 (Card 14) — 메즈(속박) 스킬. 화면에 가장 가까이 접근한 순서로 여러 명을 한 번에
	-- 타겟팅해서 각자 위치에 개별 연출을 띄우고 데미지 + MonsterAI:ApplyStun(기존 썬더볼트 감전과
	-- 동일한 "완전 정지 + 별 이펙트" 연출)으로 속박한다.
