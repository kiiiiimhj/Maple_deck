		elseif cardIdx == 158 then
			extraStr = "타겟 " .. self:GetLeapAttackTargetCount(self.LeapAttackLevel) .. "명  |  속박(살짝 도약) " .. self.LeapAttackRootDuration .. "초  |  콤보스택 +1 (100%)"
		elseif cardIdx == 159 then
