			end
			log("ThunderBolt L" .. self.ThunderBoltLevel)
			return
		end

		-- 썬더스톰 (조합 스킬 — 새 슬롯 없이 썬더볼트가 있던 슬롯을 그대로 넘겨받는다)
		if cardIdx == 16 then
			if upgradeType == "unlock" then
				self.ThunderStormLevel = 1
				local slotIdx = self:GetSlotForCard(4)
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 16)
					self:ResetSlotTimer(slotIdx)
					self:PlayThunderStormFusionEffect(slotIdx)
					log("Card16(ThunderStorm) fused into Slot" .. slotIdx .. " (was ThunderBolt)")
				else
					log_warning("ThunderStorm: ThunderBolt not found in any slot — fusion could not place the card")
				end
			elseif upgradeType == "thunderstorm_up" and self.ThunderStormLevel < 3 then
				self.ThunderStormLevel = self.ThunderStormLevel + 1
			end
			log("ThunderStorm L" .. self.ThunderStormLevel)
			return
		end

		-- 아이스 스트라이크 (조합 스킬 — 새 슬롯 없이 콜드빔이 있던 슬롯을 그대로 넘겨받는다)
		if cardIdx == 17 then
			if upgradeType == "unlock" then
				self.IceStrikeLevel = 1
				local slotIdx = self:GetSlotForCard(3)
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 17)
					self:ResetSlotTimer(slotIdx)
					self:PlayThunderStormFusionEffect(slotIdx)
					log("Card17(IceStrike) fused into Slot" .. slotIdx .. " (was ColdBeam)")
				else
					log_warning("IceStrike: ColdBeam not found in any slot — fusion could not place the card")
				end
			elseif upgradeType == "icestrike_up" and self.IceStrikeLevel < 3 then
				self.IceStrikeLevel = self.IceStrikeLevel + 1
			end
			log("IceStrike L" .. self.IceStrikeLevel)
			return
		end

		-- 체인 라이트닝 (조합 스킬 — 새 슬롯 없이 에너지볼트가 있던 슬롯을 그대로 넘겨받는다)
		if cardIdx == 19 then
			if upgradeType == "unlock" then
				self.ChainLightningLevel = 1
				local slotIdx = self:GetSlotForCard(9)
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 19)
					self:ResetSlotTimer(slotIdx)
					self:PlayThunderStormFusionEffect(slotIdx)
					log("Card19(ChainLightning) fused into Slot" .. slotIdx .. " (was EnergyBolt)")
				else
					log_warning("ChainLightning: EnergyBolt not found in any slot — fusion could not place the card")
				end
			elseif upgradeType == "chainlightning_up" and self.ChainLightningLevel < 3 then
				self.ChainLightningLevel = self.ChainLightningLevel + 1
			end
			log("ChainLightning L" .. self.ChainLightningLevel)
			return
		end

		-- 더블 커터 (조합 스킬 — 아이스커터 슬롯을 그대로 넘겨받고, 썬더커터 슬롯은 완전히 비운다)
		if cardIdx == 20 then
			if upgradeType == "unlock" then
				self.DoubleCutterLevel = 1
				local iceSlot = self:GetSlotForCard(11)
				local thunderSlot = self:GetSlotForCard(13)
				if iceSlot > 0 then
					self:AssignCardToSlot(iceSlot, 20)
					self:ResetSlotTimer(iceSlot)
					self:PlayThunderStormFusionEffect(iceSlot)
					log("Card20(DoubleCutter) fused into Slot" .. iceSlot .. " (was IceCutter)")
				else
					log_warning("DoubleCutter: IceCutter not found in any slot — fusion could not place the card")
				end
				if thunderSlot > 0 then
					self:AssignCardToSlot(thunderSlot, 0)
					log("DoubleCutter: ThunderCutter's Slot" .. thunderSlot .. " emptied")
				end
			elseif upgradeType == "doublecutter_up" and self.DoubleCutterLevel < 3 then
				self.DoubleCutterLevel = self.DoubleCutterLevel + 1
			end
			log("DoubleCutter L" .. self.DoubleCutterLevel)
			return
		end

		-- 킹페페 (조합 스킬 — 페페(Card12) 슬롯을 그대로 넘겨받는다. 매직 부스터/매직 아머는
		-- 슬롯 없는 패시브라 비울 슬롯이 없음)
		if cardIdx == 21 then
			if upgradeType == "unlock" then
				self.GrandPepeLevel = 1
				local pepeSlot = self:GetSlotForCard(12)
				if pepeSlot > 0 then
					self:AssignCardToSlot(pepeSlot, 21)
					self:ResetSlotTimer(pepeSlot)
					self:PlayThunderStormFusionEffect(pepeSlot)
					log("Card21(GrandPepe) fused into Slot" .. pepeSlot .. " (was Pepe)")
				else
					log_warning("GrandPepe: Pepe not found in any slot — fusion could not place the card")
				end
			elseif upgradeType == "grandpepe_up" and self.GrandPepeLevel < 3 then
				self.GrandPepeLevel = self.GrandPepeLevel + 1
			end
			log("GrandPepe L" .. self.GrandPepeLevel)
			return
		end

		if cardIdx == 3 then
			if upgradeType == "unlock" then
				self.ColdBeamLevel = 1
				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 3)
					self:ResetSlotTimer(slotIdx)
					log("Card3(ColdBeam) -> Slot" .. slotIdx)
				end
			elseif upgradeType == "coldbeam_up" and self.ColdBeamLevel < 5 then
				self.ColdBeamLevel = self.ColdBeamLevel + 1
			end
			log("ColdBeam L" .. self.ColdBeamLevel)
			return
		end

		-- 매직클로는 (해금 포함) 업그레이드할 때마다 1씩 누적 — 타겟 수 스케일링에 쓴다.
		-- 메테오는 스케일링 용도는 없지만 카드슬롯 Lv 표시용으로 동일하게 누적한다
		if cardIdx == 2 then self.Card2UpgradeCount = self.Card2UpgradeCount + 1
		elseif cardIdx == 5 then self.Card5UpgradeCount = self.Card5UpgradeCount + 1
		end

		-- 파이어샷(Card1)은 5회까지만 기존 배율을 따르고 그 이후로는 데미지 +20 고정 무한증가 —
		-- 다른 카드와 증가 방식이 달라 별도로 분리해서 처리한다.
		if cardIdx == 1 and (upgradeType == "dmg" or upgradeType == "cd") then
			if upgradeType == "dmg" then
				if self.Card1UpgradeCount < self.Card1MultiplierCap then
					self.Card1Damage = self.Card1Damage * 1.2
				else
					self.Card1Damage = self.Card1Damage + self.Card1FlatDamageBonus
				end
				self.Card1UpgradeCount = self.Card1UpgradeCount + 1
			elseif upgradeType == "cd" then
				-- 5회 이후에는 쿨타임 강화 선택지 자체가 더 이상 안 나오지만(GenerateLevelUpChoices에서
				-- 걸러짐), 혹시 모를 경로에 대비해 여기서도 상한을 넘으면 조용히 무시한다
				if self.Card1UpgradeCount < self.Card1MultiplierCap then
					self.Card1Cooldown = self.Card1Cooldown * 0.85
					self.Card1UpgradeCount = self.Card1UpgradeCount + 1
				end
			end
			log("Card1(파이어샷) upgrade: count=" .. self.Card1UpgradeCount .. " dmg=" .. math.floor(self.Card1Damage) .. " cd=" .. string.format("%.2f", self.Card1Cooldown))
			return
		end

		-- 애로우샷(Card25, 실피드 전용)도 파이어샷과 동일한 공식(5회까지 배율, 이후 데미지 +20 고정
		-- 무한증가)을 완전히 독립된 프로퍼티로 따른다.
		if cardIdx == 25 and (upgradeType == "dmg" or upgradeType == "cd") then
			if upgradeType == "dmg" then
				if self.ArrowShotUpgradeCount < self.ArrowShotMultiplierCap then
					self.ArrowShotDamage = self.ArrowShotDamage * 1.2
				else
					self.ArrowShotDamage = self.ArrowShotDamage + self.ArrowShotFlatDamageBonus
				end
				self.ArrowShotUpgradeCount = self.ArrowShotUpgradeCount + 1
			elseif upgradeType == "cd" then
				if self.ArrowShotUpgradeCount < self.ArrowShotMultiplierCap then
					self.ArrowShotCooldown = self.ArrowShotCooldown * 0.85
					self.ArrowShotUpgradeCount = self.ArrowShotUpgradeCount + 1
				end
			end
			log("Card25(애로우샷) upgrade: count=" .. self.ArrowShotUpgradeCount .. " dmg=" .. math.floor(self.ArrowShotDamage) .. " cd=" .. string.format("%.2f", self.ArrowShotCooldown))
			return
		end

		-- 레이온 기본공격(Card150)도 파이어샷/애로우샷과 동일한 공식을 독립된 프로퍼티로 따른다.
		if cardIdx == 150 and (upgradeType == "dmg" or upgradeType == "cd") then
			if upgradeType == "dmg" then
				if self.LeionAttackUpgradeCount < self.LeionAttackMultiplierCap then
					self.LeionAttackDamage = self.LeionAttackDamage * 1.2
				else
					self.LeionAttackDamage = self.LeionAttackDamage + self.LeionAttackFlatDamageBonus
				end
				self.LeionAttackUpgradeCount = self.LeionAttackUpgradeCount + 1
			elseif upgradeType == "cd" then
				if self.LeionAttackUpgradeCount < self.LeionAttackMultiplierCap then
					self.LeionAttackCooldown = self.LeionAttackCooldown * 0.85
					self.LeionAttackUpgradeCount = self.LeionAttackUpgradeCount + 1
				end
			end
			log("Card150(레이온 기본공격) upgrade: count=" .. self.LeionAttackUpgradeCount .. " dmg=" .. math.floor(self.LeionAttackDamage) .. " cd=" .. string.format("%.2f", self.LeionAttackCooldown))
			return
		end

		-- 쉐이드 기본공격(Card172)도 파이어샷/애로우샷/레이온 기본공격과 동일한 공식을 독립된 프로퍼티로 따른다.
		if cardIdx == 172 and (upgradeType == "dmg" or upgradeType == "cd") then
			if upgradeType == "dmg" then
				if self.ShadeAttackUpgradeCount < self.ShadeAttackMultiplierCap then
					self.ShadeAttackDamage = self.ShadeAttackDamage * 1.2
				else
					self.ShadeAttackDamage = self.ShadeAttackDamage + self.ShadeAttackFlatDamageBonus
				end
				self.ShadeAttackUpgradeCount = self.ShadeAttackUpgradeCount + 1
			elseif upgradeType == "cd" then
				if self.ShadeAttackUpgradeCount < self.ShadeAttackMultiplierCap then
					self.ShadeAttackCooldown = self.ShadeAttackCooldown * 0.85
					self.ShadeAttackUpgradeCount = self.ShadeAttackUpgradeCount + 1
				end
			end
			log("Card172(쉐이드 기본공격) upgrade: count=" .. self.ShadeAttackUpgradeCount .. " dmg=" .. math.floor(self.ShadeAttackDamage) .. " cd=" .. string.format("%.2f", self.ShadeAttackCooldown))
			return
		end

		-- 콤보 어택(패시브 — 슬롯 없이 레벨만 증가)
		if cardIdx == 151 then
			if upgradeType == "unlock" then
				self.ComboAttackLevel = 1
			elseif upgradeType == "comboattack_up" and self.ComboAttackLevel < 5 then
				self.ComboAttackLevel = self.ComboAttackLevel + 1
			end
			self:NotifyComboOnPermanent()
			log("ComboAttack L" .. self.ComboAttackLevel .. " (스택 확률 " .. math.floor(_CardRegistry:GetChance(151, self.ComboAttackLevel) * 100) .. "%)")
			return
		end

		-- 찬스 어택(패시브 — 슬롯 없이 레벨만 증가)
		if cardIdx == 161 then
			if upgradeType == "unlock" then
				self.ChanceAttackLevel = 1
			elseif upgradeType == "chanceattack_up" and self.ChanceAttackLevel < 5 then
				self.ChanceAttackLevel = self.ChanceAttackLevel + 1
			end
			self:NotifyChanceAttackOnPermanent()
			log("ChanceAttack L" .. self.ChanceAttackLevel .. " (크리티컬 " .. math.floor(_CardRegistry:GetChance(161, self.ChanceAttackLevel) * 100) .. "%)")
			return
		end

		-- 코마(패시브 — 슬롯 없이 레벨만 증가)
		if cardIdx == 162 then
			if upgradeType == "unlock" then
				self.ComaLevel = 1
			elseif upgradeType == "coma_up" and self.ComaLevel < 5 then
				self.ComaLevel = self.ComaLevel + 1
			end
			self:NotifyComaOnPermanent()
			log("Coma L" .. self.ComaLevel .. " (폭발 배율 " .. self:GetComaBurstPercent(self.ComaLevel) .. "%)")
			return
		end

		-- 셀프 리커버리(패시브 — 슬롯 없이 레벨만 증가)
		if cardIdx == 163 then
			if upgradeType == "unlock" then
				self.SelfRecoveryLevel = 1
			elseif upgradeType == "selfrecovery_up" and self.SelfRecoveryLevel < 5 then
				self.SelfRecoveryLevel = self.SelfRecoveryLevel + 1
			end
			self._selfRecoveryTimer = self.SelfRecoveryInterval
			self:NotifySelfRecoveryOnPermanent()
			log("SelfRecovery L" .. self.SelfRecoveryLevel .. " (" .. string.format("%.0f", self.SelfRecoveryInterval) .. "초마다 " .. self:GetSelfRecoveryPercent() .. "% 회복)")
			return
		end

		-- 워리어 마스터리(패시브 — 슬롯 없이 레벨만 증가)
		if cardIdx == 164 then
			if upgradeType == "unlock" then
				self.WarriorMasteryLevel = 1
			elseif upgradeType == "warriormastery_up" and self.WarriorMasteryLevel < 5 then
				self.WarriorMasteryLevel = self.WarriorMasteryLevel + 1
			end
			self:NotifyWarriorMasteryOnPermanent()
			log("WarriorMastery L" .. self.WarriorMasteryLevel .. " (데미지 +" .. self:GetWarriorMasteryPercent() .. "%)")
			return
		end

		-- 슬래시(슬롯형 액티브)
		if cardIdx == 152 then
			if upgradeType == "unlock" then
				self.SlashLevel = 1
				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 152)
					self:ResetSlotTimer(slotIdx)
					log("Card152(Slash) -> Slot" .. slotIdx)
				end
			elseif upgradeType == "slash_up" and self.SlashLevel < 5 then
				self.SlashLevel = self.SlashLevel + 1
			end
			log("Slash L" .. self.SlashLevel .. " (dmg=" .. math.floor(self:GetSlashDamage(self.SlashLevel)) .. " targets=" .. self:GetSlashTargetCount(self.SlashLevel) .. ")")
			return
		end

		-- 슬래시 스톰 (조합 스킬 — 슬래시 슬롯을 그대로 넘겨받는다. 콤보 어택/코마는 둘 다 슬롯 없는
		-- 패시브라 비울 슬롯이 없음)
		if cardIdx == 167 then
			if upgradeType == "unlock" then
				self.SlashStormLevel = 1
				local slashSlot = self:GetSlotForCard(152)
				if slashSlot > 0 then
					self:AssignCardToSlot(slashSlot, 167)
					self:ResetSlotTimer(slashSlot)
					self:PlayThunderStormFusionEffect(slashSlot)
					log("Card167(SlashStorm) fused into Slot" .. slashSlot .. " (was Slash)")
				else
					log_warning("SlashStorm: Slash not found in any slot — fusion could not place the card")
				end
			elseif upgradeType == "slashstorm_up" and self.SlashStormLevel < 3 then
				self.SlashStormLevel = self.SlashStormLevel + 1
			end
			log("SlashStorm L" .. self.SlashStormLevel .. " (dmg=" .. math.floor(self:GetSlashStormDamage(self.SlashStormLevel)) .. " targets=" .. self:GetSlashStormTargetCount(self.SlashStormLevel) .. ")")
			return
		end

		-- 브랜디쉬(슬롯형 액티브)
		if cardIdx == 153 then
			if upgradeType == "unlock" then
				self.BrandishLevel = 1
				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 153)
					self:ResetSlotTimer(slotIdx)
					log("Card153(Brandish) -> Slot" .. slotIdx)
				end
			elseif upgradeType == "brandish_up" and self.BrandishLevel < 5 then
				self.BrandishLevel = self.BrandishLevel + 1
			end
			log("Brandish L" .. self.BrandishLevel .. " (dmg=" .. math.floor(self:GetBrandishDamage(self.BrandishLevel)) .. " targets=" .. self:GetBrandishTargetCount(self.BrandishLevel) .. ")")
			return
		end

		-- 플래시 슬래시(슬롯형 액티브)
		if cardIdx == 154 then
			if upgradeType == "unlock" then
				self.FlashSlashLevel = 1
				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 154)
					self:ResetSlotTimer(slotIdx)
					log("Card154(FlashSlash) -> Slot" .. slotIdx)
				end
			elseif upgradeType == "flashslash_up" and self.FlashSlashLevel < 5 then
				self.FlashSlashLevel = self.FlashSlashLevel + 1
			end
			log("FlashSlash L" .. self.FlashSlashLevel .. " (dmg=" .. math.floor(self:GetFlashSlashDamage(self.FlashSlashLevel)) .. " targets=" .. self:GetFlashSlashTargetCount(self.FlashSlashLevel) .. ")")
			return
		end

		-- 스피릿 블레이드 (조합 스킬 — 플래시 슬래시 슬롯을 그대로 넘겨받는다. 찬스 어택은 슬롯 없는
		-- 패시브라 비울 슬롯이 없음)
		if cardIdx == 165 then
			if upgradeType == "unlock" then
				self.SpiritBladeLevel = 1
				local flashSlashSlot = self:GetSlotForCard(154)
				if flashSlashSlot > 0 then
					self:AssignCardToSlot(flashSlashSlot, 165)
					self:ResetSlotTimer(flashSlashSlot)
					self:PlayThunderStormFusionEffect(flashSlashSlot)
					log("Card165(SpiritBlade) fused into Slot" .. flashSlashSlot .. " (was FlashSlash)")
				else
					log_warning("SpiritBlade: FlashSlash not found in any slot — fusion could not place the card")
				end
			elseif upgradeType == "spiritblade_up" and self.SpiritBladeLevel < 3 then
				self.SpiritBladeLevel = self.SpiritBladeLevel + 1
			end
			log("SpiritBlade L" .. self.SpiritBladeLevel .. " (dmg=" .. math.floor(self:GetSpiritBladeDamage(self.SpiritBladeLevel)) .. " targets=" .. self:GetSpiritBladeTargetCount(self.SpiritBladeLevel) .. ")")
			return
		end

		-- 돌진(슬롯형 액티브)
		if cardIdx == 155 then
			if upgradeType == "unlock" then
				self.ChargeLevel = 1
				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 155)
					self:ResetSlotTimer(slotIdx)
					log("Card155(Charge) -> Slot" .. slotIdx)
				end
			elseif upgradeType == "charge_up" and self.ChargeLevel < 5 then
				self.ChargeLevel = self.ChargeLevel + 1
			end
			log("Charge L" .. self.ChargeLevel .. " (dmg=" .. math.floor(self:GetChargeDamage(self.ChargeLevel)) .. " targets=" .. self:GetChargeTargetCount(self.ChargeLevel) .. ")")
			return
		end

		-- 버닝 러시 (조합 스킬 — 돌진 슬롯을 그대로 넘겨받는다. 워리어 마스터리/셀프 리커버리는
		-- 둘 다 슬롯 없는 패시브라 비울 슬롯이 없음)
		if cardIdx == 166 then
			if upgradeType == "unlock" then
				self.BurningRushLevel = 1
				local chargeSlot = self:GetSlotForCard(155)
				if chargeSlot > 0 then
					self:AssignCardToSlot(chargeSlot, 166)
					self:ResetSlotTimer(chargeSlot)
					self:PlayThunderStormFusionEffect(chargeSlot)
					log("Card166(BurningRush) fused into Slot" .. chargeSlot .. " (was Charge)")
				else
					log_warning("BurningRush: Charge not found in any slot — fusion could not place the card")
				end
			elseif upgradeType == "burningrush_up" and self.BurningRushLevel < 3 then
				self.BurningRushLevel = self.BurningRushLevel + 1
			end
			log("BurningRush L" .. self.BurningRushLevel .. " (dmg=" .. math.floor(self:GetBurningRushDamage(self.BurningRushLevel)) .. " pct=" .. math.floor(self:GetBurningRushPercent(self.BurningRushLevel) * 100) .. "%)")
			return
		end

		-- 오라 블레이드(슬롯형 액티브)
		if cardIdx == 156 then
			if upgradeType == "unlock" then
				self.AuraBladeLevel = 1
				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 156)
					self:ResetSlotTimer(slotIdx)
					log("Card156(AuraBlade) -> Slot" .. slotIdx)
				end
			elseif upgradeType == "aurablade_up" and self.AuraBladeLevel < 5 then
				self.AuraBladeLevel = self.AuraBladeLevel + 1
			end
			log("AuraBlade L" .. self.AuraBladeLevel .. " (dmg=" .. math.floor(self:GetAuraBladeDamage(self.AuraBladeLevel)) .. " targets=" .. self:GetAuraBladeTargetCount(self.AuraBladeLevel) .. ")")
			return
		end

