	property SpriteGUIRendererComponent labelBg6 = "4e7fd940-e0d8-4124-9832-b600450a6509"
	-- 아이콘 우하단에 겹치는 레벨 배지 배경 — 이것도 카드 뒷면일 땐 숨겨야 한다
	property SpriteGUIRendererComponent levelBadgeBg1 = "1b0c37cb-7d11-4745-98ed-c4ba75da4820"
	property SpriteGUIRendererComponent levelBadgeBg2 = "042ddf81-6416-494d-957e-931c88c92f89"
