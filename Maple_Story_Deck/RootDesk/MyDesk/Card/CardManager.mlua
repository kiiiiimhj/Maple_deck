	property number Card14EffectScale = 0.8  -- 몬스터가 맨 앞까지 접근했을 때 연출이 너무 커 보여서 20% 축소
	property number Card14EffectBaseAlpha = 0.8  -- 기본 알파를 20% 낮춤(페이드아웃은 이 값에서 0까지 진행)

	-- ── 실피드 전용: 애로우샷 (기본공격, 카드 25) — 아르카나의 파이어샷(Card1)과 완전히 별도의 트랙이다.
