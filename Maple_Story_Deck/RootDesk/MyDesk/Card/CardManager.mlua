	method number GetStormPoemDamage(integer level)
		if level >= 3 then return 140
		elseif level >= 2 then return 120
		end
		return 100
	end

	-- 화살 발사 수(=바람의 시처럼 타겟 수만큼 순환 분산) — Lv1:5 / Lv2:6 / Lv3:7
	-- SkillInventory 폭풍의 시(인덱스30) Lv9: 추가 타격 +2, 카드 자체 레벨과 별개로 항상 가산
	method integer GetStormPoemHitCount(integer level)
		local base = 5
		if level >= 3 then base = 7
		elseif level >= 2 then base = 6
		end
		return base + math.floor(self:GetSkillInvTierPercent(30, 0, 0, 2))
	end

	-- 추가 타격 확률(화살마다 독립 판정) — Lv1:15% / Lv2:15% / Lv3:20%
	method number GetStormPoemExtraChance(integer level)
		if level >= 3 then return 0.20 end
		return 0.15
	end

	-- 추가 타격 대미지 비율 — Lv1:90% / Lv2:120% / Lv3:150%
	method number GetStormPoemExtraPercent(integer level)
		if level >= 3 then return 1.50
		elseif level >= 2 then return 1.20
		end
		return 0.90
	end

	-- 유저 확인: "단일 타겟인가? 바람의시처럼 타겟팅하면 좋겠는데" → 바람의 시(WindPoemAttack)와
	-- 동일하게 히트 수만큼 GetClosestTargets로 뽑아 순환 배분한다(몬스터가 히트 수보다 적으면 wraparound).
	-- 기존의 "한 타겟에 전부 집중" 설계는 폐기.
	@ExecSpace("ServerOnly")
	method void StormPoemAttack(number damage, boolean isCrit)
		self:PlayWindPoemSound()
		local level = self.StormPoemLevel
		local hitCount = self:GetStormPoemHitCount(level)
		local aliveTargets = self:GetClosestTargets(hitCount)
		if #aliveTargets == 0 then return end
		local arrowTargets = {}
		for i = 1, hitCount do
			local idx = ((i - 1) % #aliveTargets) + 1
			table.insert(arrowTargets, aliveTargets[idx])
		end
		self:PlayStormPoemBow(arrowTargets, damage, isCrit, level)
	end

	-- 유저 지적: "폭풍의시 연출 나오는데 왜 바람의 시연출도 뜨는거야" / "폭풍의 시연출만 나오고 그때
	-- 화살이 나가야지" — 바람의 시의 생성연출(prepare)·활쏘는연출(keydownend) 플래시를 재사용하지
	-- 않는다. 이후 유저 정정: "3d659525... 이 연출로 바꾸라는거지 원본을 유지하라는게 아님" — 처음에
	-- 끼워넣었던 keydown/6~10 활 당기는 연출은 완전히 제거하고, 쏘는 연출(3d659525...) 하나만 단독
	-- 재생한 뒤 그게 다 끝나면 화살을 쏜다.
	@ExecSpace("ServerOnly")
	method void PlayStormPoemBow(any targets, number damage, boolean isCrit, integer level)
		self:PlayStormPoemShoot(self:GetBowSpawnPosition(), self.Card101BowRotation)

		-- 유저 요청: 화살은 즉발 — 쏘는 연출(0.8초)이 끝나길 기다리지 않고 시작 직후(0.05초)에 쏜다
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			for i = 1, #targets do
				local staggerDelay = (i - 1) * self.Card116ArrowStaggerDelay
				local target = targets[i]
				_TimerService:SetTimerOnce(function()
					if not isvalid(self) then return end
					if isvalid(target) and isvalid(target.Entity) and not target._dead then
						self:FireStormPoemArrow(target, damage, isCrit, level)
					end
				end, staggerDelay)
			end
		end, self.Card116ArrowStartDelay)
	end

	-- "쏘는 연출" — 활 당기는 연출(keydown/6~10)을 대체하는 단독 연출이다(유저 정정: "이 연출로
	-- 바꾸라는거지 원본을 유지하라는게 아님"). 원본 리소스가 커서(최대 636x444) 30% 축소해서 재생한다
	@ExecSpace("ServerOnly")
	method void PlayStormPoemShoot(Vector3 pos, number rotation)
		local frames = self:GetStormPoemShootFrames()
		local dur = self.Card116FrameDuration
		local fx = self:SpawnEffectWithModel(frames[1], pos, rotation, 1.0, self.Card116ShootScale, 1.0, "skilleffectlong")
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		for i = 2, #frames do
			local frameRUID = frames[i]
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) and isvalid(renderer) then renderer.SpriteRUID = frameRUID end
			end, dur * (i - 1))
		end
		fx:Destroy(dur * #frames)
	end

	@ExecSpace("ServerOnly")
	method void PlayStormPoemHitEffect(Vector3 pos, number scale)
		local frames = self:GetStormPoemHitFrames()
		local dur = self.Card116FrameDuration
		local fx = self:SpawnEffectWithModel(frames[1], pos, 0, 1.0, scale, 1.0, "skilleffectlong")
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		for i = 2, #frames do
			local frameRUID = frames[i]
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) and isvalid(renderer) then renderer.SpriteRUID = frameRUID end
			end, dur * (i - 1))
		end
		fx:Destroy(dur * #frames)
	end

	-- 화살 한 발 발사 — 바람의 시 FireWindPoemArrow와 동일한 발사/비행/착탄 구조를 재사용하되, 착탄
	-- 연출은 전용 리소스(Card116HitRUID)로 교체하고, 착탄 후 화살마다 독립적으로 추가 타격을 판정한다.
	@ExecSpace("ServerOnly")
	method void FireStormPoemArrow(MonsterAI target, number damage, boolean isCrit, integer level)
		local p1 = target.Entity.TransformComponent.Position
		local hitPos = Vector3(p1.x, p1.y + 0.3, p1.z)
		local bowPos = self:GetBowSpawnPosition()
		local startPos = Vector3(bowPos.x + self.Card116ArrowSpawnXOffset, bowPos.y + self.Card116ArrowSpawnYOffset, bowPos.z)
		-- 버그 수정(2026-08-26, 유저 지적: "화면 넘어갔는데 이펙트가 다음 존에 존재") — 캐스트 시점
		-- 존 인덱스를 캡처해 지연 콜백 시점에 현재 존과 다르면 이펙트 스폰을 건너뛴다.
		local castZoneIndex = target._spawnZoneIndex

		local dx = hitPos.x - startPos.x
		local dy = hitPos.y - startPos.y
		local angle = math.deg(math.atan(dy, dx))

		local fx = self:SpawnEffect(self.Card116ArrowRUID, startPos, angle, 1.5, 1.5 * (self:GetEffectScaleRatio(target)), 1)
		self:FlyWindPoemArrow(fx, startPos, hitPos)

		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			if isvalid(target) and isvalid(target.Entity) and not target._dead then
				if isCrit then target:TakeDamageCrit(damage * 2)
				else target:TakeDamage(damage) end
			end
			if castZoneIndex == _MapManager.CurrentMapIndex then
				local scaleRatio = isvalid(target) and self:GetEffectScaleRatio(target) or 1.0
				self:PlayStormPoemHitEffect(hitPos, 1.3 * scaleRatio)
			end

			-- 추가 타격 — 화살마다(=이 호출마다) 독립적으로 판정(유저 확인: "독립적")
			local extraChance = self:GetStormPoemExtraChance(level)
			if _UtilLogic:RandomDouble() < extraChance then
				local extraPercent = self:GetStormPoemExtraPercent(level)
				_TimerService:SetTimerOnce(function()
					if not isvalid(self) then return end
					if isvalid(target) and isvalid(target.Entity) and not target._dead then
						local extraDamage = damage * extraPercent
						if isCrit then target:TakeDamageCrit(extraDamage * 2)
						else target:TakeDamage(extraDamage) end
					end
				end, self.HitEffectLifetime)
			end
		end, self.Card101ArrowFlightDuration)
	end

	-- ── 실피드 전용: 애로우 블로우 (카드 102, 슬롯형 정식 스킬 2호) — 항상 단일 타겟, 쿨타임 2.5초
	-- 고정. Lv2+에서 20% 확률로 "강화 화살"(레벨별 150/160/180/200% 대미지, 전용 화살 리소스)이
	-- 나간다 — 강화든 아니든 타격 연출은 동일하게 재사용한다(유저 요청: "강화화살 타격연출도 그냥
	-- 타격연출이랑 동일하게"). 활대 연출은 바람의 시와 완전히 동일한 방식(위치/회전/레이어수/타이밍)
	-- 으로 재생한다(유저 요청: "활대는 바람의시랑 같게 연출하면 되고") — FlyWindPoemArrow를 화살
	-- 비행에 그대로 재사용한다. 단 활시위를 당기는 연출 자체는 바람의 시와 다르다 — effect/9~15
	-- (정지 스프라이트 7장)를 순서대로 갈아 끼우는 게 진짜 활대 연출이고(유저 확인: "이펙트에 9~15
	-- 부분이게 활대 연출이야"), 그 중 11번째 프레임(시퀀스 3번째 컷) 시점에 실제로 화살이 풀리는
	-- 순간을 표현하는 정식 애니메이션클립을 별도 레이어로 겹쳐 재생한다(유저 요청: "활대 연출
	-- 11번쯤에 이 연출이 들어가면 될 거 같은데").
	@Sync property integer ArrowBlowLevel = 0
	property string Card102Name = "애로우 블로우"
	property string Card102IconRUID = "f62b353e3f704eb097e427b7fc97980e"
	property number Card102Cooldown = 2.5  -- 레벨 무관 고정
	property string Card102BowFrame9RUID = "cb69a2516c4f4d3da364dae36759cf3c"
	property string Card102BowFrame10RUID = "d50087106b6c4808809ac95ee27bc521"
	property string Card102BowFrame11RUID = "51bf1a41c2cd48389e297552a32ad694"
	property string Card102BowFrame12RUID = "1aeade7040284fa1afdb986bbe4bec92"
	property string Card102BowFrame13RUID = "f4df14d37cae4617aadf3e91044f02ef"
	property string Card102BowFrame14RUID = "0395d4fc5be245fcb399771083cec579"
	property string Card102BowFrame15RUID = "7fbcf16702a148b78b3fa4f52dc4bb1e"
	property number Card102BowFrameDuration = 0.1286  -- 프레임당 재생 시간(7프레임 * 0.1286 ≈ 0.9초 예산 — 유저 요청으로 기존 0.5초 대비 0.4초 연장)
	property string Card102BowReleaseClipRUID = "2ed6be9152eb4bf0b22f4ca6e6fff9fe"  -- 11번째 프레임에 겹쳐 재생
	property number Card102BowDuration = 0.9  -- 프레임 시퀀스 총 재생시간과 맞춤(유저 요청: "연출시간 약 0.4s만 더길면" — 0.5→0.9)
	property number Card102FireOffset = 0.3  -- 화살이 활대 연출 끝까지 안 기다리고 이만큼 일찍 발사(유저 요청: "발사되는시간 0.3s 떙겨줘") — 연출 자체 길이(Card102BowDuration)는 그대로 유지
	property number Card102ArrowXOffset = 0.2  -- 화살 스폰 X를 활대 중앙에 맞게 미세 보정 — 이 좌표계는 +X가 화면상 왼쪽으로 보임(유저 요청: "화살대 중앙이랑 안맞아서 <이쪽으로 아주 약간만" → 0.08에서 0.2로 조정)
	property string Card102ArrowEffectRUID = "64142d933e854590a67af044f3d091fb"  -- 일반 화살
	property string Card102EnhancedArrowEffectRUID = "64f775829e234918bd65e9d22214bb06"  -- 강화 화살
	property string Card102HitRUID = "84a473e004a34fdea67aa74a87dc75c6"  -- 일반/강화 공용 타격 연출
	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 전용 리소스팩 번들 오디오(_audio/Hit) 사용
	property string Card102SoundRUID = "b4c345306d4948f1a0b8cc787fd57bef"

	method void PlayArrowBlowSound()
		_SoundService:PlaySound(self.Card102SoundRUID, 1.0)
	end

	method number GetArrowBlowDamage()
		if self.ArrowBlowLevel >= 5 then return 210
		elseif self.ArrowBlowLevel >= 3 then return 170
		end
		return 120
	end

	-- SkillInventory 애로우 블로우(인덱스21) Lv9: "추가 타격 +1"을 강화 화살 확률 100%(사실상 보장)로
	-- 해석해 적용한다 — 카드 자체 레벨과 별개로 항상 가산.
	method number GetArrowBlowEnhanceChance()
		local base = 0
		if self.ArrowBlowLevel >= 2 then base = 0.20 end
		return base + self:GetSkillInvTierPercent(21, 0, 0, 1.0)
	end

	method number GetArrowBlowEnhanceMultiplier()
		if self.ArrowBlowLevel >= 5 then return 2.00
		elseif self.ArrowBlowLevel >= 4 then return 1.80
		elseif self.ArrowBlowLevel >= 3 then return 1.60
		elseif self.ArrowBlowLevel >= 2 then return 1.50
		end
		return 1.0
	end

	-- 캐스팅 시점(호출 시점엔 타겟이 항상 살아있음 — TickCard의 aliveTarget 가드)에 착탄 위치를
	-- 미리 고정해둔다. 활대를 당기는 동안(Card102BowDuration) 타겟이 죽어도 화살 발사/타격 연출은
	-- 항상 끝까지 재생되고, 데미지 적용만 그 시점 생존 여부로 갈린다(유저 요청: "타겟이 죽으면
	-- 연출이 바로 종료되는거 같은데 그것도 고쳐줘" — 바람의 시 추가타와 동일한 정책).
	@ExecSpace("ServerOnly")
	method void ArrowBlowAttack(number damage, boolean isCrit, MonsterAI target)
		self:PlayArrowBlowSound()
		self:PlayArrowBlowBow()
		if not isvalid(target) or not isvalid(target.Entity) then return end
		local p1 = target.Entity.TransformComponent.Position
		local hitPos = Vector3(p1.x, p1.y + 0.3, p1.z)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self:FireArrowBlowArrow(target, hitPos, damage, isCrit)
		end, math.max(0, self.Card102BowDuration - self.Card102FireOffset))
	end

	-- 활대(시위 당기는) 연출 — effect/9~15 정지 스프라이트 7장을 순서대로 갈아 끼우고, 11번째
	-- 프레임(시퀀스 3번째 컷) 시점에 화살이 풀리는 순간을 표현하는 애니메이션클립을 별도 레이어로
	-- 겹쳐 재생한다.
	@ExecSpace("ServerOnly")
	method void PlayArrowBlowBow()
		local frames = {
			self.Card102BowFrame9RUID, self.Card102BowFrame10RUID, self.Card102BowFrame11RUID,
			self.Card102BowFrame12RUID, self.Card102BowFrame13RUID, self.Card102BowFrame14RUID,
			self.Card102BowFrame15RUID,
		}
		local dur = self.Card102BowFrameDuration
		local fx = self:SpawnEffectWithModel(frames[1], self:GetBowSpawnPosition(), self.Card101BowRotation, 1.0, self.Card101BowScale, 1.0, "skilleffectlong")
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		for i = 2, #frames do
			local frameRUID = frames[i]
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) and isvalid(renderer) then renderer.SpriteRUID = frameRUID end
			end, dur * (i - 1))
		end
		fx:Destroy(dur * #frames)

		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			local release = self:SpawnEffectWithModel(self.Card102BowReleaseClipRUID, self:GetBowSpawnPosition(), self.Card101BowRotation, 1.0, self.Card101BowScale, 1.0, "skilleffectlong")
			if release ~= nil then release:Destroy(dur * (#frames - 2)) end
		end, dur * 2)
	end

	-- 화살 발사 — 강화 화살(Lv2+, 20% 확률)이면 배율과 리소스만 바뀌고, 타격 연출은 항상 동일하다.
	-- hitPos는 캐스팅 시점에 이미 고정된 좌표(ArrowBlowAttack 참고) — 타겟이 그 사이 죽어서
	-- isvalid(target)==false가 되어도 화살 비행/타격 연출은 항상 끝까지 재생되고, 데미지 적용만
	-- 그 시점 생존 여부로 건너뛴다.
	@ExecSpace("ServerOnly")
	method void FireArrowBlowArrow(MonsterAI target, Vector3 hitPos, number damage, boolean isCrit)
		local bowPos = self:GetBowSpawnPosition()
		local startPos = Vector3(bowPos.x + self.Card102ArrowXOffset, bowPos.y, bowPos.z)

		local dx = hitPos.x - startPos.x
		local dy = hitPos.y - startPos.y
		-- 이 화살 리소스는 이미지 자체가 반대 방향을 보고 있어 180도 보정한다(일반/강화 화살 공통)
		local angle = math.deg(math.atan(dy, dx)) + 180

		local enhanceChance = self:GetArrowBlowEnhanceChance()
		local isEnhanced = enhanceChance > 0 and _UtilLogic:RandomDouble() < enhanceChance
		local finalDamage = damage
		local arrowRUID = self.Card102ArrowEffectRUID
		if isEnhanced then
			finalDamage = damage * self:GetArrowBlowEnhanceMultiplier()
			arrowRUID = self.Card102EnhancedArrowEffectRUID
		end

		local aliveTarget = isvalid(target) and not target._dead
		local castScaleRatio = aliveTarget and self:GetEffectScaleRatio(target) or 1.0
		local fx = self:SpawnEffect(arrowRUID, startPos, angle, 1.5, 1.2 * castScaleRatio, 1)
		self:FlyWindPoemArrow(fx, startPos, hitPos)

		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			if isvalid(target) and isvalid(target.Entity) and not target._dead then
				if isCrit then target:TakeDamageCrit(finalDamage * 2)
				else target:TakeDamage(finalDamage) end
			end
			local hitAliveTarget = isvalid(target) and not target._dead
			local scaleRatio = hitAliveTarget and self:GetEffectScaleRatio(target) or 1.0
			local hitFx = self:SpawnEffect(self.Card102HitRUID, hitPos, 0, 1.0, 1.3 * scaleRatio, 1)
			if hitFx ~= nil then hitFx:Destroy(self.HitEffectLifetime) end
		end, self.Card101ArrowFlightDuration)
	end

	-- ── 실피드 전용: 강화 애로우 블로우 (카드 117, 조합 스킬) — 애로우 블로우(Card102) Lv5 + 연속
	-- 사격(Card113, 슬롯 없는 패시브) 보유 시 등장. 새 슬롯이 필요없고 애로우 블로우의 슬롯을 그대로
	-- 넘겨받는다(아쿠아 서지/헤일 버스트와 동일한 "슬롯 카드 + 슬롯 없는 패시브" 단일 슬롯 조합
	-- 패턴). 항상 단일 타겟, 쿨타임 2.5초 고정(애로우 블로우와 동일). 캐스트당 화살 발사 수는
	-- 레벨별 2/2/3발(GetEnhancedArrowBlowArrowCount, 유저 요청: "화살 1개 쏘는걸 늘리라는건데" —
	-- 처음에 "3연타 히트 횟수"를 레벨별로 바꿨다가 유저에게 강하게 정정받음: 3연타는 고정 유지하고
	-- 늘려야 하는 건 화살 발사 수였다), 화살마다 Card117ArrowStaggerDelay(0.15초) 간격으로 같은
	-- 타겟에 연사한다. 화살 한 발 한 발이 독립적으로 레벨별 확률(20%/25%/30%, 유저 확인)로 "강화
	-- 화살"인지 판정하는데, 강화 화살은 착탄 시 0.3초 간격으로 동일 대미지가 고정 3회(Card117EnhancedHitCount,
	-- 레벨 무관) 들어간다(히트 간격은 최초 0.15초 → "0.3s정도로 해야할듯" 요청으로 조정). 대미지
	-- 숫자가 겹쳐 보이는 문제(유저 지적: "계속 겹쳐서 나오냐")는 히트마다
	-- TakeDamageWithOffset/TakeDamageCritWithOffset(MonsterAI.mlua 신규 추가)으로 수평 오프셋을 줘서
	-- 해결했다. 크리티컬 여부는 화살당 1회 판정을 그대로 그 화살의 3히트에 공유 — 애로우 블로우
	-- 원본과 동일하게 별도 재판정하지 않는다. 확률에 못 걸리면 "기본화살"(64f77582..., 기존 애로우
	-- 블로우의 강화화살 리소스를 재활용)이 나가고 타격 연출도 애로우 블로우의 기존 타격 연출
	-- (Card102HitRUID)을 그대로 재사용한다(유저 요청: "기본화살 타격은 애로우 블로우의 강화화살
	-- 타격쓰면됨"). 활대 연출(쏘는 연출, 17프레임)은 전용 신규 리소스 — 연출 시작 0.5초 후 첫 화살을
	-- 발사한다(최초엔 폭풍의 시와 동일하게 0.05초 즉발이었으나 "쏘는연출 시작하고 0.5s 있다
	-- 화살발사해야할듯" 요청으로 조정).
	@Sync property integer EnhancedArrowBlowLevel = 0
	property string Card117Name = "강화 애로우 블로우"
	property string Card117IconRUID = "48eed9553f37476aa234798e5fecc709"
	property number Card117Cooldown = 2.5  -- 레벨 무관 고정(애로우 블로우와 동일)
	property string Card117ShootRUID = "32eff4d4e0fe4abb92415cbafac88463"  -- 쏘는 연출(17프레임)
	property number Card117ShootScale = 1.2
	property number Card117FrameDuration = 0.05
	property number Card117ArrowStartDelay = 0.5  -- 유저 요청: 쏘는 연출 시작 0.5초 후 화살 발사
	property string Card117BasicArrowRUID = "64f775829e234918bd65e9d22214bb06"  -- 기본화살(애로우 블로우의 강화화살 리소스 재활용)
	property string Card117EnhancedArrowRUID = "21360dd335dc4c3abb83c3de41001978"  -- 강화 화살
	property string Card117EnhancedHitRUID = "ac818eba02d946458e45a778e41cbaf6"  -- 강화화살 전용 타격 연출(8프레임)
	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 전용 리소스팩 번들 오디오(_audio/Use) 사용
	property string Card117SoundRUID = "0e86c615fcaf4d7cabdb1095b046f0ec"

	method void PlayEnhancedArrowBlowSound()
		_SoundService:PlaySound(self.Card117SoundRUID, 1.0)
	end
	property number Card117EnhancedHitInterval = 0.3  -- 유저 요청: 강화 화살 히트 간격(0.15초 → 0.3초)
	property integer Card117EnhancedHitCount = 3  -- 강화 화살 히트 횟수(레벨 무관 고정 — "그건 유지해야지" 유저 확인)
	property number Card117DamageNumberSpacing = 0.4  -- 유저 요청: 겹쳐 보이는 대미지 숫자를 히트마다 수평으로 떨어뜨림
	property number Card117ArrowStaggerDelay = 0.15  -- 유저 요청: 화살 1개 발사를 레벨별 연사로 늘림(발사 간격)

	method number GetEnhancedArrowBlowDamage(integer level)
		if level >= 3 then return 300
		elseif level >= 2 then return 250
		end
		return 230
	end

	method number GetEnhancedArrowBlowEnhanceChance(integer level)
		if level >= 3 then return 0.30
		elseif level >= 2 then return 0.25
		end
		return 0.20
	end

	-- 캐스트당 발사하는 화살 수 — 유저 요청: "화살 1개 쏘는걸 늘리라는건데" — 레벨별 2/2/3발
	-- 연사(각 화살은 독립적으로 강화 여부를 판정하고, 강화면 고정 3연타가 들어간다)
	-- SkillInventory 강화 애로우 블로우(인덱스31) Lv9: 추가 타격 +2, 카드 자체 레벨과 별개로 항상 가산
	method integer GetEnhancedArrowBlowArrowCount(integer level)
		local base = 2
		if level >= 3 then base = 3 end
		return base + math.floor(self:GetSkillInvTierPercent(31, 0, 0, 2))
	end

	-- 쏘는 연출(32eff4d4e0fe4abb92415cbafac88463) 17프레임
