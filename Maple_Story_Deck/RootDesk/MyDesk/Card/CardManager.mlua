	property string ArrowShotHitRUID4 = "c8967beeb4804ed7adfff261ee7b3d44"
	property string ArrowShotHitRUID5 = "c3a3cc7a2c624c92aff148b9cb984c2b"
	property number ArrowShotHitScale = 0.8
	-- 애로우샷/바람의 시 착탄 연출 공용 — 둘 다 공용 "skilleffect" 모델(0.8초 자동파괴)을 그대로 쓰면
	-- 클립 1루프가 그보다 짧아서 루프가 여러 번 도는 게 보인다(유저 지적: "히트 연출 시간은 2개가
	-- 모두 동일하지? 그래서 루프 도는거 아냐?" — 실제로 원인이었다). SpriteAnimPlayerEndEvent 방식은
	-- 클라이언트 도달 지연으로 첫 루프를 놓칠 수 있어서, 서버가 확정적으로 Destroy 타이머를 걸어
	-- 재생 자체를 짧게 끊는다.
	property number HitEffectLifetime = 0.3

	-- ── 레이온 전용: 기본공격(콤보어택 패시브, 카드 150) — 파이어샷/애로우샷과 동일하게 슬롯 배치와
	-- 무관하게 항상 발동하는 상시 기본공격이며, GameManager.SelectedCharacter==2(레이온)일 때만 틱된다.
	-- 데미지/쿨타임 강화 공식도 동일(×1.2 최대 5회, 이후 +20 고정 / ×0.85 최대 5회)하되 독립된 값으로
	-- 관리한다. 콤보어택 자체(적중 시 대상에게 스택이 쌓이고 5스택에서 자동 폭발)는 MonsterAI에
	-- ComboStack으로 구현되어 있다(FreezeStack과 동일한 "대상에 스택이 쌓이는" 패턴).
	@Sync property number LeionAttackDamage = 100
	@Sync property number LeionAttackCooldown = 0.8
	@Sync property integer LeionAttackUpgradeCount = 0
	property integer LeionAttackMultiplierCap = 5
	property number LeionAttackFlatDamageBonus = 20
	property string LeionAttackName = "연격"
	-- 유저가 지정한 콤보어택 리소스팩("코마")의 skill 아이콘을 그대로 재사용
	property string LeionAttackIconRUID = "38a6aefef6784c42967a997795dba30f"
	-- 유저 지정 공격 스킬 연출(단일 animationclip이라 다른 다중프레임 스킬과 달리 네이티브 재생 그대로 사용)
	property string LeionAttackEffectRUID = "ffaf507b148744f49715a8253477fec0"
	-- 크기 1/4(0.375)→10%↑(0.4125)→5%↑(0.433125)→20%↑(0.51975)→15%↑(0.51975*1.15=0.5977125)
	property number LeionAttackEffectScale = 0.5977125
	-- 유저 지정: 오른쪽(+X)으로 더, 위로 살짝(+Y). 이후 유저 요청으로 오른쪽으로 0.1 추가 이동(0.5->0.6)
	property number LeionAttackEffectOffsetX = 0.6
	property number LeionAttackEffectOffsetY = 0.15
	-- 유저 요청: 연출 스폰 후 이 시간만큼 늦춰서 데미지를 적용(타격 타이밍 싱크)
	property number LeionAttackDamageDelay = 0.2
	-- HitEffectLifetime(0.3초, 여러 스킬 공용)을 그대로 쓰다가 유저 지정으로 0.3초 빠르게(=그대로) 했더니
	-- "연출이 끊기는 느낌"이라는 피드백을 받아, 공용 값은 안 건드리고 레이온 전용 지속시간을 따로 둔다
	property number LeionAttackEffectLifetime = 0.6
	property number _timerBasicLeion = 0

	-- 콤보어택 — 유저 정정: 스택 자체에는 데미지 보너스를 두지 않는다(이전엔 스택당 +4%를 매 타격에
	-- 곱해서 4~20%가 항상 적용됐었다). 대신 5스택 도달 시 그 마지막 타격 데미지의 200%를 폭발 데미지로
	-- 한 번 추가 적용한다(PlayComboFinishBurst 참고).
	-- 5스택 도달 시 자동 폭발 연출 — 리소스팩 "코마"
	property string ComboFinishSoundRUID = "15cbdb9c56db4e87a379ba631e06a3d1"
	-- 콤보어택(Card151)은 기본공격에 딸린 항상-발동 효과가 아니라 별도 슬롯형 스킬 카드다(유저 정정:
	-- "스킬 추가하는거고 레이온 스킬이야"). 레벨(1~5)에 따라 기본공격 적중 시 스택이 붙을 확률만
	-- 오르고(10/15/20/30/35%, _CardRegistry.GetChance(151, lv) 참고), 0이면(미해금) 전혀 안 붙는다.
	@Sync property integer ComboAttackLevel = 0

	-- 레이온 기본공격 — 콤보어택(Card151)을 해금한 상태에서만, 적중 시 그 레벨의 확률로 대상에게
	-- 콤보 스택을 쌓는다(유저 지정: "캐릭터한테 스택이 쌓이는게 아니라 몬스터한테 스택이 쌓이게").
	-- 스택 자체엔 데미지 보너스가 없다(유저 정정) — 5스택 도달 시 PlayComboFinishBurst가 그 마지막
	-- 타격 데미지의 200%를 폭발 데미지로 한 번 추가할 뿐이다.
	@ExecSpace("ServerOnly")
	method void LeionBasicAttack(number damage, boolean isCrit, MonsterAI target)
		if not isvalid(target) or not isvalid(target.Entity) or target._dead then return end

		-- 유저 제안: 연출을 데미지보다 먼저 스폰해서, 이 타격으로 몬스터가 죽어 Die()의 사망 처리
		-- (드랍 계산 등)가 뒤이어 실행되더라도 연출 스폰 코드 자체는 이미 끝난 뒤라 절대 영향받지
		-- 않게 한다(유저 리포트: "몬스터가 죽더라도 연출은 나가야지" — 여전히 가끔 안 나오는 케이스가
		-- 있어서, "캡처 후 데미지→연출" 순서보다 한 발 더 나아가 "연출 먼저→데미지"로 완전히 바꿨다).
		-- WorldPosition을 GetCurrentMap() 기준 로컬로 변환한 뒤(존 오프셋 두 번 겹침 방지 —
		-- WorldToCurrentMapLocal 주석 참고), 유저 지정 오프셋(오른쪽으로 더, 위로 살짝)만큼 옮긴다.
		local p1 = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
		local hitPos = Vector3(p1.x + self.LeionAttackEffectOffsetX, p1.y + self.LeionAttackEffectOffsetY, p1.z)
		local fx = self:SpawnEffect(self.LeionAttackEffectRUID, hitPos, 0, 1.0, self.LeionAttackEffectScale * (self:GetEffectScaleRatio(target)), 1.0)
		if fx ~= nil then fx:Destroy(self.LeionAttackEffectLifetime) end

		-- 유저 요청: 데미지 적용 타이밍을 연출 스폰 시점보다 LeionAttackDamageDelay만큼 늦춘다.
		-- 그 사이 대상이 다른 공격으로 먼저 죽을 수 있으니 콜백 시점에 다시 유효성을 확인한다.
		local capturedTarget = target
		local capturedDamage = damage
		local capturedIsCrit = isCrit
		_TimerService:SetTimerOnce(function()
			if not isvalid(capturedTarget) or not isvalid(capturedTarget.Entity) or capturedTarget._dead then return end
			-- 콤보 스택 자체에는 데미지 보너스가 없다 — 5스택 폭발(PlayComboFinishBurst)이 실제 적용된
			-- 데미지(크리티컬 반영 후)의 200%를 따로 터뜨리므로, AddComboStack에 그 값을 그대로 넘긴다.
			-- (and/or 삼항 표현 대신 if/else로 명시 — 삼항식은 mlua 정적 타입 추론이 number로 확정하지
			-- 못해 강타입 MonsterAI 파라미터에 대한 메서드 호출에서 LEA-1102가 발생했다)
			local appliedDamage = capturedDamage
			if capturedIsCrit then
				appliedDamage = capturedDamage * 2
				capturedTarget:TakeDamageCrit(appliedDamage)
			else
				capturedTarget:TakeDamage(appliedDamage)
			end
			-- SkillInventory 콤보 어택(인덱스55) 레벨의 +3%/+6%/+9%가 카드 자체 레벨과 별개로 항상
			-- 가산된다 — 카드가 미해금(ComboAttackLevel=0)이어도 SkillInventory만으로 스택 확률이
			-- 생길 수 있어야 하므로(파이널 어택:활과 동일 패턴) 게이트도 SkillInventory 여부를 같이 본다.
			if (self.ComboAttackLevel > 0 or self:GetSkillInvLevelByIndex(55) > 0) and not capturedTarget._dead then
				local chance = 0
				if self.ComboAttackLevel > 0 then chance = _CardRegistry:GetChance(151, self.ComboAttackLevel) end
				chance = chance + self:GetSkillInvTierPercent(55, 0.03, 0.06, 0.09)
				if _UtilLogic:RandomDouble() < chance then
					capturedTarget:AddComboStack(appliedDamage)
				end
			end
			log("LeionBasicAttack: dmg=" .. math.floor(appliedDamage))
		end, self.LeionAttackDamageDelay)
	end

	-- 실제 "콤보 어택" 계열 오브 클립(6프레임: index0=생성 연출, index1~5=스택 1~5 표시 프레임).
	-- MonsterAI가 스택 개수만큼(오브 슬롯 1~5) 스폰해서 원형으로 돌리는데, 각 오브는 자기 슬롯
	-- 번호(N)에 도달할 때까지 index 0→N을 순서대로 재생하다가 N에서 정지 유지한다(유저 지정 —
	-- "1->3(두번째 콤보)" 등 프레임 진행+정지 규칙). 애니메이션 자동재생이 아니라 MonsterAI가
	-- StartFrameIndex=EndFrameIndex를 매 프레임 수동으로 갱신하는 방식으로 구현
	property string ComboOrbRUID = "5a61ef5c39564849ac042304d4cb245b"

	-- MonsterAI.TriggerComboFinish()가 5스택 도달 시점에 호출 — 폭발 연출 + 전용 사운드 +
	-- 5번째 스택을 쌓은 그 마지막 타격 데미지(lastHitDamage, 크리티컬 반영 후)의 배율(기본 200%,
	-- 코마(Card162) 보유 시 레벨별 220~260%) 폭발 데미지. 연출은 코마 미해금 시 일반(ComaNormalEffectRUID),
	-- 해금 시 강화(ComaEnhancedEffectRUID)로 고정 선택한다(예전엔 finish/1~10 중 무작위 재생이었음).
	@ExecSpace("ServerOnly")
	method void PlayComboFinishBurst(MonsterAI target, number lastHitDamage)
		if not isvalid(target) or not isvalid(target.Entity) then return end
		local ruid = self.ComaNormalEffectRUID
		if self.ComaLevel > 0 then ruid = self.ComaEnhancedEffectRUID end
		local pos = target.Entity.TransformComponent.Position
		local scale = self:GetEffectScaleRatio(target) * 1.3
		local fx = self:SpawnEffect(ruid, pos, 0, 1.0, scale, 1.0)
		if fx ~= nil then fx:Destroy(1.0) end
		self:PlayComboFinishSound()
		local burstMult = self:GetComaBurstMult(self.ComaLevel)
		-- SkillInventory 슬래시 스톰(인덱스51) Lv9: 콤보 폭발 대미지 15% 증가, 카드 자체 레벨과 별개로
		-- 항상 가산(코마의 콤보 폭발 배율에 그대로 얹는다)
		burstMult = burstMult + self:GetSkillInvTierPercent(51, 0, 0, 0.15)
		if not target._dead then
			target:TakeDamage(lastHitDamage * burstMult)
		end
		log("PlayComboFinishBurst: ruid=" .. ruid .. " burstDmg=" .. math.floor(lastHitDamage * burstMult))
	end

	@ExecSpace("Multicast")
	method void PlayComboFinishSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.ComboFinishSoundRUID, 1.0)
	end

	-- ── 레이온 전용: 슬래시 (카드 152, 슬롯형 정식 스킬 1호) — "슬래시 블러스트" 리소스팩 재사용.
	-- Lv1~5 고정 데미지 테이블(120/120/140/160/200), 쿨타임은 레벨 무관 3초 고정, 타겟 수만
	-- 레벨별로 늘어난다(Lv1:1명/Lv2~4:2명/Lv5:3명, GetClosestTargets로 선정, 각 단일 타격).
	-- 맞은 대상마다 100% 확률(=항상) 콤보 스택 1을 추가한다 — ComboAttackLevel(Card151) 보유 여부와
	-- 무관하게 이 스킬 자체의 고정 효과.
	@Sync property integer SlashLevel = 0
	property number Card152Cooldown = 3.0
	-- 유저 지정: 5~10프레임 재생(원복 — "옆존에서 연출" 문제의 실제 원인은 프레임이 아니라
	-- GetCurrentMap() 존 오프셋 이중 적용이었음, WorldToCurrentMapLocal로 별도 수정됨)
	property string SlashEffectRUID = "eaa71284041b4c8390c32ade11286e16"
	property integer SlashEffectStartFrame = 5
	property integer SlashEffectEndFrame = 10
	property number SlashEffectFrameStepDuration = 0.06
	-- 유저 지정: 기존 대비 20% 축소(1.3*0.8=1.04)
	property number SlashEffectScale = 1.04
	-- 여러 번 조정(1→0.1→0.25→0) 끝에 유저 재지정으로 0.3만큼 오른쪽 이동
	property number SlashEffectOffsetX = 1.3
	property string SlashHitEffectRUID = "3ebd5d6967394c2589408f69c2bc5c54"
	-- 유저 지정: 기존 대비 20% 축소(1.0*0.8=0.8)
	property number SlashHitEffectScale = 0.8
	property string SlashSoundRUID = "ca35cb7d0652411395a5bb90a5beecd3"

	-- 타당 데미지(레벨별 고정값, 배율 아님 — 유저 지정 표)
	method number GetSlashDamage(integer level)
		if level >= 5 then return 240
		elseif level >= 4 then return 200
		elseif level >= 3 then return 170
		elseif level >= 2 then return 150
		end
		return 130
	end

	-- 타겟 수(서로 다른 몬스터) — Lv1:1 / Lv2~4:2 / Lv5:3
	method integer GetSlashTargetCount(integer level)
		if level >= 5 then return 3
		elseif level >= 2 then return 2
		end
		return 1
	end

	-- 스윙 연출(frames 5~10)을 대상 몬스터 위치에 한 번씩 스폰해서 정확히 한 번만 재생하고 정지한다
	-- (콤보어택 오브와 동일한 "정지-프레임" 수동 제어 — 네이티브 재생은 이 구간을 계속 반복했다).
	-- 유저 지정: "각각 나가야지" — 캐스터 위치 1곳이 아니라 맞은 몬스터마다 개별로 재생한다.
	-- pos/scale은 SlashAttack이 데미지를 넣기 "전" 시점에 미리 캡처해서 넘긴다(아래 SlashAttack 주석 참고).
	@ExecSpace("ServerOnly")
	method void PlaySlashSwingEffect(Vector3 pos, number scale)
		local map = self:GetCurrentMap()
		if map == nil then return end
		local fx = _SpawnService:SpawnByModelId("skilleffectlong", "FX", pos, map)
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		if renderer ~= nil then renderer.SpriteRUID = self.SlashEffectRUID end
		fx.TransformComponent.Scale = Vector3(scale, scale, 1.0)
		local frameCount = self.SlashEffectEndFrame - self.SlashEffectStartFrame + 1
		for i = 0, frameCount - 1 do
			local frameIdx = self.SlashEffectStartFrame + i
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) and isvalid(renderer) then
					renderer.StartFrameIndex = frameIdx
					renderer.EndFrameIndex = frameIdx
				end
			end, i * self.SlashEffectFrameStepDuration)
		end
		fx:Destroy(frameCount * self.SlashEffectFrameStepDuration + 0.05)
	end

	@ExecSpace("ServerOnly")
	method void SlashAttack(number damage, boolean isCrit)
		local targets = self:GetClosestTargets(self:GetSlashTargetCount(self.SlashLevel))
		if #targets == 0 then return end

		self:PlaySlashSound()

		for _, target in ipairs(targets) do
			-- 유저 제안: 연출을 데미지보다 먼저 스폰해서, 이 타격으로 몬스터가 죽어 Die()의 사망
			-- 처리가 뒤이어 실행되더라도 연출 스폰 코드 자체는 이미 끝난 뒤라 절대 영향받지 않게 한다
			-- (유저 리포트: 여전히 가끔 연출이 안 나오는 케이스가 있어 "캡처 후 데미지→연출" 순서보다
			-- 한 발 더 나아가 "연출 먼저→데미지"로 완전히 바꿨다).
			local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
			local scaleRatio = self:GetEffectScaleRatio(target)

			self:PlaySlashSwingEffect(Vector3(p.x + self.SlashEffectOffsetX, p.y + 0.3, p.z - 0.1), self.SlashEffectScale * scaleRatio)
			local hitFx = self:SpawnEffect(self.SlashHitEffectRUID, Vector3(p.x, p.y, p.z), 0, 1.0, self.SlashHitEffectScale * scaleRatio, 1.0)
			if hitFx ~= nil then hitFx:Destroy(self.HitEffectLifetime) end

			local appliedDamage = damage
			if isCrit then
				appliedDamage = damage * 2
				target:TakeDamageCrit(appliedDamage)
			else
				target:TakeDamage(appliedDamage)
			end
			target:AddComboStack(appliedDamage)
			self:TryExtraComboStack(152, target, appliedDamage)
		end
		log("SlashAttack: hit=" .. #targets .. "/" .. self:GetSlashTargetCount(self.SlashLevel))
	end

	@ExecSpace("Multicast")
	method void PlaySlashSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.SlashSoundRUID, 1.0)
	end

	-- ── 레이온 전용: 브랜디쉬 (카드 153, 슬롯형 액티브 2호) — 슬래시(152)와 데미지/쿨타임 테이블은
	-- 유사하며 방식도 동일하다: 맞은 대상마다 스윙+타격 연출을 "각각" 재생한다(유저 정정 — "이것도
	-- 개별 타겟이야", 캐스터 위치 1곳 공용 연출로 잘못 구현했던 최초 버전을 폐기하고 슬래시와 동일한
	-- per-target 패턴으로 수정). GetClosestTargets로 대상 선정(Lv1-2:1명/Lv3-5:2명). 쿨타임은 Lv1만
	-- 5초, Lv2 이상은 4.5초 고정.
	@Sync property integer BrandishLevel = 0
	property string BrandishSwingEffectRUID = "8b26a0cdb63d455e82d1ca0fddf5e139"
	property integer BrandishSwingStartFrame = 0
	property integer BrandishSwingEndFrame = 9
	property number BrandishSwingFrameStepDuration = 0.06
	property number BrandishSwingScale = 1.0
	property number BrandishSwingOffsetX = 1.5
	property number BrandishSwingOffsetY = 0.3
	property string BrandishHitEffectRUID = "38e9351c34b843ddbcc191c762e7464c"
	property number BrandishHitEffectScale = 1.0
	property string BrandishSoundRUID = "6c06fe8ab27b469eb61f466ea7f7e182"

	-- 타당 데미지(레벨별 고정값 — 유저 지정 표)
	method number GetBrandishDamage(integer level)
		if level >= 5 then return 200
		elseif level >= 4 then return 180
		elseif level >= 3 then return 160
		elseif level >= 2 then return 140
		end
		return 120
	end

	-- 쿨타임 — Lv1만 5초, Lv2 이상은 4.5초 고정(유저 지정 표)
	method number GetBrandishCooldown(integer level)
		if level >= 2 then return 4.5 end
		return 5.0
	end

	-- 타겟 수(GetClosestTargets로 선정) — Lv1-2:1 / Lv3-5:2
	method integer GetBrandishTargetCount(integer level)
		if level >= 3 then return 2 end
		return 1
	end

	-- 스윙 연출(PlaySlashSwingEffect와 동일한 "정지-프레임" 수동 제어) — 맞은 대상마다 개별 호출된다
	-- (유저 정정: "이것도 개별 타겟이야" — 캐스터 위치 1곳 공용 스폰 방식은 폐기).
	@ExecSpace("ServerOnly")
	method void PlayBrandishSwingEffect(Vector3 pos, number scale)
		local map = self:GetCurrentMap()
		if map == nil then return end
		local fx = _SpawnService:SpawnByModelId("skilleffectlong", "FX", pos, map)
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		if renderer ~= nil then renderer.SpriteRUID = self.BrandishSwingEffectRUID end
		fx.TransformComponent.Scale = Vector3(scale, scale, 1.0)
		local frameCount = self.BrandishSwingEndFrame - self.BrandishSwingStartFrame + 1
		for i = 0, frameCount - 1 do
			local frameIdx = self.BrandishSwingStartFrame + i
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) and isvalid(renderer) then
					renderer.StartFrameIndex = frameIdx
					renderer.EndFrameIndex = frameIdx
				end
			end, i * self.BrandishSwingFrameStepDuration)
		end
		fx:Destroy(frameCount * self.BrandishSwingFrameStepDuration + 0.05)
	end

	@ExecSpace("ServerOnly")
	method void BrandishAttack(number damage, boolean isCrit)
		local targets = self:GetClosestTargets(self:GetBrandishTargetCount(self.BrandishLevel))
		if #targets == 0 then return end

		self:PlayBrandishSound()

		for _, target in ipairs(targets) do
			-- 유저 확정 패턴: 연출을 데미지보다 먼저 스폰(몬스터가 죽어도 연출은 항상 나가야 함)
			local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
			local scaleRatio = self:GetEffectScaleRatio(target)

			self:PlayBrandishSwingEffect(Vector3(p.x + self.BrandishSwingOffsetX, p.y + self.BrandishSwingOffsetY, p.z - 0.1), self.BrandishSwingScale * scaleRatio)
			local hitFx = self:SpawnEffect(self.BrandishHitEffectRUID, Vector3(p.x, p.y, p.z), 0, 1.0, self.BrandishHitEffectScale * scaleRatio, 1.0)
			if hitFx ~= nil then hitFx:Destroy(self.HitEffectLifetime) end

			local appliedDamage = damage
			if isCrit then
				appliedDamage = damage * 2
				target:TakeDamageCrit(appliedDamage)
			else
				target:TakeDamage(appliedDamage)
			end
			target:AddComboStack(appliedDamage)
			self:TryExtraComboStack(153, target, appliedDamage)
		end
		log("BrandishAttack: hit=" .. #targets .. "/" .. self:GetBrandishTargetCount(self.BrandishLevel))
	end

	@ExecSpace("Multicast")
	method void PlayBrandishSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.BrandishSoundRUID, 1.0)
	end

	-- ── 레이온 전용: 플래시 슬래시 (카드 154, 슬롯형 액티브 3호) — 슬래시/브랜디쉬와 달리 "그 대상만"
	-- 맞는 스킬이 아니다. GetClosestTargets로 뽑힌 대상 수만큼, 각 대상의 위치에서 좌/우 랜덤 방향으로
	-- 이동하는 연출을 하나씩 띄우고, 그 연출이 지나가는 경로에 닿는 몬스터는(애초 뽑힌 대상이 아니어도)
	-- 전부 맞는 관통형 이동 판정이다(더블 커터의 LaunchDoubleCutterTravel과 동일 패턴 재사용 — 단,
	-- 이동 거리가 아니라 유저 지정대로 "연출이 사라질 때까지"인 지속시간으로 종료). 오른쪽으로 이동할
	-- 때는 연출을 좌우 반전한다(유저 지정: "우는 스킬 연출 반대로 해야함").
	@Sync property integer FlashSlashLevel = 0
	property number Card154Cooldown = 5.0
	property string FlashSlashTravelEffectRUID = "7bc3041a25934c14a2c6e4a78420bc89"
	property string FlashSlashHitEffectRUID = "9c968d7e53ba4ccc8b242ac6d5748e40"
	property string FlashSlashSoundRUID = "3a0e45300efd4623addaa0c30ba4cadc"
	property number FlashSlashTravelSpeed = 3.0
	property number FlashSlashTravelDuration = 0.6
	property number FlashSlashTravelTickInterval = 0.1
	property number FlashSlashHitRadius = 0.9
	property number FlashSlashScale = 1.0

	-- 타당 데미지(레벨별 고정값 — 유저 지정 표)
	method number GetFlashSlashDamage(integer level)
		if level >= 5 then return 200
		elseif level >= 4 then return 180
		elseif level >= 3 then return 160
		elseif level >= 2 then return 140
		end
		return 120
	end

	-- 타겟 수(각각 별도의 이동 연출을 받는 시작 지점 개수) — Lv1:1 / Lv2-4:2 / Lv5:3
	method integer GetFlashSlashTargetCount(integer level)
		if level >= 5 then return 3 end
		if level >= 2 then return 2 end
		return 1
	end

	@ExecSpace("ServerOnly")
	method void FlashSlashAttack(number damage, boolean isCrit)
		local targets = self:GetClosestTargets(self:GetFlashSlashTargetCount(self.FlashSlashLevel))
		if #targets == 0 then return end

		self:PlayFlashSlashSound()

		for _, target in ipairs(targets) do
			local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
			local scaleRatio = self:GetEffectScaleRatio(target)
			local direction = 1
			if _UtilLogic:RandomDouble() < 0.5 then direction = -1 end

			local map = self:GetCurrentMap()
			if map ~= nil then
				local fx = _SpawnService:SpawnByModelId("skilleffectlong", "FX", Vector3(p.x, p.y, p.z - 0.1), map)
				if fx ~= nil then
					local renderer = fx.SpriteRendererComponent
					if renderer ~= nil then
						renderer.SpriteRUID = self.FlashSlashTravelEffectRUID
						renderer.FlipX = (direction > 0)
					end
					local s = self.FlashSlashScale * scaleRatio
					fx.TransformComponent.Scale = Vector3(s, s, 1.0)
					self:LaunchFlashSlashTravel(fx, Vector3(p.x, p.y, p.z), direction, damage, isCrit, target)
				end
			end
		end
		log("FlashSlashAttack: targets=" .. #targets)
	end

	-- direction(+1=오른쪽/-1=왼쪽)으로 매 틱(FlashSlashTravelTickInterval) 위치를 옮기고, 그 위치 반경
	-- 안의 몬스터를(한 번씩만, hitSet으로 관리) 타격한다. 더블 커터와 달리 이동 거리가 아니라
	-- FlashSlashTravelDuration(연출이 사라질 때까지)으로 종료한다(유저 지정: "이동은 많이하는건 아니고
	-- 스킬이 사라질떄까지 하면됨").
	@ExecSpace("ServerOnly")
	method void LaunchFlashSlashTravel(Entity fx, Vector3 startPos, integer direction, number damage, boolean isCrit, MonsterAI depthAnchor)
		if not isvalid(fx) then return end
		local hitSet = {}
		local elapsed = 0
		local tickId = 0
		tickId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self) or not isvalid(fx) then
				_TimerService:ClearTimer(tickId)
				return
			end
			elapsed = elapsed + self.FlashSlashTravelTickInterval
			local curX = startPos.x + direction * self.FlashSlashTravelSpeed * elapsed
			local fxPos = fx.TransformComponent.Position
			fx.TransformComponent.Position = Vector3(curX, fxPos.y, fxPos.z)

			local map = self:GetCurrentMap()
			if map ~= nil then
				local monsters = self:GetMonstersInCurrentZone(map)
				for _, mob in ipairs(monsters) do
					---@type MonsterAI
					local m = mob
					if not m._dead and not hitSet[m] then
						local mp = m.Entity.TransformComponent.Position
						local dx = mp.x - curX
						local dy = mp.y - startPos.y
						if (dx * dx + dy * dy) <= (self.FlashSlashHitRadius * self.FlashSlashHitRadius) and self:IsSameDepthBand(depthAnchor, m) then
							hitSet[m] = true
							local finalDamage = damage
							if isCrit then
								finalDamage = damage * 2
								m:TakeDamageCrit(finalDamage)
							else
								m:TakeDamage(finalDamage)
							end
							m:AddComboStack(finalDamage)
							self:TryExtraComboStack(154, m, finalDamage)
							local hp = m.Entity.TransformComponent.Position
							local hfx = self:SpawnEffect(self.FlashSlashHitEffectRUID, Vector3(hp.x, hp.y, hp.z), 0, 1.0, self:GetEffectScaleRatio(m), 1.0)
							if hfx ~= nil then hfx:Destroy(self.HitEffectLifetime) end
							log("FlashSlashAttack: travel hit dmg=" .. math.floor(finalDamage))
						end
					end
				end
			end

			if elapsed >= self.FlashSlashTravelDuration then
				_TimerService:ClearTimer(tickId)
				if isvalid(fx) then fx:Destroy() end
			end
		end, self.FlashSlashTravelTickInterval)
	end

	@ExecSpace("Multicast")
	method void PlayFlashSlashSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.FlashSlashSoundRUID, 1.0)
	end

	-- ── 레이온 전용: 돌진 (카드 155, 슬롯형 액티브 4호) — 실피드의 플레시 미라주(Card108)와 완전히
	-- 동일한 시스템 재사용(유저 지정: "플레시 미라쥬랑 동일 시스템"). 좌/우 최외곽 대상을 중앙(존
	-- 중심)으로 넉백시키고, 그 이동 경로에 있는 다른 몬스터는 충돌 대미지(타격 유닛 %)만 받는다.
	-- 전부 중앙 근방(Card108CenterRadius 안)에 몰려있으면 대신 무작위 2마리를 양끝으로 밀어낸다.
	-- 데미지/타겟수/충돌비율 표가 플레시 미라주와 완전히 동일해서 Card108KnockbackDuration/
	-- Card108CenterRadius/Card108OutwardOvershoot/Card108KnockbackStartDelay 등 공용 타이밍 상수를
	-- 그대로 재사용한다 — 연출(2개 클립을 순서대로 이어붙임)/아이콘/사운드만 레이온 전용으로 교체.
	-- 콤보스택은 붙지 않는다(유저 표에 콤보스택 항목이 없음).
	@Sync property integer ChargeLevel = 0
	property number Card155Cooldown = 5.0
	property string ChargeEffect1RUID = "ef91af157e1a481cb46a3dc06add959c"
	property string ChargeEffect2RUID = "17d0678308ed420bbcf6599d7f2ddf84"
	property integer ChargeEffect1FrameCount = 8
	property integer ChargeEffect2FrameCount = 8
	property number ChargeEffectFrameStepDuration = 0.07
	-- 유저 지정: 첫 연출은 즉시, 두번째 연출은 첫 연출이 끝나길 기다리지 않고 0.2초 뒤 겹쳐서 등장
	property number ChargeEffect2Delay = 0.2
	-- 유저 지정: 넉백은 연출 시작과 동시에 바로 들어간다("넉백 바로 되게해야겠다 연출즉시") — 플레시
	-- 미라주/플래시 봄버가 쓰는 공용 Card108KnockbackStartDelay(0.7초)는 그대로 두고 돌진만 독립된
	-- 지연값(0초)을 쓴다.
	property number ChargeKnockbackStartDelay = 0
	property number ChargeEffectScale = 1.0
	property string ChargeHitEffectRUID = "f0f5068c3da743f1addd85e35f2f4b5f"
	property number ChargeHitEffectScale = 1.0
	property string ChargeSoundRUID = "f5a9f40c07c645c88e069849a566b4ff"

	-- 타당 데미지 — 플레시 미라주(Card108)와 완전히 동일한 표
	method number GetChargeDamage(integer level)
		if level >= 5 then return 200
		elseif level >= 4 then return 160
		elseif level >= 3 then return 140
		end
		return 100
	end

	-- 타겟 수(=동시에 넉백시키는 유닛 수) — 플레시 미라주와 동일: Lv1:1명 / Lv2~5:2명
	method integer GetChargeTargetCount(integer level)
		if level >= 2 then return 2 end
		return 1
	end

	-- 충돌 대상("타격 유닛") 대미지 비율 — 플레시 미라주와 완전히 동일한 표(30/30/40/50/60%)
	-- SkillInventory 돌진(인덱스43) Lv9: 충돌 대미지 20% 증가, 카드 자체 레벨과 별개로 항상 가산
	method number GetChargeCollisionPercent(integer level)
		local base = 0.30
		if level >= 5 then base = 0.60
		elseif level >= 4 then base = 0.50
		elseif level >= 3 then base = 0.40
		end
		return base + self:GetSkillInvTierPercent(43, 0, 0, 0.20)
	end

	-- FleshMirageAttack과 동일한 좌/우 최외곽 탐색 + 중앙 넉백 + 중앙근방 예외(양끝으로 밀어냄) 로직
	@ExecSpace("ServerOnly")
	method void ChargeAttack(number damage, boolean isCrit)
		local map = self:GetCurrentMap()
		if map == nil then return end
		local monsters = self:GetMonstersInCurrentZone(map)
		local centerX = self:GetZoneCenterX()

		local leftExtreme, rightExtreme = nil, nil
		local centerCluster = {}
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local x = m.Entity.TransformComponent.Position.x
				if x < centerX - self.Card108CenterRadius and (leftExtreme == nil or x < leftExtreme.Entity.TransformComponent.Position.x) then
					leftExtreme = m
				elseif x > centerX + self.Card108CenterRadius and (rightExtreme == nil or x > rightExtreme.Entity.TransformComponent.Position.x) then
					rightExtreme = m
				elseif x >= centerX - self.Card108CenterRadius and x <= centerX + self.Card108CenterRadius then
					table.insert(centerCluster, m)
				end
			end
		end
		if leftExtreme == nil and rightExtreme == nil then
			self:FireChargeOutward(map, monsters, centerCluster, centerX, damage, isCrit)
			return
		end

		local targetCount = self:GetChargeTargetCount(self.ChargeLevel)
		local collisionPct = self:GetChargeCollisionPercent(self.ChargeLevel)

		if targetCount >= 2 then
			if leftExtreme ~= nil then
				self:FireChargeShove(map, monsters, leftExtreme, centerX, damage, isCrit, collisionPct)
			elseif #centerCluster > 0 then
				local pick = centerCluster[_UtilLogic:RandomIntegerRange(1, #centerCluster)]
				self:FireChargeShove(map, monsters, pick, centerX - self.Card108OutwardOvershoot, damage, isCrit, collisionPct)
			end
			if rightExtreme ~= nil then
				self:FireChargeShove(map, monsters, rightExtreme, centerX, damage, isCrit, collisionPct)
			elseif #centerCluster > 0 then
				local pick = centerCluster[_UtilLogic:RandomIntegerRange(1, #centerCluster)]
				self:FireChargeShove(map, monsters, pick, centerX + self.Card108OutwardOvershoot, damage, isCrit, collisionPct)
			end
		else
			local pickRight
			if leftExtreme == nil then pickRight = true
			elseif rightExtreme == nil then pickRight = false
			else pickRight = _UtilLogic:RandomDouble() < 0.5 end
			if pickRight then
				self:FireChargeShove(map, monsters, rightExtreme, centerX, damage, isCrit, collisionPct)
			else
				self:FireChargeShove(map, monsters, leftExtreme, centerX, damage, isCrit, collisionPct)
			end
		end
	end

	-- FireFleshMirageOutward와 동일한 "전부 중앙 근방" 예외 처리 — 무작위 2마리를 양끝으로 밀어낸다
	@ExecSpace("ServerOnly")
	method void FireChargeOutward(Entity map, table monsters, table centerCluster, number centerX, number damage, boolean isCrit)
		if #centerCluster < 2 then return end
		local collisionPct = self:GetChargeCollisionPercent(self.ChargeLevel)

		local pool = {}
		for i, m in ipairs(centerCluster) do pool[i] = m end
		for i = #pool, 2, -1 do
			local j = _UtilLogic:RandomIntegerRange(1, i)
			pool[i], pool[j] = pool[j], pool[i]
		end

		self:FireChargeShove(map, monsters, pool[1], centerX - self.Card108OutwardOvershoot, damage, isCrit, collisionPct)
		self:FireChargeShove(map, monsters, pool[2], centerX + self.Card108OutwardOvershoot, damage, isCrit, collisionPct)
	end

	-- FireFleshMirageShove와 완전히 동일한 넉백/충돌 로직 — 연출/타격이펙트만 돌진 전용으로 교체
	@ExecSpace("ServerOnly")
	method void FireChargeShove(Entity map, table monsters, MonsterAI primary, number destX, number damage, boolean isCrit, number collisionPct)
		if not isvalid(primary) or not isvalid(primary.Entity) or not isvalid(primary.Entity.TransformComponent) then return end
		destX = self:ClampKnockbackDestX(primary, destX)
		local primaryX = primary.Entity.TransformComponent.Position.x
		local dirRight = destX > primaryX
		local totalDist = math.abs(destX - primaryX)

		local pp = primary.Entity.TransformComponent.Position
		self:PlayChargeSound()
		self:PlayChargeEffect(Vector3(pp.x, pp.y + self.Card108EffectYOffset, pp.z), dirRight, self:GetEffectScaleRatio(primary))
		-- 버그 수정(2026-08-26, 유저 지적: "화면 넘어갔는데 이펙트가 다음 존에 존재") — 캐스트 시점
		-- 존 인덱스를 캡처해, 넉백 지연 이후 충돌 히트 이펙트가 다른 존에 잘못 나타나지 않게 한다.
		local castZoneIndex = primary._spawnZoneIndex

		-- 버그 수정(2026-08-26, 유저 지적: "연출 끊기는거 같은데") — primary가 KnockbackStartDelay
		-- 도중 죽으면 이 블록 전체(주변 다른 몬스터 충돌 히트 이펙트까지)가 통째로 스킵됐다. primary
		-- 관련 로직(넉백 이동)만 따로 생사 체크하고, 충돌 판정/연출은 primary 생사와 무관하게 항상
		-- 진행한다(primaryX/dirRight/totalDist/destX는 이미 타이머 시작 전에 값으로 캡처돼 있어 primary가
		-- 죽거나 파괴돼도 안전). 각 충돌 대상(m)의 히트 이펙트도 데미지와 분리해서 항상 재생한다.
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end

			if isvalid(primary) and isvalid(primary.Entity) and not primary._dead then
				if isCrit then primary:TakeDamageDelayedDeath(damage * 2, true, self.Card108KnockbackDuration)
				else primary:TakeDamageDelayedDeath(damage, false, self.Card108KnockbackDuration) end
				primary:ApplyLateralShove(destX, self.Card108KnockbackDuration)
			end

			local collideCount = 0
			if totalDist > 0 then
				for _, mob in ipairs(monsters) do
					---@type MonsterAI
					local m = mob
					if isvalid(m) and m ~= primary and not m._dead and isvalid(m.Entity) and self:IsSameDepthBand(primary, m) then
						local mx = m.Entity.TransformComponent.Position.x
						local inPath = (dirRight and mx >= primaryX and mx <= destX)
							or ((not dirRight) and mx <= primaryX and mx >= destX)
						if inPath then
							collideCount = collideCount + 1
							local hitDelay = self.Card108KnockbackDuration * (math.abs(mx - primaryX) / totalDist)
							local collideDamage = damage * collisionPct
							_TimerService:SetTimerOnce(function()
								if not isvalid(m) or not isvalid(m.Entity) then return end
								if castZoneIndex == _MapManager.CurrentMapIndex then
									local hitPos = m.Entity.TransformComponent.Position
									local hitFx = self:SpawnEffect(self.ChargeHitEffectRUID, hitPos, 0, 1.0, self.ChargeHitEffectScale, 1)
									if hitFx ~= nil then hitFx:Destroy(self.HitEffectLifetime) end
								end
								if not m._dead then
									if isCrit then m:TakeDamageCrit(collideDamage * 2)
									else m:TakeDamage(collideDamage) end
								end
							end, hitDelay)
						end
					end
				end
			end

			log("ChargeShove: dmg=" .. math.floor(isCrit and damage * 2 or damage) .. " collide=" .. collideCount .. " dirRight=" .. tostring(dirRight))
		end, self.ChargeKnockbackStartDelay)
	end

	-- 유저 정정: 첫 연출은 즉시 날아가고, 두번째 연출은 첫 연출이 끝나길 기다리지 않고 그로부터
	-- 0.2초 뒤에 겹쳐서 등장한다("연출하고 0.2s있다 ㄱㄱ") — 순차 재생이 아니라 각자 독립된 엔티티로
	-- 동시에(겹쳐서) 재생해야 하므로 fx를 클립별로 따로 스폰한다. 각 클립은 슬래시/브랜디쉬와 동일한
	-- "정지-프레임" 수동 제어로 정확히 한 번씩만 재생한다(네이티브 루프 방지). 오른쪽으로 이동할 때
	-- 좌우 반전.
	@ExecSpace("ServerOnly")
	method void PlayChargeEffect(Vector3 pos, boolean dirRight, number scaleRatio)
		self:PlayChargeEffectClip(pos, dirRight, scaleRatio, self.ChargeEffect1RUID, self.ChargeEffect1FrameCount, 0)
		self:PlayChargeEffectClip(pos, dirRight, scaleRatio, self.ChargeEffect2RUID, self.ChargeEffect2FrameCount, self.ChargeEffect2Delay)
	end

	@ExecSpace("ServerOnly")
	method void PlayChargeEffectClip(Vector3 pos, boolean dirRight, number scaleRatio, string clipRUID, integer frameCount, number startDelay)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			local map = self:GetCurrentMap()
			if map == nil then return end
			local fx = _SpawnService:SpawnByModelId("skilleffectlong", "FX", pos, map)
			if fx == nil then return end
			local renderer = fx.SpriteRendererComponent
			if renderer == nil then return end
			renderer.FlipX = dirRight
			local s = self.ChargeEffectScale * scaleRatio
			fx.TransformComponent.Scale = Vector3(s, s, 1.0)
			renderer.SpriteRUID = clipRUID
			for i = 0, frameCount - 1 do
				_TimerService:SetTimerOnce(function()
					if isvalid(fx) and isvalid(renderer) then
						renderer.StartFrameIndex = i
						renderer.EndFrameIndex = i
					end
				end, i * self.ChargeEffectFrameStepDuration)
			end
			fx:Destroy(frameCount * self.ChargeEffectFrameStepDuration + 0.05)
		end, startDelay)
	end

	@ExecSpace("Multicast")
	method void PlayChargeSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.ChargeSoundRUID, 1.0)
	end

	-- ── 레이온 전용: 오라 블레이드 (카드 156, 슬롯형 액티브 5호) — 두 연출이 동시에 나간다:
	-- 1) GetClosestTargets로 뽑힌 대상 각각의 위치에서 슬래시(Card152)처럼 즉시 재생되는 근접 타격
	-- 연출(연출1), 2) 플레이어 위치에서 화면 위(경험치바 방향)로 수직 상승하며 경로에 걸리는 몬스터를
	-- 전부(뎁스밴드 구분 없이, 킹페페와 동일 방식) 관통 타격하는 연출(연출2, 화면을 벗어나면 소멸).
	-- 두 연출 모두 같은 타격 이펙트를 재사용하고, 맞을 때마다(연출1/연출2 각각 개별) 콤보스택 +1(100%).
	-- 연출2는 기본(가로) 방향을 시계방향 90도 회전시켜 세로로 세운다(이 코드베이스 확정 컨벤션: ZRotation
	-- 값을 올릴수록 시계방향 — Card106CastRotationCorrection 주석 참고).
	@Sync property integer AuraBladeLevel = 0
	property number Card156Cooldown = 5.0
	property string AuraBladeSlashEffectRUID = "5c3501dc981941c5b04c2f690351bce8"
	-- 실측(LoadAnimationClipAndWait): 15프레임, 총 재생시간 0.9초 — 예전엔 0.5초로 잘못 잡아서 끝까지
	-- 재생되지 못하고 중간에 잘렸다(유저 지적으로 실측 확인 후 수정). 0.05초 여유를 둔다.
	property number AuraBladeSlashEffectLifetime = 0.95
	property string AuraBladeVerticalEffectRUID = "2a128f46b0c54f4d8bfafdd2fb29f568"
	property string AuraBladeHitEffectRUID = "9dfe3560a11c4742b7f3acb1bbf631e2"
	property number AuraBladeHitEffectScale = 1.0
	property string AuraBladeSoundRUID = "ca35cb7d0652411395a5bb90a5beecd3"  -- 유저 지정: 슬래시(Card152) 사운드 재사용
	-- 유저 지정 이력: +15%(1.0→1.15) → "이펙트 너무 큼, 30% 줄여"(1.15×0.7=0.805)
	property number AuraBladeEffectScale = 0.805
	-- 유저 지정 이력: 1/3(0.333) → "20% 키워"(0.333×1.2=0.4)
	property number AuraBladeVerticalScale = 0.4
	property number AuraBladeVerticalRotation = -90  -- 유저 지정: 반시계방향 90도(기존 시계방향에서 수정)
	property number AuraBladeVerticalSpeed = 5.0
	property number AuraBladeVerticalTickInterval = 0.05
	-- 유저 지정: 연출2 크기를 20% 키운 만큼(1.0×1.2) 타격 반경도 같이 20% 확장
	property number AuraBladeVerticalHitRadius = 1.2
	-- 발사 시작점(연출1이 나간 타겟 위치) 기준 이 y오프셋을 넘으면 화면 밖으로 간주해 연출을 지운다.
	-- 바람의 시(Card101BowPosition.y=3.8, 플레이어 기준)가 "경험치바 바로 아래, 아직 보임"으로 라이브
	-- 스크린샷 실측 확인된 값이라 그보다 여유 있게 잡았다 — 타겟은 대략 플레이어와 비슷한 높이에 있으므로
	-- 같은 기준을 재사용, 라이브에서 실제로 보고 미세조정이 필요할 수 있다.
	property number AuraBladeVerticalOffscreenY = 4.5

	-- 타당 데미지(레벨별 고정값 — 유저 지정 표)
	method number GetAuraBladeDamage(integer level)
		if level >= 5 then return 200
		elseif level >= 4 then return 180
		elseif level >= 3 then return 160
		elseif level >= 2 then return 140
		end
		return 120
	end

	-- 타겟 수(연출1이 개별 재생되는 시작 지점 개수) — Lv1-2:1 / Lv3-5:2 (유저 지정 표)
	method integer GetAuraBladeTargetCount(integer level)
		if level >= 3 then return 2 end
		return 1
	end

	@ExecSpace("ServerOnly")
	method void AuraBladeAttack(number damage, boolean isCrit)
		local targets = self:GetClosestTargets(self:GetAuraBladeTargetCount(self.AuraBladeLevel))
		if #targets == 0 then return end

		self:PlayAuraBladeSound()

		-- 유저 지정: 연출1(근접)과 연출2(검기)가 같은 몬스터를 동시에 맞히면 벨런스가 깨진다(대미지
		-- 중복 적용 + 콤보스택 중복 적립) — 이번 발동 전체에서 공유하는 "이미 맞은 몬스터" 테이블
		-- (resolvedSet)로 몬스터당 데미지+콤보스택 전부 딱 한 번만 적용되게 막는다. 근접타로 먼저
		-- 맞은 몬스터는 검기가 지나가도 데미지를 받지 않는다(반대 순서는 실행 구조상 발생하지 않음 —
		-- 근접타 루프가 같은 프레임에 전부 끝난 뒤에야 검기의 타이머 틱이 시작되기 때문).
		local resolvedSet = {}

		for _, target in ipairs(targets) do
			local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
			local scaleRatio = self:GetEffectScaleRatio(target)

			-- 유저 실측 지적으로 확인됨: 이 클립은 15프레임/0.9초짜리라 공용 "skilleffect" 모델(자체 Duration
			-- 0.8초 고정)로 스폰하면 클립이 끝까지 재생되기 전에 모델 자체가 먼저 사라진다 — "skilleffectlong"
			-- (Duration 2.5초)으로 스폰하고 AuraBladeSlashEffectLifetime(0.95초)으로 직접 정리한다.
			local fx = self:SpawnEffectWithModel(self.AuraBladeSlashEffectRUID, Vector3(p.x, p.y, p.z - 0.1), 0, 1.0, self.AuraBladeEffectScale * scaleRatio, 1.0, "skilleffectlong")
			if fx ~= nil then fx:Destroy(self.AuraBladeSlashEffectLifetime) end
			local hitFx = self:SpawnEffect(self.AuraBladeHitEffectRUID, Vector3(p.x, p.y, p.z), 0, 1.0, self.AuraBladeHitEffectScale * scaleRatio, 1.0)
			if hitFx ~= nil then hitFx:Destroy(self.HitEffectLifetime) end

			if not resolvedSet[target] then
				resolvedSet[target] = true
				local appliedDamage = damage
				if isCrit then
					appliedDamage = damage * 2
					target:TakeDamageCrit(appliedDamage)
				else
					target:TakeDamage(appliedDamage)
				end
				target:AddComboStack(appliedDamage)
				self:TryExtraComboStack(156, target, appliedDamage)
			end

			-- 유저 정정: 연출2는 플레이어 위치가 아니라 "연출1이 나간 자리"(=이 target의 위치)에서 개별로
			-- 발사돼야 한다 — 타겟이 2명이면 각 타겟 위치에서 각각 위로 하나씩 나간다(공용 1개가 아님).
			self:LaunchAuraBladeVertical(damage, isCrit, p, resolvedSet)
		end

		log("AuraBladeAttack: targets=" .. #targets)
	end

	-- 연출1이 나간 자리(startPos, = 그 타겟의 위치)에서 수직으로 상승하며, 지나가는 경로(반경
	-- AuraBladeVerticalHitRadius)에 있는 몬스터를(한 번씩만, hitSet으로 관리) 전부 타격한다. 특정 타겟에
	-- 종속되지 않는 광역 연출이라 뎁스밴드 구분 없이(킹페페와 동일 방식) 전부 맞는다. 화면 밖
	-- (AuraBladeVerticalOffscreenY)에 닿으면 소멸한다. 타겟이 여러 명이면 이 메서드가 타겟 수만큼
	-- 각각 독립적으로(동시에) 호출된다. resolvedSet은 AuraBladeAttack이 이번 발동 전체에서 공유하는
	-- "이미 맞은 몬스터" 테이블(근접타로 맞은 몬스터는 검기 데미지를 또 받지 않도록 관리).
	@ExecSpace("ServerOnly")
	method void LaunchAuraBladeVertical(number damage, boolean isCrit, Vector3 startPos, table resolvedSet)
		local map = self:GetCurrentMap()
		if map == nil then return end
		local startX = startPos.x
		local startY = startPos.y

		local fx = self:SpawnEffectWithModel(self.AuraBladeVerticalEffectRUID, Vector3(startX, startY, -0.1), self.AuraBladeVerticalRotation, 1.0, self.AuraBladeVerticalScale, 1.0, "skilleffectlong")
		if fx == nil then return end

		local hitSet = {}
		local elapsed = 0
		local tickId = 0
		tickId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self) or not isvalid(fx) then
				_TimerService:ClearTimer(tickId)
				return
			end
			elapsed = elapsed + self.AuraBladeVerticalTickInterval
			local curY = startY + self.AuraBladeVerticalSpeed * elapsed
			local fxPos = fx.TransformComponent.Position
			fx.TransformComponent.Position = Vector3(fxPos.x, curY, fxPos.z)

			local monsters = self:GetMonstersInCurrentZone(map)
			for _, mob in ipairs(monsters) do
				---@type MonsterAI
				local m = mob
				if isvalid(m) and not m._dead and not hitSet[m] and not resolvedSet[m] then
					local mp = m.Entity.TransformComponent.Position
					local dx = mp.x - startX
					local dy = mp.y - curY
					if (dx * dx + dy * dy) <= (self.AuraBladeVerticalHitRadius * self.AuraBladeVerticalHitRadius) then
						hitSet[m] = true
						resolvedSet[m] = true
						local finalDamage = damage
						if isCrit then
							finalDamage = damage * 2
							m:TakeDamageCrit(finalDamage)
						else
							m:TakeDamage(finalDamage)
						end
						m:AddComboStack(finalDamage)
						self:TryExtraComboStack(156, m, finalDamage)
						local hp = m.Entity.TransformComponent.Position
						local hfx = self:SpawnEffect(self.AuraBladeHitEffectRUID, Vector3(hp.x, hp.y, hp.z), 0, 1.0, self:GetEffectScaleRatio(m), 1.0)
						if hfx ~= nil then hfx:Destroy(self.HitEffectLifetime) end
						log("AuraBladeAttack: vertical hit dmg=" .. math.floor(finalDamage))
					end
				end
			end

			if (curY - startY) >= self.AuraBladeVerticalOffscreenY then
				_TimerService:ClearTimer(tickId)
				if isvalid(fx) then fx:Destroy() end
			end
		end, self.AuraBladeVerticalTickInterval)
	end

	@ExecSpace("Multicast")
	method void PlayAuraBladeSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.AuraBladeSoundRUID, 1.0)
	end

	-- ── 레이온 전용 조합 스킬: 솔라 블레이드 (카드 168) — 오라 블레이드(156) Lv5 + 워리어 마스터리
	-- (164) + 콤보 어택(151, 둘 다 슬롯 없는 패시브) 보유 시 등장. 오라 블레이드와 완전히 동일한 매커니즘
	-- (근접 슬래시 연출1 + "검기" 연출2 동시 발동, 타겟 수만큼) 재사용, 새 슬롯이 필요 없고 오라 블레이드의
	-- 슬롯을 그대로 넘겨받는다. 유저 지정으로 연출1/타격 연출/아이콘을 신규 리소스로 교체하고, 검기(연출2)는
	-- 항상 정수직으로만 날아가던 기존과 달리 타겟 수만큼 부채꼴 발사각으로 갈라져 날아간다(2발=45/-45,
	-- 3발=45/90(정수직)/-45 — GetSolarBladeVerticalTilts). 사운드는 오라 블레이드와 동일한 것을 재사용.
	@Sync property integer SolarBladeLevel = 0
	property number Card168Cooldown = 6.0  -- 레벨 무관 고정(유저 표)
	-- 실측(LoadAnimationClipAndWait): 13프레임, 총 재생시간 0.78초. 0.05초 여유를 둔다.
	property string SolarBladeSlashEffectRUID = "b1976a3ae31447269810bc7cb281a485"
	property number SolarBladeSlashEffectLifetime = 0.83
	property string SolarBladeVerticalEffectRUID = "2a128f46b0c54f4d8bfafdd2fb29f568"  -- 오라 블레이드와 동일 리소스 재사용(유저 지정: "위로 날아가는 연출은 동일")
	-- 실측: 8프레임, 총 재생시간 0.48초. 공용 HitEffectLifetime(0.3초)보다 길어 전용 프로퍼티로 관리.
	property string SolarBladeHitEffectRUID = "5a7e7bfcabcb4b81943ffd42c241c39b"
	property number SolarBladeHitEffectLifetime = 0.53
	property number SolarBladeHitEffectScale = 1.0
	property number SolarBladeEffectScale = 0.7245  -- 유저 지정: 연출1 크기 10% 축소(0.805 * 0.9)
	property number SolarBladeVerticalScale = 0.4  -- 오라 블레이드와 동일 배율 재사용
	property number SolarBladeVerticalSpeed = 5.0
	property number SolarBladeVerticalTickInterval = 0.05
	property number SolarBladeVerticalHitRadius = 1.2  -- 오라 블레이드와 동일 반경 재사용
	property number SolarBladeVerticalOffscreenY = 4.5  -- 오라 블레이드와 동일 기준 재사용

	-- 대미지(레벨별 고정값 — 유저 지정 표)
	method number GetSolarBladeDamage(integer level)
		if level >= 3 then return 300
		elseif level >= 2 then return 260
		end
		return 230
	end

	-- 타겟 수(연출1이 개별 재생되는 시작 지점 개수, = 검기 발사 개수) — Lv1-2:2 / Lv3:3 (유저 지정 표)
	method integer GetSolarBladeTargetCount(integer level)
		if level >= 3 then return 3 end
		return 2
	end

	@ExecSpace("ServerOnly")
	method void SolarBladeAttack(number damage, boolean isCrit)
		local targets = self:GetClosestTargets(self:GetSolarBladeTargetCount(self.SolarBladeLevel))
		if #targets == 0 then return end

		self:PlayAuraBladeSound()

		local tilts = self:GetSolarBladeVerticalTilts(#targets)

		-- 유저 지정: 연출1(근접)과 연출2(검기) 여러 발이 같은 몬스터를 동시에 맞히면 벨런스가 깨진다
		-- (대미지 중복 적용 + 콤보스택 중복 적립) — 이번 발동 전체에서 공유하는 "이미 맞은 몬스터"
		-- 테이블(resolvedSet)로 몬스터당 데미지+콤보스택 전부 딱 한 번만 적용되게 막는다. 근접타로
		-- 먼저 맞은 몬스터는 어떤 검기가 지나가도 데미지를 받지 않는다(반대 순서는 실행 구조상
		-- 발생하지 않음 — 근접타 루프가 같은 프레임에 전부 끝난 뒤에야 검기의 타이머 틱이 시작됨).
		local resolvedSet = {}

		for _, target in ipairs(targets) do
			local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
			local scaleRatio = self:GetEffectScaleRatio(target)

			-- "skilleffectlong"(Duration 2.5초)으로 스폰하고 SolarBladeSlashEffectLifetime으로 직접 정리한다
			-- (공용 "skilleffect" 0.8초 고정 Duration보다 클립이 길어 중간에 잘리는 것 방지).
			local fx = self:SpawnEffectWithModel(self.SolarBladeSlashEffectRUID, Vector3(p.x, p.y, p.z - 0.1), 0, 1.0, self.SolarBladeEffectScale * scaleRatio, 1.0, "skilleffectlong")
			if fx ~= nil then fx:Destroy(self.SolarBladeSlashEffectLifetime) end
			local hitFx = self:SpawnEffect(self.SolarBladeHitEffectRUID, Vector3(p.x, p.y, p.z), 0, 1.0, self.SolarBladeHitEffectScale * scaleRatio, 1.0)
			if hitFx ~= nil then hitFx:Destroy(self.SolarBladeHitEffectLifetime) end

			if not resolvedSet[target] then
				resolvedSet[target] = true
				local appliedDamage = damage
				if isCrit then
					appliedDamage = damage * 2
					target:TakeDamageCrit(appliedDamage)
				else
					target:TakeDamage(appliedDamage)
				end
				target:AddComboStack(appliedDamage)
			end

			-- 연출2("검기")는 연출1이 나간 자리(=이 target의 위치)마다 부채꼴 발사각 세트 전체가
			-- 개별로 발사된다(유저 확인: 타겟 2명이면 검기 총 4개 — 타겟당 45/-45 두 개씩. 타겟 3명이면
			-- 타겟당 45/90/-45 세 개씩, 총 9개).
			for _, tilt in ipairs(tilts) do
				self:LaunchSolarBladeVertical(damage, isCrit, p, tilt, resolvedSet)
			end
		end

		log("SolarBladeAttack: targets=" .. #targets)
	end

	-- 검기 발사각(수직 기준 좌우 대칭, 단위: 도 — 0=정수직 위, +는 오른쪽으로 기울어짐) — 유저 지정 표:
	-- 2발일 때 45/-45, 3발일 때 45/90(=0틀트, 정수직)/-45. 이 세트 전체가 타겟마다(=근접 타격 대상마다)
	-- 개별로 나간다(유저 확인: 타겟 2명 → 검기 총 4개, 타겟 3명 → 검기 총 9개).
	method table GetSolarBladeVerticalTilts(integer count)
		if count >= 3 then return { 45, 0, -45 } end
		return { 45, -45 }
	end

	-- 툴팁 표시용 — 실제 검기 총 발사 개수(타겟 수 × 발사각 세트 크기)
	method integer GetSolarBladeVerticalCount(integer level)
		local targetCount = self:GetSolarBladeTargetCount(level)
		return targetCount * #self:GetSolarBladeVerticalTilts(targetCount)
	end

	-- 연출1이 나간 자리(startPos, = 그 타겟의 위치)에서 tiltDegrees 발사각(0=정수직 위, +는 오른쪽으로
	-- 기울어짐, GetSolarBladeVerticalTilts에서 결정)으로 날아가며, 지나가는 경로(반경
	-- SolarBladeVerticalHitRadius)에 있는 몬스터를(한 번씩만, hitSet으로 관리) 전부 타격한다. 특정 타겟에
	-- 종속되지 않는 광역 연출이라 뎁스밴드 구분 없이(킹페페와 동일 방식) 전부 맞는다. 화면 밖
	-- (SolarBladeVerticalOffscreenY, Y기준)에 닿으면 소멸한다. 타겟이 여러 명이면 이 메서드가 타겟 수만큼
	-- (각각 다른 tiltDegrees로) 독립적으로 동시 호출된다. resolvedSet은 SolarBladeAttack이 이번 발동
	-- 전체에서 공유하는 "이미 맞은 몬스터" 테이블(근접타/다른 검기로 맞은 몬스터는 데미지를 또 받지 않도록 관리).
	@ExecSpace("ServerOnly")
	method void LaunchSolarBladeVertical(number damage, boolean isCrit, Vector3 startPos, number tiltDegrees, table resolvedSet)
		local map = self:GetCurrentMap()
		if map == nil then return end
		local startX = startPos.x
		local startY = startPos.y

		local tiltRad = tiltDegrees * math.pi / 180
		local dirX = math.sin(tiltRad)
		local dirY = math.cos(tiltRad)
		-- 유저 실측 지적: 이동 방향(dirX/dirY)은 맞는데 비주얼 회전이 반대로 보임 — tiltDegrees=0
		-- (정수직)일 때는 기존과 동일하게 -90을 유지하되, 기울기 부호만 반전한다.
		local rotationParam = -tiltDegrees - 90

		local fx = self:SpawnEffectWithModel(self.SolarBladeVerticalEffectRUID, Vector3(startX, startY, -0.1), rotationParam, 1.0, self.SolarBladeVerticalScale, 1.0, "skilleffectlong")
		if fx == nil then return end

		local hitSet = {}
		local elapsed = 0
		local tickId = 0
		tickId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self) or not isvalid(fx) then
				_TimerService:ClearTimer(tickId)
				return
			end
			elapsed = elapsed + self.SolarBladeVerticalTickInterval
			local travelled = self.SolarBladeVerticalSpeed * elapsed
			local curX = startX + dirX * travelled
			local curY = startY + dirY * travelled
			local fxPos = fx.TransformComponent.Position
			fx.TransformComponent.Position = Vector3(curX, curY, fxPos.z)

			local monsters = self:GetMonstersInCurrentZone(map)
			for _, mob in ipairs(monsters) do
				---@type MonsterAI
				local m = mob
				if isvalid(m) and not m._dead and not hitSet[m] and not resolvedSet[m] then
					local mp = m.Entity.TransformComponent.Position
					local dx = mp.x - curX
					local dy = mp.y - curY
					if (dx * dx + dy * dy) <= (self.SolarBladeVerticalHitRadius * self.SolarBladeVerticalHitRadius) then
						hitSet[m] = true
						resolvedSet[m] = true
						-- SkillInventory 솔라 블레이드(인덱스52) Lv9: 검기 대미지 15% 증가, 카드 자체 레벨과
						-- 별개로 항상 가산(근접타가 아니라 이 "검기" 투사체 히트에만 추가로 곱연산)
						local finalDamage = damage * (1.0 + self:GetSkillInvTierPercent(52, 0, 0, 0.15))
						if isCrit then
							finalDamage = finalDamage * 2
							m:TakeDamageCrit(finalDamage)
						else
							m:TakeDamage(finalDamage)
						end
						m:AddComboStack(finalDamage)
						local hp = m.Entity.TransformComponent.Position
						local hfx = self:SpawnEffect(self.SolarBladeHitEffectRUID, Vector3(hp.x, hp.y, hp.z), 0, 1.0, self:GetEffectScaleRatio(m), 1.0)
						if hfx ~= nil then hfx:Destroy(self.SolarBladeHitEffectLifetime) end
						log("SolarBladeAttack: vertical hit dmg=" .. math.floor(finalDamage))
					end
				end
			end

			if (curY - startY) >= self.SolarBladeVerticalOffscreenY then
				_TimerService:ClearTimer(tickId)
				if isvalid(fx) then fx:Destroy() end
			end
		end, self.SolarBladeVerticalTickInterval)
	end

	-- ── 레이온 전용: 레이징 블로우 (카드 157, 슬롯형 액티브 6호) — GetClosestTargets로 뽑힌 각 타겟마다
	-- 독립적으로 콤보를 건다(슬래시처럼 개별 타겟, 스플래시 아님). 타겟당 10% 확률로 "강화 타격"(4연타,
	-- 60/50/40/30%)이 나가고, 나머지 90%는 "일반 타격"(2연타, 70/50%) — 확률/타수는 레벨 무관 고정, 레벨은
	-- 기준 데미지(GetCardDamage)와 타겟 수만 바꾼다. 각 타격은 RagingBlowHitInterval(0.35초) 간격으로
	-- 순차 적용되고, 매 타격마다 전용 타격 연출이 새로 뜬다. 일반/강화 각각 공격연출+타격연출 애니메이션
	-- 실제 길이가 서로 다르고 공용 skilleffect(0.8초 고정)보다 긴 것도 있어(실측: 일반공격 0.93초) 전부
	-- skilleffectlong으로 스폰하고 실측값 기반 전용 Lifetime으로 직접 정리한다(유저 지정: "끝까지 보여주게").
	@Sync property integer RagingBlowLevel = 0
	property number Card157Cooldown = 5.0
	property number RagingBlowEnhanceChance = 0.10
	property number RagingBlowHitInterval = 0.35
	property number RagingBlowEffectScale = 0.575  -- 유저 지정 이력: 50% 축소(0.5) → 15% 확대(0.5*1.15)
	property number RagingBlowHitEffectScale = 0.575  -- 공격연출과 함께 동일 비율 적용
	property number RagingBlowEffectYOffset = 0.1  -- 유저 지정: 연출을 위로 0.1만큼 이동
	property number RagingBlowEffectXOffset = 0.3  -- 유저 지정: 화면 기준 오른쪽으로 0.3만큼 이동
	property string RagingBlowNormalAttackRUID = "dee33ecfc0d14dffaedf161434d1ee8e"
	property number RagingBlowNormalAttackLifetime = 0.95  -- 실측 0.93초 + 여유
	property string RagingBlowNormalHitRUID = "7d4fd3b71abd42d6b37f49652d13a8d7"
	property number RagingBlowNormalHitLifetime = 0.7  -- 실측 0.66초 + 여유
	property string RagingBlowEnhancedAttackRUID = "5308ef85369c4f31843d6e8cde4b1012"
	property number RagingBlowEnhancedAttackLifetime = 0.83  -- 실측 0.78초 + 여유
	property string RagingBlowEnhancedHitRUID = "b79cbdf6d06b487382f03d625a1fc464"
	property number RagingBlowEnhancedHitLifetime = 0.65  -- 실측 0.60초 + 여유
	property string RagingBlowSoundRUID = "d621d7a5bffb427cac3f1e00db9d451b"  -- 일반/강화 공용
	-- 강화 애로우 블로우(Card117DamageNumberSpacing=0.4, 완전히 안 겹치게)의 2/3 정도로 좁게 잡아
	-- 유저 지정대로 "1/3 정도만 겹치게" 만든다. 히트 순서는 중앙 기준 대칭 배치(GetRagingBlow* 사용부 참고).
	property number RagingBlowDamageNumberSpacing = 0.27

	-- 타당 데미지(레벨별 고정값 — 유저 지정 표)
	method number GetRagingBlowDamage(integer level)
		if level >= 5 then return 200
		elseif level >= 4 then return 160
		elseif level >= 3 then return 140
		elseif level >= 2 then return 120
		end
		return 100
	end

	-- 타겟 수(각각 독립 콤보를 받는 대상 수) — Lv1-2:1 / Lv3-5:2 (유저 지정 표)
	method integer GetRagingBlowTargetCount(integer level)
		if level >= 3 then return 2 end
		return 1
	end

	-- 일반 타격(2연타) 타수별 비율 — 70% / 50% (레벨 무관 고정)
	method number GetRagingBlowNormalPercent(integer hitIndex)
		if hitIndex == 1 then return 0.70 end
		return 0.50
	end

	-- 강화 타격(4연타) 타수별 비율 — 60% / 50% / 40% / 30% (레벨 무관 고정)
	method number GetRagingBlowEnhancedPercent(integer hitIndex)
		if hitIndex == 1 then return 0.60
		elseif hitIndex == 2 then return 0.50
		elseif hitIndex == 3 then return 0.40
		end
		return 0.30
	end

	@ExecSpace("ServerOnly")
	method void RagingBlowAttack(number damage, boolean isCrit)
		local targets = self:GetClosestTargets(self:GetRagingBlowTargetCount(self.RagingBlowLevel))
		if #targets == 0 then return end

		self:PlayRagingBlowSound()

		for _, target in ipairs(targets) do
			local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
			local scaleRatio = self:GetEffectScaleRatio(target)
			-- SkillInventory 레이징 블로우(인덱스45) Lv9: 강화 타격 확률 +10%, 카드 자체 레벨과 별개로 항상 가산
			local isEnhanced = _UtilLogic:RandomDouble() < (self.RagingBlowEnhanceChance + self:GetSkillInvTierPercent(45, 0, 0, 0.10))

			local attackRUID = self.RagingBlowNormalAttackRUID
			local attackLifetime = self.RagingBlowNormalAttackLifetime
			local hitRUID = self.RagingBlowNormalHitRUID
			local hitLifetime = self.RagingBlowNormalHitLifetime
			local hitCount = 2
			if isEnhanced then
				attackRUID = self.RagingBlowEnhancedAttackRUID
				attackLifetime = self.RagingBlowEnhancedAttackLifetime
				hitRUID = self.RagingBlowEnhancedHitRUID
				hitLifetime = self.RagingBlowEnhancedHitLifetime
				hitCount = 4
			end

			local fx = self:SpawnEffectWithModel(attackRUID, Vector3(p.x + self.RagingBlowEffectXOffset, p.y + self.RagingBlowEffectYOffset, p.z - 0.1), 0, 1.0, self.RagingBlowEffectScale * scaleRatio, 1.0, "skilleffectlong")
			if fx ~= nil then fx:Destroy(attackLifetime) end

			-- 유저 지적으로 확인됨: 대미지 숫자가 연타마다 정확히 같은 좌표에 떠서 겹쳐 보인다 —
			-- 강화 애로우 블로우(Card117)와 동일한 해법(TakeDamageWithOffset/TakeDamageCritWithOffset의
			-- 수평 오프셋)을 재사용, 히트 순서를 중앙 기준 대칭 배치한다. 완전히 떨어뜨리지 않고
			-- "1/3 정도만 겹치게"(유저 지정) 간격을 좁게 잡는다.
			local resolveHit = function(hitIndex)
				if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
				local pct
				if isEnhanced then pct = self:GetRagingBlowEnhancedPercent(hitIndex)
				else pct = self:GetRagingBlowNormalPercent(hitIndex) end
				local hp = target.Entity.TransformComponent.Position
				local hitDamage = damage * pct
				local offsetX = (hitIndex - (hitCount + 1) / 2.0) * self.RagingBlowDamageNumberSpacing
				if isCrit then
					hitDamage = hitDamage * 2
					target:TakeDamageCritWithOffset(hitDamage, Vector2(offsetX, 0))
				else
					target:TakeDamageWithOffset(hitDamage, Vector2(offsetX, 0))
				end
				local hfx = self:SpawnEffectWithModel(hitRUID, Vector3(hp.x + self.RagingBlowEffectXOffset, hp.y + self.RagingBlowEffectYOffset, hp.z), 0, 1.0, self.RagingBlowHitEffectScale * self:GetEffectScaleRatio(target), 1.0, "skilleffectlong")
				if hfx ~= nil then hfx:Destroy(hitLifetime) end
				log("RagingBlowAttack: hit " .. hitIndex .. "/" .. hitCount .. " enhanced=" .. tostring(isEnhanced) .. " dmg=" .. math.floor(hitDamage))
			end

			-- 유저 지적: 강화 타격 연출은 공격 연출과 동시에(즉시) 나와야 한다 — 1번째 타격은 타이머를
			-- 거치지 않고 공격 연출 스폰 직후 동기적으로 처리한다(일반 타격도 동일 구조라 같이 적용됨).
			resolveHit(1)
			for hitIndex = 2, hitCount do
				local hitDelay = (hitIndex - 1) * self.RagingBlowHitInterval
				_TimerService:SetTimerOnce(function()
					resolveHit(hitIndex)
				end, hitDelay)
			end
		end

		log("RagingBlowAttack: targets=" .. #targets)
	end

	@ExecSpace("Multicast")
	method void PlayRagingBlowSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.RagingBlowSoundRUID, 1.0)
	end

	-- ── 레이온 전용 조합 스킬: 퓨리어스 블로우 (카드 170) — 레이징 블로우(157) Lv5 + 셀프 리커버리(163) +
	-- 워리어 마스터리(164, 둘 다 슬롯 없는 패시브) 보유 시 등장. 레이징 블로우와 완전히 동일한 매커니즘
	-- (타겟마다 개별로 일반타격 2연타(70/50%) 또는 확률적으로 강화타격 4연타(60/50/40/30%))을 그대로
	-- 재사용, 레이징 블로우의 슬롯을 그대로 넘겨받는다. 유저 지정 변경점: 타겟 수 레벨 무관 3명 고정
	-- (레이징 블로우는 레벨별 1~2명), 강화 확률이 레벨별로 상승(15/20/30%, 레이징 블로우는 레벨 무관
	-- 10% 고정). 연출 4종(일반/강화 각 공격+타격)은 신규 리소스로 교체, 사운드는 레이징 블로우와 동일
	-- 재사용. 신규 연출 실측(LoadAnimationClipAndWait) 결과 원본과 길이가 달라(일반타격 0.66→0.36초,
	-- 강화공격 0.78→0.90초, 강화타격 0.60→0.36초, 일반공격만 0.93초로 동일) 타이밍 상수를 새로 반영했다.
	@Sync property integer FuriousBlowLevel = 0
	property number Card170Cooldown = 5.0  -- 레벨 무관 고정(유저 표)
	property number FuriousBlowHitInterval = 0.35  -- 레이징 블로우와 동일 재사용
	property number FuriousBlowEffectScale = 0.575  -- 레이징 블로우와 동일 재사용
	property number FuriousBlowHitEffectScale = 0.575
	property number FuriousBlowEffectYOffset = 0.1
	property number FuriousBlowEffectXOffset = 0.3
	-- 실측: 일반공격 17프레임/0.93초, 일반타격 6프레임/0.36초, 강화공격 15프레임/0.90초, 강화타격
	-- 6프레임/0.36초. 0.05초 여유를 둔다.
	property string FuriousBlowNormalAttackRUID = "8e3ac5b0e7ea4919bd8dc48d7c44748f"
	property number FuriousBlowNormalAttackLifetime = 0.98
	property string FuriousBlowNormalHitRUID = "247e76427403408292103c69ad3fb722"
	property number FuriousBlowNormalHitLifetime = 0.41
	property string FuriousBlowEnhancedAttackRUID = "1b87f0fb57534d84aa3e0e596f5c473d"
	property number FuriousBlowEnhancedAttackLifetime = 0.95
	property string FuriousBlowEnhancedHitRUID = "5a68cdd33c834f58962437f802105ab3"
	property number FuriousBlowEnhancedHitLifetime = 0.41
	property string FuriousBlowSoundRUID = "d621d7a5bffb427cac3f1e00db9d451b"  -- 유저 지정: 레이징 블로우와 동일 사운드
	property number FuriousBlowDamageNumberSpacing = 0.27  -- 레이징 블로우와 동일 재사용

	-- 대미지(레벨별 고정값 — 유저 확인: Lv1=230/Lv2=260/Lv3=300)
	method number GetFuriousBlowDamage(integer level)
		if level >= 3 then return 300
		elseif level >= 2 then return 260
		end
		return 230
	end

	-- 타겟 수 — 레벨 무관 3명 고정(유저 표)
	method integer GetFuriousBlowTargetCount(integer level)
		return 3
	end

	-- 강화 타격 확률 — 레벨별 상승(유저 표: Lv1=15% / Lv2=20% / Lv3=30%, 레이징 블로우의 레벨 무관
	-- 10% 고정과 다른 점)
	-- SkillInventory 퓨리어스 블로우(인덱스54) Lv9: 강화 타격 확률 +10%, 카드 자체 레벨과 별개로 항상 가산
	method number GetFuriousBlowEnhanceChance(integer level)
		local base = 0.15
		if level >= 3 then base = 0.30
		elseif level >= 2 then base = 0.20
		end
		return base + self:GetSkillInvTierPercent(54, 0, 0, 0.10)
	end

	-- 일반 타격(2연타) 타수별 비율 — 70% / 50%(레벨 무관 고정, 레이징 블로우와 동일)
	method number GetFuriousBlowNormalPercent(integer hitIndex)
		if hitIndex == 1 then return 0.70 end
		return 0.50
	end

	-- 강화 타격(4연타) 타수별 비율 — 60% / 50% / 40% / 30%(레벨 무관 고정, 레이징 블로우와 동일)
	method number GetFuriousBlowEnhancedPercent(integer hitIndex)
		if hitIndex == 1 then return 0.60
		elseif hitIndex == 2 then return 0.50
		elseif hitIndex == 3 then return 0.40
		end
		return 0.30
	end

	@ExecSpace("ServerOnly")
	method void FuriousBlowAttack(number damage, boolean isCrit)
		local targets = self:GetClosestTargets(self:GetFuriousBlowTargetCount(self.FuriousBlowLevel))
		if #targets == 0 then return end

		self:PlayFuriousBlowSound()

		local enhanceChance = self:GetFuriousBlowEnhanceChance(self.FuriousBlowLevel)

		for _, target in ipairs(targets) do
			local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
			local scaleRatio = self:GetEffectScaleRatio(target)
			local isEnhanced = _UtilLogic:RandomDouble() < enhanceChance

			local attackRUID = self.FuriousBlowNormalAttackRUID
			local attackLifetime = self.FuriousBlowNormalAttackLifetime
			local hitRUID = self.FuriousBlowNormalHitRUID
			local hitLifetime = self.FuriousBlowNormalHitLifetime
			local hitCount = 2
			if isEnhanced then
				attackRUID = self.FuriousBlowEnhancedAttackRUID
				attackLifetime = self.FuriousBlowEnhancedAttackLifetime
				hitRUID = self.FuriousBlowEnhancedHitRUID
				hitLifetime = self.FuriousBlowEnhancedHitLifetime
				hitCount = 4
			end

			local fx = self:SpawnEffectWithModel(attackRUID, Vector3(p.x + self.FuriousBlowEffectXOffset, p.y + self.FuriousBlowEffectYOffset, p.z - 0.1), 0, 1.0, self.FuriousBlowEffectScale * scaleRatio, 1.0, "skilleffectlong")
			if fx ~= nil then fx:Destroy(attackLifetime) end

			-- 레이징 블로우와 동일한 해법 — 대미지 숫자가 겹치지 않도록 히트 순서를 중앙 기준 대칭
			-- 배치(TakeDamageWithOffset/TakeDamageCritWithOffset의 수평 오프셋).
			local resolveHit = function(hitIndex)
				if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
				local pct
				if isEnhanced then pct = self:GetFuriousBlowEnhancedPercent(hitIndex)
				else pct = self:GetFuriousBlowNormalPercent(hitIndex) end
				local hp = target.Entity.TransformComponent.Position
				local hitDamage = damage * pct
				local offsetX = (hitIndex - (hitCount + 1) / 2.0) * self.FuriousBlowDamageNumberSpacing
				if isCrit then
					hitDamage = hitDamage * 2
					target:TakeDamageCritWithOffset(hitDamage, Vector2(offsetX, 0))
				else
					target:TakeDamageWithOffset(hitDamage, Vector2(offsetX, 0))
				end
				local hfx = self:SpawnEffectWithModel(hitRUID, Vector3(hp.x + self.FuriousBlowEffectXOffset, hp.y + self.FuriousBlowEffectYOffset, hp.z), 0, 1.0, self.FuriousBlowHitEffectScale * self:GetEffectScaleRatio(target), 1.0, "skilleffectlong")
				if hfx ~= nil then hfx:Destroy(hitLifetime) end
				log("FuriousBlowAttack: hit " .. hitIndex .. "/" .. hitCount .. " enhanced=" .. tostring(isEnhanced) .. " dmg=" .. math.floor(hitDamage))
			end

			resolveHit(1)
			for hitIndex = 2, hitCount do
				local hitDelay = (hitIndex - 1) * self.FuriousBlowHitInterval
				_TimerService:SetTimerOnce(function()
					resolveHit(hitIndex)
				end, hitDelay)
			end
		end

		log("FuriousBlowAttack: targets=" .. #targets)
	end

	@ExecSpace("Multicast")
	method void PlayFuriousBlowSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.FuriousBlowSoundRUID, 1.0)
	end

	-- ── 쉐이드 전용: 더블 스탭 (카드171, 슬롯형 액티브 1호 — 쉐이드의 첫 스킬). GetClosestTargets로 뽑힌
	-- 각 타겟마다 스윙 연출 1회 + 즉시 1타 + 0.3초 뒤 2타를 꽂는다. 레벨이 오를수록 기준 데미지
	-- (GetDoubleStepDamage)와 타수별 비율(GetDoubleStepPercent, 70/30 → 110/70%)이 함께 상승한다(유저
	-- 지정 표). 유저 요청: "연타류 대미지는 텍스트가 1개 뜨고 0.3초 후 1개 더" — 두 타격을 실제로
	-- 0.3초 간격을 두고 순차 적용해서 대미지 숫자가 자연스럽게 시간차를 두고 뜨게 한다(레이징 블로우/
	-- 퓨리어스 블로우와 동일한 resolveHit(1) 동기 + 타이머 패턴 재사용).
	@Sync property integer DoubleStepLevel = 0
	property number Card171Cooldown = 3.0  -- 레벨 무관 고정(유저 지정: 3.5→3.0)
	property number DoubleStepHitInterval = 0.3  -- 유저 지정: "0.3초있다 1개더"
	property number DoubleStepEffectScale = 1.8  -- 유저 지정: 2배로 키운 뒤 10% 축소(2.0*0.9)
	-- 유저 지정: 연출 좌표를 위로 더 올림(스핏릿 블레이드와 동일한 슬래시류 오프셋 값 재사용)
	property number DoubleStepEffectYOffset = 0.3
	property string DoubleStepAttackRUID = "e90414edde984e80b92466d5b6355f92"
	-- 5프레임/PlayRate 1.0(원래 재생속도, 배속 아님). 이전엔 실측 없이 0.65초(여유 포함)로 넉넉하게
	-- 잡았다가 실제 클립 길이보다 길어서 루프가 재시작되어 깜빡이는 버그가 났다 — 리프 어택(Card158)
	-- 때와 동일한 원인/해법("루프 방지 우선"): 다 보여주는 것보다 짧게 끊어서 절대 안 겹치게 한다.
	property number DoubleStepAttackLifetime = 0.4
	property string DoubleStepSoundRUID = "9262cd7e020e4324ad108454c5fe7f30"
	-- 연타 대미지 숫자가 같은 좌표에 겹치지 않도록 레이징 블로우와 동일한 해법(수평 오프셋) 재사용
	property number DoubleStepDamageNumberSpacing = 0.27

	-- 타당 기준 데미지(레벨별 고정값 — 유저 지정 표)
	method number GetDoubleStepDamage(integer level)
		if level >= 5 then return 260
		elseif level >= 4 then return 220
		elseif level >= 3 then return 200
		elseif level >= 2 then return 170
		end
		return 150
	end

	-- 타겟 수 — Lv1:1명 / Lv2~4:2명 / Lv5:3명 (유저 지정 표)
	method integer GetDoubleStepTargetCount(integer level)
		if level >= 5 then return 3 end
		if level >= 2 then return 2 end
		return 1
	end

	-- 2연타 타수별 비율 — 1타 70/80/90/100/110%, 2타 30/40/50/60/70% (레벨별로 함께 상승, 유저 지정 표)
	method number GetDoubleStepPercent(integer level, integer hitIndex)
		local lv = math.max(1, math.min(level, 5))
		if hitIndex == 1 then return 0.60 + 0.10 * lv end
		return 0.20 + 0.10 * lv
	end

	@ExecSpace("ServerOnly")
	method void DoubleStepAttack(number damage, boolean isCrit, table forcedTargets)
		-- 유저 지정(2026-08-13): 쉐도우 파트너가 대신 쓸 때는 forcedTargets(파트너가 서 있는 몬스터
		-- 1명 고정)를 넘겨받아 카드 레벨의 타겟수 공식을 건너뛴다 — 플레이어 본인 시전(forcedTargets=nil)은
		-- 기존 GetClosestTargets 그대로 유지.
		local targets = forcedTargets
		if targets == nil then
			targets = self:GetClosestTargets(self:GetDoubleStepTargetCount(self.DoubleStepLevel))
		end
		-- 버그 수정(2026-08-12, 유저 지적: "공격은 하는데 몬스터 죽으면 연출 안나가냐?") — 쉐도우 파트너가
		-- 대신 실행할 때는 걸어가는 시간(0.7초) 뒤에야 이 메서드가 불려서, 그 사이 겨냥했던 몬스터가
		-- 죽으면 여기서 0마리가 나와 통째로 스킵됐다. 파트너 실행 중이면 원래 겨냥했던 타겟(죽었어도
		-- 좌표는 유효)으로 대체해서 연출만이라도 재생한다(데미지는 아래 resolveHit의 _dead 체크로 계속 막힘).
		if #targets == 0 then
			if self._shadowPartnerCopyActive and isvalid(self._shadowPartnerFallbackTarget) then
				targets = { self._shadowPartnerFallbackTarget }
			else
				return
			end
		end

		self:PlayDoubleStepSound()

		for _, target in ipairs(targets) do
			local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
			local scaleRatio = self:GetEffectScaleRatio(target)

			-- 유저 지정: 연출은 스윙 1개만 1회 재생(기존엔 스윙+타격마다 총 3번 나와서 겹쳐 보였음).
			-- 데미지 적용/텍스트는 여전히 1타 즉시 + 2타 0.3초 뒤로 분리되지만, 시각 연출은 시전 시 한 번뿐이다.
			local fx = self:SpawnEffectWithModel(self.DoubleStepAttackRUID, Vector3(p.x, p.y + self.DoubleStepEffectYOffset, p.z - 0.1), 0, 1.0, self.DoubleStepEffectScale * scaleRatio, 1.0, "skilleffectlong")
			if fx ~= nil then fx:Destroy(self.DoubleStepAttackLifetime) end

			local resolveHit = function(hitIndex)
				if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
				local pct = self:GetDoubleStepPercent(self.DoubleStepLevel, hitIndex)
				local hitDamage = damage * pct
				local offsetX = (hitIndex - 1.5) * self.DoubleStepDamageNumberSpacing
				if isCrit then
					hitDamage = hitDamage * 2
					target:TakeDamageCritWithOffset(hitDamage, Vector2(offsetX, 0))
				else
					target:TakeDamageWithOffset(hitDamage, Vector2(offsetX, 0))
				end
				log("DoubleStepAttack: hit " .. hitIndex .. "/2 dmg=" .. math.floor(hitDamage))
			end

			resolveHit(1)
			_TimerService:SetTimerOnce(function()
				resolveHit(2)
			end, self.DoubleStepHitInterval)
		end

		log("DoubleStepAttack: targets=" .. #targets)
	end

	-- ── 쉐이드 조합 스킬: 암살 (카드185) — 더블 스탭(171) Lv5 + 크리티컬 엣지(181) + 피지컬 트레이닝
	-- (183, 둘 다 슬롯 없는 패시브) 보유 시 등장. 더블 스탭과 동일한 "즉시 1타 + HitInterval 뒤 2타"
	-- 구조를 재사용하지만, 더블 스탭과 달리 1타/2타가 서로 다른 리소스팩 연출(유저 지정: "대미지는
	-- 1타 2타 들어갈때 각각 연출 다르게할꺼고")을 쓴다 — 1타는 개별 지정 RUID, 2타는 "암살" 리소스팩의
	-- effect(캐스트)/hit·0(타격)/audio·Hit(사운드)를 그대로 사용. 더블 스탭 슬롯을 그대로 넘겨받는다.
	-- 3레벨까지만 존재(다른 조합 스킬과 동일).
	@Sync property integer AssassinateLevel = 0
	property number Card185Cooldown = 3.5  -- 레벨 무관 고정(유저 표)
	property string Card185IconRUID = "dbaa15855ce9477faaf83b7ffa0f6ee2"

	-- 1타 리소스(유저 지정 개별 RUID)
	property string AssassinateHit1SoundRUID = "5b472e4debd945f3800189d1e02de2a7"
	property string AssassinateHit1CastRUID = "15332c6f8dc94dc5a16206cc2bc4fd1e"
	property string AssassinateHit1HitRUID = "feead72eccff47e398da17f5c11f4cc9"
	-- 2타 리소스("암살" 리소스팩 — 유저 지정: "여기서 effect 쓰면됨 히트도 여기 hit쓰면되고 사운드도 여기꺼 hit")
	property string AssassinateHit2SoundRUID = "d02ad2c1950846cc865dc2d041036564"
	property string AssassinateHit2CastRUID = "ceba149628214e589b67b563a776544f"
	property string AssassinateHit2HitRUID = "be55f2b4175c4d83a40d9d09a1520f2d"

	-- 연출 타이밍/크기 — 네이티브 animationclip 직접 재생(리소스팩에 프레임 전체 목록이 없어 수동
	-- 프레임 스왑 대신 이 방식 채택), 실측 전 추정치라 라이브 확인 후 조정 필요.
	property number AssassinateCastLifetime = 0.5
	property number AssassinateHitLifetime = 0.35
	-- 유저 지적: "2타 연출 루프도니깐 조금만 짧게" — 2타만 실제 클립 길이보다 Destroy 타이밍이 길어서
	-- 재생이 끝나기 전에 못 끊고 루프가 재시작되는 것으로 보임(1타는 별도 지적 없어 그대로 유지).
	property number AssassinateHit2CastLifetime = 0.4
	property number AssassinateHit2HitLifetime = 0.28
	property number AssassinateEffectScale = 0.8  -- 유저 지정: 20% 축소
	property number AssassinateEffectYOffset = 0.3  -- 더블 스탭과 동일 보정 기본 적용
	property number AssassinateEffectXOffset = 0.7  -- 유저 지정: 오른쪽으로 0.5 → 추가 0.2 더 이동(0.7, 캐스트 연출 기준)
	-- 유저 지적: "타격 연출이 몬스터한테 안붙어있는거 같다" — 캐스트와 같은 좌표를 공유하던 걸 분리해서
	-- 히트 연출만 왼쪽으로 0.4 이동(0.7-0.4=0.3), 이어서 "0.15 더 옮기자"로 추가 이동(0.3-0.15=0.15).
	-- 1타/2타 히트 연출 공통 적용.
	property number AssassinateHitEffectXOffset = 0.15
	property number AssassinateHitInterval = 0.3  -- 더블 스탭과 동일 관례(1타 후 0.3초 뒤 2타)
	-- 유저 지정: "대미지 텍스트가 타이밍 상관없이 떨어져서, 1개 먼저 뜨고 나머지가 20 정도만 겹치는
	-- 수준" — 더블 스탭의 수평 오프셋 해법(DoubleStepDamageNumberSpacing)과 동일 패턴, 겹침 폭은
	-- 라이브로 눈으로 보고 조정 예정(추정치로 더블 스탭보다 살짝 크게 시작).
	property number AssassinateDamageNumberSpacing = 0.35

	-- 타당 기준 데미지(레벨별 고정값 — 유저 지정 표)
	method number GetAssassinateDamage(integer level)
		if level >= 3 then return 320
		elseif level >= 2 then return 300
		end
		return 280
	end

	-- 타겟 수 — Lv1~2:3명 / Lv3:4명 (유저 지정 표)
	method integer GetAssassinateTargetCount(integer level)
		if level >= 3 then return 4 end
		return 3
	end

	-- 2연타 타수별 비율 — 1타 120/130/140%, 2타 80/90/100% (유저 지정 표)
	method number GetAssassinatePercent(integer level, integer hitIndex)
		local lv = math.max(1, math.min(level, 3))
		local pct
		if lv == 1 then pct = {1.20, 0.80}
		elseif lv == 2 then pct = {1.30, 0.90}
		else pct = {1.40, 1.00}
		end
		return pct[hitIndex]
	end

	@ExecSpace("ServerOnly")
	method void AssassinateAttack(number damage, boolean isCrit)
		local targets = self:GetClosestTargets(self:GetAssassinateTargetCount(self.AssassinateLevel))
		if #targets == 0 then
			if self._shadowPartnerCopyActive and isvalid(self._shadowPartnerFallbackTarget) then
				targets = { self._shadowPartnerFallbackTarget }
			else
				return
			end
		end

		for _, target in ipairs(targets) do
			if isvalid(target) and isvalid(target.Entity) then
				local scaleRatio = self:GetEffectScaleRatio(target)

				-- 1타: 즉시 캐스트+히트 연출 및 대미지
				local p1 = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
				local pos1 = Vector3(p1.x + self.AssassinateEffectXOffset, p1.y + self.AssassinateEffectYOffset, p1.z - 0.1)
				local fx1 = self:SpawnEffect(self.AssassinateHit1CastRUID, pos1, 0, 1.0, self.AssassinateEffectScale * scaleRatio, 1.0)
				if fx1 ~= nil then fx1:Destroy(self.AssassinateCastLifetime) end
				local hitPos1 = Vector3(p1.x + self.AssassinateHitEffectXOffset, p1.y + self.AssassinateEffectYOffset, p1.z - 0.1)
				local hfx1 = self:SpawnEffect(self.AssassinateHit1HitRUID, hitPos1, 0, 1.0, self.AssassinateEffectScale * scaleRatio, 1.0)
				if hfx1 ~= nil then hfx1:Destroy(self.AssassinateHitLifetime) end
				self:PlayAssassinateHit1Sound()

				if not target._dead then
					local pct1 = self:GetAssassinatePercent(self.AssassinateLevel, 1)
					local hitDamage1 = damage * pct1
					local offsetX1 = (1 - 1.5) * self.AssassinateDamageNumberSpacing
					if isCrit then
						target:TakeDamageCritWithOffset(hitDamage1 * 2, Vector2(offsetX1, 0))
					else
						target:TakeDamageWithOffset(hitDamage1, Vector2(offsetX1, 0))
					end
					log("AssassinateAttack: hit 1/2 dmg=" .. math.floor(isCrit and hitDamage1 * 2 or hitDamage1))
				end

				-- 2타: HitInterval 뒤, 서로 다른(암살 리소스팩) 캐스트+히트 연출 및 대미지
				_TimerService:SetTimerOnce(function()
					if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) then return end
					local p2 = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
					local pos2 = Vector3(p2.x + self.AssassinateEffectXOffset, p2.y + self.AssassinateEffectYOffset, p2.z - 0.1)
					local fx2 = self:SpawnEffect(self.AssassinateHit2CastRUID, pos2, 0, 1.0, self.AssassinateEffectScale * scaleRatio, 1.0)
					if fx2 ~= nil then fx2:Destroy(self.AssassinateHit2CastLifetime) end
					local hitPos2 = Vector3(p2.x + self.AssassinateHitEffectXOffset, p2.y + self.AssassinateEffectYOffset, p2.z - 0.1)
					local hfx2 = self:SpawnEffect(self.AssassinateHit2HitRUID, hitPos2, 0, 1.0, self.AssassinateEffectScale * scaleRatio, 1.0)
					if hfx2 ~= nil then hfx2:Destroy(self.AssassinateHit2HitLifetime) end
					self:PlayAssassinateHit2Sound()

					if not target._dead then
						local pct2 = self:GetAssassinatePercent(self.AssassinateLevel, 2)
						local hitDamage2 = damage * pct2
						local offsetX2 = (2 - 1.5) * self.AssassinateDamageNumberSpacing
						if isCrit then
							target:TakeDamageCritWithOffset(hitDamage2 * 2, Vector2(offsetX2, 0))
						else
							target:TakeDamageWithOffset(hitDamage2, Vector2(offsetX2, 0))
						end
						log("AssassinateAttack: hit 2/2 dmg=" .. math.floor(isCrit and hitDamage2 * 2 or hitDamage2))
					end
				end, self.AssassinateHitInterval)
			end
		end

		log("AssassinateAttack: targets=" .. #targets)
	end

	@ExecSpace("Multicast")
	method void PlayAssassinateHit1Sound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.AssassinateHit1SoundRUID, 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayAssassinateHit2Sound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.AssassinateHit2SoundRUID, 1.0)
	end

	-- ── 쉐이드 전용: 새비지 블로우 (카드173, 슬롯형 액티브 2호). GetClosestTargets로 뽑힌 각 타겟마다
	-- 스윙 연출 1회 + 3연타(0.3초 간격, 더블 스탭과 동일 간격 재사용)를 적용한다. 타수별 비율은 레벨마다
	-- 개별 지정된 유저 표라 균일 공식이 아니라 GetSavageBlowPercent에서 레벨별로 하드코딩한다.
	-- 유저 정책(2026-08-11): 연출은 대상 생사와 무관하게 항상 끝까지 재생한다 — 위치를 캐스트 시점에
	-- 미리 좌표값으로 캡처해두고, 각 타격 연출은 그 좌표에 무조건 재생(데미지만 유효성 체크). 좌표는
	-- 더블 스탭과 동일한 +0.3 보정을 기본 적용(유저 지정: 앞으로 신규 스킬엔 이 보정값을 기본으로).
	@Sync property integer SavageBlowLevel = 0
	property number Card173Cooldown = 5.0  -- 레벨 무관 고정(유저 지정: 4.5→5.0)
	property number SavageBlowEffectScale = 0.85  -- 유저 지정: 15% 축소
	property number SavageBlowEffectYOffset = 0  -- 유저 지정: +0.3 올렸다가 다시 0.3 내려서 0
	property number SavageBlowEffectXOffset = 1.0  -- 유저 지정: 오른쪽으로 1만큼 이동
	-- 유저 지정: "범위기"라 조준 지점마다 그 이펙트 반경 안의 몬스터를 전부 타격한다(아이스 커터의
	-- FireIceCutterShot 반경 판정과 동일 패턴). 정확한 수치를 안 주셔서 스윙 연출 크기 기준 추정치.
	property number SavageBlowRadius = 1.5
	-- 11프레임 실측(리소스 메타데이터) — 이 코드베이스의 프레임당 재생시간 관례(~0.11초/프레임,
	-- 다른 스킬들의 "N프레임=X초" 실측 주석들에서 역산) 기준 추정 길이. 스윙은 1회만 스폰하고
	-- 끝까지 온전히 재생한다(중간에 새로 스폰하지 않음). 유저 지적: 끝부분에서 루프가 재시작돼서
	-- 추정치보다 0.2초 짧게 잡는다(루프 방지 우선).
	property string SavageBlowAttackRUID = "895ac1e384ea42ca8dd084f54ff3346b"
	property number SavageBlowAttackLifetime = 1.0
	-- 4프레임 실측 기준 추정 길이 — 유저 지적: 끝부분에서 루프가 재시작돼서 0.2초 짧게 조정.
	-- 유저 지정: 타격 연출도 1회만 스폰해서 끝까지 온전히 재생하고, 그 재생 시간을 3등분해서 3타
	-- 데미지 타이밍을 잡는다(재생 중 새로 스폰해서 끊기던 문제 해결 — 앞으로 다연타 스킬은 이 방식을 기본으로 한다).
	property string SavageBlowHitRUID = "f342e1d9953f46e9ab003ba0e363ee2a"
	property number SavageBlowHitLifetime = 0.25
	property string SavageBlowSoundRUID = "4cc1f2f305ce46b69a8c45129e9d0432"
	property string SavageBlowHitSoundRUID = "b77afdd614194637949c7df3d002fc54"
	property number SavageBlowDamageNumberSpacing = 0.27

	-- 타당 기준 데미지(레벨별 고정값 — 유저 지정 표)
	method number GetSavageBlowDamage(integer level)
		if level >= 5 then return 230
		elseif level >= 4 then return 200
		elseif level >= 3 then return 180
		elseif level >= 2 then return 150
		end
		return 130
	end

	-- 타겟 수 — Lv1:1명 / Lv2~4:2명 / Lv5:3명 (유저 지정 표)
	method integer GetSavageBlowTargetCount(integer level)
		if level >= 5 then return 3 end
		if level >= 2 then return 2 end
		return 1
	end

	-- 3연타 타수별 비율 — 레벨마다 개별 지정(균일 공식 아님, 유저 지정 표)
	method number GetSavageBlowPercent(integer level, integer hitIndex)
		local lv = math.max(1, math.min(level, 5))
		local pct
		if lv == 1 then pct = {0.30, 0.30, 0.30}
		elseif lv == 2 then pct = {0.40, 0.30, 0.30}
		elseif lv == 3 then pct = {0.50, 0.40, 0.40}
		elseif lv == 4 then pct = {0.50, 0.50, 0.50}
		else pct = {0.60, 0.60, 0.60}
		end
		return pct[hitIndex]
	end

	@ExecSpace("ServerOnly")
	method void SavageBlowAttack(number damage, boolean isCrit, table forcedTargets)
		local map = self:GetCurrentMap()
		if map == nil then return end
		-- 유저 지정(2026-08-13): 쉐도우 파트너 전용 forcedTargets(파트너가 서 있는 몬스터 1명 고정) —
		-- 세비지 블로우가 레벨2 이상에서 원래 2~3명을 때리더라도 파트너 대신 실행일 땐 그 1명만.
		local targets = forcedTargets
		if targets == nil then
			targets = self:GetClosestTargets(self:GetSavageBlowTargetCount(self.SavageBlowLevel))
		end
		-- 버그 수정(2026-08-12) — DoubleStepAttack과 동일한 이유/패턴(쉐도우 파트너의 0.7초 이동 지연 중
		-- 원 타겟이 죽으면 재선정이 0마리가 되는 문제).
		if #targets == 0 then
			if self._shadowPartnerCopyActive and isvalid(self._shadowPartnerFallbackTarget) then
				targets = { self._shadowPartnerFallbackTarget }
			else
				return
			end
		end

		self:PlaySavageBlowSound()

		for _, target in ipairs(targets) do
			if isvalid(target) and isvalid(target.Entity) then
				local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
				local capturedPos = Vector3(p.x + self.SavageBlowEffectXOffset, p.y + self.SavageBlowEffectYOffset, p.z - 0.1)
				-- 반경 판정 기준 좌표(아이스 커터와 동일하게 로컬 Position 기준) — 캐스트 시점에 고정해서
				-- 겨냥한 대상이 나중에 죽어도 판정 지점은 그대로 유지한다.
				local centerPos = target.Entity.TransformComponent.Position
				local scaleRatio = self:GetEffectScaleRatio(target)

				-- 스윙 연출 1회, 끝까지 온전히 재생(끊기지 않게 실측 추정 길이 그대로 사용)
				local fx = self:SpawnEffectWithModel(self.SavageBlowAttackRUID, capturedPos, 0, 1.0, self.SavageBlowEffectScale * scaleRatio, 1.0, "skilleffectlong")
				if fx ~= nil then fx:Destroy(self.SavageBlowAttackLifetime) end

				-- 유저 지정: 타격 연출도 1회만 스폰해서 끝까지 온전히 재생하고(중간에 새로 스폰하지
				-- 않음), 그 재생 시간(SavageBlowHitLifetime)을 3등분해서 3타 데미지 타이밍을 잡는다.
				-- 연출은 대상 생사와 무관하게 항상 재생(유저 정책) — 데미지만 유효성 체크.
				local hfx = self:SpawnEffectWithModel(self.SavageBlowHitRUID, capturedPos, 0, 1.0, self.SavageBlowEffectScale * scaleRatio, 1.0, "skilleffectlong")
				if hfx ~= nil then hfx:Destroy(self.SavageBlowHitLifetime) end
				self:PlaySavageBlowHitSound()

				local capturedMap = map
				local capturedDamage = damage
				local capturedIsCrit = isCrit
				local tick = self.SavageBlowHitLifetime / 3

				-- 유저 지정: "범위기" — 겨냥 지점 하나만 맞는 게 아니라 그 반경(SavageBlowRadius) 안의
				-- 몬스터를 전부 타격한다(아이스 커터의 FireIceCutterShot과 동일 패턴).
				local applyHit = function(hitIndex)
					local pct = self:GetSavageBlowPercent(self.SavageBlowLevel, hitIndex)
					local hitDamage = capturedDamage * pct
					local monsters = self:GetMonstersInCurrentZone(capturedMap)
					local hitCount = 0
					for _, mob in ipairs(monsters) do
						---@type MonsterAI
						local m = mob
						if isvalid(m) and isvalid(m.Entity) and not m._dead then
							local mp = m.Entity.TransformComponent.Position
							local dx = mp.x - centerPos.x
							local dy = mp.y - centerPos.y
							if (dx * dx + dy * dy) <= (self.SavageBlowRadius * self.SavageBlowRadius) then
								hitCount = hitCount + 1
								local offsetX = (hitIndex - 2) * self.SavageBlowDamageNumberSpacing
								if capturedIsCrit then
									m:TakeDamageCritWithOffset(hitDamage * 2, Vector2(offsetX, 0))
								else
									m:TakeDamageWithOffset(hitDamage, Vector2(offsetX, 0))
								end
							end
						end
					end
					log("SavageBlowAttack: hit " .. hitIndex .. "/3 dmg=" .. math.floor(hitDamage) .. " hitCount=" .. hitCount)
				end

				applyHit(1)
				for hitIndex = 2, 3 do
					local hitDelay = (hitIndex - 1) * tick
					_TimerService:SetTimerOnce(function()
						if not isvalid(self) then return end
						applyHit(hitIndex)
					end, hitDelay)
				end
			end
		end

		log("SavageBlowAttack: targets=" .. #targets)
	end

	-- ── 쉐이드 조합 스킬: 소닉 블로우 (카드186) — 새비지 블로우(173) Lv5 + 대거 액셀레이션(180) +
	-- 카르마(182, 둘 다 슬롯 없는 패시브) 보유 시 등장. 새비지 블로우와 달리 반경 스플래시 없이
	-- GetClosestTargets로 뽑힌 각 타겟마다 독립적으로 5연타(레벨 무관 동일 % 5회)를 꽂는다. 유저 지정:
	-- "데미지 뜨는 텍스트 띠엄띠엄 나오게" — 더블 스탭/새비지 블로우와 동일한 순차 타이머 + 수평 오프셋
	-- 해법 재사용. 새비지 블로우 슬롯을 그대로 넘겨받는다. 3레벨까지만 존재.
	@Sync property integer SonicBlowLevel = 0
	property number Card186Cooldown = 5.0  -- 레벨 무관 고정(유저 표)
	property string Card186IconRUID = "ffecbd57b88f44d3991cb6738f739e09"

	-- 리소스팩 "skill/400041039"
	-- 유저 지정: keydownend0(공격 준비 모션)이 먼저, keydown(실질 공격 모션)이 그 다음 — 대미지는 keydown 타이밍
	property string SonicBlowCastRUID = "25dc4e5a172d44e99af558b0540316c0"  -- keydownend0(준비)
	property string SonicBlowHitRUID = "96c839fe34124843ad494094d1e7d2db"  -- keydown(실질 공격, 복구)
	property string SonicBlowPreSoundRUID = "2aea2b5ac7784efc8f20592f56e1343b"  -- audio/Pre
	property string SonicBlowHitSoundRUID = "0085b37ffaa0486fb9e9eec340e12b76"  -- audio/Hit
	property string SonicBlowEndSoundRUID = "20e97d8987cc482ba2b6ed89f9700b49"  -- audio/End

	-- 연출 타이밍/크기 — 실측 전 추정치, 라이브 확인 후 조정 필요
	property number SonicBlowCastLifetime = 0.5
	property number SonicBlowHitLifetime = 0.3
	property number SonicBlowEffectScale = 0.72  -- 유저 지정: 기존 20% 축소(0.8)에서 추가로 10% 더 축소(0.8*0.9)
	property number SonicBlowHitEffectScale = 0.5  -- 유저 지정: 타격 연출 절반 크기
	property number SonicBlowEffectYOffset = 0.3  -- 더블 스탭/암살과 동일 보정 기본 적용
	property number SonicBlowEffectXOffset = 0.3  -- 유저 지정: 첫 연출(캐스트) 오른쪽으로 0.3 이동
	property number SonicBlowHitInterval = 0.15  -- 5연타 간격(총 0.6초 분량)
	-- 유저 지정: 새비지 블로우(173) 업그레이드라 범위기여야 함 — 새비지 블로우와 동일한 반경 판정 패턴
	-- (SavageBlowRadius=1.5와 동일 값으로 시작).
	property number SonicBlowRadius = 1.5
	-- 유저 지정: 수평 오프셋은 제거하고 엔진 기본 트윈(위로 뜨는 연출) 그대로 사용 — 대신 숫자끼리
	-- 붙어서 겹쳐 보이지 않게 타수마다 시작 높이를 조금씩 띄운다(1타가 제일 아래, 5타가 제일 위).
	property number SonicBlowDamageNumberSpacing = 0.4
	property number SonicBlowDamageNumberYStep = 0.3

	method number GetSonicBlowDamage(integer level)
		if level >= 3 then return 340
		elseif level >= 2 then return 290
		end
		return 260
	end

	-- 타겟 수 — 레벨 무관 4명 고정(유저 표)
	method integer GetSonicBlowTargetCount(integer level)
		return 4
	end

	-- 타당 비율 — 38/40/42%(유저 표, 레벨별 동일 비율로 5회 반복)
	method number GetSonicBlowPercent(integer level)
		if level >= 3 then return 0.42
		elseif level >= 2 then return 0.40
		end
		return 0.38
	end

	@ExecSpace("ServerOnly")
	method void SonicBlowAttack(number damage, boolean isCrit)
		local map = self:GetCurrentMap()
		if map == nil then return end
		local targets = self:GetClosestTargets(self:GetSonicBlowTargetCount(self.SonicBlowLevel))
		if #targets == 0 then
			if self._shadowPartnerCopyActive and isvalid(self._shadowPartnerFallbackTarget) then
				targets = { self._shadowPartnerFallbackTarget }
			else
				return
			end
		end

		self:PlaySonicBlowPreSound()

		for _, target in ipairs(targets) do
			if isvalid(target) and isvalid(target.Entity) then
				local scaleRatio = self:GetEffectScaleRatio(target)
				local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
				local castPos = Vector3(p.x + self.SonicBlowEffectXOffset, p.y + self.SonicBlowEffectYOffset, p.z - 0.1)
				local fx = self:SpawnEffect(self.SonicBlowCastRUID, castPos, 0, 1.0, self.SonicBlowEffectScale * scaleRatio, 1.0)
				if fx ~= nil then fx:Destroy(self.SonicBlowCastLifetime) end

				local pct = self:GetSonicBlowPercent(self.SonicBlowLevel)
				local hitDamage = damage * pct

				-- 유저 지정: 새비지 블로우(173) 업그레이드라 범위기여야 함 — 겨냥 지점(centerPos) 반경
				-- 안의 몬스터를 전부 타격(새비지 블로우와 동일 패턴). 판정 기준 좌표는 캐스트 시점에 고정.
				local centerPos = target.Entity.TransformComponent.Position
				local capturedMap = map
				local capturedIsCrit = isCrit

				local hitPos = Vector3(p.x, p.y + self.SonicBlowEffectYOffset, p.z - 0.1)
				local hfx = self:SpawnEffect(self.SonicBlowHitRUID, hitPos, 0, 1.0, self.SonicBlowHitEffectScale * scaleRatio, 1.0)
				local totalHitDuration = 4 * self.SonicBlowHitInterval + self.SonicBlowHitLifetime
				if hfx ~= nil then hfx:Destroy(totalHitDuration) end

				local applyDamageTick = function(hitIndex)
					if not isvalid(self) then return end
					self:PlaySonicBlowHitSound()

					-- 유저 지정: 수평으로 퍼지지 말고 대미지 숫자는 엔진 기본 위로 뜨는 트윈 그대로 —
					-- 대신 붙어서 겹쳐 보이지 않게 타수마다 시작 높이를 위로 조금씩 띄운다.
					local offsetX = 0
					local offsetY = (hitIndex - 1) * self.SonicBlowDamageNumberYStep
					local monsters = self:GetMonstersInCurrentZone(capturedMap)
					local hitCount = 0
					for _, mob in ipairs(monsters) do
						---@type MonsterAI
						local m = mob
						if isvalid(m) and isvalid(m.Entity) and not m._dead then
							local mp = m.Entity.TransformComponent.Position
							local dx = mp.x - centerPos.x
							local dy = mp.y - centerPos.y
							if (dx * dx + dy * dy) <= (self.SonicBlowRadius * self.SonicBlowRadius) then
								hitCount = hitCount + 1
								if capturedIsCrit then
									m:TakeDamageCritWithOffset(hitDamage * 2, Vector2(offsetX, offsetY))
								else
									m:TakeDamageWithOffset(hitDamage, Vector2(offsetX, offsetY))
								end
							end
						end
					end
					log("SonicBlowAttack: hit " .. hitIndex .. "/5 dmg=" .. math.floor(capturedIsCrit and hitDamage * 2 or hitDamage) .. " hitCount=" .. hitCount)

					if hitIndex == 5 then self:PlaySonicBlowEndSound() end
				end

				applyDamageTick(1)
				for hitIndex = 2, 5 do
					local delay = (hitIndex - 1) * self.SonicBlowHitInterval
					_TimerService:SetTimerOnce(function()
						applyDamageTick(hitIndex)
					end, delay)
				end
			end
		end

		log("SonicBlowAttack: targets=" .. #targets)
	end

	@ExecSpace("Multicast")
	method void PlaySonicBlowPreSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.SonicBlowPreSoundRUID, 1.0)
	end

	@ExecSpace("Multicast")
	method void PlaySonicBlowHitSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.SonicBlowHitSoundRUID, 1.0)
	end

	@ExecSpace("Multicast")
	method void PlaySonicBlowEndSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.SonicBlowEndSoundRUID, 1.0)
	end

	@ExecSpace("Multicast")
	method void PlaySavageBlowSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.SavageBlowSoundRUID, 1.0)
	end

	@ExecSpace("Multicast")
	method void PlaySavageBlowHitSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.SavageBlowHitSoundRUID, 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayDoubleStepSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.DoubleStepSoundRUID, 1.0)
	end

	-- ── 쉐이드 전용: 기본공격(카드172) — 파이어샷/애로우샷/레이온 기본공격과 동일하게 슬롯 배치와
	-- 무관하게 항상 발동하는 상시 기본공격이며, GameManager.SelectedCharacter==3(쉐이드)일 때만 틱된다.
	-- 유저 지정: 연출 2개를 같은 위치에서 0.5초 간격으로 순차 재생(처음엔 동시 재생으로 요청했다가
	-- "동시 연출 말고 0.5초 간격"으로 정정받음). 데미지는 1타(연출1 스폰 시점)에만 적용 — 연출2는
	-- 순수 시각 후속타.
	@Sync property number ShadeAttackDamage = 100
	@Sync property number ShadeAttackCooldown = 0.8
	@Sync property integer ShadeAttackUpgradeCount = 0
	property integer ShadeAttackMultiplierCap = 5
	property number ShadeAttackFlatDamageBonus = 20
	property string ShadeAttackName = "기본공격"
	-- 전용 아이콘이 아직 없어 더블 스탭 아이콘을 임시로 재사용
	property string ShadeAttackIconRUID = "92a5020c978c46bdabab910598118b86"
	property string ShadeAttackEffectRUID1 = "ef25dcbf917042529e80b16545a66dcb"
	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 전용 리소스팩 번들 오디오(_audio/Use) 사용
	property string ShadeBasicAttackSoundRUID = "c48925b3dd9341a5b595be499182df90"

	method void PlayShadeBasicAttackSound()
		_SoundService:PlaySound(self.ShadeBasicAttackSoundRUID, 1.0)
	end
	property string ShadeAttackEffectRUID2 = "e324ac48bf11452a8b1863675b783c6c"
	property number ShadeAttackEffectScale = 1.0
	-- 유저 지정: 더블 스탭과 동일한 보정값(연출 좌표를 위로 올림) — 앞으로 신규 스킬 만들 때도 기본값으로 적용
	property number ShadeAttackEffectYOffset = 0.3
	-- 루프 방지 우선(더블 스탭과 동일한 이유 — 실측 없이 넉넉하게 잡으면 루프 재시작으로 깜빡인다)
	property number ShadeAttackEffectLifetime = 0.4
	property number _timerBasicShade = 0

	@ExecSpace("ServerOnly")
	method void ShadeBasicAttack(number damage, boolean isCrit, MonsterAI target)
		-- 버그 수정(2026-08-12, 유저 지적: "공격은 하는데 몬스터 죽으면 연출 안나가냐?") — 바로 아래
		-- 주석은 원래 "연출은 대상 생사와 무관하게 항상 재생"이라고 정책을 못박아놨는데, 정작 이 게이트가
		-- target._dead까지 같이 걸러버려서 죽은 대상이면 fx1/fx2 스폰 전에 통째로 return돼버렸다(정책과
		-- 실제 구현이 어긋나 있던 버그). 죽었어도 엔티티 자체가 유효하기만 하면 연출은 계속 재생하고,
		-- 데미지/메소드랍만 아래에서 별도로 _dead 체크한다.
		if not isvalid(target) or not isvalid(target.Entity) then return end

		self:PlayShadeBasicAttackSound()

		-- 유저 지정: 연출2가 죽음 판정 때문에 스킵되면 "연출1만 두 번 보이는 것처럼" 느껴진다 —
		-- 위치를 여기서 미리 좌표값으로 캡처해두고, 연출2는 대상 생사와 무관하게 항상 재생한다
		-- (다음 지시 전까지 모든 연출은 타겟이 죽어도 끝까지 재생 — 유저 지정 공통 정책).
		-- 유저 지정: 0.5초 간격 대신 두 연출을 동시에(같은 위치에 겹쳐서) 재생
		local p1 = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
		local capturedPos = Vector3(p1.x, p1.y + self.ShadeAttackEffectYOffset, p1.z)
		local scaleRatio = self:GetEffectScaleRatio(target)
		local fx1 = self:SpawnEffect(self.ShadeAttackEffectRUID1, capturedPos, 0, 1.0, self.ShadeAttackEffectScale * scaleRatio, 1.0)
		if fx1 ~= nil then fx1:Destroy(self.ShadeAttackEffectLifetime) end
		local fx2 = self:SpawnEffect(self.ShadeAttackEffectRUID2, capturedPos, 0, 1.0, self.ShadeAttackEffectScale * scaleRatio, 1.0)
		if fx2 ~= nil then fx2:Destroy(self.ShadeAttackEffectLifetime) end

		if target._dead then return end

		if isCrit then
			target:TakeDamageCrit(damage * 2)
		else
			target:TakeDamage(damage)
		end

		-- 유저 지정(2026-08-12): "스틸이 없어도 메소 익스플로젼이 죽은 스킬이 안 되게" — 메소 익스플로젼을
		-- 찍었으면(레벨 무관, 1 이상이면) 기본 공격도 레벨별 확률로 메소를 떨군다. 스틸(Card176)이 슬롯에
		-- 없어도 메소 공급원이 생기도록 하는 게 목적이라, 스틸과 완전히 독립적으로 판정한다.
		if self.MesoExplosionLevel > 0 and _UtilLogic:RandomDouble() < self:GetMesoExplosionBasicAttackDropChance(self.MesoExplosionLevel) then
			self:DropMesoFromBasicAttack(target)
		end

		log("ShadeBasicAttack: dmg=" .. math.floor(isCrit and damage * 2 or damage))
	end

	-- 기본 공격 메소 드랍 확률(카드177 보유 시) — Lv1:5% / Lv2:10% / Lv3:15% / Lv4:20% / Lv5:25% (유저 지정)
	-- 메소 데토네이션(카드189) 보유 시에는 레벨식을 벗어나 고정 30%로 오른다(유저 지정 표).
	method number GetMesoExplosionBasicAttackDropChance(integer level)
		if self.MesoDetonationLevel > 0 then return 0.30 end
		return level * 0.05
	end

	-- ShadeBasicAttack 전용 — TriggerStealDrop의 메소 파트만 재사용(잡템/장비는 기본 공격에서 안 뜬다,
	-- 유저 지정: "메소 드랍되게"만 요청). 금액은 스틸과 동일하게 Card176MesoAmount를 공유한다.
	@ExecSpace("ServerOnly")
	method void DropMesoFromBasicAttack(MonsterAI target)
		if not isvalid(target) or not isvalid(target.Entity) then return end
		local worldPos = target.Entity.TransformComponent.WorldPosition
		local fallParams = target:GetLootDropFallParams()
		_GameManager:ScheduleMesoDrop(worldPos, fallParams.fallHeight, fallParams.groundWorldY, self.Card176MesoAmount, fallParams.dropScale)
	end

	-- ── 쉐이드 전용: 연막탄 (카드174, 슬롯형 액티브 3호). GetClosestTargets로 뽑힌 조준 지점마다 연막
	-- 구역을 깔아, 그 반경 안의 몬스터에게 1초마다(지속시간초 만큼) 기준값의 100%를 DoT로 주고, 동시에
	-- 그 몬스터들의 플레이어 공격 명중률을 낮춘다(MonsterAI.ApplyAccuracyDebuff, 보스/엘리트는 OnReachPlayer에서
	-- 절반만 적용). 유저 지정: "연출 반경 너무 크지 않게 적당히" — 1차로 작게 잡고 피드백 받아 조정.
	@Sync property integer SmokeGrenadeLevel = 0
	property number Card174Cooldown = 8.0  -- 레벨 무관 고정(유저 표)
	property number SmokeGrenadeRadius = 1.2  -- 유저 지정: 너무 크지 않게 적당히(1차 추정치)
	property number SmokeGrenadeEffectScale = 0.85  -- 유저 지정: 15% 축소
	property number SmokeGrenadeEffectYOffset = 0.0
	property string SmokeGrenadeThrowRUID = "d703cc75584b4100af8a921f874b30b8"  -- effect(투척/폭발 연출, 1회)
	property number SmokeGrenadeThrowLifetime = 0.6  -- 실측 전 보수적 추정치(루프 방지 우선)
	-- 유저 지정(2026-08-13, 재조정): tile/0(8~16프레임) 자체 루프를 사라질 때까지 그대로 유지 —
	-- special(8e5ca7e1) 전환 시도했으나 깜빡거림 발생해서 되돌림.
	property string SmokeGrenadeCloudRUID = "d8017cb7a16c49a196425a03b29d52f8"  -- tile/0(지속되는 연막 구름, 반경 동안 루프)
	property string SmokeGrenadeSoundRUID = "ad63f4c64f304b6c876fb68511addb87"
	property number SmokeGrenadeFadeOutDuration = 0.4  -- 구름이 사라지기 이 시간 전부터 알파를 0으로 서서히 낮춘다(AquaSurge와 동일 패턴)

	-- 타당 기준 데미지(레벨별 고정값 — 유저 지정 표, 초당 100%로 그대로 적용)
	method number GetSmokeGrenadeDamage(integer level)
		if level >= 5 then return 90
		elseif level >= 4 then return 60
		elseif level >= 3 then return 50
		elseif level >= 2 then return 30
		end
		return 20
	end

	-- 타겟 수(조준 지점 수) — Lv1:1 / Lv2~4:2 / Lv5:3 (유저 지정 표)
	method integer GetSmokeGrenadeTargetCount(integer level)
		if level >= 5 then return 3 end
		if level >= 2 then return 2 end
		return 1
	end

	-- 몬스터 명중 하락률 — 20/30/40/50/60% (유저 지정 표)
	method number GetSmokeGrenadeMissChance(integer level)
		if level >= 5 then return 0.60
		elseif level >= 4 then return 0.50
		elseif level >= 3 then return 0.40
		elseif level >= 2 then return 0.30
		end
		return 0.20
	end

	-- 지속시간 — Lv1~2:3초 / Lv3~4:4초 / Lv5:5초 (유저 지정 표)
	method integer GetSmokeGrenadeDuration(integer level)
		if level >= 5 then return 5
		elseif level >= 3 then return 4
		end
		return 3
	end

	-- 연막탄 전용 타겟 선정 — 유저 지정: "2개 이상이면 멀리 있는 타겟으로 잡아서 넓게 퍼지게".
	-- 1번째는 GetClosestTargets와 동일하게 화면에 가까운(스케일 큰) 순으로 뽑고, 2번째부터는 이미
	-- 뽑힌 지점들과의 최소 거리가 가장 큰(가장 멀리 떨어진) 몬스터를 그리디하게 골라 퍼뜨린다.
	@ExecSpace("ServerOnly")
	method table GetSmokeGrenadeTargets(integer count)
		local map = self:GetCurrentMap()
		if map == nil then return {} end
		local monsters = self:GetMonstersInCurrentZone(map)
		local alive = {}
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead then table.insert(alive, m) end
		end
		if #alive == 0 then return {} end

		table.sort(alive, function(a, b) return (a._currentScale or 0) > (b._currentScale or 0) end)

		local result = { alive[1] }
		table.remove(alive, 1)

		while #result < count and #alive > 0 do
			local bestIdx = 1
			local bestMinDistSq = -1
			for i, cand in ipairs(alive) do
				local cp = cand.Entity.TransformComponent.Position
				local minDistSq = math.huge
				for _, sel in ipairs(result) do
					local sp = sel.Entity.TransformComponent.Position
					local dx = cp.x - sp.x
					local dy = cp.y - sp.y
					local distSq = dx * dx + dy * dy
					if distSq < minDistSq then minDistSq = distSq end
				end
				if minDistSq > bestMinDistSq then
					bestMinDistSq = minDistSq
					bestIdx = i
				end
			end
			table.insert(result, alive[bestIdx])
			table.remove(alive, bestIdx)
		end

		return result
	end

	@ExecSpace("ServerOnly")
	method void SmokeGrenadeAttack(number damage, boolean isCrit)
		local map = self:GetCurrentMap()
		if map == nil then return end
		local level = self.SmokeGrenadeLevel
		local targets = self:GetSmokeGrenadeTargets(self:GetSmokeGrenadeTargetCount(level))
		-- 버그 수정(2026-08-12) — DoubleStepAttack과 동일한 이유/패턴. GetSmokeGrenadeTargets도 내부적으로
		-- 살아있는 몬스터만 거르기 때문에 같은 문제가 생긴다.
		if #targets == 0 then
			if self._shadowPartnerCopyActive and isvalid(self._shadowPartnerFallbackTarget) then
				targets = { self._shadowPartnerFallbackTarget }
			else
				return
			end
		end

		self:PlaySmokeGrenadeSound()

		local duration = self:GetSmokeGrenadeDuration(level)
		local missChance = self:GetSmokeGrenadeMissChance(level)
		-- 유저 지정(2026-08-12): "쉐도우 파트너일떄는 예외처리로 스모크 디버프 X" — 파트너가 원본
		-- 메서드를 그대로 실행하는 동안엔 self._shadowPartnerCopyActive가 true다. 클로저(applyTick)가
		-- 나중에(최대 duration초 뒤까지) 실행될 수 있으므로, 그 시점엔 이미 플래그가 꺼져 있을 수 있어
		-- 지금 시점 값을 로컬로 캡처해서 넘긴다.
		local skipDebuff = self._shadowPartnerCopyActive

		for _, target in ipairs(targets) do
			if isvalid(target) and isvalid(target.Entity) then
				local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
				local capturedPos = Vector3(p.x, p.y + self.SmokeGrenadeEffectYOffset, p.z - 0.1)
				local centerPos = target.Entity.TransformComponent.Position
				local scaleRatio = self:GetEffectScaleRatio(target)

				-- 투척/폭발 연출 1회, 끝까지 온전히 재생 (유저 지정: 연막난무 쪽에서 조정한 좌표를
				-- 연막탄 본체에도 동일하게 적용 — SmokeRampageThrowXOffset/YOffset 재사용)
				local throwPos = Vector3(capturedPos.x + self.SmokeRampageThrowXOffset, capturedPos.y + self.SmokeRampageThrowYOffset, capturedPos.z)
				local fx = self:SpawnEffectWithModel(self.SmokeGrenadeThrowRUID, throwPos, 0, 1.0, self.SmokeGrenadeEffectScale * scaleRatio, 1.0, "skilleffectlong")
				if fx ~= nil then fx:Destroy(self.SmokeGrenadeThrowLifetime) end

				-- 지속되는 연막 구름 — 지속시간 동안 루프 재생(타일류 리소스라 루프 전제로 설계됨)
				local cloudScale = (self.SmokeGrenadeRadius / 1.2) * self.SmokeGrenadeEffectScale * scaleRatio
				local cloud = self:SpawnEffectWithModel(self.SmokeGrenadeCloudRUID, capturedPos, 0, 1.0, cloudScale, 1.0, "skilleffectlong")
				if cloud ~= nil then
					cloud:Destroy(duration)
					local cloudRenderer = cloud.SpriteRendererComponent
					if cloudRenderer ~= nil then
						-- 유저 지정(2026-08-13, 재조정): special로 전환하면 깜빡거림 발생 — tile/0(8~16프레임)
						-- 자체 루프를 사라질 때까지 그대로 유지하는 것으로 되돌림(special 전환 제거).
						local fadeDuration = math.min(self.SmokeGrenadeFadeOutDuration, duration)
						local fadeDelay = duration - fadeDuration
						_TimerService:SetTimerOnce(function()
							if not isvalid(cloud) or not isvalid(cloudRenderer) then return end
							_TweenLogic:PlayTween(1.0, 0.0, fadeDuration, EaseType.Linear, function(alpha)
								if isvalid(cloudRenderer) then cloudRenderer:SetAlpha(alpha) end
							end)
						end, fadeDelay)
					end
				end

				local capturedMap = map
				local capturedDamage = damage
				local capturedIsCrit = isCrit
				local capturedRadius = self.SmokeGrenadeRadius

				-- 1초마다(지속시간 동안) 반경 안의 몬스터 전부에게 DoT + 명중 하락 디버프 재적용
				local applyTick = function()
					local monsters = self:GetMonstersInCurrentZone(capturedMap)
					local hitCount = 0
					for _, mob in ipairs(monsters) do
						---@type MonsterAI
						local m = mob
						if isvalid(m) and isvalid(m.Entity) and not m._dead then
							local mp = m.Entity.TransformComponent.Position
							local dx = mp.x - centerPos.x
							local dy = mp.y - centerPos.y
							if (dx * dx + dy * dy) <= (capturedRadius * capturedRadius) then
								hitCount = hitCount + 1
								if capturedIsCrit then
									m:TakeDamageCrit(capturedDamage * 2)
								else
									m:TakeDamage(capturedDamage)
								end
								-- 다음 틱(1초 뒤)까지 여유를 두고 갱신 — 틱 사이에 명중 판정이 새는 걸 방지
								if not skipDebuff then m:ApplyAccuracyDebuff(missChance, 1.1) end
							end
						end
					end
					log("SmokeGrenadeAttack: tick dmg=" .. math.floor(capturedDamage) .. " hitCount=" .. hitCount)
				end

				applyTick()
				for tickIdx = 1, duration - 1 do
					local delay = tickIdx * 1.0
					_TimerService:SetTimerOnce(function()
						if not isvalid(self) then return end
						applyTick()
					end, delay)
				end
			end
		end

		log("SmokeGrenadeAttack: targets=" .. #targets)
	end

	@ExecSpace("Multicast")
	method void PlaySmokeGrenadeSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.SmokeGrenadeSoundRUID, 1.0)
	end

	-- ── 쉐이드 조합 스킬: 연막난무 (카드187) — 연막탄(174) Lv5 + 다크 사이트(184) + 대거 액셀레이션
	-- (180, 둘 다 슬롯 없는 패시브) 보유 시 등장. 연막탄의 투척/구름/초당 DoT(반경 안 전부)/명중디버프를
	-- 그대로 재사용하고(SmokeGrenadeAttack과 동일 로직), 구름이 깔리고 0.5초 뒤 중앙에 문양이 새겨졌다가
	-- 사라지면서 추가 타격 연출 + 보너스 대미지(120/140/160%, 반경 안 전부, 1회성)가 한 번 더 터진다.
	-- 3레벨까지만 존재. 연막탄 슬롯을 그대로 넘겨받는다.
	@Sync property integer SmokeRampageLevel = 0
	property number Card187Cooldown = 8.0  -- 레벨 무관 고정(유저 표)
	property string Card187IconRUID = "0a72fb25ab844cee8126b64b202cd7b9"

	-- 리소스팩 "skill/4211011"
	property string SmokeRampageSigilRUID = "c28f866bc99841a3baf48d997c3a77e7"  -- effect(중앙에 새겨지는 문양)
	property string SmokeRampageBurstHitRUID = "5420f6979d1a4f0aa259a7268f67362b"  -- hit/0(문양이 사라질 때 타격 연출)
	property string SmokeRampageBurstSoundRUID = "ae31d12c065d403fa2d9782460f787b0"  -- audio/hit

	-- 유저 지정: "연막 깔리고 0.5초 있다가" — 보너스 시퀀스 시작 타이밍
	property number SmokeRampageBonusDelay = 0.5
	-- 컷오프 확인(슬로우모션+skilleffectlong 임시 스폰으로 라이브 검증): 자연스럽게 다단계로 이어지는
	-- 연출이라 공용 "skilleffect" 모델의 내부 상한(0.8초)까지 꽉 채워서 끊기지 않게 한다 —
	-- 그 이상 넣어도 내부 SkillEffectAI가 먼저 파괴하므로 0.8초가 사실상 최대치.
	property number SmokeRampageSigilLifetime = 0.8
	property number SmokeRampageBurstHitLifetime = 0.35  -- 실측 전 추정치
	property number SmokeRampageSigilScaleMult = 1.15  -- 유저 지정: 문양 연출 15% 확대
	property number SmokeRampageSigilDepthOffset = 0.1  -- 유저 지정: 연막탄 구름보다 위(앞)에 그려지도록 추가로 당김
	property number SmokeRampageSigilXOffset = 0.8  -- 유저 지정: 문양 연출 오른쪽으로 1 이동 후 왼쪽으로 0.2 추가 조정(1.0-0.2)
	property number SmokeRampageSigilYOffset = 0.7  -- 유저 지정: 문양 연출 위로 0.7 이동
	-- 유저 지정: 투척/폭발 연출 오른쪽 0.4 / 위 1.0(0.6+0.4) 이동 — 연막난무뿐 아니라 연막탄(174)
	-- 본체 SmokeGrenadeAttack에도 동일하게 재사용해서 좌표를 맞춘다(둘 다 같은 연출을 공유하므로).
	property number SmokeRampageThrowXOffset = 0.4
	property number SmokeRampageThrowYOffset = 1.0

	-- 기준 데미지(초당 100% DoT 값) — 90/100/110 (유저 표, 연막탄 Lv5의 90과 동일하게 이어짐)
	method number GetSmokeRampageDamage(integer level)
		if level >= 3 then return 110
		elseif level >= 2 then return 100
		end
		return 90
	end

	-- 보너스 대미지 비율 — 120/140/160% (유저 표)
	method number GetSmokeRampageBonusPercent(integer level)
		if level >= 3 then return 1.60
		elseif level >= 2 then return 1.40
		end
		return 1.20
	end

	@ExecSpace("ServerOnly")
	method void SmokeRampageAttack(number damage, boolean isCrit)
		local map = self:GetCurrentMap()
		if map == nil then return end
		-- 유저 지정: 연막난무 활성 중에도 연막탄(174)은 계속 Lv5로 남아있어 타겟수/명중하락/지속시간을
		-- 그대로 재사용할 수 있다(소닉 블로우가 SavageBlowLevel을 그대로 쓰는 것과 동일한 패턴).
		local targets = self:GetSmokeGrenadeTargets(self:GetSmokeGrenadeTargetCount(self.SmokeGrenadeLevel))
		if #targets == 0 then
			if self._shadowPartnerCopyActive and isvalid(self._shadowPartnerFallbackTarget) then
				targets = { self._shadowPartnerFallbackTarget }
			else
				return
			end
		end

		self:PlaySmokeGrenadeSound()

		local duration = self:GetSmokeGrenadeDuration(self.SmokeGrenadeLevel)
		local missChance = self:GetSmokeGrenadeMissChance(self.SmokeGrenadeLevel)
		local bonusPct = self:GetSmokeRampageBonusPercent(self.SmokeRampageLevel)
		local skipDebuff = self._shadowPartnerCopyActive

		for _, target in ipairs(targets) do
			if isvalid(target) and isvalid(target.Entity) then
				local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
				local capturedPos = Vector3(p.x, p.y + self.SmokeGrenadeEffectYOffset, p.z - 0.1)
				local centerPos = target.Entity.TransformComponent.Position
				local scaleRatio = self:GetEffectScaleRatio(target)

				-- 투척/폭발 연출 1회 (연막탄과 동일하되, 유저 지정으로 위로 0.6 추가 이동 — 연막난무 전용)
				local throwPos = Vector3(capturedPos.x + self.SmokeRampageThrowXOffset, capturedPos.y + self.SmokeRampageThrowYOffset, capturedPos.z)
				local fx = self:SpawnEffectWithModel(self.SmokeGrenadeThrowRUID, throwPos, 0, 1.0, self.SmokeGrenadeEffectScale * scaleRatio, 1.0, "skilleffectlong")
				if fx ~= nil then fx:Destroy(self.SmokeGrenadeThrowLifetime) end

				-- 지속되는 연막 구름 (연막탄과 동일)
				local cloudScale = (self.SmokeGrenadeRadius / 1.2) * self.SmokeGrenadeEffectScale * scaleRatio
				local cloud = self:SpawnEffectWithModel(self.SmokeGrenadeCloudRUID, capturedPos, 0, 1.0, cloudScale, 1.0, "skilleffectlong")
				if cloud ~= nil then
					cloud:Destroy(duration)
					local cloudRenderer = cloud.SpriteRendererComponent
					if cloudRenderer ~= nil then
						-- 유저 지정(2026-08-13, 재조정): special로 전환하면 깜빡거림 발생 — tile/0(8~16프레임)
						-- 자체 루프를 사라질 때까지 그대로 유지하는 것으로 되돌림(special 전환 제거).
						local fadeDuration = math.min(self.SmokeGrenadeFadeOutDuration, duration)
						local fadeDelay = duration - fadeDuration
						_TimerService:SetTimerOnce(function()
							if not isvalid(cloud) or not isvalid(cloudRenderer) then return end
							_TweenLogic:PlayTween(1.0, 0.0, fadeDuration, EaseType.Linear, function(alpha)
								if isvalid(cloudRenderer) then cloudRenderer:SetAlpha(alpha) end
							end)
						end, fadeDelay)
					end
				end

				local capturedMap = map
				local capturedDamage = damage
				local capturedIsCrit = isCrit
				local capturedRadius = self.SmokeGrenadeRadius

				-- 1초마다(지속시간 동안) 반경 안의 몬스터 전부에게 DoT + 명중 하락 디버프 재적용 (연막탄과 동일)
				local applyTick = function()
					local monsters = self:GetMonstersInCurrentZone(capturedMap)
					local hitCount = 0
					for _, mob in ipairs(monsters) do
						---@type MonsterAI
						local m = mob
						if isvalid(m) and isvalid(m.Entity) and not m._dead then
							local mp = m.Entity.TransformComponent.Position
							local dx = mp.x - centerPos.x
							local dy = mp.y - centerPos.y
							if (dx * dx + dy * dy) <= (capturedRadius * capturedRadius) then
								hitCount = hitCount + 1
								if capturedIsCrit then
									m:TakeDamageCrit(capturedDamage * 2)
								else
									m:TakeDamage(capturedDamage)
								end
								if not skipDebuff then m:ApplyAccuracyDebuff(missChance, 1.1) end
							end
						end
					end
					log("SmokeRampageAttack: tick dmg=" .. math.floor(capturedDamage) .. " hitCount=" .. hitCount)
				end

				applyTick()
				for tickIdx = 1, duration - 1 do
					local delay = tickIdx * 1.0
					_TimerService:SetTimerOnce(function()
						if not isvalid(self) then return end
						applyTick()
					end, delay)
				end

				-- 유저 지정: 연막 깔리고 0.5초 뒤 — 중앙에 문양이 새겨졌다가 사라지면서 타격 연출 +
				-- 보너스 대미지(반경 안 전부, 1회성)가 터진다.
				_TimerService:SetTimerOnce(function()
					if not isvalid(self) then return end
					-- 유저 지정: 연막탄 구름보다 위(앞)에 보이도록 z를 추가로 당기고, 오른쪽 1/위로 0.7 이동.
					local sigilPos = Vector3(capturedPos.x + self.SmokeRampageSigilXOffset, capturedPos.y + self.SmokeRampageSigilYOffset, capturedPos.z - self.SmokeRampageSigilDepthOffset)
					local sigil = self:SpawnEffect(self.SmokeRampageSigilRUID, sigilPos, 0, 1.0, self.SmokeGrenadeEffectScale * self.SmokeRampageSigilScaleMult * scaleRatio, 1.0)
					if sigil ~= nil then sigil:Destroy(self.SmokeRampageSigilLifetime) end

					_TimerService:SetTimerOnce(function()
						if not isvalid(self) then return end
						local hfx = self:SpawnEffect(self.SmokeRampageBurstHitRUID, capturedPos, 0, 1.0, self.SmokeGrenadeEffectScale * scaleRatio, 1.0)
						if hfx ~= nil then hfx:Destroy(self.SmokeRampageBurstHitLifetime) end
						self:PlaySmokeRampageBurstSound()

						local bonusDamage = capturedDamage * bonusPct
						local monsters = self:GetMonstersInCurrentZone(capturedMap)
						local hitCount = 0
						for _, mob in ipairs(monsters) do
							---@type MonsterAI
							local m = mob
							if isvalid(m) and isvalid(m.Entity) and not m._dead then
								local mp = m.Entity.TransformComponent.Position
								local dx = mp.x - centerPos.x
								local dy = mp.y - centerPos.y
								if (dx * dx + dy * dy) <= (capturedRadius * capturedRadius) then
									hitCount = hitCount + 1
									if capturedIsCrit then
										m:TakeDamageCrit(bonusDamage * 2)
									else
										m:TakeDamage(bonusDamage)
									end
								end
							end
						end
						log("SmokeRampageAttack: bonus dmg=" .. math.floor(bonusDamage) .. " hitCount=" .. hitCount)
					end, self.SmokeRampageSigilLifetime)
				end, self.SmokeRampageBonusDelay)
			end
		end

		log("SmokeRampageAttack: targets=" .. #targets)
	end

	@ExecSpace("Multicast")
	method void PlaySmokeRampageBurstSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.SmokeRampageBurstSoundRUID, 1.0)
	end

	-- ── 쉐이드 전용: 무스펠하임 (카드175, 슬롯형 액티브 4호). 플레시 미라주(Card108)/플래시 봄버
	-- (Card120)와 동일한 좌/우 최외곽 탐색 + 중앙 넉백 메커니즘(2타겟일 때는 좌우 한 명씩 동시에
	-- 중앙으로 넉백)이지만, 넉백 도중 경로상 충돌 대미지는 없다(유저 지정: "넉백 되면서 적들을
	-- 치는게 아니라 넉백된 몬스터가 멈춘 자리에서 범위 대미지 줄거임"). 즉 대미지는 오직 넉백이 끝나
	-- 멈춘 자리에서 한 번, 그 반경 안의 모든 몬스터(자기 자신 포함)에게 기준값의 100%로 터진다.
	@Sync property integer MuspelheimLevel = 0
	property number Card175Cooldown = 5.0  -- 레벨 무관 고정(유저 표)
	property string Card175Name = "무스펠하임"
	property string Card175IconRUID = "19361e72087946b1888684185b40d935"
	property string Card175CastRUID = "15c9678df2124b1f80e7f70ab72967c2"  -- 캐스트(넉백 시작) 연출, animationclip — "찌르는" 느낌을 주는 원본
	property string Card175Cast2RUID = "6f77577e40804440bbce497cde2cfe7d"  -- 캐스트 보조 연출(유저 지정) — 원본과 겹쳐서 같이 재생, 밋밋함 보완용
	property string Card175ExplosionRUID = "784abcdbe11147edabf3d6eb565da9ef"  -- 범위 대미지 타격(폭발) 연출, animationclip
	property string Card175SoundRUID = "47437cd74d964d7488c2ddc30b551756"
	-- 유저 지정: 기본(캐스트) 연출은 20% 작게, 터지는(폭발) 연출은 20% 크게 — 서로 반대 방향이라 분리
	property number Card175CastScale = 0.8
	property number Card175Cast2Scale = 0.8  -- 보조 연출도 원본과 동일 배율로 겹쳐 재생
	property number Card175ExplosionScale = 1.2
	-- 유저 지정: 보조 연출은 원본과 겹치지 않고 "쏘아지는 방향의 반대쪽"에 0.6만큼 떨어져 붙는다(꼬리처럼)
	property number Card175Cast2OffsetX = 0.6
	-- 신규 스킬 기본 보정값(유저 지정 정책): 연출 좌표를 위로 0.3 올림
	property number Card175EffectYOffset = 0.3
	-- 실측 전 보수적 추정치(루프 방지 우선) — 피드백 받아 조정
	property number Card175CastLifetime = 0.5
	property number Card175Cast2Lifetime = 0.5  -- 원본과 같이 나가야 하므로 동일 재생시간
	property number Card175ExplosionLifetime = 0.4
	-- 리소스 실측(784abcdb...): 최대 프레임 160×116px, Card175ExplosionScale(1.2) 적용 시 약 192×139px
	-- = 1.92×1.39 유닛. 가로 기준 반경(0.96)으로 잡으면 세로(더 좁은 쪽, 절반 0.7유닛)에서는 판정이
	-- 연출보다 눈에 띄게 넓게 남는다(유저 지적: "폭발 반경이 연출이랑 같은 사이즈 맞아?" — 아니었음).
	-- 더 타이트한 세로 기준에 맞춰 축소.
	property number Card175ExplosionRadius = 0.7
	-- 유저 지정: 양옆에서 넉백된 몬스터가 중앙에서 충돌하면 폭발을 1개로 합쳐서 1.7배 크게(연출+판정 반경 모두)
	property number Card175MergedExplosionMultiplier = 1.7
	property number Card175KnockbackDuration = 0.5  -- FleshMirage와 동일한 물리 이동 시간
	-- 유저 지정: "넉백이 조금 더 빨리 일어나야됨" — 0.5 → 0.3
	property number Card175KnockbackStartDelay = 0.3
	property number Card175CenterRadius = 1.0  -- FleshMirage와 동일 — 이 반경 안이면 "이미 중앙" 취급
	property number Card175OutwardOvershoot = 1000.0
	-- 유저 지정: "쏘아지는것처럼 살짝 움직이게" — 원본 캐스트 연출을 넉백 방향으로 짧게 찌르듯 이동
	property number Card175ThrustDistance = 0.3
	property number Card175ThrustDuration = 0.15

	method number GetMuspelheimDamage(integer level)
		if level >= 5 then return 260
		elseif level >= 4 then return 200
		elseif level >= 3 then return 180
		elseif level >= 2 then return 150
		end
		return 130
	end

	-- 타겟 수 — Lv1~2:1명 / Lv3~5:2명(좌우 동시, 유저 지정 표)
	method integer GetMuspelheimTargetCount(integer level)
		if level >= 3 then return 2 end
		return 1
	end

	-- 자체 크리티컬 확률 보너스 — Lv1:10%/Lv2:15%/Lv3:20%/Lv4:25%/Lv5:30%(유저 지정 표, RollCrit cardIdx==175에서 합산)
	method number GetMuspelheimCritChance(integer level)
		if level >= 5 then return 0.30
		elseif level >= 4 then return 0.25
		elseif level >= 3 then return 0.20
		elseif level >= 2 then return 0.15
		end
		return 0.10
	end

	-- 플레시 미라주(FleshMirageAttack)와 동일한 좌/우 최외곽 탐색 + 중앙근방 예외 로직 재사용.
	-- 넉백 방향은 항상 중앙(x=0)이다.
	@ExecSpace("ServerOnly")
	method void MuspelheimAttack(number damage, boolean isCrit)
		local map = self:GetCurrentMap()
		if map == nil then return end
		local monsters = self:GetMonstersInCurrentZone(map)
		local centerX = self:GetZoneCenterX()

		local leftExtreme, rightExtreme = nil, nil
		local centerCluster = {}
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local x = m.Entity.TransformComponent.Position.x
				if x < centerX - self.Card175CenterRadius and (leftExtreme == nil or x < leftExtreme.Entity.TransformComponent.Position.x) then
					leftExtreme = m
				elseif x > centerX + self.Card175CenterRadius and (rightExtreme == nil or x > rightExtreme.Entity.TransformComponent.Position.x) then
					rightExtreme = m
				elseif x >= centerX - self.Card175CenterRadius and x <= centerX + self.Card175CenterRadius then
					table.insert(centerCluster, m)
				end
			end
		end
		if leftExtreme == nil and rightExtreme == nil and #centerCluster == 0 then return end

		self:PlayMuspelheimSound()
		local targetCount = self:GetMuspelheimTargetCount(self.MuspelheimLevel)

		if targetCount >= 2 then
			if leftExtreme ~= nil and rightExtreme ~= nil then
				-- 유저 지정: 양옆 실제 몬스터가 둘 다 있으면 중앙에서 만나 충돌하므로, 폭발도 하나로
				-- 합쳐서 1.7배 크게 터뜨린다.
				self:FireMuspelheimShovePaired(map, leftExtreme, rightExtreme, centerX, damage, isCrit)
			else
				if leftExtreme ~= nil then
					self:FireMuspelheimShove(map, leftExtreme, centerX, damage, isCrit)
				elseif #centerCluster > 0 then
					local pick = centerCluster[_UtilLogic:RandomIntegerRange(1, #centerCluster)]
					self:FireMuspelheimShove(map, pick, centerX - self.Card175OutwardOvershoot, damage, isCrit)
				end
				if rightExtreme ~= nil then
					self:FireMuspelheimShove(map, rightExtreme, centerX, damage, isCrit)
				elseif #centerCluster > 0 then
					local pick = centerCluster[_UtilLogic:RandomIntegerRange(1, #centerCluster)]
					self:FireMuspelheimShove(map, pick, centerX + self.Card175OutwardOvershoot, damage, isCrit)
				end
			end
		else
			local pickRight
			if leftExtreme == nil and rightExtreme == nil then
				local pick = centerCluster[_UtilLogic:RandomIntegerRange(1, #centerCluster)]
				local dest = (_UtilLogic:RandomDouble() < 0.5) and (centerX - self.Card175OutwardOvershoot) or (centerX + self.Card175OutwardOvershoot)
				self:FireMuspelheimShove(map, pick, dest, damage, isCrit)
				return
			elseif leftExtreme == nil then pickRight = true
			elseif rightExtreme == nil then pickRight = false
			else pickRight = _UtilLogic:RandomDouble() < 0.5 end
			if pickRight then
				self:FireMuspelheimShove(map, rightExtreme, centerX, damage, isCrit)
			else
				self:FireMuspelheimShove(map, leftExtreme, centerX, damage, isCrit)
			end
		end
	end

	-- 캐스트 연출(원래 위치) 재생 → Card175KnockbackStartDelay 뒤 넉백 시작 → 넉백이 끝나 멈춘 자리에서
	-- onLanded(stopPos)를 호출한다. 폭발 연출/대미지는 여기서 직접 처리하지 않고 호출부(단일 폭발 —
	-- FireMuspelheimShove / 병합 폭발 — FireMuspelheimShovePaired)에 위임한다.
	@ExecSpace("ServerOnly")
	method void LaunchMuspelheimKnockback(MonsterAI primary, number destX, any onLanded)
		if not isvalid(primary) or not isvalid(primary.Entity) or not isvalid(primary.Entity.TransformComponent) then return end
		destX = self:ClampKnockbackDestX(primary, destX)
		local pp = primary.Entity.TransformComponent.Position
		local scaleRatio = self:GetEffectScaleRatio(primary)
		-- 유저 지정: 연출의 반전 기준(FlipX=false)이 오른쪽 방향 — 왼쪽으로 보낼 때만 반전시킨다
		local dirRight = destX > pp.x
		local flipped = not dirRight
		local thrustSign = dirRight and 1 or -1
		local castOrigin = Vector3(pp.x, pp.y + self.Card175EffectYOffset, pp.z)

		local castFx = self:SpawnEffectWithModel(self.Card175CastRUID, castOrigin, 0, 1.0, self.Card175CastScale * scaleRatio, 1.0, "skilleffectlong")
		if castFx ~= nil then
			castFx:Destroy(self.Card175CastLifetime)
			-- 유저 지정: 원본 연출(15c9678d)은 반전 방향이 반대였다 — 이 연출만 flipped를 뒤집어 사용(보조 연출은 그대로)
			local castR = castFx.SpriteRendererComponent
			if castR ~= nil then castR.FlipX = not flipped end
			-- 유저 지정: "쏘아지는것처럼 살짝 움직이게" — 넉백 방향으로 짧게 찌르듯 이동시켜 정적으로
			-- 보이지 않게 한다.
			_TweenLogic:PlayTween(0.0, self.Card175ThrustDistance, self.Card175ThrustDuration, EaseType.QuadEaseOut, function(t)
				if not isvalid(castFx) then return end
				castFx.TransformComponent.Position = Vector3(castOrigin.x + thrustSign * t, castOrigin.y, castOrigin.z)
			end)
		end

		-- 유저 지정: 보조 연출은 원본과 겹치지 않고 "쏘아지는 방향의 반대쪽"(꼬리 위치)에 0.6만큼
		-- 떨어져 붙는다.
		local cast2Pos = Vector3(castOrigin.x - thrustSign * self.Card175Cast2OffsetX, castOrigin.y, castOrigin.z)
		local cast2Fx = self:SpawnEffectWithModel(self.Card175Cast2RUID, cast2Pos, 0, 1.0, self.Card175Cast2Scale * scaleRatio, 1.0, "skilleffectlong")
		if cast2Fx ~= nil then
			cast2Fx:Destroy(self.Card175Cast2Lifetime)
			local cast2R = cast2Fx.SpriteRendererComponent
			if cast2R ~= nil then cast2R.FlipX = flipped end
		end

		-- 넉백이 멈추는 자리(stopPos) — 도중에 primary가 죽어도 항상 그 자리에서 onLanded가 불리도록
		-- 캐스트 시점에 미리 고정해둔다(다른 스킬과 동일한 정책).
		local stopPos = Vector3(destX, pp.y, pp.z)

		-- 유저 지적(2026-08-12): "쉐도우 무스펠하임 넉백되는 시간 땡기자 0.3s정도 더 빨리" — 쉐도우
		-- 파트너가 이 메서드를 호출하는 동안만 켜져 있는 `_shadowPartnerCopyActive` 플래그로 분기해서,
		-- 넉백 시작 딜레이를 그만큼 앞당긴다(0 밑으로는 안 내려가게 clamp). 플레이어가 직접 쓰는
		-- 원본 무스펠하임(이 플래그가 꺼져 있을 때)은 기존 타이밍 그대로 유지.
		local startDelay = self.Card175KnockbackStartDelay
		if self._shadowPartnerCopyActive then
			startDelay = math.max(0, startDelay - self.Card178MuspelheimKnockbackTimeAdvance)
		end

		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(primary) or not isvalid(primary.Entity) or primary._dead then return end
			primary:ApplyLateralShove(destX, self.Card175KnockbackDuration)

			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				if onLanded ~= nil then onLanded(stopPos) end
			end, self.Card175KnockbackDuration)
		end, startDelay)
	end

	-- 단일 타겟용 — 넉백이 끝나면 그 자리에서 기본 크기(1.0배)로 폭발한다.
	@ExecSpace("ServerOnly")
	method void FireMuspelheimShove(Entity map, MonsterAI primary, number destX, number damage, boolean isCrit)
		self:LaunchMuspelheimKnockback(primary, destX, function(stopPos)
			self:ResolveMuspelheimExplosion(map, stopPos, damage, isCrit, 1.0)
		end)
	end

	-- 유저 지정: 좌우 실제 몬스터가 둘 다 있어 중앙에서 충돌하는 경우 — 각자 캐스트+넉백은 그대로
	-- 개별 재생하되, 폭발은 두 착지 지점의 평균 위치에서 딱 1번만, 1.7배 크기(연출+판정 반경 모두)로
	-- 터뜨린다("범위 타격 연출이 1개만 뜨고 지금의 크기 1.7배, 범위도 1.7배").
	@ExecSpace("ServerOnly")
	method void FireMuspelheimShovePaired(Entity map, MonsterAI a, MonsterAI b, number destX, number damage, boolean isCrit)
		local landedPositions = {}
		local onLand = function(stopPos)
			table.insert(landedPositions, stopPos)
			if #landedPositions >= 2 then
				local p1 = landedPositions[1]
				local p2 = landedPositions[2]
				local mergedPos = Vector3((p1.x + p2.x) / 2, (p1.y + p2.y) / 2, p1.z)
				self:ResolveMuspelheimExplosion(map, mergedPos, damage, isCrit, self.Card175MergedExplosionMultiplier)
			end
		end
		self:LaunchMuspelheimKnockback(a, destX, onLand)
		self:LaunchMuspelheimKnockback(b, destX, onLand)
	end

	-- 폭발 연출 재생 + 반경 안의 모든 몬스터(넉백된 본인 포함)에게 기준값의 100% 대미지(유저 지정:
	-- "범위 타격 100%"). 연출은 항상 재생, 판정도 stopPos 고정 좌표 기준. sizeMultiplier는 연출
	-- 스케일과 판정 반경에 동일하게 곱해진다(1.0=기본, 1.7=병합 폭발).
	@ExecSpace("ServerOnly")
	method void ResolveMuspelheimExplosion(Entity map, Vector3 stopPos, number damage, boolean isCrit, number sizeMultiplier)
		local fxPos = Vector3(stopPos.x, stopPos.y + self.Card175EffectYOffset, stopPos.z)
		local fx = self:SpawnEffectWithModel(self.Card175ExplosionRUID, fxPos, 0, 1.0, self.Card175ExplosionScale * sizeMultiplier, 1.0, "skilleffectlong")
		if fx ~= nil then fx:Destroy(self.Card175ExplosionLifetime) end
		local explosionRadius = self.Card175ExplosionRadius * sizeMultiplier

		local monsters = self:GetMonstersInCurrentZone(map)
		local hitCount = 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local mp = m.Entity.TransformComponent.Position
				local dx = mp.x - stopPos.x
				local dy = mp.y - stopPos.y
				if (dx * dx + dy * dy) <= (explosionRadius * explosionRadius) then
					hitCount = hitCount + 1
					if isCrit then m:TakeDamageCrit(damage * 2)
					else m:TakeDamage(damage) end
				end
			end
		end
		log("MuspelheimExplosion: hit=" .. hitCount .. " dmg=" .. math.floor(isCrit and damage * 2 or damage))
	end

	@ExecSpace("Multicast")
	method void PlayMuspelheimSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.Card175SoundRUID, 1.0)
	end

	-- ── 쉐이드 전용: 스틸 (카드176, 슬롯형 액티브 5호). GetClosestTargets로 뽑힌 타겟마다 대미지 +
	-- 드랍 3종을 동시에 굴린다: ① 메소(돈다발, 100% 고정) — 몬스터의 사망시 드랍과 별개 시스템으로,
	-- 5초 동안 바닥에 머물다(유저 지정: "메소 익스플로젼"이 아직 없어서 지금은 그냥) 인벤(골드)으로
	-- 들어간다. ② 잡템(Card176ItemDropChance=50%, 유저 지정 표) — 그 몬스터의 실제 사망 드롭템과
	-- 동일한 걸(GameManager.GetMonsterLootItemId) 그대로 지급, LootItemDropChance(35%, 사망시 확률)와는
	-- 별개의 스틸 전용 확률을 쓴다. ③ 장비(GameManager.WeaponDropChance) — 사망 시와 완전히 동일한
	-- 기존 시스템을 그대로, 독립적으로 호출한다("장비 확률을 따름"). 몬스터가 죽지 않아도 셋 다
	-- 발동하고(유저 지정), 비행형/공중부양 중인 타겟도 사망시 드랍과 동일하게 바닥까지 낙하한다
	-- (MonsterAI.GetLootDropFallParams 재사용). 잡템이 실제로 터질 때만 몬스터 머리 위에 느낌표(당황
	-- 표현, 유저 제공 리소스)를 띄운다.
	@Sync property integer StealLevel = 0
	property number Card176Cooldown = 6.0  -- 레벨 무관 고정(유저 표)
	property string Card176IconRUID = "0cdc58f4336044e58e07afcd112727d0"
	property string Card176CastRUID = "bc8884dc5797493794bfbfa2ffe28965"  -- 스킬 연출(유저 제공)
	property string Card176ExclaimRUID = "6c1797e07dda41d9b5ea478fc59dba4b"  -- 잡템 드랍 시 머리 위 느낌표(당황)
	property string Card176SoundRUID = "67a4c7d9f9b740ecafada0c5e9a96dec"
	-- 유저 지정(2026-08-12): "스틸 연출크기 20%만 줄여주고" — 기존 1.5배에서 20% 축소(1.5*0.8=1.2)
	property number Card176EffectScale = 1.2
	-- 유저 지정: 0.3 내림(신규 스킬 기본 보정값 +0.3을 상쇄)
	property number Card176EffectYOffset = 0.0
	-- 실측 전 보수적 추정치(루프 방지 우선) — 피드백 받아 조정
	property number Card176CastLifetime = 0.5
	property number Card176ExclaimYOffset = 0.9  -- 스턴 스타 인디케이터와 동일한 머리 위 오프셋 관례
	property number Card176ExclaimLifetime = 0.6
	-- 유저 지정 표: 잡템 드랍 확률 50%(레벨 무관 고정) — 장비는 GameManager.WeaponDropChance를 그대로 별도 판정
	property number Card176ItemDropChance = 0.5
	-- 유저 지정: 어두운 배경에서 캐스트 연출이 검게 묻혀 안 보여서, 노란색 은은한 아웃라인을 둘러
	-- 가시성을 높인다. EliteOutline.material과 같은 Outline 셰이더를 재사용(이미 이 프로젝트에서
	-- 검증된 셰이더/프로퍼티)하되, 더 옅고 얇게(Thickness/Alpha↓) 잡아 "은은한 빛" 느낌만 낸다.
	property string Card176CastGlowMaterialId = "75a11168-cf7e-4d53-8b54-3bf882df30af"  -- RootDesk/MyDesk/Materials/StealCastGlow.material
	-- 표에 별도 메소 수량이 없어 킬 보상(GameManager.GoldPerKill)과 동일한 기본값 사용 — 조정 가능
	property integer Card176MesoAmount = 5
	-- 유저 지정(2026-08-14): "메소가 너무 과하게 나오는 거 같은 케이스가 있으니 스틸이랑 아주르 엣지
	-- 메소 드랍 확률 60%로" — 플레이어 본인이 직접 쓴 스틸/아주르 엣지의 메소 드랍 확률(TriggerStealDrop
	-- 참고). 쉐도우 파트너 대리 실행 시의 20%는 별도로 그대로 유지.
	property number Card176MesoDropChance = 0.6
	-- (구) Card176ItemSlotIconRUID는 제거됨 — 실제로는 메소 계열 아이콘이라 잡템인데 코인처럼 보이는
	-- 버그의 원인이었다. 이제 잡템은 GrantLootItemDrop으로 실제 아이템 고유 아이콘을 그대로 쓴다.

	method number GetStealDamage(integer level)
		if level >= 5 then return 200
		elseif level >= 4 then return 160
		elseif level >= 3 then return 140
		elseif level >= 2 then return 120
		end
		return 100
	end

	-- 타겟 수 — Lv1~2:2명 / Lv3~4:3명 / Lv5:4명 (유저 지정 표)
	method integer GetStealTargetCount(integer level)
		if level >= 5 then return 4 end
		if level >= 3 then return 3 end
		return 2
	end

	@ExecSpace("ServerOnly")
	method void StealAttack(number damage, boolean isCrit, table forcedTargets)
		-- 유저 지정(2026-08-13): 쉐도우 파트너 전용 forcedTargets(파트너가 서 있는 몬스터 1명 고정) —
		-- 스틸이 레벨에 따라 2~4명을 때리더라도 파트너 대신 실행일 땐 그 1명만.
		local targets = forcedTargets
		if targets == nil then
			targets = self:GetClosestTargets(self:GetStealTargetCount(self.StealLevel))
		end
		-- 버그 수정(2026-08-12) — DoubleStepAttack과 동일한 이유/패턴.
		if #targets == 0 then
			if self._shadowPartnerCopyActive and isvalid(self._shadowPartnerFallbackTarget) then
				targets = { self._shadowPartnerFallbackTarget }
			else
				return
			end
		end

		self:PlayStealSound()

		for _, target in ipairs(targets) do
			if isvalid(target) and isvalid(target.Entity) then
				local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
				local capturedPos = Vector3(p.x, p.y + self.Card176EffectYOffset, p.z - 0.1)
				local scaleRatio = self:GetEffectScaleRatio(target)

				local fx = self:SpawnEffectWithModel(self.Card176CastRUID, capturedPos, 0, 1.0, self.Card176EffectScale * scaleRatio, 1.0, "skilleffectlong")
				if fx ~= nil then
					if fx.SpriteRendererComponent ~= nil then
						fx.SpriteRendererComponent:ChangeMaterial(self.Card176CastGlowMaterialId)
					end
					fx:Destroy(self.Card176CastLifetime)
				end

				if isCrit then target:TakeDamageCrit(damage * 2)
				else target:TakeDamage(damage) end

				self:TriggerStealDrop(target)
			end
		end

		log("StealAttack: targets=" .. #targets)
	end

	-- 유저 정정: 메소(100%)는 독립이지만, "아이템" 쪽은 중첩 확률이다 — 먼저 Card176ItemDropChance(50%)로
	-- "뭐라도 하나 뜨는지"를 판정하고, 그 안에서 GameManager.WeaponDropChance(0.05%) 비율 그대로 장비/잡템을
	-- 나눈다(= 아이템이 뜬 그 50% 중 99.95%는 잡템, 0.05%는 장비). target이 이 시점에 죽어있어도(다른
	-- 스킬과 동시에 맞아 방금 죽었어도) 사망 위치 자체는 여전히 유효하므로 그대로 진행한다 — _dead
	-- 체크 없음(유저 지정: "적이 안죽어도 드롭된다"의 반대쪽 경우도 막을 이유가 없음).
	@ExecSpace("ServerOnly")
	method void TriggerStealDrop(MonsterAI target)
		if not isvalid(target) or not isvalid(target.Entity) then return end
		local worldPos = target.Entity.TransformComponent.WorldPosition
		local fallParams = target:GetLootDropFallParams()

		-- 유저 지정(2026-08-12: "메소 드랍확률만 50%" → 같은 날 "코인 드랍 확률 20%로 바꾸고(쉐도우
		-- 얘기하는거다)"로 재조정, 2026-08-14: "메소가 너무 과하게 나오는 거 같은 케이스가 있으니 스틸이랑
		-- 아주르 엣지 메소 드랍 확률 60%로" — 플레이어 본인이 직접 쓴 스틸/아주르 엣지는 100%→60%로,
		-- 쉐도우 파트너가 대신 실행한 경우(self._shadowPartnerCopyActive)는 그대로 20%.
		local mesoDropChance = self._shadowPartnerCopyActive and 0.2 or self.Card176MesoDropChance
		if _UtilLogic:RandomDouble() < mesoDropChance then
			_GameManager:ScheduleMesoDrop(worldPos, fallParams.fallHeight, fallParams.groundWorldY, self.Card176MesoAmount, fallParams.dropScale)
		end

		if _UtilLogic:RandomDouble() < self.Card176ItemDropChance then
			if _UtilLogic:RandomDouble() < _GameManager.WeaponDropChance then
				_GameManager:GrantWeaponItemDrop(worldPos, fallParams.fallHeight, fallParams.groundWorldY, fallParams.dropScale)
			else
				local itemId = _GameManager:GetMonsterLootItemId(target._spawnZoneIndex, target._speciesIdx)
				if itemId ~= "" then
					-- 버그 수정(2026-08-12): Card176ItemSlotIconRUID로 받았던 RUID가 실제로는 "금색
					-- 메소/동전" 계열 아이콘이라, 잡템 드랍인데도 코인처럼 보여서 진짜 메소랑 헷갈리는
					-- 원인이었다(유저 실측: "몹 2마리인데 코인 3개" — 메소 1개 + 코인모양 잡템 1개가
					-- 한 몬스터에서 같이 뜬 것). 실제 아이템 고유 아이콘 그대로 쓰도록 되돌림.
					_GameManager:GrantLootItemDrop(worldPos, fallParams.fallHeight, fallParams.groundWorldY, itemId, fallParams.dropScale)
				end
			end
			self:PlayStealExclaim(target)
		end
	end

	-- 유저 지정: 잡템 드랍이 실제로 터질 때 몬스터 머리 위에 느낌표(당황 표현)를 잠깐 띄운다.
	@ExecSpace("ServerOnly")
	method void PlayStealExclaim(MonsterAI target)
		if not isvalid(target) or not isvalid(target.Entity) then return end
		local p = target.Entity.TransformComponent.Position
		local scaleRatio = self:GetEffectScaleRatio(target)
		local fx = self:SpawnEffect(self.Card176ExclaimRUID, Vector3(p.x, p.y + self.Card176ExclaimYOffset, p.z - 0.1), 0, 1.0, scaleRatio, 1.0)
		if fx ~= nil then fx:Destroy(self.Card176ExclaimLifetime) end
	end

	@ExecSpace("Multicast")
	method void PlayStealSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.Card176SoundRUID, 1.0)
	end

	-- ── 쉐이드 조합 스킬: 아주르 엣지 (카드188) — 무스펠하임(175) Lv5 + 스틸(176) Lv5(둘 다 슬롯형
	-- 액티브) 보유 시 등장. 더블 커터/브레이브 슬래시와 동일한 "액티브 2개 병합" 패턴 — 무스펠하임
	-- 슬롯을 그대로 넘겨받고 스틸 슬롯은 비운다. 무스펠하임의 좌/우 탐색+넉백+범위폭발 메커니즘을 그대로
	-- 재사용하되(캐스트/폭발 연출·반경·병합배율 등 Card175 프로퍼티 재사용), 폭발 대미지 비율을
	-- 100%→110/120/130%로 올리고, 착지(충돌) 시 스틸의 드랍(메소100%+아이템50%, TriggerStealDrop 그대로
	-- 재사용)을 함께 터뜨린다. 신규 연출: 강화 보조연출(effect0, Card175Cast2 자리를 대체), 발사 직후
	-- 붙는 추진 프레임(hit/0의 4~5), 날아가는 동안 몬스터에 업히는 라이드 연출, 충돌 시 스틸 플래시.
	@Sync property integer AzureEdgeLevel = 0
	property number Card188Cooldown = 4.5  -- 레벨 무관 고정(유저 표)
	property string Card188IconRUID = "3beb3be542084574b48da2da0e7fde46"

	-- 리소스팩 "무스펠 하임 강화" — 신규 요소만(캐스트/폭발 연출은 무스펠하임 Card175* 그대로 재사용)
	property string AzureEdgeUseSoundRUID = "638873b2bce949febbbf41cfb5e1347a"  -- audio/Use(스킬 발동)
	property string AzureEdgeHitSoundRUID = "47437cd74d964d7488c2ddc30b551756"  -- audio/Hit(폭발 순간)
	property string AzureEdgeEnhanceCastRUID = "7983a42382984638aeba75e285f08894"  -- effect0("강화" 보조 연출, Card175Cast2RUID 대체)
	property string AzureEdgePropulsionRUID4 = "436c337c6da14cd79edbcc7c936eda64"  -- hit/0/4
	property string AzureEdgePropulsionRUID5 = "fd2a19a211e044a6b51facd133265d3a"  -- hit/0/5
	property string AzureEdgeRideRUID = "29ab2868e672445b8af3659f9fe31d93"  -- 날아가는 몬스터한테 업히는 연출(유저 제공)
	property string AzureEdgeStealFlashRUID = "f713b8efdada4fd2ab5235331d510a7d"  -- 충돌 시 훔치는 연출(유저 제공)

	property number AzureEdgeEnhanceCastLifetime = 0.5  -- 실측 전 추정치(Card175Cast2Lifetime과 동일값)
	property number AzureEdgePropulsionFrameDuration = 0.08  -- 실측 전 추정치 — 프레임 4→5 전환 간격
	property number AzureEdgePropulsionScale = 0.9  -- 실측 전 추정치
	-- 유저 지정: "살짝 몬스터보다 겹치긴 하는데 윗쪽에 업힌 것처럼" — 몬스터 위치보다 살짝 위, z도
	-- 살짝 당겨서 몬스터 스프라이트 위에 그려지게 한다.
	property number AzureEdgeRideYOffset = 0.5
	property number AzureEdgeRideZOffset = 0.15
	property number AzureEdgeRideUpdateInterval = 0.05  -- 라이드 연출이 몬스터 위치를 따라가는 갱신 주기
	property number AzureEdgeStealFlashLifetime = 0.4  -- 실측 전 추정치

	-- 유저 표: "넉백 2개 충돌시 범위 타격 증가" — 무스펠하임과 동일 배율(1.7배)
	property number AzureEdgeMergedExplosionMultiplier = 1.7

	method number GetAzureEdgeDamage(integer level)
		if level >= 3 then return 360
		elseif level >= 2 then return 340
		end
		return 320
	end

	-- 범위 폭발 비율 — 110/120/130% (유저 표, 무스펠하임의 고정 100%를 대체)
	method number GetAzureEdgeExplosionPercent(integer level)
		if level >= 3 then return 1.30
		elseif level >= 2 then return 1.20
		end
		return 1.10
	end

	-- 자체 크리티컬 확률 보너스 — 30/35/40% (유저 표, 무스펠하임의 GetMuspelheimCritChance와 동일 훅)
	method number GetAzureEdgeCritChance(integer level)
		if level >= 3 then return 0.40
		elseif level >= 2 then return 0.35
		end
		return 0.30
	end

	-- 무스펠하임과 동일한 좌/우 최외곽 탐색 + 중앙근방 예외 로직(항상 2명 병렬 넉백 — 유저 표
	-- "타겟 수 2" 고정, 무스펠하임 Lv3~5의 targetCount>=2 분기와 동일).
	@ExecSpace("ServerOnly")
	method void AzureEdgeAttack(number damage, boolean isCrit)
		local map = self:GetCurrentMap()
		if map == nil then return end
		local monsters = self:GetMonstersInCurrentZone(map)
		local centerX = self:GetZoneCenterX()

		local leftExtreme, rightExtreme = nil, nil
		local centerCluster = {}
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local x = m.Entity.TransformComponent.Position.x
				if x < centerX - self.Card175CenterRadius and (leftExtreme == nil or x < leftExtreme.Entity.TransformComponent.Position.x) then
					leftExtreme = m
				elseif x > centerX + self.Card175CenterRadius and (rightExtreme == nil or x > rightExtreme.Entity.TransformComponent.Position.x) then
					rightExtreme = m
				elseif x >= centerX - self.Card175CenterRadius and x <= centerX + self.Card175CenterRadius then
					table.insert(centerCluster, m)
				end
			end
		end
		if leftExtreme == nil and rightExtreme == nil and #centerCluster == 0 then return end

		self:PlayAzureEdgeUseSound()

		if leftExtreme ~= nil and rightExtreme ~= nil then
			self:FireAzureEdgeShovePaired(map, monsters, leftExtreme, rightExtreme, centerX, damage, isCrit)
		else
			if leftExtreme ~= nil then
				self:FireAzureEdgeShove(map, monsters, leftExtreme, centerX, damage, isCrit)
			elseif #centerCluster > 0 then
				local pick = centerCluster[_UtilLogic:RandomIntegerRange(1, #centerCluster)]
				self:FireAzureEdgeShove(map, monsters, pick, centerX - self.Card175OutwardOvershoot, damage, isCrit)
			end
			if rightExtreme ~= nil then
				self:FireAzureEdgeShove(map, monsters, rightExtreme, centerX, damage, isCrit)
			elseif #centerCluster > 0 then
				local pick = centerCluster[_UtilLogic:RandomIntegerRange(1, #centerCluster)]
				self:FireAzureEdgeShove(map, monsters, pick, centerX + self.Card175OutwardOvershoot, damage, isCrit)
			end
		end
	end

	-- 캐스트(+강화 보조연출+추진 프레임) 재생 → 넉백 시작(라이드 연출 부착) → 착지 시 onLanded(stopPos).
	-- 무스펠하임의 LaunchMuspelheimKnockback과 동일 골격 + 신규 연출만 추가.
	-- 유저 지정(2026-08-14): 넉백당한 primary가 중앙까지 날아가는 경로에 다른 몬스터가 서 있으면, 그
	-- 몬스터도 스틸(TriggerStealDrop)이 굴러가야 한다 — 지금까지는 착지한 primary(들)에게만 적용됐다.
	-- 플레시 미라주의 "경로상 충돌" 판정(FireFleshMirageShove 참고: 같은 뎁스 밴드 + primaryX~destX
	-- 사이에 있는 몬스터, 거리 비례 지연으로 타이밍 맞춤)을 그대로 재사용하되, 대미지는 추가하지 않는다
	-- (아주르 엣지는 원래 "경로상 충돌 대미지 없음"이 설계 의도라 그건 유지 — 유저 요청은 스틸만).
	@ExecSpace("ServerOnly")
	method void LaunchAzureEdgeKnockback(table monsters, MonsterAI primary, number destX, any onLanded)
		if not isvalid(primary) or not isvalid(primary.Entity) or not isvalid(primary.Entity.TransformComponent) then return end
		destX = self:ClampKnockbackDestX(primary, destX)
		local pp = primary.Entity.TransformComponent.Position
		local scaleRatio = self:GetEffectScaleRatio(primary)
		-- 무스펠하임과 동일한 반전 기준(FlipX=false가 오른쪽 방향) — 왼쪽으로 보낼 때만 반전
		local dirRight = destX > pp.x
		local flipped = not dirRight
		local thrustSign = dirRight and 1 or -1
		local castOrigin = Vector3(pp.x, pp.y + self.Card175EffectYOffset, pp.z)

		local castFx = self:SpawnEffectWithModel(self.Card175CastRUID, castOrigin, 0, 1.0, self.Card175CastScale * scaleRatio, 1.0, "skilleffectlong")
		if castFx ~= nil then
			castFx:Destroy(self.Card175CastLifetime)
			local castR = castFx.SpriteRendererComponent
			if castR ~= nil then castR.FlipX = not flipped end
			_TweenLogic:PlayTween(0.0, self.Card175ThrustDistance, self.Card175ThrustDuration, EaseType.QuadEaseOut, function(t)
				if not isvalid(castFx) then return end
				castFx.TransformComponent.Position = Vector3(castOrigin.x + thrustSign * t, castOrigin.y, castOrigin.z)
			end)
		end

		-- 유저 지정: "effect 다음 연출이 강화 연출이거든 그거 쓰면된다" — 보조 연출을 effect0로
		-- 교체(원본 무스펠하임의 Card175Cast2 자리를 대신 차지, 위치/반전 로직은 동일)
		local cast2Pos = Vector3(castOrigin.x - thrustSign * self.Card175Cast2OffsetX, castOrigin.y, castOrigin.z)
		local cast2Fx = self:SpawnEffectWithModel(self.AzureEdgeEnhanceCastRUID, cast2Pos, 0, 1.0, self.Card175Cast2Scale * scaleRatio, 1.0, "skilleffectlong")
		if cast2Fx ~= nil then
			cast2Fx:Destroy(self.AzureEdgeEnhanceCastLifetime)
			local cast2R = cast2Fx.SpriteRendererComponent
			if cast2R ~= nil then cast2R.FlipX = flipped end
		end

		-- 유저 지정: "히트 연출에서 4~5는 스킬 나갈때 뒤에 붙여추면되 추진력같은 느낌" — 발사 지점에
		-- 정지-프레임 수동 스왑으로 두 프레임(4→5)을 짧게 이어붙여 추진 꼬리처럼 보이게 한다.
		local propulsionFx = self:SpawnEffect(self.AzureEdgePropulsionRUID4, castOrigin, 0, 1.0, self.AzureEdgePropulsionScale * scaleRatio, 1.0)
		if propulsionFx ~= nil then
			local propR = propulsionFx.SpriteRendererComponent
			if propR ~= nil then propR.FlipX = not flipped end
			_TimerService:SetTimerOnce(function()
				if isvalid(propulsionFx) and isvalid(propR) then propR.SpriteRUID = self.AzureEdgePropulsionRUID5 end
			end, self.AzureEdgePropulsionFrameDuration)
			propulsionFx:Destroy(self.AzureEdgePropulsionFrameDuration * 2)
		end

		-- 넉백이 멈추는 자리(stopPos) — 캐스트 시점에 미리 고정(다른 스킬과 동일한 정책)
		local stopPos = Vector3(destX, pp.y, pp.z)
		-- 버그 수정(2026-08-26, 유저 지적: "화면 넘어갔는데 이펙트가 다음 존에 존재") — 캐스트 시점
		-- 존 인덱스를 캡처해, 라이드 연출/착지 폭발이 다른 존에 잘못 나타나지 않게 한다.
		local castZoneIndex = primary._spawnZoneIndex

		-- 버그 수정(2026-08-26, 유저 지적: "연출 끊기는거 같은데") — primary가 KnockbackStartDelay
		-- 도중 죽으면 이 블록 전체(라이드 연출, 경로 스틸, 그리고 가장 치명적으로 onLanded=착지 폭발
		-- 예약까지)가 통째로 스킵됐다. primary 관련 로직(넉백 이동)만 따로 생사 체크하고, 나머지(경로
		-- 스틸/라이드 연출/onLanded 예약)는 primary 생사와 무관하게 항상 진행한다 — primary.Entity
		-- 자체는 죽어도(파괴되지 않는 한) 유효하므로 위치는 계속 읽을 수 있다.
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(primary) or not isvalid(primary.Entity) then return end
			local primaryX = primary.Entity.TransformComponent.Position.x
			if not primary._dead then
				primary:ApplyLateralShove(destX, self.Card175KnockbackDuration)
			end

			-- 경로상 충돌 스틸 — primaryX~destX 사이(같은 뎁스 밴드)에 있는 다른 몬스터에게, primary가
			-- 실제로 그 몬스터의 X를 지나가는 시점(거리 비례 지연)에 맞춰 TriggerStealDrop만 적용한다
			-- (대미지는 없음 — FireFleshMirageShove의 충돌 판정과 동일한 틀, 목적만 스틸로 교체).
			local totalDist = math.abs(destX - primaryX)
			if monsters ~= nil and totalDist > 0 then
				local travelRight = destX > primaryX
				for _, mob in ipairs(monsters) do
					---@type MonsterAI
					local m = mob
					if isvalid(m) and m ~= primary and not m._dead and isvalid(m.Entity) and self:IsSameDepthBand(primary, m) then
						local mx = m.Entity.TransformComponent.Position.x
						local inPath = (travelRight and mx >= primaryX and mx <= destX)
							or ((not travelRight) and mx <= primaryX and mx >= destX)
						if inPath then
							local hitDelay = self.Card175KnockbackDuration * (math.abs(mx - primaryX) / totalDist)
							_TimerService:SetTimerOnce(function()
								if not isvalid(self) or not isvalid(m) or m._dead or not isvalid(m.Entity) then return end
								self:TriggerStealDrop(m)
								log("AzureEdgePathSteal: passed monster at x=" .. string.format("%.2f", mx))
							end, hitDelay)
						end
					end
				end
			end

			-- 유저 지정: "날아가는(넉백되는) 몬스터한테 붙이고 살짝 겹치긴 하는데 윗쪽에 업힌 것처럼" —
			-- 넉백 이동 내내 몬스터 위치를 따라가는 라이드 연출. 존이 이미 넘어갔으면 아예 스폰하지 않는다.
			local rideFx = nil
			if castZoneIndex == _MapManager.CurrentMapIndex then
				rideFx = self:SpawnEffect(self.AzureEdgeRideRUID, Vector3(pp.x, pp.y + self.AzureEdgeRideYOffset, pp.z - self.AzureEdgeRideZOffset), 0, 1.0, scaleRatio, 1.0)
			end
			local rideTickId = 0
			if rideFx ~= nil then
				rideTickId = _TimerService:SetTimerRepeat(function()
					if not isvalid(self) or not isvalid(rideFx) or not isvalid(primary) or not isvalid(primary.Entity) then
						if rideTickId ~= 0 then _TimerService:ClearTimer(rideTickId) end
						return
					end
					local cp = primary.Entity.TransformComponent.Position
					rideFx.TransformComponent.Position = Vector3(cp.x, cp.y + self.AzureEdgeRideYOffset, cp.z - self.AzureEdgeRideZOffset)
				end, self.AzureEdgeRideUpdateInterval)
			end

			-- onLanded(착지 폭발+스틸드랍)는 primary 생사와 무관하게 항상 예약 — stopPos가 캐스트
			-- 시점에 이미 고정 좌표로 캡처돼 있어 primary가 그 사이 죽거나 파괴돼도 안전하다.
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				if rideTickId ~= 0 then _TimerService:ClearTimer(rideTickId) end
				if isvalid(rideFx) then rideFx:Destroy() end
				if onLanded ~= nil then onLanded(stopPos, castZoneIndex) end
			end, self.Card175KnockbackDuration)
		end, self.Card175KnockbackStartDelay)
	end

	-- 단일 타겟용 — 넉백이 끝나면 그 자리에서 기본 크기(1.0배)로 폭발 + 스틸 드랍(그 몬스터에게만).
	@ExecSpace("ServerOnly")
	method void FireAzureEdgeShove(Entity map, table monsters, MonsterAI primary, number destX, number damage, boolean isCrit)
		self:LaunchAzureEdgeKnockback(monsters, primary, destX, function(stopPos, castZoneIndex)
			self:ResolveAzureEdgeExplosion(map, stopPos, damage, isCrit, 1.0, { primary }, castZoneIndex)
		end)
	end

	-- 좌우 실제 몬스터가 둘 다 있어 중앙에서 충돌하는 경우 — 무스펠하임과 동일하게 폭발은 평균 위치에서
	-- 1.7배로 1번만, 스틸 드랍은 충돌한 두 몬스터 모두에게 각각 적용.
	@ExecSpace("ServerOnly")
	method void FireAzureEdgeShovePaired(Entity map, table monsters, MonsterAI a, MonsterAI b, number destX, number damage, boolean isCrit)
		local landedPositions = {}
		local onLand = function(stopPos, castZoneIndex)
			table.insert(landedPositions, stopPos)
			if #landedPositions >= 2 then
				local p1 = landedPositions[1]
				local p2 = landedPositions[2]
				local mergedPos = Vector3((p1.x + p2.x) / 2, (p1.y + p2.y) / 2, p1.z)
				self:ResolveAzureEdgeExplosion(map, mergedPos, damage, isCrit, self.AzureEdgeMergedExplosionMultiplier, { a, b }, castZoneIndex)
			end
		end
		self:LaunchAzureEdgeKnockback(monsters, a, destX, onLand)
		self:LaunchAzureEdgeKnockback(monsters, b, destX, onLand)
	end

	-- 폭발 연출(+스틸 플래시) 재생 + 반경 안의 모든 몬스터에게 기준값의 110/120/130% 대미지, 그리고
	-- 넉백되어 충돌(착지)한 몬스터에게만 스틸의 드랍(메소100%+아이템50%, TriggerStealDrop 재사용)을 적용.
	@ExecSpace("ServerOnly")
	method void ResolveAzureEdgeExplosion(Entity map, Vector3 stopPos, number damage, boolean isCrit, number sizeMultiplier, table stealTargets, integer castZoneIndex)
		local fxPos = Vector3(stopPos.x, stopPos.y + self.Card175EffectYOffset, stopPos.z)
		-- 버그 수정(2026-08-26, 유저 지적: "화면 넘어갔는데 이펙트가 다음 존에 존재") — 캐스트 시점과
		-- 현재 존이 다르면 폭발/스틸 플래시 연출을 스폰하지 않는다(대미지 판정은 그대로 유지).
		if castZoneIndex == _MapManager.CurrentMapIndex then
			local fx = self:SpawnEffectWithModel(self.Card175ExplosionRUID, fxPos, 0, 1.0, self.Card175ExplosionScale * sizeMultiplier, 1.0, "skilleffectlong")
			if fx ~= nil then fx:Destroy(self.Card175ExplosionLifetime) end

			-- 유저 지정: "몬스터랑 부딪히면 이 연출, 훔치는 연출" — 폭발과 같이 스틸 플래시도 터진다.
			local stealFx = self:SpawnEffect(self.AzureEdgeStealFlashRUID, fxPos, 0, 1.0, sizeMultiplier, 1.0)
			if stealFx ~= nil then stealFx:Destroy(self.AzureEdgeStealFlashLifetime) end
		end
		self:PlayAzureEdgeHitSound()

		local explosionRadius = self.Card175ExplosionRadius * sizeMultiplier
		local explosionDamage = damage * self:GetAzureEdgeExplosionPercent(self.AzureEdgeLevel)

		local monsters = self:GetMonstersInCurrentZone(map)
		local hitCount = 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local mp = m.Entity.TransformComponent.Position
				local dx = mp.x - stopPos.x
				local dy = mp.y - stopPos.y
				if (dx * dx + dy * dy) <= (explosionRadius * explosionRadius) then
					hitCount = hitCount + 1
					if isCrit then m:TakeDamageCrit(explosionDamage * 2)
					else m:TakeDamage(explosionDamage) end
				end
			end
		end

		if stealTargets ~= nil then
			for _, t in ipairs(stealTargets) do
				if isvalid(t) then self:TriggerStealDrop(t) end
			end
		end

		log("AzureEdgeExplosion: hit=" .. hitCount .. " dmg=" .. math.floor(isCrit and explosionDamage * 2 or explosionDamage))
	end

	@ExecSpace("Multicast")
	method void PlayAzureEdgeUseSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.AzureEdgeUseSoundRUID, 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayAzureEdgeHitSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.AzureEdgeHitSoundRUID, 1.0)
	end

	-- ── 쉐이드 전용: 메소 익스플로젼 (카드177, 슬롯형 액티브 6호). 스틸이 떨어뜨린 메소(GameManager의
	-- 서버측 _activeMesoDrops 목록) 중 "착지 완료" 상태인 것은 전부(개수 제한 없음, 유저 지정: "폭발은
	-- 메소 폭발 가능한거 다 터지는거") 한꺼번에 터뜨린다. 필드에 그런 메소가 하나도 없으면 이번 틱은
	-- 그냥 아무 효과 없이 지나간다(유저 지정: "메소없으면 스킬 대기"). 터뜨린 자리마다 범위 폭발
	-- 대미지(몬스터 생사 여부만 판정, 몬스터가 있어야만 대미지가 들어감) + 그 메소의 골드를 즉시
	-- 지급하고, 걸려있던 자동회수(5초) 타이머는 GameManager.PopLandedMesoDrops가 대신 취소해준다.
	-- 유저 표의 1/1/2/2/2 컬럼("연출 범위")은 폭발 개수가 아니라 폭발 반경 티어 — Lv1~2는 기본
	-- 반경, Lv3~5는 확대된 반경(GetMesoExplosionRadiusMultiplier).
	@Sync property integer MesoExplosionLevel = 0
	property number Card177Cooldown = 7.0  -- 레벨 무관 고정(유저 표)
	property string Card177IconRUID = "0784bfbeea6545e3a1dbbbe2aebfa2b2"
	-- 리소스팩 "메소 익스플로젼"의 "effect" 애니메이션클립(11프레임, 최대 344x184px) — 작게 시작해
	-- 크게 부풀어오르는 형태라 폭발 연출로 사용. Scale/Radius는 실측 전 추정치(라이브 테스트 후 조정 예정)
	property string Card177ExplosionRUID = "61840689ea7b44f09f91960734232e34"
	-- 유저 지정(2026-08-12): 연출(effect0/effect 둘 다 이 값을 공유) 15% 축소 — 공격범위도 같은 비율로
	-- 같이 줄여서 "연출 크기 = 실제 판정 범위"를 유지한다.
	property number Card177ExplosionScale = 0.85
	-- 유저 지정(2026-08-12): 연출 좌표 — 처음엔 위로 0.2였다가 "아래로 0.1, 오른쪽으로 0.2" 추가
	-- 조정으로 최종 Y=0.1(0.2-0.1), X=0.2. effect0/effect 둘 다 이 값을 공유하므로 두 단계 연출이
	-- 같이 움직인다. 판정 범위(CenterYOffset/CenterXOffset)도 같은 양만큼 같이 옮겨서 "연출 크기 =
	-- 판정 범위" 원칙을 유지한다.
	property number Card177ExplosionXOffset = 0.2
	property number Card177ExplosionYOffset = 0.1
	property number Card177ExplosionLifetime = 0.7
	-- 유저 지적(2026-08-12): "폭파연출이 세로로 길잖아" — effect(61840689) 리소스는 피벗이 거의 바닥
	-- (실측 ny≈0.03)이라 착지점에서 위로만 크게 자라는 형태다. 원형 판정 대신 실측 프레임 크기
	-- (344x184px, pivot nx≈0.52/ny≈0.03, Card177ExplosionScale=0.85 반영, 무스펠하임 검증 px/유닛
	-- 비율 ~137 사용) 기반 타원 판정으로 실제 연출 모양에 맞춘다 — 판정 중심 자체를 착지점보다
	-- 위로 올리고(CenterYOffset), 가로/세로 반경을 따로 잡는다. (구) Card177ExplosionRadius는
	-- 더 이상 안 쓴다.
	property number Card177ExplosionHalfWidth = 1.05
	property number Card177ExplosionHalfHeight = 0.57
	-- 0.54(피벗 기준 실측치) + 0.1(유저 지정: 최종 Y오프셋 0.1) = 0.64. X는 연출과 동일하게 0.2.
	property number Card177ExplosionCenterYOffset = 0.64
	property number Card177ExplosionCenterXOffset = 0.2
	-- "audio/Hit" — 유저 지정: 대미지가 들어가는 순간(=2번째 연출 시작)에 맞춰 재생
	property string Card177SoundRUID = "acb0f70275b7422dbcc8a395cbbd9d28"
	-- 유저 지정(2026-08-12): 리소스팩 "effect0"(af4c894d...)의 4~18번 스프라이트 15장을 먼저 재생하고
	-- ("충전 후 사라지는" 연출), 그게 끝나기 Card177Effect2LeadTime초 전에 위 Card177ExplosionRUID("effect")가
	-- 겹쳐서 시작 — 대미지도 이 순간에 들어간다. effect0은 네이티브 애니메이션클립이 4프레임뿐이라
	-- (전체 15장 중 일부만 포함) 이 프로젝트 표준 "정지-프레임 수동 스왑" 기법(스피릿 블레이드
	-- PlaySpiritBladeThrust와 동일 패턴)으로 전부 직접 이어붙인다.
	property any Card177Effect0FrameRUIDs = {
		"731b0a9b3d06432da5f74d180855e787", -- effect0/4
		"23bb1b1b64e24a10946616c3d2b6f25a", -- effect0/5
		"e44c5d06ef634ae1bc5cf7dc10162d4f", -- effect0/6
		"3b0bad7f49b44abe8755f6ad80a93aeb", -- effect0/7
		"995f0f2448844abea9f27e1a0c219c92", -- effect0/8
		"334b77c7c93d46da9cb745d5fd6cbc1f", -- effect0/9
		"0307b18787ba4a4a88f64f8ff94fb827", -- effect0/10
		"065bdb57219e4facafbbc7add5b8f12a", -- effect0/11
		"9fdde052981d45a0b457fa748338b46b", -- effect0/12
		"5c813668381a43a2ad887a9aa6275d13", -- effect0/13
		"561cd098a12148fe9f1c34a1e9c5c8a2", -- effect0/14
		"063cf8a354304f8e88a004595172f630", -- effect0/15
		"87f86f9540f641838f91c62fd17833ab", -- effect0/16
		"512a83759ea24931b3d1fed0d3648336", -- effect0/17
		"46ffab4c7298447ea1c3540daa5e4df4", -- effect0/18
	}
	-- 유저 확정: 추천값(die 애니메이션과 동일한 10fps 추정치) 그대로 — 15프레임 * 0.1초 = 총 1.5초
	property number Card177Effect0FrameStepDuration = 0.1
	-- effect0이 끝나기 이만큼 전에 effect(폭발)+대미지가 겹쳐서 시작. 원래 0.3초였는데 유저 지정으로
	-- 0.6초 더 앞당김(0.3+0.6=0.9) — "폭발연출을 지금보다 0.6s 빠르게, 두 연출은 겹쳐도 됨"
	property number Card177Effect2LeadTime = 0.9
	-- 범위 안에서 실제로 맞은 몬스터마다 재생하는 히트 스파크 — 리소스팩의 hit/0~hit/8(9종) 중 무작위
	property number Card177HitEffectLifetime = 0.35
	property string Card177HitRUID0 = "644458b8c91949b4b4b84ff949eba8ca"
	property string Card177HitRUID1 = "01399ad0be5b416cb8e7b546ef198ee6"
	property string Card177HitRUID2 = "1f4f8390a4b84b1e971a0c4c5dc81a6a"
	property string Card177HitRUID3 = "5fc67eff43b347858b8792087abc132f"
	property string Card177HitRUID4 = "f1dd8ae11b3c4ba18ab81a195f9f6882"
	property string Card177HitRUID5 = "f6c771d1edb94d8eb75dd6ebbe2b4f5c"
	property string Card177HitRUID6 = "cb3643f3c74b446c93efd7f3dd4e2d56"
	property string Card177HitRUID7 = "22e843a7a31941829a6cd66752fbcf0e"
	property string Card177HitRUID8 = "28833d6cff7948958a50986e9c9a7b5d"

	method number GetMesoExplosionDamage(integer level)
		if level >= 5 then return 270
		elseif level >= 4 then return 240
		elseif level >= 3 then return 210
		elseif level >= 2 then return 180
		end
		return 150
	end

	-- 폭발 반경 배율("연출 범위" 컬럼) — Lv1~2:기본 / Lv3~5:확대 (유저 지정 표)
	method number GetMesoExplosionRadiusMultiplier(integer level)
		if level >= 3 then return 1.3 end
		return 1.0
	end

	method string GetRandomMesoExplosionHitRUID()
		local roll = _UtilLogic:RandomIntegerRange(0, 8)
		if roll == 0 then return self.Card177HitRUID0
		elseif roll == 1 then return self.Card177HitRUID1
		elseif roll == 2 then return self.Card177HitRUID2
		elseif roll == 3 then return self.Card177HitRUID3
		elseif roll == 4 then return self.Card177HitRUID4
		elseif roll == 5 then return self.Card177HitRUID5
		elseif roll == 6 then return self.Card177HitRUID6
		elseif roll == 7 then return self.Card177HitRUID7
		end
		return self.Card177HitRUID8
	end

	-- 반환값(boolean)은 "이번 틱에 실제로 터뜨렸는지" — false면 TickCard가 쿨타임을 채우지 않고
	-- 계속 대기 상태로 둔다(유저 지정: "메소가 없으면 스킬 쿨 돌지말고 대기상태로 있어야함").
	@ExecSpace("ServerOnly")
	method boolean MesoExplosionAttack(number damage, boolean isCrit)
		-- 유저 지정: "폭발은 메소 폭발 가능한거 다 터지는거" — 개수 제한 없이 착지 완료된 메소를 전부 꺼낸다.
		local drops = _GameManager:PopLandedMesoDrops(999999)
		if #drops == 0 then return false end

		local map = self:GetCurrentMap()
		local radiusMult = self:GetMesoExplosionRadiusMultiplier(self.MesoExplosionLevel)

		for _, drop in ipairs(drops) do
			_GameManager:AddGold(drop.amount)
			_GameManager:ClearMesoIconByDropId(drop.id)
			if map ~= nil then
				local localPos = self:WorldToCurrentMapLocal(drop.worldPos)
				self:ResolveMesoExplosion(map, localPos, damage, isCrit, radiusMult)
			end
		end
		return true
	end

	-- 1단계: effect0(15프레임 수동 스왑) 먼저 재생. 끝나기 Card177Effect2LeadTime초 전에 2단계(폭발
	-- 연출 + 대미지)를 예약한다 — 유저 지정 순서: "effect0 먼저 → 끝나기 0.3초전에 effect, 이때 대미지".
	@ExecSpace("ServerOnly")
	method void ResolveMesoExplosion(Entity map, Vector3 localPos, number damage, boolean isCrit, number radiusMult)
		self:PlayMesoExplosionCharge(localPos, radiusMult)

		local chargeDuration = #self.Card177Effect0FrameRUIDs * self.Card177Effect0FrameStepDuration
		local delay = math.max(0, chargeDuration - self.Card177Effect2LeadTime)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(map) then return end
			self:ResolveMesoExplosionImpact(map, localPos, damage, isCrit, radiusMult)
		end, delay)
	end

	-- effect0(af4c894d..., 4~18번 스프라이트 15장)를 "정지-프레임" 수동 스왑으로 이어붙여 재생 —
	-- 스피릿 블레이드 PlaySpiritBladeThrust와 동일한 기법(하나의 스프라이트시트가 아니라 서로 다른
	-- 개별 리소스를 스왑). 첫 프레임(effect0/4)으로 스폰한 뒤 나머지 14장을 순서대로 스왑한다.
	@ExecSpace("ServerOnly")
	method void PlayMesoExplosionCharge(Vector3 localPos, number radiusMult)
		local frames = self.Card177Effect0FrameRUIDs
		if #frames == 0 then return end
		local fxPos = Vector3(localPos.x + self.Card177ExplosionXOffset, localPos.y + self.Card177ExplosionYOffset, localPos.z - 0.1)
		local fx = self:SpawnEffectWithModel(frames[1], fxPos, 0, 1.0, self.Card177ExplosionScale * radiusMult, 1.0, "skilleffectlong")
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		for i = 2, #frames do
			local ruid = frames[i]
			_TimerService:SetTimerOnce(function()
				if not isvalid(fx) or not isvalid(renderer) then return end
				renderer.SpriteRUID = ruid
			end, (i - 1) * self.Card177Effect0FrameStepDuration)
		end
		local totalDuration = #frames * self.Card177Effect0FrameStepDuration
		fx:Destroy(totalDuration + 0.05)
	end

	-- 2단계: effect(폭발) 연출 + 실제 범위 대미지 적용 — effect0이 끝나기 직전(Card177Effect2LeadTime초
	-- 전)에 겹쳐서 시작한다(유저 지정: "이때 대미지 들어감").
	@ExecSpace("ServerOnly")
	method void ResolveMesoExplosionImpact(Entity map, Vector3 localPos, number damage, boolean isCrit, number radiusMult)
		self:PlayMesoExplosionSound()
		local fxPos = Vector3(localPos.x + self.Card177ExplosionXOffset, localPos.y + self.Card177ExplosionYOffset, localPos.z - 0.1)
		local fx = self:SpawnEffectWithModel(self.Card177ExplosionRUID, fxPos, 0, 1.0, self.Card177ExplosionScale * radiusMult, 1.0, "skilleffectlong")
		if fx ~= nil then fx:Destroy(self.Card177ExplosionLifetime) end

		-- 타원 판정(원형 대신) — 연출 실측 모양(세로로 긴 형태, 피벗이 바닥)에 맞춘다.
		local halfWidth = self.Card177ExplosionHalfWidth * radiusMult
		local halfHeight = self.Card177ExplosionHalfHeight * radiusMult
		local centerX = localPos.x + self.Card177ExplosionCenterXOffset * radiusMult
		local centerY = localPos.y + self.Card177ExplosionCenterYOffset * radiusMult

		local monsters = self:GetMonstersInCurrentZone(map)
		local hitCount = 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local mp = m.Entity.TransformComponent.Position
				local nx = (mp.x - centerX) / halfWidth
				local ny = (mp.y - centerY) / halfHeight
				if (nx * nx + ny * ny) <= 1.0 then
					hitCount = hitCount + 1
					local scaleRatio = self:GetEffectScaleRatio(m)
					local hitFx = self:SpawnEffect(self:GetRandomMesoExplosionHitRUID(), Vector3(mp.x, mp.y, mp.z - 0.1), 0, 1.0, scaleRatio, 1.0)
					if hitFx ~= nil then hitFx:Destroy(self.Card177HitEffectLifetime) end
					if isCrit then m:TakeDamageCrit(damage * 2)
					else m:TakeDamage(damage) end
				end
			end
		end
		log("MesoExplosion: hit=" .. hitCount .. " dmg=" .. math.floor(isCrit and damage * 2 or damage))
	end

	@ExecSpace("Multicast")
	method void PlayMesoExplosionSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.Card177SoundRUID, 1.0)
	end

	-- ── 쉐이드 조합 스킬: 메소 데토네이션 (카드189) — 메소 익스플로젼(177) Lv5 + 카르마(182) + 다크
	-- 사이트(184) + 피지컬 트레이닝(183, 셋 다 슬롯 없는 패시브) 보유 시 등장. 메소 익스플로젼의 "필드에
	-- 착지한 메소 전부 동시 폭발, 없으면 대기" 구조를 그대로 재사용하되, 신규 리소스팩("메소 익스플로젼
	-- VI")의 animationclip 3종(effect0=차지/effect=폭발/effect1=타격)을 네이티브 직접 재생(수동 프레임
	-- 스왑 대신 SpriteRUID에 animationclip RUID를 바로 지정)으로 교체하고, 몬스터 피격마다 스턴이 새로
	-- 추가된다(유저 표: 50/60/70%, 지속 1/1/2초). 기본 공격 메소 드랍 확률도 레벨식(최대 25%)을 벗어나
	-- 고정 30%로 오른다(GetMesoExplosionBasicAttackDropChance 참고). 메소 익스플로젼 슬롯을 그대로
	-- 넘겨받는다. 3레벨까지만 존재(다른 조합 스킬과 동일). 리소스팩에 전용 사운드가 없어 메소 익스플로젼과
	-- 동일한 사운드(Card177SoundRUID)를 재사용한다.
	@Sync property integer MesoDetonationLevel = 0
	property number Card189Cooldown = 7.0  -- 레벨 무관 고정(유저 표, 메소 익스플로젼과 동일)
	property string Card189IconRUID = "def5b9aea9dc4bd5b93940df791f0cec"

	-- "메소 익스플로젼 VI" 리소스팩 animationclip 직접 재생용 RUID
	property string Card189ChargeRUID = "538c9a0b06d44519a0d5c8d0e2e61e1f"     -- effect0(차지)
	property string Card189ExplosionRUID = "486883a76bae45e3b7c3d55a08265ea9" -- effect(폭발)
	property string Card189HitRUID = "3d510fa2fdbf4cdb9b106b83808e3d22"       -- effect1(타격)

	-- 연출 타이밍 — 실측(_ResourceService:LoadAnimationClipAndWait, effect0/effect/effect1 전부
	-- 19~12프레임/0.87초로 확인)보다 살짝 짧게 잡는다(루프 재시작 깜빡임 방지 컨벤션). 라이브 확인 후 조정 필요.
	property number Card189ChargeDuration = 0.82
	property number Card189ExplosionLifetime = 0.82
	property number Card189HitEffectLifetime = 0.82
	-- 차지가 끝나기 이 시간 전에 폭발+피해가 겹쳐 시작한다(메소 익스플로젼 Card177Effect2LeadTime과 동일 관례)
	property number Card189LeadTime = 0.15
	-- 유저 지적(라이브 확인, 2026-08-17): 폭발 연출이 자체적으로 2번 도는 것처럼 보인다("루프도는듯")
	-- — 루프를 억지로 억제하는 대신 그 자체를 메커니즘으로 채택, 폭발당 대미지를 50%/50%로 나눠 2번
	-- 적용한다(총 데미지는 동일). 연출 크기는 20%로 축소했다가, 유저가 "메소 익스플로젼이랑 범위·연출
	-- 크기 같으면 좋겠다"고 정정해서 1.0(메소 익스플로젼과 동일)으로 되돌림 — 판정 범위(Card189Explosion
	-- HalfWidth/HalfHeight)는 처음부터 메소 익스플로젼과 같은 값이라 이제 연출·판정 둘 다 일치한다.
	-- 유저 지정(2026-08-17): "너무 크다" — 메소 익스플로젼과 동일 크기(1.0)에서 다시 10% 축소.
	property number Card189EffectScale = 0.9
	property number Card189HitPercent = 0.5  -- 1/2타 동일 비율(유저 지정: 50%,50%)
	-- 폭발 연출이 자체적으로 한 번 더 도는 시점(추정치 — 실측 전, 라이브 확인 후 조정 필요)
	property number Card189SecondHitDelay = 0.41

	-- 폭발 판정 타원(가로/세로 반경) — 메소 익스플로젼(Card177)의 시각 배치를 그대로 재사용한 추정치.
	-- 신규 연출 크기가 다를 수 있어 라이브 확인 후 조정 필요.
	property number Card189ExplosionXOffset = 0.2
	property number Card189ExplosionYOffset = 0.1
	-- 유저 지정(2026-08-17): 연출과 함께 판정 범위도 10% 축소(메소 익스플로젼 기준값 1.05/0.57의 90%)
	property number Card189ExplosionHalfWidth = 0.945
	property number Card189ExplosionHalfHeight = 0.513
	property number Card189ExplosionCenterYOffset = 0.64
	property number Card189ExplosionCenterXOffset = 0.2

	-- 타당 기준 데미지(레벨별 고정값 — 유저 지정 표)
	method number GetMesoDetonationDamage(integer level)
		if level >= 3 then return 340
		elseif level >= 2 then return 320
		end
		return 300
	end

	-- 스턴 확률 — Lv1:50% / Lv2:60% / Lv3:70% (유저 지정 표)
	method number GetMesoDetonationStunChance(integer level)
		if level >= 3 then return 0.70
		elseif level >= 2 then return 0.60
		end
		return 0.50
	end

	-- 스턴 지속시간 — Lv1~2:1초 / Lv3:2초 (유저 지정 표)
	method number GetMesoDetonationStunDuration(integer level)
		if level >= 3 then return 2.0 end
		return 1.0
	end

	-- 반환값(boolean) 의미는 MesoExplosionAttack과 동일 — false면 TickCard가 쿨타임을 소모하지 않고 대기 상태로 둔다.
	@ExecSpace("ServerOnly")
	method boolean MesoDetonationAttack(number damage, boolean isCrit)
		local drops = _GameManager:PopLandedMesoDrops(999999)
		if #drops == 0 then return false end

		local map = self:GetCurrentMap()
		for _, drop in ipairs(drops) do
			_GameManager:AddGold(drop.amount)
			_GameManager:ClearMesoIconByDropId(drop.id)
			if map ~= nil then
				local localPos = self:WorldToCurrentMapLocal(drop.worldPos)
				self:ResolveMesoDetonation(map, localPos, damage, isCrit)
			end
		end
		return true
	end

	-- 1단계: effect0(차지) animationclip 직접 재생. 끝나기 Card189LeadTime초 전에 2단계(폭발 연출 +
	-- 대미지 + 스턴)를 예약한다(메소 익스플로젼과 동일 순서 관례).
	@ExecSpace("ServerOnly")
	method void ResolveMesoDetonation(Entity map, Vector3 localPos, number damage, boolean isCrit)
		local fxPos = Vector3(localPos.x + self.Card189ExplosionXOffset, localPos.y + self.Card189ExplosionYOffset, localPos.z - 0.1)
		local fx = self:SpawnEffect(self.Card189ChargeRUID, fxPos, 0, 1.0, self.Card189EffectScale, 1.0)
		if fx ~= nil then fx:Destroy(self.Card189ChargeDuration) end

		local delay = math.max(0, self.Card189ChargeDuration - self.Card189LeadTime)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(map) then return end
			self:ResolveMesoDetonationImpact(map, localPos, damage, isCrit)
		end, delay)
	end

	-- 2단계: effect(폭발) 연출 스폰(자체적으로 2번 도는 것처럼 보이는 그 연출) + 대미지 판정을 2번(즉시 +
	-- Card189SecondHitDelay초 뒤) 실행 — 각각 ResolveMesoDetonationHit이 전체 데미지의 50%씩 적용한다.
	@ExecSpace("ServerOnly")
	method void ResolveMesoDetonationImpact(Entity map, Vector3 localPos, number damage, boolean isCrit)
		self:PlayMesoDetonationSound()
		local fxPos = Vector3(localPos.x + self.Card189ExplosionXOffset, localPos.y + self.Card189ExplosionYOffset, localPos.z - 0.1)
		local fx = self:SpawnEffect(self.Card189ExplosionRUID, fxPos, 0, 1.0, self.Card189EffectScale, 1.0)
		if fx ~= nil then fx:Destroy(self.Card189ExplosionLifetime) end

		self:ResolveMesoDetonationHit(map, localPos, damage, isCrit)
		-- 유저 지적(2026-08-17): "2타 때 새 연출이 전혀 안 뜨는 게 문제" — 1타의 폭발(effect)이 아직
		-- 살아있는(Card189ExplosionLifetime=0.82초 뒤 소멸, 즉 t=Card189SecondHitDelay+0.82초까지 생존)
		-- 동안 차지(effect0)를 새로 겹쳐 스폰해서 "폭발→차지 겹침→2타"로 자연스럽게 이어지게 한다.
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(map) then return end
			self:PlayMesoDetonationSound()
			local fxPos2 = Vector3(localPos.x + self.Card189ExplosionXOffset, localPos.y + self.Card189ExplosionYOffset, localPos.z - 0.1)
			local fx2 = self:SpawnEffect(self.Card189ChargeRUID, fxPos2, 0, 1.0, self.Card189EffectScale, 1.0)
			if fx2 ~= nil then fx2:Destroy(self.Card189ChargeDuration) end
			self:ResolveMesoDetonationHit(map, localPos, damage, isCrit)
		end, self.Card189SecondHitDelay)
	end

	-- 실제 범위 대미지(전체의 Card189HitPercent=50%) + 몬스터마다 확률 스턴 적용 1회분. 크리티컬 여부는
	-- 캐스트 시점 값을 두 번 다 그대로 쓰지만, 스턴 확률/타격 연출은 매번 독립적으로 판정한다.
	@ExecSpace("ServerOnly")
	method void ResolveMesoDetonationHit(Entity map, Vector3 localPos, number damage, boolean isCrit)
		local halfWidth = self.Card189ExplosionHalfWidth
		local halfHeight = self.Card189ExplosionHalfHeight
		local centerX = localPos.x + self.Card189ExplosionCenterXOffset
		local centerY = localPos.y + self.Card189ExplosionCenterYOffset

		local stunChance = self:GetMesoDetonationStunChance(self.MesoDetonationLevel)
		local stunDuration = self:GetMesoDetonationStunDuration(self.MesoDetonationLevel)
		local hitDamage = damage * self.Card189HitPercent

		local monsters = self:GetMonstersInCurrentZone(map)
		local hitCount = 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local mp = m.Entity.TransformComponent.Position
				local nx = (mp.x - centerX) / halfWidth
				local ny = (mp.y - centerY) / halfHeight
				if (nx * nx + ny * ny) <= 1.0 then
					hitCount = hitCount + 1
					local scaleRatio = self:GetEffectScaleRatio(m)
					local hitFx = self:SpawnEffect(self.Card189HitRUID, Vector3(mp.x, mp.y, mp.z - 0.1), 0, 1.0, self.Card189EffectScale * scaleRatio, 1.0)
					if hitFx ~= nil then hitFx:Destroy(self.Card189HitEffectLifetime) end
					if isCrit then m:TakeDamageCrit(hitDamage * 2)
					else m:TakeDamage(hitDamage) end
					if _UtilLogic:RandomDouble() < stunChance then
						m:ApplyStun(stunDuration, true)
					end
				end
			end
		end
		log("MesoDetonation: hit=" .. hitCount .. " dmg=" .. math.floor(isCrit and hitDamage * 2 or hitDamage))
	end

	@ExecSpace("Multicast")
	method void PlayMesoDetonationSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.Card177SoundRUID, 1.0)
	end

	-- ── 쉐이드 전용: 쉐도우 파트너 (카드178, 슬롯형 액티브 7호). 피닉스처럼 지속시간 동안 소환수를
	-- 유지하는 스킬이지만, 자체 공격 타이머 대신 "플레이어가 이번 프레임에 실제로 발동한 액션(기본
	-- 공격 172 또는 슬롯 스킬)을 그대로 따라 한다"(유저 지정) — 데미지는 레벨별 비율로 너프. 같은
	-- 프레임에 여러 액션이 겹치면 스킬이 기본공격보다 우선, 스킬끼리 겹치면 무작위 하나. 이 결정은
	-- 소환된 파트너 전원(레벨별 1~2체, 유저 정정: "타겟수 아니고 소환 개수였음")이 동시에 함께
	-- 재생한다 — 직전 복제 동작이 아직 재생 중이면(Card178AttackMotionDuration, 전원 공유하는 단일
	-- 바쁨 상태) 새 복제를 시작하지 않는다(유저 지정: "먼저 쓴 스킬이 선행되어 다 종료되면 스킬
	-- 사용"). 복제 시 항상 고정 모션(Card178AttackRUID, 유저 지정)만 쓰고, 파트너 각자의 타겟 선정은
	-- 원본 스킬의 타겟 수/범위와 무관하게 항상 자기 위치 기준 최근접 1명으로 단순화한다(유저 지정:
	-- "동시에 같은 타겟을 잡을 필요는 없지만 동시에 시전되어야함").
	@Sync property integer ShadowPartnerLevel = 0
	property number Card178Cooldown = 10.0  -- 레벨 무관 고정(유저 표)
	-- 유저 지정(2026-08-12): 리소스팩 "skill/14111000"으로 전부 교체(기존에 잘못 골랐던 범용 리소스팩
	-- 대신 이 스킬 전용 팩) — 아이콘/캐스트/이동/공격/사망/대기 전부 이 팩 기준
	property string Card178IconRUID = "a1a46c991c5f464b862225b85c011aac"
	-- effect(16프레임)+effect0(11프레임)를 동시에 겹쳐 재생(쉐이드 기본공격의 fx1/fx2 동시재생과
	-- 동일한 패턴) — 소환 캐스트 연출
	property string Card178CastRUID = "df5ddacd44aa4acd956ab2a4bbc6ec6e"
	property string Card178CastRUID2 = "acd4de7e93a54ba49c7c9668536327f7"
	property number Card178CastLifetime = 0.8  -- 실측 전 보수적 추정치(16프레임 기준)
	property string Card178IdleRUID = "f86bb47590ce4ef787dae1441e3140c9"  -- special/alert(대기 포즈, 유저 지정)
	property string Card178WalkRUID = "c9b9b0a008754947a164ab68fdd2eabd"  -- special/walk1(이동 연출, 유저 지정)
	-- 유저 지적(2026-08-12): "공격모션이 빠진거같은데?" — 기존 6a55c8f0...는 실제로 확인해보니 자세가
	-- 애매해서 공격 동작처럼 안 보였다. 유저가 새로 준 eb9a4583...(같은 리소스팩의 다른 스윙 클립)로 교체.
	property string Card178AttackRUID = "eb9a4583928e4251ae7cc46c1c12f5f7"
	property string Card178DieRUID = "9889c763f65f480587f6215f2c27aecb"  -- special/dead(소환 해제, 유저 지정)
	property string Card178SoundRUID = "6d1c40b8cfaf44fe9c349040d95f31b4"  -- audio/Use
	property number Card178Scale = 1.0  -- 실측 전 추정치
	property Vector3 Card178SpawnPosition = Vector3(0, 3.0, -0.1)  -- 근처에 적이 없을 때만 쓰는 대체 위치(피닉스와 동일 패턴)
	property number Card178HoverYOffset = 0.0
	property number Card178DepthZ = -2.0  -- 몬스터(Z 0~0.65)보다 항상 위(피닉스/허수아비와 동일 패턴)
	-- 2체 이상 소환될 때 서로 겹치지 않도록 좌우로 벌리는 간격(유닛)
	property number Card178MultiSpawnSpacing = 0.6
	-- 유저 지적(2026-08-12): "이동 안하는데?" — 공격 시 타겟 위치로 실제로 걸어가도록(walk1 재생)
	-- 추가했다. 타겟 앞에 서는 지점까지 물러서는 거리 + 이동 시간(4프레임 추정 근거로 0.35초)
	property number Card178AttackForwardOffset = 0.3
	-- 유저 지적(2026-08-12): "분신 이동 속도 너무 빠름 절반으로 줄여봐" — 이동거리는 그대로 두고
	-- 소요시간을 2배(0.35→0.7)로 늘려서 속도를 절반으로 낮췄다.
	property number Card178RepositionDuration = 0.7
	-- swingO3가 3프레임이라 공식(0.05+0.1*N) 기준 0.35초 — 공격 스프라이트가 대기 포즈로 돌아가기
	-- 전까지 유지되는 시간(순수 시각 연출용, 바쁨 판정과는 무관).
	property number Card178AttackMotionDuration = 0.35
	-- 유저 정정(2026-08-12): "도착하자마자 바로 때려도 됨, 공격한 이후 1초의 딜레이를 주라는거였음" →
	-- 이어서 "스킬 쓰고 2초동안 aff31ece...(어지러움/쿨다운 상태 아이콘) 좀 띄우자, 그다음 다시 공격
	-- 할 수 있게, 저 상태에서는 제자리에 멈춰있음 될듯"으로 확장 — 공격 직후 파트너 머리 위에 이
	-- 아이콘을 띄운 채 제자리에 서서 대기하는 시간(=이동 없음, 다음 행동도 막힘). 복제 전체가 끝날
	-- 때까지 다음 복제를 막는 "바쁨" 판정은 이동(RepositionDuration)+이 값으로 계산한다.
	-- 유저 지정(2026-08-13): 스턴(어지러움 아이콘 유지) 시간 2.0→1.0초로 단축 — 파트너가 더 자주 움직임.
	property number Card178PostAttackDuration = 1.0
	property string Card178PostAttackIconRUID = "aff31eceba614575ab4959a4bbb43806"
	property number Card178PostAttackIconYOffset = 0.8
	-- 유저 지적(2026-08-12): "쉐도우 스턴 걸리는거 0.2s 정도 늦추고" + "공격하고 스턴걸릴때 연출이
	-- 짤리는 경우가 없는지" → 이어서 "쉐도우 스턴 0.2s 추가로 더 있다 걸리게 해줘"로 재차 증가(0.2→0.4).
	-- 공격 스윙(Card178AttackMotionDuration)이 끝나자마자 곧바로 대기 포즈+어지러움 아이콘으로
	-- 전환되던 걸, 그 사이에 여유를 둬서 공격 포즈가 너무 급하게 잘려 보이지 않도록 한다. 아이콘 표시
	-- 시작과 바쁨 해제 타이머 둘 다 이 값만큼 뒤로 민다.
	property number Card178StunDelay = 0.4
	-- 유저 지적(2026-08-12, 1차): "무스펠하임은 쉐도우파트너가 쓰면 중앙으로 안가고 넉백을 지금보다
	-- 1/3 수준으로 줄이자 — 존을 벗어날까봐 불안하다" → (2차, 방향 버그) "쉐도우가 오른쪽으로 지나가고
	-- 있을때 무스펠하임쓰면 쉐도우캐릭 오른쪽에 넉백이 떠야해, 반대인경우는 왼쪽 ... 지금은 등뒤에서
	-- 쏘는 느낌이여" — 기존엔 destX 방향이 "타겟→존중앙" 기준이라 파트너가 어느 쪽에서 접근해 서 있는지와
	-- 무관하게 정해져서, 파트너가 오른쪽을 보고 있는데 넉백이 왼쪽(파트너 등 뒤)으로 나가는 경우가
	-- 있었다. 존중앙 기준을 버리고, 파트너가 지금 바라보는 방향(facingSign, hit.facingSign)으로 고정된
	-- 짧은 거리만 미는 것으로 교체 — 방향은 항상 파트너 정면과 일치하고, 거리 자체도 짧아서(1.5) 존
	-- 이탈 위험도 낮다(ClampKnockbackDestX의 존/화면 안전 클램프도 그대로 이중 적용됨).
	property number Card178MuspelheimKnockbackDistance = 1.5
	-- 유저 지적(2026-08-12): "쉐도우 무스펠하임 넉백되는 시간 땡기자 0.3s정도 더 빨리" — LaunchMuspelheimKnockback의
	-- 공용 시작딜레이(Card175KnockbackStartDelay=0.3)에서 파트너가 쓸 때만 이 값만큼 빼서 앞당긴다
	-- (0 밑으로는 안 내려감). 플레이어 직접 사용은 영향 없음.
	property number Card178MuspelheimKnockbackTimeAdvance = 0.3
	property number Card178DieDuration = 0.35  -- special/dead 3프레임 추정(0.05+0.1*3)
	-- 유저 지정: "얘도 검은색이라 노란색 테두리 아까처럼 씌워주고(스틸처럼)" — 이미 검증된
	-- StealCastGlow.material을 그대로 재사용, 소환 내내 유지(엘리트 아웃라인과 동일하게 상시 적용)
	property string Card178GlowMaterialId = "75a11168-cf7e-4d53-8b54-3bf882df30af"
	-- 유저 지정(2026-08-12): "쉐도우 파트너일떄는 예외처리로 스모크 디버프 X 스틸은 메소 드랍확률만
	-- 50%" — 원본 스킬 메서드를 그대로 호출하는 동안만 true로 켜서, SmokeGrenadeAttack/TriggerStealDrop
	-- 내부에서 "지금 이 실행이 파트너가 쓴 건지"를 분기하는 데 쓰는 플래그(넉백은 그대로 원본과 동일 —
	-- 별도 분기 없음).
	property boolean _shadowPartnerCopyActive = false
	-- 버그 수정(2026-08-12, 유저 지적: "공격은 하는데 몬스터 죽으면 연출 안나가냐?") — 파트너가 걸어가서
	-- 실제로 스킬을 실행하기까지 RepositionDuration(0.7초)이 걸리는데, 복제 대상 스킬(171/173/174/176/179)은
	-- 전부 실행 시점에 GetClosestTargets를 새로 불러서 그 순간 살아있는 몬스터가 하나도 없으면
	-- "if #targets == 0 then return end"에 걸려 연출까지 통째로 스킵됐다(웨이브 막바지 마지막 1마리가
	-- 그 0.7초 사이 죽으면 항상 재현). ExecuteShadowPartnerCopy가 t=0 시점에 미리 찾아둔 hit.target을
	-- 여기 담아뒀다가, 각 스킬의 재선정이 0마리를 반환할 때 이걸로 대체해서 연출만이라도 재생시킨다.
	property MonsterAI _shadowPartnerFallbackTarget = nil
	-- 소환된 파트너 전원의 목록(레벨5에서 2체) — 전부 같은 맵/바쁨상태/유지시간을 공유한다
	property any _shadowPartnerEntities = {}
	property Entity _shadowPartnerMap = nil
	-- 버그 수정(2026-08-22, Ep2Map3SummonLogic 개발 중 발견) — ep2_map3/ep2_map4처럼 존 10개가
	-- container=nil로 파일 하나를 공유하는 맵에서는 GetCurrentMap()이 반환하는 Entity가 존을 옮겨도
	-- 항상 똑같아서, Entity 비교(liveMap ~= self._shadowPartnerMap)로는 존 이동이 절대 감지되지
	-- 않았다. _MapManager.CurrentMapIndex 비교로 바꾼다(GetMonstersInCurrentZone과 동일한 기준).
	property integer _shadowPartnerZoneIndex = -1
	property boolean _shadowPartnerBusy = false
	-- 유저 정정(2026-08-12): "사용하는 스킬을 따라하지말고 그냥 보유중인 스킬중 랜덤하게 사용하는걸로
	-- 바꾸자 기본 공격까지 포함해서" — 플레이어 행동을 프레임 단위로 따라하던 기존 방식(RecordShadowPartner
	-- Candidate/ResolveShadowPartnerFrame)을 폐기하고, 소환 중 자체 주기(Card178ActionInterval)마다
	-- 현재 슬롯에 있는 스킬(+기본공격) 중 하나를 무작위로 골라 사용하는 자율 행동으로 변경했다(피닉스의
	-- 고정 공격 틱 스케줄과 동일한 패턴 — ShadowPartnerAttack에서 소환 시점에 한번에 예약).
	property number Card178ActionInterval = 1.2
	property number Card178FirstActionDelay = 0.8

	-- 복사 대미지 비율 60/70/80/90/100% (유저 지정 표)
	method number GetShadowPartnerCopyPercent(integer level)
		if level >= 5 then return 1.0
		elseif level >= 4 then return 0.9
		elseif level >= 3 then return 0.8
		elseif level >= 2 then return 0.7
		end
		return 0.6
	end

	-- 지속시간 5/5/6/6/6초 (유저 지정 표)
	method number GetShadowPartnerDuration(integer level)
		if level >= 3 then return 6 end
		return 5
	end

	-- 유저 정정(2026-08-12): "파트너 타겟수는 1/1/1/1/1로 바꾸자 저거 그냥 소환 개수였어" — 표의
	-- 1/1/1/1/2 컬럼은 파트너 1체가 때리는 타겟 수가 아니라 "동시에 소환되는 파트너 개체 수"였다.
	-- 재정정(2026-08-12): "쉐도우 소환 1~5 레벨 다 1개로 하자" — Lv5의 2체 소환도 없애고 전 레벨 1체로 통일.
	method integer GetShadowPartnerSummonCount(integer level)
		return 1
	end

	@ExecSpace("ServerOnly")
	method void ShadowPartnerAttack(number damage, boolean isCrit)
		local map = self:GetCurrentMap()
		if map == nil then return end

		-- 이미 소환돼 있으면 전부 정리 후 재소환(쿨타임이 항상 유지시간보다 길어서 정상 플레이에선
		-- 거의 발생하지 않지만 방어적으로 처리 — 피닉스와 동일한 관례)
		for _, old in ipairs(self._shadowPartnerEntities) do
			if isvalid(old) then old:Destroy() end
		end
		self._shadowPartnerEntities = {}
		self._shadowPartnerBusy = false

		local firstTarget = self:FindClosestInMap(map)
		local basePos = self.Card178SpawnPosition
		if firstTarget ~= nil and isvalid(firstTarget) and isvalid(firstTarget.Entity) then
			local tp = firstTarget.Entity.TransformComponent.Position
			basePos = Vector3(tp.x, tp.y + self.Card178HoverYOffset, self.Card178DepthZ)
		end

		self:PlayShadowPartnerCastEffect(basePos)

		local summonCount = self:GetShadowPartnerSummonCount(self.ShadowPartnerLevel)
		for i = 1, summonCount do
			-- 2체 이상이면 겹치지 않게 좌우로 벌린다(1체면 오프셋 0)
			local offsetX = (i - (summonCount + 1) / 2.0) * self.Card178MultiSpawnSpacing
			local spawnPos = Vector3(basePos.x + offsetX, basePos.y, basePos.z)
			-- "persistenteffect"는 자동 소멸 스크립트가 없는 전용 모델(피닉스가 이미 검증) — 수명은
			-- 아래 타이머로 직접 관리한다.
			local partner = self:SpawnEffectWithModel(self.Card178IdleRUID, spawnPos, 0, 1.0, self.Card178Scale, 1.0, "persistenteffect")
			if partner ~= nil then
				if partner.SpriteRendererComponent ~= nil then
					partner.SpriteRendererComponent:ChangeMaterial(self.Card178GlowMaterialId)
				end
				table.insert(self._shadowPartnerEntities, partner)
			end
		end
		self._shadowPartnerMap = map
		self._shadowPartnerZoneIndex = _MapManager.CurrentMapIndex

		local duration = self:GetShadowPartnerDuration(self.ShadowPartnerLevel)

		-- 피닉스(PhoenixAttack)와 동일한 패턴 — 소환 시점에 유지시간 동안의 행동 틱을 전부 미리
		-- 예약한다. 매 틱마다 self:ShadowPartnerRandomAction()이 그 순간 슬롯에 있는 스킬(+기본공격)
		-- 중 하나를 무작위로 골라 사용한다(바쁨 상태면 그 틱은 조용히 건너뜀).
		local interval = self.Card178ActionInterval
		local actionCount = math.floor(duration / interval)
		for i = 0, actionCount - 1 do
			local delay = self.Card178FirstActionDelay + i * interval
			_TimerService:SetTimerOnce(function()
				self:ShadowPartnerRandomAction()
			end, delay)
		end

		_TimerService:SetTimerOnce(function()
			self:TryEndShadowPartnerLife()
		end, duration)

		log("ShadowPartnerAttack: duration=" .. duration .. " copyPercent=" .. math.floor(self:GetShadowPartnerCopyPercent(self.ShadowPartnerLevel) * 100) .. "% summonCount=" .. summonCount)
	end

	@ExecSpace("Multicast")
	method void PlayShadowPartnerCastEffect(Vector3 pos)
		if self:IsServer() then return end
		_SoundService:PlaySound(self.Card178SoundRUID, 1.0)
		local fx1 = self:SpawnEffectWithModel(self.Card178CastRUID, pos, 0, 1.0, self.Card178Scale, 1.0, "skilleffectlong")
		if fx1 ~= nil then fx1:Destroy(self.Card178CastLifetime) end
		local fx2 = self:SpawnEffectWithModel(self.Card178CastRUID2, pos, 0, 1.0, self.Card178Scale, 1.0, "skilleffectlong")
		if fx2 ~= nil then fx2:Destroy(self.Card178CastLifetime) end
	end

	-- 유지시간이 다 됐을 때 호출 — 마침 복제 동작이 재생 중이면(바쁨) 그게 끝날 때까지 소환 해제를
	-- 미룬다(피닉스 TryEndPhoenixLife와 동일한 패턴, 유저 지정: "먼저 쓴 스킬이 선행되어 다 종료되면").
	@ExecSpace("ServerOnly")
	method void TryEndShadowPartnerLife()
		if not isvalid(self) then return end
		if self._shadowPartnerBusy then
			_TimerService:SetTimerOnce(function()
				self:TryEndShadowPartnerLife()
			end, 0.1)
			return
		end
		for _, fx in ipairs(self._shadowPartnerEntities) do
			if isvalid(fx) then
				local r = fx.SpriteRendererComponent
				if r ~= nil then r.SpriteRUID = self.Card178DieRUID end
				fx:Destroy(self.Card178DieDuration)
			end
		end
		self._shadowPartnerEntities = {}
		self._shadowPartnerMap = nil
	end

	-- 존 이동 감지 시 파트너 전원을 플레이어의 새 맵으로 다시 소환(피닉스 RelocatePhoenixToNewMap과 동일 패턴)
	@ExecSpace("ServerOnly")
	method void RelocateShadowPartnerToNewMap(Entity newMap)
		local oldList = self._shadowPartnerEntities
		local count = #oldList
		if count == 0 then return end
		local anchor = self:FindClosestInMap(newMap)
		local basePos = self.Card178SpawnPosition
		if anchor ~= nil and isvalid(anchor) and isvalid(anchor.Entity) then
			local ap = anchor.Entity.TransformComponent.Position
			basePos = Vector3(ap.x, ap.y + self.Card178HoverYOffset, self.Card178DepthZ)
		end
		local fresh = {}
		for i = 1, count do
			local offsetX = (i - (count + 1) / 2.0) * self.Card178MultiSpawnSpacing
			local spawnPos = Vector3(basePos.x + offsetX, basePos.y, basePos.z)
			local p = self:SpawnEffectWithModel(self.Card178IdleRUID, spawnPos, 0, 1.0, self.Card178Scale, 1.0, "persistenteffect")
			if p ~= nil then
				if p.SpriteRendererComponent ~= nil then
					p.SpriteRendererComponent:ChangeMaterial(self.Card178GlowMaterialId)
				end
				table.insert(fresh, p)
			end
		end
		for _, old in ipairs(oldList) do
			if isvalid(old) then old:Destroy() end
		end
		self._shadowPartnerEntities = fresh
		self._shadowPartnerMap = newMap
		self._shadowPartnerZoneIndex = _MapManager.CurrentMapIndex
	end

	-- 현재 슬롯에 있는 스킬(카드178 자기 자신 제외) + 기본공격(172)을 후보 풀로 반환한다.
	@ExecSpace("ServerOnly")
	method table GetShadowPartnerCandidateCardIndices()
		local pool = { 172 }
		local slots = { self.Slot1Card, self.Slot2Card, self.Slot3Card, self.Slot4Card, self.Slot5Card, self.Slot6Card }
		for _, c in ipairs(slots) do
			if c ~= 0 and c ~= 178 then table.insert(pool, c) end
		end
		return pool
	end

	-- ShadowPartnerAttack이 소환 시점에 예약해둔 행동 틱마다 호출된다 — 그 순간 보유 중인 스킬(+기본공격)
	-- 중 하나를 무작위로 골라 사용한다. 이동/공격 모션이 아직 진행 중(바쁨)이면 이번 틱은 건너뛴다.
	@ExecSpace("ServerOnly")
	method void ShadowPartnerRandomAction()
		if self.ShadowPartnerLevel == 0 or self._shadowPartnerBusy or #self._shadowPartnerEntities == 0 then return end
		local pool = self:GetShadowPartnerCandidateCardIndices()
		local chosen = pool[_UtilLogic:RandomIntegerRange(1, #pool)]
		self:ExecuteShadowPartnerCopy(chosen)
	end

	-- 실제 복제 실행 — 소환된 파트너 전원이 각자 최근접 타겟(원본 타겟과 무관, 1명) 앞까지 걸어간 뒤
	-- (피닉스 PhoenixAttackTick과 동일한 이동-후-공격 패턴) 동시에 공격 모션+대미지가 들어간다.
	-- 원본 카드의 기준 대미지에 레벨별 비율을 곱해서(너프) 적중시킨다.
	@ExecSpace("ServerOnly")
	method void ExecuteShadowPartnerCopy(integer cardIdx)
		if #self._shadowPartnerEntities == 0 then return end

		-- 존 이동 감지 — Entity 비교가 아니라 존 인덱스로 비교한다(위 _shadowPartnerZoneIndex 선언부 주석 참고)
		if _MapManager.CurrentMapIndex ~= self._shadowPartnerZoneIndex then
			local liveMap = self:GetCurrentMap()
			if liveMap ~= nil then
				self:RelocateShadowPartnerToNewMap(liveMap)
				if #self._shadowPartnerEntities == 0 then return end
			end
		end
		local map = self._shadowPartnerMap
		if map == nil then return end

		-- 파트너별로 각자 위치 기준 최근접 1명을 찾는다(전부 유효 타겟을 못 찾으면 이번 복제는 스킵)
		local hits = {}
		for _, partner in ipairs(self._shadowPartnerEntities) do
			if isvalid(partner) then
				local targets = self:GetClosestTargetsFromPosition(map, partner.TransformComponent.Position, 1)
				if #targets > 0 then table.insert(hits, { partner = partner, target = targets[1] }) end
			end
		end
		if #hits == 0 then return end

		self._shadowPartnerBusy = true

		-- 각 파트너를 자기 타겟 앞(Card178AttackForwardOffset만큼 물러선 지점)으로 걷는 연출과 함께
		-- 이동시킨다(피닉스와 동일하게 ServerOnly에서 TransformComponent.Position/SpriteRUID/FlipX를
		-- 직접 세팅 — Transform과 SpriteRenderer는 엔진이 자동 동기화하므로 별도 Multicast 불필요).
		for _, hit in ipairs(hits) do
			local partner = hit.partner
			local target = hit.target
			local renderer = partner.SpriteRendererComponent
			local startPos = partner.TransformComponent.Position
			local targetPos = target.Entity.TransformComponent.Position

			local facingRight = targetPos.x >= startPos.x
			local facingSign = facingRight and 1 or -1
			local destZ = startPos.z
			-- 유저 지적(2026-08-12): "쉐도우가 오른쪽으로 지나가고 있을때 무스펠하임쓰면 쉐도우캐릭
			-- 오른쪽에 넉백이 떠야해... 지금은 등뒤에서 쏘는 느낌" — 무스펠하임 복사(cardIdx==175)의
			-- 넉백 방향을 파트너가 지금 바라보는 방향(facingSign)에 맞추기 위해 dispatch 루프까지
			-- 들고 가도록 hit 테이블에 저장해둔다(이 루프의 facingSign은 이 for문 스코프 안에서만
			-- 유효해서 나중 dispatch 루프에서는 직접 못 씀).
			hit.facingSign = facingSign

			if renderer ~= nil then
				renderer.FlipX = facingRight
				renderer.SpriteRUID = self.Card178WalkRUID
			end

			-- 유저 지적(2026-08-12): "공격할때는 진짜 타겟한 몬스터 옆에 붙어서 사용하게 해줄래?" —
			-- 기존엔 이동 시작 시점에 캡처한 targetPos 딱 한 지점으로만 보간해서, 그 사이 몬스터가
			-- 계속 움직이면(플레이어를 향해 추적 중이므로 흔함) 파트너가 몬스터 없는 빈 자리에 도착해
			-- 버렸다. 매 틱마다 타겟의 "현재" 좌표를 다시 읽어 목적지를 갱신하면서 보간하도록 바꿔서
			-- (facingSign/오프셋 방향은 시작 시점 값 고정 — 도중에 좌우가 뒤집혀 보이지 않게), 도착 시점엔
			-- 항상 그 순간 몬스터 실제 위치 옆에 서게 된다(비행형은 기존과 동일하게 고도는 안 쫓음).
			_TweenLogic:PlayTween(0.0, 1.0, self.Card178RepositionDuration, EaseType.Linear, function(t)
				if not isvalid(partner) then return end
				local curTargetX = targetPos.x
				local curTargetY = targetPos.y
				if isvalid(target) and isvalid(target.Entity) then
					local ctp = target.Entity.TransformComponent.Position
					curTargetX = ctp.x
					curTargetY = ctp.y
				end
				local curDestY = curTargetY
				if isvalid(target) and target._isFlying then curDestY = startPos.y end
				local curDestX = curTargetX - facingSign * self.Card178AttackForwardOffset
				local x = startPos.x + (curDestX - startPos.x) * t
				local y = startPos.y + (curDestY - startPos.y) * t
				partner.TransformComponent.Position = Vector3(x, y, destZ)
			end)
		end

		-- 유저 정정(2026-08-12): "도착하자마자 바로 때려도 됨, 공격한 이후 1초의 딜레이를 주라는거였음"
		-- → 이어서 "2초동안 쿨다운 아이콘 띄우자"로 확장 — 윈드업 없이 도착 즉시 공격 모션+실제 스킬
		-- 실행. 대신 "바쁨" 해제(다음 행동 가능 시점)를 공격 스윙+쿨다운 아이콘 표시가 전부 끝나는
		-- 시점(Card178AttackMotionDuration + Card178StunDelay + Card178PostAttackDuration)으로 미룬다.
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self:PlayShadowPartnerAttackMotion(cardIdx)

			local baseDamage = self:GetCardDamage(cardIdx) * self:GetShadowPartnerCopyPercent(self.ShadowPartnerLevel)
			local isCrit = self:RollCrit(cardIdx)
			local hitCount = 0
			-- 유저 지적(2026-08-12): "그냥 있는거 가져다가 실행하면 안되는거냐? 이미 만들어놓은 스킬 얘가
			-- 휘두르면 그몬스터한테 나오게 하면 되는거잖아" — 대표 연출만 손으로 재현하던 방식(누락되는
			-- 연출/오프셋/사운드가 계속 나옴)을 버리고, 카드가 원래 쓰는 진짜 공격 메서드를 그대로 호출한다.
			-- 이러면 연출·사운드·부가효과까지 원본과 항상 100% 동일하게 유지된다(원본이 나중에 바뀌어도
			-- 자동으로 따라감). 단, 기본공격(172) 외에는 원본 메서드가 자기 GetClosestTargets로 스스로
			-- 타겟을 고르기 때문에(파트너가 서 있는 그 몬스터에 고정되지 않음) 부가효과가 파트너 소환
			-- 중엔 실질적으로 2배로 발동한다 — 이어서 유저가 이 부가효과 배율을 파트너 전용으로 낮춰달라고
			-- 지정(스모크 디버프 제거/스틸 메소드랍 50%)해서 self._shadowPartnerCopyActive 플래그로 각
			-- 메서드 내부에서 분기한다(넉백은 그대로 원본과 동일하게 유지).
			if cardIdx == 172 then
				for _, hit in ipairs(hits) do
					local t = hit.target
					if isvalid(t) and isvalid(t.Entity) then
						self:ShadeBasicAttack(baseDamage, isCrit, t)
						hitCount = hitCount + 1
					end
				end
			else
				self._shadowPartnerCopyActive = true
				-- 유저 지적(2026-08-12): "쉐도우파트너한테는 쉐이드 스킬 엑티브 스킬 늘어날때마다
				-- 적용되어야함" — GetShadowPartnerCandidateCardIndices는 슬롯을 그때그때 스캔해서
				-- 자동으로 새 카드를 포함하지만, 실행은 이 분기표가 cardIdx별로 대응하는 실제 메서드를
				-- 알아야 하므로 여전히 수동으로 하나씩 추가해야 한다(다크 플레어(179) 추가 시 이 분기가
				-- 누락돼서 뽑혀도 조용히 아무 일도 안 일어나는 버그였음) — 앞으로 쉐이드 액티브 스킬을
				-- 새로 추가할 때마다 반드시 여기도 같이 추가할 것.
				for _, hit in ipairs(hits) do
					-- 버그 수정(2026-08-12): 아래 각 메서드가 실행 시점에 GetClosestTargets를 다시 불러
					-- 0마리가 나오면(파트너가 원래 겨냥한 이 hit.target이 그 사이 죽은 경우 포함) 대체용으로
					-- 쓸 수 있게 미리 담아둔다 — 각 메서드 쪽 수정과 짝이다.
					self._shadowPartnerFallbackTarget = hit.target
					-- 유저 지정(2026-08-13): "타겟된 애들한테만 1개씩, 카드 레벨이 2 이상이라도 1개만" —
					-- 더블스텝/새비지블로우/스틸/다크플레어는 카드 레벨의 타겟수 공식(GetXTargetCount)을
					-- 무시하고, 파트너가 실제로 서 있는 그 몬스터 1명(hit.target)에게만 고정 적용한다
					-- (forcedTargets를 넘기면 각 메서드가 자체 GetClosestTargets 재선정을 건너뛴다).
					local partnerForcedTargets = (isvalid(hit.target) and isvalid(hit.target.Entity)) and { hit.target } or {}
					if cardIdx == 171 then self:DoubleStepAttack(baseDamage, isCrit, partnerForcedTargets)
					elseif cardIdx == 173 then self:SavageBlowAttack(baseDamage, isCrit, partnerForcedTargets)
					elseif cardIdx == 174 then self:SmokeGrenadeAttack(baseDamage, isCrit)
					elseif cardIdx == 175 then
						-- 유저 지적(2026-08-12): "쉐도우 파트너가 중앙 방향을 바라보게 쏠순 없나? 타겟이
						-- 왼쪽에 있으면 그 타겟 왼쪽편에서 중앙으로 쏘게" — 원본 MuspelheimAttack은 맵
						-- 전체를 스캔해 "양끝(leftExtreme/rightExtreme)"을 직접 찾아서 쏘기 때문에 파트너
						-- 위치와 무관하게 항상 같은 결과였다. 대신 파트너 자신이 이미 골라둔 타겟(hit.target)
						-- 하나만 넉백시키도록 변경 — FireMuspelheimShove가 캐스트 연출+넉백+폭발을 전부 그
						-- 타겟의 실제 위치에서 재생하므로 "연출은 쉐도우 파트너가 쓰는 그대로" 유지되면서,
						-- 맵 전체 양끝이 아니라 파트너가 붙어있는 그 몬스터 한 명만 대상이 된다.
						-- 방향 버그 수정(2026-08-12): "쉐도우가 오른쪽으로 지나가고 있을때 무스펠하임쓰면
						-- 쉐도우캐릭 오른쪽에 넉백이 떠야해 ... 지금은 등뒤에서 쏘는 느낌" — destX를
						-- "타겟→존중앙" 방향으로 정하던 걸 버리고, 파트너가 지금 바라보는 방향
						-- (hit.facingSign, 이동 루프에서 미리 저장해둠)으로 고정 거리만 민다 — 항상 파트너
						-- 정면 방향으로 넉백이 나가서 "등 뒤에서 쏘는" 위화감이 없어지고, 짧은 고정거리라
						-- ClampKnockbackDestX의 존/화면 안전 클램프와 함께 존 이탈 위험도 낮다.
						local t = hit.target
						if isvalid(t) and isvalid(t.Entity) then
							local tx = t.Entity.TransformComponent.Position.x
							local partnerFacingSign = hit.facingSign or 1
							local shortDestX = tx + partnerFacingSign * self.Card178MuspelheimKnockbackDistance
							self:FireMuspelheimShove(map, t, shortDestX, baseDamage, isCrit)
						end
					elseif cardIdx == 176 then self:StealAttack(baseDamage, isCrit, partnerForcedTargets)
					elseif cardIdx == 177 then self:MesoExplosionAttack(baseDamage, isCrit)
					elseif cardIdx == 179 then self:DarkFlareAttack(baseDamage, isCrit, partnerForcedTargets)
					elseif cardIdx == 189 then self:MesoDetonationAttack(baseDamage, isCrit)
					elseif cardIdx == 191 then self:AbyssalFlareAttack(baseDamage, isCrit, partnerForcedTargets)
					end
					hitCount = hitCount + 1
				end
				self._shadowPartnerCopyActive = false
			end
			log("ShadowPartnerCopy: card=" .. cardIdx .. " dmg=" .. math.floor(isCrit and baseDamage * 2 or baseDamage) .. " partners=" .. hitCount)

			-- 버그 수정(2026-08-12, 유저 지적: "eb9a4583...(공격 스프라이트) 2번 연출되잖아 1번만 하게 해") —
			-- 스프라이트 리셋(Idle 복귀)과 아이콘 스폰이 한 타이머(AttackMotionDuration+StunDelay=0.75초)에
			-- 같이 묶여있어서, AttackMotionDuration(0.35초, swing 연출 1회분으로 산정한 값)짜리 공격
			-- 스프라이트가 그보다 2배 넘게 긴 0.75초 동안 계속 붙어있다 보니 같은 클립이 한 번 더 루프
			-- 돌아 "2번 재생되는" 것처럼 보였다. AttackMotionDuration 주석 자체가 "대기 포즈로 돌아가기
			-- 전까지 유지되는 시간"이라 원래도 스프라이트 리셋은 이 시점에 끊겼어야 정상 — 아이콘 딜레이
			-- (StunDelay, 유저 지정: "스킬 쓰고 2초동안 이거 좀 띄우자")는 그대로 유지하되, 스프라이트
			-- 리셋만 별도 타이머로 분리해서 원래 의도한 타이밍(AttackMotionDuration)에 끊는다.
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				for _, fx in ipairs(self._shadowPartnerEntities) do
					if isvalid(fx) then
						local r = fx.SpriteRendererComponent
						if r ~= nil then r.SpriteRUID = self.Card178IdleRUID end
					end
				end
			end, self.Card178AttackMotionDuration)

			-- 짧은 공격 스윙이 끝나고 대기 포즈로 돌아간 뒤, 그 머리 위에 쿨다운 상태 아이콘
			-- (Card178PostAttackIconRUID)을 StunDelay만큼 늦게 띄운 채 제자리에서 대기한다(유저 지정: "스킬
			-- 쓰고 2초동안 이거 좀 띄우자 ... 저상태에서는 제자리에 멈춰있음 될듯" — 이동은 다음 행동
			-- 틱이 왔을 때만 다시 시작되므로 별도 처리 없이 자동으로 제자리 대기가 된다).
			-- 버그 수정(2026-08-12): "스턴은 못움직이는 동안 연출 계속 나오게" — 이 아이콘을
			-- self:SpawnEffect(...)로 스폰하고 있었는데, 그 헬퍼는 내부적으로 modelId="skilleffect"를
			-- 쓰고 그 모델 자신의 SkillEffectAI가 스폰 시점에 고정 0.8초 후 자동 파괴한다
			-- ([[feedback_skilleffect_duration_timing]]과 동일한 landmine — 스폰 뒤의 icon:Destroy(2.0)
			-- 호출은 이미 0.8초 만에 사라진 엔티티에 뒤늦게 걸려 아무 효과가 없었다). 그래서 파트너가
			-- 실제로는 PostAttackDuration(2.0~2.4초) 내내 멈춰있는데도 아이콘은 0.8초 만에 사라져
			-- 나머지 구간엔 아무 표시 없이 서 있는 것처럼 보였다. 자동 파괴 스크립트가 없는
			-- "persistenteffect" 모델로 바꿔서 스폰하면(파트너 본체/다크플레어 타격프레임과 동일 패턴)
			-- 뒤의 icon:Destroy(Card178PostAttackDuration) 호출이 실제 수명을 그대로 결정하게 된다.
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				for _, fx in ipairs(self._shadowPartnerEntities) do
					if isvalid(fx) then
						local pos = fx.TransformComponent.Position
						local icon = self:SpawnEffectWithModel(self.Card178PostAttackIconRUID, Vector3(pos.x, pos.y + self.Card178PostAttackIconYOffset, pos.z - 0.1), 0, 1.0, 1.0, 1.0, "persistenteffect")
						if icon ~= nil then icon:Destroy(self.Card178PostAttackDuration) end
					end
				end
			end, self.Card178AttackMotionDuration + self.Card178StunDelay)

			-- "바쁨" 자체는 공격 시점 기준 스윙(AttackMotionDuration)+여유(StunDelay)+쿨다운 아이콘
			-- (PostAttackDuration)이 전부 끝난 뒤에 풀린다 — 다음 행동 틱이 그 전에 도착하면 스킵되고,
			-- 그 이후 틱이면 바로(이동 없이 이미 근처면 즉시, 멀면 이동 후) 다시 공격 가능해진다.
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				self._shadowPartnerBusy = false
			end, self.Card178AttackMotionDuration + self.Card178StunDelay + self.Card178PostAttackDuration)
		end, self.Card178RepositionDuration)
	end

	-- 유저 지적(2026-08-12): "공격 모션 계속 안나오는데??" — 원인 발견: 이 메서드가 Multicast였는데,
	-- 안에서 읽는 self._shadowPartnerEntities는 @Sync가 아닌 이 Logic 자신의 로컬 프로퍼티(애초에 any/
	-- table이라 @Sync 불가)라 클라이언트 쪽 이 스크립트 인스턴스에서는 항상 빈 테이블이었다 — Multicast로
	-- 클라에서 실행돼봤자 for문이 0번 돌아서 스프라이트가 절대 안 바뀜(이동/사망/대기 복귀는 전부 이미
	-- ServerOnly에서 fx.SpriteRendererComponent를 직접 세팅하는 방식이라 정상 동작했던 것과 대비됨).
	-- 동일하게 ServerOnly 직접 세팅으로 바꿔서 고친다(Entity/Component 자체는 엔진이 자동 동기화).
	@ExecSpace("ServerOnly")
	method void PlayShadowPartnerAttackMotion(integer cardIdx)
		for _, fx in ipairs(self._shadowPartnerEntities) do
			if isvalid(fx) then
				local r = fx.SpriteRendererComponent
				if r ~= nil then r.SpriteRUID = self.Card178AttackRUID end
			end
		end
	end

	-- ── 쉐이드 조합 스킬: 듀얼 쉐도우 파트너 (카드190) — 쉐도우 파트너(178) Lv5 + 다크 사이트(184) +
	-- 크리티컬 엣지(181, 둘 다 슬롯 없는 패시브) 보유 시 등장. 기존 쉐도우 파트너는 소환된 1체가 매번
	-- "기본공격이거나 슬롯 스킬 중 무작위"를 섞어서 썼는데, 이걸 역할이 고정된 2체로 분리한다 — 1체는
	-- 슬롯 스킬만 무작위로 복사(기본공격 172 제외, 110/120/130%), 다른 1체는 기본공격만(110/130/150%).
	-- 두 분신은 서로 완전히 독립적인 행동 주기/바쁨 상태를 가진다(같은 스킬을 동시에 쓸 필요가 없으므로
	-- 별개 타이머로 굴린다 — 기존 ShadowPartnerAttack/ExecuteShadowPartnerCopy의 "전원 동기화" 구조와
	-- 다름, 그래서 별도 상태(_dualPartnerA/B*)로 관리하고 기존 _shadowPartnerEntities/_shadowPartnerBusy는
	-- 건드리지 않는다). 시각 연출/이동/공격 모션/사후 아이콘 등은 쉐도우 파트너의 리소스(Card178*)를 그대로
	-- 재사용, 아이콘도 동일(a1a46c99..., 유저가 명시적으로 같은 RUID 지정). 쉐도우 파트너 슬롯을 그대로
	-- 넘겨받는다. 3레벨까지만 존재(다른 조합 스킬과 동일).
	@Sync property integer DualShadowPartnerLevel = 0
	property number Card190Cooldown = 10.0  -- 레벨 무관 고정(쉐도우 파트너와 동일, 유저 표)
	property number Card190Duration = 6.0  -- 레벨 무관 고정(쉐도우 파트너 Lv5 기준과 동일, 유저 표: "6")
	-- 유저 지정(2026-08-17): 기본 공격 전담 분신(역할 B)만 크기 10% 축소(Card178Scale 기준 곱연산).
	-- 스킬 복사 분신(역할 A)은 원래 크기 그대로.
	property number Card190BasicPartnerScale = 0.9

	property Entity _dualPartnerAEntity = nil  -- 슬롯 스킬 복사 담당
	property boolean _dualPartnerABusy = false
	property Entity _dualPartnerBEntity = nil  -- 기본 공격 전용
	property boolean _dualPartnerBBusy = false
	property Entity _dualPartnerMap = nil

	-- 슬롯 스킬 복사 분신 대미지 비율 — Lv1:110% / Lv2:120% / Lv3:130% (유저 지정 표)
	method number GetDualShadowPartnerSkillPercent(integer level)
		if level >= 3 then return 1.30
		elseif level >= 2 then return 1.20
		end
		return 1.10
	end

	-- 기본 공격 전용 분신 대미지 비율 — Lv1:110% / Lv2:130% / Lv3:150% (유저 지정 표)
	method number GetDualShadowPartnerBasicPercent(integer level)
		if level >= 3 then return 1.50
		elseif level >= 2 then return 1.30
		end
		return 1.10
	end

	-- 슬롯 스킬 복사 분신 전용 후보 풀 — 슬롯에 배치된 카드만 모은다(기본공격 172는 애초에 슬롯 카드가
	-- 아니라서 자동 제외되고, 자기 자신(190)과 쉐도우 파트너 원본(178)도 명시적으로 뺀다).
	@ExecSpace("ServerOnly")
	method table GetDualShadowPartnerSkillCandidateIndices()
		local pool = {}
		local slots = { self.Slot1Card, self.Slot2Card, self.Slot3Card, self.Slot4Card, self.Slot5Card, self.Slot6Card }
		for _, c in ipairs(slots) do
			if c ~= 0 and c ~= 178 and c ~= 190 then table.insert(pool, c) end
		end
		return pool
	end

	@ExecSpace("ServerOnly")
	method void DualShadowPartnerAttack(number damage, boolean isCrit)
		local map = self:GetCurrentMap()
		if map == nil then return end

		if isvalid(self._dualPartnerAEntity) then self._dualPartnerAEntity:Destroy() end
		if isvalid(self._dualPartnerBEntity) then self._dualPartnerBEntity:Destroy() end
		self._dualPartnerAEntity = nil
		self._dualPartnerBEntity = nil
		self._dualPartnerABusy = false
		self._dualPartnerBBusy = false

		local firstTarget = self:FindClosestInMap(map)
		local basePos = self.Card178SpawnPosition
		if firstTarget ~= nil and isvalid(firstTarget) and isvalid(firstTarget.Entity) then
			local tp = firstTarget.Entity.TransformComponent.Position
			basePos = Vector3(tp.x, tp.y + self.Card178HoverYOffset, self.Card178DepthZ)
		end

		self:PlayShadowPartnerCastEffect(basePos)

		local posA = Vector3(basePos.x - self.Card178MultiSpawnSpacing / 2.0, basePos.y, basePos.z)
		local posB = Vector3(basePos.x + self.Card178MultiSpawnSpacing / 2.0, basePos.y, basePos.z)
		self._dualPartnerAEntity = self:SpawnDualPartnerBody(posA, self.Card178Scale)
		self._dualPartnerBEntity = self:SpawnDualPartnerBody(posB, self.Card178Scale * self.Card190BasicPartnerScale)
		self._dualPartnerMap = map

		local interval = self.Card178ActionInterval
		local actionCount = math.floor(self.Card190Duration / interval)
		for i = 0, actionCount - 1 do
			local delay = self.Card178FirstActionDelay + i * interval
			_TimerService:SetTimerOnce(function() self:DualPartnerARandomAction() end, delay)
			_TimerService:SetTimerOnce(function() self:DualPartnerBBasicAction() end, delay)
		end

		_TimerService:SetTimerOnce(function()
			self:TryEndDualShadowPartnerLife()
		end, self.Card190Duration)

		log("DualShadowPartnerAttack: duration=" .. self.Card190Duration .. " skillPct=" .. math.floor(self:GetDualShadowPartnerSkillPercent(self.DualShadowPartnerLevel) * 100) .. " basicPct=" .. math.floor(self:GetDualShadowPartnerBasicPercent(self.DualShadowPartnerLevel) * 100))
	end

	@ExecSpace("ServerOnly")
	method Entity SpawnDualPartnerBody(Vector3 pos, number scale)
		local partner = self:SpawnEffectWithModel(self.Card178IdleRUID, pos, 0, 1.0, scale, 1.0, "persistenteffect")
		if partner ~= nil and partner.SpriteRendererComponent ~= nil then
			partner.SpriteRendererComponent:ChangeMaterial(self.Card178GlowMaterialId)
		end
		return partner
	end

	-- 유지시간이 다 됐을 때 호출 — 둘 중 하나라도 복제 동작이 재생 중이면(바쁨) 그게 끝날 때까지
	-- 소환 해제를 미룬다(쉐도우 파트너 TryEndShadowPartnerLife와 동일한 패턴).
	@ExecSpace("ServerOnly")
	method void TryEndDualShadowPartnerLife()
		if not isvalid(self) then return end
		if self._dualPartnerABusy or self._dualPartnerBBusy then
			_TimerService:SetTimerOnce(function()
				self:TryEndDualShadowPartnerLife()
			end, 0.1)
			return
		end
		if isvalid(self._dualPartnerAEntity) then
			local r = self._dualPartnerAEntity.SpriteRendererComponent
			if r ~= nil then r.SpriteRUID = self.Card178DieRUID end
			self._dualPartnerAEntity:Destroy(self.Card178DieDuration)
		end
		if isvalid(self._dualPartnerBEntity) then
			local r = self._dualPartnerBEntity.SpriteRendererComponent
			if r ~= nil then r.SpriteRUID = self.Card178DieRUID end
			self._dualPartnerBEntity:Destroy(self.Card178DieDuration)
		end
		self._dualPartnerAEntity = nil
		self._dualPartnerBEntity = nil
		self._dualPartnerMap = nil
	end

	@ExecSpace("ServerOnly")
	method void DualPartnerARandomAction()
		if self.DualShadowPartnerLevel == 0 or self._dualPartnerABusy or not isvalid(self._dualPartnerAEntity) then return end
		local pool = self:GetDualShadowPartnerSkillCandidateIndices()
		if #pool == 0 then return end
		local cardIdx = pool[_UtilLogic:RandomIntegerRange(1, #pool)]
		self:ExecuteDualPartnerAction(1, cardIdx)
	end

	@ExecSpace("ServerOnly")
	method void DualPartnerBBasicAction()
		if self.DualShadowPartnerLevel == 0 or self._dualPartnerBBusy or not isvalid(self._dualPartnerBEntity) then return end
		self:ExecuteDualPartnerAction(2, 172)
	end

	method Entity GetDualPartnerEntity(integer role)
		if role == 1 then return self._dualPartnerAEntity end
		return self._dualPartnerBEntity
	end

	@ExecSpace("ServerOnly")
	method void SetDualPartnerBusy(integer role, boolean busy)
		if role == 1 then self._dualPartnerABusy = busy
		else self._dualPartnerBBusy = busy end
	end

	-- ExecuteShadowPartnerCopy의 단일 분신 버전 — 이동(걷기)→도착 즉시 공격 모션+실제 스킬 실행→대기
	-- 포즈+쿨다운 아이콘→바쁨 해제까지 동일한 흐름이지만 분신 1체·역할별 배율 기준으로 단순화했다.
	-- cardIdx별 실제 실행 분기는 ExecuteShadowPartnerCopy와 동일 목록을 유지한다(새 쉐이드 액티브 스킬
	-- 추가 시 반드시 여기도 같이 추가할 것 — ExecuteShadowPartnerCopy 쪽 주석과 동일한 경고).
	@ExecSpace("ServerOnly")
	method void ExecuteDualPartnerAction(integer role, integer cardIdx)
		local partner = self:GetDualPartnerEntity(role)
		if not isvalid(partner) then return end
		local liveMap = self:GetCurrentMap()
		if liveMap == nil then return end
		self._dualPartnerMap = liveMap

		local targets = self:GetClosestTargetsFromPosition(liveMap, partner.TransformComponent.Position, 1)
		if #targets == 0 then return end
		local target = targets[1]

		self:SetDualPartnerBusy(role, true)

		local renderer = partner.SpriteRendererComponent
		local startPos = partner.TransformComponent.Position
		local targetPos = target.Entity.TransformComponent.Position
		local facingRight = targetPos.x >= startPos.x
		local facingSign = facingRight and 1 or -1
		local destZ = startPos.z

		if renderer ~= nil then
			renderer.FlipX = facingRight
			renderer.SpriteRUID = self.Card178WalkRUID
		end

		_TweenLogic:PlayTween(0.0, 1.0, self.Card178RepositionDuration, EaseType.Linear, function(t)
			if not isvalid(partner) then return end
			local curTargetX = targetPos.x
			local curTargetY = targetPos.y
			if isvalid(target) and isvalid(target.Entity) then
				local ctp = target.Entity.TransformComponent.Position
				curTargetX = ctp.x
				curTargetY = ctp.y
			end
			local curDestY = curTargetY
			if isvalid(target) and target._isFlying then curDestY = startPos.y end
			local curDestX = curTargetX - facingSign * self.Card178AttackForwardOffset
			local x = startPos.x + (curDestX - startPos.x) * t
			local y = startPos.y + (curDestY - startPos.y) * t
			partner.TransformComponent.Position = Vector3(x, y, destZ)
		end)

		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(partner) then return end
			if renderer ~= nil then renderer.SpriteRUID = self.Card178AttackRUID end

			local percent = self:GetDualShadowPartnerBasicPercent(self.DualShadowPartnerLevel)
			if role == 1 then percent = self:GetDualShadowPartnerSkillPercent(self.DualShadowPartnerLevel) end
			local baseDamage = self:GetCardDamage(cardIdx) * percent
			local isCrit = self:RollCrit(cardIdx)

			if cardIdx == 172 then
				if isvalid(target) and isvalid(target.Entity) then
					self:ShadeBasicAttack(baseDamage, isCrit, target)
				end
			else
				self._shadowPartnerCopyActive = true
				self._shadowPartnerFallbackTarget = target
				local forcedTargets = (isvalid(target) and isvalid(target.Entity)) and { target } or {}
				if cardIdx == 171 then self:DoubleStepAttack(baseDamage, isCrit, forcedTargets)
				elseif cardIdx == 173 then self:SavageBlowAttack(baseDamage, isCrit, forcedTargets)
				elseif cardIdx == 174 then self:SmokeGrenadeAttack(baseDamage, isCrit)
				elseif cardIdx == 175 then
					if isvalid(target) and isvalid(target.Entity) then
						local tx = target.Entity.TransformComponent.Position.x
						local shortDestX = tx + facingSign * self.Card178MuspelheimKnockbackDistance
						self:FireMuspelheimShove(liveMap, target, shortDestX, baseDamage, isCrit)
					end
				elseif cardIdx == 176 then self:StealAttack(baseDamage, isCrit, forcedTargets)
				elseif cardIdx == 177 then self:MesoExplosionAttack(baseDamage, isCrit)
				elseif cardIdx == 179 then self:DarkFlareAttack(baseDamage, isCrit, forcedTargets)
				elseif cardIdx == 189 then self:MesoDetonationAttack(baseDamage, isCrit)
				elseif cardIdx == 191 then self:AbyssalFlareAttack(baseDamage, isCrit, forcedTargets)
				end
				self._shadowPartnerCopyActive = false
			end
			log("DualPartnerAction: role=" .. role .. " card=" .. cardIdx .. " dmg=" .. math.floor(isCrit and baseDamage * 2 or baseDamage))

			_TimerService:SetTimerOnce(function()
				if not isvalid(self) or not isvalid(partner) then return end
				if renderer ~= nil then renderer.SpriteRUID = self.Card178IdleRUID end
			end, self.Card178AttackMotionDuration)

			-- 유저 지정(2026-08-17): "기본 공격하는애는(role 2) 스턴없이 이동하자" — 어지러움(쿨다운)
			-- 아이콘을 띄운 채 제자리에 서 있는 사후 대기 단계를 건너뛰고, 공격 모션이 끝나자마자 바로
			-- 바쁨 상태를 풀어 다음 행동 틱에 곧장 다시 걸어다닐 수 있게 한다. 스킬 복사 분신(role 1)은
			-- 기존 그대로(아이콘 표시+대기).
			if role == 1 then
				_TimerService:SetTimerOnce(function()
					if not isvalid(self) or not isvalid(partner) then return end
					local pos = partner.TransformComponent.Position
					local icon = self:SpawnEffectWithModel(self.Card178PostAttackIconRUID, Vector3(pos.x, pos.y + self.Card178PostAttackIconYOffset, pos.z - 0.1), 0, 1.0, 1.0, 1.0, "persistenteffect")
					if icon ~= nil then icon:Destroy(self.Card178PostAttackDuration) end
				end, self.Card178AttackMotionDuration + self.Card178StunDelay)

				_TimerService:SetTimerOnce(function()
					if not isvalid(self) then return end
					self:SetDualPartnerBusy(role, false)
				end, self.Card178AttackMotionDuration + self.Card178StunDelay + self.Card178PostAttackDuration)
			else
				_TimerService:SetTimerOnce(function()
					if not isvalid(self) then return end
					self:SetDualPartnerBusy(role, false)
				end, self.Card178AttackMotionDuration)
			end
		end, self.Card178RepositionDuration)
	end

	-- ── 쉐이드 전용: 다크 플레어 (카드179, 슬롯형 액티브 8호). GetClosestTargets로 뽑힌 타겟마다 캐스트
	-- 연출(Card179CastRUID, 16프레임 실측 기준 1.65초 추정)을 재생하고, 그 연출이 끝나기
	-- Card179HitLeadTime(0.4초, 유저 지정) 전 시점에 타격 연출(hit/0/4~7 수동 프레임 스왑)+사운드+
	-- 대미지+스턴(100% 고정, 2초)이 동시에 들어간다. 유저 지정: "스턴 걸리니깐 연출에 버섯 돌아가는거
	-- 해야한다" — MonsterAI.ApplyStun의 showIndicator=true가 이미 이 회전 마크(스턴 스타) 연출을
	-- 내장하고 있어 그대로 재사용.
	@Sync property integer DarkFlareLevel = 0
	property number Card179Cooldown = 6.0  -- 레벨 무관 고정(유저 표)
	property string Card179CastRUID = "7d8a1679d4ae4dc28f1ff9e68a78798a"
	-- 유저 지적(2026-08-12): "연출이 루프돔" — 16프레임 공식(0.05+0.1*16=1.65초) 추정치가 실제 네이티브
	-- 재생시간보다 길었다. 1차로 0.2초만 깎았더니(1.45) 유저가 "아직도 연출 더 나오는데 루프돔"이라
	-- 여전히 부족했다 — 이 프로젝트의 확립된 결론(SpriteAnimPlayerEndEvent는 클라 도달 지연으로 못
	-- 믿는다, ArrowShotHitRUID 주석 참고)대로 정밀 측정 대신 훨씬 보수적으로 크게 깎는다. 그래도
	-- 여전히 루프 돌거나 반대로 너무 일찍 끊기면(연출이 안 끝난 채 사라짐) 실측 피드백 필요.
	property number Card179CastDuration = 1.0
	property number Card179CastScale = 1.0
	property number Card179CastYOffset = 0.0
	property number Card179HitLeadTime = 0.4  -- 유저 지정: "대미지 타이밍은 연출이 끝나기 0.4초전"
	property any Card179HitFrameRUIDs = {
		"df91cd114cfb42988100e16722cc9917",  -- hit/0/4
		"005bec63f6b5462ea9f51b11dfb8e196",  -- hit/0/5
		"644cd16e122b4cc1891421332cad795f",  -- hit/0/6
		"58719f86ad1c413c8cea7d74d098b3b2",  -- hit/0/7
	}
	property number Card179HitFrameStepDuration = 0.1
	property string Card179HitSoundRUID = "540f3ba45a2c41f2b50029718093041e"
	property number Card179StunDuration = 2.0  -- 레벨 무관 고정(유저 표)
	-- 유저 지정(2026-08-12): "헤일스톤처럼 떨어질때에도 적이 닿으면 데미지 달게" → 이어서 "스킬 연출
	-- 범위만큼 통로도 바꿔야겠지!?" — 헤일스톤(Card15PathWidth=0.5/PathHeight=3.0)은 가느다란 얼음
	-- 기둥 기준이라 그대로 재사용하면 훨씬 큰 다크 플레어 연출(타격 시점 프레임 실측 약 580×500px =
	-- 5.8×5.0유닛, 100px/유닛 환산 — 무스펠하임 반경 산출과 동일한 방식)보다 판정이 눈에 띄게 좁게
	-- 남는다. 가로는 그 절반(half-width 비교 방식)인 2.5로, 세로는 헤일스톤과 비슷한 체감이라 3.0 유지
	-- (실측 전 추정치 — 라이브 확인 후 조정 필요할 수 있음).
	property number Card179PathWidth = 2.5
	property number Card179PathHeight = 3.0

	-- 타당 기준 데미지(레벨별 고정값 — 유저 지정 표)
	method number GetDarkFlareDamage(integer level)
		if level >= 5 then return 240
		elseif level >= 4 then return 210
		elseif level >= 3 then return 190
		elseif level >= 2 then return 160
		end
		return 140
	end

	-- 타겟 수 — Lv1~2:1명 / Lv3~5:2명 (유저 지정 표)
	method integer GetDarkFlareTargetCount(integer level)
		if level >= 3 then return 2 end
		return 1
	end

	@ExecSpace("ServerOnly")
	method void DarkFlareAttack(number damage, boolean isCrit, table forcedTargets)
		-- 유저 지정(2026-08-13): 쉐도우 파트너 전용 forcedTargets(파트너가 서 있는 몬스터 1명 고정) —
		-- 다크 플레어가 레벨3 이상에서 원래 2명을 때리더라도 파트너 대신 실행일 땐 그 1명만.
		local targets = forcedTargets
		if targets == nil then
			targets = self:GetClosestTargets(self:GetDarkFlareTargetCount(self.DarkFlareLevel))
		end
		-- 버그 수정(2026-08-12) — DoubleStepAttack과 동일한 이유/패턴.
		if #targets == 0 then
			if self._shadowPartnerCopyActive and isvalid(self._shadowPartnerFallbackTarget) then
				targets = { self._shadowPartnerFallbackTarget }
			else
				return
			end
		end
		local map = self:GetCurrentMap()

		for _, target in ipairs(targets) do
			if isvalid(target) and isvalid(target.Entity) then
				local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
				local capturedPos = Vector3(p.x, p.y + self.Card179CastYOffset, p.z - 0.1)
				local scaleRatio = self:GetEffectScaleRatio(target)

				local fx = self:SpawnEffectWithModel(self.Card179CastRUID, capturedPos, 0, 1.0, self.Card179CastScale * scaleRatio, 1.0, "skilleffectlong")
				if fx ~= nil then fx:Destroy(self.Card179CastDuration) end

				-- 유저 정책(대상 생사와 무관하게 연출은 항상 재생) — 타격 시점의 좌표/스케일은 캐스트
				-- 시점에 미리 캡처해서 넘긴다(다른 스킬들과 동일한 관례).
				local capturedTarget = target
				local capturedDamage = damage
				local capturedIsCrit = isCrit
				local capturedScaleRatio = scaleRatio
				local capturedTargets = targets
				local capturedMap = map
				local hitDelay = math.max(0, self.Card179CastDuration - self.Card179HitLeadTime)
				_TimerService:SetTimerOnce(function()
					if not isvalid(self) then return end
					self:ResolveDarkFlareHit(capturedTarget, capturedPos, capturedScaleRatio, capturedDamage, capturedIsCrit, capturedMap, capturedTargets)
				end, hitDelay)
			end
		end

		log("DarkFlareAttack: targets=" .. #targets)
	end

	-- 타격 연출(hit/0/4~7 수동 프레임 스왑, "persistenteffect"로 수명 직접 관리)+사운드를 캐스트 시점
	-- 좌표에 재생하고, 대상이 그 사이 죽지 않았으면 대미지+스턴(100%, 고정 2초)을 적용한다. 유저 지정:
	-- "헤일스톤처럼 떨어질때에도 적이 닿으면 데미지 달게" — 헤일스톤(Card15)과 동일하게 착탄 지점
	-- 위쪽 세로 통로(Card179PathWidth×Card179PathHeight) 안에 낀 다른 몬스터도 대미지만 같이 받는다
	-- (스턴은 원래 타겟에게만, allTargets에 이미 들어있는 다른 카드179 타겟은 중복 방지로 제외).
	@ExecSpace("ServerOnly")
	method void ResolveDarkFlareHit(MonsterAI target, Vector3 pos, number scaleRatio, number damage, boolean isCrit, Entity map, table allTargets)
		self:PlayDarkFlareHitSound()

		local frames = self.Card179HitFrameRUIDs
		local fx = self:SpawnEffectWithModel(frames[1], pos, 0, 1.0, self.Card179CastScale * scaleRatio, 1.0, "persistenteffect")
		if fx ~= nil then
			for i = 2, #frames do
				local frameRUID = frames[i]
				local delay = (i - 1) * self.Card179HitFrameStepDuration
				_TimerService:SetTimerOnce(function()
					if isvalid(fx) then
						local r = fx.SpriteRendererComponent
						if r ~= nil then r.SpriteRUID = frameRUID end
					end
				end, delay)
			end
			fx:Destroy(#frames * self.Card179HitFrameStepDuration + 0.05)
		end

		if isvalid(target) and isvalid(target.Entity) and not target._dead then
			if isCrit then target:TakeDamageCrit(damage * 2)
			else target:TakeDamage(damage) end
			target:ApplyStun(self.Card179StunDuration, true)
		end

		if map == nil then return end
		local pathHitCount = 0
		local monsters = self:GetMonstersInCurrentZone(map)
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and isvalid(m.Entity) and not m._dead and m ~= target then
				local isOtherPrimary = false
				for _, t2 in ipairs(allTargets) do
					if m == t2 then isOtherPrimary = true break end
				end
				if not isOtherPrimary then
					local mp = m.Entity.TransformComponent.Position
					local dxPath = math.abs(mp.x - pos.x)
					local inPath = dxPath <= self.Card179PathWidth and mp.y > pos.y and (mp.y - pos.y) <= self.Card179PathHeight
					if inPath then
						if isCrit then m:TakeDamageCrit(damage * 2)
						else m:TakeDamage(damage) end
						pathHitCount = pathHitCount + 1
					end
				end
			end
		end
		if pathHitCount > 0 then log("DarkFlareAttack: path hit=" .. pathHitCount) end
	end

	@ExecSpace("Multicast")
	method void PlayDarkFlareHitSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.Card179HitSoundRUID, 1.0)
	end

	-- ── 쉐이드 조합 스킬: 어비설 플레어 (카드191) — 다크 플레어(179) Lv5 + 대거 액셀레이션(180) +
	-- 피지컬 트레이닝(183, 둘 다 슬롯 없는 패시브) 보유 시 등장. 캐스트 연출은 다크 플레어와 완전히
	-- 동일(Card179CastRUID/CastDuration/HitLeadTime 그대로 재사용, 신규 리소스팩에도 같은 RUID가
	-- "effect"로 들어있음). 다크 플레어의 "타격+스턴" 대신, 같은 타이밍에 새 프레임(summon/stand/12~15,
	-- 다크 플레어의 hit/0/4~7과 동일한 수동 프레임 스왑 기법)으로 "칼이 꼽히는" 연출을 재생하고, 그
	-- 타이밍에 연무(안개)를 발생시킨다 — 연무는 지속시간(레벨별 2/3/4초) 동안 끊기지 않고 유지되며 그
	-- 범위 안의 몬스터 전부에게 매초 틱 대미지(기준 데미지의 30/40/50%)를 입힌다. 스턴은 없음(유저
	-- 표: 특수효과/확률 칸이 비어있고 틱데미지만 명시). 다크 플레어 슬롯을 그대로 넘겨받는다. 3레벨까지만 존재.
	@Sync property integer AbyssalFlareLevel = 0
	property number Card191Cooldown = 6.0  -- 레벨 무관 고정(다크 플레어와 동일, 유저 표)
	property string Card191IconRUID = "b210de14b51f41608a208b1a0764697f"

	-- "다크 플레어" 리소스팩(신규 요소) — "칼이 꼽히는" 연출용 4프레임(summon/stand/12~15)
	property any Card191StabFrameRUIDs = {
		"bc62499c10fd4f018c821178b8245dfc",  -- summon/stand/12
		"7d2133b723854e96a68726f619b8039f",  -- summon/stand/13
		"9f832c36252849f89abe91a1b2c06055",  -- summon/stand/14
		"552cd33d30cc4427b42d45a4071e1c06",  -- summon/stand/15
	}
	property number Card191StabFrameStepDuration = 0.1  -- 다크 플레어 히트프레임(Card179HitFrameStepDuration)과 동일 간격 재사용
	property string Card191StabSoundRUID = "540f3ba45a2c41f2b50029718093041e"  -- audio/Use(다크 플레어 히트사운드와 동일 RUID)
	property string Card191FogAppearSoundRUID = "7b93fc6f8ec3479bbfb1311058b3d983"  -- audio/Attack1(연무 발생 전용, 신규)

	-- 유저 재지정(2026-08-17): "연무 연출(summon/repeat) 빼줘, 그냥 칼꼽히고 12~15 거기 부분만
	-- 필요한거야, 12~15가 n초동안 지속되어야해" — 별도 연무 스폰 없이, 칼이 꽂히는 4프레임을 지속시간
	-- (duration) 내내 루프 재생한다. 틱 판정은 타원(가로/세로 반경 개별)으로 유지.
	-- 유저 지정(2026-08-18): "범위가 좌우로 0.3 정도 더 길어야하고" — 세로는 기존 1.5 유지, 가로만 1.8로.
	property number Card191FogHalfWidth = 1.8
	property number Card191FogHalfHeight = 1.5
	-- 유저 지정(2026-08-18): "사라질땐 알파 빠지면서 자연스럽게" — 연막탄(SmokeGrenadeFadeOutDuration=0.4)과
	-- 동일 패턴으로 지속시간 끝나기 이 시간 전부터 알파를 0으로 낮춘다.
	property number Card191FogFadeOutDuration = 0.4

	-- 타당 기준 데미지(레벨별 고정값 — 유저 지정 표, 틱 대미지 계산의 기준값)
	method number GetAbyssalFlareDamage(integer level)
		if level >= 3 then return 300
		elseif level >= 2 then return 280
		end
		return 260
	end

	-- 틱 대미지 비율 — Lv1:30% / Lv2:40% / Lv3:50% (유저 지정 표, 초당 기준 데미지에 곱)
	method number GetAbyssalFlareTickPercent(integer level)
		if level >= 3 then return 0.50
		elseif level >= 2 then return 0.40
		end
		return 0.30
	end

	-- 연무 지속시간(=틱 횟수) — Lv1:2초 / Lv2:3초 / Lv3:4초 (유저 지정 표)
	method integer GetAbyssalFlareDuration(integer level)
		if level >= 3 then return 4
		elseif level >= 2 then return 3
		end
		return 2
	end

	-- 1단계: 캐스트(다크 플레어와 동일 연출/타이밍). 타겟 수는 레벨 무관 항상 1명(유저 표).
	@ExecSpace("ServerOnly")
	method void AbyssalFlareAttack(number damage, boolean isCrit, table forcedTargets)
		local targets = forcedTargets
		if targets == nil then
			targets = self:GetClosestTargets(1)
		end
		if #targets == 0 then
			if self._shadowPartnerCopyActive and isvalid(self._shadowPartnerFallbackTarget) then
				targets = { self._shadowPartnerFallbackTarget }
			else
				return
			end
		end
		local map = self:GetCurrentMap()
		if map == nil then return end
		local target = targets[1]
		if not isvalid(target) or not isvalid(target.Entity) then return end

		local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
		local capturedPos = Vector3(p.x, p.y + self.Card179CastYOffset, p.z - 0.1)
		-- 버그 수정(2026-08-17, 유저 지적: "연무 범위는 틱대미지 들어가야하는데 안들어가는듯") — 틱
		-- 판정용 중심좌표는 다른 몬스터의 mp(Entity.TransformComponent.Position, 로컬)와 같은 좌표계여야
		-- 하는데, WorldToCurrentMapLocal로 변환한 capturedPos(연출 배치용)를 그대로 재사용해서 좌표계가
		-- 어긋나 있었다(연막탄의 centerPos와 동일하게 분리) — 틱 판정은 target 자신의 로컬 Position을 쓴다.
		local centerPos = target.Entity.TransformComponent.Position
		local scaleRatio = self:GetEffectScaleRatio(target)

		local fx = self:SpawnEffectWithModel(self.Card179CastRUID, capturedPos, 0, 1.0, self.Card179CastScale * scaleRatio, 1.0, "skilleffectlong")
		if fx ~= nil then fx:Destroy(self.Card179CastDuration) end

		local capturedMap = map
		local capturedDamage = damage
		local capturedIsCrit = isCrit
		local capturedScaleRatio = scaleRatio
		local hitDelay = math.max(0, self.Card179CastDuration - self.Card179HitLeadTime)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self:ResolveAbyssalFlareStab(capturedPos, centerPos, capturedScaleRatio, capturedDamage, capturedIsCrit, capturedMap)
		end, hitDelay)

		log("AbyssalFlareAttack: target=1")
	end

	-- 2단계: "칼이 꼽히는" 연출(수동 프레임 스왑, 다크 플레어와 동일 기법) + 사운드. 유저 지정:
	-- "12~15는 지속시간동안 루프되야지" — 4프레임(12→13→14→15)을 한 번만 재생하고 멈추는 게 아니라
	-- 지속시간(duration) 내내 그 사이클을 계속 반복 재생한다. 그동안 매초(첫 틱은 즉시) centerPos
	-- 반경 안 몬스터 전부에게 틱 대미지를 적용한다.
	@ExecSpace("ServerOnly")
	method void ResolveAbyssalFlareStab(Vector3 pos, Vector3 centerPos, number scaleRatio, number damage, boolean isCrit, Entity map)
		self:PlayAbyssalFlareStabSound()
		self:PlayAbyssalFogAppearSound()
		local duration = self:GetAbyssalFlareDuration(self.AbyssalFlareLevel)
		local frames = self.Card191StabFrameRUIDs
		local frameCount = #frames
		local fx = self:SpawnEffectWithModel(frames[1], pos, 0, 1.0, self.Card179CastScale * scaleRatio, 1.0, "persistenteffect")
		if fx ~= nil then
			local totalSteps = math.floor(duration / self.Card191StabFrameStepDuration)
			for i = 1, totalSteps - 1 do
				local frameRUID = frames[(i % frameCount) + 1]
				local delay = i * self.Card191StabFrameStepDuration
				_TimerService:SetTimerOnce(function()
					if isvalid(fx) then
						local r = fx.SpriteRendererComponent
						if r ~= nil then r.SpriteRUID = frameRUID end
					end
				end, delay)
			end
			-- 유저 지정(2026-08-18): "사라질땐 알파 빠지면서 자연스럽게" — Destroy 직전 FadeOutDuration
			-- 동안 알파를 1.0→0.0으로 선형 트윈(연막탄과 동일 패턴).
			local fadeDuration = math.min(self.Card191FogFadeOutDuration, duration)
			local fadeDelay = duration - fadeDuration
			_TimerService:SetTimerOnce(function()
				if not isvalid(fx) then return end
				local renderer = fx.SpriteRendererComponent
				if renderer == nil then return end
				_TweenLogic:PlayTween(1.0, 0.0, fadeDuration, EaseType.Linear, function(alpha)
					if isvalid(renderer) then renderer:SetAlpha(alpha) end
				end)
			end, fadeDelay)
			fx:Destroy(duration)
		end

		local tickDamage = damage * self:GetAbyssalFlareTickPercent(self.AbyssalFlareLevel)
		-- 유저 지정(2026-08-18): "범위가 좌우로 0.3 정도 더 길어야하고" — 원형 반경 대신 가로/세로
		-- 반경이 다른 타원 판정(메소익스플로전/메소데토네이션과 동일 공식)으로 전환.
		local halfWidth = self.Card191FogHalfWidth
		local halfHeight = self.Card191FogHalfHeight
		local capturedMap = map
		local applyTick = function()
			if not isvalid(capturedMap) then return end
			local monsters = self:GetMonstersInCurrentZone(capturedMap)
			local hitCount = 0
			for _, mob in ipairs(monsters) do
				---@type MonsterAI
				local m = mob
				if isvalid(m) and isvalid(m.Entity) and not m._dead then
					local mp = m.Entity.TransformComponent.Position
					local nx = (mp.x - centerPos.x) / halfWidth
					local ny = (mp.y - centerPos.y) / halfHeight
					if (nx * nx + ny * ny) <= 1.0 then
						hitCount = hitCount + 1
						if isCrit then m:TakeDamageCrit(tickDamage * 2)
						else m:TakeDamage(tickDamage) end
					end
				end
			end
			log("AbyssalFlare: tick dmg=" .. math.floor(tickDamage) .. " hit=" .. hitCount)
		end

		applyTick()
		for tickIdx = 1, duration - 1 do
			local delay = tickIdx * 1.0
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				applyTick()
			end, delay)
		end
	end

	@ExecSpace("Multicast")
	method void PlayAbyssalFlareStabSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.Card191StabSoundRUID, 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayAbyssalFogAppearSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.Card191FogAppearSoundRUID, 1.0)
	end

	-- 주어진 좌표에서 실제 거리로 가장 가까운 살아있는 몬스터 최대 count명을 반환(피닉스의
	-- FindClosestByPosition을 다중 타겟으로 확장한 버전 — 쉐도우 파트너 Lv5 전용 2타겟에 필요)
	@ExecSpace("ServerOnly")
	method table GetClosestTargetsFromPosition(Entity map, Vector3 fromPos, integer count)
		if map == nil then return {} end
		local monsters = self:GetMonstersInCurrentZone(map)
		local candidates = {}
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then table.insert(candidates, m) end
		end
		table.sort(candidates, function(a, b)
			local ap = a.Entity.TransformComponent.Position
			local bp = b.Entity.TransformComponent.Position
			local adx, ady = ap.x - fromPos.x, ap.y - fromPos.y
			local bdx, bdy = bp.x - fromPos.x, bp.y - fromPos.y
			return (adx * adx + ady * ady) < (bdx * bdx + bdy * bdy)
		end)
		local result = {}
		for i = 1, math.min(count, #candidates) do table.insert(result, candidates[i]) end
		return result
	end

	-- ── 레이온 전용: 리프 어택 (카드 158, 슬롯형 액티브 7호) — GetClosestTargets로 뽑힌 각 타겟마다
	-- 개별로 연출1(base=e36aeb78 실측0.48초 + overlay=89557cad 실측0.54초, 동시 스폰 — 리소스 메타데이터로
	-- 확인한 결과 e36aeb78/89557cad/1546c866/b78adf56 전부 같은 네이티브 스킬 1001010 소속이고, e36aeb78는
	-- "effect", 89557cad는 "effect0"라 원본 스킬에서 같이 겹쳐 재생되는 한 쌍으로 판단해 동시 스폰함
	-- — 유저가 준 텍스트에서 라벨이 안 붙어있었던 게 바로 이 리소스였다)+연출2/타격(1546c866, 실측
	-- 0.36초)을 재생하고 데미지 + 콤보스택 +1을 적용한 뒤, MonsterAI:ApplyStun(자체 연출이 있으니
	-- showIndicator=false, 아쿠아 트랩과 동일 관례)+ApplyLevitate를 같은 duration(1초, 유저 지정:
	-- "튀어오르고 착지까지 1S", 레벨 무관 고정)으로 같이 걸어 "살짝 튀어올랐다 착지할 때까지 행동불가"를
	-- 구현한다(ApplyLevitate는 자체적으로 뜨고 내려오는 트윈까지 처리해준다 — 아쿠아 트랩/서지가 쓰는
	-- 기존 API 그대로 재사용). 사운드는 실제로 1개(b78adf56, audioclip 확인됨)뿐이라 캐스트 시점에
	-- 한 번만 재생한다(처음에 "e36aeb78"도 사운드인 줄 알고 착지 시점에 재생시켰다가, 리소스 메타데이터
	-- 조회 결과 animationclip으로 밝혀져 [LEA-3015] 로드 에러가 나서 바로잡음).
	@Sync property integer LeapAttackLevel = 0
	property number Card158Cooldown = 4.5
	property number LeapAttackRootDuration = 1.0  -- 레벨 무관 고정(유저 지정)
	property number LeapAttackEffectScale = 1.0
	property string LeapAttackEffectBaseRUID = "e36aeb7845994c44997d6fd55e4dfbda"
	-- 유저 지적: "1회만 나와야하는데 루프돌아서 살짝 더나온다" — 실측 0.48초에 여유(+0.05)를 더했더니
	-- 그 여유 구간에서 네이티브 루프가 이미 다시 시작해 앞부분이 살짝 겹쳐 보였다(애로우샷/바람의 시
	-- 히트연출 주석의 기존 결론과 동일한 원인: SpriteAnimPlayerEndEvent로 정확히 끊는 것도 클라 도달
	-- 지연 때문에 못 믿는다 — 서버 Destroy 타이머를 실측보다 살짝 짧게 걸어 "끝까지 다 안 보여도
	-- 루프는 절대 안 보이게"로 방향을 바꿈).
	property number LeapAttackEffectBaseLifetime = 0.4  -- 실측 0.48초보다 짧게(루프 방지 우선)
	property string LeapAttackEffectRUID = "89557cad15f148f388269cc4fa35c4fd"
	property number LeapAttackEffectLifetime = 0.45  -- 실측 0.54초보다 짧게(루프 방지 우선)
	property string LeapAttackHitRUID = "1546c866534d47cb9fc8bbf7bedada73"
	property number LeapAttackHitLifetime = 0.3  -- 실측 0.36초보다 짧게 — 코드베이스 공용 HitEffectLifetime과 동일값
	property string LeapAttackSoundRUID = "b78adf56fe644dc3babf7024aa5a21f8"

	-- 타당 데미지(레벨별 고정값 — 유저 지정 표)
	method number GetLeapAttackDamage(integer level)
		if level >= 5 then return 240
		elseif level >= 4 then return 200
		elseif level >= 3 then return 160
		elseif level >= 2 then return 140
		end
		return 120
	end

	-- 타겟 수 — Lv1:1 / Lv2-4:2 / Lv5:3 (유저 지정 표)
	method integer GetLeapAttackTargetCount(integer level)
		if level >= 5 then return 3 end
		if level >= 2 then return 2 end
		return 1
	end

	@ExecSpace("ServerOnly")
	method void LeapAttackAttack(number damage, boolean isCrit)
		local targets = self:GetClosestTargets(self:GetLeapAttackTargetCount(self.LeapAttackLevel))
		if #targets == 0 then return end

		self:PlayLeapAttackSound()

		for _, target in ipairs(targets) do
			local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
			local scaleRatio = self:GetEffectScaleRatio(target)

			local fxBase = self:SpawnEffectWithModel(self.LeapAttackEffectBaseRUID, Vector3(p.x, p.y, p.z - 0.1), 0, 1.0, self.LeapAttackEffectScale * scaleRatio, 1.0, "skilleffectlong")
			if fxBase ~= nil then fxBase:Destroy(self.LeapAttackEffectBaseLifetime) end
			local fx = self:SpawnEffectWithModel(self.LeapAttackEffectRUID, Vector3(p.x, p.y, p.z - 0.1), 0, 1.0, self.LeapAttackEffectScale * scaleRatio, 1.0, "skilleffectlong")
			if fx ~= nil then fx:Destroy(self.LeapAttackEffectLifetime) end
			local hfx = self:SpawnEffectWithModel(self.LeapAttackHitRUID, Vector3(p.x, p.y, p.z), 0, 1.0, self.LeapAttackEffectScale * scaleRatio, 1.0, "skilleffectlong")
			if hfx ~= nil then hfx:Destroy(self.LeapAttackHitLifetime) end

			local appliedDamage = damage
			if isCrit then
				appliedDamage = damage * 2
				target:TakeDamageCrit(appliedDamage)
			else
				target:TakeDamage(appliedDamage)
			end
			target:AddComboStack(appliedDamage)
			self:TryExtraComboStack(158, target, appliedDamage)
			target:ApplyStun(self.LeapAttackRootDuration, false)
			target:ApplyLevitate(self.LeapAttackRootDuration)
		end

		log("LeapAttackAttack: targets=" .. #targets)
	end

	@ExecSpace("Multicast")
	method void PlayLeapAttackSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.LeapAttackSoundRUID, 1.0)
	end

	-- ── 레이온 전용 조합 스킬: 브레이브 슬래시 (카드 160) — 브랜디쉬(153) Lv5 + 리프 어택(158) Lv5
	-- 보유 시 등장(더블 커터와 동일한 "선행카드 2개 동시소모" 패턴 — 브랜디쉬 슬롯을 그대로 넘겨받고
	-- 리프 어택 슬롯은 비운다). 대상마다 브랜디쉬처럼 개별 스윙+타격 연출을 재생하되, 콤보스택은
	-- +2(AddComboStack 2회 호출)로 두 배 적용하고, 리프 어택의 ApplyLevitate(공중 띄우기)는 쓰지 않고
	-- 스턴만 2초 100% 건다(유저 표에 "스턴"만 명시, 도약 연출 없음). 이름/아이콘/태그는
	-- CardRegistry(160)에서 관리, 데미지/쿨타임/타겟수/스턴은 이 스크립트에서 관리.
	@Sync property integer BraveSlashLevel = 0
	property number Card160Cooldown = 3.0  -- 레벨 무관 고정(유저 표)
	property number BraveSlashStunDuration = 2.0  -- 레벨 무관 고정(유저 표)
	property string BraveSlashSwingEffectRUID = "f7286265340c49dc8b3bbed151c75b82"
	-- 이 클립은 13프레임짜리라(브랜디쉬 10프레임/0.6초, 오라블레이드 15프레임/0.9초와 동일하게
	-- 프레임당 0.06초로 환산하면 13프레임=0.78초) 기존 0.4초로는 절반쯤에서 잘렸다 — 유저 지적으로 수정
	property number BraveSlashSwingEffectLifetime = 0.8
	property string BraveSlashHitEffectRUID = "f5b2ce0a2286437db948e5ebefaf3b29"
	property number BraveSlashHitEffectLifetime = 0.3
	property string BraveSlashSoundRUID = "01641f672ecd4a7b9a7d065ce59f887e"
	property number BraveSlashEffectScale = 1.0

	-- 타당 데미지(레벨별 고정값 — 유저 지정 표)
	method number GetBraveSlashDamage(integer level)
		if level >= 3 then return 450
		elseif level >= 2 then return 400
		end
		return 350
	end

	-- 타겟 수(GetClosestTargets로 선정) — Lv1-2:3 / Lv3:4 (유저 지정 표)
	method integer GetBraveSlashTargetCount(integer level)
		if level >= 3 then return 4 end
		return 3
	end

	@ExecSpace("ServerOnly")
	method void BraveSlashAttack(number damage, boolean isCrit)
		local targets = self:GetClosestTargets(self:GetBraveSlashTargetCount(self.BraveSlashLevel))
		if #targets == 0 then return end

		self:PlayBraveSlashSound()

		for _, target in ipairs(targets) do
			local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
			local scaleRatio = self:GetEffectScaleRatio(target)

			local fx = self:SpawnEffectWithModel(self.BraveSlashSwingEffectRUID, Vector3(p.x, p.y, p.z - 0.1), 0, 1.0, self.BraveSlashEffectScale * scaleRatio, 1.0, "skilleffectlong")
			if fx ~= nil then fx:Destroy(self.BraveSlashSwingEffectLifetime) end
			local hfx = self:SpawnEffectWithModel(self.BraveSlashHitEffectRUID, Vector3(p.x, p.y, p.z), 0, 1.0, self.BraveSlashEffectScale * scaleRatio, 1.0, "skilleffectlong")
			if hfx ~= nil then hfx:Destroy(self.BraveSlashHitEffectLifetime) end

			local appliedDamage = damage
			if isCrit then
				appliedDamage = damage * 2
				target:TakeDamageCrit(appliedDamage)
			else
				target:TakeDamage(appliedDamage)
			end
			target:AddComboStack(appliedDamage)
			target:AddComboStack(appliedDamage)
			-- SkillInventory 브레이브 슬래시(인덱스48) Lv9: 스턴 지속시간 +1초, 카드 자체 레벨과 별개로 항상 가산
			target:ApplyStun(self.BraveSlashStunDuration + self:GetSkillInvTierPercent(48, 0, 0, 1.0), true)
		end

		log("BraveSlashAttack: hit=" .. #targets .. "/" .. self:GetBraveSlashTargetCount(self.BraveSlashLevel))
	end

	@ExecSpace("Multicast")
	method void PlayBraveSlashSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.BraveSlashSoundRUID, 1.0)
	end

	-- ── 레이온 전용: 스카링 소드 (카드 159, 슬롯형 액티브 8호) — 피닉스(카드105)와 동일한 "소환수"
	-- 패턴을 재사용한다(유저 지정: "피닉스처럼 같은 매카니즘"). 시전 시 최근접 적 근처에서 검 한 자루가
	-- 소환되고, 유지시간(레벨별 4~5초) 동안 고정 간격(2초, 레벨 무관)으로 그 시점 최근접 적에게 날아가
	-- 2연타(각 50%)를 꽂은 뒤 다시 대기 자세로 돌아온다 — 유지시간/간격 계산상 모든 레벨에서 항상
	-- 정확히 2회의 공격 사이클(=4회 타격)이 나온다(유저 확인 예시: "4초 유지, 2초 간격 → 총 2회의
	-- 2연타 공격"). 피닉스와 달리 반경 판정(광역 스플래시)은 쓰지 않는다 — 타겟 수가 레벨 무관 항상
	-- 1명이라(유저 표), "연출 범위 광역"은 이펙트가 시각적으로 크게/넓게 보인다는 뜻으로 해석해 큰
	-- Scale로만 반영하고 대미지는 추적 중인 단일 대상에게만 직접 적용한다. 피닉스의 "몸통을 공격
	-- 지점에서 물러 세우는" 연출(FlameForwardOffset)도 화염 특유의 연출이라 검에는 불필요해 생략 —
	-- 검은 타겟 위치로 직접 날아가 그 자리에서 찌른다.
	@Sync property integer ScarringSwordLevel = 0
	property string Card159Name = "스카링 소드"
	property string Card159IconRUID = "f97f557e480f482db24679f0d53e6e30"
	property number Card159Cooldown = 9.0  -- 레벨 무관 고정(유저 표)
	property number Card159AttackInterval = 2.0  -- 레벨 무관 고정(유저 확인: "2초 간격")
	property number Card159HitInterval = 0.35  -- 2연타 사이 간격 — 레이징 블로우와 동일 간격 재사용
	property number Card159Scale = 0.91  -- 유저 요청으로 30% 축소(1.3 * 0.7)
	property number Card159HitScale = 1.0
	property number Card159HitRadius = 1.5  -- 찌르는 모션이 닿는 범위 판정(2026-08-05: 1.2→1.3, 유저 지적 — 연출보다 판정이 좁아 보임 / 2026-08-07: 1.3→1.5, 유저 요청으로 +0.2 확장)
	property Vector3 Card159SpawnPosition = Vector3(0, 3.0, -0.1)  -- 근처에 적이 하나도 없을 때만 쓰는 대체 위치(피닉스와 동일값 재사용)
	property number Card159HoverYOffset = 0.1  -- 타겟 위치 기준 높이 오프셋
	property number Card159DepthZ = -2.0  -- 몬스터 Z 범위보다 앞선 고정값 — 항상 몬스터 위에 그려지게(피닉스/허수아비와 동일 방식)
	-- 실측(_ResourceService:LoadAnimationClipAndWait): 소환 11프레임/0.99초, 이동(stand) 8프레임/0.96초,
	-- 공격 10프레임/0.90초, 히트 6프레임/0.54초, 사라짐 8프레임/0.96초. 리프 어택에서 확립한 교훈대로
	-- (SpriteAnimPlayerEndEvent는 클라 도달 지연으로 못 믿는다) 스프라이트 전환/Destroy 타이밍은 실측보다
	-- 살짝 짧게 잡아 루프 재시작 플래시를 방지한다 — 피닉스의 Card105DieDuration(8프레임 실측보다 축소)도
	-- 동일한 이유로 이미 이렇게 처리돼 있었다.
	property number Card159SummonAppearDuration = 0.94  -- 실측 0.99초보다 짧게
	property number Card159RepositionDuration = 0.3  -- 타겟 위치로 이동하는 시간(피닉스와 동일)
	property number Card159Hit1Delay = 0.3  -- 공격 포즈 시작 후 1타가 들어가는 시점(0.90초 클립 안에 2타 모두 들어가도록)
	property number Card159HitLifetime = 0.49  -- 실측 0.54초보다 짧게
	property number Card159DieDuration = 0.9  -- 실측 0.96초보다 짧게
	property string Card159SummonedRUID = "cb8d8eb3c0a342179c73d606951b4331"  -- 소환 연출
	property string Card159MoveRUID = "9180909395934b4ab2dfb47f87864813"  -- 이동(대기) 연출 — 네이티브 경로상 "stand"지만 유저가 "이동 연출"로 지정, 대기와 이동 겸용으로 재생
	property string Card159AttackRUID = "9f615337b9ee463e9e7fbc40c92dc18a"  -- 공격 연출
	property string Card159HitRUID = "d750662cf8424955928240748813605e"  -- 히트 연출
	property string Card159DieRUID = "e27c66de556843fd826184d0ddc9da18"  -- 사라지는 연출
	property string Card159SoundRUID = "0051f5688445447aa6cc9ccbd8e8fdb5"
	property Entity _swordEntity = nil
	property Entity _swordMap = nil  -- 소드가 현재 있는 맵(존 이동 감지용)
	-- Entity 비교로는 ep2_map3/ep2_map4(존 10개 공유 파일)에서 존 이동이 감지 안 되는 버그 수정 —
	-- _shadowPartnerZoneIndex 선언부 주석 참고
	property integer _swordZoneIndex = -1
	property Vector3 _swordAnchorPos = Vector3(0, 0, 0)  -- 소환된(또는 존 이동 후 재소환된) 고정 위치 — 타겟 탐색 기준점(피닉스와 동일)
	property boolean _swordFacingRight = false
	property boolean _swordAttackInProgress = false  -- true인 동안은 유지시간 만료로 인한 소환 해제를 미룬다(피닉스와 동일)

	method number GetScarringSwordDamage(integer level)
		if level >= 5 then return 240
		elseif level >= 4 then return 200
		elseif level >= 3 then return 160
		elseif level >= 2 then return 140
		end
		return 120
	end

	-- 유지시간 — Lv1-2:4초 / Lv3-5:5초(유저 표). Card159AttackInterval=2초 고정이라
	-- floor(duration/interval)은 두 구간 모두 2가 나와, 결과적으로 모든 레벨에서 2회 공격으로 동일하다.
	method number GetScarringSwordDuration(integer level)
		if level >= 3 then return 5 end
		return 4
	end

	@ExecSpace("ServerOnly")
	method void ScarringSwordAttack(number damage, boolean isCrit)
		local map = self:GetCurrentMap()
		if map == nil then return end

		-- 이미 소환된 소드가 남아있으면 정리 후 재소환(쿨타임 9초가 유지시간 4~5초보다 항상 길어서
		-- 정상 플레이에선 거의 발생하지 않지만 방어적으로 처리 — 피닉스와 동일한 이유)
		if isvalid(self._swordEntity) then
			self._swordEntity:Destroy()
			self._swordEntity = nil
		end
		self._swordAttackInProgress = false

		self:PlayScarringSwordSound()

		local duration = self:GetScarringSwordDuration(self.ScarringSwordLevel)
		local leadTime = self.Card159SummonAppearDuration
		local interval = self.Card159AttackInterval

		local firstTarget = self:FindClosestInMap(map)
		local spawnPos = self.Card159SpawnPosition
		if firstTarget ~= nil and isvalid(firstTarget) and isvalid(firstTarget.Entity) then
			local tp = firstTarget.Entity.TransformComponent.Position
			spawnPos = Vector3(tp.x, tp.y + self.Card159HoverYOffset, self.Card159DepthZ)
		end

		-- "persistenteffect"(자동 소멸 스크립트 없음) — 피닉스와 동일한 이유로, 수명을 아래 타이머로
		-- 직접 100% 관리한다(skilleffect/skilleffectlong 고정 Duration으로는 소드의 실제 수명을 못 버팀).
		local sword = self:SpawnEffectWithModel(self.Card159SummonedRUID, spawnPos, 0, 1.0, self.Card159Scale, 1.0, "persistenteffect")
		if sword == nil then return end
		self._swordEntity = sword
		self._swordMap = map
		self._swordZoneIndex = _MapManager.CurrentMapIndex
		self._swordAnchorPos = spawnPos

		_TimerService:SetTimerOnce(function()
			local fx = self._swordEntity
			if isvalid(fx) then
				local r = fx.SpriteRendererComponent
				if r ~= nil then r.SpriteRUID = self.Card159MoveRUID end
			end
		end, leadTime)

		local attackCount = math.floor(duration / interval)
		for i = 0, attackCount - 1 do
			local delay = leadTime + i * interval
			_TimerService:SetTimerOnce(function()
				self:ScarringSwordAttackTick(damage, isCrit)
			end, delay)
		end

		_TimerService:SetTimerOnce(function()
			self:TryEndScarringSwordLife()
		end, leadTime + duration)

		log("ScarringSwordAttack: duration=" .. duration .. " attacks=" .. attackCount .. " dmg=" .. math.floor(damage))
	end

	@ExecSpace("Multicast")
	method void PlayScarringSwordSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.Card159SoundRUID, 1.0)
	end

	-- 유지시간이 다 됐을 때 호출된다. 공격이 진행 중이면 끝날 때까지 미뤘다가 사라진다(피닉스와 동일)
	@ExecSpace("ServerOnly")
	method void TryEndScarringSwordLife()
		if not isvalid(self) then return end
		if self._swordAttackInProgress then
			_TimerService:SetTimerOnce(function()
				self:TryEndScarringSwordLife()
			end, 0.1)
			return
		end
		local fx = self._swordEntity
		if isvalid(fx) then
			local r = fx.SpriteRendererComponent
			if r ~= nil then r.SpriteRUID = self.Card159DieRUID end
			fx:Destroy(self.Card159DieDuration)
		end
		self._swordEntity = nil
		self._swordMap = nil
	end

	-- 존 이동 감지 시 소드를 플레이어의 새 맵으로 다시 소환한다(피닉스의 RelocatePhoenixToNewMap과 동일)
	@ExecSpace("ServerOnly")
	method void RelocateScarringSwordToNewMap(Entity newMap)
		local old = self._swordEntity
		local anchor = self:FindClosestInMap(newMap)
		local pos = self.Card159SpawnPosition
		if anchor ~= nil and isvalid(anchor) and isvalid(anchor.Entity) then
			local ap = anchor.Entity.TransformComponent.Position
			pos = Vector3(ap.x, ap.y + self.Card159HoverYOffset, self.Card159DepthZ)
		end
		local fresh = self:SpawnEffectWithModel(self.Card159MoveRUID, pos, 0, 1.0, self.Card159Scale, 1.0, "persistenteffect")
		if fresh == nil then return end
		if isvalid(old) then old:Destroy() end
		self._swordEntity = fresh
		self._swordMap = newMap
		self._swordZoneIndex = _MapManager.CurrentMapIndex
		self._swordAnchorPos = pos
	end

	-- 공격 1회 — self._swordEntity/_swordMap을 그때그때 다시 읽어서(캡처된 값 아님) 존 이동을 감지하고,
	-- 소환된(고정) 위치 기준 실거리 최근접 적에게 이동한 뒤 2연타(각 50%)를 꽂는다(피닉스와 동일 구조,
	-- 반경 판정 없이 그 대상 1명에게만 직접 적용).
	@ExecSpace("ServerOnly")
	method void ScarringSwordAttackTick(number damage, boolean isCrit)
		if not isvalid(self) then return end
		local sword = self._swordEntity
		if not isvalid(sword) then return end

		if _MapManager.CurrentMapIndex ~= self._swordZoneIndex then
			local liveMap = self:GetCurrentMap()
			if liveMap ~= nil then
				self:RelocateScarringSwordToNewMap(liveMap)
				sword = self._swordEntity
				if not isvalid(sword) then return end
			end
		end
		local map = self._swordMap

		local startPos = sword.TransformComponent.Position
		local target = self:FindClosestByPosition(map, self._swordAnchorPos)
		if target == nil or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end

		self._swordAttackInProgress = true

		local renderer = sword.SpriteRendererComponent
		local targetPos = target.Entity.TransformComponent.Position

		local facingRight = self._swordFacingRight
		if targetPos.x > startPos.x then facingRight = true
		elseif targetPos.x < startPos.x then facingRight = false end
		self._swordFacingRight = facingRight
		if renderer ~= nil then renderer.FlipX = facingRight end

		local hitPos = Vector3(targetPos.x, targetPos.y + self.Card159HoverYOffset, self.Card159DepthZ)

		if renderer ~= nil then renderer.SpriteRUID = self.Card159MoveRUID end
		_TweenLogic:PlayTween(0.0, 1.0, self.Card159RepositionDuration, EaseType.Linear, function(t)
			if not isvalid(sword) then return end
			local x = startPos.x + (hitPos.x - startPos.x) * t
			local y = startPos.y + (hitPos.y - startPos.y) * t
			sword.TransformComponent.Position = Vector3(x, y, hitPos.z)
		end)

		local scaleRatio = self:GetEffectScaleRatio(target)
		-- SkillInventory 스카링 소드(인덱스47) Lv9: 소환수 대미지 10% 증가, 카드 자체 레벨과 별개로
		-- 항상 가산(대미지%/쿨타임% 일반 보너스와 별개로 소환수 타격에만 추가로 곱연산)
		local hitDamage = damage * 0.5 * (1.0 + self:GetSkillInvTierPercent(47, 0, 0, 0.10))

		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(sword) then return end
			if renderer ~= nil then renderer.SpriteRUID = self.Card159AttackRUID end

			_TimerService:SetTimerOnce(function()
				self:ResolveScarringSwordHit(map, target, hitPos, hitDamage, isCrit, scaleRatio)
			end, self.Card159Hit1Delay)

			_TimerService:SetTimerOnce(function()
				self:ResolveScarringSwordHit(map, target, hitPos, hitDamage, isCrit, scaleRatio)
				if isvalid(sword) and renderer ~= nil then renderer.SpriteRUID = self.Card159MoveRUID end
				self._swordAttackInProgress = false
			end, self.Card159Hit1Delay + self.Card159HitInterval)
		end, self.Card159RepositionDuration)
	end

	-- 히트 연출 스폰 + 대미지 적용 1회분(50%) — 유저 지적: "닿는 범위에 찌르는 모션 대미지 다 안들어가는듯"
	-- (기존엔 추적 중인 target 1명에게만 직접 적용해서, 찌르는 연출이 실제로 겹친 다른 몬스터를 무시했다).
	-- 피닉스의 ResolvePhoenixHit과 동일한 패턴으로 hitPos 기준 반경(Card159HitRadius) 안의 몬스터를 전부
	-- 순회하며 적용한다. anchor(추적하던 target)는 죽어도 IsSameDepthBand가 무효 대상엔 true를 반환하므로
	-- 판정 자체는 계속 진행된다(피닉스와 동일 이유).
	@ExecSpace("ServerOnly")
	method void ResolveScarringSwordHit(Entity map, MonsterAI anchor, Vector3 hitPos, number hitDamage, boolean isCrit, number scaleRatio)
		if map == nil then return end
		local fxHit = self:SpawnEffectWithModel(self.Card159HitRUID, hitPos, 0, 1.0, self.Card159HitScale * scaleRatio, 1.0, "skilleffectlong")
		if fxHit ~= nil then fxHit:Destroy(self.Card159HitLifetime) end

		local radius = self.Card159HitRadius
		local monsters = self:GetMonstersInCurrentZone(map)
		local hitCount = 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local mp = m.Entity.TransformComponent.Position
				local dx = mp.x - hitPos.x
				local dy = mp.y - hitPos.y
				if (dx * dx + dy * dy) <= (radius * radius) and self:IsSameDepthBand(anchor, m) then
					if isCrit then m:TakeDamageCrit(hitDamage * 2)
					else m:TakeDamage(hitDamage) end
					hitCount = hitCount + 1
				end
			end
		end
		log("ScarringSwordHit: hit=" .. hitCount .. " radius=" .. radius .. " dmg=" .. math.floor(hitDamage))
	end

	-- ── 레이온 전용 조합 스킬: 스카링 블레이드 (카드 169) — 스카링 소드(159) Lv5 + 찬스 어택(161) +
	-- 워리어 마스터리(164, 둘 다 슬롯 없는 패시브) 보유 시 등장. 스카링 소드와 완전히 동일한 "소환수"
	-- 매커니즘(근처 적 소환+유지시간 동안 고정 간격으로 그때그때 최근접 적에게 날아가 2연타)을 그대로
	-- 재사용, 새 슬롯이 필요 없고 스카링 소드의 슬롯을 그대로 넘겨받는다. 유저 지정으로 공격 연출/타격
	-- 연출/아이콘만 신규 리소스로 교체하고(소환/이동/사라짐 연출과 사운드는 스카링 소드와 동일하게 재사용),
	-- 신규 공격/타격 연출은 실측 결과 원본과 프레임 수·재생시간이 동일해(공격 10프레임/0.90초, 타격
	-- 6프레임/0.54초) 타이밍 상수도 원본 그대로 재사용한다. 데미지만 Lv1~3 상향 재조정(유저 확인:
	-- 280/320/360, 쿨타임 9초 고정 유지).
	@Sync property integer ScarringBladeLevel = 0
	property number Card169Cooldown = 9.0  -- 레벨 무관 고정(스카링 소드와 동일)
	property number ScarringBladeAttackInterval = 2.0  -- 레벨 무관 고정(스카링 소드와 동일)
	property number ScarringBladeHitInterval = 0.35
	property number ScarringBladeScale = 0.91
	property number ScarringBladeHitScale = 1.0
	property number ScarringBladeHitRadius = 1.7  -- 2026-08-05: 1.2→1.5, 유저 지적 — 연출보다 판정이 좁아 보임 / 2026-08-07: 1.5→1.7, 유저 요청으로 +0.2 확장
	property Vector3 ScarringBladeSpawnPosition = Vector3(0, 3.0, -0.1)  -- 근처에 적이 하나도 없을 때만 쓰는 대체 위치
	property number ScarringBladeHoverYOffset = 0.1
	property number ScarringBladeDepthZ = -2.0
	property number ScarringBladeSummonAppearDuration = 0.94  -- 소환 연출 재사용(원본과 동일 타이밍)
	property number ScarringBladeRepositionDuration = 0.3
	-- 신규 공격/타격 연출 실측(LoadAnimationClipAndWait) 결과 원본과 프레임 수·재생시간이 동일해
	-- (공격 10프레임/0.90초, 타격 6프레임/0.54초) 원본 타이밍 상수를 그대로 재사용한다.
	property number ScarringBladeHit1Delay = 0.3
	property number ScarringBladeHitLifetime = 0.49
	property number ScarringBladeDieDuration = 0.9  -- 사라짐 연출 재사용(원본과 동일 타이밍)
	property string ScarringBladeSummonedRUID = "cb8d8eb3c0a342179c73d606951b4331"  -- 스카링 소드와 동일(소환 연출)
	property string ScarringBladeMoveRUID = "9180909395934b4ab2dfb47f87864813"  -- 스카링 소드와 동일(이동/대기 연출)
	property string ScarringBladeAttackRUID = "8ee3ce25e9b94331bc0cc9c0c7a5e6dc"  -- 유저 지정: 신규 공격 연출
	property string ScarringBladeHitRUID = "39e7e74a75a54c01af5337b0e50b7b37"  -- 유저 지정: 신규 타격 연출
	property string ScarringBladeDieRUID = "e27c66de556843fd826184d0ddc9da18"  -- 스카링 소드와 동일(사라짐 연출)
	property string ScarringBladeSoundRUID = "0051f5688445447aa6cc9ccbd8e8fdb5"  -- 유저 지정: 스카링 소드와 동일 사운드
	property Entity _bladeEntity = nil
	property Entity _bladeMap = nil  -- 블레이드가 현재 있는 맵(존 이동 감지용)
	-- Entity 비교로는 ep2_map3/ep2_map4(존 10개 공유 파일)에서 존 이동이 감지 안 되는 버그 수정 —
	-- _shadowPartnerZoneIndex 선언부 주석 참고
	property integer _bladeZoneIndex = -1
	property Vector3 _bladeAnchorPos = Vector3(0, 0, 0)  -- 소환된(또는 존 이동 후 재소환된) 고정 위치 — 타겟 탐색 기준점
	property boolean _bladeFacingRight = false
	property boolean _bladeAttackInProgress = false  -- true인 동안은 유지시간 만료로 인한 소환 해제를 미룬다

	-- 대미지(레벨별 고정값 — 유저 확인: Lv1=280/Lv2=320/Lv3=360)
	method number GetScarringBladeDamage(integer level)
		if level >= 3 then return 360
		elseif level >= 2 then return 320
		end
		return 280
	end

	-- 유지시간 — 스카링 소드와 동일한 규칙(Lv1-2:4초/Lv3:5초). ScarringBladeAttackInterval=2초
	-- 고정이라 floor(duration/interval)은 두 구간 모두 2가 나와, 모든 레벨에서 2회 공격(=4회 타격) 동일.
	method number GetScarringBladeDuration(integer level)
		if level >= 3 then return 5 end
		return 4
	end

	@ExecSpace("ServerOnly")
	method void ScarringBladeAttack(number damage, boolean isCrit)
		local map = self:GetCurrentMap()
		if map == nil then return end

		-- 이미 소환된 블레이드가 남아있으면 정리 후 재소환(쿨타임 9초가 유지시간 4~5초보다 항상 길어서
		-- 정상 플레이에선 거의 발생하지 않지만 방어적으로 처리 — 스카링 소드와 동일한 이유)
		if isvalid(self._bladeEntity) then
			self._bladeEntity:Destroy()
			self._bladeEntity = nil
		end
		self._bladeAttackInProgress = false

		self:PlayScarringBladeSound()

		local duration = self:GetScarringBladeDuration(self.ScarringBladeLevel)
		local leadTime = self.ScarringBladeSummonAppearDuration
		local interval = self.ScarringBladeAttackInterval

		local firstTarget = self:FindClosestInMap(map)
		local spawnPos = self.ScarringBladeSpawnPosition
		if firstTarget ~= nil and isvalid(firstTarget) and isvalid(firstTarget.Entity) then
			local tp = firstTarget.Entity.TransformComponent.Position
			spawnPos = Vector3(tp.x, tp.y + self.ScarringBladeHoverYOffset, self.ScarringBladeDepthZ)
		end

		local blade = self:SpawnEffectWithModel(self.ScarringBladeSummonedRUID, spawnPos, 0, 1.0, self.ScarringBladeScale, 1.0, "persistenteffect")
		if blade == nil then return end
		self._bladeEntity = blade
		self._bladeMap = map
		self._bladeZoneIndex = _MapManager.CurrentMapIndex
		self._bladeAnchorPos = spawnPos

		_TimerService:SetTimerOnce(function()
			local fx = self._bladeEntity
			if isvalid(fx) then
				local r = fx.SpriteRendererComponent
				if r ~= nil then r.SpriteRUID = self.ScarringBladeMoveRUID end
			end
		end, leadTime)

		local attackCount = math.floor(duration / interval)
		for i = 0, attackCount - 1 do
			local delay = leadTime + i * interval
			_TimerService:SetTimerOnce(function()
				self:ScarringBladeAttackTick(damage, isCrit)
			end, delay)
		end

		_TimerService:SetTimerOnce(function()
			self:TryEndScarringBladeLife()
		end, leadTime + duration)

		log("ScarringBladeAttack: duration=" .. duration .. " attacks=" .. attackCount .. " dmg=" .. math.floor(damage))
	end

	@ExecSpace("Multicast")
	method void PlayScarringBladeSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.ScarringBladeSoundRUID, 1.0)
	end

	-- 유지시간이 다 됐을 때 호출된다. 공격이 진행 중이면 끝날 때까지 미뤘다가 사라진다(스카링 소드와 동일)
	@ExecSpace("ServerOnly")
	method void TryEndScarringBladeLife()
		if not isvalid(self) then return end
		if self._bladeAttackInProgress then
			_TimerService:SetTimerOnce(function()
				self:TryEndScarringBladeLife()
			end, 0.1)
			return
		end
		local fx = self._bladeEntity
		if isvalid(fx) then
			local r = fx.SpriteRendererComponent
			if r ~= nil then r.SpriteRUID = self.ScarringBladeDieRUID end
			fx:Destroy(self.ScarringBladeDieDuration)
		end
		self._bladeEntity = nil
		self._bladeMap = nil
	end

	-- 존 이동 감지 시 블레이드를 플레이어의 새 맵으로 다시 소환한다(스카링 소드와 동일)
	@ExecSpace("ServerOnly")
	method void RelocateScarringBladeToNewMap(Entity newMap)
		local old = self._bladeEntity
		local anchor = self:FindClosestInMap(newMap)
		local pos = self.ScarringBladeSpawnPosition
		if anchor ~= nil and isvalid(anchor) and isvalid(anchor.Entity) then
			local ap = anchor.Entity.TransformComponent.Position
			pos = Vector3(ap.x, ap.y + self.ScarringBladeHoverYOffset, self.ScarringBladeDepthZ)
		end
		local fresh = self:SpawnEffectWithModel(self.ScarringBladeMoveRUID, pos, 0, 1.0, self.ScarringBladeScale, 1.0, "persistenteffect")
		if fresh == nil then return end
		if isvalid(old) then old:Destroy() end
		self._bladeEntity = fresh
		self._bladeMap = newMap
		self._bladeZoneIndex = _MapManager.CurrentMapIndex
		self._bladeAnchorPos = pos
	end

	-- 공격 1회 — self._bladeEntity/_bladeMap을 그때그때 다시 읽어서(캡처된 값 아님) 존 이동을 감지하고,
	-- 소환된(고정) 위치 기준 실거리 최근접 적에게 이동한 뒤 2연타(각 50%)를 꽂는다(스카링 소드와 동일 구조).
	@ExecSpace("ServerOnly")
	method void ScarringBladeAttackTick(number damage, boolean isCrit)
		if not isvalid(self) then return end
		local blade = self._bladeEntity
		if not isvalid(blade) then return end

		if _MapManager.CurrentMapIndex ~= self._bladeZoneIndex then
			local liveMap = self:GetCurrentMap()
			if liveMap ~= nil then
				self:RelocateScarringBladeToNewMap(liveMap)
				blade = self._bladeEntity
				if not isvalid(blade) then return end
			end
		end
		local map = self._bladeMap

		local startPos = blade.TransformComponent.Position
		local target = self:FindClosestByPosition(map, self._bladeAnchorPos)
		if target == nil or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end

		self._bladeAttackInProgress = true

		local renderer = blade.SpriteRendererComponent
		local targetPos = target.Entity.TransformComponent.Position

		local facingRight = self._bladeFacingRight
		if targetPos.x > startPos.x then facingRight = true
		elseif targetPos.x < startPos.x then facingRight = false end
		self._bladeFacingRight = facingRight
		if renderer ~= nil then renderer.FlipX = facingRight end

		local hitPos = Vector3(targetPos.x, targetPos.y + self.ScarringBladeHoverYOffset, self.ScarringBladeDepthZ)

		if renderer ~= nil then renderer.SpriteRUID = self.ScarringBladeMoveRUID end
		_TweenLogic:PlayTween(0.0, 1.0, self.ScarringBladeRepositionDuration, EaseType.Linear, function(t)
			if not isvalid(blade) then return end
			local x = startPos.x + (hitPos.x - startPos.x) * t
			local y = startPos.y + (hitPos.y - startPos.y) * t
			blade.TransformComponent.Position = Vector3(x, y, hitPos.z)
		end)

		local scaleRatio = self:GetEffectScaleRatio(target)
		-- SkillInventory 스카링 블레이드(인덱스53) Lv9: 소환수 대미지 15% 증가, 카드 자체 레벨과 별개로
		-- 항상 가산(대미지%/쿨타임% 일반 보너스와 별개로 소환수 타격에만 추가로 곱연산)
		local hitDamage = damage * 0.5 * (1.0 + self:GetSkillInvTierPercent(53, 0, 0, 0.15))

		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(blade) then return end
			if renderer ~= nil then renderer.SpriteRUID = self.ScarringBladeAttackRUID end

			_TimerService:SetTimerOnce(function()
				self:ResolveScarringBladeHit(map, target, hitPos, hitDamage, isCrit, scaleRatio)
			end, self.ScarringBladeHit1Delay)

			_TimerService:SetTimerOnce(function()
				self:ResolveScarringBladeHit(map, target, hitPos, hitDamage, isCrit, scaleRatio)
				if isvalid(blade) and renderer ~= nil then renderer.SpriteRUID = self.ScarringBladeMoveRUID end
				self._bladeAttackInProgress = false
			end, self.ScarringBladeHit1Delay + self.ScarringBladeHitInterval)
		end, self.ScarringBladeRepositionDuration)
	end

	-- 히트 연출 스폰 + 대미지 적용 1회분(50%) — 스카링 소드의 ResolveScarringSwordHit과 동일한 패턴으로
	-- hitPos 기준 반경(ScarringBladeHitRadius) 안의 몬스터를 전부 순회하며 적용한다.
	@ExecSpace("ServerOnly")
	method void ResolveScarringBladeHit(Entity map, MonsterAI anchor, Vector3 hitPos, number hitDamage, boolean isCrit, number scaleRatio)
		if map == nil then return end
		local fxHit = self:SpawnEffectWithModel(self.ScarringBladeHitRUID, hitPos, 0, 1.0, self.ScarringBladeHitScale * scaleRatio, 1.0, "skilleffectlong")
		if fxHit ~= nil then fxHit:Destroy(self.ScarringBladeHitLifetime) end

		local radius = self.ScarringBladeHitRadius
		local monsters = self:GetMonstersInCurrentZone(map)
		local hitCount = 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local mp = m.Entity.TransformComponent.Position
				local dx = mp.x - hitPos.x
				local dy = mp.y - hitPos.y
				if (dx * dx + dy * dy) <= (radius * radius) and self:IsSameDepthBand(anchor, m) then
					if isCrit then m:TakeDamageCrit(hitDamage * 2)
					else m:TakeDamage(hitDamage) end
					hitCount = hitCount + 1
				end
			end
		end
		log("ScarringBladeHit: hit=" .. hitCount .. " radius=" .. radius .. " dmg=" .. math.floor(hitDamage))
	end

	-- ── 실피드 전용: 바람의 시 (카드 101, 슬롯형 정식 스킬 1호) — 상시발동인 애로우샷과 달리 슬롯에
	-- 배치되는 일반 액티브 스킬이다. Lv1~5 고정 데미지 테이블(90/90/130/130/170), 쿨타임은 레벨
	-- 무관 3.5초 고정, 타겟 수만 레벨별로 늘어난다(Lv1-2:1명/Lv3-4:2명/Lv5:3명, GetClosestTargets로
	-- 선정, 각 단일 타격 — 매직클로(Card2)와 동일한 다중타겟 패턴).
	@Sync property integer WindPoemLevel = 0
	property string Card101Name = "바람의 시"
	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 전용 팩에 번들 오디오가 없어 같은 활 계열
	-- 애로우 블로우(Card102)의 타격 사운드 재사용
	property string Card101SoundRUID = "b4c345306d4948f1a0b8cc787fd57bef"

	method void PlayWindPoemSound()
		_SoundService:PlaySound(self.Card101SoundRUID, 1.0)
	end
	property string Card101IconRUID = "f822a40d24004883980d8ef88d9b0f7a"
	property number Card101Cooldown = 3.5  -- 레벨 무관 고정
	-- 캐스팅 연출 시퀀스(유저 지정 순서): 1) 생성 연출 → 2) 활 쏘는 연출 → 3) 화살 발사와 동시에 제거.
	-- 둘 다 화면 위쪽 고정 위치에서 아래로 쏘는 각도(-90도)로 재생한다.
