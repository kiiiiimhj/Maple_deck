	-- 카드 슬롯 프레임 이미지(스킬 있을 때) — 사용자 제공 액자 이미지
	property string CardFrameRUID = "db543485bfb24d139135ee0602be6d1f"
	-- 기본공격(파이어샷) 전용 쿨타임 — 카드슬롯 좌측 원형 칼 아이콘
	property SpriteGUIRendererComponent basicAttackCooldown = "269d97df-acbe-4b92-a02c-da81ecd840aa"
	property SpriteGUIRendererComponent cooldown1 = "203801e9-159b-431a-9f6b-9c9b01715ce0"
