	property string Card15EffectRUID = "ea3601f7731c4e9f8e372149217c0d5e"
	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 전용 리소스팩 번들 오디오(_audio/Hit) 사용
	property string Card15SoundRUID = "81950e7f78a3483d8176eecf8d00b029"

