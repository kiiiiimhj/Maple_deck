			extraStr = "타겟 2명(넉백)  |  크리티컬 확률 +" .. math.floor(self:GetAzureEdgeCritChance(lv188e) * 100) .. "%  |  범위 " .. string.format("%.1f", self.Card175ExplosionRadius) .. "  |  충돌시 " .. string.format("%.1f", self.AzureEdgeMergedExplosionMultiplier) .. "배  |  메소 100%/아이템 50%"
		elseif cardIdx == 189 then
			local lv189e = self.MesoDetonationLevel
			extraStr = "타겟 : 필드의 메소 전부(없으면 대기)  |  2연타(50/50%, " .. string.format("%.2f", self.Card189SecondHitDelay) .. "초 간격)  |  스턴 " .. math.floor(self:GetMesoDetonationStunChance(lv189e) * 100) .. "% 확률로 " .. string.format("%.0f", self:GetMesoDetonationStunDuration(lv189e)) .. "초  |  기본 공격 시 30% 확률로 메소 드랍"
		elseif cardIdx == 190 then
			extraStr = "지속 " .. string.format("%.0f", self.Card190Duration) .. "초  |  분신 2체(스킬 복사 1 + 기본공격 전용 1, 서로 독립 행동)"
		elseif cardIdx == 191 then
			local lv191e = self.AbyssalFlareLevel
