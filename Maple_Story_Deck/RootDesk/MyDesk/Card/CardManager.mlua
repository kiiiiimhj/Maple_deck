	property number _timerBasic = 0
	property number _timer1 = 0
	property number _timer2 = 0
	property number _timer3 = 0
	property number _timer4 = 0
	property number _timer5 = 0
	property number _timer6 = 0

	-- 파워 엘릭서 습득 시 GameManager가 호출 — 장착된 모든 슬롯을 즉시 재사용 가능 상태로 만든다.
	-- 서버 타이머(_timer1~6)만 0으로 되돌리면 실제로는 바로 재사용 가능해지지만, 슬롯에 도는 쿨타임
	-- 원형 게이지(_activeCooldowns)는 클라이언트가 캐스트 시점에 등록해둔 자기만의 startTime/duration으로
	-- 독립적으로 카운트다운하는 클라 로컬 예측이라 서버 타이머 리셋과 무관하게 계속 돈다 — 그래서
	-- ResetAllCooldownVisuals()를 같이 브로드캐스트해서 게이지도 즉시 초기화해야 한다.
	@ExecSpace("ServerOnly")
	method void ResetAllCooldowns()
		self._timerBasic = 0
		self._timer1 = 0
		self._timer2 = 0
		self._timer3 = 0
		self._timer4 = 0
		self._timer5 = 0
		self._timer6 = 0
		self:ResetAllCooldownVisuals()
	end

	-- ResetAllCooldowns()가 호출 — 슬롯 쿨타임 원형 게이지 7개(기본공격+슬롯1~6)를 즉시 "사용 가능"
	-- 상태로 되돌린다. _activeCooldowns에서 이 오버레이들만 제거하고(버프 아이콘 항목은 그대로 둠 — 같은
	-- 리스트를 공유하지만 무관한 연출이라 건드리면 안 됨) TickCooldownVisuals의 자연 완료 분기와 동일하게
	-- FillAmount=0 + Enable=false로 맞춘다.
	@ExecSpace("Multicast")
	method void ResetAllCooldownVisuals()
		if self:IsServer() then return end
		local overlays = { self.basicAttackCooldown, self.cooldown1, self.cooldown2, self.cooldown3, self.cooldown4, self.cooldown5, self.cooldown6 }
		for _, overlay in ipairs(overlays) do
			if overlay ~= nil then
				for i = #self._activeCooldowns, 1, -1 do
					if self._activeCooldowns[i].overlay == overlay then
						table.remove(self._activeCooldowns, i)
					end
				end
				overlay.Entity:SetEnable(false)
				overlay.FillAmount = 0
			end
		end
	end

	-- 레벨업 선택지 내부 상태
	property integer _choiceCard1 = 0
	property integer _choiceCard2 = 0
	property integer _choiceCard3 = 0
	property string _choiceType1 = ""
	property string _choiceType2 = ""
	property string _choiceType3 = ""
	property integer _pendingLevelUps = 0
	property any _choiceClickHandler1 = nil
	property any _choiceClickHandler2 = nil
	property any _choiceClickHandler3 = nil

	-- 클라이언트 쿨타임 연출 — 캐스트마다 새 타이머를 만들지 않고
	-- 단일 반복 타이머가 활성 쿨타임 목록을 매 틱 갱신한다 (다수 동시 캐스트 시 타이머 고갈 방지)
	property any _activeCooldowns = nil
	property integer _cooldownTimerId = 0

	-- ── 레이온 전용 패시브 4종 (카드 161~164) — 실피드의 보우 액셀레이션 등(카드 109~113)과 동일한
	-- 패턴(슬롯 없음, 해금 즉시 영구 적용, 레벨업 선택지 풀에서 unlock→강화). 레이온 전용이라
	-- GenerateLevelUpChoices의 isLeion 블록에서만 노출된다. 이름/아이콘/태그는 CardRegistry(161~164)에서
	-- 관리, 실제 수치는 이 스크립트에서 관리.
	@Sync property integer ChanceAttackLevel = 0
	@Sync property integer ComaLevel = 0
	@Sync property integer SelfRecoveryLevel = 0
	@Sync property integer WarriorMasteryLevel = 0

	-- ── 쉐이드 전용 패시브 5종(카드180~184) — 실피드/레이온의 동종 패시브와 동일 패턴(슬롯 없음, 해금
	-- 즉시 영구 적용). 이름/아이콘/태그/레벨별 수치(chancePerLevel)는 CardRegistry(180~184)에서 관리,
	-- 실제 게임 로직 적용부만 여기(GetEffectiveCooldown/RollCrit/GetCardDamage) + MonsterAI
	-- (TakeDamageCrit*/OnReachPlayer)에서 CardRegistry.GetChance(cardIdx, level)로 조회한다.
	@Sync property integer DaggerAccelLevel = 0
	@Sync property integer CriticalEdgeLevel = 0
	@Sync property integer KarmaLevel = 0
	@Sync property integer PhysicalTrainingLevel = 0
	@Sync property integer DarkSightLevel = 0

	-- 대거 액셀레이션(180) 쿨타임 감소율 — GetEffectiveCooldown에서 매직 부스터/보우 액셀레이션과
	-- 동일한 방식으로 곱연산 적용.
	method number GetDaggerAccelReduction()
		return _CardRegistry:GetChance(180, self.DaggerAccelLevel)
	end

	-- 카르마(182) 크리티컬 대미지 보너스 — 크리티컬 샷(111)과 동일한 패턴으로
	-- MonsterAI.TakeDamageCrit/TakeDamageCritWithOffset/TakeDamageDelayedDeath에서 가산 적용.
	method number GetKarmaBonus()
		return _CardRegistry:GetChance(182, self.KarmaLevel)
	end

	-- 피지컬 트레이닝(183) 피해량 배율 — 워리어 마스터리와 동일한 패턴으로 GetCardDamage 전역 곱연산.
	method number GetPhysicalTrainingMult()
		return 1.0 + _CardRegistry:GetChance(183, self.PhysicalTrainingLevel)
	end

	-- 다크 사이트(184) 공격 회피 확률 — MonsterAI.OnReachPlayer에서 몬스터 공격 도달 시 이 확률로
	-- 완전히 회피(대미지 0). 연막탄의 몬스터별 명중하락 디버프와는 별개 판정.
	method number GetDarkSightEvadeChance()
		return _CardRegistry:GetChance(184, self.DarkSightLevel)
	end

	-- 코마 — 5스택 콤보 폭발(PlayComboFinishBurst)의 데미지 배율(기본 200%)을 레벨별로 강화하고,
	-- 미해금 시 일반 연출/해금 시 강화 연출로 교체한다(유저 지정 — 이전엔 finish/1~10 중 무작위
	-- 재생이었음).
	property string ComaNormalEffectRUID = "8d638b1a7d5a4fac9de02f4c875ab956"
	property string ComaEnhancedEffectRUID = "3f6088e8a7134c5aaa65b4f5ac12e374"

	-- 표시용 정수 퍼센트(200/220/230/240/250/260) — GetComaBurstMult()의 소수값에서
	-- floor(mult*100)으로 역산하면 부동소수점 오차로 229 같은 값이 나올 수 있어(메디테이션과 동일한
	-- 함정), 화면/로그 표시는 항상 이 함수를 써야 한다.
	method integer GetComaBurstPercent(integer level)
		if level >= 5 then return 260
		elseif level >= 4 then return 250
		elseif level >= 3 then return 240
		elseif level >= 2 then return 230
		elseif level >= 1 then return 220
		end
		return 200
	end

	-- SkillInventory 코마(인덱스57) 레벨의 +5%/+10%/+15%가 카드 자체 레벨과 별개로 항상 가산된다.
	method number GetComaBurstMult(integer level)
		return (self:GetComaBurstPercent(level) / 100.0) + self:GetSkillInvTierPercent(57, 0.05, 0.10, 0.15)
	end

	-- 셀프 리커버리 — SelfRecoveryInterval초마다 최대 체력의 % 회복, Lv1:3%/Lv2:4%/Lv3:5%/Lv4:6%/Lv5:7%
	property number SelfRecoveryInterval = 10.0
	property number _selfRecoveryTimer = 0
	method integer GetSelfRecoveryPercent()
		if self.SelfRecoveryLevel >= 5 then return 7
		elseif self.SelfRecoveryLevel >= 4 then return 6
		elseif self.SelfRecoveryLevel >= 3 then return 5
		elseif self.SelfRecoveryLevel >= 2 then return 4
		elseif self.SelfRecoveryLevel >= 1 then return 3
		end
		return 0
	end

	-- 워리어 마스터리 — 모든 스킬 데미지 % 증가(메디테이션/연속 사격과 동일한 전역 적용 패턴,
	-- GetCardDamage에서 공통 적용), Lv1:5%/Lv2:8%/Lv3:12%/Lv4:16%/Lv5:20%
	method integer GetWarriorMasteryPercent()
		if self.WarriorMasteryLevel >= 5 then return 20
		elseif self.WarriorMasteryLevel >= 4 then return 16
		elseif self.WarriorMasteryLevel >= 3 then return 12
		elseif self.WarriorMasteryLevel >= 2 then return 8
		elseif self.WarriorMasteryLevel >= 1 then return 5
		end
		return 0
	end

	-- SkillInventory 워리어 마스터리(인덱스59) 레벨의 +2%/+4%/+6%가 카드 자체 레벨과 별개로 항상 가산된다.
	method number GetWarriorMasteryMult()
		return 1.0 + (self:GetWarriorMasteryPercent() / 100.0) + self:GetSkillInvTierPercent(59, 0.02, 0.04, 0.06)
	end

	-- ── 레이온 전용 조합 스킬: 스피릿 블레이드 (카드 165) — 플래시 슬래시(154) Lv5 + 찬스 어택(161,
	-- 슬롯 없는 패시브) 보유 시 등장. 아쿠아 서지/헤일 버스트와 동일한 "슬롯형 액티브 1개 + 슬롯 없는
	-- 패시브 1개" 조합 패턴 — 새 슬롯이 필요없고 플래시 슬래시의 슬롯을 그대로 넘겨받는다.
	-- GetClosestTargets로 뽑힌 대상마다 "찌르는" 연출(리소스팩 effect/12~16 5장을 순서대로 스왑하며
	-- 살짝 전진, 90도 회전 — 유저 지정: "살짝 찌르는것처럼 움직이면서 살짝")을 재생하고 1타(기준 데미지
	-- 100%)를 즉시 적중시킨다. 그 연출이 12~16 전부 재생을 마치면(유저 지정: "12~16까지 연출 온전히
	-- 재생되는지 확인") 그 위치에서 effect0(a66fc223) 연출이 재생되며, 그 반경(SpiritBladeSplashRadius)
	-- 안의 모든 몬스터(원래 타겟 포함)에게 2타(비율 데미지, 50/60/70%)가 들어간다 — 헤일 버스트의
	-- "바닥 범위기"와 동일한 반경 스캔 패턴(map:GetChildComponentsByTypeName("script.MonsterAI")).
	-- 콤보스택은 1타 적중 시에만(원래 타겟 대상 1회, 100%) 적용한다.
	@Sync property integer SpiritBladeLevel = 0
	property number Card165Cooldown = 5.0  -- 레벨 무관 고정(유저 표)
	-- "찌르는" 연출 — 리소스팩 effect/12~16(5장)을 순서대로 스왑
	property string SpiritBladeFrame12RUID = "d7b1e7d2406f4cb9ad24e10a474d51e7"
	property string SpiritBladeFrame13RUID = "17adc3ccdb144dc38fd468cd6dbded83"
	property string SpiritBladeFrame14RUID = "ad6294debf854add9db5804af387611f"
	property string SpiritBladeFrame15RUID = "46faaa83b2f54018977020d0511ef8eb"
	property string SpiritBladeFrame16RUID = "9cf01a64351e41368a7351dda386a811"
	property number SpiritBladeFrameStepDuration = 0.06  -- 브랜디쉬 스윙과 동일한 프레임 간격
	property number SpiritBladeThrustDistance = 0.2  -- 5프레임 재생 동안 앞으로 이동하는 총 거리(살짝)
	property number SpiritBladeEffectYOffset = 0.3  -- 유저 지정: 연출1(찌르는 연출) 좌표를 위로 살짝
	property number SpiritBladeEffectScale = 1.0
	-- "affected" 연출 — 찌르는 연출(1) 시작과 동시에 같은 위치에 덧씌워 재생(유저 지정)
	property string SpiritBladeAffectedRUID = "4f02d8ff913a4936b1b887e54f3e66ff"
	property number SpiritBladeAffectedLifetime = 0.5
	-- 찌르는 연출이 끝나는 시점에 재생되는 반경 판정 연출(effect0) + 그 반경 안 전체 2타
	property string SpiritBladeSplashRUID = "a66fc22314704d0397aa52c453e9ddf2"
	property number SpiritBladeSplashLifetime = 0.8
	property number SpiritBladeSplashRadius = 1.2  -- 반경 — 추정치, 어색하면 조정
	property number SpiritBladeDamageNumberSpacing = 0.27  -- 레이징 블로우와 동일한 겹침 방지 오프셋
	property string SpiritBladeSoundRUID = "267c7840593c419098060eb07e2b4dbb"

	-- 1타 기준 데미지(레벨별 고정값 — 유저 지정 표)
	method number GetSpiritBladeDamage(integer level)
		if level >= 3 then return 300
		elseif level >= 2 then return 240
		end
		return 200
	end

	-- 타겟 수(GetClosestTargets로 선정) — Lv1-2:3 / Lv3:4 (유저 지정 표)
	method integer GetSpiritBladeTargetCount(integer level)
		if level >= 3 then return 4 end
		return 3
	end

	-- 2타 데미지 비율 — 50%/60%/70% (유저 지정 표. 확률이 아니라 항상 발동하는 2번째 타격의 데미지 배율)
	-- SkillInventory 스피릿 블레이드(인덱스49) Lv9: 2타 대미지 +10%, 카드 자체 레벨과 별개로 항상 가산
	method number GetSpiritBladeSecondHitPercent(integer level)
		local base = 0.50
		if level >= 3 then base = 0.70
		elseif level >= 2 then base = 0.60
		end
		return base + self:GetSkillInvTierPercent(49, 0, 0, 0.10)
	end

	-- "찌르는" 연출 — frame12로 스폰 후 13→14→15→16을 SpiritBladeFrameStepDuration 간격으로 스왑하며
	-- 매 프레임 살짝 앞으로 이동시킨다(브랜디쉬의 "정지-프레임" 수동 제어와 동일한 방식이되, 하나의
	-- 스프라이트시트 프레임 인덱스가 아니라 서로 다른 5개의 개별 리소스를 스왑한다는 점이 다르다).
	-- 5프레임 재생이 전부 끝나면 onComplete를 호출한다(반경 2타 타이밍용).
	@ExecSpace("ServerOnly")
	method void PlaySpiritBladeThrust(Vector3 pos, number scale, any onComplete)
		local fx = self:SpawnEffectWithModel(self.SpiritBladeFrame12RUID, pos, 90, 1.0, scale, 1.0, "skilleffectlong")
		if fx == nil then
			if onComplete ~= nil then onComplete() end
			return
		end
		-- 찌르는 연출(1) 시작과 동시에 "affected" 연출을 같은 위치에 덧씌운다(유저 지정)
		local overlayFx = self:SpawnEffectWithModel(self.SpiritBladeAffectedRUID, pos, 90, 1.0, scale, 1.0, "skilleffectlong")
		if overlayFx ~= nil then overlayFx:Destroy(self.SpiritBladeAffectedLifetime) end
		local renderer = fx.SpriteRendererComponent
		local frames = { self.SpiritBladeFrame13RUID, self.SpiritBladeFrame14RUID, self.SpiritBladeFrame15RUID, self.SpiritBladeFrame16RUID }
		local stepDist = self.SpiritBladeThrustDistance / #frames
		for i, ruid in ipairs(frames) do
			_TimerService:SetTimerOnce(function()
				if not isvalid(fx) then return end
				if isvalid(renderer) then renderer.SpriteRUID = ruid end
				fx.TransformComponent.Position = Vector3(pos.x + stepDist * i, pos.y, pos.z)
				log("SpiritBladeThrust: frame " .. (12 + i) .. " ruid=" .. ruid)
			end, i * self.SpiritBladeFrameStepDuration)
		end
		local totalDuration = (#frames + 1) * self.SpiritBladeFrameStepDuration
		fx:Destroy(totalDuration + 0.05)
		_TimerService:SetTimerOnce(function()
			if onComplete ~= nil then onComplete() end
		end, totalDuration)
	end

	@ExecSpace("ServerOnly")
	method void SpiritBladeAttack(number damage, boolean isCrit)
		local targets = self:GetClosestTargets(self:GetSpiritBladeTargetCount(self.SpiritBladeLevel))
		if #targets == 0 then return end

		self:PlaySpiritBladeSound()
		local secondHitPct = self:GetSpiritBladeSecondHitPercent(self.SpiritBladeLevel)

		for _, target in ipairs(targets) do
			local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
			local scaleRatio = self:GetEffectScaleRatio(target)

			-- 1타: 찌르는 연출과 동시에 즉시 적중(유저 확정 패턴: 연출을 데미지보다 먼저 스폰)
			if not target._dead then
				local hitDamage = damage
				local offsetX = -0.5 * self.SpiritBladeDamageNumberSpacing
				if isCrit then
					hitDamage = hitDamage * 2
					target:TakeDamageCritWithOffset(hitDamage, Vector2(offsetX, 0))
				else
					target:TakeDamageWithOffset(hitDamage, Vector2(offsetX, 0))
				end
				target:AddComboStack(hitDamage)
				log("SpiritBladeAttack: hit1 dmg=" .. math.floor(hitDamage))
			end

			self:PlaySpiritBladeThrust(Vector3(p.x, p.y + self.SpiritBladeEffectYOffset, p.z - 0.1), self.SpiritBladeEffectScale * scaleRatio, function()
				self:ResolveSpiritBladeSplash(p, damage * secondHitPct, isCrit)
			end)
		end

		log("SpiritBladeAttack: targets=" .. #targets)
	end

	-- 찌르는 연출(12~16)이 끝나는 시점에 호출 — 착탄 위치(p) 반경 안의 모든 몬스터(원래 타겟 포함)에게
	-- 2타(비율 데미지)를 적용하고, 그 자리에서 effect0(a66fc223) 연출을 재생한다. 헤일 버스트의
	-- "바닥 범위기"와 동일한 반경 스캔 패턴.
	@ExecSpace("ServerOnly")
	method void ResolveSpiritBladeSplash(Vector3 p, number splashDamage, boolean isCrit)
		if not isvalid(self) then return end
		local map = self:GetCurrentMap()
		if map == nil then return end

		local fx = self:SpawnEffectWithModel(self.SpiritBladeSplashRUID, p, 0, 1.0, self.SpiritBladeEffectScale, 1.0, "skilleffectlong")
		if fx ~= nil then fx:Destroy(self.SpiritBladeSplashLifetime) end

		local hitCount = 0
		local monsters = self:GetMonstersInCurrentZone(map)
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if not m._dead then
				local mp = m.Entity.TransformComponent.Position
				local dx = mp.x - p.x
				local dy = mp.y - p.y
				local inSplash = (dx * dx + dy * dy) <= (self.SpiritBladeSplashRadius * self.SpiritBladeSplashRadius)
				if inSplash then
					hitCount = hitCount + 1
					if isCrit then m:TakeDamageCrit(splashDamage * 2)
					else m:TakeDamage(splashDamage) end
				end
			end
		end
		log("SpiritBladeAttack: splash hits=" .. hitCount .. " dmg=" .. math.floor(splashDamage))
	end

	@ExecSpace("Multicast")
	method void PlaySpiritBladeSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.SpiritBladeSoundRUID, 1.0)
	end

	-- ── 레이온 전용 조합 스킬: 버닝 러시 (카드 166) — 돌진(155) Lv5 + 워리어 마스터리(164) +
	-- 셀프 리커버리(163, 둘 다 슬롯 없는 패시브) 보유 시 등장. 기본 매커니즘은 돌진과 완전히 동일
	-- (좌/우 최외곽 대상을 중앙으로 넉백 + 경로상 다른 몬스터는 충돌 대미지) — 새 슬롯이 필요없고
	-- 돌진의 슬롯을 그대로 넘겨받는다. 유저 지정 리소스팩("돌진")으로 연출을 교체하고, 넉백이 끝나
	-- (날아간 유닛이 멈추는 시점) hit/0/4~8 5프레임 착지 폭발 연출 + effect0(덧씌우기, 스피릿
	-- 블레이드와 동일한 방식)이 재생되며 그 반경(BurningRushSplashRadius) 안의 모든 몬스터에게
	-- 추가 범위 대미지가 들어간다(유저 표: 레벨별 비율이 충돌 대미지 비율과 동일해서
	-- GetBurningRushPercent 하나로 공용 사용).
	@Sync property integer BurningRushLevel = 0
	property number Card166Cooldown = 5.0  -- 레벨 무관 고정(유저 표)
	property string BurningRushSoundRUID = "d9522927411a4f8f9dc7e083ee891f7f"
	property string BurningRushCastEffectRUID = "06615b13d6ff4227b8b80f64a1f303dd"
	property number BurningRushCastEffectLifetime = 0.5
	property number BurningRushEffectScale = 1.0
	-- 충돌 히트("칼 나오는" 연출) — effect/8~12 5프레임을 순서대로 스왑. 유저 지정: 날아가는 방향에
	-- 따라 이 연출도 좌우 반전(FlipX)되어야 한다(진행 방향과 반대로 칼이 나오면 어색함).
	property string BurningRushHitFrame8RUID = "53d69573d1574188aa7e996d4e2a6a6e"
	property string BurningRushHitFrame9RUID = "009539ca4d3c49fc8b9702cdc3ca798b"
	property string BurningRushHitFrame10RUID = "6181c5e42aad476f88356f2d4b6beb28"
	property string BurningRushHitFrame11RUID = "0bc159f14d23404891638bd8dd2bc983"
	property string BurningRushHitFrame12RUID = "393c2afd955e47e08ba0d3e7bd3603c4"
	property number BurningRushHitFrameStepDuration = 0.06
	property string BurningRushHitSoundRUID = "0467154104b8470f82e44aa2371dcfe3"
	-- 착지 폭발("날아간 유닛이 멈추면") — hit/0/4~8 5프레임 + effect0 덧씌우기
	property string BurningRushBurstFrame4RUID = "7b206910c8d149409515865c0296e8a5"
	property string BurningRushBurstFrame5RUID = "fdbf7ad0b0f24866ae084953dd493919"
	property string BurningRushBurstFrame6RUID = "5a2feee2aa944b05ae733574cbf11eff"
	property string BurningRushBurstFrame7RUID = "941ab56ece634b00b7c8a3d187cf023a"
	property string BurningRushBurstFrame8RUID = "d2b21085895c435684e025efb4ccc12b"
	property number BurningRushBurstFrameStepDuration = 0.06
	property string BurningRushBurstOverlayRUID = "12e423c2df444ed38cc94c486e76433b"
	property number BurningRushBurstOverlayLifetime = 0.6
	property number BurningRushSplashRadius = 1.3  -- 반경 — 추정치, 어색하면 조정

	-- 대미지(레벨별 고정값 — 유저 지정 표)
	method number GetBurningRushDamage(integer level)
		if level >= 3 then return 260
		elseif level >= 2 then return 220
		end
		return 200
	end

	-- 타겟 수 — 레벨 무관 2명 고정(유저 지정 표)
	method integer GetBurningRushTargetCount(integer level)
		return 2
	end

	-- "타격 유닛"(충돌 대미지) 비율이자 "날아간 유닛 주변 대미지"(착지 범위 대미지) 비율 — 유저 표에서
	-- 두 항목이 레벨별로 동일한 수치(60/70/80%)라 하나의 함수로 공용 사용한다
	-- SkillInventory 버닝 러시(인덱스50) Lv9: 충돌·착지 대미지 15% 증가, 카드 자체 레벨과 별개로 항상 가산
	method number GetBurningRushPercent(integer level)
		local base = 0.60
		if level >= 3 then base = 0.80
		elseif level >= 2 then base = 0.70
		end
		return base + self:GetSkillInvTierPercent(50, 0, 0, 0.15)
	end

	-- 돌진(ChargeAttack)과 완전히 동일한 좌/우 최외곽 탐색 + 중앙 넉백 + 중앙근방 예외 로직
	@ExecSpace("ServerOnly")
	method void BurningRushAttack(number damage, boolean isCrit)
		local map = self:GetCurrentMap()
		if map == nil then return end
		local monsters = self:GetMonstersInCurrentZone(map)
		local centerX = self:GetZoneCenterX()

		local leftExtreme, rightExtreme = nil, nil
		local centerCluster = {}
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local x = m.Entity.TransformComponent.Position.x
				if x < centerX - self.Card108CenterRadius and (leftExtreme == nil or x < leftExtreme.Entity.TransformComponent.Position.x) then
					leftExtreme = m
				elseif x > centerX + self.Card108CenterRadius and (rightExtreme == nil or x > rightExtreme.Entity.TransformComponent.Position.x) then
					rightExtreme = m
				elseif x >= centerX - self.Card108CenterRadius and x <= centerX + self.Card108CenterRadius then
					table.insert(centerCluster, m)
				end
			end
		end
		if leftExtreme == nil and rightExtreme == nil then
			self:FireBurningRushOutward(map, monsters, centerCluster, centerX, damage, isCrit)
			return
		end

		local targetCount = self:GetBurningRushTargetCount(self.BurningRushLevel)
		local pct = self:GetBurningRushPercent(self.BurningRushLevel)

		if targetCount >= 2 then
			if leftExtreme ~= nil then
				self:FireBurningRushShove(map, monsters, leftExtreme, centerX, damage, isCrit, pct)
			elseif #centerCluster > 0 then
				local pick = centerCluster[_UtilLogic:RandomIntegerRange(1, #centerCluster)]
				self:FireBurningRushShove(map, monsters, pick, centerX - self.Card108OutwardOvershoot, damage, isCrit, pct)
			end
			if rightExtreme ~= nil then
				self:FireBurningRushShove(map, monsters, rightExtreme, centerX, damage, isCrit, pct)
			elseif #centerCluster > 0 then
				local pick = centerCluster[_UtilLogic:RandomIntegerRange(1, #centerCluster)]
				self:FireBurningRushShove(map, monsters, pick, centerX + self.Card108OutwardOvershoot, damage, isCrit, pct)
			end
		else
			local pickRight
			if leftExtreme == nil then pickRight = true
			elseif rightExtreme == nil then pickRight = false
			else pickRight = _UtilLogic:RandomDouble() < 0.5 end
			if pickRight then
				self:FireBurningRushShove(map, monsters, rightExtreme, centerX, damage, isCrit, pct)
			else
				self:FireBurningRushShove(map, monsters, leftExtreme, centerX, damage, isCrit, pct)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void FireBurningRushOutward(Entity map, table monsters, table centerCluster, number centerX, number damage, boolean isCrit)
		if #centerCluster < 2 then return end
		local pct = self:GetBurningRushPercent(self.BurningRushLevel)

		local pool = {}
		for i, m in ipairs(centerCluster) do pool[i] = m end
		for i = #pool, 2, -1 do
			local j = _UtilLogic:RandomIntegerRange(1, i)
			pool[i], pool[j] = pool[j], pool[i]
		end

		self:FireBurningRushShove(map, monsters, pool[1], centerX - self.Card108OutwardOvershoot, damage, isCrit, pct)
		self:FireBurningRushShove(map, monsters, pool[2], centerX + self.Card108OutwardOvershoot, damage, isCrit, pct)
	end

	-- 돌진의 FireChargeShove와 동일한 넉백/충돌 로직 + 착지 시점 범위 폭발(신규)
	@ExecSpace("ServerOnly")
	method void FireBurningRushShove(Entity map, table monsters, MonsterAI primary, number destX, number damage, boolean isCrit, number pct)
		if not isvalid(primary) or not isvalid(primary.Entity) or not isvalid(primary.Entity.TransformComponent) then return end
		destX = self:ClampKnockbackDestX(primary, destX)
		local primaryX = primary.Entity.TransformComponent.Position.x
		local dirRight = destX > primaryX
		local totalDist = math.abs(destX - primaryX)

		local pp = primary.Entity.TransformComponent.Position
		self:PlayBurningRushSound()
		local fx = self:SpawnEffect(self.BurningRushCastEffectRUID, Vector3(pp.x, pp.y + self.Card108EffectYOffset, pp.z), 0, 1.0, self.BurningRushEffectScale * self:GetEffectScaleRatio(primary), 1.0)
		if fx ~= nil then
			local renderer = fx.SpriteRendererComponent
			if renderer ~= nil then renderer.FlipX = dirRight end
			fx:Destroy(self.BurningRushCastEffectLifetime)
		end

		if isCrit then primary:TakeDamageDelayedDeath(damage * 2, true, self.Card108KnockbackDuration)
		else primary:TakeDamageDelayedDeath(damage, false, self.Card108KnockbackDuration) end

		primary:ApplyLateralShove(destX, self.Card108KnockbackDuration)

		local collideCount = 0
		if totalDist > 0 then
			for _, mob in ipairs(monsters) do
				---@type MonsterAI
				local m = mob
				if isvalid(m) and m ~= primary and not m._dead and isvalid(m.Entity) and self:IsSameDepthBand(primary, m) then
					local mx = m.Entity.TransformComponent.Position.x
					local inPath = (dirRight and mx >= primaryX and mx <= destX)
						or ((not dirRight) and mx <= primaryX and mx >= destX)
					if inPath then
						collideCount = collideCount + 1
						local hitDelay = self.Card108KnockbackDuration * (math.abs(mx - primaryX) / totalDist)
						local collideDamage = damage * pct
						_TimerService:SetTimerOnce(function()
							if not isvalid(m) or m._dead or not isvalid(m.Entity) then return end
							local hitPos = m.Entity.TransformComponent.Position
							self:PlayBurningRushHitEffect(hitPos, dirRight, self.BurningRushEffectScale)
							self:PlayBurningRushHitSound()
							if isCrit then m:TakeDamageCrit(collideDamage * 2)
							else m:TakeDamage(collideDamage) end
						end, hitDelay)
					end
				end
			end
		end

		-- 착지(넉백 종료) 시점 — hit/0/4~8 폭발 연출 + 반경 범위 대미지(신규 메커니즘)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(primary) or not isvalid(primary.Entity) then return end
			local landPos = primary.Entity.TransformComponent.Position
			self:PlayBurningRushBurst(Vector3(landPos.x, landPos.y, landPos.z), self.BurningRushEffectScale * self:GetEffectScaleRatio(primary), function()
				self:ResolveBurningRushSplash(landPos, damage * pct, isCrit)
			end)
		end, self.Card108KnockbackDuration)

		log("BurningRushShove: dmg=" .. math.floor(isCrit and damage * 2 or damage) .. " collide=" .. collideCount .. " dirRight=" .. tostring(dirRight))
	end

	-- 충돌 히트("칼 나오는") 연출 — effect/8→9→10→11→12를 순서대로 스왑한다. dirRight로 FlipX를
	-- 한 번 세팅해서(스왑 도중 재설정할 필요 없음, 값이 유지됨) 날아가는 방향과 맞춘다(유저 지정).
	@ExecSpace("ServerOnly")
	method void PlayBurningRushHitEffect(Vector3 pos, boolean dirRight, number scale)
		local fx = self:SpawnEffectWithModel(self.BurningRushHitFrame8RUID, pos, 0, 1.0, scale, 1.0, "skilleffectlong")
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		if isvalid(renderer) then renderer.FlipX = dirRight end
		log("BurningRushHitEffect: frame8 dirRight=" .. tostring(dirRight))
		local frames = { self.BurningRushHitFrame9RUID, self.BurningRushHitFrame10RUID, self.BurningRushHitFrame11RUID, self.BurningRushHitFrame12RUID }
		for i, ruid in ipairs(frames) do
			_TimerService:SetTimerOnce(function()
				if not isvalid(fx) then return end
				if isvalid(renderer) then renderer.SpriteRUID = ruid end
			end, i * self.BurningRushHitFrameStepDuration)
		end
		fx:Destroy((#frames + 1) * self.BurningRushHitFrameStepDuration + 0.05)
	end

	-- 착지 폭발 연출 — hit/0/4→5→6→7→8을 순서대로 스왑하고, 시작과 동시에 effect0을 덧씌운다(스피릿
	-- 블레이드와 동일한 방식). 재생이 끝나면 onComplete를 호출한다(범위 대미지 타이밍용).
	@ExecSpace("ServerOnly")
	method void PlayBurningRushBurst(Vector3 pos, number scale, any onComplete)
		local fx = self:SpawnEffectWithModel(self.BurningRushBurstFrame4RUID, pos, 0, 1.0, scale, 1.0, "skilleffectlong")
		if fx == nil then
			if onComplete ~= nil then onComplete() end
			return
		end
		local overlayFx = self:SpawnEffectWithModel(self.BurningRushBurstOverlayRUID, pos, 0, 1.0, scale, 1.0, "skilleffectlong")
		if overlayFx ~= nil then overlayFx:Destroy(self.BurningRushBurstOverlayLifetime) end

		local renderer = fx.SpriteRendererComponent
		local frames = { self.BurningRushBurstFrame5RUID, self.BurningRushBurstFrame6RUID, self.BurningRushBurstFrame7RUID, self.BurningRushBurstFrame8RUID }
		for i, ruid in ipairs(frames) do
			_TimerService:SetTimerOnce(function()
				if not isvalid(fx) then return end
				if isvalid(renderer) then renderer.SpriteRUID = ruid end
			end, i * self.BurningRushBurstFrameStepDuration)
		end
		local totalDuration = (#frames + 1) * self.BurningRushBurstFrameStepDuration
		fx:Destroy(totalDuration + 0.05)
		_TimerService:SetTimerOnce(function()
			if onComplete ~= nil then onComplete() end
		end, totalDuration)
	end

	-- 착지 폭발 연출이 끝나는 시점에 호출 — 착지 위치(pos) 반경 안의 모든 몬스터에게 범위 대미지를
	-- 적용한다(헤일 버스트/스피릿 블레이드와 동일한 반경 스캔 패턴)
	@ExecSpace("ServerOnly")
	method void ResolveBurningRushSplash(Vector3 pos, number splashDamage, boolean isCrit)
		if not isvalid(self) then return end
		local map = self:GetCurrentMap()
		if map == nil then return end

		local hitCount = 0
		local monsters = self:GetMonstersInCurrentZone(map)
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if not m._dead then
				local mp = m.Entity.TransformComponent.Position
				local dx = mp.x - pos.x
				local dy = mp.y - pos.y
				local inSplash = (dx * dx + dy * dy) <= (self.BurningRushSplashRadius * self.BurningRushSplashRadius)
				if inSplash then
					hitCount = hitCount + 1
					if isCrit then m:TakeDamageCrit(splashDamage * 2)
					else m:TakeDamage(splashDamage) end
				end
			end
		end
		log("BurningRushShove: splash hits=" .. hitCount .. " dmg=" .. math.floor(splashDamage))
	end

	@ExecSpace("Multicast")
	method void PlayBurningRushSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.BurningRushSoundRUID, 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayBurningRushHitSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.BurningRushHitSoundRUID, 1.0)
	end

	-- ── 레이온 전용 조합 스킬: 슬래시 스톰 (카드 167) — 슬래시(152) Lv5 + 콤보 어택(151) + 코마
	-- (162, 둘 다 슬롯 없는 패시브) 보유 시 등장. 슬래시와 완전히 동일한 기본 패턴(GetClosestTargets로
	-- 뽑힌 대상마다 개별로 스윙+타격 연출을 재생하고 즉시 단일 타격) — 새 슬롯이 필요없고 슬래시의
	-- 슬롯을 그대로 넘겨받는다. 유저 지정 리소스팩("슬래시 스톰")으로 연출을 교체하되, 스윙은 원본
	-- 슬래시처럼 한 리소스의 프레임 구간이 아니라 서로 다른 8개 개별 리소스(effect/6~13)를 순서대로
	-- 스왑하고, 타격 연출은 hit/0/5~6(2프레임) + effect0(덧씌우기, 스피릿 블레이드와 동일한 방식)을
	-- 같이 재생한다. 콤보스택은 브레이브 슬래시와 동일하게 대상당 +2(AddComboStack 2회, 100%) 적용한다.
	@Sync property integer SlashStormLevel = 0
	property number Card167Cooldown = 3.0  -- 레벨 무관 고정(유저 표)
	property string SlashStormSoundRUID = "3a0e45300efd4623addaa0c30ba4cadc"
	property string SlashStormHitSoundRUID = "b6065da7c3444f0bbcc63a947f1e7d0d"
	-- 스윙 연출 — effect/6~13(8프레임)을 순서대로 스왑
	property string SlashStormSwingFrame6RUID = "73293cdb1c3c4e83abeb654de24b3887"
	property string SlashStormSwingFrame7RUID = "c2bb8fc5c61444ce860a934c659da993"
	property string SlashStormSwingFrame8RUID = "3fd1ec8d5c3c499196b660b1809cd31b"
	property string SlashStormSwingFrame9RUID = "0f1212622727462ba56a00ad219822f2"
	property string SlashStormSwingFrame10RUID = "caa279f655734b86b64cdc6f80928751"
	property string SlashStormSwingFrame11RUID = "e041480f789f48ae91b53b77718001f7"
	property string SlashStormSwingFrame12RUID = "2895795545ba4169be234bbb696f611e"
	property string SlashStormSwingFrame13RUID = "2fa2ae9a86e64024aea6adc8305270f0"
	property number SlashStormSwingFrameStepDuration = 0.06
	property number SlashStormSwingScale = 1.144  -- 유저 지정: 기존 1.04에서 10% 증가
	property number SlashStormSwingOffsetX = 1.3  -- 슬래시와 동일 오프셋
	property number SlashStormSwingOffsetY = 0.3
	-- 스윙과 동시에 재생하는 캐스트 연출("effect", 단일 animationclip 그대로 재생) — 실측(6프레임,
	-- LoadAnimationClipAndWait)으로 총 0.6초 확인. 07d98384(CharLevel/11/effect)를 같이 덧씌워
	-- 재생하고(실측 12프레임, 0.96초 — 74f8d58d보다 훨씬 길어 별도 Duration/Lifetime로 분리 관리),
	-- 이 둘의 좌표만 오른쪽으로 0.5 추가 이동(SlashStormCastEffectOffsetX).
	-- 대미지(+타격 연출)는 두 캐스트 연출 중 더 긴 쪽(07d98384, 0.96초)이 끝나기 20% 전(80% 지점)에
	-- 지연 발동한다.
	-- SpriteRendererComponent(월드)는 SpriteGUIRendererComponent와 달리 AnimClipPlayType(1회/루프)
	-- 필드가 아예 없어서 재생 반복 여부를 직접 끌 수 없다 — 유저 리포트: "+0.05초 여유"를 뒀더니
	-- 자연 재생이 끝난 뒤 루프로 처음 프레임으로 되돌아가는 게 그 여유 구간에 보여 깜빡임으로 보였다.
	-- 여유를 더하지 않고 실측값보다 살짝 짧게 끊어서 재시작 프레임이 보이기 전에 Destroy되도록 한다.
	property string SlashStormCastEffectRUID = "74f8d58d6b2b4386bd20f7556c4898a1"
	property string SlashStormOverlayEffectRUID = "07d98384378546bd98aa611936c7a641"
	property number SlashStormCastEffectDuration = 0.6  -- 실측값(LoadAnimationClipAndWait)
	property number SlashStormCastEffectLifetime = 0.58  -- 실측(0.6초)보다 살짝 짧게 — 루프 재시작 프레임 노출 방지
	property number SlashStormOverlayEffectDuration = 0.96  -- 실측값(12프레임, LoadAnimationClipAndWait) — 대미지 지연 계산 기준
	property number SlashStormOverlayEffectLifetime = 0.94  -- 실측(0.96초)보다 살짝 짧게 — 루프 재시작 프레임 노출 방지
	property number SlashStormCastEffectOffsetX = -0.6  -- 유저 지정: 왼쪽으로 0.6 이동(-0.3에서 변경)
	-- 타격 연출 — hit/0/5~6(2프레임) + effect0 덧씌우기 + hit/0(6ce3e8c3, 5프레임 단일 재생) 추가 덧씌우기
	property string SlashStormHitFrame5RUID = "e8a54fea3afc4b4db70aac62a0373ab7"
	property string SlashStormHitFrame6RUID = "7f56e739edae47b188e583bb4cbdb044"
	property number SlashStormHitFrameStepDuration = 0.06
	property string SlashStormHitOverlayRUID = "c6affc4c0bab428ab9fadb071e2efe60"
	property number SlashStormHitOverlayLifetime = 0.5
	property string SlashStormHitAnimClipRUID = "6ce3e8c3483643c2b4993df78057eb77"
	property number SlashStormHitAnimClipDuration = 0.3  -- 실측값(5프레임, LoadAnimationClipAndWait)
	property number SlashStormHitAnimClipLifetime = 0.28  -- 실측(0.3초)보다 살짝 짧게 — 루프 재시작 프레임 노출 방지
	property number SlashStormHitScale = 0.8  -- 슬래시와 동일 비율

	-- 타당 데미지(레벨별 고정값 — 유저 지정 표)
	method number GetSlashStormDamage(integer level)
		if level >= 3 then return 400
		elseif level >= 2 then return 350
		end
		return 300
	end

	-- 타겟 수(서로 다른 몬스터, GetClosestTargets로 선정) — Lv1-2:3 / Lv3:4 (유저 지정 표)
	method integer GetSlashStormTargetCount(integer level)
		if level >= 3 then return 4 end
		return 3
	end

	-- 스윙 연출 — frame6로 스폰 후 7→8→9→10→11→12→13을 순서대로 스왑(슬래시의 "정지-프레임" 수동
	-- 제어와 동일한 의도이되, 하나의 스프라이트시트 프레임 인덱스가 아니라 서로 다른 8개의 개별
	-- 리소스를 스왑한다는 점이 다르다 — 스피릿 블레이드/버닝 러시와 동일한 패턴).
	@ExecSpace("ServerOnly")
	method void PlaySlashStormSwingEffect(Vector3 pos, number scale)
		local fx = self:SpawnEffectWithModel(self.SlashStormSwingFrame6RUID, pos, 0, 1.0, scale, 1.0, "skilleffectlong")
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		local frames = { self.SlashStormSwingFrame7RUID, self.SlashStormSwingFrame8RUID, self.SlashStormSwingFrame9RUID, self.SlashStormSwingFrame10RUID, self.SlashStormSwingFrame11RUID, self.SlashStormSwingFrame12RUID, self.SlashStormSwingFrame13RUID }
		for i, ruid in ipairs(frames) do
			_TimerService:SetTimerOnce(function()
				if not isvalid(fx) then return end
				if isvalid(renderer) then renderer.SpriteRUID = ruid end
			end, i * self.SlashStormSwingFrameStepDuration)
		end
		fx:Destroy((#frames + 1) * self.SlashStormSwingFrameStepDuration + 0.05)
	end

	-- 타격 연출 — frame5로 스폰과 동시에 effect0을 덧씌우고(스피릿 블레이드와 동일한 방식), frame6으로 스왑.
	-- 유저 지정: 6ce3e8c3(hit/0, 5프레임 animationclip, 실측 0.3초)도 대미지 타이밍에 같이 덧씌운다.
	@ExecSpace("ServerOnly")
	method void PlaySlashStormHitEffect(Vector3 pos, number scale)
		local fx = self:SpawnEffectWithModel(self.SlashStormHitFrame5RUID, pos, 0, 1.0, scale, 1.0, "skilleffectlong")
		if fx == nil then return end
		local overlayFx = self:SpawnEffectWithModel(self.SlashStormHitOverlayRUID, pos, 0, 1.0, scale, 1.0, "skilleffectlong")
		if overlayFx ~= nil then overlayFx:Destroy(self.SlashStormHitOverlayLifetime) end
		local animClipFx = self:SpawnEffect(self.SlashStormHitAnimClipRUID, pos, 0, 1.0, scale, 1.0)
		if animClipFx ~= nil then animClipFx:Destroy(self.SlashStormHitAnimClipLifetime) end
		local renderer = fx.SpriteRendererComponent
		_TimerService:SetTimerOnce(function()
			if not isvalid(fx) then return end
			if isvalid(renderer) then renderer.SpriteRUID = self.SlashStormHitFrame6RUID end
		end, self.SlashStormHitFrameStepDuration)
		fx:Destroy(2 * self.SlashStormHitFrameStepDuration + 0.05)
	end

	@ExecSpace("ServerOnly")
	method void SlashStormAttack(number damage, boolean isCrit)
		local targets = self:GetClosestTargets(self:GetSlashStormTargetCount(self.SlashStormLevel))
		if #targets == 0 then return end

		self:PlaySlashStormSound()
		-- 유저 지정: 대미지(+타격 연출)는 캐스트 연출이 시작하고 끝나기 20% 전(=80% 지점)에 나온다.
		-- 07d98384(0.96초)가 74f8d58d(0.6초)보다 길므로, 더 긴 쪽을 기준으로 지연을 계산한다.
		local damageDelay = self.SlashStormOverlayEffectDuration * 0.8

		for _, target in ipairs(targets) do
			local p = self:WorldToCurrentMapLocal(target.Entity.TransformComponent.WorldPosition)
			local scaleRatio = self:GetEffectScaleRatio(target)
			local castPos = Vector3(p.x + self.SlashStormSwingOffsetX + self.SlashStormCastEffectOffsetX, p.y + self.SlashStormSwingOffsetY, p.z - 0.1)

			self:PlaySlashStormSwingEffect(Vector3(p.x + self.SlashStormSwingOffsetX, p.y + self.SlashStormSwingOffsetY, p.z - 0.1), self.SlashStormSwingScale * scaleRatio)
			-- 스윙과 동시에("effect" animationclip) + 유저 지정 07d98384(CharLevel/11/effect)를 같이 재생
			local castFx = self:SpawnEffect(self.SlashStormCastEffectRUID, castPos, 0, 1.0, self.SlashStormSwingScale * scaleRatio, 1.0)
			if castFx ~= nil then castFx:Destroy(self.SlashStormCastEffectLifetime) end
			local castOverlayFx = self:SpawnEffect(self.SlashStormOverlayEffectRUID, castPos, 0, 1.0, self.SlashStormSwingScale * scaleRatio, 1.0)
			if castOverlayFx ~= nil then castOverlayFx:Destroy(self.SlashStormOverlayEffectLifetime) end

			_TimerService:SetTimerOnce(function()
				if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
				self:PlaySlashStormHitEffect(Vector3(p.x, p.y, p.z), self.SlashStormHitScale * scaleRatio)
				self:PlaySlashStormHitSound()

				local appliedDamage = damage
				if isCrit then
					appliedDamage = damage * 2
					target:TakeDamageCrit(appliedDamage)
				else
					target:TakeDamage(appliedDamage)
				end
				-- 유저 표: 콤보스택 2 — 브레이브 슬래시와 동일하게 AddComboStack을 두 번 호출
				target:AddComboStack(appliedDamage)
				target:AddComboStack(appliedDamage)
				log("SlashStormAttack: delayed hit dmg=" .. math.floor(appliedDamage))
			end, damageDelay)
		end
		log("SlashStormAttack: hit=" .. #targets .. "/" .. self:GetSlashStormTargetCount(self.SlashStormLevel))
	end

	@ExecSpace("Multicast")
	method void PlaySlashStormSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.SlashStormSoundRUID, 1.0)
	end

	@ExecSpace("Multicast")
	method void PlaySlashStormHitSound()
		if self:IsServer() then return end
		_SoundService:PlaySound(self.SlashStormHitSoundRUID, 1.0)
	end

	-- ── 헬퍼 메서드 ────────────────────────────────────────────

	method integer GetSlotCard(integer slotIdx)
		if slotIdx == 1 then return self.Slot1Card
		elseif slotIdx == 2 then return self.Slot2Card
		elseif slotIdx == 3 then return self.Slot3Card
		elseif slotIdx == 4 then return self.Slot4Card
		elseif slotIdx == 5 then return self.Slot5Card
		elseif slotIdx == 6 then return self.Slot6Card
		end
		return 0
	end

	method void AssignCardToSlot(integer slotIdx, integer cardIdx)
		if slotIdx == 1 then self.Slot1Card = cardIdx
		elseif slotIdx == 2 then self.Slot2Card = cardIdx
		elseif slotIdx == 3 then self.Slot3Card = cardIdx
		elseif slotIdx == 4 then self.Slot4Card = cardIdx
		elseif slotIdx == 5 then self.Slot5Card = cardIdx
		elseif slotIdx == 6 then self.Slot6Card = cardIdx
		end
	end

	method integer GetNextEmptySlot()
		if self.Slot1Card == 0 then return 1 end
		if self.Slot2Card == 0 then return 2 end
		if self.Slot3Card == 0 then return 3 end
		if self.Slot4Card == 0 then return 4 end
		if self.Slot5Card == 0 then return 5 end
		if self.Slot6Card == 0 then return 6 end
		return 0
	end

	method boolean IsCardUnlocked(integer cardIdx)
		if cardIdx == 3 then return self.ColdBeamLevel > 0 end
		if cardIdx == 4 then return self.ThunderBoltLevel > 0 end
		if cardIdx == 7 then return self.MagicBoosterLevel > 0 end
		if cardIdx == 8 then return self.MagicCriticalLevel > 0 end
		if cardIdx == 9 then return self.EnergyBoltLevel > 0 end
		if cardIdx == 10 then return self.FreezingEffectLevel > 0 end
		if cardIdx == 11 then return self.IceCutterLevel > 0 end
		if cardIdx == 12 then return self.KingPepeLevel > 0 end
		if cardIdx == 13 then return self.ThunderCutterLevel > 0 end
		if cardIdx == 14 then return self.AquaTrapLevel > 0 end
		if cardIdx == 15 then return self.HailStoneLevel > 0 end
		if cardIdx == 16 then return self.ThunderStormLevel > 0 end
		if cardIdx == 17 then return self.IceStrikeLevel > 0 end
		if cardIdx == 18 then return self.MagicArmorLevel > 0 end
		if cardIdx == 19 then return self.ChainLightningLevel > 0 end
		if cardIdx == 20 then return self.DoubleCutterLevel > 0 end
		if cardIdx == 21 then return self.GrandPepeLevel > 0 end
		if cardIdx == 22 then return self.MeditationLevel > 0 end
		if cardIdx == 23 then return self.HailBurstLevel > 0 end
		if cardIdx == 24 then return self.AquaSurgeLevel > 0 end
		if cardIdx == 101 then return self.WindPoemLevel > 0 end
		if cardIdx == 102 then return self.ArrowBlowLevel > 0 end
		if cardIdx == 103 then return self.IceQuiverLevel > 0 end
		if cardIdx == 104 then return self.FireQuiverLevel > 0 end
		if cardIdx == 105 then return self.PhoenixLevel > 0 end
		if cardIdx == 106 then return self.RetreatShotLevel > 0 end
		if cardIdx == 107 then return self.UncounterArrowLevel > 0 end
		if cardIdx == 118 then return self.ArrowFletterLevel > 0 end
		if cardIdx == 119 then return self.UncounterArrowVLevel > 0 end
		if cardIdx == 120 then return self.FlashBomberLevel > 0 end
		if cardIdx == 108 then return self.FleshMirageLevel > 0 end
		if cardIdx == 114 then return self.ArrowIllusionLevel > 0 end
		if cardIdx == 115 then return self.EvolveLevel > 0 end
		if cardIdx == 116 then return self.StormPoemLevel > 0 end
		if cardIdx == 117 then return self.EnhancedArrowBlowLevel > 0 end
		if cardIdx == 109 then return self.BowAccelerationLevel > 0 end
		if cardIdx == 110 then return self.PiercingWillLevel > 0 end
		if cardIdx == 111 then return self.CriticalShotLevel > 0 end
