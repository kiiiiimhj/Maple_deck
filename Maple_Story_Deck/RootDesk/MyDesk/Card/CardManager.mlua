		elseif cardIdx == 171 then
			local lv = self.DoubleStepLevel
			extraStr = "타겟 " .. self:GetDoubleStepTargetCount(lv) .. "명  |  2연타(" .. math.floor(self:GetDoubleStepPercent(lv, 1) * 100) .. "/" .. math.floor(self:GetDoubleStepPercent(lv, 2) * 100) .. "%)  |  " .. self.DoubleStepHitInterval .. "초 간격"
		elseif cardIdx == 185 then
			local lv185 = self.AssassinateLevel
			extraStr = "타겟 " .. self:GetAssassinateTargetCount(lv185) .. "명  |  2연타(" .. math.floor(self:GetAssassinatePercent(lv185, 1) * 100) .. "/" .. math.floor(self:GetAssassinatePercent(lv185, 2) * 100) .. "%)  |  " .. self.AssassinateHitInterval .. "초 간격"
		elseif cardIdx == 186 then
			local lv186 = self.SonicBlowLevel
			extraStr = "타겟 " .. self:GetSonicBlowTargetCount(lv186) .. "명  |  5연타(각 " .. math.floor(self:GetSonicBlowPercent(lv186) * 100) .. "%)  |  " .. self.SonicBlowHitInterval .. "초 간격  |  범위 " .. string.format("%.1f", self.SonicBlowRadius)
		elseif cardIdx == 187 then
			local lv187e = self.SmokeRampageLevel
			extraStr = "타겟 " .. self:GetSmokeGrenadeTargetCount(self.SmokeGrenadeLevel) .. "명  |  명중 -" .. math.floor(self:GetSmokeGrenadeMissChance(self.SmokeGrenadeLevel) * 100) .. "%(보스/엘리트 절반)  |  지속 " .. self:GetSmokeGrenadeDuration(self.SmokeGrenadeLevel) .. "초  |  반경 " .. string.format("%.1f", self.SmokeGrenadeRadius) .. "  |  0.5초 뒤 보너스 " .. math.floor(self:GetSmokeRampageBonusPercent(lv187e) * 100) .. "%"
		elseif cardIdx == 188 then
