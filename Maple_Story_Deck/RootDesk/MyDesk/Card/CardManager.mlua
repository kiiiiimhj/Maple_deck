	-- 캐스팅 시점에 착탄 위치를 미리 고정해둔다 — 애로우 블로우와 동일한 정책(활 쏘는 동안 타겟이
	-- 죽어도 연출은 항상 끝까지 재생되고 데미지 적용만 생존 여부로 갈린다). 단일 타겟 유지하되,
	-- 레벨별 화살 수(2/2/3발, GetEnhancedArrowBlowArrowCount)만큼 같은 타겟에 연사한다 — 화살마다
	-- 독립적으로 강화 여부를 판정한다(FireEnhancedArrowBlowArrow 내부).
	@ExecSpace("ServerOnly")
	method void EnhancedArrowBlowAttack(number damage, boolean isCrit, MonsterAI target)
		self:PlayEnhancedArrowBlowSound()
		self:PlayEnhancedArrowBlowShoot()
		if not isvalid(target) or not isvalid(target.Entity) then return end
		local p1 = target.Entity.TransformComponent.Position
		local hitPos = Vector3(p1.x, p1.y + 0.3, p1.z)
		local arrowCount = self:GetEnhancedArrowBlowArrowCount(self.EnhancedArrowBlowLevel)
		for i = 1, arrowCount do
			local delay = self.Card117ArrowStartDelay + (i - 1) * self.Card117ArrowStaggerDelay
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				if isvalid(target) and isvalid(target.Entity) and not target._dead then
					self:FireEnhancedArrowBlowArrow(target, hitPos, damage, isCrit)
				end
			end, delay)
		end
	end

	-- 쏘는 연출 — 애로우 블로우의 기존 활대(당기는) 연출을 대체하는 전용 신규 리소스(17프레임)
	@ExecSpace("ServerOnly")
	method void PlayEnhancedArrowBlowShoot()
		local frames = self:GetCard117ShootFrames()
		local dur = self.Card117FrameDuration
		local fx = self:SpawnEffectWithModel(frames[1], self:GetBowSpawnPosition(), self.Card101BowRotation, 1.0, self.Card117ShootScale, 1.0, "skilleffectlong")
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		for i = 2, #frames do
			local frameRUID = frames[i]
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) and isvalid(renderer) then renderer.SpriteRUID = frameRUID end
			end, dur * (i - 1))
		end
		fx:Destroy(dur * #frames)
	end

	-- 화살 발사(연사 중 1발) — 레벨별 확률로 강화 화살(고정 3연타)이냐 기본화살(단발, 애로우 블로우 타격 연출 재사용)이냐가 화살마다 독립적으로 갈린다
	@ExecSpace("ServerOnly")
	method void FireEnhancedArrowBlowArrow(MonsterAI target, Vector3 hitPos, number damage, boolean isCrit)
		local startPos = self:GetBowSpawnPosition()
		local dx = hitPos.x - startPos.x
		local dy = hitPos.y - startPos.y
		-- 기본화살(애로우 블로우 강화화살 리소스 재활용)과 동일한 180도 보정
		local angle = math.deg(math.atan(dy, dx)) + 180
		-- 버그 수정(2026-08-26, 유저 지적: "화면 넘어갔는데 이펙트가 다음 존에 존재") — 캐스트 시점
		-- 존 인덱스를 캡처해 지연 콜백(3연타 포함) 시점에 현재 존과 다르면 이펙트 스폰을 건너뛴다.
		local castZoneIndex = isvalid(target) and target._spawnZoneIndex or -1

		local level = self.EnhancedArrowBlowLevel
		local enhanceChance = self:GetEnhancedArrowBlowEnhanceChance(level)
		local isEnhanced = _UtilLogic:RandomDouble() < enhanceChance

		local aliveTarget = isvalid(target) and not target._dead
		local castScaleRatio = aliveTarget and self:GetEffectScaleRatio(target) or 1.0

		if isEnhanced then
			local fx = self:SpawnEffect(self.Card117EnhancedArrowRUID, startPos, angle, 1.5, 1.2 * castScaleRatio, 1)
			self:FlyWindPoemArrow(fx, startPos, hitPos)
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				self:ResolveEnhancedArrowBlowHits(target, hitPos, damage, isCrit, castZoneIndex)
			end, self.Card101ArrowFlightDuration)
		else
			local fx = self:SpawnEffect(self.Card117BasicArrowRUID, startPos, angle, 1.5, 1.2 * castScaleRatio, 1)
			self:FlyWindPoemArrow(fx, startPos, hitPos)
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				if isvalid(target) and isvalid(target.Entity) and not target._dead then
					if isCrit then target:TakeDamageCrit(damage * 2)
					else target:TakeDamage(damage) end
				end
				if castZoneIndex == _MapManager.CurrentMapIndex then
					local hitAliveTarget = isvalid(target) and not target._dead
					local scaleRatio = hitAliveTarget and self:GetEffectScaleRatio(target) or 1.0
					local hitFx = self:SpawnEffect(self.Card102HitRUID, hitPos, 0, 1.0, 1.3 * scaleRatio, 1)
					if hitFx ~= nil then hitFx:Destroy(self.HitEffectLifetime) end
				end
			end, self.Card101ArrowFlightDuration)
		end
	end

	-- 강화 화살 착탄 — 0.3초 간격으로 동일 대미지가 고정 3회 들어간다(레벨 무관 — "그건 유지해야지"
	-- 유저 확인). 매 히트마다 전용 타격 연출(Card117EnhancedHitRUID)을 재생하고, 대미지 숫자가
	-- 서로 겹쳐 보이지 않도록(유저 지적: "계속 겹쳐서 나오냐") 히트마다 수평 오프셋을 줘서 떨어뜨린다.
	-- castZoneIndex(2026-08-26 추가)는 캐스트 시점 존 — 3연타가 진행되는 동안 플레이어가 다른 존으로
	-- 넘어가면 그 이후 히트의 이펙트는 스폰하지 않는다(데미지는 계속 적용됨, 연출만 스킵).
	@ExecSpace("ServerOnly")
	method void ResolveEnhancedArrowBlowHits(MonsterAI target, Vector3 hitPos, number damage, boolean isCrit, integer castZoneIndex)
		local hitCount = self.Card117EnhancedHitCount
		for i = 1, hitCount do
			local delay = (i - 1) * self.Card117EnhancedHitInterval
			local offsetX = (i - (hitCount + 1) / 2.0) * self.Card117DamageNumberSpacing
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				if isvalid(target) and isvalid(target.Entity) and not target._dead then
					if isCrit then target:TakeDamageCritWithOffset(damage * 2, Vector2(offsetX, 0))
					else target:TakeDamageWithOffset(damage, Vector2(offsetX, 0)) end
				end
				if castZoneIndex == _MapManager.CurrentMapIndex then
					local hitAliveTarget = isvalid(target) and not target._dead
					local scaleRatio = hitAliveTarget and self:GetEffectScaleRatio(target) or 1.0
					self:PlayEnhancedArrowBlowHitEffect(hitPos, 1.3 * scaleRatio)
				end
			end, delay)
		end
	end

	@ExecSpace("ServerOnly")
	method void PlayEnhancedArrowBlowHitEffect(Vector3 pos, number scale)
		local frames = self:GetCard117EnhancedHitFrames()
		local dur = self.Card117FrameDuration
		local fx = self:SpawnEffectWithModel(frames[1], pos, 0, 1.0, scale, 1.0, "skilleffectlong")
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		for i = 2, #frames do
			local frameRUID = frames[i]
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) and isvalid(renderer) then renderer.SpriteRUID = frameRUID end
			end, dur * (i - 1))
		end
		fx:Destroy(dur * #frames)
	end

	-- ── 실피드 전용: 아이스 퀴버 (카드 103, 슬롯형 정식 스킬 3호) — 광역(이펙트 자체 반경) 다중
	-- 타겟, 쿨타임 4초 고정. 지상 우선(GetGroundPriorityTargets)으로 레벨별 타겟 수만큼 골라 각각
	-- 즉시 데미지를 주고, 맞은 대상마다 확률(레벨별)로 슬로우(MonsterAI:ApplySlow, 레벨별 지속시간)를
	-- 건다 — 아르카나의 AddFreezeStack(빙결 스택)은 FreezingEffect 패시브가 있어야만 동작해서
	-- 실피드 전용 카드에는 못 쓴다(패시브를 못 가져가므로 항상 no-op됐을 것), 대신 패시브 의존 없는
	-- 독립 슬로우 시스템을 그대로 쓴다. 타격 연출은 유저 리소스팩의 mode/0/7~15(정지 스프라이트
	-- 9장)를 순서대로 갈아 끼워 재생한다(유저 확인: "mode에서 7~15가 공격 이펙트").
	@Sync property integer IceQuiverLevel = 0
	property string Card103Name = "아이스 퀴버"
	property string Card103IconRUID = "5380e2771f104da4a1a8d4287cc0faa1"
	property number Card103Cooldown = 4.0  -- 레벨 무관 고정
	property string Card103Frame7RUID = "ccf6aa7edfc04b3c940c12c674fb3805"
	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 전용 팩에 번들 오디오가 없어 같은 얼음 계열
	-- 콜드빔(Card3) 사운드 재사용
	property string Card103SoundRUID = "2e9dbbaf840b41c5a3385e23c6c16b4e"

	method void PlayIceQuiverSound()
		_SoundService:PlaySound(self.Card103SoundRUID, 1.0)
	end
	property string Card103Frame8RUID = "3c0e04c4e68a4fcfad27f52a376efad1"
	property string Card103Frame9RUID = "837dbc3317084d11a99c4349697d15b5"
	property string Card103Frame10RUID = "d0e92160126145b590ea1638f5b1244b"
	property string Card103Frame11RUID = "4e41e1a84af64113a59f4231ab2e8fa2"
	property string Card103Frame12RUID = "6d4cc754b5554f2bbb7ec3807a76d767"
	property string Card103Frame13RUID = "4b1a2f6252084e2eb55b598a166a9ddc"
	property string Card103Frame14RUID = "b28134ced9c84c0383f25032b4237395"
	property string Card103Frame15RUID = "69c8d47897194097b77b25fa18e97b04"
	property number Card103FrameDuration = 0.05  -- 프레임당 재생 시간(9프레임 총 0.45초)
	property number Card103EffectYOffset = -1.0  -- 연출 위치를 타겟보다 아래로 내림(유저 요청)
	property number Card103Radius = 0.9  -- 레벨 무관 고정 반경(이펙트가 실제로 닿는 범위) — 유저 요청으로 "찍은 대상만 때리기"에서 진짜 반경 판정으로 전환
	property number Card103EffectScaleMult = 0.9  -- 이펙트 크기 10% 축소(유저 요청), 반경도 같은 비율로 축소

	method number GetIceQuiverDamage()
		if self.IceQuiverLevel >= 5 then return 200
		elseif self.IceQuiverLevel >= 3 then return 150
		end
		return 100
	end

	method integer GetIceQuiverTargetCount()
		if self.IceQuiverLevel >= 4 then return 3
		elseif self.IceQuiverLevel >= 2 then return 2
		end
		return 1
	end

	-- SkillInventory 아이스 퀴버(인덱스22) Lv9: 슬로우 확률 +10%, 카드 자체 레벨과 별개로 항상 가산
	method number GetIceQuiverSlowChance()
		local base = 0.40
		if self.IceQuiverLevel >= 5 then base = 0.60
		elseif self.IceQuiverLevel >= 3 then base = 0.50
		end
		return base + self:GetSkillInvTierPercent(22, 0, 0, 0.10)
	end

	method number GetIceQuiverSlowDuration()
		if self.IceQuiverLevel >= 4 then return 4
		elseif self.IceQuiverLevel >= 2 then return 3
		end
		return 2
	end

	-- 지상 우선(GetGroundPriorityTargets)으로 레벨별 개수만큼 착탄 지점을 고르고, 각 착탄 지점마다
	-- 고정 반경(Card103Radius) 안에 있는 모든 몬스터를 실제 거리 판정으로 함께 때린다(유저 요청:
	-- "연출 범위 광역이면 좋겠음" — 기존엔 찍은 대상만 때리는 방식이었음, 아이스 커터의 반경 판정
	-- 패턴을 그대로 재사용). 착탄 지점끼리 겹치면 같은 몬스터가 여러 번 맞을 수 있다.
	@ExecSpace("ServerOnly")
	method void IceQuiverAttack(number damage, boolean isCrit)
		self:PlayIceQuiverSound()
		local map = self:GetCurrentMap()
		if map == nil then return end
		local anchors = self:GetGroundPriorityTargets(self:GetIceQuiverTargetCount())
		local radius = self.Card103Radius
		local slowChance = self:GetIceQuiverSlowChance()
		local slowDuration = self:GetIceQuiverSlowDuration()
		local monsters = self:GetMonstersInCurrentZone(map)
		local hitCount = 0
		for _, anchor in ipairs(anchors) do
			if isvalid(anchor) and isvalid(anchor.Entity) and not anchor._dead then
				local centerPos = anchor.Entity.TransformComponent.Position
				local fxPos = Vector3(centerPos.x, centerPos.y + self.Card103EffectYOffset, centerPos.z)
				self:PlayIceQuiverBurst(fxPos, self:GetEffectScaleRatio(anchor) * self.Card103EffectScaleMult)

				for _, mob in ipairs(monsters) do
					---@type MonsterAI
					local m = mob
					if isvalid(m) and not m._dead then
						local mp = m.Entity.TransformComponent.Position
						local dx = mp.x - centerPos.x
						local dy = mp.y - centerPos.y
						if (dx * dx + dy * dy) <= (radius * radius) and self:IsSameDepthBand(anchor, m) then
							if isCrit then m:TakeDamageCrit(damage * 2)
							else m:TakeDamage(damage) end
							if slowChance > 0 and _UtilLogic:RandomDouble() < slowChance then
								m:ApplySlow(slowDuration)
							end
							hitCount = hitCount + 1
						end
					end
				end
			end
		end
		log("IceQuiverAttack: hit=" .. hitCount .. " anchors=" .. #anchors .. " radius=" .. radius .. " dmg=" .. math.floor(damage) .. " slowChance=" .. slowChance .. " slowDuration=" .. slowDuration)
	end

	-- mode/0/7~15 정지 스프라이트 9장을 순서대로 갈아 끼워 재생하는 얼음 폭발 연출(Arrow Blow의
	-- 활대 프레임 갈이 기법과 동일한 패턴).
	@ExecSpace("ServerOnly")
	method void PlayIceQuiverBurst(Vector3 pos, number scale)
		local frames = {
			self.Card103Frame7RUID, self.Card103Frame8RUID, self.Card103Frame9RUID,
			self.Card103Frame10RUID, self.Card103Frame11RUID, self.Card103Frame12RUID,
			self.Card103Frame13RUID, self.Card103Frame14RUID, self.Card103Frame15RUID,
		}
		local dur = self.Card103FrameDuration
		local fx = self:SpawnEffectWithModel(frames[1], pos, 0, 1.0, scale, 1.0, "skilleffectlong")
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		for i = 2, #frames do
			local frameRUID = frames[i]
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) and isvalid(renderer) then renderer.SpriteRUID = frameRUID end
			end, dur * (i - 1))
		end
		fx:Destroy(dur * #frames)
	end

	-- ── 실피드 전용: 파이어 퀴버 (카드 104, 슬롯형 정식 스킬 4호) — 아이스 퀴버(카드103)와 데미지/타겟
	-- 수/쿨타임/반경 진행이 완전히 동일한 광역 다중 히트 스킬. 차이는 딱 하나: 맞은 대상이 "그 순간
	-- 이미 슬로우 상태"면 데미지가 레벨별 비율(40/60/80/100/120%)만큼 추가로 들어간다 — 아이스 퀴버로
	-- 슬로우를 걸어두고 파이어 퀴버로 마무리하는 원소 조합을 노린 설계(유저의 "슬로우 상태 적 추가"
	-- 표기를 확률/도트가 아니라 슬로우 여부 체크 + 즉시 데미지 배율로 해석 — 표의 "초당 dps" 열은
	-- (대미지×타겟수)/쿨타임과 정확히 일치해 별도 매커니즘이 아니라 참고용 파생 수치로 판단됨).
	-- 연출은 리소스팩의 mode/1/7~15(빨간색, 유저 확인: "mode에서 d878e6f5... 이거 있는 부분(빨간색)
	-- 7~15")를 아이스 퀴버와 동일한 프레임 갈이 기법으로 재생한다.
	@Sync property integer FireQuiverLevel = 0
	property string Card104Name = "파이어 퀴버"
	property string Card104IconRUID = "852bcdd0e80c4014addb76d72969f7bc"
	property number Card104Cooldown = 4.5  -- 레벨 무관 고정(유저 요청으로 4.0→4.5)
	property number Card104SlowedBonusDelay = 0.2  -- 슬로우 추가 대미지 표시 지연(기본 대미지와 겹치지 않게)
	property number Card104Radius = 0.9  -- 레벨 무관 고정 — 아이스 퀴버(Card103Radius)와 동일(유저 요청: "대미지 반경은 아이스랑 같아야해")
	property number Card104EffectYOffset = -1.0  -- 아이스 퀴버와 동일하게 아래로
	property number Card104EffectScaleMult = 0.9  -- 아이스 퀴버와 동일 비율로 축소
	property string Card104Frame7RUID = "d878e6f5a64c422eabb5c81191855df2"
	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 전용 팩에 번들 오디오가 없어 같은 화염 계열
	-- 메테오(Card5) 사운드 재사용
	property string Card104SoundRUID = "d906d21dc9bd4c8cb66861d423044a65"

	method void PlayFireQuiverSound()
		_SoundService:PlaySound(self.Card104SoundRUID, 1.0)
	end
	property string Card104Frame8RUID = "4d5ce1f173294e7d963a025544a1b844"
	property string Card104Frame9RUID = "1392718989a943c6ab6d8bb96db8fe18"
	property string Card104Frame10RUID = "a1861a2b98d24322a7d4dc782eed4a21"
	property string Card104Frame11RUID = "4e8cae3158c44a48b635dc2856c2a6b1"
	property string Card104Frame12RUID = "3427c510c0124eb3b3a9abc19969e134"
	property string Card104Frame13RUID = "d6dacbdf31d543df86e34147ba222728"
	property string Card104Frame14RUID = "e4c2b37c209341efa538cc811edb6ed2"
	property string Card104Frame15RUID = "299b53fed9f446af9717aa9b987f87fc"
	property number Card104FrameDuration = 0.05

	method number GetFireQuiverDamage()
		if self.FireQuiverLevel >= 5 then return 200
		elseif self.FireQuiverLevel >= 3 then return 150
		end
		return 100
	end

	method integer GetFireQuiverTargetCount()
		if self.FireQuiverLevel >= 4 then return 3
		elseif self.FireQuiverLevel >= 2 then return 2
		end
		return 1
	end

	-- 슬로우 상태인 대상에게 추가로 들어가는 데미지 배율(1.4~2.2 = +40%~+120%)
	-- SkillInventory 파이어 퀴버(인덱스23) Lv9: 슬로우 상태 적 추가 대미지 +10%, 카드 자체 레벨과
	-- 별개로 항상 가산(배율에 그대로 +0.10)
	method number GetFireQuiverSlowedBonusMult()
		local base = 1.4
		if self.FireQuiverLevel >= 5 then base = 2.2
		elseif self.FireQuiverLevel >= 4 then base = 2.0
		elseif self.FireQuiverLevel >= 3 then base = 1.8
		elseif self.FireQuiverLevel >= 2 then base = 1.6
		end
		return base + self:GetSkillInvTierPercent(23, 0, 0, 0.10)
	end

	-- 아이스 퀴버(IceQuiverAttack)와 동일한 구조 — 지상 우선으로 착탄 지점을 고르고, 각 착탄
	-- 지점마다 고정 반경(Card104Radius) 안의 모든 몬스터를 실제 거리 판정으로 함께 때린다. 슬로우
	-- 상태인 대상만 GetFireQuiverSlowedBonusMult() 배율이 추가로 곱해진다.
	@ExecSpace("ServerOnly")
	method void FireQuiverAttack(number damage, boolean isCrit)
		self:PlayFireQuiverSound()
		local map = self:GetCurrentMap()
		if map == nil then return end
		local anchors = self:GetGroundPriorityTargets(self:GetFireQuiverTargetCount())
		local radius = self.Card104Radius
		local slowedBonusMult = self:GetFireQuiverSlowedBonusMult()
		local monsters = self:GetMonstersInCurrentZone(map)
		local hitCount = 0
		for _, anchor in ipairs(anchors) do
			if isvalid(anchor) and isvalid(anchor.Entity) and not anchor._dead then
				local centerPos = anchor.Entity.TransformComponent.Position
				local fxPos = Vector3(centerPos.x, centerPos.y + self.Card104EffectYOffset, centerPos.z)
				self:PlayFireQuiverBurst(fxPos, self:GetEffectScaleRatio(anchor) * self.Card104EffectScaleMult)

				for _, mob in ipairs(monsters) do
					---@type MonsterAI
					local m = mob
					if isvalid(m) and not m._dead then
						local mp = m.Entity.TransformComponent.Position
						local dx = mp.x - centerPos.x
						local dy = mp.y - centerPos.y
						if (dx * dx + dy * dy) <= (radius * radius) and self:IsSameDepthBand(anchor, m) then
							if isCrit then m:TakeDamageCrit(damage * 2)
							else m:TakeDamage(damage) end
							-- 슬로우 상태면 추가 대미지를 곧바로 합쳐서 띄우지 않고 0.2초 뒤 별도로
							-- 띄운다 — 기본 대미지 숫자랑 완전히 겹쳐서 안 보인다는 유저 피드백
							if m._isSlowed then
								local bonusDamage = damage * (slowedBonusMult - 1.0)
								_TimerService:SetTimerOnce(function()
									if not isvalid(self) then return end
									if isvalid(m) and isvalid(m.Entity) and not m._dead then
										if isCrit then m:TakeDamageCrit(bonusDamage * 2)
										else m:TakeDamage(bonusDamage) end
									end
								end, self.Card104SlowedBonusDelay)
							end
							hitCount = hitCount + 1
						end
					end
				end
			end
		end
		log("FireQuiverAttack: hit=" .. hitCount .. " anchors=" .. #anchors .. " radius=" .. radius .. " dmg=" .. math.floor(damage) .. " slowedBonusMult=" .. slowedBonusMult)
	end

	-- mode/1/7~15(빨간색) 정지 스프라이트 9장을 순서대로 갈아 끼워 재생 — 아이스 퀴버의
	-- PlayIceQuiverBurst와 동일한 프레임 갈이 기법.
	@ExecSpace("ServerOnly")
	method void PlayFireQuiverBurst(Vector3 pos, number scale)
		local frames = {
			self.Card104Frame7RUID, self.Card104Frame8RUID, self.Card104Frame9RUID,
			self.Card104Frame10RUID, self.Card104Frame11RUID, self.Card104Frame12RUID,
			self.Card104Frame13RUID, self.Card104Frame14RUID, self.Card104Frame15RUID,
		}
		local dur = self.Card104FrameDuration
		local fx = self:SpawnEffectWithModel(frames[1], pos, 0, 1.0, scale, 1.0, "skilleffectlong")
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		for i = 2, #frames do
			local frameRUID = frames[i]
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) and isvalid(renderer) then renderer.SpriteRUID = frameRUID end
			end, dur * (i - 1))
		end
		fx:Destroy(dur * #frames)
	end

	-- ── 실피드 전용 조합 스킬: 애로우 일루전 (카드 114) — 아이스 퀴버(103) Lv5 + 파이어 퀴버(104) Lv5
	-- 보유 시 등장(슬롯이 꽉 차 있어도 뽑기 풀에 노출). 두 원본 카드 모두 사라지고, 애로우 일루전이
	-- 아이스 퀴버 슬롯을 그대로 넘겨받는다(파이어 퀴버 슬롯은 완전히 비워짐). Lv1~3까지만 존재.
	-- 아이스/파이어 퀴버와 동일한 "지상 우선 anchor 선택 + 고정 반경" 광역 다중히트 구조를 재사용한다
	-- (유저 확인: "바닥에 화살을 쏴서 필드에 [효과가] 일어나는 범위 공격, 일반적인 마법 스킬같은 느낌,
	-- 투사체가 날아가는건 없음" — IceQuiverAttack/FireQuiverAttack과 동일한 GetGroundPriorityTargets
	-- 방식이지 개별 발사체가 아님). 매 캐스트 anchor 2곳 고정(레벨 무관). 각 anchor 반경 안의 몬스터를
	-- 전부 타격 — 슬로우 상태가 아니면 슬로우+스턴을 100% 동시에 걸고, 이미 슬로우 상태면(유저 확인:
	-- "슬로우가 아닌애들은 슬로우걸리고 슬로우 걸린애들은 추가대미지 들어간다는거야") 대신 0.2초 뒤
	-- 추가 대미지(기본 대미지의 120%/140%/160% — 파이어 퀴버 슬로우 추가딜과 동일한 지연 표시 기법)를
	-- 별도로 띄운다.
	-- 연출 4종(발사/공격연출/타격이미지/스턴이미지)은 REST 리소스 API 실측 확인 결과 전부 여러 프레임짜리
	-- animationclip이다 — 네이티브 재생에 맡기면 공용 skilleffect 모델의 Duration 캡에 걸려 중간에 잘릴
	-- 수 있다(유저 강한 피드백: "온전하게 실행되게끔 항상 만들랬지"). 그래서 4종 전부 원본 프레임을 직접
	-- 추출해 수동으로 이어붙인다(아이스/파이어 퀴버의 PlayXxxBurst와 동일 기법, PlayArrowIllusionFrames
	-- 공용 헬퍼로 통합). "발사"가 총 프레임 수만큼 온전히 다 재생된 시점에 "공격연출"을 그 자리에 띄우고,
	-- 그 공격연출 위치를 기준으로 범위 대미지를 적용한다(유저 지정: "연출 끝날때쯤 82f4a186... 실행해서
	-- 82f4a186... 기준으로 범위대미지를 입혀라").
	@Sync property integer ArrowIllusionLevel = 0
	property string Card114Name = "애로우 일루전"
	property string Card114IconRUID = "333f9c5876124f14aa9a1ad80265a3f3"
	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 전용 팩에 번들 오디오가 없어 같은 활 계열
	-- 애로우 블로우(Card102) 사운드 재사용
	property string Card114SoundRUID = "b4c345306d4948f1a0b8cc787fd57bef"

	method void PlayArrowIllusionSound()
		_SoundService:PlaySound(self.Card114SoundRUID, 1.0)
	end
	property number Card114Cooldown = 4.0  -- 레벨 무관 고정
	property integer Card114TargetCount = 2  -- 레벨 무관 고정 anchor 수
	-- 기준값 — 실제 사용값은 레벨별 배율(GetArrowIllusionRadius/EffectScale)이 곱해진 값이다.
	-- 유저 요청으로 연출크기 1.7배 확대(0.63 → 1.071) + 히트 판정 반경도 동일 배율로 동반 확대
	property number Card114BaseRadius = 1.071
	property number Card114EffectYOffset = 0.0  -- 유저 요청으로 위로 1만큼 이동(-1.0 → 0.0)
	property number Card114BaseEffectScale = 1.071

	-- 레벨별 연출/판정 배율 — Lv1~2: +15% / Lv3: +20%
	method number GetArrowIllusionSizeMult(integer level)
		if level >= 3 then return 1.20
		end
		return 1.15
	end

	method number GetArrowIllusionRadius(integer level)
		return self.Card114BaseRadius * self:GetArrowIllusionSizeMult(level)
	end

	method number GetArrowIllusionEffectScale(integer level)
		return self.Card114BaseEffectScale * self:GetArrowIllusionSizeMult(level)
	end
	property number Card114FrameDuration = 0.05  -- 프레임당 재생시간(파이어 퀴버 Card104FrameDuration과 동일값)
	property number Card114SlowedBonusDelay = 0.2  -- 슬로우 대상 추가 대미지 표시 지연(파이어 퀴버와 동일)

	-- 발사(5a2a151e...) 16프레임 — GET /v3/resources/{ruid} 실측으로 얻은 payload.frames[].spriteRuid 순서 그대로
	method table GetArrowIllusionCastFrames()
		return {
			"4749947990ac43a8aee956dd19e92d2f",
			"de131f0ba7f349789293f32bbe64f3d7",
			"f655b6c4053d4efcbf8021c04f120432",
			"d2e2e413219048bb9bfc82a853fcf179",
			"783de070e0f341babfcea3c90c481f2a",
			"eb3ec2eed5ed48c1a300dec59dbdbfeb",
			"9b182b4761ae4a60922d43d3592c84ad",
			"e937e63015e848ae8eb80acd852a01a5",
			"2c65ca913045444881abb361b273bf22",
			"b91470fe8436467da91515038799463b",
			"1ff0609481ea4910b805cf9f44914480",
			"1a8e888091e84d7b92eeec1fd8f04567",
			"e3edd9216caa41e68704bc9951bbe277",
			"6f44a471ce8044879e12e41f46cfefea",
			"ec93ebff8e4a451582fb736cc558bf88",
			"842fa10b6b734f5cb3735d1664c5582c",
		}
	end

	-- 공격연출(82f4a186...) 6프레임 — 이 프레임이 뜨는 시점에 실제 범위 대미지가 들어간다
	method table GetArrowIllusionImpactFrames()
		return {
			"14da087fccfb41e2bedb170d652abc58",
			"7fd098b2619142e4a23f7b7fe0c62ffc",
			"d64af77abbd74a7b8d4b6b075f423f24",
			"0d89975ccac2467f933398dfb575efa7",
			"d1ec6847870a48b89e91589282092325",
			"d0233cb670c14a119be4684f8b805512",
		}
	end

	-- 타격 이미지(c6a582fa...) 6프레임 — 개별 피격 대상 표시
	method table GetArrowIllusionHitFrames()
		return {
			"ae80d50129ef4f76af8c8de09356942a",
			"2e3661a113f545e28c5daa1e582ead8b",
			"d2ddbec104544bb1971e8642edf4c051",
			"b4780f1ec00b4f8b8004a0c16cf0fc17",
			"133cccca8f1e4f1b8962e88281059e1c",
			"3c3343702e724562b346f726c9754f13",
		}
	end

	method number GetArrowIllusionDamage(integer level)
		if level >= 3 then return 260
		elseif level >= 2 then return 240
		end
		return 200
	end

	-- 슬로우+스턴 동시 적용 지속시간(초) — Lv1:2 / Lv2:3 / Lv3:4
	-- SkillInventory 에로우 일루전(인덱스28) Lv9: 스턴 시간 +1초, 카드 자체 레벨과 별개로 항상 가산
	method number GetArrowIllusionStatusDuration(integer level)
		local base = 2
		if level >= 3 then base = 4
		elseif level >= 2 then base = 3
		end
		return base + self:GetSkillInvTierPercent(28, 0, 0, 1.0)
	end

	-- 이미 슬로우 상태인 대상에게 추가로 들어가는 대미지 비율(기본 대미지 대비) — Lv1:120% / Lv2:140% / Lv3:160%
	method number GetArrowIllusionSlowedBonusRatio(integer level)
		if level >= 3 then return 1.60
		elseif level >= 2 then return 1.40
		end
		return 1.20
	end

	@ExecSpace("ServerOnly")
	method void ArrowIllusionAttack(number damage, boolean isCrit)
		self:PlayArrowIllusionSound()
		local map = self:GetCurrentMap()
		if map == nil then return end
		local level = self.ArrowIllusionLevel
		local statusDuration = self:GetArrowIllusionStatusDuration(level)
		local bonusRatio = self:GetArrowIllusionSlowedBonusRatio(level)
		local anchors = self:GetGroundPriorityTargets(self.Card114TargetCount)
		local radius = self:GetArrowIllusionRadius(level)
		-- "발사"가 온전히 다 재생된 뒤(=총 프레임 수만큼)에야 "공격연출"이 뜨고 대미지가 들어간다
		local castDuration = self.Card114FrameDuration * #self:GetArrowIllusionCastFrames()
		local monsters = self:GetMonstersInCurrentZone(map)
		local hitCount = 0
		for _, anchor in ipairs(anchors) do
			if isvalid(anchor) and isvalid(anchor.Entity) and not anchor._dead then
				local centerPos = anchor.Entity.TransformComponent.Position
				local fxPos = Vector3(centerPos.x, centerPos.y + self.Card114EffectYOffset, centerPos.z)
				self:PlayArrowIllusionCast(fxPos, self:GetEffectScaleRatio(anchor) * self:GetArrowIllusionEffectScale(level))
				-- 버그 수정(2026-08-26, 유저 지적: "화면 넘어갔는데 이펙트가 다음 존에 존재") — 캐스트
				-- 시점 존 인덱스를 캡처해, castDuration이 지나 착탄 콜백이 실행될 때 플레이어가 이미
				-- 다른 존으로 넘어갔으면 착탄/타격 이펙트 스폰을 건너뛴다.
				local castZoneIndex = anchor._spawnZoneIndex

				_TimerService:SetTimerOnce(function()
					if not isvalid(self) then return end
					if not isvalid(anchor) or not isvalid(anchor.Entity) or anchor._dead then return end
					local zoneOk = castZoneIndex == _MapManager.CurrentMapIndex
					if zoneOk then self:PlayArrowIllusionImpact(fxPos) end
					for _, mob in ipairs(monsters) do
						---@type MonsterAI
						local m = mob
						if isvalid(m) and not m._dead then
							local mp = m.Entity.TransformComponent.Position
							local dx = mp.x - centerPos.x
							local dy = mp.y - centerPos.y
							if (dx * dx + dy * dy) <= (radius * radius) and self:IsSameDepthBand(anchor, m) then
								if isCrit then m:TakeDamageCrit(damage * 2)
								else m:TakeDamage(damage) end
								if zoneOk then self:PlayArrowIllusionHitImage(m) end

								if m._isSlowed then
									local bonusDamage = damage * bonusRatio
									_TimerService:SetTimerOnce(function()
										if not isvalid(self) then return end
										if isvalid(m) and isvalid(m.Entity) and not m._dead then
											if isCrit then m:TakeDamageCrit(bonusDamage * 2)
											else m:TakeDamage(bonusDamage) end
										end
									end, self.Card114SlowedBonusDelay)
								else
									m:ApplySlow(statusDuration)
									-- 커스텀 스턴 이미지(b84f2bc1...)가 안 보이는 문제(유저 지적) — 자체
									-- 연출 대신 썬더볼트/썬더스톰과 동일하게 네이티브 스턴 인디케이터를
									-- 쓴다(유저 요청: "다른 스킬 스턴이랑 크기 연출 통일하면 된다")
									m:ApplyStun(statusDuration, true)
								end
								hitCount = hitCount + 1
							end
						end
					end
				end, castDuration)
			end
		end
		log("ArrowIllusionAttack: anchors=" .. #anchors .. " radius=" .. radius .. " dmg=" .. math.floor(damage) .. " castDuration=" .. castDuration .. " statusDuration=" .. statusDuration .. " bonusRatio=" .. bonusRatio)
	end

	-- 원본 애니메이션클립을 네이티브 재생에 맡기지 않고 프레임을 직접 추출해 수동으로 이어붙인다(유저
	-- 요청: "온전하게 실행되게끔 항상 만들랬지" — 공용 skilleffect 모델의 Duration 캡에 걸려 도중에
	-- 잘리는 문제를 원천 차단하는 프로젝트 기본 기법, 아이스/파이어 퀴버의 PlayXxxBurst와 동일 패턴).
	-- 애로우 일루전 연출 4종(발사/공격연출/타격이미지/스턴이미지)이 전부 이 구조를 공유해서 헬퍼로 뺐다.
	@ExecSpace("ServerOnly")
	method void PlayArrowIllusionFrames(table frames, Vector3 pos, number scale)
		local dur = self.Card114FrameDuration
		local fx = self:SpawnEffectWithModel(frames[1], pos, 0, 1.0, scale, 1.0, "skilleffectlong")
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		for i = 2, #frames do
			local frameRUID = frames[i]
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) and isvalid(renderer) then renderer.SpriteRUID = frameRUID end
			end, dur * (i - 1))
		end
		fx:Destroy(dur * #frames)
	end

	@ExecSpace("ServerOnly")
	method void PlayArrowIllusionCast(Vector3 pos, number scale)
		self:PlayArrowIllusionFrames(self:GetArrowIllusionCastFrames(), pos, scale)
	end

	@ExecSpace("ServerOnly")
	method void PlayArrowIllusionImpact(Vector3 pos)
		self:PlayArrowIllusionFrames(self:GetArrowIllusionImpactFrames(), pos, 1.0)
	end

	@ExecSpace("ServerOnly")
	method void PlayArrowIllusionHitImage(MonsterAI target)
		if not isvalid(target) or not isvalid(target.Entity) then return end
		local pos = target.Entity.TransformComponent.Position
		self:PlayArrowIllusionFrames(self:GetArrowIllusionHitFrames(), pos, 1.0)
	end


	-- ── 실피드 전용: 피닉스 (카드 105, 슬롯형 정식 스킬 5호) — 지금까지와 완전히 다른 "소환수" 패턴.
	-- 시전 시 화면 위에서 피닉스 한 마리가 나타나(summon/summoned) 매 공격마다 그 시점 최근접 적
	-- 위로 날아가서(summon/fly) 그 자리에 불기둥(summon/attack1)을 만들어 광역 데미지를 준다 — 유저
	-- 확인: "가장 가까운 적 위로 이동해서 공격, 매 공격마다 다시 최근접 적을 갱신", 공격 간격 1.5초
	-- 고정(유저 확인). 유지시간(레벨별 3~7초, Lv+2) 동안 반복하다가 소환 해제(summon/die) 후 사라진다.
	-- 슬로우 상태인 대상 추가 데미지는 파이어 퀴버(카드104)와 동일한 메커니즘(0.2초 뒤 별도 표시)을
	-- 그대로 재사용한다. 공용 "skilleffectlong" 모델의 기본 Duration(2.5초)로는 피닉스의 실제 수명
	-- (최대 약 7.5초)을 못 버텨서, 스폰 직후 SkillEffectAI.Duration을 직접 늘려 덮어쓴다.
	@Sync property integer PhoenixLevel = 0
	property string Card105Name = "피닉스"
	property string Card105IconRUID = "fd051469cf104e0bb1597e6930619354"
	property number Card105Cooldown = 10.0  -- 레벨 무관 고정
	property number Card105BaseRadius = 1.32  -- 레벨 무관 기본 반경(Lv2/Lv5에서 10%씩 증가) — 유저 요청으로 1.2에서 10% 추가 확대
	property number Card105Scale = 1.04  -- 유저 요청으로 전체 크기 20% 축소(1.3→1.04)
	property Vector3 Card105SpawnPosition = Vector3(0, 3.0, -0.1)  -- 근처에 적이 하나도 없을 때만 쓰는 대체 위치
	property number Card105HoverYOffset = -0.1  -- 타겟 위치 기준 높이(유저 요청으로 0.9→-0.1, 공격 위치가 너무 높았음)
	property number Card105DepthZ = -2.0  -- 몬스터 Z(0~0.65) 범위보다 앞선 고정값 — 항상 몬스터 위에 그려지게(허수아비의 ScarecrowDepthZ와 동일한 방식, 유저 요청). 기존 -1.0에서 유저가 "몬스터가 더 위에 그려지는 것 같다"고 해서 여유폭을 더 크게 뒀다
	property number Card105SummonAppearDuration = 0.8  -- 소환 연출(10프레임) 재생 시간
	property number Card105RepositionDuration = 0.3  -- 매 공격 시 타겟 위치로 이동하는 시간 — 소환 위치 고정 기준 탐색으로 이동 거리 자체가 짧아져서 0.7 유지 시 공격 간격(1.5초) 안에서 공격 연출이 보일 시간이 부족했음(유저 확인: "마지막 공격만 재대로 연출나오고 그전 공격은 연출이 다 짤린다"), 0.3으로 되돌려 공격 포즈 표시 시간을 확보
	property number Card105FlameAppearDelay = 0.6  -- 공격 포즈 시작 후 앞쪽에 화염이 실제로 생기는 시점(데미지는 이때 적용) — 유저 요청으로 0.4→0.6(+0.2초 더 늦게)
	property number Card105FlameForwardOffset = 1.5  -- 피닉스 몸통을 공격 지점(=타겟 위치)에서 이만큼 뒤로 물려서 세우는 거리(유저 요청으로 0.2→1.2→1.5)
	property number Card105DieDuration = 0.65  -- 소환 해제 연출(8프레임) 재생 시간 — 1.2초는 루프가 한 번 더 돌아서 보였음(유저 확인), 프레임 수에 맞춰 축소
	property number Card105AttackInterval = 1.5  -- 레벨 무관 고정(유저 확인)
	property number Card105SlowedBonusDelay = 0.2
	property string Card105SummonedRUID = "46198aa7dd8245b59ea37305c57df9f0"  -- 소환 연출
	property string Card105FlyRUID = "b4ff5a77f4bd4de4b685f6356512492d"  -- 이동 연출
	property string Card105StandRUID = "58b437598f4a4206a0dfeb19c044b2aa"  -- 대기(공격 사이) 연출
	property string Card105AttackRUID = "64658cc8a2b54c3bb023593d90a08c7c"  -- 공격(불기둥) 연출
	property string Card105DieRUID = "f5a1e8e491904f24b13a6381ca860b2a"  -- 소환 해제 연출
	property string Card105HitRUID = "3a436ae129ae4aab8ca9533d8864afc7"  -- 대미지 착탄 시 재생하는 폭발 히트 연출(유저 지정)
	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 전용 리소스팩 번들 오디오(_audio/Use) 사용
	property string Card105SoundRUID = "27144cdcb71e40fba845e2f084b257ab"

	method void PlayPhoenixSound()
		_SoundService:PlaySound(self.Card105SoundRUID, 1.0)
	end
	property number Card105HitScale = 1.0
	property number Card105HitLifetime = 0.4
	property number Card105HitYOffset = 0.6  -- 히트 연출을 착탄 좌표보다 위로 띄움(유저 요청)
	property Entity _phoenixEntity = nil
	property Entity _phoenixMap = nil  -- 피닉스가 현재 있는 맵(존 이동 감지용) — self._phoenixEntity와 항상 짝으로 갱신
	-- 버그 수정(2026-08-22) — Entity 비교로는 ep2_map3/ep2_map4(존 10개가 container=nil로 파일 하나를
	-- 공유)에서 존 이동이 절대 감지되지 않았다(_shadowPartnerZoneIndex 선언부 주석 참고). 아래 "존나이동"
	-- 버그 주석은 FindClosestByPosition으로 대상 선정을 고친 것뿐이라 이 근본 원인은 그때 못 잡았었다.
	property integer _phoenixZoneIndex = -1
	property Vector3 _phoenixAnchorPos = Vector3(0, 0, 0)  -- 소환된(또는 존 이동 후 재소환된) 고정 위치 — 타겟 탐색 기준점(유저 요청: "소환된 위치로부터 가장 가까운적 공격")
	property boolean _phoenixFacingRight = false  -- 현재 바라보는 방향(FlipX와 동일한 값) — 화염 판정 중심 오프셋 방향에 사용
	property boolean _phoenixAttackInProgress = false  -- 이동→화염 판정까지 진행 중이면 true — 유지시간 만료 시 이 공격이 끝날 때까지 소환 해제를 미루는 데 사용

	method number GetPhoenixDamage()
		if self.PhoenixLevel >= 5 then return 250
		elseif self.PhoenixLevel >= 4 then return 200
		elseif self.PhoenixLevel >= 3 then return 170
		elseif self.PhoenixLevel >= 2 then return 140
		end
		return 120
	end

	-- 레벨별 유지시간 3/4/5/6/7초
	-- SkillInventory 피닉스(인덱스24) Lv9: 유지시간 +1초, 카드 자체 레벨과 별개로 항상 가산
	method number GetPhoenixDuration()
		return self.PhoenixLevel + 2 + self:GetSkillInvTierPercent(24, 0, 0, 1.0)
	end

	-- Lv2에서 반경 +10%, Lv5에서 다시 +10%(누적 +20%)
	method number GetPhoenixRadius()
		if self.PhoenixLevel >= 5 then return self.Card105BaseRadius * 1.20
		elseif self.PhoenixLevel >= 2 then return self.Card105BaseRadius * 1.10
		end
		return self.Card105BaseRadius
	end

	-- 슬로우 상태 대상 추가 데미지 배율(1.4~2.2 = +40%~+120%) — 파이어 퀴버와 동일 진행
	method number GetPhoenixSlowedBonusMult()
		if self.PhoenixLevel >= 5 then return 2.2
		elseif self.PhoenixLevel >= 4 then return 2.0
		elseif self.PhoenixLevel >= 3 then return 1.8
		elseif self.PhoenixLevel >= 2 then return 1.6
		end
		return 1.4
	end

	@ExecSpace("ServerOnly")
	method void PhoenixAttack(number damage, boolean isCrit)
		self:PlayPhoenixSound()
		local map = self:GetCurrentMap()
		if map == nil then return end

		-- 이미 소환된 피닉스가 남아있으면 정리 후 재소환(쿨타임이 항상 유지시간보다 길어서 정상
		-- 플레이에선 거의 발생하지 않지만 방어적으로 처리)
		if isvalid(self._phoenixEntity) then
			self._phoenixEntity:Destroy()
			self._phoenixEntity = nil
		end
		self._phoenixAttackInProgress = false

		local duration = self:GetPhoenixDuration()
		local leadTime = self.Card105SummonAppearDuration
		local interval = self.Card105AttackInterval

		-- 화면 위 고정 좌표 대신 그 시점 최근접 적 근처에서 소환한다(유저 피드백: "지금은 무슨
		-- 하늘에서 날라오네" — 기존엔 고정 좌표에서 스폰한 뒤 첫 공격 때 먼 거리를 빠르게 이동해서
		-- 마치 하늘에서 낙하하는 것처럼 보였다). 주변에 적이 없을 때만 기본 위치를 쓴다.
		local firstTarget = self:FindClosestInMap(map)
		local spawnPos = self.Card105SpawnPosition
		if firstTarget ~= nil and isvalid(firstTarget) and isvalid(firstTarget.Entity) then
			local tp = firstTarget.Entity.TransformComponent.Position
			-- Z는 타겟의 깊이를 그대로 물려받지 않고 고정값을 쓴다(유저 요청: "피닉스는 허수아비처럼
			-- 뎁스 위에 올라오게" — 허수아비도 몬스터 Z(0~0.65) 범위보다 앞선 고정값(-1.0)을 써서
			-- 항상 몬스터 위에 그려지게 하는 것과 동일한 방식).
			spawnPos = Vector3(tp.x, tp.y + self.Card105HoverYOffset, self.Card105DepthZ)
		end

		-- "skilleffectlong"은 script.SkillEffectAI가 붙어있어 스폰 직후 Duration을 늘려 덮어써도
		-- 이미 OnBeginPlay에서 예전 기본값(2.5초)으로 타이머가 잡힌 뒤라 소용이 없었다(유저 실측:
		-- "공격 모션하고 사라지는게 아니라 유지시간동안은 계속 있어야해" — 실제로는 최대 7.5초까지
		-- 유지돼야 하는데 2.5초 만에 죽고 있었음). 자동 소멸 스크립트가 아예 없는 전용 모델
		-- "persistenteffect"를 새로 만들어 쓰고, 수명은 아래 타이머로 직접 100% 관리한다.
		local phoenix = self:SpawnEffectWithModel(self.Card105SummonedRUID, spawnPos, 0, 1.0, self.Card105Scale, 1.0, "persistenteffect")
		if phoenix == nil then return end
		self._phoenixEntity = phoenix
		self._phoenixMap = map
		self._phoenixZoneIndex = _MapManager.CurrentMapIndex
		self._phoenixAnchorPos = spawnPos

		_TimerService:SetTimerOnce(function()
			local fx = self._phoenixEntity
			if isvalid(fx) then
				local r = fx.SpriteRendererComponent
				if r ~= nil then r.SpriteRUID = self.Card105StandRUID end
			end
		end, leadTime)

		-- 공격 틱은 phoenix/map을 직접 캡처하지 않고 매번 self._phoenixEntity / self._phoenixMap을
		-- 그때그때 다시 읽는다 — 존 이동으로 중간에 피닉스가 재소환(RelocatePhoenixToNewMap)돼도
		-- 이미 예약된 타이머들이 예전(파괴된) 엔티티를 계속 참조하지 않도록 하기 위함이다.
		local attackCount = math.floor(duration / interval)
		for i = 0, attackCount - 1 do
			local delay = leadTime + i * interval
			_TimerService:SetTimerOnce(function()
				self:PhoenixAttackTick(damage, isCrit)
			end, delay)
		end

		_TimerService:SetTimerOnce(function()
			self:TryEndPhoenixLife()
		end, leadTime + duration)

		log("PhoenixAttack: duration=" .. duration .. " attacks=" .. attackCount .. " radius=" .. self:GetPhoenixRadius() .. " dmg=" .. math.floor(damage))
	end

	-- 유지시간이 다 됐을 때 호출된다. 마침 공격이 진행 중이면(이동→화염 판정까지) 바로 없애지 않고
	-- 그 공격이 끝날 때까지 조금씩 미뤘다가 사라진다(유저 요청: "공격 도중에 지속시간이 다되서
	-- 사라질때는 예외로 공격이 다 끝나고 사라지게끔해줘").
	@ExecSpace("ServerOnly")
	method void TryEndPhoenixLife()
		if not isvalid(self) then return end
		if self._phoenixAttackInProgress then
			_TimerService:SetTimerOnce(function()
				self:TryEndPhoenixLife()
			end, 0.1)
			return
		end
		local fx = self._phoenixEntity
		if isvalid(fx) then
			local r = fx.SpriteRendererComponent
			if r ~= nil then r.SpriteRUID = self.Card105DieRUID end
			fx:Destroy(self.Card105DieDuration)
		end
		self._phoenixEntity = nil
		self._phoenixMap = nil
	end

	-- 주어진 맵 안에서 접근도(스케일)가 가장 높은 살아있는 몬스터 1명을 반환 — 소환 위치를 정할 때만
	-- 쓴다(그 시점엔 아직 피닉스 자신의 좌표가 없으므로 "화면에 가장 가까이 온" 기준이 자연스럽다).
	@ExecSpace("ServerOnly")
	method MonsterAI FindClosestInMap(Entity map)
		if map == nil then return nil end
		local monsters = self:GetMonstersInCurrentZone(map)
		local best = nil
		local bestScale = -1
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead then
				local scale = m._currentScale or 0
				if scale > bestScale then
					best = m
					bestScale = scale
				end
			end
		end
		return best
	end

	-- 주어진 좌표에서 실제 거리로 가장 가까운 살아있는 몬스터 1명을 반환 — 공격 틱마다 이걸 쓴다
	-- (유저 요청: "가장 가까운적 공격하도록해라" — FindClosestInMap의 스케일 기준은 "화면/플레이어와
	-- 가장 가까운 적"이라 피닉스가 있는 위치와 무관하게 매번 엉뚱하게 먼 적으로 튈 수 있었다. 그게
	-- "존나이동" 버그의 근본 원인으로 보임 — 이제 피닉스 자기 위치 기준 실거리로 고른다).
	@ExecSpace("ServerOnly")
	method MonsterAI FindClosestByPosition(Entity map, Vector3 fromPos)
		if map == nil then return nil end
		local monsters = self:GetMonstersInCurrentZone(map)
		local best = nil
		local bestDistSq = -1
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local mp = m.Entity.TransformComponent.Position
				local dx = mp.x - fromPos.x
				local dy = mp.y - fromPos.y
				local distSq = dx * dx + dy * dy
				if bestDistSq < 0 or distSq < bestDistSq then
					best = m
					bestDistSq = distSq
				end
			end
		end
		return best
	end

	-- 존 이동 감지 시 피닉스를 플레이어의 새 맵으로 다시 소환한다(유저 요청: "얘는 존이동해도 계속
	-- 따라와야한다고"). 예전 엔티티는 파괴하고, self._phoenixEntity/_phoenixMap을 새 것으로 갱신만
	-- 하면 이미 예약된 공격/소환해제 타이머들은 다음 실행 때 자동으로 새 엔티티를 집는다.
	@ExecSpace("ServerOnly")
	method void RelocatePhoenixToNewMap(Entity newMap)
		local oldPhoenix = self._phoenixEntity
		local anchor = self:FindClosestInMap(newMap)
		local pos = self.Card105SpawnPosition
		if anchor ~= nil and isvalid(anchor) and isvalid(anchor.Entity) then
			local ap = anchor.Entity.TransformComponent.Position
			pos = Vector3(ap.x, ap.y + self.Card105HoverYOffset, self.Card105DepthZ)
		end
		local fresh = self:SpawnEffectWithModel(self.Card105StandRUID, pos, 0, 1.0, self.Card105Scale, 1.0, "persistenteffect")
		if fresh == nil then return end
		if isvalid(oldPhoenix) then oldPhoenix:Destroy() end
		self._phoenixEntity = fresh
		self._phoenixMap = newMap
		self._phoenixZoneIndex = _MapManager.CurrentMapIndex
		self._phoenixAnchorPos = pos
	end

	-- 공격 1회 — self._phoenixEntity/_phoenixMap을 그때그때 다시 읽어서(캡처된 값 아님) 존 이동을
	-- 감지하고, 그 시점 실거리 최근접 적 위로 이동한 뒤 불기둥(ResolvePhoenixHit)을 띄운다. 적이
	-- 하나도 없으면 이번 틱은 조용히 건너뛴다.
	@ExecSpace("ServerOnly")
	method void PhoenixAttackTick(number damage, boolean isCrit)
		if not isvalid(self) then return end
		local phoenix = self._phoenixEntity
		if not isvalid(phoenix) then return end

		-- 플레이어가 피닉스가 있던 존과 다른 존으로 이동했으면, 그 자리에서 사라지고 플레이어의
		-- 현재 존에서 다시 나타나 계속 따라온다. Entity 비교가 아니라 존 인덱스로 비교한다(위
		-- _phoenixZoneIndex 선언부 주석 참고).
		if _MapManager.CurrentMapIndex ~= self._phoenixZoneIndex then
			local liveMap = self:GetCurrentMap()
			if liveMap ~= nil then
				self:RelocatePhoenixToNewMap(liveMap)
				phoenix = self._phoenixEntity
				if not isvalid(phoenix) then return end
			end
		end
		local map = self._phoenixMap

		local startPos = phoenix.TransformComponent.Position
		-- 타겟 선정 기준점은 피닉스의 "현재" 위치가 아니라 "소환된(고정)" 위치다(유저 명확화: "소환된
		-- 위치로부터 가장 가까운적 공격해야한다니깐?" — 매번 이동한 뒤의 위치를 기준으로 다시 고르면
		-- 기준점 자체가 계속 밀려서 몬스터가 흩어져 있을 때 점점 먼 곳으로 끌려가듯 이동하게 된다).
		local target = self:FindClosestByPosition(map, self._phoenixAnchorPos)
		if target == nil or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end

		-- 이 공격을 실행하기로 확정 — 화염 판정이 끝날 때까지 유지시간 만료로 인한 소환 해제를 미룬다
		self._phoenixAttackInProgress = true

		local renderer = phoenix.SpriteRendererComponent
		local targetPos = target.Entity.TransformComponent.Position

		-- 이동 방향에 맞춰 이미지 좌우를 뒤집는다(유저 확인: FlipY가 아니라 FlipX가 맞음)
		local facingRight = self._phoenixFacingRight
		if targetPos.x > startPos.x then facingRight = true
		elseif targetPos.x < startPos.x then facingRight = false end
		self._phoenixFacingRight = facingRight
		if renderer ~= nil then renderer.FlipX = facingRight end

		-- 데미지가 실제로 들어가는 곳은 피닉스 몸통이 아니라 그 앞쪽(공격 지점)이므로(유저 지적:
		-- "피닉스 몸통에서 대미지가 들어가는게 아니니깐 그 앞쪽이잖아... 공격지점기준으로 잡아야지"),
		-- 공격 지점(flamePos)이 타겟 위치에 정확히 오도록 먼저 잡고, 몸통(hoverPos)은 바라보는
		-- 방향 반대쪽으로 Card105FlameForwardOffset만큼 물러선 곳에 세운다.
		local facingSign = facingRight and 1 or -1
		local flamePos = Vector3(targetPos.x, targetPos.y + self.Card105HoverYOffset, targetPos.z)
		-- 몸통(hoverPos)의 Z는 타겟 깊이를 물려받지 않고 고정값을 쓴다(허수아비와 동일한 이유 —
		-- 유저 요청: "피닉스는 허수아비처럼 뎁스 위에 올라오게").
		local hoverPos = Vector3(flamePos.x - facingSign * self.Card105FlameForwardOffset, flamePos.y, self.Card105DepthZ)

		-- 공중 몬스터처럼 천천히 날개짓하며 이동(유저 요청: "아니 천천히 이동" — 기존 0.3초는 순간
		-- 이동처럼 보였음)
		if renderer ~= nil then renderer.SpriteRUID = self.Card105FlyRUID end
		_TweenLogic:PlayTween(0.0, 1.0, self.Card105RepositionDuration, EaseType.Linear, function(t)
			if not isvalid(phoenix) then return end
			local x = startPos.x + (hoverPos.x - startPos.x) * t
			local y = startPos.y + (hoverPos.y - startPos.y) * t
			phoenix.TransformComponent.Position = Vector3(x, y, hoverPos.z)
		end)

		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(phoenix) then return end
			if renderer ~= nil then renderer.SpriteRUID = self.Card105AttackRUID end
			-- 공격 연출(22프레임짜리 긴 클립)은 여기서 억지로 대기 포즈로 되돌리지 않는다 — 다음
			-- 공격 틱(Card105AttackInterval=1.5초 뒤)이 Fly로 자연스럽게 덮어쓸 때까지 그대로 재생되게
			-- 둔다(유저 피드백: "연출이 짤리는듯?" — 기존엔 0.3초 만에 강제로 되돌려서 22프레임짜리
			-- 클립이 끝까지 재생되기 전에 잘렸다).

			-- 데미지는 공격 포즈 시작과 동시가 아니라, 날개짓 도중 앞쪽에 화염이 실제로 생기는
			-- 타이밍에 맞춰서 들어간다(유저 요청: "날개짓하면 피닉스 앞쪽에 화염이 생기잖아 그 범위로
			-- 대미지가 그타이밍에 들어가야하고")
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				self:ResolvePhoenixHit(map, target, flamePos, damage, isCrit)
				self._phoenixAttackInProgress = false
			end, self.Card105FlameAppearDelay)
		end, self.Card105RepositionDuration)
	end

	-- 화염 착탄 지점(centerPos, 피닉스 몸이 아니라 앞으로 뻗어나간 지점) 기준 고정 반경 판정 —
	-- 아이스/파이어 퀴버와 동일한 패턴. 슬로우 상태 대상은 0.2초 뒤 추가 데미지를 별도로 띄운다
	-- (파이어 퀴버와 동일한 이유). map은 피닉스가 소환된 맵으로 고정(플레이어의 현재 맵이 아님) —
	-- FindClosestInMap과 동일한 이유. anchor는 깊이 밴드(IsSameDepthBand) 비교 기준으로만 쓴다 —
	-- centerPos는 이미 고정된 좌표라 anchor가 그 사이 죽어도(IsSameDepthBand는 무효 대상이면 그냥
	-- true를 반환) 화염 판정 자체는 항상 이어서 실행된다(유저 요청: "몬스터가 죽어도 공격은
	-- 이어서하고 그 반경에 들어간 적은 대미지 들어가게해야해" — 기존엔 anchor가 죽으면 통째로
	-- 건너뛰어서 반경 안 다른 몬스터까지 데미지가 안 들어갔다).
	@ExecSpace("ServerOnly")
	method void ResolvePhoenixHit(Entity map, MonsterAI anchor, Vector3 centerPos, number damage, boolean isCrit)
		if map == nil then return end
		-- 착탄 지점에 폭발 히트 연출 재생 — 다른 광역 스킬(아이스/파이어 퀴버, 언카운터 에로우)과
		-- 동일하게 대미지 판정과 무관하게(맞은 대상이 0명이어도) 항상 재생한다.
		local hitScaleRatio = 1.0
		if isvalid(anchor) then hitScaleRatio = self:GetEffectScaleRatio(anchor) end
		local hitPos = Vector3(centerPos.x, centerPos.y + self.Card105HitYOffset, centerPos.z)
		local fxHit = self:SpawnEffectWithModel(self.Card105HitRUID, hitPos, 0, 1.0, self.Card105HitScale * hitScaleRatio, 1, "skilleffectlong")
		if fxHit ~= nil then fxHit:Destroy(self.Card105HitLifetime) end

		local radius = self:GetPhoenixRadius()
		local slowedBonusMult = self:GetPhoenixSlowedBonusMult()
		local monsters = self:GetMonstersInCurrentZone(map)
		local hitCount = 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead then
				local mp = m.Entity.TransformComponent.Position
				local dx = mp.x - centerPos.x
				local dy = mp.y - centerPos.y
				if (dx * dx + dy * dy) <= (radius * radius) and self:IsSameDepthBand(anchor, m) then
					if isCrit then m:TakeDamageCrit(damage * 2)
					else m:TakeDamage(damage) end
					if m._isSlowed then
						local bonusDamage = damage * (slowedBonusMult - 1.0)
						_TimerService:SetTimerOnce(function()
							if not isvalid(self) then return end
							if isvalid(m) and isvalid(m.Entity) and not m._dead then
								if isCrit then m:TakeDamageCrit(bonusDamage * 2)
								else m:TakeDamage(bonusDamage) end
							end
						end, self.Card105SlowedBonusDelay)
					end
					hitCount = hitCount + 1
				end
			end
		end
		log("PhoenixHit: hit=" .. hitCount .. " radius=" .. radius .. " dmg=" .. math.floor(damage))
	end

	-- ── 실피드 전용 조합 스킬: 이볼브 (카드 115) — 꿰뚫는 의지(110, 슬롯 없는 패시브) + 피닉스(105)
	-- Lv5 보유 시 등장(슬롯이 꽉 차 있어도 뽑기 풀에 노출). 피닉스는 사라지고, 이볼브가 피닉스 슬롯을
	-- 그대로 넘겨받는다(꿰뚫는 의지는 패시브라 비울 슬롯이 없음). Lv1~3까지만 존재. 유저 확인: "피닉스
	-- 업글 스킬임... 피닉스의 기능이 동일하다고 보면되겠지" — 소환/추적/광역판정 구조는 피닉스와
	-- 동일하게 재사용하되 반경은 손대지 않는다(유저 요청: "범위는 건들이지말자" — 피닉스 Lv5 반경
	-- 그대로 고정). 레벨업은 대신 자체 크리티컬 확률(10/15/20%)로 간다.
	-- 공격 연출(Card115AttackRUID, 25프레임 전방 찌르기)이 재생되는 동안 대미지가 2단계로 들어간다
	-- (유저 지정):
	-- 1) "어택1" — 애니메이션 초반, 반경 안 전체 대상에게 동시에 기본 대미지의 50%/60%/70%(레벨별)
	-- 2) "히트연출" — 그 뒤 반경 안 각 대상에게 히트 이펙트(Card115HitEffectRUID, 90도 회전 적용)를
	--    찌르기에 먼저 닿은 순서(중심에서 가까운 순)로 순차적으로 띄우면서 기본 대미지의 100%를
	--    개별 적용한다. 슬로우 상태 추가딜(파이어 퀴버와 동일한 지연 표시 기법)은 이 히트(100%)에만 적용.
	-- 공격이 끝나면(피닉스처럼 대기 포즈로 전환하는 대신) 소환 연출(Card115SummonRUID)을 다시 재생해서
	-- "계속 그 자리에 떠 있는" 것처럼 보이게 한다(유저 요청: "어택 하고 끝에... 사라지는데 이걸 바로
	-- 소환하는 연출을 붙여서 유지되게 하는게 핵심" — 실제 스킬 시전(소환)/유지시간 만료(소환해제)는
	-- 이 재생과 별개의 1회성 이벤트). 이동 중에는 Card115MoveRUID를 쓴다(유저 지정: "2d212050...는
	-- 이동할때 쓰면되고"). 히트 이펙트만 아이스/파이어 퀴버와 동일한 방식(원본 프레임 직접 이어붙이기)
	-- 으로 재생한다 — 소환/이동/공격/소환해제는 피닉스와 동일하게 네이티브 재생 + 타이밍 간격으로 처리.
	@Sync property integer EvolveLevel = 0
	property string Card115Name = "이볼브"
	property string Card115IconRUID = "088e8e269661493f8794073429bae296"
	property string Card115SummonRUID = "09e28796b1c241f5aa46b959c176ac7e"  -- 소환 연출(9프레임) — 시전 시 1회 + 매 공격 뒤 대기 루프로 재사용
	property string Card115MoveRUID = "2d212050f9754a28a773b543382a339a"  -- 이동 연출(10프레임)
	property string Card115DieRUID = "21a94e8121b746b5b1ea112ec6a09e67"  -- 소환 해제 연출(8프레임) — 유지시간 만료 시 1회만
	property string Card115AttackRUID = "5daa28bdc87b4de3844acb2de3b8a163"  -- 공격(전방 찌르기) 연출(25프레임)
	property string Card115HitEffectRUID = "65c8505b497d4e60b98540c95282f83c"  -- 히트 이펙트(8프레임, 90도 회전 적용)
	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 전용 리소스팩 번들 오디오(_audio/Use) 사용
	property string Card115SoundRUID = "1bcc05d9369a4595bd05c5fe997522f8"

	method void PlayEvolveSound()
		_SoundService:PlaySound(self.Card115SoundRUID, 1.0)
	end

	property number Card115BaseRadius = 1.32  -- 피닉스와 동일 기준값(유저 요청으로 레벨별 추가 확장 없음)
	property number Card115HitRadius = 3.5  -- 실제 판정 반경(유저 스크린샷 지적으로 불길 연출 전체를 덮게 확대 — 1.584→3.5, 라이브 확인 후 재조정 가능)
	property number Card115Scale = 0.884  -- 유저 요청으로 연출 크기 15% 축소(피닉스 기준값 1.04 → 0.884)
	property Vector3 Card115SpawnPosition = Vector3(0, 3.0, -0.1)
	property number Card115HoverYOffset = -0.1
	property number Card115DepthZ = -2.0
	property number Card115SummonAppearDuration = 0.8
	property number Card115RepositionDuration = 0.3
	property number Card115Attack1Delay = 0.3  -- 공격 포즈 시작 후 "어택1"(부분 대미지) 타이밍 — 라이브 확인 후 조정
	property number Card115HitEffectStartDelay = 0.55  -- "어택1" 이후 "히트연출"(전체 대미지) 시작 타이밍
	property number Card115HitEffectStagger = 0.08  -- 히트연출 순차 표시 간격(대상 간)
	property number Card115LoopBackDelay = 1.0  -- 공격 포즈 시작 후 다시 소환 연출로 되돌리는 시점(다음 공격 전 대기)
	property number Card115DieDuration = 0.65
	property number Card115AttackInterval = 1.5  -- 피닉스와 동일 고정
	property number Card115SlowedBonusDelay = 0.2
	property number Card115FrameDuration = 0.05  -- 히트 이펙트 프레임 이어붙이기 간격
	property Entity _evolveEntity = nil
	property Entity _evolveMap = nil
	-- Entity 비교로는 ep2_map3/ep2_map4(존 10개 공유 파일)에서 존 이동이 감지 안 되는 버그 수정 —
	-- _shadowPartnerZoneIndex 선언부 주석 참고
	property integer _evolveZoneIndex = -1
	property Vector3 _evolveAnchorPos = Vector3(0, 0, 0)
	property boolean _evolveFacingRight = false
	property boolean _evolveAttackInProgress = false

	-- 히트 이펙트(65c8505b...) 8프레임 — GET /v3/resources/{ruid} 실측으로 얻은 payload.frames[].spriteRuid
	method table GetEvolveHitFrames()
		return {
			"9c37c539991c45dd8d769256d7e756c6",
			"d599031beb194bfbb5fed3e8b0bc672d",
			"406883035a24493db70d7d7d3f8078ed",
			"df89ec232eb14e6c963ddf5218300569",
			"ea38c9ad2c1544bd83ef1e4e7762e4d0",
			"894f84be40934f259acfc9f3e5d6f8ff",
			"45d99bc64b954d59b69f25eeed0f64f7",
			"a2a5a2c4bb354acda7768351c9cf9cb6",
		}
	end

	method number GetEvolveDamage(integer level)
		if level >= 3 then return 340
		elseif level >= 2 then return 320
		end
		return 300
	end

	-- 유지시간 — Lv1:5 / Lv2:6 / Lv3:7초(피닉스 Lv5의 7초에서 이어짐)
	-- SkillInventory 이볼브(인덱스29) Lv9: 유지시간 +1초, 카드 자체 레벨과 별개로 항상 가산
	method number GetEvolveDuration(integer level)
		local base = 5
		if level >= 3 then base = 7
		elseif level >= 2 then base = 6
		end
		return base + self:GetSkillInvTierPercent(29, 0, 0, 1.0)
	end

	-- 쿨타임 — Lv1:10 / Lv2:9 / Lv3:8초
	method number GetEvolveCooldown(integer level)
		if level >= 3 then return 8
		elseif level >= 2 then return 9
		end
		return 10
	end

	-- "어택1" 부분 대미지 비율 — 유저 요청으로 레벨 무관 50% 고정("대미지를 50%,50%로 바꿔줄래?")
	method number GetEvolveAttack1Ratio(integer level)
		return 0.50
	end

	-- 자체 크리티컬 확률(유저 요청 — 범위 대신 이 수치로 레벨업) — Lv1:10% / Lv2:15% / Lv3:20%
	method number GetEvolveCritChance(integer level)
		if level >= 3 then return 0.20
		elseif level >= 2 then return 0.15
		end
		return 0.10
	end

	-- 판정 반경 — 유저 스크린샷 지적: "지금 대미지범위가 빨간색인데 초록색 테두리만큼(불길 연출 전체
	-- 범위) 나와야해". 예전 피닉스 Lv5 반경(1.584, 화염 착탄점만 겨우 덮는 크기)은 어택 연출이 새가
	-- 날아가 불길이 되는 넓은 궤적 전체를 표현하기엔 너무 작았다 — Card115HitRadius로 분리해서 훨씬
	-- 크게 키운다(레벨별로는 여전히 안 건드림 — "범위는 건들이지말자"는 레벨 스케일링 얘기였고 이건
	-- 기준값 자체의 시각 불일치 수정). 라이브에서 다시 눈으로 맞춰볼 값이라 조정 가능성 있음.
	method number GetEvolveRadius()
		return self.Card115HitRadius
	end

	-- 슬로우 상태 대상 추가 데미지 비율 — Lv1:120% / Lv2:140% / Lv3:160%(파이어 퀴버와 동일 진행)
	method number GetEvolveSlowedBonusRatio(integer level)
		if level >= 3 then return 1.60
		elseif level >= 2 then return 1.40
		end
		return 1.20
	end

	@ExecSpace("ServerOnly")
	method void EvolveAttack(number damage, boolean isCrit)
		self:PlayEvolveSound()
		local map = self:GetCurrentMap()
		if map == nil then return end

		-- 이미 소환된 이볼브가 남아있으면 정리 후 재소환(쿨타임이 항상 유지시간보다 길어서 정상
		-- 플레이에선 거의 발생하지 않지만 방어적으로 처리 — 피닉스와 동일한 이유)
		if isvalid(self._evolveEntity) then
			self._evolveEntity:Destroy()
			self._evolveEntity = nil
		end
		self._evolveAttackInProgress = false

		local level = self.EvolveLevel
		local duration = self:GetEvolveDuration(level)
		local leadTime = self.Card115SummonAppearDuration
		local interval = self.Card115AttackInterval

		local firstTarget = self:FindClosestInMap(map)
		local spawnPos = self.Card115SpawnPosition
		if firstTarget ~= nil and isvalid(firstTarget) and isvalid(firstTarget.Entity) then
			local tp = firstTarget.Entity.TransformComponent.Position
			spawnPos = Vector3(tp.x, tp.y + self.Card115HoverYOffset, self.Card115DepthZ)
		end

		local evolve = self:SpawnEffectWithModel(self.Card115SummonRUID, spawnPos, 0, 1.0, self.Card115Scale, 1.0, "persistenteffect")
		if evolve == nil then return end
		self._evolveEntity = evolve
		self._evolveMap = map
		self._evolveZoneIndex = _MapManager.CurrentMapIndex
		self._evolveAnchorPos = spawnPos

		-- 공격 틱은 evolve/map을 직접 캡처하지 않고 매번 self._evolveEntity / self._evolveMap을
		-- 그때그때 다시 읽는다(피닉스와 동일한 존 이동 대응 이유)
		local attackCount = math.floor(duration / interval)
		for i = 0, attackCount - 1 do
			local delay = leadTime + i * interval
			_TimerService:SetTimerOnce(function()
				self:EvolveAttackTick(damage, isCrit, level)
			end, delay)
		end

		_TimerService:SetTimerOnce(function()
			self:TryEndEvolveLife()
		end, leadTime + duration)

		log("EvolveAttack: duration=" .. duration .. " attacks=" .. attackCount .. " radius=" .. self:GetEvolveRadius() .. " dmg=" .. math.floor(damage))
	end

	-- 유지시간이 다 됐을 때 호출된다. 공격이 진행 중이면 끝날 때까지 미뤘다가 사라진다(피닉스와 동일)
	@ExecSpace("ServerOnly")
	method void TryEndEvolveLife()
		if not isvalid(self) then return end
		if self._evolveAttackInProgress then
			_TimerService:SetTimerOnce(function()
				self:TryEndEvolveLife()
			end, 0.1)
			return
		end
		local fx = self._evolveEntity
		if isvalid(fx) then
			local r = fx.SpriteRendererComponent
			if r ~= nil then r.SpriteRUID = self.Card115DieRUID end
			fx:Destroy(self.Card115DieDuration)
		end
		self._evolveEntity = nil
		self._evolveMap = nil
	end

	-- 존 이동 감지 시 이볼브를 플레이어의 새 맵으로 다시 소환한다(피닉스의 RelocatePhoenixToNewMap과 동일)
	@ExecSpace("ServerOnly")
	method void RelocateEvolveToNewMap(Entity newMap)
		local oldEvolve = self._evolveEntity
		local anchor = self:FindClosestInMap(newMap)
		local pos = self.Card115SpawnPosition
		if anchor ~= nil and isvalid(anchor) and isvalid(anchor.Entity) then
			local ap = anchor.Entity.TransformComponent.Position
			pos = Vector3(ap.x, ap.y + self.Card115HoverYOffset, self.Card115DepthZ)
		end
		local fresh = self:SpawnEffectWithModel(self.Card115SummonRUID, pos, 0, 1.0, self.Card115Scale, 1.0, "persistenteffect")
		if fresh == nil then return end
		if isvalid(oldEvolve) then oldEvolve:Destroy() end
		self._evolveEntity = fresh
		self._evolveMap = newMap
		self._evolveZoneIndex = _MapManager.CurrentMapIndex
		self._evolveAnchorPos = pos
	end

	-- 공격 1회 — self._evolveEntity/_evolveMap을 그때그때 다시 읽어서 존 이동을 감지하고, 그 시점
	-- 실거리 최근접 적 위로 이동한 뒤 찌르기(어택1 + 히트연출)를 실행한다(피닉스와 동일 구조).
	@ExecSpace("ServerOnly")
	method void EvolveAttackTick(number damage, boolean isCrit, integer level)
		if not isvalid(self) then return end
		local evolve = self._evolveEntity
		if not isvalid(evolve) then return end

		if _MapManager.CurrentMapIndex ~= self._evolveZoneIndex then
			local liveMap = self:GetCurrentMap()
			if liveMap ~= nil then
				self:RelocateEvolveToNewMap(liveMap)
				evolve = self._evolveEntity
				if not isvalid(evolve) then return end
			end
		end
		local map = self._evolveMap

		local startPos = evolve.TransformComponent.Position
		local target = self:FindClosestByPosition(map, self._evolveAnchorPos)
		if target == nil or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end

		self._evolveAttackInProgress = true

		local renderer = evolve.SpriteRendererComponent
		local targetPos = target.Entity.TransformComponent.Position

		local facingRight = self._evolveFacingRight
		if targetPos.x > startPos.x then facingRight = true
		elseif targetPos.x < startPos.x then facingRight = false end
		self._evolveFacingRight = facingRight
		if renderer ~= nil then renderer.FlipX = facingRight end

		local facingSign = facingRight and 1 or -1
		local strikePos = Vector3(targetPos.x, targetPos.y + self.Card115HoverYOffset, targetPos.z)
		local hoverPos = Vector3(strikePos.x - facingSign * 1.2, strikePos.y, self.Card115DepthZ)
		-- 판정 중심은 착탄 지점(strikePos)이 아니라 새→불길 궤적 전체(몸통 hoverPos~착탄 지점)를
		-- 아우르도록 몸통 쪽(hoverPos)으로 당긴다(유저 스크린샷: 초록 테두리가 착탄 지점보다 훨씬
		-- 왼쪽/넓게까지 덮여 있었음)
		local flameCenterPos = hoverPos

		if renderer ~= nil then renderer.SpriteRUID = self.Card115MoveRUID end
		_TweenLogic:PlayTween(0.0, 1.0, self.Card115RepositionDuration, EaseType.Linear, function(t)
			if not isvalid(evolve) then return end
			local x = startPos.x + (hoverPos.x - startPos.x) * t
			local y = startPos.y + (hoverPos.y - startPos.y) * t
			evolve.TransformComponent.Position = Vector3(x, y, hoverPos.z)
		end)

		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(evolve) then return end
			if renderer ~= nil then renderer.SpriteRUID = self.Card115AttackRUID end

			-- 1) 어택1 — 반경 안 전체 대상에게 즉시 부분 대미지(크리티컬은 어택1/히트연출 각각 따로
			-- 판정한다 — 유저 요청: "크리 확률은 각각 적용되고")
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				self:ResolveEvolveAttack1(map, target, flameCenterPos, damage, level)
			end, self.Card115Attack1Delay)

			-- 2) 히트연출 — 그 뒤 반경 안 각 대상에게 순차적으로 부분 대미지
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				self:ResolveEvolveHitSequence(map, target, flameCenterPos, damage, level)
				self._evolveAttackInProgress = false
			end, self.Card115HitEffectStartDelay)

			-- 공격이 끝나면(사라져 보이지 않게) 소환 연출을 다시 재생해서 대기 상태로 유지한다(유저 요청)
			_TimerService:SetTimerOnce(function()
				if isvalid(evolve) and renderer ~= nil then renderer.SpriteRUID = self.Card115SummonRUID end
			end, self.Card115LoopBackDelay)
		end, self.Card115RepositionDuration)
	end

	-- 어택1: 찌르기 초반 판정 — 반경 안 전체 대상에게 동시에 기본 대미지의 50%. 크리티컬은 이 히트만의
	-- 독립 판정(유저 요청: "크리 확률은 각각 적용되고")
	@ExecSpace("ServerOnly")
	method void ResolveEvolveAttack1(Entity map, MonsterAI anchor, Vector3 centerPos, number damage, integer level)
		if map == nil then return end
		local isCrit = self:RollCrit(115)
		local radius = self:GetEvolveRadius()
		local ratio = self:GetEvolveAttack1Ratio(level)
		local partialDamage = damage * ratio
		local monsters = self:GetMonstersInCurrentZone(map)
		local hitCount = 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead then
				local mp = m.Entity.TransformComponent.Position
				local dx = mp.x - centerPos.x
				local dy = mp.y - centerPos.y
				if (dx * dx + dy * dy) <= (radius * radius) and self:IsSameDepthBand(anchor, m) then
					if isCrit then m:TakeDamageCrit(partialDamage * 2)
					else m:TakeDamage(partialDamage) end
					hitCount = hitCount + 1
				end
			end
		end
		log("ResolveEvolveAttack1: hit=" .. hitCount .. " ratio=" .. ratio .. " isCrit=" .. tostring(isCrit) .. " dmg=" .. math.floor(partialDamage))
	end

	-- 히트연출: 반경 안 각 대상에게 중심에서 가까운 순서대로 히트 이펙트(90도 회전) + 대미지를
	-- 순차 적용한다(유저 지정: "먼저 히트모션에 닿은 순서대로"). 대미지 비율은 어택1과 동일하게 50%로
	-- 맞춘다(유저 요청: "대미지를 50%,50%로 바꿔줄래?" — 어택1 50% + 히트연출 50% = 총 100%).
	-- 크리티컬은 대상마다 독립적으로 판정한다(유저 요청: "크리 확률은 각각 적용되고"). 슬로우 상태
	-- 대상 추가딜은 이 히트에만 적용한다.
	@ExecSpace("ServerOnly")
	method void ResolveEvolveHitSequence(Entity map, MonsterAI anchor, Vector3 centerPos, number damage, integer level)
		if map == nil then return end
		local radius = self:GetEvolveRadius()
		local hitDamage = damage * 0.50
		local bonusRatio = self:GetEvolveSlowedBonusRatio(level)
		local monsters = self:GetMonstersInCurrentZone(map)

		local hits = {}
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead then
				local mp = m.Entity.TransformComponent.Position
				local dx = mp.x - centerPos.x
				local dy = mp.y - centerPos.y
				local distSq = dx * dx + dy * dy
				if distSq <= (radius * radius) and self:IsSameDepthBand(anchor, m) then
					table.insert(hits, { monster = m, dist = distSq })
				end
			end
		end
		table.sort(hits, function(a, b) return a.dist < b.dist end)

		for i, entry in ipairs(hits) do
			local m = entry.monster
			local stagger = (i - 1) * self.Card115HitEffectStagger
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				if not isvalid(m) or not isvalid(m.Entity) or m._dead then return end
				local isCrit = self:RollCrit(115)
				local pos = m.Entity.TransformComponent.Position
				self:PlayEvolveHitEffect(pos)
				if isCrit then m:TakeDamageCrit(hitDamage * 2)
				else m:TakeDamage(hitDamage) end
				if m._isSlowed then
					local bonusDamage = hitDamage * bonusRatio
					_TimerService:SetTimerOnce(function()
						if not isvalid(self) then return end
						if isvalid(m) and isvalid(m.Entity) and not m._dead then
							if isCrit then m:TakeDamageCrit(bonusDamage * 2)
							else m:TakeDamage(bonusDamage) end
						end
					end, self.Card115SlowedBonusDelay)
				end
			end, stagger)
		end
		log("ResolveEvolveHitSequence: targets=" .. #hits .. " radius=" .. radius)
	end

	-- 히트 이펙트 — 원본 프레임을 직접 이어붙여 온전히 재생하고(아이스/파이어 퀴버·애로우 일루전과
	-- 동일 기법), -90도 회전을 적용한다(유저 정정: "90도회전이아니라 -90이였던거같네")
	@ExecSpace("ServerOnly")
	method void PlayEvolveHitEffect(Vector3 pos)
		local frames = self:GetEvolveHitFrames()
		local dur = self.Card115FrameDuration
		local fx = self:SpawnEffectWithModel(frames[1], pos, -90, 1.0, 1.0, 1.0, "skilleffectlong")
		if fx == nil then return end
		local renderer = fx.SpriteRendererComponent
		for i = 2, #frames do
			local frameRUID = frames[i]
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) and isvalid(renderer) then renderer.SpriteRUID = frameRUID end
			end, dur * (i - 1))
		end
		fx:Destroy(dur * #frames)
	end

	-- ── 실피드 전용: 리트리트 샷 (카드 106, 슬롯형 정식 스킬 6호) — 횡(가로) 관통 스킬. 매 시전마다
	-- 몬스터가 더 많은 쪽의 반대편(화면 좌/우 고정 위치)에서 등장해 반대쪽을 향해 화살을 N발(레벨별
	-- 2~4발) 연사한다(유저 요청: "적이 많은쪽을 우선해서 반대에 나오면 좋겠고"). 화살마다 발사 위치에서
	-- 가장 가까운, 아직 다른 화살이 안 쓴 몬스터를 타겟으로 잡고(유저 재확인: "y축에 적이있는곳에서
	-- 발사가 되야하고(타겟팅)") 그 몬스터의 높이(Y)에서 발사해, 그 줄(±Y밴드) 위에서 발사 방향 쪽에
	-- 있는 몬스터를 가까운 순으로 최대(1+관통횟수)명 관통한다("그 경로에 있는 적들을 공격하고"). 관통
	-- 예산을 다 쓰면 그 마지막 타격 지점에서 화살이 사라지고, 그 줄에 몬스터가 부족해 예산을 못 채우면
	-- (유저 재확인: "관통 횟수가 남았는데 왜 화살이 사라져 끝까지 쭉 날아가야지") 화면 반대쪽 끝까지
	-- 날아간다. 활 당기는 연출은
	-- 화살마다 새로 스폰하지 않고, 이전 연출이 끝나기 전에 다음 연출을 겹쳐서 스폰해 끊김(깜빡임) 없이
	-- 이어진다(에로우 플레터/Card118와 동일한 기법, 유저 지적: "연출이 깜빡거리는데 연출 겹치게해서
	-- 깜빡거리는거 없애야해").
	@Sync property integer RetreatShotLevel = 0
	property string Card106Name = "리트리트 샷"
	property string Card106IconRUID = "1a05fec36730489dba992b06d9e89176"
	property number Card106Cooldown = 7.0  -- 레벨 무관 고정
	property string Card106CastRUID = "0b7f4439542040ab9cd0cc5097af7544"
	-- 이 리소스는 이미지 자체가 대각선(약 35~40도)으로 기울어져 있어 정면(수평)으로 보이도록
	-- 보정한다 — -38→-41로 "시계 방향 3도"를 시도했더니 유저 확인으로 반대 방향으로 움직였음 — 이
	-- 부호에서는 값을 낮출수록(더 음수) 반시계 방향이라는 뜻이므로, 시계 방향으로 가려면 반대로
	-- 값을 올려야 한다. -38에서 3도만큼 반대로(+3) 조정.
	property number Card106CastRotationCorrection = -31
	-- 클립(애니메이션플레이어)의 자체 루프 대신, 클립을 이루는 4장의 정지 프레임을 직접 이어붙여서
	-- 재생한다(유저 제안: "3프레임일때 애니 1개더 실행 이런식으로... 연결해서... 이어붙여" — 마지막
	-- 프레임에 닿으면 다시 0번 프레임부터 이어서 재생해 지속시간을 채운다). 애니메이션플레이어 자체
	-- 루프에 맡기면 재시작 순간이 눈에 띄게 깜빡였다(유저 지적: "이거 왜 깜빡깜빡거려").
	property string Card106CastFrame0RUID = "d717ef38fb254f05b0ce553ff924d35c"
	property string Card106CastFrame1RUID = "fb64437061834e3597957c3d973f777f"
	property string Card106CastFrame2RUID = "7bdae609fee44c4a9e49fadccfe63270"
	property string Card106CastFrame3RUID = "2783c93ee8134c5c9cb7b7fa64b67cea"
	-- 유저 요청: "쏘는속도 조금더 올리면 좋겠어" — 에로우 플레터 1.5배 속도 조정과 동일한 기법으로
	-- 프레임 재생 속도/전체 재생시간/겹침 시간을 전부 1.2로 나눠서 발사 간격(CastDuration-Overlap)
	-- 자체가 1.2배 빨라지게 한다(0.5초 → 0.4167초).
	property number Card106CastFrameDuration = 0.05  -- 프레임 1장당 재생 시간 — 기존 0.06의 1/1.2
	property number Card106CastDuration = 0.5  -- 전체 재생 시간 — 기존 0.6의 1/1.2
	property number Card106CastScale = 1.15  -- 유저 요청으로 15% 확대
	-- 다음 화살의 캐스트를 이전 캐스트가 끝나기 이 시간 전에 미리 겹쳐서 스폰한다(에로우 플레터의
	-- Card118CastOverlap과 동일한 기법) — 화살 발사 간격 자체도 이 값만큼 줄어들어 더 빠르게 연사된다.
	property number Card106CastOverlap = 0.0833  -- 기존 0.1의 1/1.2
	-- 마지막 화살의 캐스트는 끝까지 다 재생하지 않고, 화살이 실제로 발사되는 시점 직후 바로 끈다
	-- (그 전 화살들은 다음 캐스트가 겹쳐서 스폰되므로 끝까지 재생해도 자연스럽게 이어짐).
	property number Card106LastCastCutoff = 0.15
	property string Card106ArrowRUID = "f4773d451d344bc7818d3da0ddfa4c41"
	property string Card106HitRUID = "34d1273d29b2435aa0b97036f4e7416c"
	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 전용 리소스팩 번들 오디오(_audio/Use) 사용
	property string Card106SoundRUID = "29101cbe391a4b08a9940ada4b3f3525"

	method void PlayRetreatShotSound()
		_SoundService:PlaySound(self.Card106SoundRUID, 1.0)
	end
	property number Card106ArrowScale = 1.05  -- 유저 요청으로 5% 확대
	property number Card106ArrowLaunchDelay = 0.05  -- 캐스트 시작 후 화살이 나가기까지의 지연 — 거의 즉시(유저 요청: "활이 바로 나가야하고")
	property number Card106ArrowSpeed = 8.5  -- 화살 이동 속도(초당 월드유닛) — 12→7(너무 빨리 사라졌음)→8.5(유저 요청: "화살속도 조금더 올리면 좋겠어")
	-- 화살은 캐스트와 달리 대각선 기울기 보정이 필요 없다 — 각도 보정 없이 FlipX(좌우 반전)만으로
	-- 방향을 처리한다("Y축 반전"이라는 유저 표현은 엔진 FlipY가 아니라 "Y축 기준 반사"=좌우 반전을
	-- 뜻했음, 뒤늦게 파악).
	property number Card106ArrowRotationCorrection = 0
	property number Card106ArrowVisualYOffset = 0.4  -- 화살 연출을 판정 좌표보다 살짝 위로 띄움(유저 요청, 순수 시각용) — 0.5→0.4
	property number Card106SidePositionX = 5.5  -- 화면 좌/우 고정 발사 위치(X, 반대쪽은 음수) — Y는 매번 그 화살의 타겟 높이로 고정(유저 요청)
	property number Card106YBandTolerance = 0.6  -- 화살이 지나가는 "줄" 판정 폭(±)
	property number Card106HitRadius = 0.5  -- 실시간 충돌 판정 반경 — 화살의 현재 X와 몬스터 X가 이 안이면 그 순간 맞은 것으로 처리
	property number Card106HitYOffset = 0.35  -- 타격 연출을 착탄 좌표보다 위로 띄움(유저 요청: "살짝만 위로 올려 살짝더")

	method number GetRetreatShotDamage()
		if self.RetreatShotLevel >= 5 then return 160
		elseif self.RetreatShotLevel >= 4 then return 140
		elseif self.RetreatShotLevel >= 3 then return 120
		elseif self.RetreatShotLevel >= 2 then return 100
		end
		return 80
	end

	-- 화살 수(=여기서 "타겟 수") — Lv1:2 / Lv2~3:3 / Lv4~5:4
	method integer GetRetreatShotArrowCount()
		if self.RetreatShotLevel >= 4 then return 4
		elseif self.RetreatShotLevel >= 2 then return 3
		end
		return 2
	end

	-- 관통 횟수 — Lv1~2:1 / Lv3~4:2 / Lv5:3
	method integer GetRetreatShotPierceCount()
		if self.RetreatShotLevel >= 5 then return 3
		elseif self.RetreatShotLevel >= 3 then return 2
		end
		return 1
	end

	-- 관통 대미지 비율 — 1번째 관통 50%, 2번째 60%, 3번째 70%(레벨별 관통 횟수만큼만 실제로 적용됨)
	method number GetRetreatShotPiercePercent(integer pierceIndex)
		if pierceIndex == 1 then return 0.50
		elseif pierceIndex == 2 then return 0.60
		elseif pierceIndex == 3 then return 0.70
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method void RetreatShotAttack(number damage, boolean isCrit)
		self:PlayRetreatShotSound()
		local map = self:GetCurrentMap()
		if map == nil then return end

		local monsters = self:GetMonstersInCurrentZone(map)
		local leftCount, rightCount = 0, 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local x = m.Entity.TransformComponent.Position.x
				if x < 0 then leftCount = leftCount + 1
				elseif x > 0 then rightCount = rightCount + 1 end
			end
		end

		-- 왼쪽에 적이 더 많거나 동률이면 반대편(오른쪽)에서 등장해 왼쪽을 향해 쏜다. 이 프로젝트
		-- 좌표계 실측 결과 +X가 화면상 왼쪽으로 보여서(유저 지적: "지금 기준으로 좌측에 뜨는게
		-- 우측에 떠야해") 화면상 오른쪽 = 음수 X로 부호를 뒤집어 맞춘다.
		local spawnOnRight = leftCount >= rightCount
		local launchX = spawnOnRight and -self.Card106SidePositionX or self.Card106SidePositionX
		local flyDirRight = not spawnOnRight

		local arrowCount = self:GetRetreatShotArrowCount()
		local pierceCount = self:GetRetreatShotPierceCount()
		local usedTargets = {}
		-- 버그 수정(2026-08-26, 유저 지적: "화면 넘어갔는데 이펙트가 다음 존에 존재") — 캐스트 시점
		-- 존 인덱스를 캡처해 연사되는 화살들(FireRetreatShotSequence→FireRetreatShotArrow)까지 전달,
		-- 발사 시점에 이미 존이 넘어갔으면 그 화살은 스폰하지 않는다.
		local castZoneIndex = _MapManager.CurrentMapIndex
		for i = 1, arrowCount do
			local delay = (i - 1) * math.max(0.05, self.Card106CastDuration - self.Card106CastOverlap)
			local isLast = (i == arrowCount)
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				self:FireRetreatShotSequence(map, launchX, flyDirRight, usedTargets, pierceCount, damage, isCrit, isLast, castZoneIndex)
			end, delay)
		end

		log("RetreatShotAttack: arrows=" .. arrowCount .. " pierce=" .. pierceCount .. " spawnOnRight=" .. tostring(spawnOnRight) .. " dmg=" .. math.floor(damage))
	end

	-- 화살 한 발의 준비 단계 — 발사 위치(launchX)에서 가장 가까운(아직 다른 화살이 안 쓴) 몬스터를
	-- 기준 타겟으로 잡고, 활대 자체를 그 몬스터의 높이(열)로 이동시켜 등장한 뒤(유저 요청: "y축에
	-- 적이있는곳에서 발사가 되야하고(타겟팅)") 캐스트가 끝나길 기다리지 않고 화살을 발사한다.
	@ExecSpace("ServerOnly")
	method void FireRetreatShotSequence(Entity map, number launchX, boolean flyDirRight, table usedTargets, integer pierceCount, number damage, boolean isCrit, boolean isLast, integer castZoneIndex)
		if castZoneIndex ~= _MapManager.CurrentMapIndex then return end
		local monsters = self:GetMonstersInCurrentZone(map)
		local primary = nil
		local bestDist = -1
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) and not usedTargets[m] then
				local mx = m.Entity.TransformComponent.Position.x
				local d = math.abs(mx - launchX)
				if bestDist < 0 or d < bestDist then
					bestDist = d
					primary = m
				end
			end
		end
		if primary == nil then return end
		usedTargets[primary] = true

		local arrowY = primary.Entity.TransformComponent.Position.y
		local launchPos = Vector3(launchX, arrowY, -0.1)

		self:PlayRetreatShotCast(launchPos, flyDirRight, isLast)

		-- 화살은 캐스트 연출이 다 끝나길 기다리지 않고 거의 즉시 나간다(유저 요청: "이 쏘는연출 할떄
		-- 활이 바로 나가야하고").
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self:FireRetreatShotArrow(map, launchPos, flyDirRight, primary, pierceCount, damage, isCrit, castZoneIndex)
		end, self.Card106ArrowLaunchDelay)
	end

	-- 활대(캐스트) 연출 — 4장을 이어붙여 재생. 마지막 화살의 캐스트는 화살이 실제로 발사되는 시점
	-- 직후 바로 끈다(에로우 플레터 Card118LastCastCutoff와 동일한 기법 — 그 전 화살들은 다음 캐스트가
	-- 겹쳐서 스폰되므로 끝까지 재생해도 자연스럽게 이어진다).
	@ExecSpace("ServerOnly")
	method void PlayRetreatShotCast(Vector3 pos, boolean flyDirRight, boolean isLast)
		-- 활대는 쏘는 방향을 바라봐야 한다(유저 지적: "활을 쏘는데 뒤로나가... 활대를 돌려야지 나가는
		-- 방향으로"). 좌우는 FlipX로 뒤집고, 대각선으로 기울어진 원본 이미지는
		-- Card106CastRotationCorrection으로 수평 보정한다.
		local flip = not flyDirRight
		local rot = flip and -self.Card106CastRotationCorrection or self.Card106CastRotationCorrection

		local frames = {
			self.Card106CastFrame0RUID, self.Card106CastFrame1RUID,
			self.Card106CastFrame2RUID, self.Card106CastFrame3RUID,
		}
		local perFrame = self.Card106CastFrameDuration
		local fx = self:SpawnEffectWithModel(frames[1], pos, rot, 1.0, self.Card106CastScale, 1.0, "skilleffectlong")
		if fx == nil then return end
		local r = fx.SpriteRendererComponent
		if r ~= nil then r.FlipX = flip end
		if isLast then
			fx:Destroy(self.Card106LastCastCutoff)
			return
		end
		local totalSteps = math.max(1, math.floor(self.Card106CastDuration / perFrame))
		for step = 2, totalSteps do
			local frameRUID = frames[((step - 1) % #frames) + 1]
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) and isvalid(r) then r.SpriteRUID = frameRUID end
			end, perFrame * (step - 1))
		end
		fx:Destroy(self.Card106CastDuration)
	end

	-- 화살 한 발 — 이미 정해진 기준 타겟(primary)의 높이(Y)를 줄 삼아 발사 방향으로 실제로 이동하며,
	-- 매 틱마다 그 순간 그 줄에 실제로 겹치는 몬스터를 그때그때 맞힌다(유저 지적: "쏠때 타겟을(관통
	-- 되는 적) 미리 계산하는거냐" — 예전엔 발사 시점에 맞을 대상을 미리 확정해서, 몬스터가 계속
	-- 이동하는 이 게임 특성상 화살이 도착했을 땐 이미 자리를 벗어나 있어 대미지가 안 들어가거나
	-- 순서가 꼬이는 문제가 있었다. 실시간 충돌로 바꿔서 화살이 실제로 스쳐 지나가는 몬스터만 맞는다).
	-- 관통 예산(1+관통횟수)을 다 채우면 그 자리에서 사라지고, 다 못 채우면 화면 반대쪽 끝까지 날아간다.
	@ExecSpace("ServerOnly")
	method void FireRetreatShotArrow(Entity map, Vector3 launchPos, boolean flyDirRight, MonsterAI primary, integer pierceCount, number damage, boolean isCrit, integer castZoneIndex)
		-- 버그 수정(2026-08-26, 유저 지적: "화면 넘어갔는데 이펙트가 다음 존에 존재") — 캐스트/연사
		-- 사이 이미 존이 넘어갔으면 화살 자체를 스폰하지 않는다.
		if castZoneIndex ~= _MapManager.CurrentMapIndex then return end
		-- 실제 원인을 찾았다: "Y축 반전"은 엔진 FlipY가 아니라 "Y축을 기준으로 반사" = 좌우 반전
		-- = 엔진의 FlipX를 뜻하는 표현이었다(용어 혼동, 죄송합니다). FlipY는 상하 대칭인 이 화살
		-- 스프라이트에는 아무 시각적 차이가 없어서 계속 안 맞았던 것. 유저가 준 참고 이미지(> 로
		-- 갈 때/< 로 갈 때 각각의 정확한 모양) 기준으로 다시 맞춘다.
		local flipArrow = not flyDirRight
		local rotationZ = flipArrow and -self.Card106ArrowRotationCorrection or self.Card106ArrowRotationCorrection
		-- 화살 연출 자체를 살짝 위로 띄운다(유저 요청: "화살 살짝 위로 올려 0.5정도") — 판정(명중
		-- 좌표)에는 영향 없는 순수 시각 오프셋이다.
		local visualY = self.Card106ArrowVisualYOffset
		local spawnVisualPos = Vector3(launchPos.x, launchPos.y + visualY, launchPos.z)
		-- "skilleffect"(SpawnEffect 기본)는 SkillEffectAI가 0.8초 뒤 자동으로 파괴한다 — 화면 끝까지
		-- 날아가야 하는 경우(0.8초 이상 걸림) 도중에 강제로 사라지는 원인이었다. 자동 소멸 타이머가
		-- 없는 "persistenteffect"를 써서 수명을 아래 실시간 충돌 루프가 직접 제어하게 한다.
		local fx = self:SpawnEffectWithModel(self.Card106ArrowRUID, spawnVisualPos, rotationZ, 1.0, self.Card106ArrowScale, 1, "persistenteffect")
		if fx == nil then return end
		local arrowRenderer = fx.SpriteRendererComponent
		if arrowRenderer ~= nil then arrowRenderer.FlipX = flipArrow end

		local arrowY = launchPos.y
		-- dir 부호가 반대였다(유저 지적: "활은 >일로 쏘는데 화살은 화면밖 <일로 나가잖아" — 활대의
		-- FlipX(not flyDirRight)가 바라보는 실제 화면 방향과 화살의 이동 방향이 반대였다). 활대와
		-- 동일한 방향으로 실제 이동하도록 부호를 뒤집는다.
		local dir = flyDirRight and -1 or 1
		-- edgeX는 발사 지점(launchPos.x, 항상 ±SidePositionX)이 아니라 그 지점에서 진행 방향(dir)으로
		-- 화면 폭만큼 더 나아간 지점이어야 한다 — launchPos.x와 같은 값으로 잘못 계산하면(버그) 첫
		-- 틱에서 곧바로 "끝에 도달"로 판정돼 화살이 나가지도 못하고 그 자리에서 바로 사라진다.
		local edgeX = launchPos.x + dir * (2 * self.Card106SidePositionX)
		local maxBudget = pierceCount + 1
		local hitSet = {}
		local hitCount = 0
		local elapsedTime = 0
		local tickInterval = 1 / 60
		local timerId = nil

		-- 시각적 이동은 매 틱 TransformComponent.Position을 직접 대입하는 대신 PlayTween 하나로
		-- 처리한다(유저 지적: "활당기는 연출은 나오는데 화살이 안나감" — 서버에서 60Hz로 Position을
		-- 직접 덮어쓰면 클라이언트로 정상적으로 동기화되지 않아 화살이 제자리에 멈춰있다 사라지는
		-- 것으로 보였다. 다른 모든 스킬이 이동 연출에 PlayTween을 쓰는 것과 동일한 방식으로 맞춘다).
		-- 충돌 판정은 이 트윈과 별개로, 동일한 수식으로 매 틱 curX를 직접 계산해 처리한다.
		local totalTravelTime = math.abs(edgeX - launchPos.x) / self.Card106ArrowSpeed
		_TweenLogic:PlayTween(0.0, 1.0, totalTravelTime, EaseType.Linear, function(t)
			if not isvalid(fx) then return end
			local x = launchPos.x + (edgeX - launchPos.x) * t
			fx.TransformComponent.Position = Vector3(x, arrowY + visualY, launchPos.z)
		end)

		-- 유저 리포트(에로우 플레터에서 먼저 확인, 리트리트 샷도 동일 구조라 재확인): "관통이 남으면
		-- 화면 끝까지 가고 거기서 살짝 멈춰있다" — 시각 이동(Tween, 실제 엔진 경과시간)과 충돌판정
		-- 틱루프(elapsedTime을 tickInterval만큼 수동 누적하는 별도 시계)가 다른 시계를 쓰다 보니 틱루프가
		-- 살짝 밀리면 Tween은 이미 끝나 화면 끝에 멈춰 보이는데 reachedEdge가 아직 안 걸려 fx:Destroy가
		-- 늦게 불린다. Tween과 동일한 totalTravelTime으로 별도 안전장치 타이머를 걸어 확실히 사라지게
		-- 한다(관통 예산이 남아도 끝까지 이동하는 동작 자체는 그대로 유지).
		_TimerService:SetTimerOnce(function()
			if timerId then _TimerService:ClearTimer(timerId) end
			if isvalid(fx) then fx:Destroy(0.05) end
		end, totalTravelTime)

		timerId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self) or not isvalid(fx) then
				if timerId then _TimerService:ClearTimer(timerId) end
				return
			end
			-- 버그 수정(2026-08-26, 유저 지적: "화면 넘어갔는데 이펙트가 다음 존에 존재") — 화살이
			-- 화면을 가로지르는 도중(실시간 여러 틱) 플레이어가 다른 존으로 넘어가면 즉시 화살을
			-- 지우고 틱루프를 멈춘다 — 계속 남아있는 화살/타격이펙트가 새 존에 잘못 나타나는 걸 막는다.
			if castZoneIndex ~= _MapManager.CurrentMapIndex then
				if timerId then _TimerService:ClearTimer(timerId) end
				if isvalid(fx) then fx:Destroy(0.05) end
				return
			end
			elapsedTime = elapsedTime + tickInterval
			local curX = launchPos.x + dir * self.Card106ArrowSpeed * elapsedTime

			-- 그 순간 화살 위치(curX)에 실제로 겹치는(반경 이내) 몬스터를 그때그때 맞힌다 — 몬스터가
			-- 계속 움직여도 실제로 스친 순간의 위치 기준이라 순서가 꼬이지 않는다.
			local monsters = self:GetMonstersInCurrentZone(map)
			for _, mob in ipairs(monsters) do
				---@type MonsterAI
				local m = mob
				if isvalid(m) and not m._dead and isvalid(m.Entity) and not hitSet[m] then
					local mp = m.Entity.TransformComponent.Position
					if math.abs(mp.y - arrowY) <= self.Card106YBandTolerance and math.abs(mp.x - curX) <= self.Card106HitRadius then
						hitSet[m] = true
						hitCount = hitCount + 1
						local pierceIdx = hitCount - 1
						local finalDamage = damage
						if pierceIdx > 0 then finalDamage = damage * self:GetRetreatShotPiercePercent(pierceIdx) end
						if isCrit then m:TakeDamageCrit(finalDamage * 2)
						else m:TakeDamage(finalDamage) end
						local hitFx = self:SpawnEffect(self.Card106HitRUID, Vector3(mp.x, mp.y + self.Card106HitYOffset, launchPos.z), 0, 1.0, 1.0, 1)
						if hitFx ~= nil then hitFx:Destroy(self.HitEffectLifetime) end
					end
				end
			end

			-- reachedEdge는 flyDirRight가 아니라 실제 이동 부호(dir)를 기준으로 판정해야 한다 —
			-- flyDirRight로 판정하면 dir 부호를 반대로 고칠 때마다 여기도 같이 안 맞아서 화살이 첫
			-- 틱에 바로 끝난 것으로 처리되는 동일한 버그가 재발한다.
			local reachedEdge = (dir > 0 and curX >= edgeX) or (dir < 0 and curX <= edgeX)
			if hitCount >= maxBudget or reachedEdge then
				if timerId then _TimerService:ClearTimer(timerId) end
				if isvalid(fx) then fx:Destroy(0.05) end
			end
		end, tickInterval)
	end

	-- ── 실피드 전용: 에로우 플레터 (카드 118, 조합 스킬) — 리트리트 샷(Card106) Lv5 + 보우
	-- 액셀레이션(Card109) + 꿰뚫는 의지(Card110, 둘 다 슬롯 없는 패시브) 보유 시 등장 — 새 슬롯이
	-- 필요없고 리트리트 샷의 슬롯을 그대로 넘겨받는다(헤일 버스트와 동일한 "슬롯 카드 + 슬롯 없는
	-- 패시브 2개" 조합 패턴). 리트리트 샷과 동일한 구조(횡 관통, 몬스터 많은 쪽 반대편에서 화살 연사,
	-- 각 화살은 발사 위치에서 가장 가까운 미사용 몬스터를 줄(Y)로 삼아 그 줄 위 몬스터를 관통) —
	-- 관통 횟수는 레벨 무관 고정 4회(관통 대미지 60/70/80/90%, 유저 지정)이고
	-- 이 스킬 전용 크리티컬 확률 보너스(10%/15%/20%, RollCrit에 cardIdx==118 분기로 추가)가 있다.
	-- 캐스트(활대) 연출은 신규 리소스(f59e94b2..., 9프레임)로 교체하되, 리소스 자체가 정면을 보고
	-- 있지 않아 리트리트 샷과 동일한 각도 보정값(-31도)을 그대로 가져다 쓴다(유저 지시: "이걸로
	-- 각도보정값을 그대로 가져다써라"). 활 당기는 연출은 다음 캐스트를 이전이 끝나기 전에 겹쳐서
	-- 스폰해 끊김(깜빡임) 없이 이어진다(유저 지적: "지금 연출이 끊기거든(깜빡깜빡)... 연출 겹쳐서
	-- 안끊기게").
	@Sync property integer ArrowFletterLevel = 0
	property string Card118Name = "에로우 플레터"
	property string Card118IconRUID = "028b253be9894fd28e2b9f8a3af0ff28"
	property string Card118CastFrame0RUID = "caa7d4bdbc1c4deb9edd6622bcc9cc89"
	property string Card118CastFrame1RUID = "9cf5e85f7c424d10a559bcd5f5de4df8"
	property string Card118CastFrame2RUID = "8dc205c696ab4661a8fc96367dedcbd3"
	property string Card118CastFrame3RUID = "392618b81c804ce99e54b7d1c9f39f7d"
	property string Card118CastFrame4RUID = "65af9662bffd42829e68ceb6f5b3edfb"
	property string Card118CastFrame5RUID = "721fb833c1534307adddeaaa7c30cb43"
	property string Card118CastFrame6RUID = "cc49324d439f43aab04fc8738a3e9fea"
	property string Card118CastFrame7RUID = "e33ffebbb2b847a987071dd0ebb63e08"
	property string Card118CastFrame8RUID = "695f3248182b407092a74bcf90fc14c2"
	-- 유저 요청: "화살 쏘는속도 지금보다 약 1.5배 빠르게... 쏘는 연출은 그에맞게 변경" — 프레임
	-- 재생 속도/전체 재생시간/겹침 시간을 전부 1.5로 나눠서 화살 발사 간격 자체가 1.5배 빨라지게
	-- 한다(발사 간격은 CastDuration-Overlap로 계산되므로, 세 값을 같은 비율로 줄이면 간격도 정확히
	-- 1.5배 줄어든다 — 0.48초 → 0.32초).
	property number Card118CastFrameDuration = 0.0467  -- 9프레임 × 0.0467 ≈ 0.42초(1바퀴) — 기존 0.07의 1/1.5
	property number Card118CastDuration = 0.42
	property number Card118CastOverlap = 0.1  -- 기존 0.15의 1/1.5
	-- 유저 요청으로 30 설정.
	property number Card118CastRotationCorrection = 30
	property number Card118CastScale = 0.7  -- 유저 요청으로 30% 축소
	property string Card118ArrowRUID = "3aa8859ff9a44b969c96ef722d1c24f0"
	property string Card118HitRUID = "fb0500173c6f494fb71f963bc9fd6b7e"
	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 전용 팩에 번들 오디오가 없어 같은 활 계열
	-- 애로우 블로우(Card102) 사운드 재사용
	property string Card118SoundRUID = "b4c345306d4948f1a0b8cc787fd57bef"

	method void PlayArrowFletterSound()
		_SoundService:PlaySound(self.Card118SoundRUID, 1.0)
	end
	-- 유저 요청: "타격 연출 화살에 닿고 바로 터지면 좋겠고" — HitEffectLifetime(0.3초)이 9프레임 클립의
	-- 원본 재생시간보다 짧아서 기본 재생속도(1.0)로는 절정(burst) 프레임까지 못 가고 잘렸다. 재생속도를
	-- 높여 0.3초 안에 절정까지 확실히 도달하도록 한다.
	property number Card118HitPlayRate = 2.5
	property number Card118ArrowScale = 0.85  -- 유저 요청으로 15% 축소
	-- 유저 지적: "각도가 한개도 안바뀌는데" — 화살 스폰을 rotationZ=0으로 하드코딩해놔서 애초에
	-- 보정이 반영될 수가 없었다(진짜 원인). 리트리트 샷과 동일하게 조정 가능한 보정값으로 분리.
	-- 유저 요청으로 0으로 설정(보정 없음).
	property number Card118ArrowRotationCorrection = 0
	property integer Card118PierceCount = 4  -- 레벨 무관 고정(유저 지정)
	-- 유저 요청: "N발 다쏘면 쏘는 연출 끄는 느낌" — 마지막 화살의 캐스트는 화살이 실제로 발사되는
	-- 시점(Card106ArrowLaunchDelay) 직후 바로 끈다(끝까지 다 재생하지 않음)
	property number Card118LastCastCutoff = 0.15
	-- 유저 요청: "화면 밖에서 연출이 너무 보이는거 같은데 살짝씩 화면쪽으로... 좌우 둘다 중앙방향으로
	-- 쪼금씩만" — 리트리트 샷과 공유하던 Card106SidePositionX(5.5, 화면 좌/우 고정 발사 위치)를
	-- 그대로 줄이면 리트리트 샷 본인 연출까지 같이 움직이므로, 이 스킬 전용 값으로 분리해서 살짝만
	-- (5.5 → 5.0) 중앙 쪽으로 당긴다.
	property number Card118SidePositionX = 5.0

	method number GetArrowFletterDamage(integer level)
		if level >= 3 then return 220
		elseif level >= 2 then return 200
		end
		return 180
	end

	method number GetArrowFletterCooldown(integer level)
		if level >= 2 then return 6.5 end
		return 7.0
	end

	-- 화살 수(="타겟 수") — Lv1~2:5 / Lv3:6
	method integer GetArrowFletterArrowCount(integer level)
		if level >= 3 then return 6 end
		return 5
	end

	-- 이 스킬 전용 크리티컬 확률 보너스 — RollCrit(cardIdx==118)에서 합산된다
	-- SkillInventory 에로우 플레터(인덱스32) Lv9: 크리티컬 확률 +8%, 카드 자체 레벨과 별개로 항상 가산
	method number GetArrowFletterCritChance(integer level)
		local base = 0.10
		if level >= 3 then base = 0.20
		elseif level >= 2 then base = 0.15
		end
		return base + self:GetSkillInvTierPercent(32, 0, 0, 0.08)
	end

	-- 관통 대미지 비율 — 레벨 무관 고정: 1번째 관통 60%, 2번째 70%, 3번째 80%, 4번째 90%
	-- (관통 예산을 다 못 채우면 실제로는 그만큼만 적용됨)
	method number GetArrowFletterPiercePercent(integer pierceIndex)
		if pierceIndex == 1 then return 0.60
		elseif pierceIndex == 2 then return 0.70
		elseif pierceIndex == 3 then return 0.80
		elseif pierceIndex == 4 then return 0.90
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method void ArrowFletterAttack(number damage, boolean isCrit)
		self:PlayArrowFletterSound()
		local map = self:GetCurrentMap()
		if map == nil then return end

		local monsters = self:GetMonstersInCurrentZone(map)
		local leftCount, rightCount = 0, 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local x = m.Entity.TransformComponent.Position.x
				if x < 0 then leftCount = leftCount + 1
				elseif x > 0 then rightCount = rightCount + 1 end
			end
		end

		-- 리트리트 샷과 동일한 좌표계 보정(+X가 화면상 왼쪽으로 보임)
		local spawnOnRight = leftCount >= rightCount
		local launchX = spawnOnRight and -self.Card118SidePositionX or self.Card118SidePositionX
		local flyDirRight = not spawnOnRight

		local level = self.ArrowFletterLevel
		local arrowCount = self:GetArrowFletterArrowCount(level)
		local usedTargets = {}
		-- 버그 수정(2026-08-26, 유저 지적: "화면 넘어갔는데 이펙트가 다음 존에 존재") — 캐스트 시점
		-- 존 인덱스를 캡처해 연사되는 화살들까지 전달, 발사 시점에 이미 존이 넘어갔으면 스폰하지 않는다.
		local castZoneIndex = _MapManager.CurrentMapIndex
		for i = 1, arrowCount do
			-- 화살마다 매번 새 캐스트 연출을 스폰하는데, 이전 연출이 끝나고 나서야 다음 연출이 스폰되면
			-- 그 사이 빈 프레임(깜빡임)이 생긴다. 다음 연출을 이전 연출이 끝나기 Card118CastOverlap초
			-- 전에 미리 겹쳐서 스폰해 끊김 없이 이어지게 한다(유저 지적: "연출이 끊기거든(깜빡깜빡)...
			-- 연출 겹쳐서 안끊기게").
			local delay = (i - 1) * math.max(0.05, self.Card118CastDuration - self.Card118CastOverlap)
			local isLast = (i == arrowCount)
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				self:FireArrowFletterSequence(map, launchX, flyDirRight, usedTargets, damage, isCrit, isLast, castZoneIndex)
			end, delay)
		end

		log("ArrowFletterAttack: arrows=" .. arrowCount .. " pierce=" .. self.Card118PierceCount .. " spawnOnRight=" .. tostring(spawnOnRight) .. " dmg=" .. math.floor(damage))
	end

	-- 화살 한 발의 준비 단계 — 리트리트 샷의 FireRetreatShotSequence와 동일한 타겟팅(발사 위치에서
	-- 가장 가까운 미사용 몬스터를 줄로 삼음, 유저 재확인: "y축에 적이있는곳에서 발사가 되야하고").
	@ExecSpace("ServerOnly")
	method void FireArrowFletterSequence(Entity map, number launchX, boolean flyDirRight, table usedTargets, number damage, boolean isCrit, boolean isLast, integer castZoneIndex)
		if castZoneIndex ~= _MapManager.CurrentMapIndex then return end
		local monsters = self:GetMonstersInCurrentZone(map)
		local primary = nil
		local bestDist = -1
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) and not usedTargets[m] then
				local mx = m.Entity.TransformComponent.Position.x
				local d = math.abs(mx - launchX)
				if bestDist < 0 or d < bestDist then
					bestDist = d
					primary = m
				end
			end
		end
		if primary == nil then return end
		usedTargets[primary] = true

		local arrowY = primary.Entity.TransformComponent.Position.y
		local launchPos = Vector3(launchX, arrowY, -0.1)

		self:PlayArrowFletterCast(launchPos, flyDirRight, isLast)

		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self:FireArrowFletterArrow(map, launchPos, flyDirRight, primary, damage, isCrit, castZoneIndex)
		end, self.Card106ArrowLaunchDelay)
	end

	-- 활대(캐스트) 연출 — 9프레임을 직접 이어붙여 재생. 리소스 자체가 정면을 보지 않아 리트리트 샷과
	-- 동일한 각도 보정(Card118CastRotationCorrection)을 적용한다. 유저 요청: "5발쏘면 5발 다쏘면
	-- 쏘는연출 끄고" — 마지막 화살의 캐스트는 자기 연출을 끝까지 다 재생하지 않고, 화살이 실제로
	-- 발사되는 시점(Card118LastCastCutoff) 직후 바로 끈다(그 전 화살들은 다음 캐스트가 겹쳐서
	-- 스폰되므로 끝까지 재생해도 자연스럽게 이어짐).
	@ExecSpace("ServerOnly")
	method void PlayArrowFletterCast(Vector3 pos, boolean flyDirRight, boolean isLast)
		local flip = not flyDirRight
		local rot = flip and -self.Card118CastRotationCorrection or self.Card118CastRotationCorrection
		local frames = {
			self.Card118CastFrame0RUID, self.Card118CastFrame1RUID, self.Card118CastFrame2RUID,
			self.Card118CastFrame3RUID, self.Card118CastFrame4RUID, self.Card118CastFrame5RUID,
			self.Card118CastFrame6RUID, self.Card118CastFrame7RUID, self.Card118CastFrame8RUID,
		}
		local dur = self.Card118CastFrameDuration
		local fx = self:SpawnEffectWithModel(frames[1], pos, rot, 1.0, self.Card118CastScale, 1.0, "skilleffectlong")
		if fx == nil then return end
		local r = fx.SpriteRendererComponent
		if r ~= nil then r.FlipX = flip end
		if isLast then
			fx:Destroy(self.Card118LastCastCutoff)
			return
		end
		for step = 2, #frames do
			local frameRUID = frames[step]
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) and isvalid(r) then r.SpriteRUID = frameRUID end
			end, dur * (step - 1))
		end
		fx:Destroy(dur * #frames)
	end

	-- 화살 한 발 — 리트리트 샷의 FireRetreatShotArrow와 동일한 실시간 충돌 로직(매 틱마다 그 순간
	-- 실제로 겹치는 몬스터를 맞힘)이지만 관통 횟수가 레벨 무관 고정(Card118PierceCount=4)이고
	-- 이 스킬 전용 관통 대미지 비율을 쓴다.
	@ExecSpace("ServerOnly")
	method void FireArrowFletterArrow(Entity map, Vector3 launchPos, boolean flyDirRight, MonsterAI primary, number damage, boolean isCrit, integer castZoneIndex)
		-- 버그 수정(2026-08-26, 유저 지적: "화면 넘어갔는데 이펙트가 다음 존에 존재") — 캐스트/연사
		-- 사이 이미 존이 넘어갔으면 화살 자체를 스폰하지 않는다.
		if castZoneIndex ~= _MapManager.CurrentMapIndex then return end
		-- 유저 정정: "각도 반대로해야하고... y축이라고... 좌우" — 방향 판정 부호가 반대였다(리트리트
		-- 샷과 달리 이 화살 리소스는 기본 방향이 반대인 듯). flipArrow를 뒤집어서 좌우(FlipX) 및
		-- 각도 보정 부호를 모두 반전한다.
		local flipArrow = flyDirRight
		local arrowRotationZ = flipArrow and -self.Card118ArrowRotationCorrection or self.Card118ArrowRotationCorrection
		local visualY = self.Card106ArrowVisualYOffset
		local spawnVisualPos = Vector3(launchPos.x, launchPos.y + visualY, launchPos.z)
		-- "skilleffect"(SpawnEffect 기본)는 0.8초 뒤 자동 파괴되므로(리트리트 샷과 동일한 이유) 자동
		-- 소멸 타이머가 없는 "persistenteffect"를 써서 수명을 실시간 충돌 루프가 직접 제어하게 한다.
		local fx = self:SpawnEffectWithModel(self.Card118ArrowRUID, spawnVisualPos, arrowRotationZ, 1.0, self.Card118ArrowScale, 1, "persistenteffect")
		if fx == nil then return end
		local arrowRenderer = fx.SpriteRendererComponent
		-- 유저 정정: "y축이라고... 좌우" — 이 프로젝트에서 "Y축 반전"은 실제 엔진 FlipY(상하)가
		-- 아니라 좌우 반전(FlipX)을 뜻한다(리트리트 샷 작업 때도 동일한 용어 혼동이 있었음). FlipY는
		-- 쓰지 않는다.
		if arrowRenderer ~= nil then arrowRenderer.FlipX = flipArrow end

		local arrowY = launchPos.y
		-- dir 부호 반전(리트리트 샷과 동일한 버그 수정 — 활대가 바라보는 실제 화면 방향과 반대로
		-- 날아가고 있었다).
		local dir = flyDirRight and -1 or 1
		-- edgeX는 발사 지점이 아니라 그 지점에서 진행 방향으로 화면 폭만큼 더 나아간 지점이어야 한다
		-- (리트리트 샷과 동일한 버그 수정 — launchPos.x와 같은 값이면 첫 틱에 바로 종료돼버린다).
		local edgeX = launchPos.x + dir * (2 * self.Card118SidePositionX)
		local pierceCount = self.Card118PierceCount
		local maxBudget = pierceCount + 1
		local hitSet = {}
		local hitCount = 0
		local elapsedTime = 0
		local tickInterval = 1 / 60
		local timerId = nil

		-- 시각적 이동은 PlayTween 하나로 처리한다(리트리트 샷과 동일한 수정 — 매 틱 Position을 직접
		-- 대입하면 클라이언트로 정상 동기화되지 않아 화살이 안 나가는 것처럼 보였다). 충돌 판정은
		-- 이 트윈과 별개로 동일한 수식의 curX를 매 틱 직접 계산해 처리한다.
		local totalTravelTime = math.abs(edgeX - launchPos.x) / self.Card106ArrowSpeed
		_TweenLogic:PlayTween(0.0, 1.0, totalTravelTime, EaseType.Linear, function(t)
			if not isvalid(fx) then return end
			local x = launchPos.x + (edgeX - launchPos.x) * t
			fx.TransformComponent.Position = Vector3(x, arrowY + visualY, launchPos.z)
		end)

		-- 유저 리포트: "화살이 관통이 남으면 화면 끝까지 가고 거기서 머물러있는데" — 시각적 이동(Tween,
		-- 실제 엔진 경과시간 기준)과 충돌판정 틱루프(elapsedTime을 매번 tickInterval만큼 수동으로
		-- 누적하는 별도 시계)가 서로 다른 시계를 쓰다 보니, 틱루프 쪽이 살짝이라도 밀리면(프레임 드랍
		-- 등) Tween은 이미 끝나 화살이 화면 끝에 멈춰 보이는데 틱루프의 reachedEdge는 아직 안 걸려서
		-- fx:Destroy가 늦게 불린다 — 그동안 "멈춰서 안 사라지는" 것처럼 보인다. Tween과 동일한
		-- totalTravelTime으로 별도의 안전장치 타이머를 걸어, 실제 이동이 끝나는 시점에 맞춰 확실히
		-- 사라지게 한다(유저 재확인: 관통 예산이 남아도 끝까지 이동하는 동작 자체는 그대로 유지해야 함).
		_TimerService:SetTimerOnce(function()
			if timerId then _TimerService:ClearTimer(timerId) end
			if isvalid(fx) then fx:Destroy(0.05) end
		end, totalTravelTime)

		timerId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self) or not isvalid(fx) then
				if timerId then _TimerService:ClearTimer(timerId) end
				return
			end
			-- 버그 수정(2026-08-26, 유저 지적: "화면 넘어갔는데 이펙트가 다음 존에 존재") — 화살이
			-- 화면을 가로지르는 도중 플레이어가 다른 존으로 넘어가면 즉시 지우고 틱루프를 멈춘다.
			if castZoneIndex ~= _MapManager.CurrentMapIndex then
				if timerId then _TimerService:ClearTimer(timerId) end
				if isvalid(fx) then fx:Destroy(0.05) end
				return
			end
			elapsedTime = elapsedTime + tickInterval
			local curX = launchPos.x + dir * self.Card106ArrowSpeed * elapsedTime

			local monsters = self:GetMonstersInCurrentZone(map)
			for _, mob in ipairs(monsters) do
				---@type MonsterAI
				local m = mob
				if isvalid(m) and not m._dead and isvalid(m.Entity) and not hitSet[m] then
					local mp = m.Entity.TransformComponent.Position
					if math.abs(mp.y - arrowY) <= self.Card106YBandTolerance and math.abs(mp.x - curX) <= self.Card106HitRadius then
						hitSet[m] = true
						hitCount = hitCount + 1
						local pierceIdx = hitCount - 1
						local finalDamage = damage
						if pierceIdx > 0 then finalDamage = damage * self:GetArrowFletterPiercePercent(pierceIdx) end
						if isCrit then m:TakeDamageCrit(finalDamage * 2)
						else m:TakeDamage(finalDamage) end
						local hitFx = self:SpawnEffect(self.Card118HitRUID, Vector3(mp.x, mp.y, launchPos.z), 0, self.Card118HitPlayRate, 1.0, 1)
						if hitFx ~= nil then hitFx:Destroy(self.HitEffectLifetime) end
					end
				end
			end

			-- reachedEdge는 flyDirRight가 아니라 실제 이동 부호(dir)를 기준으로 판정해야 한다 —
			-- flyDirRight로 판정하면 dir 부호를 반대로 고칠 때마다 여기도 같이 안 맞아서 화살이 첫
			-- 틱에 바로 끝난 것으로 처리되는 동일한 버그가 재발한다.
			local reachedEdge = (dir > 0 and curX >= edgeX) or (dir < 0 and curX <= edgeX)
			if hitCount >= maxBudget or reachedEdge then
				if timerId then _TimerService:ClearTimer(timerId) end
				if isvalid(fx) then fx:Destroy(0.05) end
			end
		end, tickInterval)
	end

	-- ── 실피드 전용: 언카운터 에로우 (카드 107, 슬롯형 정식 스킬 7호) — 종(세로) 범위기. 헤일 스톤과
	-- 동일한 매커니즘(GetGroundPriorityTargets로 지상 우선 anchor를 고른 뒤 그 위치에 판정 범위를
	-- 형성)을 90도 돌려 세로로 만든 버전이다(유저 요청: "유사한건 헤일스톤 가로형 광역이라고 보면됨").
	-- 몬스터 타겟 바로 위에 세로로 긴 연출이 먼저 생기고(유저 요청: "몬스터타겟으로 위쪽에 생기고"),
	-- 그 연출 범위 안에 있는 모든 몬스터가 타격 연출과 함께 맞는다(유저 요청: "연출 범위내에 몬스터에게
	-- 타격 연출 주면된다"). 대미지는 연출이 뜨는 시점이 아니라 타격 연출이 들어가는 시점에 맞춰
	-- 적용한다(유저 요청: "타격 연출 들어갈때 대미지 들어가야함").
	@Sync property integer UncounterArrowLevel = 0
	property string Card107Name = "언카운터 에로우"
	property string Card107IconRUID = "244c81f1750747549a5fdaa87f4e3d04"
	-- 연출(주 캐스트 — 하늘에서 바닥으로 떨어져 착탄하는 14프레임 연출, 유저 참고 이미지 확인)과 타격
	-- 연출(7프레임, 착탄 시 재생)은 리소스의 프레임 수/크기 변화 패턴으로 역할을 구분했다. 캐스트는
	-- 네이티브 애니메이션플레이어 루프에 맡기면 지속시간을 임의로 짧게 끊어야 해서 원본이 다 재생되기
	-- 전에 잘려 보였다(유저 지적: "쏘는 연출 짤리는거같은데 원본 그대로 연출 시켜 1회") — 리트리트
	-- 샷(Card106)과 동일하게 14장의 정지 프레임을 직접 이어붙여 정확히 1바퀴만 재생한다(래핑 없음).
	property string Card107CastRUID = "b187e24d9c0d42abbfa172a13e34059d"
	property string Card107CastFrame0RUID = "7c7d7fa1b7cb41bebc2d926259cdfff4"
	property string Card107CastFrame1RUID = "ed7c57de83e24318b52b21790712be77"
	property string Card107CastFrame2RUID = "1e9a2a363ae94c679abb44066cf17951"
	property string Card107CastFrame3RUID = "16dbb88a0720408fa24ac0cb62cd08a9"
	property string Card107CastFrame4RUID = "8fddc19573f141148736df2e5ae31fda"
	property string Card107CastFrame5RUID = "09e38e1c278a4af092078b805da0b4aa"
	property string Card107CastFrame6RUID = "3ee1c55ce6e7427398eefd47155777da"
	property string Card107CastFrame7RUID = "239f025070ae47aca8186aa231af1ebb"
	property string Card107CastFrame8RUID = "4f4d43910de2401d87b9d7f6c38adc90"
	property string Card107CastFrame9RUID = "cb847bf4f10f4bb882c7ebb9104eb7a3"
	property string Card107CastFrame10RUID = "7a63a20eafa94825bbe147d8af41ad92"
	property string Card107CastFrame11RUID = "3b07245a50cf4d6fb8a1ebe1f851baae"
	property string Card107CastFrame12RUID = "fd6558e294a3451b832c87a0a017d02b"
	property string Card107CastFrame13RUID = "f9fce6b2d1e9435d9ff3d649b4e6fe60"
	property number Card107CastFrameDuration = 0.07  -- 프레임 1장당 재생 시간(14장 × 0.07 = 0.98초 = 캐스트 전체 재생 시간)
	-- 원본 이미지가 "<" 방향(옆)을 향하고 있어 위→아래로 쏘는 것처럼 보이도록 회전 보정(유저 지적:
	-- "지금은 <쪽을 향해쏘잖아... -90도 해봐").
	property number Card107CastRotation = 90
	property string Card107HitRUID = "77222253430e496aa51b57ab307805af"
	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 전용 리소스팩 번들 오디오(_audio/Use) 사용
	property string Card107SoundRUID = "1f616220d57b46f1bc84e176117ebcb4"

	method void PlayUncounterArrowSound()
		_SoundService:PlaySound(self.Card107SoundRUID, 1.0)
	end
	property number Card107CastScale = 0.9  -- 유저 요청으로 10% 축소
	property number Card107HitScale = 1.0
	property number Card107HitLifetime = 0.4
	-- 캐스트 연출(활대 모양)을 타겟보다 확실히 위로 띄운다(유저 지적: "활대가 위로 나와야한다니깐?
	-- 위에서 아래로 쏘는거라고" — 판정 좌표(anchorPos)에는 영향 없는 순수 시각 오프셋).
	property number Card107CastYOffset = 3.5  -- 유저 요청으로 좀 더 위로
	property number Card107ImpactLeadTime = 0.3  -- 캐스트 연출이 다 끝나기 이 시간 전에 타격+대미지 적용(유저 요청: "대미지 0.3s 빠르게")
	-- 판정대 크기 — 리소스 실측(최대 프레임 652×320px, 90도 회전 후 세로/가로 축이 뒤바뀜, CastScale
	-- 0.9 적용, CastYOffset 2.5까지 포함)을 기준으로 연출이 실제로 그려지는 범위를 다 덮도록 넉넉하게
	-- 잡았다(유저 요청: "발사 연출에 포함되면 대미지 다 들어가야함" — 시각적으로 보이는 범위 안에
	-- 있는 몬스터는 전부 맞아야 한다).
	property number Card107BandWidth = 1.5  -- 세로 판정대 좌우 폭(±)
	property number Card107ColumnHeight = 6.0  -- 판정대가 타겟보다 위로 얼마나 높이까지 닿는지

	method number GetUncounterArrowDamage()
		if self.UncounterArrowLevel >= 5 then return 200
		elseif self.UncounterArrowLevel >= 4 then return 160
		elseif self.UncounterArrowLevel >= 3 then return 140
		elseif self.UncounterArrowLevel >= 2 then return 120
		end
		return 100
	end

	-- 착탄 지점(=anchor) 수 — Lv1~2: 1곳 / Lv3~5: 2곳
	method integer GetUncounterArrowTargetCount()
		if self.UncounterArrowLevel >= 3 then return 2 end
		return 1
	end

	-- 쿨타임 — Lv1~2: 7초 / Lv3~5: 6초
	method number GetUncounterArrowCooldown()
		if self.UncounterArrowLevel >= 3 then return 6.0 end
		return 7.0
	end

	-- 지상 우선(GetGroundPriorityTargets)으로 레벨별 개수만큼 착탄 지점을 고르고, 각 지점마다 하늘에서
	-- 떨어지는 세로 연출을 원본 그대로 1바퀴 재생한 뒤, 그 자리에 타격 연출을 재생하며 동시에 판정
	-- 범위(BandWidth×ColumnHeight, anchor 위쪽) 안의 모든 몬스터에게 대미지를 적용한다.
	@ExecSpace("ServerOnly")
	method void UncounterArrowAttack(number damage, boolean isCrit)
		self:PlayUncounterArrowSound()
		local map = self:GetCurrentMap()
		if map == nil then return end
		local targetCount = self:GetUncounterArrowTargetCount()
		local anchors = self:GetGroundPriorityTargets(targetCount)
		local hitCount = 0
		-- 버그 수정(2026-08-26, 유저 지적: "화면 넘어갔는데 이펙트가 다음 존에 존재") — 캐스트 시점
		-- 존 인덱스를 캡처해, 착탄 콜백이 실행될 때 플레이어가 이미 다른 존으로 넘어갔으면 착탄
		-- 이펙트 스폰을 건너뛴다.
		local castZoneIndex = _MapManager.CurrentMapIndex
		for _, anchor in ipairs(anchors) do
			local p = anchor.Entity.TransformComponent.Position
			local castPos = Vector3(p.x, p.y + self.Card107CastYOffset, p.z)
			local castDuration = self:PlayUncounterArrowCast(castPos, self:GetEffectScaleRatio(anchor))
			hitCount = hitCount + 1

			local impactDelay = math.max(0, castDuration - self.Card107ImpactLeadTime)
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				self:ResolveUncounterArrowHit(map, anchor, p, damage, isCrit, castZoneIndex)
			end, impactDelay)
		end
		log("UncounterArrowAttack: anchors=" .. hitCount .. "/" .. targetCount)
	end

	-- 캐스트 연출 — 애니메이션플레이어의 자체 루프에 맡기지 않고, 14장의 정지 프레임을 직접
	-- 이어붙여서 정확히 1바퀴만(래핑 없이) 재생한다(리트리트 샷과 동일한 기법). 네이티브 루프에
	-- 맡기면 재생 도중에 강제로 끊어야 해서 원본이 다 나오기 전에 잘려 보였다. 총 재생 시간(=착탄
	-- 시점)을 반환한다.
	@ExecSpace("ServerOnly")
	method number PlayUncounterArrowCast(Vector3 pos, number scaleRatio)
		local frames = {
			self.Card107CastFrame0RUID, self.Card107CastFrame1RUID, self.Card107CastFrame2RUID,
			self.Card107CastFrame3RUID, self.Card107CastFrame4RUID, self.Card107CastFrame5RUID,
			self.Card107CastFrame6RUID, self.Card107CastFrame7RUID, self.Card107CastFrame8RUID,
			self.Card107CastFrame9RUID, self.Card107CastFrame10RUID, self.Card107CastFrame11RUID,
			self.Card107CastFrame12RUID, self.Card107CastFrame13RUID,
		}
		local perFrame = self.Card107CastFrameDuration
		local totalDuration = perFrame * #frames
		local fx = self:SpawnEffectWithModel(frames[1], pos, self.Card107CastRotation, 1.0, self.Card107CastScale * scaleRatio, 1, "skilleffectlong")
		if fx == nil then return totalDuration end
		local r = fx.SpriteRendererComponent
		for step = 2, #frames do
			local frameRUID = frames[step]
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) and isvalid(r) then r.SpriteRUID = frameRUID end
			end, perFrame * (step - 1))
		end
		fx:Destroy(totalDuration)
		return totalDuration
	end

	-- 타격 연출은 anchor가 그 사이 죽어도 항상 그 좌표에 재생하고(다른 스킬과 동일한 정책: 연출은
	-- 항상 재생, 대미지만 생존 체크), 대미지는 판정 시점에 생존해 있는 몬스터에게만 세로 판정대
	-- (BandWidth×ColumnHeight, anchor 기준 위쪽) 안에 있으면 적용한다 — anchor 자신도 판정대 맨
	-- 아래(dx=0, dy=0)에 포함되므로 자동으로 맞는다.
	@ExecSpace("ServerOnly")
	method void ResolveUncounterArrowHit(Entity map, MonsterAI anchor, Vector3 anchorPos, number damage, boolean isCrit, integer castZoneIndex)
		if castZoneIndex == _MapManager.CurrentMapIndex then
			local fxHit = self:SpawnEffectWithModel(self.Card107HitRUID, anchorPos, 0, 1.0, self.Card107HitScale, 1, "skilleffectlong")
			if fxHit ~= nil then fxHit:Destroy(self.Card107HitLifetime) end
		end

		local monsters = self:GetMonstersInCurrentZone(map)
		local hitCount = 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local mp = m.Entity.TransformComponent.Position
				local dx = math.abs(mp.x - anchorPos.x)
				local dy = mp.y - anchorPos.y
				local inBand = dx <= self.Card107BandWidth and dy >= 0 and dy <= self.Card107ColumnHeight
				if inBand and self:IsSameDepthBand(anchor, m) then
					if isCrit then m:TakeDamageCrit(damage * 2)
					else m:TakeDamage(damage) end
					hitCount = hitCount + 1
				end
			end
		end
		log("UncounterArrowHit: hit=" .. hitCount)
	end

	-- ── 실피드 전용: 언카운트에로우V (카드 119, 조합 스킬) — 언카운터 에로우(Card107) Lv5 + 보우
	-- 액셀레이션(Card109) + 크리티컬 샷(Card111, 둘 다 슬롯 없는 패시브) 보유 시 등장 — 새 슬롯이
	-- 필요없고 언카운터 에로우의 슬롯을 그대로 넘겨받는다. 위치/각도는 언카운터 에로우와 동일(캐스트
	-- 회전 90도, CastYOffset=3.5 — 유저 지정: "위치 각도 그런거는 언카운트 에로우랑 같음")하되,
	-- 캐스트 연출이 신규 리소스(e1c03582..., 15프레임, 최대 840×596px)로 커져서 판정 범위
	-- (BandWidth/ColumnHeight)도 그 크기에 맞춰 다시 계산했다(유저 지정: "연출을 만큼 타격 범위를
	-- 수정해야함") — 언카운터 에로우 원본이 썼던 공식(90도 회전 후 원본 세로폭→ColumnHeight, 원본
	-- 가로폭 절반→BandWidth)을 그대로 적용: ColumnHeight≈8.4→8.5, BandWidth≈2.98→3.0. 이 스킬
	-- 전용 크리티컬 확률 보너스(10%/15%/20%, RollCrit에 cardIdx==119 분기 추가)가 있다. 아이콘/캐스트/
	-- 타격 연출 RUID는 유저가 처음 준 두 개가 실제로는 32×32 아이콘이 아니라 큰 이펙트였음을
	-- 썸네일로 직접 확인하고 재요청해서 확정했다(유저 확인: "준 RUID 둘 다 실제로는 큰 이펙트").
	@Sync property integer UncounterArrowVLevel = 0
	property string Card119Name = "언카운트에로우V"
	property string Card119IconRUID = "158c055faa384b36b5e4e273bf7da441"
	property string Card119CastFrame0RUID = "057f6eb181544ab7b10718d08058c4cc"
	property string Card119CastFrame1RUID = "d902e08cd8a64618bf48a29b5e4c47dc"
	property string Card119CastFrame2RUID = "9a5c7c332d534189a5771fb6c19c9173"
	property string Card119CastFrame3RUID = "260d0b65e8cc406fa039c4b93117eadd"
	property string Card119CastFrame4RUID = "c5dedb20d14748fc970cf4d1b150d90d"
	property string Card119CastFrame5RUID = "c734cac3933046a6906b0432692342bc"
	property string Card119CastFrame6RUID = "fa2e352b758845f8bc20b14193a9bf6d"
	property string Card119CastFrame7RUID = "767d7b84be13405a8ab987d5f268ba6d"
	property string Card119CastFrame8RUID = "9ce6c95b1e194c259f459bc69fa5a76d"
	property string Card119CastFrame9RUID = "100c6f3c1b324159b4e6db6c3736e546"
	property string Card119CastFrame10RUID = "15043f86442e45b3af102f9444f24c09"
	property string Card119CastFrame11RUID = "e34b3768def14aee9e5f413a065c2627"
	property string Card119CastFrame12RUID = "b465588492db45da9f844a8f1a990b7b"
	property string Card119CastFrame13RUID = "40615956bcae472791382f176dc1ff53"
	property string Card119CastFrame14RUID = "39a3b496c5dd4f1ea931ffba710ec03b"
	property number Card119CastFrameDuration = 0.07  -- 15프레임 × 0.07 = 1.05초
	property number Card119CastRotation = 90  -- 언카운터 에로우와 동일
	property string Card119HitRUID = "3cdf7b122eca48e5bb0b406adabf4ea9"
	property number Card119CastScale = 0.7  -- 유저 요청으로 30% 축소
	property number Card119HitScale = 1.0
	property number Card119HitLifetime = 0.4
	property number Card119CastYOffset = 3.5  -- 언카운터 에로우와 동일
	property number Card119ImpactLeadTime = 0.6  -- 유저 요청으로 대미지 타이밍 0.3초 빠르게(0.3→0.6)
	property number Card119Cooldown = 5.0  -- 레벨 무관 고정(유저 지정)
	-- 유저 요청: "크기 줄어들면 데미지 판정 범위도 그거에 맞게 변경되어야함" — CastScale 축소(30%)와
	-- 동일 비율로 판정 범위도 같이 줄인다.
	property number Card119BandWidth = 2.1  -- 3.0 × 0.7
	property number Card119ColumnHeight = 5.95  -- 8.5 × 0.7

	method number GetUncounterArrowVDamage(integer level)
		if level >= 3 then return 350
		elseif level >= 2 then return 300
		end
		return 250
	end

	-- 착탄 지점(=anchor) 수 — Lv1~2:3 / Lv3:4
	method integer GetUncounterArrowVTargetCount(integer level)
		if level >= 3 then return 4 end
		return 3
	end

	-- 이 스킬 전용 크리티컬 확률 보너스 — RollCrit(cardIdx==119)에서 합산된다
	-- SkillInventory 언카운트에로우V(인덱스33) Lv9: 크리티컬 확률 +8%, 카드 자체 레벨과 별개로 항상 가산
	method number GetUncounterArrowVCritChance(integer level)
		local base = 0.10
		if level >= 3 then base = 0.20
		elseif level >= 2 then base = 0.15
		end
		return base + self:GetSkillInvTierPercent(33, 0, 0, 0.08)
	end

	@ExecSpace("ServerOnly")
	method void UncounterArrowVAttack(number damage, boolean isCrit)
		self:PlayUncounterArrowSound()
		local map = self:GetCurrentMap()
		if map == nil then return end
		local level = self.UncounterArrowVLevel
		local targetCount = self:GetUncounterArrowVTargetCount(level)
		local anchors = self:GetGroundPriorityTargets(targetCount)
		local hitCount = 0
		-- 버그 수정(2026-08-26, 유저 지적: "화면 넘어갔는데 이펙트가 다음 존에 존재") — 캐스트 시점
		-- 존 인덱스를 캡처해, 착탄 콜백 시점에 이미 다른 존으로 넘어갔으면 착탄 이펙트를 건너뛴다.
		local castZoneIndex = _MapManager.CurrentMapIndex
		for _, anchor in ipairs(anchors) do
			local p = anchor.Entity.TransformComponent.Position
			local castPos = Vector3(p.x, p.y + self.Card119CastYOffset, p.z)
			local castDuration = self:PlayUncounterArrowVCast(castPos, self:GetEffectScaleRatio(anchor))
			hitCount = hitCount + 1

			local impactDelay = math.max(0, castDuration - self.Card119ImpactLeadTime)
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				self:ResolveUncounterArrowVHit(map, anchor, p, damage, isCrit, castZoneIndex)
			end, impactDelay)
		end
		log("UncounterArrowVAttack: anchors=" .. hitCount .. "/" .. targetCount)
	end

	-- 캐스트 연출 — 15장의 정지 프레임을 직접 이어붙여 정확히 1바퀴만(래핑 없이) 재생한다(언카운터
	-- 에로우와 동일한 기법). 총 재생 시간(=착탄 시점)을 반환한다.
	@ExecSpace("ServerOnly")
	method number PlayUncounterArrowVCast(Vector3 pos, number scaleRatio)
		local frames = {
			self.Card119CastFrame0RUID, self.Card119CastFrame1RUID, self.Card119CastFrame2RUID,
			self.Card119CastFrame3RUID, self.Card119CastFrame4RUID, self.Card119CastFrame5RUID,
			self.Card119CastFrame6RUID, self.Card119CastFrame7RUID, self.Card119CastFrame8RUID,
			self.Card119CastFrame9RUID, self.Card119CastFrame10RUID, self.Card119CastFrame11RUID,
			self.Card119CastFrame12RUID, self.Card119CastFrame13RUID, self.Card119CastFrame14RUID,
		}
		local perFrame = self.Card119CastFrameDuration
		local totalDuration = perFrame * #frames
		local fx = self:SpawnEffectWithModel(frames[1], pos, self.Card119CastRotation, 1.0, self.Card119CastScale * scaleRatio, 1, "skilleffectlong")
		if fx == nil then return totalDuration end
		local r = fx.SpriteRendererComponent
		for step = 2, #frames do
			local frameRUID = frames[step]
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) and isvalid(r) then r.SpriteRUID = frameRUID end
			end, perFrame * (step - 1))
		end
		fx:Destroy(totalDuration)
		return totalDuration
	end

	-- 타격 연출은 anchor가 그 사이 죽어도 항상 그 좌표에 재생하고, 대미지는 판정 시점에 생존해 있는
	-- 몬스터에게만 세로 판정대(BandWidth×ColumnHeight, anchor 기준 위쪽) 안에 있으면 적용한다.
	@ExecSpace("ServerOnly")
	method void ResolveUncounterArrowVHit(Entity map, MonsterAI anchor, Vector3 anchorPos, number damage, boolean isCrit, integer castZoneIndex)
		if castZoneIndex == _MapManager.CurrentMapIndex then
			local fxHit = self:SpawnEffectWithModel(self.Card119HitRUID, anchorPos, 0, 1.0, self.Card119HitScale, 1, "skilleffectlong")
			if fxHit ~= nil then fxHit:Destroy(self.Card119HitLifetime) end
		end

		local monsters = self:GetMonstersInCurrentZone(map)
		local hitCount = 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local mp = m.Entity.TransformComponent.Position
				local dx = math.abs(mp.x - anchorPos.x)
				local dy = mp.y - anchorPos.y
				local inBand = dx <= self.Card119BandWidth and dy >= 0 and dy <= self.Card119ColumnHeight
				if inBand and self:IsSameDepthBand(anchor, m) then
					if isCrit then m:TakeDamageCrit(damage * 2)
					else m:TakeDamage(damage) end
					hitCount = hitCount + 1
				end
			end
		end
		log("UncounterArrowVHit: hit=" .. hitCount)
	end

	-- ── 실피드 전용: 플레시 미라주 (카드 108, 슬롯형 정식 스킬 8호) — 넉백 스킬. 화면 양끝(좌/우)
	-- 중 더 바깥쪽에 서 있는 몬스터를 타겟으로 잡아(유저 요청: "유닛이 양끝에 있는 애가 타겟으로
	-- 잡혀야하고") 대미지를 넣고, 그 몬스터를 화면 가장자리까지 실제로 밀어붙인다(유저 요청: "유닛이
	-- 끝까지(좌,우) 밀려나가는거야"). Lv2부터는 좌/우 양쪽에서 각각 1명씩(=타겟 2명) 동시에 발동한다.
	-- 넉백되는 타겟 본인이 날아가면서 같은 뎁스 밴드(IsSameDepthBand)에서 경로상 충돌하는 다른
	-- 몬스터에게도 대미지를 준다(유저 요청 — 처음엔 "충돌한 적도 같이 넉백"이었으나 "넉백된(타겟)
	-- 몬스터가 날아가면서 충돌한 적에게 대미지 주는걸로 바꾸자"로 최종 변경, 충돌 대미지는 원래
	-- 대미지의 레벨별 비율만 적용, 넉백은 원래 타겟만). 대미지로 즉사할 상황이어도 타겟 본인은 넉백
	-- 연출이 끝날 때까지는 죽지 않는다(유저 요청: "대미지가 들어가도 즉시 죽지말고 넉백은하고 죽기"
	-- — MonsterAI:TakeDamageDelayedDeath로 처리). 충돌 대상은 그냥 즉시 데미지(넉백 없음)이므로 일반
	-- TakeDamage/TakeDamageCrit를 그대로 쓴다.
	@Sync property integer FleshMirageLevel = 0
	property string Card108Name = "플레시 미라주"
	property string Card108IconRUID = "764f0902e51048549dcbaf59b782639a"
	-- 연출(=타격 연출과 동일 리소스, 유저 제공, 20프레임) — 유저 지적으로 원본이 다 재생되기 전에
	-- 잘려 보이는 문제를 확인해, 리트리트 샷/언카운터 에로우와 동일하게 20장의 정지 프레임을 직접
	-- 이어붙여서 정확히 1바퀴만 재생한다.
	property string Card108EffectRUID = "58e110e55e704554b86208eec56e497f"
	property string Card108EffectFrame0RUID = "2b71e962288f4522a9d33377774d49a9"
	property string Card108EffectFrame1RUID = "d4c495e20524473cac84b676415ee870"
	property string Card108EffectFrame2RUID = "aff17c0dee474b4bb89c6075c34ddc37"
	property string Card108EffectFrame3RUID = "0922405272554360983ce68aa013d883"
	property string Card108EffectFrame4RUID = "e9c1f9283d4a41d1aa9c46cb294a8241"
	property string Card108EffectFrame5RUID = "cab3240faf7c47c687de2ed22c0fa4ad"
	property string Card108EffectFrame6RUID = "ed898d8b7fad4a9c80a83b4eefef905a"
	property string Card108EffectFrame7RUID = "01990a746ccf4bb8b8006833c3b0d584"
	property string Card108EffectFrame8RUID = "8db65beb017342cd8f40a84e10a2371b"
	property string Card108EffectFrame9RUID = "8b1132ca4326494c821f996fb1b53187"
	property string Card108EffectFrame10RUID = "1bdfed2b4fd64eceaadd6a670cf5035f"
	property string Card108EffectFrame11RUID = "95c5398eb0ab4357aafe4062464a26d4"
	property string Card108EffectFrame12RUID = "dd8766a2d7e242b4880ef6f54ecc2ee9"
	property string Card108EffectFrame13RUID = "8eddc6dbfd8742159d50adf9eada3def"
	property string Card108EffectFrame14RUID = "91fc606c33dc4fa2b6cdd003ae4bf1e6"
	property string Card108EffectFrame15RUID = "bf94f821798f479ea9e2f817053fb98d"
	property string Card108EffectFrame16RUID = "4ce213b444674f77935dd9d02e66c0d1"
	property string Card108EffectFrame17RUID = "853aab4565ca4b4ba7872ac0f72a41ec"
	property string Card108EffectFrame18RUID = "ba55b85bfd194ff3851895dee920cc31"
	property string Card108EffectFrame19RUID = "087ccc526b254dcdb4b10c4c868add68"
	property string Card108CollisionHitRUID = "ff4ac418d6e24097a78ec2d2897b1b29"  -- 충돌 대상 타격 이펙트(유저 제공)
	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 전용 팩에 번들 오디오가 없어 같은 돌진형
	-- 레이징 블로우(Card157) 사운드 재사용
	property string Card108SoundRUID = "d621d7a5bffb427cac3f1e00db9d451b"

	method void PlayFleshMirageSound()
		_SoundService:PlaySound(self.Card108SoundRUID, 1.0)
	end
	property number Card108Cooldown = 5.0
	property number Card108EffectScale = 1.15  -- 유저 요청으로 15% 확대
	property number Card108EffectYOffset = 0.4  -- 연출을 위로 띄움(유저 요청, 판정 좌표엔 영향 없는 순수 시각 오프셋)
	property number Card108KnockbackDuration = 0.5  -- 중앙(0)까지 실제로 밀려나가는 물리 이동 시간(넉백 자체) — 연출 재생 시간과는 별개
	property number Card108CenterRadius = 1.0  -- 이 반경 안의 몬스터는 "이미 중앙" 취급 — 좌/우 어느 쪽에도 반경 밖 몬스터가 없으면 대신 양끝으로 밀어낸다(유저 지정)
	property number Card108OutwardOvershoot = 1000.0  -- 양끝으로 밀어낼 때 일부러 넘겨주는 먼 destX — ClampKnockbackDestX가 실제 발판 가장자리로 잘라낸다
	property number KnockbackScreenSafeHalfWidth = 5.0  -- ClampKnockbackDestX 최종 클램프용 화면 안전 반폭 — GetSpawnPositionFromFootholds 등 스폰 로직이 쓰는 "플레이어 위치 ±5" 관례와 동일(카메라 가시범위 대략 ±6.4 안쪽)
	-- 연출 재생 시간을 Card108KnockbackDuration에 억지로 맞추면(0.5초÷20프레임=0.025초/프레임) 원본보다
	-- 훨씬 빨리 재생돼 사실상 원본 그대로가 아니게 된다(유저 강한 지적: "원본 그대로 다 보여주게
	-- 바꾸랬잖아... 연출 시간이 맞냐고"). 리트리트 샷/언카운터 에로우와 동일하게 프레임당 재생시간을
	-- 독립적으로(0.07초/프레임, 20프레임=1.4초) 고정하고, 넉백 이동(물리)과는 완전히 분리한다.
	property number Card108EffectFrameDuration = 0.07
	property number Card108KnockbackStartDelay = 0.7  -- 연출 시작 후 실제 대미지+넉백이 들어가기까지의 지연(유저 요청, 최초 0.2초 → 0.7초로 조정)
	property number Card108EffectFrameCount = 20
	property number Card108CollisionHitScale = 1.0

	method number GetFleshMirageDamage()
		if self.FleshMirageLevel >= 5 then return 200
		elseif self.FleshMirageLevel >= 4 then return 160
		elseif self.FleshMirageLevel >= 3 then return 140
		end
		return 100
	end

	-- 타겟 수(=동시에 넉백시키는 유닛 수) — Lv1: 1명(더 바깥쪽 한쪽만) / Lv2~5: 2명(좌우 양쪽 동시)
	method integer GetFleshMirageTargetCount()
		if self.FleshMirageLevel >= 2 then return 2 end
		return 1
	end

	-- 충돌 대상 대미지 비율 — Lv1:60% / Lv2:70% / Lv3:80% / Lv4:90% / Lv5:100%
	-- 유저 요청으로 너프: 60/70/80/90/100% → 30/30/40/50/60%
	-- SkillInventory 플레시 미라주(인덱스27) Lv9: 충돌 대미지 +15%, 카드 자체 레벨과 별개로 항상 가산
	method number GetFleshMirageCollisionPercent()
		local base = 0.30
		if self.FleshMirageLevel >= 5 then base = 0.60
		elseif self.FleshMirageLevel >= 4 then base = 0.50
		elseif self.FleshMirageLevel >= 3 then base = 0.40
		end
		return base + self:GetSkillInvTierPercent(27, 0, 0, 0.15)
	end

	-- 화면에 살아있는 몬스터 중 좌/우(중앙 x=0 기준) 각각 가장 바깥쪽 몬스터를 찾는다. 모든 레벨에서
	-- 넉백 방향은 항상 중앙(x=0)이다(유저의 강한 최종 지적: "맨 좌측에 뜨는애를 왜 <이쪽으로
	-- 보내내고... >으로 보내야지... 중앙에 모이게 보내라고" — 바깥(가장자리)으로 미는 이전 설계는
	-- 완전히 틀렸었다). Lv1은 좌/우 중 하나를 무작위로 골라(이전엔 "더 바깥쪽" 비교로 골라서 몬스터
	-- 스폰 좌표 특성상 사실상 항상 오른쪽만 뽑혔다 — 무작위 선택으로 편향을 없앰) 그 몬스터 하나만
	-- 중앙으로 넉백시키고, Lv2 이상은 있는 쪽 전부(최대 좌우 각 1명씩)를 동시에 중앙으로 넉백시켜
	-- 서로 충돌하게 한다(유저 요청: "좌우에 한개씩 생겨서 중앙쪽으로 모이게 쏘면 될듯").
	@ExecSpace("ServerOnly")
	method void FleshMirageAttack(number damage, boolean isCrit)
		self:PlayFleshMirageSound()
		local map = self:GetCurrentMap()
		if map == nil then return end
		local monsters = self:GetMonstersInCurrentZone(map)
		local centerX = self:GetZoneCenterX()

		-- Card108CenterRadius(1.0) 밖에 있는 몬스터만 "바깥쪽 최외곽" 후보로 본다 — 그 반경 안에
		-- 있는 몬스터는 centerCluster에 모아뒀다가, 좌/우 어느 쪽에도 바깥쪽 후보가 하나도 없을 때
		-- (전부 중앙 근방에 몰려있을 때) FireFleshMirageOutward로 넘긴다(유저 지정: "우선순위는 양끝이
		-- 지금처럼 맞지만 만약에 중앙에만 있으면... 양끝으로 날아가야해" — 기존 "중앙으로 당기기"만
		-- 있으면 이미 중앙 근처인 몬스터에게 써도 이동량이 0에 가까워 사실상 아무 효과가 없었다).
		local leftExtreme, rightExtreme = nil, nil
		local centerCluster = {}
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local x = m.Entity.TransformComponent.Position.x
				if x < centerX - self.Card108CenterRadius and (leftExtreme == nil or x < leftExtreme.Entity.TransformComponent.Position.x) then
					leftExtreme = m
				elseif x > centerX + self.Card108CenterRadius and (rightExtreme == nil or x > rightExtreme.Entity.TransformComponent.Position.x) then
					rightExtreme = m
				elseif x >= centerX - self.Card108CenterRadius and x <= centerX + self.Card108CenterRadius then
					table.insert(centerCluster, m)
				end
			end
		end
		if leftExtreme == nil and rightExtreme == nil then
			self:FireFleshMirageOutward(map, monsters, centerCluster, centerX, damage, isCrit)
			return
		end

		local targetCount = self:GetFleshMirageTargetCount()
		local collisionPct = self:GetFleshMirageCollisionPercent()

		if targetCount >= 2 then
			-- Lv2+: 있는 쪽 전부 존 중심으로 모이게 넉백(유저 요청: "좌우에 한개씩 생겨서 중앙쪽으로 모이게").
			-- 한쪽만 바깥쪽 후보가 있고 반대쪽엔 바깥쪽 후보 없이 중앙 근방(centerCluster)에만 몬스터가
			-- 있으면 그동안 반대쪽은 아무 반응이 없었다(유저 지적: "한쪽은 끝정도에 있고 한쪽은 중앙에
			-- 있으면 발동안되는데... 중앙부 타격해서 끝으로 옮겨야할거같은데"). Lv2+는 항상 2마리가
			-- 움직이도록, 비어있는 쪽은 centerCluster에서 무작위 1마리를 뽑아 그 반대쪽(비어있는 쪽)
			-- 끝으로 밀어낸다 — FireFleshMirageOutward와 동일한 오버슈트+클램프 방식 재사용.
			if leftExtreme ~= nil then
				self:FireFleshMirageShove(map, monsters, leftExtreme, centerX, damage, isCrit, collisionPct)
			elseif #centerCluster > 0 then
				local pick = centerCluster[_UtilLogic:RandomIntegerRange(1, #centerCluster)]
				self:FireFleshMirageShove(map, monsters, pick, centerX - self.Card108OutwardOvershoot, damage, isCrit, collisionPct)
			end
			if rightExtreme ~= nil then
				self:FireFleshMirageShove(map, monsters, rightExtreme, centerX, damage, isCrit, collisionPct)
			elseif #centerCluster > 0 then
				local pick = centerCluster[_UtilLogic:RandomIntegerRange(1, #centerCluster)]
				self:FireFleshMirageShove(map, monsters, pick, centerX + self.Card108OutwardOvershoot, damage, isCrit, collisionPct)
			end
		else
			-- Lv1: 좌/우 절반 중 하나를 무작위로 골라 그 몬스터를 존 중심으로 넉백한다(유저 강한 지적:
			-- "맨 좌측에 뜨는애를 왜 <이쪽으로 보내내고... >으로 보내야지... 중앙에 모이게 보내라고" —
			-- 바깥(가장자리)이 아니라 항상 중앙 쪽으로 밀어야 한다. Lv2+와 동일하게 destX=centerX를 쓴다).
			local pickRight
			if leftExtreme == nil then pickRight = true
			elseif rightExtreme == nil then pickRight = false
			else pickRight = _UtilLogic:RandomDouble() < 0.5 end
			if pickRight then
				self:FireFleshMirageShove(map, monsters, rightExtreme, centerX, damage, isCrit, collisionPct)
			else
				self:FireFleshMirageShove(map, monsters, leftExtreme, centerX, damage, isCrit, collisionPct)
			end
		end
	end

	-- 몬스터가 서 있는 발판의 실제 폭을 벗어나 넉백되면 허공에 뜬 채로 멈추는 문제가 있었다(유저 지적:
	-- "공중 발판에 있던애들은 넉백되고 공중에 떠있어... 넉백은 타일이 있는 곳까지만 갈수있단말이지" —
	-- 단 실제 비행형 몬스터는 발판 개념이 없으므로 예외(유저 확인: "공중은 예외여~")). MonsterSpawner에
	-- 이미 있는 존별 발판 밴드(GetZonePlatformBands, 스폰 위치 결정에 쓰던 것)를 재사용해 목적지 X를
	-- 타겟이 서 있는 발판의 xMin~xMax 안으로 잘라낸다. 하드코딩 밴드가 없는 존(8/13~15)은 GetZonePlatformBands가
	-- nil을 반환하는데, 이 존들은 스폰 로직도 똑같이 하드코딩 대신 FootholdComponent를 직접 훑는 GetFlatRuns를
	-- 쓰므로(유저 지적: "그럼 그 존은 클램프 없이=공중에 뜬다는 소리?" — 맞는 지적이라 동일하게 대응해야
	-- 한다) 여기서도 그 방식으로 폴백한다.
	-- target.Entity.TransformComponent.Position는 "존 컨테이너 기준 로컬 좌표"인데(TransformComponent.d.mlua:
	-- "Shows coordinates relative to an Entity's parent"), GetZonePlatformBands(+offsetX)/GetFlatRuns가
	-- 반환하는 밴드는 둘 다 월드(맵 루트) 좌표다 — 프레임이 안 맞았다. 컨테이너가 없는 루트 존(오프셋
	-- 0)에서는 로컬==월드라 우연히 맞았지만, 컨테이너가 있는 대부분의 존(오프셋이 0이 아닌 거의 모든
	-- 존)에서는 로컬 좌표가 항상 0 근처라 "월드 X가 0 근처인" 엉뚱한(주로 루트) 존의 밴드가 매번
	-- 잘못 선택됐다(유저 리포트: "존29에서 플레시 미라주 쓰면 타일을 뚫고 들어간다" — 존29(로컬≈0)가
	-- 실제로는 존27(월드 x≈0)의 밴드로 잘못 클램프됨, 실측 확인: 존27/29 둘 다 y=-0.49 밴드를 갖고
	-- 있어 Y로도 구분이 안 됨). GetBowSpawnPosition/GetZoneCenterX와 동일한 패턴으로 컨테이너의
	-- WorldPosition을 더해 로컬 pos/destX를 월드로 변환해서 비교하고, 최종 결과는 다시 로컬로 되돌려
	-- 반환한다(호출부 FireFleshMirageShove/FireFlashBomberShove가 전부 로컬 좌표로 이후 계산을
	-- 이어가므로 — primaryX = primary.Entity.TransformComponent.Position.x와 같은 프레임이어야 한다).
	@ExecSpace("ServerOnly")
	method number ClampKnockbackDestX(MonsterAI target, number destX)
		if not isvalid(target) or not isvalid(target.Entity) or not isvalid(target.Entity.TransformComponent) then return destX end
		if target._isFlying then return destX end
		-- 버그 수정(2026-08-26, 유저 리포트 "보너스보스가 넉백맞고 사라짐") — 보너스보스(Ep3Map2BonusBossLogic)는
		-- 실제로는 ZoneInfo 밖 고정 아레나(ep3_map2_ester_1)에 서 있지만, 스킬 타겟팅을 위해 _spawnZoneIndex에
		-- "플레이어가 입장 직전에 있던 실제 존"(예: 101)을 등록해둔다(InitializeAnimatedBonusBoss 주석 참고).
		-- 그런데 이 메서드는 그 _spawnZoneIndex로 발판 밴드/존 컨테이너 오프셋을 조회하므로, 보너스보스한테는
		-- 아레나와 전혀 무관한 "실제 존"의 좌표계로 clamp를 계산해버려 엉뚱한 destX가 나온다 — 발판을 평평하게
		-- 바꾼 것과 무관하게 항상 있던 버그. 보너스보스는 애초에 ApplyKnockback도 제외되어 있으니(§ApplyKnockback)
		-- 여기서도 동일하게 제외한다.
		if target._isBonusBoss then return destX end
		local zoneIdx = target._spawnZoneIndex
		local bands = _MonsterSpawner:GetZonePlatformBands(zoneIdx)
		local pos = target.Entity.TransformComponent.Position

		local zoneMap = _MonsterSpawner:GetZoneEntity(zoneIdx)
		local containerOffsetX = 0
		if zoneMap ~= nil and isvalid(zoneMap) and isvalid(zoneMap.TransformComponent) then
			containerOffsetX = zoneMap.TransformComponent.WorldPosition.x
		end
		local worldPosX = pos.x + containerOffsetX
		local worldDestX = destX + containerOffsetX

		-- 하드코딩 밴드(GetZonePlatformBands)는 병합 전 존 로컬 좌표라 월드 좌표로 쓰려면 존 오프셋을
		-- 더해야 한다(GetSpawnPositionFromFootholds와 동일한 이유) — FootholdComponent에서 직접 뽑는
		-- GetFlatRuns 결과는 이미 월드 좌표라 오프셋을 더하면 안 된다.
		local needsOffset = bands ~= nil
		local offsetX = needsOffset and _MonsterSpawner:GetZoneOffsetX(zoneIdx) or 0

		if bands == nil then
			-- 성능 최적화(2026-08-20, 유저 리포트 "에피2 맵3/4에서 몬스터 소환될때 렉") — 매번 전체
			-- FootholdComponent를 새로 스캔하는 대신 mapIndex별 캐시(GetFlatRunsCached)를 재사용한다.
			bands = _MonsterSpawner:GetFlatRunsCached(zoneIdx)
		end
		if bands == nil or #bands == 0 then return destX end

		-- Y가 같은 밴드가 여러 존에 걸쳐 있을 수 있다(예: 그룹I 존27=존29, 존28=존30이 각각 같은 지면
		-- 높이) — GetFlatRuns는 존별로 나뉘지 않은 밴드 목록을 그대로 반환하므로, Y만 보고 고르면 여러
		-- 존이 동률일 때 먼저 나열된 쪽으로 잘못 클램프될 수 있다. Y 차이를 압도적으로 우선하되(다른
		-- 층이면 절대 안 됨), Y가 같거나 거의 같은 후보들 사이에서는 (월드로 변환한) 현재 위치를 실제로
		-- 포함/근접한 밴드를 우선하도록 X 거리를 보조 기준으로 추가한다.
		local bestBand = nil
		local bestScore = -1
		for _, band in ipairs(bands) do
			local dy = math.abs(band.y - pos.y)
			local bandMinX = band.xMin + offsetX
			local bandMaxX = band.xMax + offsetX
			local dx = 0
			if worldPosX < bandMinX then dx = bandMinX - worldPosX
			elseif worldPosX > bandMaxX then dx = worldPosX - bandMaxX end
			local score = dy * 1000 + dx
			if bestScore < 0 or score < bestScore then
				bestScore = score
				bestBand = band
			end
		end
		if bestBand == nil then return destX end
		local margin = 0.2
		local minX = bestBand.xMin + offsetX + margin
		local maxX = bestBand.xMax + offsetX - margin
		if minX > maxX then return pos.x end

		-- 발판 자체가 카메라 가시범위(대략 ±6.4)보다 넓을 수 있다 — 특히 GetFlatRuns 폴백(bands==nil)은
		-- 병합 맵 전체 FootholdComponent를 훑으므로 존 경계 없이 이어진 발판이면 xMin/xMax가 옆 존까지
		-- 뻗어있을 수 있다. 발판 가장자리 클램프만으로는 부족해서(유저 리포트: "양끝으로 보낼때 화면
		-- 밖으로 나가는 케이스"), GetSpawnPositionFromFootholds가 스폰 위치에 이미 쓰는 것과 동일한
		-- "플레이어 현재 위치 ±5" 화면 안전범위로 한 번 더 좁힌다.
		-- 버그 수정(유저 리포트: "무스펠하임 공중타일에서 화면이 중앙이 아니면 광역대미지가 안 들어간다") —
		-- 공중타일(플레이어가 서 있는 지면과 다른 높이의 발판)은 밴드 X범위 자체가 "플레이어 위치 ±5"
		-- 화면 안전범위와 아예 안 겹칠 수 있다. 이전엔 그 경우 minX>maxX가 돼 destX가 pos.x로
		-- 무너져(=넉백 이동거리 0) 착지 지점(stopPos)이 원래 자리 그대로 고정되고, 정작 몬스터들이
		-- 흩어져 있던 자리엔 아무도 안 모이니 광역 폭발이 허공만 때리는 것처럼 보였다. 화면 안전범위와
		-- 발판이 안 겹치면 화면 클램프를 포기하고 발판 범위 안에서만 클램프해 실제 넉백 이동은 항상
		-- 일어나게 한다(화면 밖으로 나가는 것 자체는 발판 클램프가 여전히 막아준다).
		local playerWorldX = self:GetPlayerCenterX()
		local safeMinX = math.max(minX, playerWorldX - self.KnockbackScreenSafeHalfWidth)
		local safeMaxX = math.min(maxX, playerWorldX + self.KnockbackScreenSafeHalfWidth)
		if safeMinX <= safeMaxX then
			minX, maxX = safeMinX, safeMaxX
		end
		worldDestX = math.max(minX, math.min(maxX, worldDestX))

		-- 버그 수정(2026-08-20, 유저 리포트 "넉백류 스킬쓰면 계속 존을 벗어나는 경우가 생기는거 같은데") —
		-- 위 화면-안전 클램프(±5)만으로는 존 경계를 완전히 못 막는다: 맵3/4처럼 존 간격이 15.5인 곳에서
		-- 플레이어가 존 가장자리 쪽에 서 있으면 "플레이어 위치 ±5" 범위 자체가 존 경계(간격의 절반=7.75)를
		-- 넘어갈 수 있어서, 넉백당한 몬스터가 물리적으로 이어진 옆 존 발판까지 밀려나 버린다. 같은 파일을
		-- 공유하는 앞/뒤 존과의 spawnX 중간지점(GetZoneXBounds)을 하드 경계로 한 번 더 덧씌워서, 넉백이
		-- 절대 자기 존 밖으로 못 나가게 한다. container 있는 존은 GetZoneXBounds가 nil을 반환해 아무 영향 없다.
		local zoneBounds = _MonsterSpawner:GetZoneXBounds(zoneIdx)
		if zoneBounds ~= nil then
			if zoneBounds.minX ~= nil then worldDestX = math.max(worldDestX, zoneBounds.minX + margin) end
			if zoneBounds.maxX ~= nil then worldDestX = math.min(worldDestX, zoneBounds.maxX - margin) end
		end

		-- 존8은 발판 자체는 하나로 이어져 있지만 그 위에 충돌 데이터 없는 순수 장식 기둥이 있어서,
		-- 발판 폭 클램프만으로는 넉백이 그 기둥을 뚫고 지나가 보였다(유저 지적: "존 8에서 기둥 거기는
		-- 넉백하면 몬스터가 뚫고 지나가... 존8만 하드코딩으로 기둥 못가게 막을수있나?"). 월드 X
		-- 20.7~21.7(존8 오프셋 15.5 + object-4 로컬 x≈5.71 기준 추정치 — 실측이 다르면 조정 필요)을
		-- 통과 금지 구간으로 별도 처리해, 시작 위치 기준 반대편으로 넘어가려 하면 기둥 이쪽 가장자리에서 멈춘다.
		if target._spawnZoneIndex == 8 then
			local pillarMinX, pillarMaxX = 20.7, 21.7
			local fromX = worldPosX
			if fromX < pillarMinX and worldDestX >= pillarMinX then
				worldDestX = pillarMinX - margin
			elseif fromX > pillarMaxX and worldDestX <= pillarMaxX then
				worldDestX = pillarMaxX + margin
			end
		end

		return worldDestX - containerOffsetX
	end

	-- 타겟 하나를 destX까지 실제로 밀어붙인다(Lv1은 화면 가장자리, Lv2+는 중앙 0). 실제 이동 방향
	-- (dirRight)은 시작 위치와 destX의 대소 관계로 구한다 — Lv1(바깥으로)과 Lv2(중앙으로) 모두 같은
	-- 코드로 처리되도록. 대미지는 타겟 본인만 받고(죽음은 넉백 종료까지 지연), 이동 경로상 같은 뎁스
	-- 밴드에서 충돌하는 다른 몬스터는 넉백 없이 충돌 대미지(collisionPct)만 받는다 — 대미지 타이밍은
	-- 타겟이 실제로 그 몬스터의 X를 지나가는 시점에 맞춘다.
	@ExecSpace("ServerOnly")
	method void FireFleshMirageShove(Entity map, table monsters, MonsterAI primary, number destX, number damage, boolean isCrit, number collisionPct)
		-- 후보로 뽑힌 뒤(FleshMirageAttack) 실제 넉백 처리 전에 다른 스킬/이펙트 스폰 등으로 primary가
		-- 무효화될 수 있다(실측: 동시다발 스폰이 몰린 상황에서 발생 확인) — 크래시 대신 조용히 스킵.
		if not isvalid(primary) or not isvalid(primary.Entity) or not isvalid(primary.Entity.TransformComponent) then return end
		destX = self:ClampKnockbackDestX(primary, destX)
		local primaryX = primary.Entity.TransformComponent.Position.x
		local dirRight = destX > primaryX
		local totalDist = math.abs(destX - primaryX)

		local pp = primary.Entity.TransformComponent.Position
		self:PlayFleshMirageEffect(Vector3(pp.x, pp.y + self.Card108EffectYOffset, pp.z), dirRight, self:GetEffectScaleRatio(primary))
		-- 버그 수정(2026-08-26, 유저 지적: "화면 넘어갔는데 이펙트가 다음 존에 존재, 실피드쪽이 많은거
		-- 같아") — 캐스트 시점 존 인덱스를 캡처해, 넉백 지연 이후 충돌 히트 이펙트가 다른 존에 잘못
		-- 나타나지 않게 한다.
		local castZoneIndex = primary._spawnZoneIndex

		-- 연출이 시작되고 Card108KnockbackStartDelay(0.7초) 뒤에야 실제 대미지+넉백이 들어간다(최초
		-- 유저 요청은 0.2초였으나 "연출 시작하고 약 0.7s 있다가 넉백되게 변경해" 요청으로 조정).
		-- 버그 수정(2026-08-26, 유저 지적: "연출 끊기는거 같은데") — primary가 KnockbackStartDelay
		-- 도중 죽으면 이 블록 전체(주변 다른 몬스터 충돌 히트 이펙트까지)가 통째로 스킵됐다. primary
		-- 관련 로직(넉백 이동)만 따로 생사 체크하고, 충돌 판정/연출은 primary 생사와 무관하게 항상
		-- 진행한다(primaryX/dirRight/totalDist/destX는 이미 타이머 시작 전에 값으로 캡처돼 있어 primary가
		-- 죽거나 파괴돼도 안전). 각 충돌 대상(m)의 히트 이펙트도 데미지와 분리해서 항상 재생한다.
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end

			if isvalid(primary) and isvalid(primary.Entity) and not primary._dead then
				if isCrit then primary:TakeDamageDelayedDeath(damage * 2, true, self.Card108KnockbackDuration)
				else primary:TakeDamageDelayedDeath(damage, false, self.Card108KnockbackDuration) end
				primary:ApplyLateralShove(destX, self.Card108KnockbackDuration)
			end

			local collideCount = 0
			if totalDist > 0 then
				for _, mob in ipairs(monsters) do
					---@type MonsterAI
					local m = mob
					if isvalid(m) and m ~= primary and not m._dead and isvalid(m.Entity) and self:IsSameDepthBand(primary, m) then
						local mx = m.Entity.TransformComponent.Position.x
						local inPath = (dirRight and mx >= primaryX and mx <= destX)
							or ((not dirRight) and mx <= primaryX and mx >= destX)
						if inPath then
							collideCount = collideCount + 1
							local hitDelay = self.Card108KnockbackDuration * (math.abs(mx - primaryX) / totalDist)
							local collideDamage = damage * collisionPct
							_TimerService:SetTimerOnce(function()
								if not isvalid(m) or not isvalid(m.Entity) then return end
								if castZoneIndex == _MapManager.CurrentMapIndex then
									local hitPos = m.Entity.TransformComponent.Position
									local hitFx = self:SpawnEffect(self.Card108CollisionHitRUID, hitPos, 0, 1.0, self.Card108CollisionHitScale, 1)
									if hitFx ~= nil then hitFx:Destroy(self.HitEffectLifetime) end
								end
								if not m._dead then
									if isCrit then m:TakeDamageCrit(collideDamage * 2)
									else m:TakeDamage(collideDamage) end
								end
							end, hitDelay)
						end
					end
				end
			end

		log("FleshMirageShove: dmg=" .. math.floor(isCrit and damage * 2 or damage) .. " collide=" .. collideCount .. " dirRight=" .. tostring(dirRight))
		end, self.Card108KnockbackStartDelay)
	end

	-- 좌/우 어느 쪽에도 Card108CenterRadius 밖(=의미 있게 바깥)에 있는 몬스터가 하나도 없을 때
	-- FleshMirageAttack이 대신 호출하는 대체 동작 — centerCluster(중앙 근방에 몰려있는 몬스터들) 중
	-- 무작위 2마리를 골라 하나는 좌측 끝, 하나는 우측 끝으로 밀어낸다(유저 지정: "우선순위는 양끝이
	-- 지금처럼 맞지만 만약에 중앙에만있으면... 양끝으로 날아가야해... 랜덤 2마리로"). 몰려있는 몬스터가
	-- 1마리뿐이면 양쪽으로 동시에 보낼 수 없으므로 아무 것도 하지 않는다(유저 확인: "몬스터가 1마리면
	-- ... 안움직이는게 맞을거 같고"). destX는 일부러 아주 먼 값(Card108OutwardOvershoot)을 넘겨서
	-- ClampKnockbackDestX가 각 타겟이 실제로 서 있는 발판의 진짜 가장자리로 알아서 잘라내게 한다 —
	-- FireFleshMirageShove의 클램프/충돌 로직을 그대로 재사용한다.
	@ExecSpace("ServerOnly")
	method void FireFleshMirageOutward(Entity map, table monsters, table centerCluster, number centerX, number damage, boolean isCrit)
		if #centerCluster < 2 then return end
		local collisionPct = self:GetFleshMirageCollisionPercent()

		local pool = {}
		for i, m in ipairs(centerCluster) do pool[i] = m end
		for i = #pool, 2, -1 do
			local j = _UtilLogic:RandomIntegerRange(1, i)
			pool[i], pool[j] = pool[j], pool[i]
		end

		self:FireFleshMirageShove(map, monsters, pool[1], centerX - self.Card108OutwardOvershoot, damage, isCrit, collisionPct)
		self:FireFleshMirageShove(map, monsters, pool[2], centerX + self.Card108OutwardOvershoot, damage, isCrit, collisionPct)
	end

	-- 20프레임 원본을 직접 이어붙여 정확히 1바퀴만 재생(래핑 없음, 유저 지적: "2번 루프 되는거
	-- 같은데 1번만 실행하게") — 오른쪽으로 날릴 때 FlipX 반전(유저 표현 "Y축 반전"은 이 프로젝트에서
	-- 실측 확인된 대로 엔진 FlipY가 아니라 좌우 반전을 뜻한다). PlayRate=0으로 네이티브 애니메이션
	-- 재생 자체를 꺼서, 프레임 전환이 전부 이 타이머로만 제어되고 엔진이 자체적으로 다시 재생/루프할
	-- 여지를 없앤다. 전체 재생 시간은 프레임 수 × 프레임당 시간(Card108EffectFrameDuration)이다.
	@ExecSpace("ServerOnly")
	method void PlayFleshMirageEffect(Vector3 pos, boolean dirRight, number scaleRatio)
		local frames = {
			self.Card108EffectFrame0RUID, self.Card108EffectFrame1RUID, self.Card108EffectFrame2RUID,
			self.Card108EffectFrame3RUID, self.Card108EffectFrame4RUID, self.Card108EffectFrame5RUID,
			self.Card108EffectFrame6RUID, self.Card108EffectFrame7RUID, self.Card108EffectFrame8RUID,
			self.Card108EffectFrame9RUID, self.Card108EffectFrame10RUID, self.Card108EffectFrame11RUID,
			self.Card108EffectFrame12RUID, self.Card108EffectFrame13RUID, self.Card108EffectFrame14RUID,
			self.Card108EffectFrame15RUID, self.Card108EffectFrame16RUID, self.Card108EffectFrame17RUID,
			self.Card108EffectFrame18RUID, self.Card108EffectFrame19RUID,
		}
		local perFrame = self.Card108EffectFrameDuration
		local fx = self:SpawnEffectWithModel(frames[1], pos, 0, 0, self.Card108EffectScale * scaleRatio, 1, "skilleffectlong")
		if fx == nil then return end
		local r = fx.SpriteRendererComponent
		if r ~= nil then r.FlipX = dirRight end
		for step = 2, #frames do
			local frameRUID = frames[step]
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) and isvalid(r) then r.SpriteRUID = frameRUID end
			end, perFrame * (step - 1))
		end
		fx:Destroy(perFrame * #frames)
	end

	-- ── 실피드 전용: 플레시 봄버 (카드 120, 조합 스킬) — 플레시 미라주(Card108) Lv5 + 파이널
	-- 어택: 활(Card112) + 연속 사격(Card113, 둘 다 슬롯 없는 패시브) 보유 시 등장 — 새 슬롯이
	-- 필요없고 플레시 미라주의 슬롯을 그대로 넘겨받는다. 넉백/충돌 구조는 플레시 미라주와 동일하되
	-- (유저 지정: "나머지연출은 플래시 미라주랑 동일하게") 항상 좌우 양쪽(타겟 2명, 레벨 무관 고정 —
	-- 플레시 미라주의 Lv1 단일타겟 분기는 없음)이 동시에 발동하고, 연출 크기는 플레시 미라주(1.15)
	-- 대비 15% 더 확대(1.15×1.15≈1.32, 유저 지정: "크기만 15% 정도 키워줘"). 신규 메커니즘: 넉백
	-- 이동(Card108KnockbackDuration)이 끝나 멈춘 자리에서 새 폭발 연출(543e54a4..., 6프레임)이
	-- 재생되고 그 범위 안의 모든 몬스터에게 추가 대미지가 들어간다(유저 지정: "넉백된 유닛이 멈추면
	-- 이 타격 연출이 나오고 이 연출 범위에 있는적은 대미지가 들어감 — 타격 이펙트 범위 만큼"). 표의
	-- 두 퍼센트는 유저 확인으로 확정: 주타겟 자신은 기본 대미지 100% 그대로, "타격 유닛 X%"는 기존
	-- 충돌 대상 대미지 비율(이름만 바뀜), "넉백 유닛 주변 Y%"는 신규 폭발 대미지 비율 — 셋 다 독립.
	@Sync property integer FlashBomberLevel = 0
	property string Card120Name = "플레시 봄버"
	property string Card120IconRUID = "431246ee45104325abb416f08db32924"
	property number Card120Cooldown = 6.0  -- 레벨 무관 고정(유저 지정)
	property number Card120EffectScale = 1.32  -- 플레시 미라주(1.15) 대비 15% 추가 확대
	property string Card120ExplosionRUID = "543e54a49cfc4373981b01786a442d46"  -- 넉백 정지 시 재생할 신규 폭발 연출(6프레임)
	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 전용 리소스팩 번들 오디오(_audio/Use) 사용
	property string Card120SoundRUID = "af1b8a15d3a641cfa850f259f26c388c"

	method void PlayFlashBomberSound()
		_SoundService:PlaySound(self.Card120SoundRUID, 1.0)
	end
	-- 리소스 실측(최대 프레임 약 220×216px) 기준 원형 판정 반경 추정치(Lv1~2 기준) — 필요시 유저 확인 후 조정
	property number Card120ExplosionRadius = 1.1
	property number Card120ExplosionLifetime = 0.4
	property number Card120ExplosionYOffset = 0.3  -- 유저 요청으로 위로 살짝 띄움(순수 시각 오프셋, 판정엔 영향 없음)

	method number GetFlashBomberDamage(integer level)
		if level >= 3 then return 220
		elseif level >= 2 then return 200
		end
		return 180
	end

	-- "타격 유닛" 대미지 비율(=플레시 미라주의 충돌 대상 대미지 비율과 동일한 메커니즘, 이름만 변경)
	method number GetFlashBomberCollisionPercent(integer level)
		if level >= 3 then return 1.20
		elseif level >= 2 then return 1.00
		end
		return 0.80
	end

	-- "넉백 유닛 주변" 폭발 대미지 비율(신규 메커니즘)
	method number GetFlashBomberExplosionPercent(integer level)
		if level >= 3 then return 1.00
		elseif level >= 2 then return 0.60
		end
		return 0.50
	end

	-- 유저 요청: "레벨 3때는 한 15% 더 키워주고 범위도 그만큼" — Lv3만 폭발 연출 크기/판정 반경을
	-- 15% 확대(범위는 크기와 동일 비율로 늘려야 시각과 판정이 어긋나지 않는다).
	method number GetFlashBomberExplosionScale(integer level)
		if level >= 3 then return 1.15 end
		return 1.0
	end

	method number GetFlashBomberExplosionRadius(integer level)
		if level >= 3 then return self.Card120ExplosionRadius * 1.15 end
		return self.Card120ExplosionRadius
	end

	-- 플레시 미라주와 동일한 좌/우 극단 탐색이지만, 레벨 무관 항상 양쪽 동시 발동(유저 지정 표 —
	-- 모든 레벨에서 타겟 수 2).
	@ExecSpace("ServerOnly")
	method void FlashBomberAttack(number damage, boolean isCrit)
		self:PlayFlashBomberSound()
		local map = self:GetCurrentMap()
		if map == nil then return end
		local monsters = self:GetMonstersInCurrentZone(map)
		local centerX = self:GetZoneCenterX()

		local leftExtreme, rightExtreme = nil, nil
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local x = m.Entity.TransformComponent.Position.x
				if x < centerX and (leftExtreme == nil or x < leftExtreme.Entity.TransformComponent.Position.x) then
					leftExtreme = m
				elseif x > centerX and (rightExtreme == nil or x > rightExtreme.Entity.TransformComponent.Position.x) then
					rightExtreme = m
				end
			end
		end
		if leftExtreme == nil and rightExtreme == nil then return end

		local level = self.FlashBomberLevel
		local collisionPct = self:GetFlashBomberCollisionPercent(level)
		local explosionPct = self:GetFlashBomberExplosionPercent(level)

		if leftExtreme ~= nil then self:FireFlashBomberShove(map, monsters, leftExtreme, centerX, damage, isCrit, collisionPct, explosionPct, level) end
		if rightExtreme ~= nil then self:FireFlashBomberShove(map, monsters, rightExtreme, centerX, damage, isCrit, collisionPct, explosionPct, level) end
	end

	-- 플레시 미라주의 FireFleshMirageShove와 동일한 넉백/충돌 로직 + 넉백이 끝나는 시점(멈춘 자리)의
	-- 신규 폭발 대미지 예약.
	@ExecSpace("ServerOnly")
	method void FireFlashBomberShove(Entity map, table monsters, MonsterAI primary, number destX, number damage, boolean isCrit, number collisionPct, number explosionPct, integer level)
		if not isvalid(primary) or not isvalid(primary.Entity) or not isvalid(primary.Entity.TransformComponent) then return end
		destX = self:ClampKnockbackDestX(primary, destX)
		local primaryX = primary.Entity.TransformComponent.Position.x
		local dirRight = destX > primaryX
		local totalDist = math.abs(destX - primaryX)

		local pp = primary.Entity.TransformComponent.Position
		self:PlayFlashBomberEffect(Vector3(pp.x, pp.y + self.Card108EffectYOffset, pp.z), dirRight, self:GetEffectScaleRatio(primary))
		-- 폭발 연출은 넉백이 멈추는 자리(destX)에서 재생한다 — 넉백 도중 타겟이 죽어 파괴돼도(지연
		-- 사망) 항상 재생되도록 캐스트 시작 시점에 좌표를 미리 고정해둔다(다른 스킬과 동일한 정책).
		local stopPos = Vector3(destX, pp.y, pp.z)
		-- 버그 수정(2026-08-26, 유저 지적: "화면 넘어갔는데 이펙트가 다음 존에 존재, 실피드쪽이 많은거
		-- 같아") — 캐스트 시점 존 인덱스를 캡처해, 충돌 히트/착지 폭발 이펙트가 다른 존에 잘못 나타나지
		-- 않게 한다.
		local castZoneIndex = primary._spawnZoneIndex

		-- 버그 수정(2026-08-26, 유저 지적: "연출 끊기는거 같은데") — primary가 KnockbackStartDelay
		-- 도중 죽으면 이 블록 전체(폭발 연출 예약, 주변 다른 몬스터 충돌 히트 이펙트까지)가 통째로
		-- 스킵됐다. primary 관련 로직(넉백 이동)만 따로 생사 체크하고, 충돌 판정/폭발 예약은 primary
		-- 생사와 무관하게 항상 진행한다(stopPos/primaryX/dirRight/totalDist/destX는 이미 값으로
		-- 캡처돼 있어 primary가 죽거나 파괴돼도 안전). 각 충돌 대상(m)의 히트 이펙트도 데미지와
		-- 분리해서 항상 재생한다.
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end

			if isvalid(primary) and isvalid(primary.Entity) and not primary._dead then
				if isCrit then primary:TakeDamageDelayedDeath(damage * 2, true, self.Card108KnockbackDuration)
				else primary:TakeDamageDelayedDeath(damage, false, self.Card108KnockbackDuration) end
				primary:ApplyLateralShove(destX, self.Card108KnockbackDuration)
			end

			local collideCount = 0
			if totalDist > 0 then
				for _, mob in ipairs(monsters) do
					---@type MonsterAI
					local m = mob
					if isvalid(m) and m ~= primary and not m._dead and isvalid(m.Entity) and self:IsSameDepthBand(primary, m) then
						local mx = m.Entity.TransformComponent.Position.x
						local inPath = (dirRight and mx >= primaryX and mx <= destX)
							or ((not dirRight) and mx <= primaryX and mx >= destX)
						if inPath then
							collideCount = collideCount + 1
							local hitDelay = self.Card108KnockbackDuration * (math.abs(mx - primaryX) / totalDist)
							local collideDamage = damage * collisionPct
							_TimerService:SetTimerOnce(function()
								if not isvalid(m) or not isvalid(m.Entity) then return end
								if castZoneIndex == _MapManager.CurrentMapIndex then
									local hitPos = m.Entity.TransformComponent.Position
									local hitFx = self:SpawnEffect(self.Card108CollisionHitRUID, hitPos, 0, 1.0, self.Card108CollisionHitScale, 1)
									if hitFx ~= nil then hitFx:Destroy(self.HitEffectLifetime) end
								end
								if not m._dead then
									if isCrit then m:TakeDamageCrit(collideDamage * 2)
									else m:TakeDamage(collideDamage) end
								end
							end, hitDelay)
						end
					end
				end
			end

			-- 유저 지정: 넉백 이동이 끝나 멈춘 자리에서 신규 폭발 연출 + 범위 대미지 — primary 생사와
			-- 무관하게 항상 예약(ResolveFlashBomberExplosion 자체도 이미 "항상 재생" 정책으로 설계됨)
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				self:ResolveFlashBomberExplosion(map, primary, stopPos, damage, isCrit, explosionPct, level, castZoneIndex)
			end, self.Card108KnockbackDuration)

			log("FlashBomberShove: dmg=" .. math.floor(isCrit and damage * 2 or damage) .. " collide=" .. collideCount .. " dirRight=" .. tostring(dirRight))
		end, self.Card108KnockbackStartDelay)
	end

	-- 넉백된 유닛이 멈춘 자리(stopPos)에서 재생하는 신규 폭발 연출 + 범위 대미지(신규 메커니즘).
	-- 연출은 항상 재생하고(다른 스킬과 동일 정책), 판정도 stopPos 고정 좌표 기준(주타겟이 그 사이
	-- 죽어도 안전).
	@ExecSpace("ServerOnly")
	method void ResolveFlashBomberExplosion(Entity map, MonsterAI primary, Vector3 stopPos, number damage, boolean isCrit, number explosionPct, integer level, integer castZoneIndex)
		-- 유저 요청: "새 폭발 연출 위로 살짝만 더 올려줄래" — 판정 좌표(stopPos)에는 영향 없는
		-- 순수 시각 오프셋만 스폰 위치에 더한다.
		local fxPos = Vector3(stopPos.x, stopPos.y + self.Card120ExplosionYOffset, stopPos.z)
		-- 유저 요청: "레벨 3때는 한 15% 더 키워주고 범위도 그만큼" — 크기와 판정 반경을 동일 비율로 확대
		local explosionScale = self:GetFlashBomberExplosionScale(level)
		local explosionRadius = self:GetFlashBomberExplosionRadius(level)
		-- 버그 수정(2026-08-26, 유저 지적: "화면 넘어갔는데 이펙트가 다음 존에 존재") — 착지 폭발 연출도
		-- 캐스트 시점 존과 현재 존이 다르면 스폰하지 않는다(대미지 판정은 그대로 유지).
		if castZoneIndex == _MapManager.CurrentMapIndex then
			local fx = self:SpawnEffectWithModel(self.Card120ExplosionRUID, fxPos, 0, 1.0, explosionScale, 1, "skilleffectlong")
			if fx ~= nil then fx:Destroy(self.Card120ExplosionLifetime) end
		end

		local monsters = self:GetMonstersInCurrentZone(map)
		local explosionDamage = damage * explosionPct
		local hitCount = 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if isvalid(m) and not m._dead and isvalid(m.Entity) then
				local mp = m.Entity.TransformComponent.Position
				local dx = mp.x - stopPos.x
				local dy = mp.y - stopPos.y
				if (dx * dx + dy * dy) <= (explosionRadius * explosionRadius) and self:IsSameDepthBand(primary, m) then
					if isCrit then m:TakeDamageCrit(explosionDamage * 2)
					else m:TakeDamage(explosionDamage) end
					hitCount = hitCount + 1
				end
			end
		end
		log("FlashBomberExplosion: hit=" .. hitCount .. " dmg=" .. math.floor(isCrit and explosionDamage * 2 or explosionDamage))
	end

	-- 플레시 미라주의 PlayFleshMirageEffect와 동일 기법(20프레임 직접 이어붙이기), 크기만 Card120EffectScale
	@ExecSpace("ServerOnly")
	method void PlayFlashBomberEffect(Vector3 pos, boolean dirRight, number scaleRatio)
		local frames = {
			self.Card108EffectFrame0RUID, self.Card108EffectFrame1RUID, self.Card108EffectFrame2RUID,
			self.Card108EffectFrame3RUID, self.Card108EffectFrame4RUID, self.Card108EffectFrame5RUID,
			self.Card108EffectFrame6RUID, self.Card108EffectFrame7RUID, self.Card108EffectFrame8RUID,
			self.Card108EffectFrame9RUID, self.Card108EffectFrame10RUID, self.Card108EffectFrame11RUID,
			self.Card108EffectFrame12RUID, self.Card108EffectFrame13RUID, self.Card108EffectFrame14RUID,
			self.Card108EffectFrame15RUID, self.Card108EffectFrame16RUID, self.Card108EffectFrame17RUID,
			self.Card108EffectFrame18RUID, self.Card108EffectFrame19RUID,
		}
		local perFrame = self.Card108EffectFrameDuration
		local fx = self:SpawnEffectWithModel(frames[1], pos, 0, 0, self.Card120EffectScale * scaleRatio, 1, "skilleffectlong")
		if fx == nil then return end
		local r = fx.SpriteRendererComponent
		if r ~= nil then r.FlipX = dirRight end
		for step = 2, #frames do
			local frameRUID = frames[step]
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) and isvalid(r) then r.SpriteRUID = frameRUID end
			end, perFrame * (step - 1))
		end
		fx:Destroy(perFrame * #frames)
	end

	-- ── 실피드 전용 패시브 5종 (카드 109~113) — 아르카나의 매직 부스터(7)/매직 크리티컬(8)/매직
	-- 아머(18)/메디테이션(22)과 동일한 패턴(슬롯 없음, 해금 즉시 영구 적용, 레벨업 선택지 풀에서
	-- unlock→강화). 실피드 전용이라 GenerateLevelUpChoices의 isSylph 블록에서만 노출된다.
	@Sync property integer BowAccelerationLevel = 0
	property string Card109Name = "보우 액셀레이션"
	property string Card109IconRUID = "fb0c2c8bda7142b3955f1ca0bd4e6513"

	@Sync property integer PiercingWillLevel = 0
	property string Card110Name = "꿰뚫는 의지"
	property string Card110IconRUID = "5a78b6fc281449d08794e132030e258d"

	@Sync property integer CriticalShotLevel = 0
	property string Card111Name = "크리티컬 샷"
	property string Card111IconRUID = "872fb05eb1244d7f84c590e9dbcaf9d5"

	@Sync property integer FinalAttackBowLevel = 0
	property string Card112Name = "파이널 어택 : 활"
	property string Card112IconRUID = "39d6e65ad9cb45e5b068946eaae56192"

	@Sync property integer RapidFireLevel = 0
	property string Card113Name = "연속 사격"
	property string Card113IconRUID = "883decec81c74de3ae0b4301fd6b8add"

	-- 보우 액셀레이션 — 쿨타임 감소, Lv1:5%/Lv2:7%/Lv3:10%/Lv4:12%/Lv5:15% (매직 부스터와 동일 수치)
	-- SkillInventory 보우 액셀레이션(인덱스35) 레벨의 -2%/-4%/-6%가 카드 자체 레벨과 별개로 항상 가산된다.
	method number GetBowAccelerationReduction()
		local base = 0
		if self.BowAccelerationLevel >= 5 then base = 0.15
		elseif self.BowAccelerationLevel >= 4 then base = 0.12
		elseif self.BowAccelerationLevel >= 3 then base = 0.10
		elseif self.BowAccelerationLevel >= 2 then base = 0.07
		elseif self.BowAccelerationLevel >= 1 then base = 0.05
		end
		return base + self:GetSkillInvTierPercent(35, 0.02, 0.04, 0.06)
	end

	-- 꿰뚫는 의지 — 크리티컬 확률, Lv1:10%/Lv2:12%/Lv3:15%/Lv4:17%/Lv5:20% (매직 크리티컬과 동일 수치)
	-- SkillInventory 꿰뚫는 의지(인덱스36) 레벨의 +2%/+4%/+6%가 카드 자체 레벨과 별개로 항상 가산된다.
	method number GetPiercingWillChance()
		local base = 0
		if self.PiercingWillLevel >= 5 then base = 0.20
		elseif self.PiercingWillLevel >= 4 then base = 0.17
		elseif self.PiercingWillLevel >= 3 then base = 0.15
		elseif self.PiercingWillLevel >= 2 then base = 0.12
		elseif self.PiercingWillLevel >= 1 then base = 0.10
		end
		return base + self:GetSkillInvTierPercent(36, 0.02, 0.04, 0.06)
	end

	-- 크리티컬 샷 — 크리티컬 대미지 추가 배율, Lv1:10%/Lv2:20%/Lv3:30%/Lv4:40%/Lv5:50% 추가
	-- (기본 크리티컬 배율 ×2에 곱연산으로 더해짐 — MonsterAI:TakeDamageCrit/TakeDamageDelayedDeath에서 적용)
	-- SkillInventory 크리티컬 샷(인덱스37) 레벨의 +3%/+6%/+9%가 카드 자체 레벨과 별개로 항상 가산된다.
	method number GetCriticalShotBonus()
		local base = 0
		if self.CriticalShotLevel >= 5 then base = 0.50
		elseif self.CriticalShotLevel >= 4 then base = 0.40
		elseif self.CriticalShotLevel >= 3 then base = 0.30
		elseif self.CriticalShotLevel >= 2 then base = 0.20
		elseif self.CriticalShotLevel >= 1 then base = 0.10
		end
		return base + self:GetSkillInvTierPercent(37, 0.03, 0.06, 0.09)
	end

	-- 파이널 어택 : 활 — 기본 공격(애로우샷) 적중 시 확률로 추가 공격
	-- SkillInventory 파이널 어택:활(인덱스38) 레벨의 +3%/+6%/+9%가 카드 자체 레벨과 별개로 항상 가산된다.
	method number GetFinalAttackBowChance()
		local base = 0
		if self.FinalAttackBowLevel >= 5 then base = 0.30
		elseif self.FinalAttackBowLevel >= 4 then base = 0.25
		elseif self.FinalAttackBowLevel >= 3 then base = 0.20
		elseif self.FinalAttackBowLevel >= 2 then base = 0.15
		elseif self.FinalAttackBowLevel >= 1 then base = 0.10
		end
		return base + self:GetSkillInvTierPercent(38, 0.03, 0.06, 0.09)
	end

	method number GetFinalAttackBowMultiplier()
		if self.FinalAttackBowLevel >= 5 then return 1.80
		elseif self.FinalAttackBowLevel >= 4 then return 1.60
		elseif self.FinalAttackBowLevel >= 3 then return 1.40
		elseif self.FinalAttackBowLevel >= 2 then return 1.20
		end
		return 1.00
	end

	-- 연속 사격 — 실피드의 전 스킬 데미지 % 증가(메디테이션과 동일한 전역 적용 패턴), Lv1:5%/Lv2:8%/Lv3:12%/Lv4:16%/Lv5:20%
	method integer GetRapidFirePercent()
		if self.RapidFireLevel >= 5 then return 20
		elseif self.RapidFireLevel >= 4 then return 16
		elseif self.RapidFireLevel >= 3 then return 12
		elseif self.RapidFireLevel >= 2 then return 8
		elseif self.RapidFireLevel >= 1 then return 5
		end
		return 0
	end

	-- SkillInventory 연속 사격(인덱스39) 레벨의 +2%/+4%/+6%가 카드 자체 레벨과 별개로 항상 가산된다.
	method number GetRapidFireMult()
		return 1.0 + (self:GetRapidFirePercent() / 100.0) + self:GetSkillInvTierPercent(39, 0.02, 0.04, 0.06)
	end

	-- 파이널 어택 : 활 발동 판정 — 애로우샷(카드25) 적중 직후 호출. 원본 공격과 동일한 비주얼
	-- (FlyArrowShot)을 재사용하되 0.2초 지연을 둬서 두 발이 이어지는 느낌을 낸다.
	-- 카드 자체가 미해금(FinalAttackBowLevel=0)이어도 SkillInventory(인덱스38)만 Lv9에 도달하면
	-- GetFinalAttackBowChance()가 0보다 커지므로 발동할 수 있어야 한다(썬더볼트 스턴과 동일 패턴).
	@ExecSpace("ServerOnly")
	method void TryFinalAttackBow(MonsterAI target)
		if self.FinalAttackBowLevel <= 0 and self:GetSkillInvLevelByIndex(38) < 9 then return end
		if _UtilLogic:RandomDouble() >= self:GetFinalAttackBowChance() then return end
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
			local bonusDamage = self:GetCardDamage(25) * self:GetFinalAttackBowMultiplier()
			local bonusCrit = self:RollCrit(25)
			if bonusCrit then target:TakeDamageCrit(bonusDamage * 2)
			else target:TakeDamage(bonusDamage) end

			local p1 = target.Entity.TransformComponent.Position
			local hitPos = Vector3(p1.x, p1.y + 0.3, p1.z)
			local startPos = Vector3(hitPos.x, hitPos.y - 0.8, hitPos.z)
			local fx = self:SpawnEffect(self.ArrowShotEffectRUID, startPos, 270, 1.5, 2.5 * (self:GetEffectScaleRatio(target)), 0.9)
			self:FlyArrowShot(fx, startPos, hitPos)

			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				local scaleRatio = isvalid(target) and self:GetEffectScaleRatio(target) or 1.0
				local hitRUID = self:GetRandomArrowShotHitRUID()
				local hitFx = self:SpawnEffect(hitRUID, hitPos, 0, 1.0, self.ArrowShotHitScale * scaleRatio, 1)
				if hitFx ~= nil then hitFx:Destroy(self.HitEffectLifetime) end
			end, 0.16)

			log("FinalAttackBow triggered: dmg=" .. math.floor(bonusCrit and bonusDamage * 2 or bonusDamage))
		end, 0.2)
	end

	-- ── 아쿠아 서지 (Card 24) — 아쿠아 트랩(Card14) Lv5 + 메디테이션(Card22, 슬롯 없는 패시브) 보유 시
	-- 등장하는 조합 스킬. 메디테이션은 슬롯이 없어 아쿠아 트랩의 슬롯만 그대로 넘겨받는다(단일 슬롯
	-- 조합 패턴). Lv1~3까지만 존재. 속박 자체는 레벨 무관 고정 3초. 속박이 끝나기 0.2초 전에 추가
	-- 대미지 1회(레벨별 비율 50%/60%/70%)가 들어가고, 그 0.2초 전에 별도 타격 연출(Card24ExtraEffectRUID)이
	-- 먼저 재생된다. 구속 연출은 rootDuration까지가 아니라 추가타가 들어가는 시점(extraDamageDelay)까지만
	-- 재생하고 그 직전에 페이드아웃한다(그 이후 더 도는 건 불필요 — 추가타가 사실상 마무리 연출 역할).
	-- 구속 연출 자체도 아쿠아 트랩과 다른 전용 RUID(Card24EffectRUID)를 쓴다(아쿠아 트랩 본체 연출에는
	-- 영향 없음).
	@Sync property integer AquaSurgeLevel = 0
	property string Card24Name = "아쿠아 서지"
	property string Card24IconRUID = "2d8b918707fa41aa975671510f50a258"
	property string Card24EffectRUID = "394e093ee86b4ad4acdfa52eb2e43d88"  -- 구속 연출(아쿠아 서지 전용)
	-- 유저 지정: 사운드 없는 스킬 전수조사 후 일괄 보강 — 전용 리소스팩 번들 오디오(_audio/Hit) 사용
	property string Card24SoundRUID = "332529e16d71440789fd4feb18237155"

	method void PlayAquaSurgeSound()
		_SoundService:PlaySound(self.Card24SoundRUID, 1.0)
	end
	property string Card24ExtraEffectRUID = "e1e6ebd278b7446fbc05006701fec2e6"  -- 추가 대미지 타격 연출
	property number Card24Cooldown = 4.0  -- 레벨 무관 고정
	property number Card24RootDuration = 3.0  -- 레벨 무관 고정
	property number Card24ExtraDamageLeadTime = 0.2  -- 속박이 끝나기 이 시간 전에 추가 대미지 적용(0.5→0.2, 타이밍을 뒤로 밀어서 착탄이 더 늦게)
	property number Card24ExtraEffectLeadTime = 0.2  -- 추가 대미지 적용 이 시간 전에 타격 연출 재생
	property number Card24ExtraEffectLifetime = 0.3  -- 추가 대미지 연출 자체 수명(0.5초는 루프가 한 번 더 도는 것처럼 보여서 줄임)
	property number Card24EffectFadeOutDuration = 0.4  -- 구속 연출이 끝나기 이 시간 전부터 알파를 0으로 서서히 낮춰 자연스럽게 사라지게 한다
	property number Card24EffectScale = 0.8  -- 몬스터가 맨 앞까지 접근했을 때 연출이 너무 커 보여서 20% 축소

	method number GetAquaSurgeDamage()
		if self.AquaSurgeLevel >= 3 then return 280
		elseif self.AquaSurgeLevel >= 2 then return 240
		end
		return 200
	end

	method integer GetAquaSurgeTargetCount()
		if self.AquaSurgeLevel >= 3 then return 6
		elseif self.AquaSurgeLevel >= 2 then return 5
		end
		return 4
	end

	method number GetAquaSurgeExtraPercent()
		if self.AquaSurgeLevel >= 3 then return 0.70
		elseif self.AquaSurgeLevel >= 2 then return 0.60
		end
		return 0.50
	end

	@ExecSpace("ServerOnly")
	method void AquaSurgeAttack(number damage, boolean isCrit)
		self:PlayAquaSurgeSound()
		local targetCount = self:GetAquaSurgeTargetCount()
		local rootDuration = self.Card24RootDuration
		local extraPercent = self:GetAquaSurgeExtraPercent()
		local targets = self:GetClosestTargets(targetCount)
		local hitCount = 0
		for _, target in ipairs(targets) do
			target:ApplyStun(rootDuration, false)
			target:ApplyLevitate(rootDuration)
			local liftDelay = math.min(0.25, rootDuration * 0.3)

			-- 속박이 끝나기 Card24ExtraDamageLeadTime 전에 추가 대미지 1회, 그보다
			-- Card24ExtraEffectLeadTime만큼 먼저 타격 연출을 재생한다. 구속 연출은
			-- rootDuration까지가 아니라 extraDamageDelay(추가타 시점)까지만 재생하고 그 직전에
			-- 페이드아웃한다 — 추가타가 마무리 연출 역할을 하므로 그 이후엔 구속 연출이 필요 없다.
			local extraDamageDelay = math.max(0, rootDuration - self.Card24ExtraDamageLeadTime)
			local extraEffectDelay = math.max(0, extraDamageDelay - self.Card24ExtraEffectLeadTime)
			-- 최초 데미지를 liftDelay만큼 늦춰서 구속 연출이 먼저 뜨게 한다 — 원래는 데미지를
			-- 즉시(t=0) 적용했는데, 그 데미지로 대상이 즉사(1방 킬)하면 liftDelay 뒤 콜백의
			-- target._dead 체크에 걸려 구속 연출 자체가 아예 안 뜨는 문제가 있었다(연출 엔티티는
			-- 대상과 무관하게 독립적으로 스폰되므로, 스폰만 데미지보다 먼저 시켜두면 대상이 그
			-- 직후 죽어도 이미 뜬 연출은 자기 타이머대로 정상 재생/페이드아웃된다).
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
				local fxScale = (self:GetEffectScaleRatio(target)) * self.Card24EffectScale
				self:PlayAquaSurgeEffect(target, extraDamageDelay - liftDelay, fxScale)
				if isCrit then target:TakeDamageCrit(damage * 2)
				else target:TakeDamage(damage) end
			end, liftDelay)
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
				local p = target.Entity.TransformComponent.Position
				local fx = self:SpawnEffect(self.Card24ExtraEffectRUID, p, 0, 1, 1, 1)
				if fx ~= nil then fx:Destroy(self.Card24ExtraEffectLifetime) end
			end, extraEffectDelay)
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
				local extraDmg = damage * extraPercent
				if isCrit then target:TakeDamageCrit(extraDmg * 2)
				else target:TakeDamage(extraDmg) end
				log("AquaSurgeAttack: extra dmg=" .. math.floor(isCrit and extraDmg * 2 or extraDmg))
			end, extraDamageDelay)

			hitCount = hitCount + 1
		end
		log("AquaSurgeAttack: hit=" .. hitCount .. "/" .. targetCount .. " dmg=" .. math.floor(isCrit and damage * 2 or damage) .. " root=" .. rootDuration)
	end

	-- PlayAquaTrapEffect와 동일한 구조지만 아쿠아 서지 전용 RUID(Card24EffectRUID)를 쓴다(아쿠아
	-- 트랩 본체의 Card14EffectRUID/PlayAquaTrapEffect에는 전혀 영향 없음). duration 전체를 한 번에
	-- 재생하고 끝나기 Card24EffectFadeOutDuration 전부터 알파를 서서히 0으로 낮춰 자연스럽게
	-- 사라지게 한다(기존엔 짧은 세그먼트를 반복 이어붙이는 방식이었는데, 세그먼트 경계에서 다시
	-- 시작하는 것처럼 보이거나, 타이머 드리프트/다른 스킬의 재스턴으로 예상보다 일찍 끊기는 등
	-- 여러 버그가 반복돼서 유저 요청으로 단순한 "전체 재생 + 페이드아웃" 방식으로 교체했다).
	@ExecSpace("ServerOnly")
	method void PlayAquaSurgeEffect(MonsterAI target, number duration, number fxScale)
		if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
		if self:GetCurrentMap() == nil or target._spawnZoneIndex ~= _MapManager.CurrentMapIndex then return end
		if duration <= 0 then return end
		local p = target.Entity.TransformComponent.Position
		local fx = self:SpawnEffectWithModel(self.Card24EffectRUID, p, 0, 1, fxScale, 1, "skilleffectlong")
		if fx == nil then return end
		fx:Destroy(duration)
		local renderer = fx.SpriteRendererComponent
		if renderer == nil then return end
		local fadeDuration = math.min(self.Card24EffectFadeOutDuration, duration)
		local fadeDelay = duration - fadeDuration
		_TimerService:SetTimerOnce(function()
			if not isvalid(fx) or not isvalid(renderer) then return end
			_TweenLogic:PlayTween(1.0, 0.0, fadeDuration, EaseType.Linear, function(alpha)
				if isvalid(renderer) then renderer:SetAlpha(alpha) end
			end)
		end, fadeDelay)
	end

	-- 헤일 스톤 (Card 15) — 범위 빙결 스킬. 지상 우선(GetGroundPriorityTargets) 순으로 여러 명을 골라
	-- 데미지 + MonsterAI:AddFreezeStack(기존 콜드빔/프리징 이펙트와 동일한 빙결 스택 시스템 —
	-- 슬로우/스택 인디케이터는 그 쪽에서 이미 다 처리해준다)으로 얼린다.
	-- Lv1(해금): 120뎀·1명 타겟·빙결스택1(레벨 무관 항상 적용) / Lv2: 타겟+1(2명) / Lv3: 데미지+50(170) /
	-- Lv4: 쿨타임 -10% / Lv5: 타겟+1(3명)
	-- 타겟마다 그 위치 바로 위 세로 통로(Card15PathWidth×Card15PathHeight) 안에 있는 다른 몬스터는
	-- 같은 전체 데미지를 추가로 받는다(빙결 스택은 원래 타겟에게만 적용).
	@Sync property integer HailStoneLevel = 0
