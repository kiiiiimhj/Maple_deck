		if cardIdx == 178 then return self.ShadowPartnerLevel > 0 end
		if cardIdx == 179 then return self.DarkFlareLevel > 0 end
		if cardIdx == 180 then return self.DaggerAccelLevel > 0 end
		if cardIdx == 181 then return self.CriticalEdgeLevel > 0 end
		if cardIdx == 182 then return self.KarmaLevel > 0 end
		if cardIdx == 183 then return self.PhysicalTrainingLevel > 0 end
