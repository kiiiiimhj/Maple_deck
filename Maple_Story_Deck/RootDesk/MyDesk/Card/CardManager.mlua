		-- 킹페페 (슬롯 해금 또는 레벨 강화)
		if cardIdx == 12 then
			if upgradeType == "unlock" then
				self.KingPepeLevel = 1
				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 12)
