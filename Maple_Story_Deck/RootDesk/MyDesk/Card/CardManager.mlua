	-- 프리징 이펙트 (Card 10) — 패시브. 아이스 계열(콜드빔/아이스커터/헤일스톤)이 빙결 스택 대상을 때리면
	-- 스택당 데미지 보너스(GetIceStackBonus), 썬더계열(썬더볼트/에너지볼트)이 빙결된 대상을 때리면
	-- 연쇄 번개(ApplyChainLightning)가 발동하는 아이스+썬더 콤보 카드.
	-- Lv1(해금): 아이스 스킬 스택당 +5% 데미지 / Lv2: +6%로 상승 / Lv3: 연쇄 번개 1마리(50%) /
	-- Lv4: 연쇄 2마리(50%,35%) / Lv5: 연쇄 3마리(50%,35%,15%) + 5스택 도달 시 썬더계열 적중으로 빙결폭발(AOE 80%, 스택초기화)
	@Sync property integer FreezingEffectLevel = 0
	property string Card10Name = "프리징 이펙트"
	property string Card10IconRUID = "719213847fdf4b50a109a263e784f0c0"

	-- 매직 아머 (Card 18) — 패시브. 해금 즉시 영구 적용(GetMagicArmorReduction 참고, 만료 없음).
	-- 몬스터에게 받는 대미지를 % 감소(GameManager.OnMonsterReached에서 적용) — Lv1:5%/Lv2:7%/Lv3:10%/Lv4:12%/Lv5:15%
	@Sync property integer MagicArmorLevel = 0
	property string Card18Name = "매직 아머"
	property string Card18IconRUID = "cb8ff28174224d93991f6a4e936d8de9"

	-- 메디테이션 (Card 22) — 패시브. 해금 즉시 영구 적용(GetMeditationMult 참고, 만료 없음).
	-- 모든 스킬 데미지를 % 증가(GetCardDamage에서 공통 적용) — Lv1:3%/Lv2:6%/Lv3:9%/Lv4:12%/Lv5:15%
	@Sync property integer MeditationLevel = 0
	property string Card22Name = "메디테이션"
	property string Card22IconRUID = "62bfbcf2b16442ce826c0fbc9f16fbb4"

	-- 표시용 정수 퍼센트(3/6/9/12/15) — GetMeditationMult()이 반환하는 1.15 같은 소수값에서
	-- (mult-1.0)*100으로 역산하면 부동소수점 오차로 14가 나올 수 있어(1.15-1.0=0.14999...99),
	-- 툴팁 등 화면 표시는 항상 이 함수를 써야 한다.
	method integer GetMeditationPercent()
		local base = 0
		if self.MeditationLevel >= 5 then base = 15
		elseif self.MeditationLevel >= 4 then base = 12
		elseif self.MeditationLevel >= 3 then base = 9
		elseif self.MeditationLevel >= 2 then base = 6
		elseif self.MeditationLevel >= 1 then base = 3
		end
		return base + self:GetSkillInvMeditationBonusPercent()
	end

	-- SkillInventory 메디테이션(인덱스10, 최대레벨 9 예외)의 +2%/+4%/+6% — Lv3/6/9에서만 상승하고
	-- 카드 자체 MeditationLevel과 별개로 항상 가산된다
	@ExecSpace("ServerOnly")
	method integer GetSkillInvMeditationBonusPercent()
		local lv = self:GetSkillInvLevelByIndex(10)
		if lv >= 9 then return 6
		elseif lv >= 6 then return 4
		elseif lv >= 3 then return 2
		end
		return 0
	end

	method number GetMeditationMult()
		return 1.0 + (self:GetMeditationPercent() / 100.0)
	end

	-- ── 헤일 버스트 (Card 23) — 헤일 스톤(Card15) Lv5 + 프리징 이펙트(Card10) + 메디테이션(Card22)
	-- 보유 시 등장하는 조합 스킬. 프리징 이펙트/메디테이션은 슬롯 없는 패시브라 헤일 스톤의 슬롯만
	-- 그대로 넘겨받는다(단일 슬롯 조합 패턴). Lv1~3까지만 존재.
	-- 타겟마다(GetGroundPriorityTargets 재사용) 헤일 스톤과 동일한 낙하 연출을 띄우고 착탄 시점에
	-- 전체 데미지 + 빙결 스택을 원래 타겟에게 적용, 그 주변 "바닥 범위기"(Card23SplashRadius) 안의
	-- 다른 몬스터에게는 레벨별 비율(60%/70%/80%) 데미지만 추가로 적용한다(빙결 스택 없음).
	-- 연출은 얼음 낙하(Card15EffectRUID 재사용) 재생 중, 그 연출이 끝나기 0.2초 전에 같은 위치에서
	-- 엘리멘탈 어뎁팅 버스트 연출(Card23BurstRUID)이 이어서 재생된다.
	@Sync property integer HailBurstLevel = 0
	property string Card23Name = "헤일 버스트"
	property string Card23IconRUID = "412638a16dc643f595b035ba776ef425"
	property string Card23BurstRUID = "afafe6bec400475691dc856fc0f4a66b"  -- 엘리멘탈 어뎁팅(썬,콜) 팩의 "effect0"(콜드 계열 버스트)
	property number Card23Cooldown = 4.5  -- 레벨 무관 고정
	property number Card23ImpactDelay = 0.8  -- 헤일 스톤과 동일한 "연출 먼저, 착탄 시 데미지" 타이밍(기존 0.3에서 +0.5 늦춤)
	property number Card23EffectLifetime = 0.72  -- 얼음 낙하 연출 수명(헤일 스톤과 동일하게 조정)
	property number Card23BurstLeadTime = 0.35  -- 얼음 연출이 끝나기 이 시간 전에 버스트 연출을 이어붙임(=스폰 후 0.3초 시점)
	property number Card23BurstLifetime = 1.2  -- 버스트 연출 자체 수명(루프 1회를 다 보여주기 위해 늘림)
	property number Card23BurstYOffset = -0.1  -- 버스트 연출만 살짝 아래로(얼음 낙하 연출에는 영향 없음)
	property number Card23SplashRadius = 1.5  -- 바닥 범위기 반경 — 추정치, 어색하면 조정

	method number GetHailBurstDamage()
		if self.HailBurstLevel >= 3 then return 300
		elseif self.HailBurstLevel >= 2 then return 250
		end
		return 200
	end

	method integer GetHailBurstTargetCount()
		if self.HailBurstLevel >= 3 then return 4 end
		return 3
	end

	method number GetHailBurstSplashPercent()
		if self.HailBurstLevel >= 3 then return 0.80
		elseif self.HailBurstLevel >= 2 then return 0.70
		end
		return 0.60
	end

	@ExecSpace("ServerOnly")
	method void HailBurstAttack(number damage, boolean isCrit)
		local targetCount = self:GetHailBurstTargetCount()
		local targets = self:GetGroundPriorityTargets(targetCount)
		local map = self:GetCurrentMap()
		local splashPercent = self:GetHailBurstSplashPercent()
		local hitCount = 0
		for _, target in ipairs(targets) do
			local p = target.Entity.TransformComponent.Position
			-- 연출 크기는 "지금 스케일/도달 임계값" 비율로 정규화한다 — 원래 고정 상수들은 몬스터가
			-- 화면 맨 앞(도달 임계값)까지 왔을 때 기준으로 맞춰져 있었는데, 여기에 원시 _currentScale
			-- (최대 1.5까지)을 그대로 곱하면 맨 앞에서 오히려 원래보다 더 커져버리는 문제가 있었다
			-- (유저 피드백: "원래 바꾸기 전이 가장 커졌을 때"). 비율로 나누면 맨 앞에서 정확히 1.0(원래
			-- 크기)이 되고, 멀리 있을 때만 그보다 작아진다.
			local hbScale = self:GetEffectScaleRatio(target)
			local fxIce = self:SpawnEffectWithModel(self.Card15EffectRUID, Vector3(p.x, p.y + self.Card15EffectYOffset, p.z), 0, self.Card15EffectPlayRate, self.Card15EffectScale * hbScale, 1, "skilleffectlong")
			if fxIce ~= nil then fxIce:Destroy(self.Card23EffectLifetime) end
			hitCount = hitCount + 1

			-- 얼음 연출이 끝나기 Card23BurstLeadTime 전에 같은 위치에서 버스트 연출을 이어붙인다.
			-- Card23BurstLifetime(1.2초)이 공용 "skilleffect" 모델의 내부 기본 Duration(0.8초)보다
			-- 길어서 반드시 "skilleffectlong"(2.5초)으로 스폰해야 한다(안 그러면 모델 쪽 타이머가
			-- 먼저 파괴해서 지정한 수명이 무시됨).
			local burstDelay = math.max(0, self.Card23EffectLifetime - self.Card23BurstLeadTime)
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				local fxBurst = self:SpawnEffectWithModel(self.Card23BurstRUID, Vector3(p.x, p.y + self.Card15EffectYOffset + self.Card23BurstYOffset, p.z), 0, 1, hbScale, 1, "skilleffectlong")
				if fxBurst ~= nil then fxBurst:Destroy(self.Card23BurstLifetime) end
			end, burstDelay)

			_TimerService:SetTimerOnce(function()
				if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
				local finalDmg = damage * self:GetIceStackBonus(target)
				if isCrit then target:TakeDamageCrit(finalDmg * 2)
				else target:TakeDamage(finalDmg) end
				target:AddFreezeStack()
				-- SkillInventory 헤일버스트(인덱스19) Lv9: 10% 확률로 빙결스택 +3 추가, 카드 자체 레벨과 별개
				if self:GetSkillInvLevel(23) >= 9 and _UtilLogic:RandomDouble() < 0.10 then
					target:AddFreezeStack()
					target:AddFreezeStack()
					target:AddFreezeStack()
				end

				-- 바닥 범위기: 착탄 위치(p) 반경 안의 다른 몬스터는 레벨별 비율만큼 추가 데미지(빙결 스택 없음)
				local splashHitCount = 0
				if map ~= nil then
					local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
					for _, mob in ipairs(monsters) do
						---@type MonsterAI
						local m = mob
						if not m._dead and m ~= target then
							local isPrimary = false
							for _, t2 in ipairs(targets) do
								if m == t2 then isPrimary = true break end
							end
							if not isPrimary then
								local mp = m.Entity.TransformComponent.Position
								local dx = mp.x - p.x
								local dy = mp.y - p.y
								local inSplash = (dx * dx + dy * dy) <= (self.Card23SplashRadius * self.Card23SplashRadius)
								if inSplash and self:IsSameDepthBand(target, m) then
									local splashDmg = damage * splashPercent * self:GetIceStackBonus(m)
									if isCrit then m:TakeDamageCrit(splashDmg * 2)
									else m:TakeDamage(splashDmg) end
									splashHitCount = splashHitCount + 1
								end
							end
						end
					end
				end
				log("HailBurstAttack: impact dmg=" .. math.floor(isCrit and finalDmg * 2 or finalDmg) .. " splash=" .. splashHitCount)
			end, self.Card23ImpactDelay)
		end
		log("HailBurstAttack: cast hit=" .. hitCount .. "/" .. targetCount)
	end

	-- 아이스 커터 (Card 11) — 레벨업으로 해금/강화하는 광역 스킬. 판정 반경은 전 레벨 고정(0.96,
	-- 더 이상 레벨별로 커지지 않음). 대신 "타겟 수"만큼 서로 다른 몬스터를 각각 조준해서
	-- 그 위치마다 반경 판정 광역 공격을 낸다(썬더 커터의 다중 조준과 동일한 방식, FindNextThunderTarget 재사용).
	-- Lv1(해금): 데미지110·타겟1명 / Lv2: 출혈(최대체력 3%, 1초당1틱, 3초) / Lv3: 타겟+1(2명) /
	-- Lv4: 데미지+50(160) / Lv5: 출혈 5%로 증가
	@Sync property integer IceCutterLevel = 0
	property number Card11Damage = 110
	property string Card11Name = "아이스 커터"
	property string Card11IconRUID = "d30a5f73b62f48619ed6c5031a5a95d6"
	property string Card11EffectRUID = "37b23bb1579e441b89e1f04e5e8afc64"
	property number Card11EffectYOffset = 0.4  -- 연출이 발밑에 깔리지 않도록 위로 띄우는 보정값(판정 반경 중심은 그대로 몬스터 위치 기준)
	property number Card11Cooldown = 4.0  -- 메테오(5.0)보다 조금 빠르게

	-- 킹페페 (Card 12) — 타겟을 따라가지 않는 "고정 위치" 광역 스킬. 펭귄이 고정 위치에 서서 자기 주변
	-- 반경(Card12HitRadius) 안의 몬스터를 전부 공격한다(지상/공중 구분 없음). Lv1~2는 좌펭귄(RUID_A)만,
	-- Lv3부터 우펭귄(RUID_B, 시각상 좌측 위치)도 같이 나간다.
	-- Lv1(해금): 데미지300·쿨타임7.0 / Lv2: 쿨타임 -10%(×0.9) / Lv3: 우펭귄(시각상 좌측) 공격범위 추가 /
	-- Lv4: 데미지+70(370) / Lv5: 쿨타임 추가 -10%(곱연산, ×0.9) + 2연속 공격(Card12RepeatChance 확률로 발동,
	-- Card12RepeatDelay 뒤에 재실행) 시작 (2타는 1타의 50% 데미지만 적용)
	@Sync property integer KingPepeLevel = 0
	property number Card12BaseDamage = 300
	property string Card12Name = "페페"
	property string Card12IconRUID = "6c4a2b6ea3904907bdfead6276ef1cff"
	property string Card12EffectRUID_A = "d1c805af5c4d442fa42dde6dda7f07dd"  -- 좌하단 펭귄
	property string Card12EffectRUID_B = "b270754c54db4bae9bfdb0c25665e59e"  -- 우하단 펭귄
	property number Card12BaseCooldown = 7.0
	property number Card12RepeatChance = 0.25  -- Lv5부터: 2연속 공격이 발동할 확률(원래 100% 확정이었음)
	property number Card12RepeatDelay = 0.5  -- Lv5부터: 한 번 발동에 이 간격을 두고 2연속 공격
	property number Card12HitDelay = 0.3  -- 연출 시작 후 이 시간 뒤에 실제 대미지 적용(타격 타이밍 싱크)
	-- 좌/우 펭귄 연출의 X좌표 = 존 중심(centerX) + 이 값. 부호 헷갈림 방지를 위해 좌/우를 완전히 분리했다 —
	-- 둘 다 값이 커질수록 오른쪽, 작아질수록(더 음수) 왼쪽으로 이동한다(공용 오프셋+부호반전 방식 아님).
	property number Card12LeftX = 2.8   -- 좌펭귄(RUID_A) X좌표 오프셋 — 보통 음수
	property number Card12RightX = -2.8   -- 우펭귄(RUID_B) X좌표 오프셋 — 좌펭귄(3.0)과 중심 기준 대칭
	property number Card12RightYOffset = -0.3  -- 우펭귄(RUID_B, 페페 Lv3부터)만 아래로 보정(좌펭귄에는 영향 없음, 킹페페 연출에도 동일 적용)
	property number Card12FixedGroundY = -0.5  -- 펭귄 연출이 뜨는 고정 Y
	property number Card12EffectScale = 1.49  -- 연출 시각 크기(1.75에서 15% 축소)
	property number Card12HitRadius = 1.8  -- 펭귄 연출 판정 반경 — 이펙트 스케일에 맞춰 튜닝(아이스 커터와 동일한 방식)

	-- 썬더 커터 (Card 13) — 레벨업으로 해금/강화하는 광역 스킬. 시전 시점 primaryTarget 위치를 중심으로
	-- 고정 반경 안의 몬스터를 전부 타격한다(아이스 커터와 동일한 위치 판정 방식, 반경은 레벨과 무관하게 고정).
	-- Lv1(해금): 데미지100·1타 / Lv2: 타겟+1(2타) / Lv3: 넉백 추가(맨 뒤로 밀려남)·데미지+50(150) /
	-- Lv4: 타겟+1(3타) / Lv5: 데미지+50(200). 보스/엘리트는 넉백 효율 50% 감소(밀려날 거리 절반).
	@Sync property integer ThunderCutterLevel = 0
