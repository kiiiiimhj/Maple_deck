	property number Card101BowGlowDuration = 0.3  -- 1) 재생 시간(추정치 — 라이브에서 실제 애니메이션 길이 보고 조정)
	property string Card101BowEffectRUID = "b00ac0d7b06d4489b91b15be39f51edc"  -- 2) 활 쏘는 연출
	property number Card101BowShootDuration = 0.2  -- 2) 재생 시간(추정치) — 이 시간 뒤 화살 발사 + 연출 제거
	-- y=3.0으로 처음 잡았다가 화면(카메라) 밖으로 나가 안 보이는 걸 실측 확인 — 이후 라이브로 직접
	-- 보면서 유저가 "경험치바 아래쯤"으로 지정(화면 상단 HUD 바로 아래)해 다시 올렸다.
	property Vector3 Card101BowPosition = Vector3(0, 2.2, -0.1)
	-- -90도로 돌렸다가 유저 요청으로 180도 더 돌림(-90+180=90) — 생성 연출/활 쏘는 연출 둘 다 공용.
	property number Card101BowRotation = 90
	-- 유저 요청: 기존 대비 1.5배
	property number Card101BowScale = 1.5
	-- 유저 제안: 같은 연출을 이 장수만큼 같은 자리에 겹쳐 스폰해서 반투명을 진하게 보이게 한다
	property integer Card101LayerCount = 3
	property string Card101ArrowEffectRUID = "bb23a0b49290475d952e0139c392584b"  -- 발사 원점→타겟까지 실제로 날아가는 화살
	property number Card101ArrowFlightDuration = 0.4  -- 발사 원점→타겟 비행 시간
	-- 여러 타겟일 때 화살을 동시발사가 아니라 순서대로 줄줄이 발사한다(유저 요청)
	property number Card101ArrowStaggerDelay = 0.1
	-- 착탄 연출 — 기존 hit/2~5 무작위 세트는 애로우샷(기본공격) 쪽으로 옮기고, 바람의 시는 전용
	-- 단일 연출로 교체(유저 요청). 애니메이션클립이 모델(skilleffect) Duration보다 빨리 한 바퀴 돌면
	-- 다시 처음부터 재생되는 게 보여서(유저 실측: "여러번 재생되는거 같은데"), 1루프만 재생하고
	-- 정지시킨다(SpriteAnimPlayerEndEvent).
	property string Card101HitRUID = "35b6faa10c5c4e068dedfd14b355bcf0"

	-- 레벨별 고정 데미지 — Lv1-2:90 / Lv3-4:130 / Lv5:170
	method number GetWindPoemDamage()
		if self.WindPoemLevel >= 5 then return 170
		elseif self.WindPoemLevel >= 3 then return 130
		end
		return 90
	end

	-- 레벨별 타겟 수 — Lv1-2:1명 / Lv3-4:2명 / Lv5:3명
	method integer GetWindPoemTargetCount()
		if self.WindPoemLevel >= 5 then return 3
		elseif self.WindPoemLevel >= 3 then return 2
		end
		return 1
	end

	-- ── 아쿠아 서지 (Card 24) — 아쿠아 트랩(Card14) Lv5 + 메디테이션(Card22, 슬롯 없는 패시브) 보유 시
	-- 등장하는 조합 스킬. 메디테이션은 슬롯이 없어 아쿠아 트랩의 슬롯만 그대로 넘겨받는다(단일 슬롯
	-- 조합 패턴). Lv1~3까지만 존재. 속박 자체는 레벨 무관 고정 3초. 속박이 끝나기 0.2초 전에 추가
	-- 대미지 1회(레벨별 비율 50%/60%/70%)가 들어가고, 그 0.2초 전에 별도 타격 연출(Card24ExtraEffectRUID)이
	-- 먼저 재생된다. 구속 연출은 rootDuration까지가 아니라 추가타가 들어가는 시점(extraDamageDelay)까지만
	-- 재생하고 그 직전에 페이드아웃한다(그 이후 더 도는 건 불필요 — 추가타가 사실상 마무리 연출 역할).
	-- 구속 연출 자체도 아쿠아 트랩과 다른 전용 RUID(Card24EffectRUID)를 쓴다(아쿠아 트랩 본체 연출에는
	-- 영향 없음).
	@Sync property integer AquaSurgeLevel = 0
	property string Card24Name = "아쿠아 서지"
	property string Card24IconRUID = "2d8b918707fa41aa975671510f50a258"
	property string Card24EffectRUID = "394e093ee86b4ad4acdfa52eb2e43d88"  -- 구속 연출(아쿠아 서지 전용)
	property string Card24ExtraEffectRUID = "e1e6ebd278b7446fbc05006701fec2e6"  -- 추가 대미지 타격 연출
	property number Card24Cooldown = 4.0  -- 레벨 무관 고정
	property number Card24RootDuration = 3.0  -- 레벨 무관 고정
	property number Card24ExtraDamageLeadTime = 0.2  -- 속박이 끝나기 이 시간 전에 추가 대미지 적용(0.5→0.2, 타이밍을 뒤로 밀어서 착탄이 더 늦게)
	property number Card24ExtraEffectLeadTime = 0.2  -- 추가 대미지 적용 이 시간 전에 타격 연출 재생
	property number Card24ExtraEffectLifetime = 0.3  -- 추가 대미지 연출 자체 수명(0.5초는 루프가 한 번 더 도는 것처럼 보여서 줄임)
	property number Card24EffectFadeOutDuration = 0.4  -- 구속 연출이 끝나기 이 시간 전부터 알파를 0으로 서서히 낮춰 자연스럽게 사라지게 한다
	property number Card24EffectScale = 0.8  -- 몬스터가 맨 앞까지 접근했을 때 연출이 너무 커 보여서 20% 축소

	method number GetAquaSurgeDamage()
		if self.AquaSurgeLevel >= 3 then return 280
		elseif self.AquaSurgeLevel >= 2 then return 240
		end
		return 200
	end

	method integer GetAquaSurgeTargetCount()
		if self.AquaSurgeLevel >= 3 then return 6
		elseif self.AquaSurgeLevel >= 2 then return 5
		end
		return 4
	end

	method number GetAquaSurgeExtraPercent()
		if self.AquaSurgeLevel >= 3 then return 0.70
		elseif self.AquaSurgeLevel >= 2 then return 0.60
		end
		return 0.50
	end

	@ExecSpace("ServerOnly")
	method void AquaSurgeAttack(number damage, boolean isCrit)
		local targetCount = self:GetAquaSurgeTargetCount()
		local rootDuration = self.Card24RootDuration
		local extraPercent = self:GetAquaSurgeExtraPercent()
		local targets = self:GetClosestTargets(targetCount)
		local hitCount = 0
		for _, target in ipairs(targets) do
			target:ApplyStun(rootDuration, false)
			target:ApplyLevitate(rootDuration)
			local liftDelay = math.min(0.25, rootDuration * 0.3)

			-- 속박이 끝나기 Card24ExtraDamageLeadTime 전에 추가 대미지 1회, 그보다
			-- Card24ExtraEffectLeadTime만큼 먼저 타격 연출을 재생한다. 구속 연출은
			-- rootDuration까지가 아니라 extraDamageDelay(추가타 시점)까지만 재생하고 그 직전에
			-- 페이드아웃한다 — 추가타가 마무리 연출 역할을 하므로 그 이후엔 구속 연출이 필요 없다.
			local extraDamageDelay = math.max(0, rootDuration - self.Card24ExtraDamageLeadTime)
			local extraEffectDelay = math.max(0, extraDamageDelay - self.Card24ExtraEffectLeadTime)
			-- 최초 데미지를 liftDelay만큼 늦춰서 구속 연출이 먼저 뜨게 한다 — 원래는 데미지를
			-- 즉시(t=0) 적용했는데, 그 데미지로 대상이 즉사(1방 킬)하면 liftDelay 뒤 콜백의
			-- target._dead 체크에 걸려 구속 연출 자체가 아예 안 뜨는 문제가 있었다(연출 엔티티는
			-- 대상과 무관하게 독립적으로 스폰되므로, 스폰만 데미지보다 먼저 시켜두면 대상이 그
			-- 직후 죽어도 이미 뜬 연출은 자기 타이머대로 정상 재생/페이드아웃된다).
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
				local fxScale = (self:GetEffectScaleRatio(target)) * self.Card24EffectScale
				self:PlayAquaSurgeEffect(target, extraDamageDelay - liftDelay, fxScale)
				if isCrit then target:TakeDamageCrit(damage * 2)
				else target:TakeDamage(damage) end
			end, liftDelay)
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
				local p = target.Entity.TransformComponent.Position
				local fx = self:SpawnEffect(self.Card24ExtraEffectRUID, p, 0, 1, 1, 1)
				if fx ~= nil then fx:Destroy(self.Card24ExtraEffectLifetime) end
			end, extraEffectDelay)
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
				local extraDmg = damage * extraPercent
				if isCrit then target:TakeDamageCrit(extraDmg * 2)
				else target:TakeDamage(extraDmg) end
				log("AquaSurgeAttack: extra dmg=" .. math.floor(isCrit and extraDmg * 2 or extraDmg))
			end, extraDamageDelay)

			hitCount = hitCount + 1
		end
		log("AquaSurgeAttack: hit=" .. hitCount .. "/" .. targetCount .. " dmg=" .. math.floor(isCrit and damage * 2 or damage) .. " root=" .. rootDuration)
	end

	-- PlayAquaTrapEffect와 동일한 구조지만 아쿠아 서지 전용 RUID(Card24EffectRUID)를 쓴다(아쿠아
	-- 트랩 본체의 Card14EffectRUID/PlayAquaTrapEffect에는 전혀 영향 없음). duration 전체를 한 번에
	-- 재생하고 끝나기 Card24EffectFadeOutDuration 전부터 알파를 서서히 0으로 낮춰 자연스럽게
	-- 사라지게 한다(기존엔 짧은 세그먼트를 반복 이어붙이는 방식이었는데, 세그먼트 경계에서 다시
	-- 시작하는 것처럼 보이거나, 타이머 드리프트/다른 스킬의 재스턴으로 예상보다 일찍 끊기는 등
	-- 여러 버그가 반복돼서 유저 요청으로 단순한 "전체 재생 + 페이드아웃" 방식으로 교체했다).
	@ExecSpace("ServerOnly")
	method void PlayAquaSurgeEffect(MonsterAI target, number duration, number fxScale)
		if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
		if self:GetCurrentMap() == nil or target._spawnZoneIndex ~= _MapManager.CurrentMapIndex then return end
		if duration <= 0 then return end
		local p = target.Entity.TransformComponent.Position
		local fx = self:SpawnEffectWithModel(self.Card24EffectRUID, p, 0, 1, fxScale, 1, "skilleffectlong")
		if fx == nil then return end
		fx:Destroy(duration)
		local renderer = fx.SpriteRendererComponent
		if renderer == nil then return end
		local fadeDuration = math.min(self.Card24EffectFadeOutDuration, duration)
		local fadeDelay = duration - fadeDuration
		_TimerService:SetTimerOnce(function()
			if not isvalid(fx) or not isvalid(renderer) then return end
			_TweenLogic:PlayTween(1.0, 0.0, fadeDuration, EaseType.Linear, function(alpha)
				if isvalid(renderer) then renderer:SetAlpha(alpha) end
			end)
		end, fadeDelay)
	end

	-- 헤일 스톤 (Card 15) — 범위 빙결 스킬. 지상 우선(GetGroundPriorityTargets) 순으로 여러 명을 골라
	-- 데미지 + MonsterAI:AddFreezeStack(기존 콜드빔/프리징 이펙트와 동일한 빙결 스택 시스템 —
	-- 슬로우/스택 인디케이터는 그 쪽에서 이미 다 처리해준다)으로 얼린다.
	-- Lv1(해금): 120뎀·1명 타겟·빙결스택1(레벨 무관 항상 적용) / Lv2: 타겟+1(2명) / Lv3: 데미지+50(170) /
	-- Lv4: 쿨타임 -10% / Lv5: 타겟+1(3명)
	-- 타겟마다 그 위치 바로 위 세로 통로(Card15PathWidth×Card15PathHeight) 안에 있는 다른 몬스터는
	-- 같은 전체 데미지를 추가로 받는다(빙결 스택은 원래 타겟에게만 적용).
	@Sync property integer HailStoneLevel = 0
	property number Card15Damage = 120
	property string Card15Name = "헤일 스톤"
	property string Card15IconRUID = "846868d95f1c445ea5d0df5b84cb00a9"
	property string Card15EffectRUID = "ea3601f7731c4e9f8e372149217c0d5e"
	property number Card15Cooldown = 5.0
	property number Card15EffectScale = 0.8  -- 연출 원본 프레임이 커서(최대 528x572) 축소 적용
	property number Card15EffectYOffset = 0.15  -- 연출을 살짝 아래로 내림
	property number Card15EffectPlayRate = 2.0  -- 연출 재생속도 2배
	-- 예전엔 Destroy를 직접 안 걸어서 공용 "skilleffect" 모델 기본 Duration(0.8초)에 그냥 맡겼었는데,
	-- PlayRate가 2배라 그 안에 루프가 여러 번 돌아 "연출 뒤에 또 재생되는" 것처럼 보였음. 이제 이 스킬
	-- 전용으로 수명을 직접 관리(공용 풀 기본값에 의존하지 않음) — 요청대로 기존(0.8초) 대비 0.15초 줄임.
	property number Card15EffectLifetime = 0.72  -- 유저 직접 지정(0.85→0.72)
	property number Card15ImpactDelay = 0.3  -- 연출 스폰 후 착탄(데미지 적용) 시점까지의 지연 — 메테오(Card5)와 동일한 패턴
	property number Card15PathWidth = 0.5  -- 얼음이 떨어지는 경로(타겟 위쪽 세로 통로)의 좌우 폭
	property number Card15PathHeight = 3.0  -- 경로 판정이 타겟보다 위로 얼마나 높이까지 닿는지

	-- ── 썬더스톰 (Card 16) — 썬더볼트 Lv5 + 매직크리티컬 보유 시 등장하는 조합 스킬.
	-- 새 슬롯을 쓰지 않고 썬더볼트가 있던 슬롯을 그대로 넘겨받는다(매직크리티컬은 소모되지 않음).
	-- Lv1~3까지만 존재.
	@Sync property integer ThunderStormLevel = 0
	property string Card16Name = "썬더스톰"
	property string Card16IconRUID = "8b109fcf51d64bc49a2dcc0e221beee1"
	-- summon/attack1 (썬더 스피어 팩) — 유저가 스크린샷으로 확인시켜준 실제 썸네일에 번개가 뚜렷하게
	-- 보여서 이 계열이 맞는 에셋이었음. 안 보였던 진짜 원인은 에셋이 아니라 SkillEffect.model의
	-- Duration 0.8초(파괴 타이머가 스폰 시점에 즉시 예약돼서 이후 덮어써도 반영 안 됨) — 모델 자체를 고침.
	property string Card16EffectRUID = "843f05fd4e9a4f9fa98fca45eeeca80e"
	property number Card16Radius = 1.4  -- 판정 반경(연출 원본 프레임 최대 324x320 기준)
	property number Card16EffectScale = 0.85
	-- 3타 사이 간격이자, 개별 타의 "연출 스폰 → 실제 착탄(데미지)"까지의 지연이기도 하다(ApplyThunderStormImpact 참고).
	-- 0.3초는 15프레임 연출(번개가 내려꽂히는 전반부)이 다 재생되기 전에 데미지가 들어가서 타이밍이
	-- 어색했음(유저 피드백) — 번개가 실제로 떨어진 뒤에 맞게 늘림.
	property number Card16HitInterval = 0.6
	-- 연출 인스턴스 하나가 살아있는 시간(Entity:Destroy로 직접 파괴 예약, Duration 프로퍼티가 아님 —
	-- 위 참고). Card16HitInterval(0.6초)과 똑같이 맞췄더니 15프레임 연출이 다 재생되기 전에 잘려서
	-- 다시 "안 보인다" 문제로 되돌아감(유저 피드백) — 그렇다고 너무 길면(2.5초) 다음 타 연출과 겹쳐서
	-- "여러 개 동시에 떨어지는" 것처럼 보임. 둘 다 완전히 없앨 수는 없어서(연출 길이 > 타격 간격이라
	-- 구조적으로 약간의 겹침은 불가피) 중간값으로 절충함 — 여전히 어색하면 더 조정 필요.
	property number Card16EffectLifetime = 1.5
	property number Card16StunDuration = 3.0
	property number Card16Cooldown = 4.5  -- 레벨 무관 고정

	-- ── 아이스 스트라이크 (Card 17) — 콜드빔 Lv5 + 프리징 이펙트 보유 시 등장하는 조합 스킬.
	-- 새 슬롯을 쓰지 않고 콜드빔이 있던 슬롯을 그대로 넘겨받는다(프리징 이펙트는 소모되지 않음).
	-- Lv1~3까지만 존재. 서로 다른 몬스터 N명(3~4명, GetClosestTargets)에게 각 1타씩 동시 적용,
	-- 매 대상 슬로우+빙결 스택 2 100% 적용.
	@Sync property integer IceStrikeLevel = 0
	property string Card17Name = "아이스 스트라이크"
	property string Card17IconRUID = "dbee0d9812a04400837ba38e89cbffbc"
	property string Card17EffectRUID = "7c9082f93eed42b5a083e84df4f77178"
	property number Card17Cooldown = 2.0  -- 레벨 무관 고정
	-- 개별 연출 수명(Entity:Destroy로 직접 관리). SpawnEffectWithModel(..., "skilleffectlong")로
	-- 스폰하므로 공용 skilleffect 모델의 0.8초 캡과 무관하게(캡=2.5초) 이 값을 자유롭게 조절 가능.
	property number Card17EffectLifetime = 0.65  -- 유저 요청으로 0.4→0.8 증가 후, 루프가 더 도는 느낌이라 0.65로 재조정
	property number Card17EffectScale = 1.265  -- 유저 요청으로 10% 확대 후 15% 추가 확대(1.1×1.15)
	property number Card17EffectAlpha = 0.8  -- 유저 요청으로 알파 20% 감소
	property number Card17EffectPlayRate = 0.8  -- 유저 요청으로 배속 0.8(20% 느리게)
	property number Card17SlowDuration = 3.0  -- 콜드빔과 동일하게 고정 3초

	-- ── 체인 라이트닝 (Card 19) — 에너지볼트 Lv5 + 매직 부스터 보유 시 등장하는 조합 스킬.
	-- 새 슬롯을 쓰지 않고 에너지볼트가 있던 슬롯을 그대로 넘겨받는다(매직 부스터는 소모되지 않음).
	-- Lv1~3까지만 존재. 서로 다른 몬스터 N명(Lv1:3/Lv2:4/Lv3:5, GetClosestTargets)에게 순서대로 연쇄
	-- 타격(홉마다 감소하는 배율) + 마지막 타겟에는 별도 "마지막 착탄" 보너스 데미지 추가.
	-- 매 캐스트 1회, 매직크리티컬 확률+20%로 자체 치명타 판정(에너지볼트의 EnergyBoltCritBonus와 동일한
	-- "가산" 방식 — 레벨 무관 고정 20%).
	@Sync property integer ChainLightningLevel = 0
	property string Card19Name = "체인 라이트닝"
	property string Card19IconRUID = "f84bad609f3a47c29ed662abea683f2e"
	property string Card19ChainRUID = "fde245aeb0eb49baa3b0bd64fbc05f7a"
	property string Card19FinalRUID = "fa693d02e71841b2bf541bcdbdd84242"
	property number Card19Cooldown = 3.0  -- 레벨 무관 고정
	property number Card19HopDelay = 0.15  -- 홉 사이 딜레이 — 연쇄가 순차적으로 전이되는 느낌을 준다

	-- 버프 아이콘 UI 바인딩
	property Entity boosterBuff = "8ac3662e-b083-4498-8295-33fcfcb9f1e2"
	property SpriteGUIRendererComponent boosterFill = "bfc40004-e62c-4d57-aa03-fc56151442e8"
	property Entity critBuff = "233abc2f-676d-48a2-ac24-f03fb165d4d2"
	property SpriteGUIRendererComponent critFill = "00adcd2c-7b51-41bb-9e52-2f814ea02f02"
	property Entity freezeBuff = "b57044c6-36ce-47ab-92e9-b76aee3ee169"
	property SpriteGUIRendererComponent freezeFill = "f62a3df5-ddf1-4642-9d3b-8b28127a9abe"
	property Entity armorBuff = "07ed20bd-9757-445a-ad47-f92ef18915f1"
	property SpriteGUIRendererComponent armorFill = "7b857f5f-d3d3-4d53-b517-2bdad4ca7134"
	property Entity meditationBuff = "4f48d10b-882a-4dfc-a9f9-7b6362890673"
	property SpriteGUIRendererComponent meditationFill = "9f502312-9210-43d7-b00c-0f6a41dfc311"

	-- 활성 버프 순서 추적 (획득 순으로 왼쪽부터)
	property any _activeBuffOrder = nil

	-- 말풍선 UI 바인딩
	property Entity tooltipPanel = "4615be3c-8628-4e55-ab57-ef285284d988"
	property TextComponent tooltipName = "6bcae722-631a-41a7-b349-89439ec2f81e"
	property TextComponent tooltipDmg = "23e460d7-77a0-4906-8284-d293d3a85748"
	property TextComponent tooltipCd = "8a0eef9f-0bf6-452a-a641-ccbaadf74212"
	property TextComponent tooltipExtra = "44c7b4c3-6481-407f-9ec5-d981eebb1823"
	property ButtonComponent slotBtn1 = "5b6b4c7d-d3c2-4b53-8f33-620eb97e4016"
	property ButtonComponent slotBtn2 = "af45836e-1c6b-4ea1-82c0-f4239fb8d814"
	property ButtonComponent slotBtn3 = "8a207abb-b05d-4a1c-b7ed-189206160352"
	property ButtonComponent slotBtn4 = "dbf63dd0-044b-490b-9812-a71d27bcbd7a"
	property ButtonComponent slotBtn5 = "d61da933-cc33-411a-9adf-a4aef9ce81e2"
	property ButtonComponent slotBtn6 = "1f088b0d-89b4-439d-ba64-2e0a38ce7ad3"
	property integer _tooltipToken = 0

	-- 에디터 디버그용 (배포 전 false로 변경)
	property boolean DebugMode = true
	property any _debugKeyHandler = nil

	-- 서버 전용 타이머 (슬롯별)
	property number _timerBasic = 0
	property number _timer1 = 0
	property number _timer2 = 0
	property number _timer3 = 0
	property number _timer4 = 0
	property number _timer5 = 0
	property number _timer6 = 0

	-- 파워 엘릭서 습득 시 GameManager가 호출 — 장착된 모든 슬롯을 즉시 재사용 가능 상태로 만든다.
	-- 서버 타이머(_timer1~6)만 0으로 되돌리면 실제로는 바로 재사용 가능해지지만, 슬롯에 도는 쿨타임
	-- 원형 게이지(_activeCooldowns)는 클라이언트가 캐스트 시점에 등록해둔 자기만의 startTime/duration으로
	-- 독립적으로 카운트다운하는 클라 로컬 예측이라 서버 타이머 리셋과 무관하게 계속 돈다 — 그래서
	-- ResetAllCooldownVisuals()를 같이 브로드캐스트해서 게이지도 즉시 초기화해야 한다.
	@ExecSpace("ServerOnly")
	method void ResetAllCooldowns()
		self._timerBasic = 0
		self._timer1 = 0
		self._timer2 = 0
		self._timer3 = 0
		self._timer4 = 0
		self._timer5 = 0
		self._timer6 = 0
		self:ResetAllCooldownVisuals()
	end

	-- ResetAllCooldowns()가 호출 — 슬롯 쿨타임 원형 게이지 7개(기본공격+슬롯1~6)를 즉시 "사용 가능"
	-- 상태로 되돌린다. _activeCooldowns에서 이 오버레이들만 제거하고(버프 아이콘 항목은 그대로 둠 — 같은
	-- 리스트를 공유하지만 무관한 연출이라 건드리면 안 됨) TickCooldownVisuals의 자연 완료 분기와 동일하게
	-- FillAmount=0 + Enable=false로 맞춘다.
	@ExecSpace("Multicast")
	method void ResetAllCooldownVisuals()
		if self:IsServer() then return end
		local overlays = { self.basicAttackCooldown, self.cooldown1, self.cooldown2, self.cooldown3, self.cooldown4, self.cooldown5, self.cooldown6 }
		for _, overlay in ipairs(overlays) do
			if overlay ~= nil then
				for i = #self._activeCooldowns, 1, -1 do
					if self._activeCooldowns[i].overlay == overlay then
						table.remove(self._activeCooldowns, i)
					end
				end
				overlay.Entity:SetEnable(false)
				overlay.FillAmount = 0
			end
		end
	end

	-- 레벨업 선택지 내부 상태
	property integer _choiceCard1 = 0
	property integer _choiceCard2 = 0
	property integer _choiceCard3 = 0
	property string _choiceType1 = ""
	property string _choiceType2 = ""
	property string _choiceType3 = ""
	property integer _pendingLevelUps = 0
	property any _choiceClickHandler1 = nil
	property any _choiceClickHandler2 = nil
	property any _choiceClickHandler3 = nil

	-- 클라이언트 쿨타임 연출 — 캐스트마다 새 타이머를 만들지 않고
	-- 단일 반복 타이머가 활성 쿨타임 목록을 매 틱 갱신한다 (다수 동시 캐스트 시 타이머 고갈 방지)
	property any _activeCooldowns = nil
	property integer _cooldownTimerId = 0

	-- ── 헬퍼 메서드 ────────────────────────────────────────────

	method integer GetSlotCard(integer slotIdx)
		if slotIdx == 1 then return self.Slot1Card
		elseif slotIdx == 2 then return self.Slot2Card
		elseif slotIdx == 3 then return self.Slot3Card
		elseif slotIdx == 4 then return self.Slot4Card
		elseif slotIdx == 5 then return self.Slot5Card
		elseif slotIdx == 6 then return self.Slot6Card
		end
		return 0
	end

	method void AssignCardToSlot(integer slotIdx, integer cardIdx)
		if slotIdx == 1 then self.Slot1Card = cardIdx
		elseif slotIdx == 2 then self.Slot2Card = cardIdx
		elseif slotIdx == 3 then self.Slot3Card = cardIdx
		elseif slotIdx == 4 then self.Slot4Card = cardIdx
		elseif slotIdx == 5 then self.Slot5Card = cardIdx
		elseif slotIdx == 6 then self.Slot6Card = cardIdx
		end
	end

	method integer GetNextEmptySlot()
		if self.Slot1Card == 0 then return 1 end
		if self.Slot2Card == 0 then return 2 end
		if self.Slot3Card == 0 then return 3 end
		if self.Slot4Card == 0 then return 4 end
		if self.Slot5Card == 0 then return 5 end
		if self.Slot6Card == 0 then return 6 end
		return 0
	end

	method boolean IsCardUnlocked(integer cardIdx)
		if cardIdx == 3 then return self.ColdBeamLevel > 0 end
		if cardIdx == 4 then return self.ThunderBoltLevel > 0 end
		if cardIdx == 7 then return self.MagicBoosterLevel > 0 end
		if cardIdx == 8 then return self.MagicCriticalLevel > 0 end
		if cardIdx == 9 then return self.EnergyBoltLevel > 0 end
		if cardIdx == 10 then return self.FreezingEffectLevel > 0 end
		if cardIdx == 11 then return self.IceCutterLevel > 0 end
		if cardIdx == 12 then return self.KingPepeLevel > 0 end
		if cardIdx == 13 then return self.ThunderCutterLevel > 0 end
		if cardIdx == 14 then return self.AquaTrapLevel > 0 end
		if cardIdx == 15 then return self.HailStoneLevel > 0 end
		if cardIdx == 16 then return self.ThunderStormLevel > 0 end
		if cardIdx == 17 then return self.IceStrikeLevel > 0 end
		if cardIdx == 18 then return self.MagicArmorLevel > 0 end
		if cardIdx == 19 then return self.ChainLightningLevel > 0 end
		if cardIdx == 20 then return self.DoubleCutterLevel > 0 end
		if cardIdx == 21 then return self.GrandPepeLevel > 0 end
		if cardIdx == 22 then return self.MeditationLevel > 0 end
		if cardIdx == 23 then return self.HailBurstLevel > 0 end
		if cardIdx == 24 then return self.AquaSurgeLevel > 0 end
		if cardIdx == 101 then return self.WindPoemLevel > 0 end
		return self.Slot1Card == cardIdx or self.Slot2Card == cardIdx or self.Slot3Card == cardIdx
			or self.Slot4Card == cardIdx or self.Slot5Card == cardIdx or self.Slot6Card == cardIdx
	end

	-- 카드가 현재 어느 슬롯에 들어있는지 (없으면 0)
	method integer GetSlotForCard(integer cardIdx)
		if self.Slot1Card == cardIdx then return 1
		elseif self.Slot2Card == cardIdx then return 2
		elseif self.Slot3Card == cardIdx then return 3
		elseif self.Slot4Card == cardIdx then return 4
		elseif self.Slot5Card == cardIdx then return 5
		elseif self.Slot6Card == cardIdx then return 6
		end
		return 0
	end

	-- 슬롯별 "아이콘" 실제 화면 좌표 (DefaultGroup 기준). CardSlots 컨테이너(-455.5)에 각 Card{N} 슬롯
	-- 프레임의 중심 오프셋을 더한 값이 슬롯 "프레임" 좌표인데, 실제 아이콘(Icon 엔티티)은 그 프레임
	-- 중심에서 다시 (0, +22)만큼 위로 떨어져 있다(이름/레벨 텍스트가 아래쪽에 자리잡아서) — 이 +22를
	-- 빼먹어서 드롭/구매 연출이 전부 아이콘보다 22px 아래로 착지하던 버그를 수정(.ui 실측: UIBuilder로
	-- CardSlots/Card{N}/Icon의 anchoredPosition을 직접 대조해서 확인함, 6슬롯 전부 동일하게 (0,22)).
	method Vector2 GetSlotUIPosition(integer slotIdx)
		if slotIdx == 1 then return Vector2(-360, -341)
		elseif slotIdx == 2 then return Vector2(-216, -341)
		elseif slotIdx == 3 then return Vector2(-72, -341)
		elseif slotIdx == 4 then return Vector2(72, -341)
		elseif slotIdx == 5 then return Vector2(216, -341)
		else return Vector2(360, -341)
		end
	end

	method SpriteGUIRendererComponent GetDropIcon(integer dropIdx)
		if dropIdx == 2 then return self.dropFlyIcon2
		elseif dropIdx == 3 then return self.dropFlyIcon3
		end
		return self.dropFlyIcon
	end

	method SpriteGUIRendererComponent GetSlotRenderer(integer slotIdx)
		if slotIdx == 1 then return self.slot1
		elseif slotIdx == 2 then return self.slot2
		elseif slotIdx == 3 then return self.slot3
		elseif slotIdx == 4 then return self.slot4
		elseif slotIdx == 5 then return self.slot5
		else return self.slot6
		end
	end

	-- 하드코딩된 "/maps/map01" 대신, 실제로 플레이어가 있는 맵을 찾는다.
	-- userEntity.CurrentMap(엔진 네이티브 맵 소속)은 쓰지 않는다 — 그룹D 병합으로 맵11/12가 물리적으로
	-- 같은 파일(map11.map)을 쓰게 된 뒤로는 존11에 있든 존12에 있든 항상 같은 "map11" 엔티티를 반환해서
	-- 구분이 안 되기 때문이다(실측 확인 — 존12로 이동한 뒤에도 카드가 계속 존11에 남겨진 몬스터를 공격).
	-- MonsterSpawner.GetCurrentMap과 동일하게 MapManager.CurrentMapIndex(버튼 이동 때마다 확정적으로
	-- 갱신됨) 기준으로 존11의 루트 또는 존12의 자식 컨테이너를 구분해서 반환한다.
	@ExecSpace("ServerOnly")
	method Entity GetCurrentMap()
		return _MonsterSpawner:GetZoneEntity(_MapManager.CurrentMapIndex)
	end

	-- ── SkillInventory 연동 (조각모아 레벨업 — 카드 자체 레벨과 완전히 별개로, 카드 슬롯의 현재
	-- 능력치에 항상 가산된다. 카드 자체가 Lv1이든 Lv5든 상관없이 SkillInventory 레벨만으로 결정) ──
	-- cardIdx -> SkillInventory 스킬 인덱스(0~19) 매핑. 포션(인덱스1)은 GameManager.ApplyPotionDrop에서
	-- 직접 참조하므로 여기엔 없다.
	property any _skillInvCardIdxMap = {
		[7] = 0,   -- 매직 부스터 (전역 쿨타임 추가 감소)
		[18] = 2,  -- 매직 아머 (전역 피격 데미지 추가 감소)
		[4] = 3,   -- 썬더 볼트
		[3] = 4,   -- 콜드 빔
		[11] = 5,  -- 아이스 커터
		[9] = 6,   -- 에너지볼트
		[13] = 7,  -- 썬더 커터
		[8] = 8,   -- 매직 크리티컬 (전역 크리티컬 확률 추가)
		[10] = 9,  -- 프리징 이펙트 (전역 빙결스택 보너스대미지 추가)
		[22] = 10, -- 메디테이션 (전역 데미지 추가, 최대레벨 9 예외)
		[12] = 11, -- 페페
		[15] = 12, -- 헤일 스톤
		[14] = 13, -- 아쿠아 트랩
		[16] = 14, -- 썬더스톰
		[17] = 15, -- 아이스 스트라이크
		[19] = 16, -- 체인 라이트닝
		[20] = 17, -- 더블 커터
		[21] = 18, -- 킹페페(GrandPepe)
		[23] = 19, -- 헤일 버스트
	}
	-- 썬더볼트만 예외로 SkillInventory 쿨타임 감소 줄이 없다(대신 스턴 지속시간/확률 2줄)
	property any _skillInvNoCooldownBonus = { [4] = true }

	@ExecSpace("ServerOnly")
	method integer GetSkillInvLevel(integer cardIdx)
		local skillIdx = self._skillInvCardIdxMap[cardIdx]
		if skillIdx == nil then return 0 end
		local key = tostring(skillIdx)
		if _SkillInventory.Levels[key] ~= nil then return _SkillInventory.Levels[key] end
		return 0
	end

	-- 패시브(매직부스터/매직아머/매직크리티컬/프리징이펙트)는 카드 인덱스가 아니라 SkillInventory
	-- 스킬 인덱스로 직접 조회한다(자기 자신 전용 cardIdx가 없는 전역 효과라서)
	@ExecSpace("ServerOnly")
	method integer GetSkillInvLevelByIndex(integer skillIndex)
		local key = tostring(skillIndex)
		if _SkillInventory.Levels[key] ~= nil then return _SkillInventory.Levels[key] end
		return 0
	end

	-- 액티브 14개 스킬 공통 Lv3 보너스: 대미지 +10% (Lv1,2는 효과 없음)
	@ExecSpace("ServerOnly")
	method number GetSkillInvDamageMult(integer cardIdx)
		if self:GetSkillInvLevel(cardIdx) >= 3 then return 1.10 end
		return 1.0
	end

	-- 액티브 14개 스킬 공통 Lv6 보너스: 쿨타임 -5% (썬더볼트 제외, Lv4,5는 효과 없음)
	@ExecSpace("ServerOnly")
	method number GetSkillInvCooldownMult(integer cardIdx)
		if self._skillInvNoCooldownBonus[cardIdx] then return 1.0 end
		if self:GetSkillInvLevel(cardIdx) >= 6 then return 0.95 end
		return 1.0
	end

	method number GetCardDamage(integer cardIdx)
		-- 메디테이션(Card22)의 영구 데미지 증가는 모든 스킬이 거쳐가는 이 함수 한 곳에서만 곱해서
		-- 개별 스킬마다 따로 적용할 필요가 없게 한다. SkillInventory의 액티브 스킬 대미지 보너스도 동일하게 여기서 일괄 적용.
		local base = self.Card5Damage
		if cardIdx == 1 then base = self.Card1Damage
		elseif cardIdx == 25 then base = self.ArrowShotDamage
		elseif cardIdx == 2 then base = self.Card2Damage
		elseif cardIdx == 3 then base = self:GetColdBeamDamage()
		elseif cardIdx == 4 then base = self:GetThunderBoltDamage()
		elseif cardIdx == 9 then base = self:GetEnergyBoltDamage()
		elseif cardIdx == 11 then base = self:GetIceCutterDamage(self.IceCutterLevel)
		elseif cardIdx == 12 then base = self:GetKingPepeDamage()
		elseif cardIdx == 13 then base = self:GetThunderCutterDamage()
		elseif cardIdx == 14 then base = self:GetAquaTrapDamage()
		elseif cardIdx == 15 then base = self:GetHailStoneDamage()
		elseif cardIdx == 16 then base = self:GetThunderStormDamage(self.ThunderStormLevel)
		elseif cardIdx == 17 then base = self:GetIceStrikeDamage(self.IceStrikeLevel)
		elseif cardIdx == 19 then base = self:GetChainLightningDamage(self.ChainLightningLevel)
		elseif cardIdx == 20 then base = self:GetDoubleCutterDamage(self.DoubleCutterLevel)
		elseif cardIdx == 21 then base = self:GetGrandPepeDamage()
		elseif cardIdx == 23 then base = self:GetHailBurstDamage()
		elseif cardIdx == 24 then base = self:GetAquaSurgeDamage()
		elseif cardIdx == 101 then base = self:GetWindPoemDamage()
		end
		return base * self:GetMeditationMult() * self:GetSkillInvDamageMult(cardIdx)
	end

	method number GetKingPepeDamage()
		-- Lv1~3: 기본(300) / Lv4~5: +70(370)
		if self.KingPepeLevel >= 4 then return self.Card12BaseDamage + 70 end
		return self.Card12BaseDamage
	end

	-- Lv2와 Lv5에서 각각 -10%씩 곱연산으로 감소(Lv1:7.0 / Lv2~4:6.3 / Lv5:5.67)
	method number GetKingPepeCooldown()
		local cd = self.Card12BaseCooldown
		if self.KingPepeLevel >= 2 then cd = cd * 0.9 end
		if self.KingPepeLevel >= 5 then cd = cd * 0.9 end
		return cd
	end

	-- 썬더 볼트 (Card 4) 레벨별 수치 — Lv1~2: 기본(90) / Lv3~4: +40(130) / Lv5: +80(170)
	method number GetThunderBoltDamage()
		if self.ThunderBoltLevel >= 5 then return self.Card4Damage + 80
		elseif self.ThunderBoltLevel >= 3 then return self.Card4Damage + 40
		end
		return self.Card4Damage
	end

	-- Lv1~3: 2명 / Lv4~5: 3명
	method integer GetThunderBoltTargetCount()
		if self.ThunderBoltLevel >= 4 then return 3 end
		return 2
	end

	-- Lv1: 0%(스턴 없음) / Lv2~4: 25% / Lv5: 30%
	method number GetThunderBoltStunChance()
		local base = 0
		if self.ThunderBoltLevel >= 5 then base = 0.30
		elseif self.ThunderBoltLevel >= 2 then base = 0.25
		end
		-- SkillInventory 썬더볼트(인덱스3) Lv9: 스턴 확률 +10%, 카드 자체 레벨과 별개로 항상 가산
		if self:GetSkillInvLevel(4) >= 9 then base = base + 0.10 end
		return base
	end

	-- Lv1: 0(해당없음) / Lv2~3: 2초 / Lv4~5: 3초 — 보스/엘리트는 호출부에서 별도로 절반 적용
	method number GetThunderBoltStunDuration()
		local base = 0
		if self.ThunderBoltLevel >= 4 then base = 3.0
		elseif self.ThunderBoltLevel >= 2 then base = 2.0
		end
		-- SkillInventory 썬더볼트(인덱스3) Lv6: 스턴 지속시간 +1초, 카드 자체 레벨과 별개로 항상 가산.
		-- 카드 자체가 아직 스턴을 못 얻은 상태(0초)여도 SkillInventory만으로 스턴이 발생할 수 있어야 하므로
		-- 여기서도 최소 1초를 보장한다.
		if self:GetSkillInvLevel(4) >= 6 then
			if base <= 0 then base = 1.0 else base = base + 1.0 end
		end
		return base
	end

	-- 콜드 빔 (Card 3) 레벨별 수치 — Lv1~2: 기본(110) / Lv3~4: +50(160) / Lv5: +100(210).
	-- 1타/2타로 반씩 나눠 적용하는 건 ColdBeamAttack 호출부에서 처리(이 값은 총 데미지 기준값)
	method number GetColdBeamDamage()
		if self.ColdBeamLevel >= 5 then return self.Card3Damage + 100
		elseif self.ColdBeamLevel >= 3 then return self.Card3Damage + 50
		end
		return self.Card3Damage
	end

	-- Lv1: 1명 / Lv2~3: 2명 / Lv4~5: 3명
	method integer GetColdBeamTargetCount()
		if self.ColdBeamLevel >= 4 then return 3
		elseif self.ColdBeamLevel >= 2 then return 2
		end
		return 1
	end

	-- Lv1~2: 기본(100) / Lv3~4: +50(150) / Lv5: +100(200)
	method number GetThunderCutterDamage()
		if self.ThunderCutterLevel >= 5 then return self.Card13Damage + 100
		elseif self.ThunderCutterLevel >= 3 then return self.Card13Damage + 50
		end
		return self.Card13Damage
	end

	-- Lv1: 1타 / Lv2~3: 2타 / Lv4~5: 3타
	method integer GetThunderCutterShotCount()
		if self.ThunderCutterLevel >= 4 then return 3
		elseif self.ThunderCutterLevel >= 2 then return 2
		end
		return 1
	end

	-- Lv1: 기본(75) / Lv2~3: +50(125) / Lv4~5: +50(175)
	method number GetAquaTrapDamage()
		if self.AquaTrapLevel >= 4 then return self.Card14Damage + 100
		elseif self.AquaTrapLevel >= 2 then return self.Card14Damage + 50
		end
		return self.Card14Damage
	end

	-- Lv1~2: 2명 / Lv3~4: 3명 / Lv5: 4명
	method integer GetAquaTrapTargetCount()
		if self.AquaTrapLevel >= 5 then return 4
		elseif self.AquaTrapLevel >= 3 then return 3
		end
		return 2
	end

	-- Lv1~2: 1초 / Lv3~5: 2초
	method number GetAquaTrapRootDuration()
		if self.AquaTrapLevel >= 3 then return 2.0 end
		return 1.0
	end

	-- Lv1~2: 기본(120) / Lv3~5: +50(170)
	method number GetHailStoneDamage()
		if self.HailStoneLevel >= 3 then return self.Card15Damage + 50 end
		return self.Card15Damage
	end

	-- Lv1: 1명 / Lv2~4: 2명 / Lv5: 3명
	method integer GetHailStoneTargetCount()
		if self.HailStoneLevel >= 5 then return 3
		elseif self.HailStoneLevel >= 2 then return 2
		end
		return 1
	end

	method number GetEnergyBoltDamage()
		-- 스킬 대공사로 파이어샷(Card1) 데미지 참조를 없애고 고정값으로 전환.
		-- Lv1: 150(기본) / Lv2~3: +50(200) / Lv4~5: +50(250)
		if self.EnergyBoltLevel >= 4 then return 150 + 100
		elseif self.EnergyBoltLevel >= 2 then return 150 + 50
		end
		return 150
	end

	method number GetCardCooldown(integer cardIdx)
		if cardIdx == 1 then return self.Card1Cooldown
		elseif cardIdx == 25 then return self.ArrowShotCooldown
		elseif cardIdx == 2 then return self.Card2Cooldown
		elseif cardIdx == 3 then return self.Card3Cooldown
		elseif cardIdx == 4 then return self.Card4Cooldown
		elseif cardIdx == 5 then return self.Card5Cooldown
		elseif cardIdx == 7 then return self.Card7Cooldown
		elseif cardIdx == 8 then return self.Card8Cooldown
		elseif cardIdx == 9 then return self.Card9Cooldown
		elseif cardIdx == 11 then return self.Card11Cooldown
		elseif cardIdx == 12 then return self:GetKingPepeCooldown()
		elseif cardIdx == 13 then return self.Card13Cooldown
		elseif cardIdx == 14 then return self.Card14Cooldown
		elseif cardIdx == 15 then return (self.HailStoneLevel >= 4) and (self.Card15Cooldown * 0.9) or self.Card15Cooldown
		elseif cardIdx == 16 then return self.Card16Cooldown
		elseif cardIdx == 17 then return self.Card17Cooldown
		elseif cardIdx == 19 then return self.Card19Cooldown
		elseif cardIdx == 20 then return self.Card20Cooldown
		elseif cardIdx == 21 then return self.Card21Cooldown
		elseif cardIdx == 23 then return self.Card23Cooldown
		elseif cardIdx == 24 then return self.Card24Cooldown
		elseif cardIdx == 101 then return self.Card101Cooldown
		end
		return 1.0
	end

	method string GetCardIconRUID(integer cardIdx)
		if cardIdx == 1 then return self.Card1IconRUID
		elseif cardIdx == 25 then return self.ArrowShotIconRUID
		elseif cardIdx == 2 then return self.Card2IconRUID
		elseif cardIdx == 3 then return self.Card3IconRUID
		elseif cardIdx == 4 then return self.Card4IconRUID
		elseif cardIdx == 5 then return self.Card5IconRUID
		elseif cardIdx == 7 then return self.Card7IconRUID
		elseif cardIdx == 8 then return self.Card8IconRUID
		elseif cardIdx == 9 then return self.Card9IconRUID
		elseif cardIdx == 10 then return self.Card10IconRUID
		elseif cardIdx == 11 then return self.Card11IconRUID
		elseif cardIdx == 12 then return self.Card12IconRUID
		elseif cardIdx == 13 then return self.Card13IconRUID
		elseif cardIdx == 14 then return self.Card14IconRUID
		elseif cardIdx == 15 then return self.Card15IconRUID
		elseif cardIdx == 16 then return self.Card16IconRUID
		elseif cardIdx == 17 then return self.Card17IconRUID
		elseif cardIdx == 18 then return self.Card18IconRUID
		elseif cardIdx == 19 then return self.Card19IconRUID
		elseif cardIdx == 20 then return self.Card20IconRUID
		elseif cardIdx == 21 then return self.Card21IconRUID
		elseif cardIdx == 22 then return self.Card22IconRUID
		elseif cardIdx == 23 then return self.Card23IconRUID
		elseif cardIdx == 24 then return self.Card24IconRUID
		elseif cardIdx == 101 then return self.Card101IconRUID
		end
		return ""
	end

	-- 카드 슬롯 라벨용 이름(레벨 표기 없이) — 카드 이름은 이미 여러 곳에서 각기 다른 프로퍼티에
	-- 흩어져 있어서(Card2~5는 고정 문자열, 7~12는 CardNName 프로퍼티) 여기서 하나로 모은다
	method string GetSlotBaseName(integer cardIdx)
		if cardIdx == 2 then return "매직 클로"
		elseif cardIdx == 3 then return "콜드 빔"
		elseif cardIdx == 4 then return "썬더 볼트"
		elseif cardIdx == 5 then return "메테오"
		elseif cardIdx == 7 then return "매직 부스터"
		elseif cardIdx == 8 then return "매직 크리티컬"
		elseif cardIdx == 9 then return self.Card9Name
		elseif cardIdx == 10 then return self.Card10Name
		elseif cardIdx == 11 then return self.Card11Name
		elseif cardIdx == 12 then return self.Card12Name
		elseif cardIdx == 13 then return self.Card13Name
		elseif cardIdx == 14 then return self.Card14Name
		elseif cardIdx == 15 then return self.Card15Name
		elseif cardIdx == 16 then return self.Card16Name
		elseif cardIdx == 17 then return self.Card17Name
		elseif cardIdx == 18 then return self.Card18Name
		elseif cardIdx == 19 then return self.Card19Name
		elseif cardIdx == 20 then return self.Card20Name
		elseif cardIdx == 21 then return self.Card21Name
		elseif cardIdx == 22 then return self.Card22Name
		elseif cardIdx == 23 then return self.Card23Name
		elseif cardIdx == 24 then return self.Card24Name
		elseif cardIdx == 101 then return self.Card101Name
		end
		return ""
	end

	-- ── 치트: 슬롯 클릭 시 레벨 순환(개발자 전용) ──────────────────
	-- 기본 true(켜짐) — 매 Play마다 execute_script로 다시 켜줘야 하는 번거로움을 없애기 위해
	-- 개발 중엔 항상 켜둔다. 실제 배포 전에는 반드시 false로 바꿀 것.
	-- Lv1~5 고정 시스템으로 전환된 슬롯 카드(3/4/9/10/11/12/13/14/15)만 대상 — 아직 구식
	-- (배율 곱연산 누적이라 "레벨"만으로 되돌릴 수 없는) 1/2/5번 카드는 순환 대상에서 제외한다.
	property boolean CheatCycleLevelOnClick = true

	@ExecSpace("Server")
	method void CheatCycleSlotLevel(integer slotIdx)
		if not self.CheatCycleLevelOnClick then return end
		local cardIdx = self:GetSlotCard(slotIdx)
		local upgradeType = self:GetCheatUpgradeType(cardIdx)
		if upgradeType == "" then return end

		local level = self:GetSlotLevelNum(cardIdx)
		if level >= 5 then
			self:CheatResetCardToLevel1(cardIdx)
		else
			self:ApplyCardUpgrade(cardIdx, upgradeType)
		end
		log("Cheat: slot" .. slotIdx .. " card" .. cardIdx .. " -> Lv" .. self:GetSlotLevelNum(cardIdx))
	end

	-- ApplyCardUpgrade가 "레벨+1" 분기에서 실제로 확인하는 upgradeType 문자열 — 카드별로 다르다.
	method string GetCheatUpgradeType(integer cardIdx)
		if cardIdx == 3 then return "coldbeam_up"
		elseif cardIdx == 4 then return "thunderbolt_up"
		elseif cardIdx == 9 then return "energybolt_up"
		elseif cardIdx == 10 then return "freeze_up"
		elseif cardIdx == 11 then return "icecutter_up"
		elseif cardIdx == 12 then return "kingpepe_up"
		elseif cardIdx == 13 then return "thundercutter_up"
		elseif cardIdx == 14 then return "aquatrap_up"
		elseif cardIdx == 15 then return "hailstone_up"
		elseif cardIdx == 101 then return "windpoem_up"
		end
		return ""
	end

	-- Lv5(최대)에서 한 번 더 클릭하면 1로 되돌린다. ApplyCardUpgrade에는 "내려가는" 경로가 없어서
	-- 직접 프로퍼티를 되돌린다 — 레벨업 도중에만 붙는 부가 상태(에너지볼트 Lv3 치명타 보너스 등)는
	-- unlock(=Lv1) 시점 기준으로 같이 초기화해야 한다.
	@ExecSpace("ServerOnly")
	method void CheatResetCardToLevel1(integer cardIdx)
		if cardIdx == 3 then self.ColdBeamLevel = 1
		elseif cardIdx == 4 then self.ThunderBoltLevel = 1
		elseif cardIdx == 9 then self.EnergyBoltLevel = 1 ; self.EnergyBoltCritBonus = 0.0
		elseif cardIdx == 10 then self.FreezingEffectLevel = 1
		elseif cardIdx == 11 then self.IceCutterLevel = 1
		elseif cardIdx == 12 then self.KingPepeLevel = 1
		elseif cardIdx == 13 then self.ThunderCutterLevel = 1
		elseif cardIdx == 14 then self.AquaTrapLevel = 1
		elseif cardIdx == 15 then self.HailStoneLevel = 1
		elseif cardIdx == 101 then self.WindPoemLevel = 1
		end
	end

	-- 카드 슬롯 라벨용 레벨 숫자 — 카드 2~5는 강화 횟수(누적 카운트)를 그대로 Lv로 보여준다
	method integer GetSlotLevelNum(integer cardIdx)
		if cardIdx == 2 then return self.Card2UpgradeCount
		elseif cardIdx == 3 then return self.ColdBeamLevel
		elseif cardIdx == 4 then return self.ThunderBoltLevel
		elseif cardIdx == 5 then return self.Card5UpgradeCount
		elseif cardIdx == 7 then return self.MagicBoosterLevel
		elseif cardIdx == 8 then return self.MagicCriticalLevel
		elseif cardIdx == 9 then return self.EnergyBoltLevel
		elseif cardIdx == 10 then return self.FreezingEffectLevel
		elseif cardIdx == 11 then return self.IceCutterLevel
		elseif cardIdx == 12 then return self.KingPepeLevel
		elseif cardIdx == 13 then return self.ThunderCutterLevel
		elseif cardIdx == 14 then return self.AquaTrapLevel
		elseif cardIdx == 15 then return self.HailStoneLevel
		elseif cardIdx == 16 then return self.ThunderStormLevel
		elseif cardIdx == 17 then return self.IceStrikeLevel
		elseif cardIdx == 18 then return self.MagicArmorLevel
		elseif cardIdx == 19 then return self.ChainLightningLevel
		elseif cardIdx == 20 then return self.DoubleCutterLevel
		elseif cardIdx == 21 then return self.GrandPepeLevel
		elseif cardIdx == 22 then return self.MeditationLevel
		elseif cardIdx == 23 then return self.HailBurstLevel
		elseif cardIdx == 24 then return self.AquaSurgeLevel
		elseif cardIdx == 101 then return self.WindPoemLevel
		end
		return 0
	end

	-- SkillInventory 3단계 공통 헬퍼 — Lv3/6/9에서만 값이 상승(패시브 4종 전용, 메디테이션 제외)
	@ExecSpace("ServerOnly")
	method number GetSkillInvTierPercent(integer skillIndex, number lv1, number lv2, number lv3)
		local lv = self:GetSkillInvLevelByIndex(skillIndex)
		if lv >= 9 then return lv3
		elseif lv >= 6 then return lv2
		elseif lv >= 3 then return lv1
		end
		return 0
	end

	-- 매직 부스터 레벨별 쿨타임 감소율 — Lv1:5% / Lv2:7% / Lv3:10% / Lv4:12% / Lv5:15%.
	-- 획득(해금) 즉시 영구 적용(타이머/만료 없음), 다른 카드 쿨타임에 곱연산으로 적용된다.
	-- SkillInventory 매직부스터(인덱스0) 레벨의 -2%/-4%/-6%가 카드 자체 레벨과 별개로 항상 가산된다.
	method number GetMagicBoosterReduction()
		local base = 0
		if self.MagicBoosterLevel >= 5 then base = 0.15
		elseif self.MagicBoosterLevel >= 4 then base = 0.12
		elseif self.MagicBoosterLevel >= 3 then base = 0.10
		elseif self.MagicBoosterLevel >= 2 then base = 0.07
		elseif self.MagicBoosterLevel >= 1 then base = 0.05
		end
		return base + self:GetSkillInvTierPercent(0, 0.02, 0.04, 0.06)
	end

	-- 매직 아머 보유 시 항시 피해 감소 적용(영구, 만료 없음) — GameManager.OnMonsterReached에서 사용.
	-- SkillInventory 매직아머(인덱스2) 레벨의 +3%/+6%/+9%가 카드 자체 레벨과 별개로 항상 가산된다.
	method number GetMagicArmorReduction()
		local base = 0
		if self.MagicArmorLevel >= 5 then base = 0.15
		elseif self.MagicArmorLevel >= 4 then base = 0.12
		elseif self.MagicArmorLevel >= 3 then base = 0.10
		elseif self.MagicArmorLevel >= 2 then base = 0.07
		elseif self.MagicArmorLevel >= 1 then base = 0.05
		end
		return base + self:GetSkillInvTierPercent(2, 0.03, 0.06, 0.09)
	end

	-- 매직 부스터 보유 시 항시 쿨타임 감소 적용(영구, 만료 없음). SkillInventory의 액티브 스킬
	-- 자체 쿨타임 감소(Lv2, -5%)도 이 최종 소비 지점에서 함께 적용한다.
	@ExecSpace("ServerOnly")
	method number GetEffectiveCooldown(integer cardIdx)
		local base = self:GetCardCooldown(cardIdx) * self:GetSkillInvCooldownMult(cardIdx)
		if self.MagicBoosterLevel == 0 and self:GetSkillInvLevelByIndex(0) == 0 then return base end
		return base * (1.0 - self:GetMagicBoosterReduction())
	end

	-- 매직 크리티컬 레벨별 치명타 확률 — Lv1:10% / Lv2:12% / Lv3:15% / Lv4:17% / Lv5:20%.
	-- 획득(해금) 즉시 영구 적용(타이머/만료 없음), 치명타 시 대미지 ×2(곱연산).
	-- SkillInventory 매직크리티컬(인덱스8) 레벨의 +2%/+4%/+6%가 카드 자체 레벨과 별개로 항상 가산된다.
	method number GetMagicCriticalChance()
		local base = 0
		if self.MagicCriticalLevel >= 5 then base = 0.20
		elseif self.MagicCriticalLevel >= 4 then base = 0.17
		elseif self.MagicCriticalLevel >= 3 then base = 0.15
		elseif self.MagicCriticalLevel >= 2 then base = 0.12
		elseif self.MagicCriticalLevel >= 1 then base = 0.10
		end
		return base + self:GetSkillInvTierPercent(8, 0.02, 0.04, 0.06)
	end

	-- 액티브 스킬별 고유 SkillInventory 크리티컬 보너스(Lv9에서 활성화) — 썬더커터/아쿠아트랩 +5%, 더블커터 +10%
	@ExecSpace("ServerOnly")
	method number GetSkillInvCardCritBonus(integer cardIdx)
		if cardIdx == 13 or cardIdx == 14 then
			if self:GetSkillInvLevel(cardIdx) >= 9 then return 0.05 end
		elseif cardIdx == 20 then
			if self:GetSkillInvLevel(cardIdx) >= 9 then return 0.10 end
		end
		return 0
	end

	-- 매직 크리티컬(카드 자체 또는 SkillInventory) 보유 시 크리티컬 판정. cardIdx가 주어지면
	-- 해당 액티브 스킬 고유의 SkillInventory 크리티컬 보너스도 더한다.
	@ExecSpace("ServerOnly")
	method boolean RollCrit(integer cardIdx)
		local chance = self:GetMagicCriticalChance() + self:GetSkillInvCardCritBonus(cardIdx)
		if chance <= 0 then return false end
		return _UtilLogic:RandomDouble() < chance
	end

	-- ── 생명주기 ────────────────────────────────────────────────

	method void OnBeginPlay()
		if self:IsServer() then
			self._timerBasic = self.Card1Cooldown
			self._timerBasicArrow = self.ArrowShotCooldown
			self._timer1 = 0
			self._timer2 = 0
			self._timer3 = 0
			self._timer4 = 0
			self._timer5 = 0
			self._timer6 = 0
			self._potionTimer = 0
			log("CardManager started")
		else
			self._choiceClickHandler1 = self.choiceBtn1.Entity:ConnectEvent(ButtonClickEvent, function() self:SelectLevelUpChoice(1) end)
			self._choiceClickHandler2 = self.choiceBtn2.Entity:ConnectEvent(ButtonClickEvent, function() self:SelectLevelUpChoice(2) end)
			self._choiceClickHandler3 = self.choiceBtn3.Entity:ConnectEvent(ButtonClickEvent, function() self:SelectLevelUpChoice(3) end)

			self.slotBtn1.Entity:ConnectEvent(ButtonClickEvent, function() self:ShowTooltip(1) ; self:CheatCycleSlotLevel(1) end)
			self.slotBtn2.Entity:ConnectEvent(ButtonClickEvent, function() self:ShowTooltip(2) ; self:CheatCycleSlotLevel(2) end)
			self.slotBtn3.Entity:ConnectEvent(ButtonClickEvent, function() self:ShowTooltip(3) ; self:CheatCycleSlotLevel(3) end)
			self.slotBtn4.Entity:ConnectEvent(ButtonClickEvent, function() self:ShowTooltip(4) ; self:CheatCycleSlotLevel(4) end)
			self.slotBtn5.Entity:ConnectEvent(ButtonClickEvent, function() self:ShowTooltip(5) ; self:CheatCycleSlotLevel(5) end)
			self.slotBtn6.Entity:ConnectEvent(ButtonClickEvent, function() self:ShowTooltip(6) ; self:CheatCycleSlotLevel(6) end)

			self.tooltipPanel:SetEnable(false)

			-- 기본공격(파이어샷)은 슬롯과 무관하게 항상 활성 — 카드슬롯 좌측 원형 칼 아이콘
			self.basicAttackCooldown.Entity:SetEnable(true)
			self.basicAttackCooldown.FillAmount = 1
			for i = 1, 6 do
				self:UpdateSlotVisual(i, false)
			end
			self:UpdatePotionVisual()

			self._activeCooldowns = {}
			self._activeBuffOrder = {}
			self._cooldownTimerId = _TimerService:SetTimerRepeat(function()
				self:TickCooldownVisuals()
			end, 1/60)

			if self.DebugMode then
				self._debugKeyHandler = _InputService:ConnectEvent(KeyDownEvent, function(e)
					if e.key == KeyboardKey.L then
						self:DebugFreezingLevelUp()
					elseif e.key == KeyboardKey.K then
						self:DebugLevelUp()
					elseif e.key == KeyboardKey.P then
						self:DebugForceTimeAttackNear()
					elseif e.key == KeyboardKey.O then
						self:DebugResetSylphUnlock()
					end
				end)
			end
		end
	end

	-- 활성 쿨타임 연출들을 매 틱 한번에 갱신 (캐스트당 새 타이머를 만들지 않음)
	-- reversed=true 항목은 버프 아이콘용: 0→1 방향(처음엔 아이콘 보이고 점점 덮임)
	@ExecSpace("ClientOnly")
	method void TickCooldownVisuals()
		local now = _UtilLogic.ElapsedSeconds
		local i = 1
		while i <= #self._activeCooldowns do
			local entry = self._activeCooldowns[i]
			local remaining = entry.duration - (now - entry.startTime)
			if remaining <= 0 then
				entry.overlay.FillAmount = 0
				entry.overlay.Entity:SetEnable(false)
				table.remove(self._activeCooldowns, i)
			else
				if entry.reversed then
					entry.overlay.FillAmount = 1.0 - remaining / entry.duration
				else
					entry.overlay.FillAmount = remaining / entry.duration
				end
				i = i + 1
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		if name == "Slot1Card" then self:UpdateSlotVisual(1, true)
		elseif name == "Slot2Card" then self:UpdateSlotVisual(2, true)
		elseif name == "Slot3Card" then self:UpdateSlotVisual(3, true)
		elseif name == "Slot4Card" then self:UpdateSlotVisual(4, true)
		elseif name == "Slot5Card" then self:UpdateSlotVisual(5, true)
		elseif name == "Slot6Card" then self:UpdateSlotVisual(6, true)
		elseif name == "PotionLevel" then self:UpdatePotionVisual()
		elseif name == "AquaTrapLevel" then self:RefreshSlotIfHoldsCard(14)
		elseif name == "HailStoneLevel" then self:RefreshSlotIfHoldsCard(15)
		elseif name == "FreezingEffectLevel" then
			if self.FreezingEffectLevel > 0 then self:NotifyFreezeOnPermanent() end
			self:RefreshSlotIfHoldsCard(10)
		elseif name == "MagicArmorLevel" then
			if self.MagicArmorLevel > 0 then self:NotifyArmorOnPermanent() end
			self:RefreshSlotIfHoldsCard(18)
		elseif name == "MeditationLevel" then
			if self.MeditationLevel > 0 then self:NotifyMeditationOnPermanent() end
		elseif name == "EnergyBoltLevel" then self:RefreshSlotIfHoldsCard(9)
		elseif name == "IceCutterLevel" then self:RefreshSlotIfHoldsCard(11)
		elseif name == "KingPepeLevel" then self:RefreshSlotIfHoldsCard(12)
		elseif name == "ThunderCutterLevel" then self:RefreshSlotIfHoldsCard(13)
		elseif name == "ThunderBoltLevel" then self:RefreshSlotIfHoldsCard(4)
		elseif name == "ThunderStormLevel" then self:RefreshSlotIfHoldsCard(16)
		elseif name == "IceStrikeLevel" then self:RefreshSlotIfHoldsCard(17)
		elseif name == "ChainLightningLevel" then self:RefreshSlotIfHoldsCard(19)
		elseif name == "DoubleCutterLevel" then self:RefreshSlotIfHoldsCard(20)
		elseif name == "GrandPepeLevel" then self:RefreshSlotIfHoldsCard(21)
		elseif name == "HailBurstLevel" then self:RefreshSlotIfHoldsCard(23)
		elseif name == "AquaSurgeLevel" then self:RefreshSlotIfHoldsCard(24)
		elseif name == "ColdBeamLevel" then self:RefreshSlotIfHoldsCard(3)
		elseif name == "Card2UpgradeCount" then self:RefreshSlotIfHoldsCard(2)
		elseif name == "Card5UpgradeCount" then self:RefreshSlotIfHoldsCard(5)
		end
	end

	-- 슬롯 배정(Slot{n}Card)과 레벨 프로퍼티(EnergyBoltLevel 등)는 서로 다른 @Sync라서 클라이언트에
	-- 도착하는 순서가 보장되지 않는다. 슬롯 동기화가 레벨 동기화보다 먼저 도착하면 방금 얻은 카드가
	-- "Lv0"로 잠깐(또는 계속) 보이는 문제가 있었다 — 레벨 프로퍼티 쪽 동기화가 도착할 때도 그 카드가
	-- 지금 꽂혀있는 슬롯을 찾아 한 번 더 갱신해서, 두 동기화 중 나중에 도착하는 쪽이 항상 최종적으로
	-- 정확한 값을 그리도록 한다
	@ExecSpace("ClientOnly")
	method void RefreshSlotIfHoldsCard(integer cardIdx)
		local slotIdx = self:GetSlotForCard(cardIdx)
		if slotIdx > 0 then self:UpdateSlotVisual(slotIdx, false) end
	end

	-- ── 클라이언트 UI 갱신 ────────────────────────────────────────

	-- animate=true면 빈 슬롯(카드 뒷면)에서 새 카드로 뒤집히는 연출을 재생한다 (카드 획득 시점).
	-- OnBeginPlay의 최초 일괄 갱신은 animate=false로 호출해 뒤집히지 않고 바로 표시되게 한다.
	@ExecSpace("ClientOnly")
	method void UpdateSlotVisual(integer slotIdx, boolean animate)
		local slot = nil
		local icon = nil
		local num = nil
		local cooldown = nil
		local levelText = nil
		local nameText = nil
		local effectText = nil
		local labelBg = nil
		local levelBadgeBg = nil
		if slotIdx == 1 then slot = self.slot1 ; icon = self.icon1 ; num = self.slotNum1 ; cooldown = self.cooldown1 ; levelText = self.levelText1 ; nameText = self.nameText1 ; effectText = self.effectText1 ; labelBg = self.labelBg1 ; levelBadgeBg = self.levelBadgeBg1
		elseif slotIdx == 2 then slot = self.slot2 ; icon = self.icon2 ; num = self.slotNum2 ; cooldown = self.cooldown2 ; levelText = self.levelText2 ; nameText = self.nameText2 ; effectText = self.effectText2 ; labelBg = self.labelBg2 ; levelBadgeBg = self.levelBadgeBg2
		elseif slotIdx == 3 then slot = self.slot3 ; icon = self.icon3 ; num = self.slotNum3 ; cooldown = self.cooldown3 ; levelText = self.levelText3 ; nameText = self.nameText3 ; effectText = self.effectText3 ; labelBg = self.labelBg3 ; levelBadgeBg = self.levelBadgeBg3
		elseif slotIdx == 4 then slot = self.slot4 ; icon = self.icon4 ; num = self.slotNum4 ; cooldown = self.cooldown4 ; levelText = self.levelText4 ; nameText = self.nameText4 ; effectText = self.effectText4 ; labelBg = self.labelBg4 ; levelBadgeBg = self.levelBadgeBg4
		elseif slotIdx == 5 then slot = self.slot5 ; icon = self.icon5 ; num = self.slotNum5 ; cooldown = self.cooldown5 ; levelText = self.levelText5 ; nameText = self.nameText5 ; effectText = self.effectText5 ; labelBg = self.labelBg5 ; levelBadgeBg = self.levelBadgeBg5
		else slot = self.slot6 ; icon = self.icon6 ; num = self.slotNum6 ; cooldown = self.cooldown6 ; levelText = self.levelText6 ; nameText = self.nameText6 ; effectText = self.effectText6 ; labelBg = self.labelBg6 ; levelBadgeBg = self.levelBadgeBg6
		end

		local cardIdx = self:GetSlotCard(slotIdx)
		if cardIdx > 0 then
			if animate then
				-- 뒤집기 연출 도중(딜레이 구간) 레벨 등 다른 @Sync 프로퍼티가 뒤늦게 도착해도 낡은 값으로
				-- 덮어쓰지 않도록, 문자열을 지금 미리 캡처하지 않고 cardIdx만 넘겨서 연출이 실제로
				-- 뒤집히는 시점에 다시 계산하게 한다 (PlaySlotFlip 참고)
				self:PlaySlotFlip(slot, icon, levelText, nameText, effectText, labelBg, levelBadgeBg, cardIdx)
			else
				slot.ImageRUID = self.CardFrameRUID
				slot.Color = Color(1, 1, 1, 1)
				icon.ImageRUID = self:GetCardIconRUID(cardIdx)
				icon.Entity:SetEnable(true)
				labelBg.Entity:SetEnable(true)
				levelBadgeBg.Entity:SetEnable(true)
				levelText.Text = "Lv" .. self:GetSlotLevelNum(cardIdx)
				nameText.Text = self:GetSlotBaseName(cardIdx)
				effectText.Text = self:GetChoiceEffectTag(cardIdx)
			end
			num.Entity:SetEnable(true)
			-- PlayCooldownVisual이 OnSyncProperty보다 먼저 도착해 이미 쿨타임이 돌고 있을 수 있다 — 그 경우엔 끄면 안 된다.
			if not self:IsCooldownActive(cooldown) then
				cooldown.Entity:SetEnable(false)
				cooldown.FillAmount = 0
			end
		else
			-- 빈 슬롯은 카드 뒷면 이미지로 표시한다 (예전엔 ImageRUID를 비우고 어둡게 칠하기만 했음) —
			-- 앞면 전용 아이콘/라벨 배경/텍스트는 전부 꺼서 카드 뒷면 위에 겹쳐 보이면 안 된다
			slot.ImageRUID = self.EmptySlotRUID
			slot.Color = Color(1, 1, 1, 1)
			icon.Entity:SetEnable(false)
			labelBg.Entity:SetEnable(false)
			levelBadgeBg.Entity:SetEnable(false)
			levelText.Text = ""
			nameText.Text = ""
			effectText.Text = ""
			num.Entity:SetEnable(false)
			cooldown.Entity:SetEnable(false)
		end
	end

	-- 카드 뒷면 → 앞면으로 뒤집히는 연출: UIScale.x를 1→0으로 접고, 정확히 다 접힌 순간(폭이 0일 때)
	-- 프레임/아이콘/레벨·이름·효과 텍스트를 한꺼번에 새 카드로 바꾼 뒤 다시 0→1로 펼친다 — 종이를 세로축으로
	-- 뒤집는 느낌. Icon/LevelLabel 등은 slot(Card{n})의 자식이라 부모 UIScale을 그대로 따라가며 같이 접힌다
	@ExecSpace("ClientOnly")
	method void PlaySlotFlip(SpriteGUIRendererComponent slot, SpriteGUIRendererComponent icon, TextComponent levelText, TextComponent nameText, TextComponent effectText, SpriteGUIRendererComponent labelBg, SpriteGUIRendererComponent levelBadgeBg, integer cardIdx)
		local transform = slot.Entity.UITransformComponent
		_TweenLogic:PlayTween(1.0, 0.0, self.SlotFlipHalfDuration, EaseType.QuadEaseIn, function(value)
			if isvalid(transform) then
				local s = transform.UIScale
				transform.UIScale = Vector3(value, s.y, s.z)
			end
		end)
		_TimerService:SetTimerOnce(function()
			if not isvalid(slot) then return end
			-- 문자열은 지금(연출이 실제로 뒤집히는 시점) 다시 계산한다 — 딜레이 동안 레벨 등의 동기화가
			-- 뒤늦게 도착했더라도 항상 그 시점 기준 최신 값을 그린다
			slot.ImageRUID = self.CardFrameRUID
			slot.Color = Color(1, 1, 1, 1)
			if isvalid(icon) then
				icon.ImageRUID = self:GetCardIconRUID(cardIdx)
				icon.Entity:SetEnable(true)
			end
			if isvalid(labelBg) then labelBg.Entity:SetEnable(true) end
			if isvalid(levelBadgeBg) then levelBadgeBg.Entity:SetEnable(true) end
			if isvalid(levelText) then levelText.Text = "Lv" .. self:GetSlotLevelNum(cardIdx) end
			if isvalid(nameText) then nameText.Text = self:GetSlotBaseName(cardIdx) end
			if isvalid(effectText) then effectText.Text = self:GetChoiceEffectTag(cardIdx) end
			if isvalid(transform) then
				_TweenLogic:PlayTween(0.0, 1.0, self.SlotFlipHalfDuration, EaseType.QuadEaseOut, function(value)
					if isvalid(transform) then
						local s = transform.UIScale
						transform.UIScale = Vector3(value, s.y, s.z)
					end
				end)
			end
		end, self.SlotFlipHalfDuration)
	end

	@ExecSpace("ClientOnly")
	method void UpdatePotionVisual()
		if self.PotionLevel == 0 then
			self.potionSlot.Color = Color(0.2, 0.2, 0.2, 0.45)
			self.potionImage.Color = Color(1, 1, 1, 0)
			self.potionCooldown.Entity:SetEnable(false)
		else
			-- 카드슬롯 프레임과 동일한 톤(짙은 남색)으로 칠해서 흰 박스로 보이지 않게 한다
			self.potionSlot.Color = Color(0.15, 0.12, 0.38, 1)
			local ruid = self.Potion1RUID
			if self.PotionLevel == 2 then ruid = self.Potion2RUID
			elseif self.PotionLevel == 3 then ruid = self.Potion3RUID
			elseif self.PotionLevel == 4 then ruid = self.Potion4RUID
			elseif self.PotionLevel == 5 then ruid = self.Potion5RUID
			end
			self.potionImage.ImageRUID = ruid
			self.potionImage.Color = Color(1, 1, 1, 1)
			-- 처음 얻거나 레벨업한 시점엔 보통 쿨타임이 없으므로 오버레이를 끈 채로 둔다.
			-- 단, 체력이 닳아있던 상태라면 같은 프레임에 곧바로 실제 사용(PlayPotionCooldownVisual)이
			-- 먼저 일어나 쿨타임이 이미 돌고 있을 수 있다 — 그 경우엔 여기서 꺼버리면 안 된다.
			if not self:IsCooldownActive(self.potionCooldown) then
				self.potionCooldown.Entity:SetEnable(false)
				self.potionCooldown.FillAmount = 0
			end
		end
	end

	@ExecSpace("ClientOnly")
	method boolean IsCooldownActive(SpriteGUIRendererComponent overlay)
		for i = 1, #self._activeCooldowns do
			if self._activeCooldowns[i].overlay == overlay then return true end
		end
		return false
	end

	@ExecSpace("Multicast")
	method void NotifyBoosterOn(number duration)
		if self:IsServer() then return end
		self:ShowBuffIcon(self.boosterBuff, self.boosterFill, duration)
	end

	@ExecSpace("Multicast")
	method void NotifyBoosterOff()
		if self:IsServer() then return end
		self:HideBuffIcon(self.boosterBuff, self.boosterFill)
	end

	@ExecSpace("Multicast")
	method void NotifyCritOn(number duration)
		if self:IsServer() then return end
		self:ShowBuffIcon(self.critBuff, self.critFill, duration)
	end

	@ExecSpace("Multicast")
	method void NotifyCritOff()
		if self:IsServer() then return end
		self:HideBuffIcon(self.critBuff, self.critFill)
	end

	@ExecSpace("Multicast")
	method void NotifyBoosterOnPermanent()
		if self:IsServer() then return end
		self:ShowBuffIconPermanent(self.boosterBuff, self.boosterFill)
	end

	@ExecSpace("Multicast")
	method void NotifyCritOnPermanent()
		if self:IsServer() then return end
		self:ShowBuffIconPermanent(self.critBuff, self.critFill)
	end

	@ExecSpace("Multicast")
	method void NotifyFreezeOnPermanent()
		if self:IsServer() then return end
		self:ShowBuffIconPermanent(self.freezeBuff, self.freezeFill)
	end

	@ExecSpace("Multicast")
	method void NotifyArmorOnPermanent()
		if self:IsServer() then return end
		self:ShowBuffIconPermanent(self.armorBuff, self.armorFill)
	end

	@ExecSpace("Multicast")
	method void NotifyMeditationOnPermanent()
		if self:IsServer() then return end
		self:ShowBuffIconPermanent(self.meditationBuff, self.meditationFill)
	end

	@ExecSpace("ClientOnly")
	method void ShowBuffIconPermanent(Entity panel, SpriteGUIRendererComponent fill)
		-- 영구 패시브 버프 아이콘 표시 — 잔여시간 fill 없이 아이콘만 상시 표시
		if panel == nil or fill == nil then return end
		if self._activeBuffOrder == nil then self._activeBuffOrder = {} end

		local buffName = ""
		if panel == self.boosterBuff then buffName = "booster"
		elseif panel == self.critBuff then buffName = "crit"
		elseif panel == self.freezeBuff then buffName = "freeze"
		elseif panel == self.armorBuff then buffName = "armor"
		elseif panel == self.meditationBuff then buffName = "meditation"
		end
		if buffName ~= "" then
			local found = false
			for _, name in ipairs(self._activeBuffOrder) do
				if name == buffName then found = true; break end
			end
			if not found then table.insert(self._activeBuffOrder, buffName) end
		end

		-- fill 오버레이의 activeCooldowns 항목 제거 (이전에 duration 방식으로 등록됐을 경우 정리)
		if self._activeCooldowns ~= nil then
			for i = #self._activeCooldowns, 1, -1 do
				if self._activeCooldowns[i].overlay == fill then
					table.remove(self._activeCooldowns, i)
				end
			end
		end

		panel:SetEnable(true)
		fill.Entity:SetEnable(false)  -- 영구 활성이므로 잔여시간 표시 불필요
		self:RepositionBuffIcons()
	end

	@ExecSpace("ClientOnly")
	method void ShowBuffIcon(Entity panel, SpriteGUIRendererComponent fill, number duration)
		if panel == nil or fill == nil then return end
		if self._activeBuffOrder == nil then self._activeBuffOrder = {} end

		local buffName = ""
		if panel == self.boosterBuff then buffName = "booster"
		elseif panel == self.critBuff then buffName = "crit"
		elseif panel == self.freezeBuff then buffName = "freeze"
		elseif panel == self.armorBuff then buffName = "armor"
		elseif panel == self.meditationBuff then buffName = "meditation"
		end
		if buffName ~= "" then
			local found = false
			for _, name in ipairs(self._activeBuffOrder) do
				if name == buffName then found = true; break end
			end
			if not found then table.insert(self._activeBuffOrder, buffName) end
		end

		panel:SetEnable(true)
		fill.Entity:SetEnable(true)
		fill.FillAmount = 0.0
		self:RegisterBuffVisual(fill, duration)
		self:RepositionBuffIcons()
	end

	@ExecSpace("ClientOnly")
	method void HideBuffIcon(Entity panel, SpriteGUIRendererComponent fill)
		if panel == nil then return end
		if self._activeBuffOrder == nil then self._activeBuffOrder = {} end

		local buffName = ""
		if panel == self.boosterBuff then buffName = "booster"
		elseif panel == self.critBuff then buffName = "crit"
		elseif panel == self.freezeBuff then buffName = "freeze"
		elseif panel == self.armorBuff then buffName = "armor"
		elseif panel == self.meditationBuff then buffName = "meditation"
		end
		if buffName ~= "" then
			for i = #self._activeBuffOrder, 1, -1 do
				if self._activeBuffOrder[i] == buffName then
					table.remove(self._activeBuffOrder, i)
				end
			end
		end

		panel:SetEnable(false)
		if fill ~= nil and self._activeCooldowns ~= nil then
			for i = #self._activeCooldowns, 1, -1 do
				if self._activeCooldowns[i].overlay == fill then
					table.remove(self._activeCooldowns, i)
				end
			end
		end
		self:RepositionBuffIcons()
	end

	@ExecSpace("ClientOnly")
	method void RepositionBuffIcons()
		if self._activeBuffOrder == nil then return end
		local iconSize = 50
		local iconGap = 4
		local startX = 20
		local startY = 195
		for i = 1, #self._activeBuffOrder do
			local buffName = self._activeBuffOrder[i]
			local panel = nil
			if buffName == "booster" then panel = self.boosterBuff
			elseif buffName == "crit" then panel = self.critBuff
			elseif buffName == "freeze" then panel = self.freezeBuff
			elseif buffName == "armor" then panel = self.armorBuff
			elseif buffName == "meditation" then panel = self.meditationBuff
			end
			if panel ~= nil then
				local tf = panel:GetComponent(UITransformComponent)
				if tf ~= nil then
					tf["anchoredPosition"] = Vector2(startX + (i-1) * (iconSize + iconGap), startY)
				end
			end
		end
	end

	-- ── 말풍선 ───────────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void ShowTooltip(integer slotIdx)
		local cardIdx = self:GetSlotCard(slotIdx)
		if cardIdx <= 0 then
			self.tooltipPanel:SetEnable(false)
			return
		end

		-- 이름 (카드 2~4: 강화 횟수 표시)
		local name = ""
		if cardIdx == 2 then
			name = "매직 클로"
			if self.Card2UpgradeCount > 0 then name = name .. " (+" .. self.Card2UpgradeCount .. "강화)" end
		elseif cardIdx == 3 then
			name = "콜드 빔 Lv." .. self.ColdBeamLevel
		elseif cardIdx == 4 then
			name = "썬더 볼트 Lv." .. self.ThunderBoltLevel
		elseif cardIdx == 5 then name = "메테오"
		elseif cardIdx == 7 then name = "매직 부스터 Lv." .. self.MagicBoosterLevel
		elseif cardIdx == 8 then name = "매직 크리티컬 Lv." .. self.MagicCriticalLevel
		elseif cardIdx == 9 then name = self.Card9Name .. " Lv." .. self.EnergyBoltLevel
		elseif cardIdx == 10 then name = self.Card10Name .. " Lv." .. self.FreezingEffectLevel
		elseif cardIdx == 11 then name = self.Card11Name .. " Lv." .. self.IceCutterLevel
		elseif cardIdx == 12 then name = self.Card12Name .. " Lv." .. self.KingPepeLevel
		elseif cardIdx == 13 then name = self.Card13Name .. " Lv." .. self.ThunderCutterLevel
		elseif cardIdx == 14 then name = self.Card14Name .. " Lv." .. self.AquaTrapLevel
		elseif cardIdx == 15 then name = self.Card15Name .. " Lv." .. self.HailStoneLevel
		elseif cardIdx == 16 then name = self.Card16Name .. " Lv." .. self.ThunderStormLevel
		elseif cardIdx == 17 then name = self.Card17Name .. " Lv." .. self.IceStrikeLevel
		elseif cardIdx == 18 then name = self.Card18Name .. " Lv." .. self.MagicArmorLevel
		elseif cardIdx == 19 then name = self.Card19Name .. " Lv." .. self.ChainLightningLevel
		elseif cardIdx == 20 then name = self.Card20Name .. " Lv." .. self.DoubleCutterLevel
		elseif cardIdx == 21 then name = self.Card21Name .. " Lv." .. self.GrandPepeLevel
		elseif cardIdx == 22 then name = self.Card22Name .. " Lv." .. self.MeditationLevel
		elseif cardIdx == 23 then name = self.Card23Name .. " Lv." .. self.HailBurstLevel
		elseif cardIdx == 24 then name = self.Card24Name .. " Lv." .. self.AquaSurgeLevel
		elseif cardIdx == 101 then name = self.Card101Name .. " Lv." .. self.WindPoemLevel
		end

		-- 데미지
		local dmg = ""
		if cardIdx == 2 then dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 3 then dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 4 then dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 5 then dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 7 then
			dmg = "쿨타임 -" .. math.floor(self:GetMagicBoosterReduction() * 100) .. "%  (영구)"
		elseif cardIdx == 8 then
			dmg = "크리티컬 " .. math.floor(self:GetMagicCriticalChance() * 100) .. "%  (영구)"
		elseif cardIdx == 9 then
			local lv = self.EnergyBoltLevel
			local hits = (lv >= 2) and "  ×2" or "  ×1"
			dmg = "대미지 : " .. math.floor(self:GetCardDamage(cardIdx)) .. hits
		elseif cardIdx == 10 then
			local bonusPct = (self.FreezingEffectLevel >= 2) and 6 or 5
			dmg = "아이스 보너스 : +" .. bonusPct .. "%/스택"
		elseif cardIdx == 11 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx)) .. "  (반경 " .. string.format("%.1f", self:GetIceCutterRadius(self.IceCutterLevel)) .. ")"
		elseif cardIdx == 12 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 13 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx)) .. "  (반경 " .. string.format("%.1f", self.Card13Radius) .. ")"
		elseif cardIdx == 14 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 15 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 16 then
			local d1 = self:GetThunderStormHitDamage(self.ThunderStormLevel, 1)
			local d2 = self:GetThunderStormHitDamage(self.ThunderStormLevel, 2)
			local d3 = self:GetThunderStormHitDamage(self.ThunderStormLevel, 3)
			dmg = "데미지 : " .. d1 .. "/" .. d2 .. "/" .. d3 .. "  (반경 " .. string.format("%.1f", self.Card16Radius) .. ")"
		elseif cardIdx == 17 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 18 then
			dmg = "피해 감소 : -" .. math.floor(self:GetMagicArmorReduction() * 100) .. "%  (영구)"
		elseif cardIdx == 19 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 20 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 21 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 22 then
			dmg = "데미지 증가 : +" .. self:GetMeditationPercent() .. "%  (영구)"
		elseif cardIdx == 23 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 24 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 101 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		end

		-- 쿨타임 (부스터 활성 중이면 실효 쿨타임 추가 표시)
		local cd = self:GetCardCooldown(cardIdx)
		local cdStr = (cardIdx == 10 or cardIdx == 18 or cardIdx == 22) and "패시브 스킬" or ("쿨타임 : " .. string.format("%.1f", cd) .. "s")
		local boosterOn = false
		if self._activeBuffOrder ~= nil then
			for _, n in ipairs(self._activeBuffOrder) do
				if n == "booster" then boosterOn = true; break end
			end
		end
		if boosterOn and self.MagicBoosterLevel > 0 then
			local effectiveCd = cd * (1.0 - self:GetMagicBoosterReduction())
			cdStr = cdStr .. "  →  " .. string.format("%.1f", effectiveCd) .. "s ★"
		end

		-- 특수 효과 / 추가 정보 (4번째 줄)
		local extraStr = ""
		if cardIdx == 2 then
			extraStr = "타겟 : " .. (1 + self.Card2UpgradeCount) .. "명"
		elseif cardIdx == 3 then
			extraStr = "타겟 : " .. self:GetColdBeamTargetCount() .. "명  |  슬로우 3s"
		elseif cardIdx == 4 then
			local targets = self:GetThunderBoltTargetCount()
			local stunPct = math.floor(self:GetThunderBoltStunChance() * 100)
			local stunDur = self:GetThunderBoltStunDuration()
			if stunDur > 0 then
				extraStr = "타겟 " .. targets .. "명  |  스턴 " .. stunPct .. "% " .. string.format("%.0f", stunDur) .. "초(보스/엘리트 " .. string.format("%.1f", stunDur * 0.5) .. "초)"
			else
				extraStr = "타겟 " .. targets .. "명"
			end
		elseif cardIdx == 5 then
			extraStr = "전체 범위  |  화염 DoT 3회"
		elseif cardIdx == 9 then
			local lv = self.EnergyBoltLevel
			if lv >= 2 then extraStr = "2연발  0.1초 간격" end
			if lv >= 3 then
				if extraStr ~= "" then extraStr = extraStr .. "  |  " end
				extraStr = extraStr .. "치명타 20%"
			end
			if lv >= 5 then
				if extraStr ~= "" then extraStr = extraStr .. "  |  " end
				extraStr = extraStr .. "폭발 " .. math.floor(self:GetCardDamage(9) * 1.2) .. " 광역"
			end
		elseif cardIdx == 10 then
			local lv = self.FreezingEffectLevel
			if lv >= 5 then
				extraStr = "연쇄 3마리(50/35/15%)  |  5스택 시 빙결폭발(AOE 80%)"
			elseif lv >= 4 then
				extraStr = "연쇄 번개 2마리 (50%/35%)"
			elseif lv >= 3 then
				extraStr = "연쇄 번개 1마리 (50%)"
			end
		elseif cardIdx == 11 then
			local lv = self.IceCutterLevel
			local bleedPct = math.floor(self:GetIceCutterBleedPercent(lv) * 100)
			extraStr = "타겟 " .. self:GetIceCutterTargetCount(lv) .. "명  |  범위 광역"
			if bleedPct > 0 then extraStr = extraStr .. "  |  출혈 " .. bleedPct .. "%/틱 (3초)" end
		elseif cardIdx == 12 then
			local coverage = (self.KingPepeLevel >= 3) and "2/4 범위" or "1/4 범위"
			extraStr = "고정 위치  |  " .. coverage
			if self.KingPepeLevel >= 5 then extraStr = extraStr .. "  |  25% 확률 2연타(2타 50%)" end
		elseif cardIdx == 13 then
			local lv = self.ThunderCutterLevel
			local shots = self:GetThunderCutterShotCount()
			extraStr = "범위 광역  |  " .. shots .. "타"
			if lv >= 3 then extraStr = extraStr .. "  |  넉백" end
		elseif cardIdx == 14 then
			local targetCount = self:GetAquaTrapTargetCount()
			local rootDuration = self:GetAquaTrapRootDuration()
			extraStr = "타겟 " .. targetCount .. "명  |  속박 " .. string.format("%.0f", rootDuration) .. "초"
		elseif cardIdx == 15 then
			extraStr = "타겟 " .. self:GetHailStoneTargetCount() .. "명  |  빙결 스택+1"
		elseif cardIdx == 16 then
			local lv = self.ThunderStormLevel
			local stunPct = math.floor(self:GetThunderStormStunChance(lv) * 100)
			extraStr = "타겟 " .. self:GetThunderStormTargetCount(lv) .. "명  |  3연타  |  스턴 " .. stunPct .. "% " .. string.format("%.0f", self.Card16StunDuration) .. "초"
		elseif cardIdx == 17 then
			extraStr = "타겟 " .. self:GetIceStrikeTargetCount(self.IceStrikeLevel) .. "명  |  슬로우+빙결 스택2"
		elseif cardIdx == 19 then
			local lv = self.ChainLightningLevel
			extraStr = "연쇄 " .. self:GetChainLightningTargetCount(lv) .. "명  |  치명타+20%  |  마지막 착탄 +" .. math.floor(self:GetChainLightningFinalBonusMult(lv) * 100) .. "%"
		elseif cardIdx == 20 then
			extraStr = "제자리 광역(출혈+넉백) → 좌우 관통  |  출혈 5%/틱  |  넉백"
		elseif cardIdx == 21 then
			local lv = self.GrandPepeLevel
			local coverage = (lv >= 3) and "4/4 범위" or (lv >= 1) and "3/4 범위" or "2/4 범위"
			local procPct = math.floor(self:GetGrandPepeProcChance() * 100)
			extraStr = "고정 위치  |  " .. coverage .. "  |  " .. procPct .. "% 확률 2연타(2타 50%)"
		elseif cardIdx == 23 then
			local splashPct = math.floor(self:GetHailBurstSplashPercent() * 100)
			extraStr = "타겟 " .. self:GetHailBurstTargetCount() .. "명  |  빙결 스택+1  |  바닥 범위기 " .. splashPct .. "%"
		elseif cardIdx == 24 then
			local extraPct = math.floor(self:GetAquaSurgeExtraPercent() * 100)
			extraStr = "타겟 " .. self:GetAquaSurgeTargetCount() .. "명  |  속박 3초  |  종료 0.5초 전 추가타 " .. extraPct .. "%"
		elseif cardIdx == 101 then
			extraStr = "타겟 " .. self:GetWindPoemTargetCount() .. "명"
		end

		self.tooltipName.Text  = name
		self.tooltipDmg.Text   = dmg
		self.tooltipCd.Text    = cdStr
		self.tooltipExtra.Text = extraStr

		-- 클릭한 슬롯 위로 위치 이동 (꼬리 tip이 슬롯 상단 5px 위에 위치하도록)
		-- 슬롯 top = slotPos.y + 82.5, tail tip = ty - 70 → ty = slotPos.y + 82.5 + 5 + 70
		local slotPos = self:GetSlotUIPosition(slotIdx)
		local tx = math.max(-740, math.min(740, slotPos.x))
		local ty = slotPos.y + 158
		local tf = self.tooltipPanel:GetComponent(UITransformComponent)
		if tf ~= nil then
			tf["anchoredPosition"] = Vector2(tx, ty)
		end

		self.tooltipPanel:SetEnable(true)
		log("툴팁: " .. name .. " / " .. dmg .. " / " .. cdStr .. " / " .. extraStr)

		-- 3초 후 자동 닫기 (토큰으로 중복 방지)
		self._tooltipToken = self._tooltipToken + 1
		local token = self._tooltipToken
		_TimerService:SetTimerOnce(function()
			if self._tooltipToken == token then
				self.tooltipPanel:SetEnable(false)
			end
		end, 3.0)
	end

	-- ── 매 프레임 (서버) ─────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if _GameManager.GameOver then return end
		-- 월드 시작 첫 프레임들에서는 다른 Logic(MonsterSpawner)의 전역 참조가 아직 등록되기 전일 수 있다
		-- (Logic끼리는 초기화 순서가 보장되지 않음) — 그 사이 FindTarget이 _MonsterSpawner를 인덱싱하면
		-- [LEA-2007] AttemptToIndex 에러가 난다. 등록될 때까지 이번 프레임은 건너뛴다.
		if _MonsterSpawner == nil then return end

		local target = self:FindTarget()

		-- 기본공격은 슬롯 배치와 무관하게 항상 활성 — 캐릭터별로 완전히 다른 트랙을 탄다
		-- (0=아르카나: 파이어샷, 1=실피드: 애로우샷)
		if _GameManager.SelectedCharacter == 1 then
			self._timerBasicArrow = self:TickCard(25, 0, self._timerBasicArrow, delta, target)
		else
			self._timerBasic = self:TickCard(1, 0, self._timerBasic, delta, target)
		end

		-- 슬롯 1~5: 배치된 카드가 있을 때만 동작 (1번 슬롯부터 채워짐)
		if self.Slot1Card > 0 then self._timer1 = self:TickCard(self.Slot1Card, 1, self._timer1, delta, target) end
		if self.Slot2Card > 0 then self._timer2 = self:TickCard(self.Slot2Card, 2, self._timer2, delta, target) end
		if self.Slot3Card > 0 then self._timer3 = self:TickCard(self.Slot3Card, 3, self._timer3, delta, target) end
		if self.Slot4Card > 0 then self._timer4 = self:TickCard(self.Slot4Card, 4, self._timer4, delta, target) end
		if self.Slot5Card > 0 then self._timer5 = self:TickCard(self.Slot5Card, 5, self._timer5, delta, target) end
		if self.Slot6Card > 0 then self._timer6 = self:TickCard(self.Slot6Card, 6, self._timer6, delta, target) end

		-- 포션 자동 사용 — 체력이 가득 찬 동안은 쿨타임을 돌리지 않고 대기, 실제로 회복이 필요해지는 순간 바로 사용한다
		if self.PotionLevel > 0 then
			self._potionTimer = self._potionTimer - delta
			if self._potionTimer <= 0 and _GameManager.PlayerHp < _GameManager.PlayerMaxHp then
				local healPct = 0.1 + (self.PotionLevel - 1) * 0.05
				local healAmount = math.floor(_GameManager.PlayerMaxHp * healPct)
				_GameManager:HealPlayer(healAmount)
				self:PlayPotionCooldownVisual(self.PotionCooldown)
				-- 체력이 가득 차 대기하는 동안 _potionTimer가 깊은 음수로 쌓일 수 있어,
				-- 더해주는 대신 정확히 쿨타임 값으로 리셋해야 한다 (안 그러면 음수 잔량이 남아 연속으로 재발동된다)
				self._potionTimer = self.PotionCooldown
			end
		end

		-- 매직 부스터/크리티컬은 영구 패시브 — 타이머 카운트다운 없음
	end

	@ExecSpace("ServerOnly")
	method number TickCard(integer cardIndex, integer slotIndex, number timer, number delta, MonsterAI target)
		local cooldown = self:GetEffectiveCooldown(cardIndex)
		local damage   = self:GetCardDamage(cardIndex)

		-- 쿨타임은 0 밑으로 내려가지 않고, 다 차면(0) "활성화 상태"로 대기한다
		if timer > 0 then
			timer = timer - delta
			if timer < 0 then timer = 0 end
		end

		if timer <= 0 then
			local aliveTarget = (target ~= nil and not target._dead)

			-- 적이 없으면 활성화 상태로 대기만 한다 (연출 재생/재시작 없음)
			if aliveTarget then
				local isCrit = self:RollCrit(cardIndex)
				if cardIndex == 2 then
					self:MagicClawAttack(damage, isCrit)
				elseif cardIndex == 3 then
					self:ColdBeamAttack(damage, isCrit)
				elseif cardIndex == 4 then
					self:ThunderAttack(damage, isCrit)
				elseif cardIndex == 5 then
					self:MeteorAttack(damage, isCrit)
				elseif cardIndex == 9 then
					self:EnergyBoltAttack(target)
				elseif cardIndex == 11 then
					self:IceCutterAttack(damage, isCrit, target)
				elseif cardIndex == 12 then
					self:KingPepeAttack(damage, isCrit, target, false)
				elseif cardIndex == 13 then
					self:ThunderCutterAttack(damage, isCrit, target)
				elseif cardIndex == 14 then
					self:AquaTrapAttack(damage, isCrit)
				elseif cardIndex == 15 then
					self:HailStoneAttack(damage, isCrit)
				elseif cardIndex == 16 then
					self:ThunderStormAttack(isCrit, target)
				elseif cardIndex == 17 then
					self:IceStrikeAttack(isCrit, target)
				elseif cardIndex == 19 then
					self:ChainLightningAttack(target)
				elseif cardIndex == 20 then
					self:DoubleCutterAttack(isCrit, target)
				elseif cardIndex == 21 then
					self:GrandPepeAttack(damage, isCrit, target, false)
				elseif cardIndex == 23 then
					self:HailBurstAttack(damage, isCrit)
				elseif cardIndex == 24 then
					self:AquaSurgeAttack(damage, isCrit)
				elseif cardIndex == 101 then
					self:WindPoemAttack(damage, isCrit)
				else
					if isCrit then target:TakeDamageCrit(damage * 2)
					else target:TakeDamage(damage) end
					if cardIndex == 1 then
						-- 파이어샷: 플레이어 쪽(화면 아래, 크게)에서 시작해 타겟 쪽으로 날아가며
						-- 점점 작아져 화면 속으로 빨려들어가는 듯한 느낌을 준다 (회전 90도, 배속 1.5배, 알파 10% 감소)
						local p1 = target.Entity.TransformComponent.Position
						local hitPos = Vector3(p1.x, p1.y + 0.3, p1.z)
						local startPos = Vector3(hitPos.x, hitPos.y - 0.8, hitPos.z)
						local fx = self:SpawnEffect(self.Card1EffectRUID, startPos, 90, 1.5, 2.5 * (self:GetEffectScaleRatio(target)), 0.9)
						self:FlyFireShot(fx, startPos, hitPos)
					elseif cardIndex == 25 then
						-- 애로우샷: 원본 화살(폭탄화살) 스프라이트가 옆보기(가로로 긴 형태)라, 파이어샷과
						-- 동일한 이동 트릭(수직으로만 이동+축소)에 맞춰 회전해서 긴 축을 이동 방향(수직)에
						-- 맞춘다. 90도 회전은 화살촉이 아래를 향해 유저가 실측 확인 — 180도 더 돌려(270도)
						-- 화살촉이 위(타겟 쪽)를 향하게 한다.
						local p1 = target.Entity.TransformComponent.Position
						local hitPos = Vector3(p1.x, p1.y + 0.3, p1.z)
						local startPos = Vector3(hitPos.x, hitPos.y - 0.8, hitPos.z)
						local fx = self:SpawnEffect(self.ArrowShotEffectRUID, startPos, 270, 1.5, 2.5 * (self:GetEffectScaleRatio(target)), 0.9)
						self:FlyArrowShot(fx, startPos, hitPos)

						-- 착탄 연출(원래 바람의 시가 쓰던 hit/2~5 무작위 세트, 유저 요청으로 이관) —
						-- FlyArrowShot 내부 비행 duration(0.16초)과 동일하게 맞춰야 착탄 타이밍이 안 어긋난다.
						_TimerService:SetTimerOnce(function()
							if not isvalid(self) then return end
							local scaleRatio = isvalid(target) and self:GetEffectScaleRatio(target) or 1.0
							local hitRUID = self:GetRandomArrowShotHitRUID()
							self:SpawnEffect(hitRUID, hitPos, 0, 1.0, self.ArrowShotHitScale * scaleRatio, 1)
						end, 0.16)
					end
				end
				-- 적을 맞췄을 때만 쿨타임 연출을 새로 재생하고 다시 채운다
				self:PlayCooldownVisual(slotIndex, cooldown)
				timer = cooldown
			end
		end
		return timer
	end

	-- 모든 스킬 연출이 SpawnEffectWithModel에서 공용으로 쓰는 깊이 여유값 — 타겟의 현재 깊이(Z)보다
	-- 이만큼만 앞으로 당겨서, 자기 몬스터에게 안 덮이면서도 다른(앞/뒤) 몬스터와의 상대적 깊이
	-- 순서는 그대로 유지한다.
	property number EffectDepthEpsilon = 0.2

	@ExecSpace("ServerOnly")
	method Entity SpawnEffect(string ruid, Vector3 pos, number rotationZ, number playRate, number scale, number alpha)
		return self:SpawnEffectWithModel(ruid, pos, rotationZ, playRate, scale, alpha, "skilleffect")
	end

	-- SpawnEffect와 동일하지만 스폰할 모델을 직접 고른다 — 대부분의 스킬은 공용 "skilleffect"
	-- (SkillEffectAI.Duration=0.8초 고정)를 쓰지만, 15프레임 이상의 긴 연출(예: 썬더스톰)은
	-- "skilleffectlong"(Duration=2.5초)이 필요하다. 원래 "skilleffect" 자체의 Duration을 2.5초로
	-- 늘렸다가 다른 모든 스킬 이펙트까지 같이 길어져버린 적이 있어서(유저 피드백: "연출이 다 길어진
	-- 것 같다"), 긴 연출이 필요한 스킬만 별도 모델을 쓰도록 분리했다.
	@ExecSpace("ServerOnly")
	method Entity SpawnEffectWithModel(string ruid, Vector3 pos, number rotationZ, number playRate, number scale, number alpha, string modelId)
		local map = self:GetCurrentMap()
		if map == nil then return nil end
		-- Z는 그대로 물려받지 않고 pos.z(=타겟의 현재 깊이, MonsterAI:UpdateDepth()가 매 프레임
		-- Z=1.5-_currentScale로 갱신해두는 값)를 기준으로 살짝만(EffectDepthEpsilon) 앞으로 당긴다.
		-- 예전엔 무조건 고정값(-0.1, 화면에서 가장 앞)을 썼는데, 그러면 뒤에 있는 몹의 연출이 앞에
		-- 있는 다른 몹보다도 항상 위에 덮여 그려지는 문제가 있었다(유저 피드백: "앞에 있는 게 가장
		-- 위, 뒤에 있는 몹 연출은 뒤에 깔려야지") — 상대적 깊이 순서를 지키도록 타겟 자신의 깊이
		-- 기준으로 바꿨다. 단, 타겟이 그 사이 계속 접근해서(_currentScale 증가→Z 감소) 아주 긴
		-- 연출(skilleffectlong, 최대 2.5초) 막바지에는 자기 몬스터가 자기 연출을 다시 추월할 수도
		-- 있다(예전 고정값 방식은 이 경우를 완전히 막았지만 상대적 깊이 순서를 항상 깨트렸다) — 짧은
		-- 연출 대부분에서는 이 정도 여유(epsilon)로 충분히 앞서 있는다.
		local fxPos = Vector3(pos.x, pos.y, pos.z - self.EffectDepthEpsilon)
		local e = _SpawnService:SpawnByModelId(modelId, "FX", fxPos, map)
		if e == nil then return nil end
		local renderer = e.SpriteRendererComponent
		if renderer ~= nil then
			renderer.SpriteRUID = ruid
			renderer.PlayRate = playRate
			if alpha ~= 1 then renderer.Color = Color(1, 1, 1, alpha) end
			log("SpawnEffect: ruid=" .. ruid .. " playRate=" .. playRate)
		end
		local tc = e.TransformComponent
		if tc ~= nil and rotationZ ~= 0 then tc.ZRotation = rotationZ end
		if tc ~= nil and scale ~= 1 then tc.Scale = Vector3(scale, scale, 1) end
		return e
	end

	@ExecSpace("ServerOnly")
	method void FlyFireShot(Entity fx, Vector3 startPos, Vector3 endPos)
		-- 플레이어 쪽(아래, 큰 스케일)에서 타겟 쪽(작은 스케일)으로 날아가 화면 속으로 빨려들어가는 느낌을 준다
		if fx == nil then return end
		local duration = 0.16
		local startScale = 2.5
		local endScale = 1.0

		_TweenLogic:PlayTween(0.0, 1.0, duration, EaseType.QuadEaseIn, function(t)
			if not isvalid(fx) then return end
			local x = startPos.x + (endPos.x - startPos.x) * t
			local y = startPos.y + (endPos.y - startPos.y) * t
			-- Z는 항상 -0.1로 고정 (몬스터보다 앞에 유지 — SpawnEffect와 동일한 이유)
			fx.TransformComponent.Position = Vector3(x, y, -0.1)
			local scale = startScale + (endScale - startScale) * t
			fx.TransformComponent.Scale = Vector3(scale, scale, 1)
		end)

		-- 착탄 후: 불꽃이 사방으로 퍼지며 알파가 빠지는 연출
		_TimerService:SetTimerOnce(function()
			if not isvalid(fx) then return end
			local impactDuration = 0.28
			_TweenLogic:PlayTween(0.0, 1.0, impactDuration, EaseType.QuadEaseOut, function(t)
				if not isvalid(fx) then return end
				local s = 1.0 + t * 0.75
				fx.TransformComponent.Scale = Vector3(s, s, 1)
				local renderer = fx.SpriteRendererComponent
				if renderer ~= nil then
					renderer.Color = Color(1, 1, 1, 0.9 * (1.0 - t))
				end
			end)
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) then fx:Destroy() end
			end, impactDuration)
		end, duration)
	end

	-- 애로우샷(실피드) 전용 비행 연출 — 비행 구간은 파이어샷과 동일(크게 시작해 작아지며 날아감)하지만,
	-- 착탄 후 불꽃처럼 커지며 퍼지는 대신 화살이 "박히는" 느낌으로 한 번 더 작아지며 빠르게 사라진다
	-- (유저 요청: "몬스터한테 박힐때는 스케일이 작아져야 자연스러울듯").
	@ExecSpace("ServerOnly")
	method void FlyArrowShot(Entity fx, Vector3 startPos, Vector3 endPos)
		if fx == nil then return end
		local duration = 0.16
		-- 화면상 세로축(=회전 전 스프라이트의 가로/긴 축, Scale.x)이 폭(Scale.y)보다 더 많이 줄어들며
		-- 날아가야 화면 속으로 빨려들어가는(원근 단축) 느낌이 난다는 유저 지적 — 세로(길이)는
		-- 2.5→0.6까지, 폭은 기존처럼 2.5→1.0까지만 줄인다.
		local startLengthScale = 2.5
		local endLengthScale = 0.6
		local startWidthScale = 2.5
		local endWidthScale = 1.0

		_TweenLogic:PlayTween(0.0, 1.0, duration, EaseType.QuadEaseIn, function(t)
			if not isvalid(fx) then return end
			local x = startPos.x + (endPos.x - startPos.x) * t
			local y = startPos.y + (endPos.y - startPos.y) * t
			fx.TransformComponent.Position = Vector3(x, y, -0.1)
			local lengthScale = startLengthScale + (endLengthScale - startLengthScale) * t
			local widthScale = startWidthScale + (endWidthScale - startWidthScale) * t
			fx.TransformComponent.Scale = Vector3(lengthScale, widthScale, 1)
		end)

		-- 착탄 후: 박히듯 한 번 더 작아지며(비행 종료 시점 스케일에서 이어서) 빠르게 알파가 빠진다.
		-- 비행 종료 시점 스케일(세로 0.6 / 폭 1.0)에서 이어서 줄여야 착탄 순간 스케일이 튀지 않는다.
		_TimerService:SetTimerOnce(function()
			if not isvalid(fx) then return end
			local impactDuration = 0.22
			_TweenLogic:PlayTween(0.0, 1.0, impactDuration, EaseType.QuadEaseOut, function(t)
				if not isvalid(fx) then return end
				local lengthScale = endLengthScale * (1.0 - t * 0.4)
				local widthScale = endWidthScale * (1.0 - t * 0.4)
				fx.TransformComponent.Scale = Vector3(lengthScale, widthScale, 1)
				local renderer = fx.SpriteRendererComponent
				if renderer ~= nil then
					renderer.Color = Color(1, 1, 1, 0.9 * (1.0 - t))
				end
			end)
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) then fx:Destroy() end
			end, impactDuration)
		end, duration)
	end

	-- 의사(pseudo) 3D 깊이 판정용 경계값 — _currentScale(스폰 0.3 ~ 도달 1.5)을 이 값 기준으로
	-- "뒤 구간"/"앞 구간" 2개로만 나눈다(요청: "스폰부터 중간, 중간부터 맨앞 이렇게 2구간만").
	-- 범위형 스킬이 조준한 타겟과 다른 구간에 있는 몬스터는 같은 화면 좌표에 없다고 보고 광역 판정에서 제외한다.
	property number DepthBandThreshold = 0.9

	-- a와 b가 같은 깊이 구간(뒤/앞)에 있는지 — 범위형 스킬의 부수 판정(조준한 타겟 외에 반경에 걸린
	-- 다른 몬스터)에만 적용한다. 둘 중 하나라도 유효하지 않으면(예: 죽음 처리 도중) 안전하게 true 반환.
	@ExecSpace("ServerOnly")
	method boolean IsSameDepthBand(MonsterAI a, MonsterAI b)
		if not isvalid(a) or not isvalid(b) then return true end
		local bandA = (a._currentScale >= self.DepthBandThreshold)
		local bandB = (b._currentScale >= self.DepthBandThreshold)
		return bandA == bandB
	end

	-- 스킬 연출 크기에 곱하는 "화면 도달 진행도" 비율 — 도달 임계값(_reachedScaleThreshold, 화면 맨
	-- 앞)에서 정확히 1.0(원래 스킬 고정 크기와 동일)이 되도록 정규화하고, 등장 시점(스폰 직후,
	-- OnBeginPlay가 잡는 실제값 0.85)에도 너무 작아 보이지 않도록 최소 0.75(유저 확정치, 0.6→0.75
	-- 상향)로 바닥을 깐다.
	method number GetEffectScaleRatio(MonsterAI mob)
		local ratio = mob._currentScale / mob._reachedScaleThreshold
		return math.max(ratio, 0.75)
	end

	-- 살아있는 몬스터를 화면에 가까이 온 순서(스케일 큰 순)로 최대 count명 반환
	@ExecSpace("ServerOnly")
	method table GetClosestTargets(integer count)
		local map = self:GetCurrentMap()
		if map == nil then return {} end
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		local targets = {}
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if not m._dead then table.insert(targets, m) end
		end
		table.sort(targets, function(a, b) return a._currentScale > b._currentScale end)
		local result = {}
		for i = 1, math.min(count, #targets) do
			table.insert(result, targets[i])
		end
		return result
	end

	-- 살아있는 몬스터를 바닥(Y가 가장 낮은, 화면에서 가장 아래에 위치한) 순으로 최대 count명 반환 —
	-- 헤일 스톤처럼 "낙하 경로" 위에 다른 몬스터가 걸리게 하려면 맨 아래(지상) 몬스터를 우선
	-- 타겟팅해야 그 위로 서 있는 몬스터들이 경로에 낄 확률이 높아진다. 비행 유닛은 Y가 높아서
	-- 자연히 뒤로 밀림(별도 예외처리 불필요).
	@ExecSpace("ServerOnly")
	method table GetGroundPriorityTargets(integer count)
		local map = self:GetCurrentMap()
		if map == nil then return {} end
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		local targets = {}
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if not m._dead then table.insert(targets, m) end
		end
		table.sort(targets, function(a, b) return a.Entity.TransformComponent.Position.y < b.Entity.TransformComponent.Position.y end)
		local result = {}
		for i = 1, math.min(count, #targets) do
			table.insert(result, targets[i])
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method void MagicClawAttack(number damage, boolean isCrit)
		-- 업그레이드할 때마다 타겟 1명씩 추가 (기본 1명)
		local targets = self:GetClosestTargets(1 + self.Card2UpgradeCount)
		for _, target in ipairs(targets) do
			if isCrit then target:TakeDamageCrit(damage * 2)
			else target:TakeDamage(damage) end
			local p2 = target.Entity.TransformComponent.Position
			self:SpawnEffect(self.Card2EffectRUID, Vector3(p2.x, p2.y + 0.3, p2.z), 0, 1.5, 1.3 * (self:GetEffectScaleRatio(target)), 1)
		end
	end

	-- 바람의 시(Card101, 실피드) — 캐스팅 연출 시퀀스를 시작한다(순서는 PlayWindPoemBow 참고).
	@ExecSpace("ServerOnly")
	method void WindPoemAttack(number damage, boolean isCrit)
		local targets = self:GetClosestTargets(self:GetWindPoemTargetCount())
		if #targets == 0 then return end
		self:PlayWindPoemBow(targets, damage, isCrit)
	end

	-- 유저 지정 순서: 1) 생성 연출(Card101BowGlowRUID) 재생 → 2) 활 쏘는 연출(Card101BowEffectRUID)
	-- 재생 → 3) 화살 발사와 동시에 연출 제거. 둘 다 화면 위쪽 고정 위치(Card101BowPosition)에서 아래로
	-- 쏘는 각도(-90도)로 배치한다. 리소스 자체의 반투명이 Color 알파(이미 1.0)로는 안 없어져서,
	-- 머티리얼/셰이더 대신 유저 제안대로 같은 연출을 Card101LayerCount(3)장 같은 자리에 겹쳐 스폰해서
	-- 알파 블렌딩이 누적되어 더 진하게 보이도록 한다.
	@ExecSpace("ServerOnly")
	method void PlayWindPoemBow(any targets, number damage, boolean isCrit)
		local fxGlowLayers = self:SpawnWindPoemLayers(self.Card101BowGlowRUID)

		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self:HideWindPoemLayers(fxGlowLayers)

			local fxBowLayers = self:SpawnWindPoemLayers(self.Card101BowEffectRUID)

			_TimerService:SetTimerOnce(function()
				if not isvalid(self) then return end
				self:HideWindPoemLayers(fxBowLayers)
				-- 유저 요청: 여러 타겟이어도 동시발사가 아니라 순서대로 줄줄이 발사한다
				for i, target in ipairs(targets) do
					local staggerDelay = (i - 1) * self.Card101ArrowStaggerDelay
					_TimerService:SetTimerOnce(function()
						if not isvalid(self) then return end
						-- 토네이도 등 즉시 제거 효과로 타겟이 그 사이 파괴될 수 있다 — isvalid 없이
						-- target._dead만 보면 이미 파괴된 컴포넌트를 읽다가 LEA-2011(TakeDamage가 nil)로
						-- 죽는다(유저 실측 확인). 다른 다중타겟 스킬(콜드빔 등)과 동일하게 체크.
						if isvalid(target) and isvalid(target.Entity) and not target._dead then
							self:FireWindPoemArrow(target, damage, isCrit)
						end
					end, staggerDelay)
				end
			end, self.Card101BowShootDuration)
		end, self.Card101BowGlowDuration)
	end

	-- 같은 연출을 같은 위치/각도/스케일로 Card101LayerCount장 겹쳐 스폰한다(유저 제안: "같은 연출을
	-- 3개 겹치면 찐해지지 않을까").
	@ExecSpace("ServerOnly")
	method table SpawnWindPoemLayers(string ruid)
		local layers = {}
		for i = 1, self.Card101LayerCount do
			-- 유저 요청으로 틴트 제거 — 리소스 원본 색 그대로 스폰한다
			local fx = self:SpawnEffectWithModel(ruid, self.Card101BowPosition, self.Card101BowRotation, 1.0, self.Card101BowScale, 1.0, "skilleffectlong")
			if fx ~= nil then
				table.insert(layers, fx)
			end
		end
		return layers
	end

	-- 알파 페이드 없이(유저 요청: "알파값 없어도 될듯") 바로 Enable=false로 끈다
	-- (Map21RelicEasterEgg.HideRelicObject와 동일한, 클라이언트에서 안전한 엔티티 숨김 패턴).
	@ExecSpace("ServerOnly")
	method void HideWindPoemLayers(table layers)
		for _, fx in ipairs(layers) do
			self:HideWindPoemEffect(fx)
		end
	end

	@ExecSpace("Multicast")
	method void HideWindPoemEffect(Entity fx)
		if not self:IsClient() then return end
		if isvalid(fx) then fx.Enable = false end
	end

	-- 화살 한 발 발사 — 타겟마다 개별 호출(동시에 여러 명 맞출 수 있음). 발사 원점(Card101BowPosition)
	-- 에서 그 타겟의 실제 좌표까지 방향을 계산해 회전시키고 직선으로 날아간다(유저 요청: "진짜로 그
	-- 화살이 적을 타겟팅해서"). 착탄 순간(비행시간과 동일하게 맞춘 지연) 몬스터 위치에 hit/2~5 중
	-- 무작위 하나를 추가로 재생한다(유저 요청: "매번 다르면 더 좋겠네").
	@ExecSpace("ServerOnly")
	method void FireWindPoemArrow(MonsterAI target, number damage, boolean isCrit)
		if isCrit then target:TakeDamageCrit(damage * 2)
		else target:TakeDamage(damage) end

		local p1 = target.Entity.TransformComponent.Position
		local hitPos = Vector3(p1.x, p1.y + 0.3, p1.z)
		local startPos = self.Card101BowPosition

		local dx = hitPos.x - startPos.x
		local dy = hitPos.y - startPos.y
		local angle = math.deg(math.atan(dy, dx))

		-- 유저 요청으로 틴트 제거 — 리소스 원본 색 그대로 스폰한다
		local fx = self:SpawnEffect(self.Card101ArrowEffectRUID, startPos, angle, 1.5, 1.5 * (self:GetEffectScaleRatio(target)), 1)
		self:FlyWindPoemArrow(fx, startPos, hitPos)

		-- 착탄 연출은 고정 좌표(hitPos)에 재생하는 순수 시각 효과라 그 사이 타겟이 죽어도(이미 위에서
		-- 데미지는 적용됨) 재생을 건너뛰지 않는다 — 죽음 체크로 스킵하면 저체력 몹 대상으로는 애로우샷과
		-- 동시에 즉사시키는 경우가 잦아 hit 연출이 거의 안 뜨는 문제가 있었다(실측 확인, FireArrowShot과 동일 이슈).
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			local scaleRatio = isvalid(target) and self:GetEffectScaleRatio(target) or 1.0
			local hitFx = self:SpawnEffect(self.Card101HitRUID, hitPos, 0, 1.0, 1.3 * scaleRatio, 1)
			self:StopEffectAfterFirstLoop(hitFx)
		end, self.Card101ArrowFlightDuration)
	end

	-- 발사 원점→타겟 실제 좌표까지 직선으로 날아가는 화살 — 파이어샷/애로우샷 계열의 "타겟 바로 밑에서
	-- 짧게 튀어 화면 속으로 빨려들어가는" 트릭과 달리, 실제 두 지점을 잇는 긴 궤적이라 회전은 발사
	-- 시점에 이미 방향대로 고정해두고(FireWindPoemArrow) 위치만 선형 보간한다.
	@ExecSpace("ServerOnly")
	method void FlyWindPoemArrow(Entity fx, Vector3 startPos, Vector3 endPos)
		if fx == nil then return end
		local duration = self.Card101ArrowFlightDuration
		_TweenLogic:PlayTween(0.0, 1.0, duration, EaseType.Linear, function(t)
			if not isvalid(fx) then return end
			local x = startPos.x + (endPos.x - startPos.x) * t
			local y = startPos.y + (endPos.y - startPos.y) * t
			fx.TransformComponent.Position = Vector3(x, y, -0.1)
		end)
		_TimerService:SetTimerOnce(function()
			if isvalid(fx) then fx:Destroy() end
		end, duration)
	end

	-- 원래 바람의 시가 쓰던 hit/2~5 무작위 세트 — 유저 요청으로 애로우샷(기본공격)의 착탄 연출로 옮겼다
	method string GetRandomArrowShotHitRUID()
		local roll = _UtilLogic:RandomIntegerRange(2, 5)
		if roll == 2 then return self.ArrowShotHitRUID2
		elseif roll == 3 then return self.ArrowShotHitRUID3
		elseif roll == 4 then return self.ArrowShotHitRUID4
		end
		return self.ArrowShotHitRUID5
	end

	-- 애니메이션클립이 모델(skilleffect) Duration보다 빨리 한 바퀴 돌면 처음부터 다시 재생되는 게
	-- 보인다(유저 실측: "여러번 재생되는거 같은데") — 1루프가 끝나는 시점(SpriteAnimPlayerEndEvent)에
	-- 숨겨서 딱 한 번만 보이게 한다.
	@ExecSpace("Multicast")
	method void StopEffectAfterFirstLoop(Entity fx)
		if not self:IsClient() then return end
		if not isvalid(fx) then return end
		fx:ConnectEvent(SpriteAnimPlayerEndEvent, function()
			if isvalid(fx) then fx.Enable = false end
		end)
	end

	@ExecSpace("ServerOnly")
	method void ColdBeamAttack(number damage, boolean isCrit)
		-- 레벨별 타겟 수는 GetColdBeamTargetCount 참고(Lv1:1명/Lv2~3:2명/Lv4~5:3명). 단일 히트 —
		-- 전체 데미지를 칼이 바닥에 꽂히는 연출 시점(Card3ImpactDelay)에 한 번에 적용한다
		-- (메테오와 동일한 "연출 먼저, 착탄 시 데미지" 패턴). 슬로우는 레벨/다른 카드와 무관하게 항상 3초 고정
		local targets = self:GetClosestTargets(self:GetColdBeamTargetCount())
		local slowDur = 3.0
		for _, target in ipairs(targets) do
			-- 새 이펙트는 대상 주변으로 퍼지는 얼음 폭발이라 방향성이 없다 — 빔처럼 위쪽에 띄울 필요 없이 대상 위치에 바로 재생한다
			-- "칼이 꽂히는" 정점(Card3ImpactFrameIndex)까지만 재생하고 그 뒤 여운 프레임은 EndFrameIndex로
			-- 잘라낸다. 공용 "skilleffect" 모델은 자체 기본 Duration이 0.8초라 그보다 긴 Destroy 지연을
			-- 걸어도 모델 쪽 타이머가 먼저 파괴해버려서(실측 확인) 격리된 "skilleffectlong" 모델로 스폰—
			-- 데미지 타이밍(Card3ImpactDelay)에 맞춰 이 연출도 같이 파괴해서 여운 없이 딱 끊는다.
			-- X는 Card3EffectXOffset만큼 오른쪽으로 밀어서 pivot 오프셋을 보정한다(위 프로퍼티 주석 참고).
			local p3 = target.Entity.TransformComponent.Position
			local p3fx = Vector3(p3.x + self.Card3EffectXOffset, p3.y, p3.z)
			local fx1 = self:SpawnEffectWithModel(self.Card3EffectRUID, p3fx, 0, 0.8, 0.8349 * (self:GetEffectScaleRatio(target)), 1, "skilleffectlong")
			if fx1 ~= nil then
				local renderer = fx1.SpriteRendererComponent
				if renderer ~= nil then renderer.EndFrameIndex = self.Card3ImpactFrameIndex end
				fx1:Destroy(self.Card3ImpactDelay)
			end

			-- 칼 꽂히는 연출이 끝나자마자(Card3ImpactDelay) 바로 이어서 2단계 연출(원래 쓰던 얼음
			-- 버스트+링)을 재생하고, 그 2단계 연출이 시작되고 나서 Card3SecondEffectDamageDelay 뒤에
			-- 데미지를 적용한다(아이스 계열 스택 보너스는 착탄 시점 스택 기준).
			_TimerService:SetTimerOnce(function()
				if isvalid(target) and isvalid(target.Entity) and not target._dead then
					local p4 = target.Entity.TransformComponent.Position
					local fx2 = self:SpawnEffect(self.Card3SecondEffectRUID, p4, 0, 1, self:GetEffectScaleRatio(target), 1)
					if fx2 ~= nil then fx2:Destroy(self.Card3SecondEffectLifetime) end

					_TimerService:SetTimerOnce(function()
						if isvalid(target) and isvalid(target.Entity) and not target._dead then
							local iceBonus = self:GetIceStackBonus(target)
							local finalDamage = damage * iceBonus
							if isCrit then target:TakeDamageCrit(finalDamage * 2)
							else target:TakeDamage(finalDamage) end
							target:ApplySlow(slowDur)
							if self.FreezingEffectLevel > 0 then target:AddFreezeStack() end
							-- SkillInventory 콜드빔(인덱스4) Lv9: 20% 확률로 빙결스택 +1 추가, 카드 자체 레벨과 별개
							if self:GetSkillInvLevel(3) >= 9 and _UtilLogic:RandomDouble() < 0.20 then target:AddFreezeStack() end
							log("ColdBeamAttack: impact dmg=" .. math.floor(isCrit and finalDamage * 2 or finalDamage))
						end
					end, self.Card3SecondEffectDamageDelay)
				end
			end, self.Card3ImpactDelay)
		end
	end

	@ExecSpace("ServerOnly")
	method void ThunderAttack(number damage, boolean isCrit)
		-- 레벨별 타겟 수/스턴 확률/스턴 지속시간은 GetThunderBolt* 참고. 보스/엘리트는 스턴
		-- 지속시간이 절반으로 적용된다(확률은 그대로).
		local targets = self:GetClosestTargets(self:GetThunderBoltTargetCount())
		local stunChance = self:GetThunderBoltStunChance()
		local stunDuration = self:GetThunderBoltStunDuration()
		log("ThunderAttack: hit=" .. #targets .. " dmg=" .. math.floor(damage) .. " stunChance=" .. stunChance .. " stunDuration=" .. stunDuration)
		for _, target in ipairs(targets) do
			local finalDmg = damage
			-- 빙결폭발 체크 (Lv5, 5스택)
			if self.FreezingEffectLevel >= 5 and target.FreezeStack >= 5 then
				self:TriggerFreezeExplosion(target, finalDmg, isCrit)
			else
				if isCrit then target:TakeDamageCrit(finalDmg * 2)
				else target:TakeDamage(finalDmg) end
			end
			self:SpawnEffect(self.Card4EffectRUID, target.Entity.TransformComponent.Position, 0, 1, self:GetEffectScaleRatio(target), 1)
			if stunDuration > 0 and _UtilLogic:RandomDouble() < stunChance then
				local finalStunDuration = (target._isBoss or target._isElite) and (stunDuration * 0.5) or stunDuration
				target:ApplyStun(finalStunDuration, true)
			end
			-- 연쇄번개 (Lv3+, 대상이 빙결 상태일 때만 발동 — ApplyChainLightning 내부에서 체크)
			self:ApplyChainLightning(target, finalDmg, isCrit)
		end
	end

	-- ── 썬더스톰 (Card 16) ────────────────────────────────────────

	-- 1타 기준 대미지 — Lv1:200 / Lv2:250 / Lv3:300
	method number GetThunderStormDamage(integer level)
		if level >= 3 then return 300
		elseif level >= 2 then return 250
		end
		return 200
	end

	-- N번째 타격의 대미지 — 매 타마다 직전 타의 절반(반올림)으로 감소. Lv1:200/100/50, Lv2:250/125/63, Lv3:300/150/75
	method integer GetThunderStormHitDamage(integer level, integer hitIndex)
		local dmg = self:GetCardDamage(16)
		for i = 2, hitIndex do
			dmg = math.floor(dmg * 0.5 + 0.5)
		end
		return math.floor(dmg)
	end

	-- Lv1: 1명(=1개 조준 지점) / Lv2~3: 2명 — 아이스커터/썬더커터와 동일한 방식으로 서로 다른 몬스터를 각각 조준
	method integer GetThunderStormTargetCount(integer level)
		if level >= 2 then return 2 end
		return 1
	end

	-- Lv1~2: 40% / Lv3: 50%
	method number GetThunderStormStunChance(integer level)
		local base = 0.4
		if level >= 3 then base = 0.5 end
		-- SkillInventory 썬더스톰(인덱스14) Lv9: 스턴 확률 +10%, 카드 자체 레벨과 별개로 항상 가산
		if self:GetSkillInvLevel(16) >= 9 then base = base + 0.10 end
		return base
	end

	-- 조준한 타겟 수(레벨별)만큼 서로 다른 몬스터를 각각 조준해서, 각 위치마다 독립적으로 "구름 1개 소환 +
	-- 3연타" 시퀀스를 발동한다.
	@ExecSpace("ServerOnly")
	method void ThunderStormAttack(boolean isCrit, MonsterAI primaryTarget)
		local level = self.ThunderStormLevel
		local targetCount = self:GetThunderStormTargetCount(level)
		local stunChance = self:GetThunderStormStunChance(level)

		local target1 = primaryTarget
		local target2 = nil
		if targetCount >= 2 then
			target2 = self:FindNextThunderTarget(target1, nil)
		end

		self:FireThunderStormCloud(target1.Entity.TransformComponent.Position, target1._currentScale, self:GetEffectScaleRatio(target1), level, isCrit, stunChance)
		if target2 ~= nil then
			self:FireThunderStormCloud(target2.Entity.TransformComponent.Position, target2._currentScale, self:GetEffectScaleRatio(target2), level, isCrit, stunChance)
		end
	end

	-- 지정된 위치에 구름 연출을 "딱 1번만" 소환하고, 그 자리에 고정된 채로 3연타를 진행한다.
	-- (예전엔 매 타마다 새로 스폰/재타겟해서 "먹구름이 1개만 소환돼야 하는데 다른 몬스터한테 또
	-- 소환된다"는 문제가 있었다 — 캐스팅 시점 위치/깊이 구간을 고정값으로 캡처해서 재사용하도록 재설계함.)
	--
	-- (과거에 여기서 SpawnEffect 반환값의 SkillEffectAI.Duration을 직접 덮어써서 늘리려 했는데 효과가
	-- 없었다 — OnBeginPlay가 스폰 시점에 이미 파괴 타이머를 Duration 기본값으로 예약해버려서, 스폰
	-- "이후"에 프로퍼티를 바꿔도 이미 예약된 타이머엔 반영되지 않는다. 처음엔 공용 "skilleffect" 모델
	-- 자체의 기본 Duration을 0.8→2.5초로 늘렸는데, 그러면 다른 모든 스킬 이펙트까지 같이 길어져버려서
	-- (유저 피드백) 되돌리고, 대신 썬더스톰 전용 "skilleffectlong"(Duration=2.5초) 모델을 새로 만들어
	-- 이 스킬만 쓰게 분리했다. 겹침 방지용 수명 제어는 여전히 Entity:Destroy(delay)로 직접 한다.)
	@ExecSpace("ServerOnly")
	method void FireThunderStormCloud(Vector3 pos, number anchorScale, number fxScaleRatio, integer level, boolean isCrit, number stunChance)
		local fx = self:SpawnEffectWithModel(self.Card16EffectRUID, pos, 0, 1, self.Card16EffectScale * fxScaleRatio, 1, "skilleffectlong")
		if fx ~= nil then fx:Destroy(self.Card16EffectLifetime) end
		self:ScheduleThunderStormImpact(pos, anchorScale, level, 1, isCrit, stunChance)
	end

	@ExecSpace("ServerOnly")
	method void ScheduleThunderStormImpact(Vector3 pos, number anchorScale, integer level, integer hitIndex, boolean isCrit, number stunChance)
		_TimerService:SetTimerOnce(function()
			if isvalid(self) then self:ApplyThunderStormImpact(pos, anchorScale, level, hitIndex, isCrit, stunChance) end
		end, self.Card16HitInterval)
	end

	-- 고정된 위치(center)에서 실제 착탄 판정 — 그 자리에 있는 몬스터라면 전부(반경 안이고, 1타는 깊이
	-- 구간이 캐스팅 시점 기준과 같을 때만) 맞는다. 구간 체크는 1타에만 적용한다 — 넉백(예: 썬더 커터
	-- Lv3)은 X/Y 위치가 아니라 _currentScale(깊이 진행도)만 바꾸는데, 1타 이후에도 매 타 구간을 다시
	-- 검사하면 1타를 맞은 대상이 넉백으로 구간이 바뀌어 2·3타를 통째로 빗맞는 문제가 있었다(유저 실측
	-- 확인). 1타에서 이미 같은 구간으로 판정받았다면 그 뒤로는 반경 안에만 있으면 계속 맞는다.
	-- 새로 스폰/재타겟하지 않으므로 원래 대상이 죽어도 구름 자체는 그대로 있고, 그 반경에 다른 몬스터가
	-- 있으면 계속 맞는다(반경에 아무도 없으면 그냥 허공을 침 — 자연스럽게 스킵됨).
	@ExecSpace("ServerOnly")
	method void ApplyThunderStormImpact(Vector3 center, number anchorScale, integer level, integer hitIndex, boolean isCrit, number stunChance)
		local map = self:GetCurrentMap()
		if map == nil then return end

		local dmg = self:GetThunderStormHitDamage(level, hitIndex)
		local anchorFront = anchorScale >= self.DepthBandThreshold
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		local hitCount = 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if not m._dead then
				local mp = m.Entity.TransformComponent.Position
				local dx = mp.x - center.x
				local dy = mp.y - center.y
				local inRange = (dx * dx + dy * dy) <= (self.Card16Radius * self.Card16Radius)
				local sameBand = (hitIndex > 1) or ((m._currentScale >= self.DepthBandThreshold) == anchorFront)
				if inRange and sameBand then
					if isCrit then m:TakeDamageCrit(dmg * 2)
					else m:TakeDamage(dmg) end
					if hitIndex == 1 and stunChance > 0 and not m._dead and _UtilLogic:RandomDouble() < stunChance then
						local stunDur = (m._isBoss or m._isElite) and (self.Card16StunDuration * 0.5) or self.Card16StunDuration
						m:ApplyStun(stunDur, true)
					end
					hitCount = hitCount + 1
				end
			end
		end
		log("ThunderStormAttack: hit" .. hitIndex .. "/3 count=" .. hitCount .. " dmg=" .. math.floor(isCrit and dmg * 2 or dmg))

		if hitIndex < 3 then
			self:ScheduleThunderStormImpact(center, anchorScale, level, hitIndex + 1, isCrit, stunChance)
		end
	end

	-- 썬더볼트 → 썬더스톰, 콜드빔 → 아이스 스트라이크 등 조합(융합) 순간 연출 — 카드 드롭 도착 때
	-- 쓰는 슬롯 확대+반짝이 파티클을 그대로 재사용한다.
	@ExecSpace("Multicast")
	method void PlayThunderStormFusionEffect(integer slotIdx)
		if self:IsServer() then return end
		self:PunchSlotScale(slotIdx)
	end

	-- ── 아이스 스트라이크 (Card 17) ────────────────────────────────

	-- 타당 대미지 — Lv1:250 / Lv2:300 / Lv3:350 (타마다 감소 없음, 매타 동일 데미지)
	method number GetIceStrikeDamage(integer level)
		if level >= 3 then return 350
		elseif level >= 2 then return 300
		end
		return 250
	end

	-- 타겟 수(서로 다른 몬스터) — Lv1~2: 3명 / Lv3: 4명
	method integer GetIceStrikeTargetCount(integer level)
		if level >= 3 then return 4 end
		return 3
	end

	-- 서로 다른 몬스터 N명(레벨별, GetClosestTargets로 선정)에게 각 1타씩 동시 적용 —
	-- 매 대상 데미지 + 슬로우 + 빙결 스택 2(AddFreezeStack 2회) 100% 적용.
	@ExecSpace("ServerOnly")
	method void IceStrikeAttack(boolean isCrit, MonsterAI primaryTarget)
		local level = self.IceStrikeLevel
		local dmg = self:GetCardDamage(17)
		local targets = self:GetClosestTargets(self:GetIceStrikeTargetCount(level))
		-- 배속(Card17EffectPlayRate)만큼 연출이 느려진 것에 맞춰 데미지/슬로우/빙결 적용 시점도 같이
		-- 늦춘다("연출 먼저 재생 → 착탄 시 데미지" 패턴, 콜드빔/메테오와 동일한 관습). 연출 수명도
		-- 같은 시간(Lifetime/PlayRate)만큼 늘려서, 느려진 애니메이션이 중간에 잘리지 않고 착탄과
		-- 동시에 자연스럽게 끝나도록 한다.
		-- impactDelay(=수명/배속)가 0.8초를 넘으면 공용 "skilleffect" 모델의 내부 기본 Duration(0.8초)이
		-- 우리 explicit Destroy보다 먼저 발동해버려서 연출이 잘린다 — "skilleffectlong"(2.5초 캡)을 쓴다.
		local impactDelay = self.Card17EffectLifetime / self.Card17EffectPlayRate
		for _, target in ipairs(targets) do
			local p = target.Entity.TransformComponent.Position
			local fx = self:SpawnEffectWithModel(self.Card17EffectRUID, p, 0, self.Card17EffectPlayRate, self.Card17EffectScale * self:GetEffectScaleRatio(target), self.Card17EffectAlpha, "skilleffectlong")
			if fx ~= nil then fx:Destroy(impactDelay) end

			_TimerService:SetTimerOnce(function()
				if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
				local finalDmg = dmg * self:GetIceStackBonus(target)
				if isCrit then target:TakeDamageCrit(finalDmg * 2)
				else target:TakeDamage(finalDmg) end
				target:ApplySlow(self.Card17SlowDuration)
				if self.FreezingEffectLevel > 0 and not target._dead then
					target:AddFreezeStack()
					target:AddFreezeStack()
				end
				-- SkillInventory 아이스스트라이크(인덱스15) Lv9: 10% 확률로 빙결스택 +2 추가, 카드 자체 레벨과 별개
				if not target._dead and self:GetSkillInvLevel(17) >= 9 and _UtilLogic:RandomDouble() < 0.10 then
					target:AddFreezeStack()
					target:AddFreezeStack()
				end
				log("IceStrikeAttack: target dmg=" .. math.floor(isCrit and finalDmg * 2 or finalDmg))
			end, impactDelay)
		end
		log("IceStrikeAttack: hit=" .. #targets .. "/" .. self:GetIceStrikeTargetCount(level))
	end

	-- ── 체인 라이트닝 (Card 19) ────────────────────────────────────

	-- 1홉(첫 타겟) 기준 대미지 — Lv1:300 / Lv2:350 / Lv3:400
	method number GetChainLightningDamage(integer level)
		if level >= 3 then return 400
		elseif level >= 2 then return 350
		end
		return 300
	end

	-- 연쇄 대상 수(서로 다른 몬스터) — Lv1:3명 / Lv2:4명 / Lv3:5명
	method integer GetChainLightningTargetCount(integer level)
		if level >= 3 then return 5
		elseif level >= 2 then return 4
		end
		return 3
	end

	-- 홉(hopIndex, 1부터 시작)별 배율 — 레벨마다 표가 다름(뒤로 갈수록 감소)
	method number GetChainLightningHopMult(integer level, integer hopIndex)
		local mults
		if level >= 3 then mults = {1.0, 0.8, 0.6, 0.4, 0.2}
		elseif level >= 2 then mults = {1.0, 0.7, 0.5, 0.3}
		else mults = {1.0, 0.6, 0.4}
		end
		return mults[hopIndex] or 0
	end

	-- 마지막 타겟에 별도로 추가되는 "마지막 착탄" 보너스 배율(1홉 기준 대미지에 곱함) — Lv1:50% / Lv2:60% / Lv3:70%
	method number GetChainLightningFinalBonusMult(integer level)
		if level >= 3 then return 0.70
		elseif level >= 2 then return 0.60
		end
		return 0.50
	end

	-- 홉마다 다른 타격 이펙트를 순환시켜 변화감을 준다(리소스팩의 hit/0~4)
	method string GetChainLightningHitRUID(integer hopIndex)
		local ruids = {
			"b499aa0ce95647ceb592198e0ce0d97c", -- hit/0
			"1361b140f2e848128ed69676647e27cf", -- hit/1
			"4c5c48d9597048a38f85d0f6cb32c575", -- hit/2
			"43aa8b75f719400ab4c077832442e260", -- hit/3
			"715c8da82db44087b06a507b37ea7bba", -- hit/4
		}
		local idx = ((hopIndex - 1) % 5) + 1
		return ruids[idx]
	end

	-- 매직크리티컬 기본 확률 + 고정 20%(레벨 무관) — 에너지볼트의 EnergyBoltCritBonus와 동일한 가산 방식
	@ExecSpace("ServerOnly")
	method boolean RollChainLightningCrit()
		local chance = self:GetMagicCriticalChance() + 0.20
		if self:GetSkillInvLevel(19) >= 9 then chance = chance + 0.10 end
		return _UtilLogic:RandomDouble() < chance
	end

	-- 두 지점을 잇는 체인 연출 — ball/0 리소스(지그재그 번개 볼트 모양, 원본 52x37)를 두 지점 사이
	-- 거리만큼 가로(X)로만 늘리고 각도에 맞춰 회전시켜 "번개가 몬스터에서 몬스터로 실제로 이어지는"
	-- 모양을 낸다(초기엔 "mob" 리소스를 썼었는데, 실제로는 리소스팩 미리보기용 도해 아이콘이었어서
	-- 스턴 이펙트처럼 보이는 오작동이 있었음 — ball/0로 교체함).
	-- world unit 환산은 8 Core Rules #5(1유닛=100px) 기준 52px≈0.52유닛으로 근사.
	@ExecSpace("ServerOnly")
	method void SpawnChainArc(Vector3 fromPos, Vector3 toPos)
		local dx = toPos.x - fromPos.x
		local dy = toPos.y - fromPos.y
		local dist = math.sqrt(dx * dx + dy * dy)
		if dist < 0.05 then return end
		local angle = math.deg(math.atan(dy, dx))
		local midPos = Vector3((fromPos.x + toPos.x) / 2, (fromPos.y + toPos.y) / 2, -0.1)
		local fx = self:SpawnEffect(self.Card19ChainRUID, midPos, angle, 1.5, 1, 1)
		if fx ~= nil then
			local scaleX = dist / 0.52
			fx.TransformComponent.Scale = Vector3(scaleX, 1, 1)
			fx:Destroy(0.3)
		end
	end

	-- 서로 다른 몬스터 N명(레벨별)에게 GetClosestTargets로 대상을 뽑아 순서대로 연쇄 타격한다.
	-- 마지막 타겟에는 착탄 후 별도로 "마지막 착탄" 보너스 데미지가 한 번 더 들어간다.
	@ExecSpace("ServerOnly")
	method void ChainLightningAttack(MonsterAI primaryTarget)
		local level = self.ChainLightningLevel
		local baseDmg = self:GetCardDamage(19)
		local isCrit = self:RollChainLightningCrit()
		local targets = self:GetClosestTargets(self:GetChainLightningTargetCount(level))
		if #targets == 0 then return end

		self:FireChainLightningHop(targets, 1, baseDmg, isCrit, level)
	end

	@ExecSpace("ServerOnly")
	method void FireChainLightningHop(table targets, integer hopIndex, number baseDmg, boolean isCrit, integer level)
		if hopIndex > #targets then return end
		local target = targets[hopIndex]
		if not isvalid(target) or not isvalid(target.Entity) or target._dead then
			self:ScheduleChainLightningHop(targets, hopIndex + 1, baseDmg, isCrit, level)
			return
		end

		-- 이전 타겟 → 이번 타겟으로 이어지는 체인 연출(1홉은 이전 지점이 없으므로 생략) — 몬스터
		-- 중심보다 살짝 위(에너지볼트와 동일한 스케일 비례 오프셋)에서 이어지도록 두 지점 다 올린다.
		if hopIndex > 1 then
			local prev = targets[hopIndex - 1]
			if isvalid(prev) and isvalid(prev.Entity) then
				local prevP = prev.Entity.TransformComponent.Position
				local prevOfs = 0.24 * (prev._currentScale * prev._scaleMultiplier)
				local curP = target.Entity.TransformComponent.Position
				local curOfs = 0.24 * (target._currentScale * target._scaleMultiplier)
				self:SpawnChainArc(Vector3(prevP.x, prevP.y + prevOfs, prevP.z), Vector3(curP.x, curP.y + curOfs, curP.z))
			end
		end

		local hopMult = self:GetChainLightningHopMult(level, hopIndex)
		local hopDmg = baseDmg * hopMult
		if isCrit then target:TakeDamageCrit(hopDmg * 2)
		else target:TakeDamage(hopDmg) end

		local p = target.Entity.TransformComponent.Position
		local ofsHit = 0.24 * (target._currentScale * target._scaleMultiplier)
		local fx = self:SpawnEffect(self:GetChainLightningHitRUID(hopIndex), Vector3(p.x, p.y + ofsHit, p.z), 0, 1, self:GetEffectScaleRatio(target), 1)
		if fx ~= nil then fx:Destroy(0.4) end

		log("ChainLightningAttack: hop" .. hopIndex .. "/" .. #targets .. " dmg=" .. math.floor(isCrit and hopDmg * 2 or hopDmg))

		if hopIndex == #targets then
			-- 마지막 타겟: 별도 "마지막 착탄" 보너스 데미지를 홉 딜레이만큼 늦게 한 번 더 적용
			local finalBonusMult = self:GetChainLightningFinalBonusMult(level)
			local finalDmg = baseDmg * finalBonusMult
			_TimerService:SetTimerOnce(function()
				if isvalid(self) and isvalid(target) and isvalid(target.Entity) and not target._dead then
					if isCrit then target:TakeDamageCrit(finalDmg * 2)
					else target:TakeDamage(finalDmg) end
					local fp = target.Entity.TransformComponent.Position
					local ffx = self:SpawnEffect(self.Card19FinalRUID, fp, 0, 1, 1.4 * (self:GetEffectScaleRatio(target)), 1)
					if ffx ~= nil then ffx:Destroy(0.5) end
					log("ChainLightningAttack: final bonus dmg=" .. math.floor(isCrit and finalDmg * 2 or finalDmg))
				end
			end, self.Card19HopDelay)
		else
			self:ScheduleChainLightningHop(targets, hopIndex + 1, baseDmg, isCrit, level)
		end
	end

	@ExecSpace("ServerOnly")
	method void ScheduleChainLightningHop(table targets, integer hopIndex, number baseDmg, boolean isCrit, integer level)
		if hopIndex > #targets then return end
		_TimerService:SetTimerOnce(function()
			if isvalid(self) then self:FireChainLightningHop(targets, hopIndex, baseDmg, isCrit, level) end
		end, self.Card19HopDelay)
	end

	@ExecSpace("ServerOnly")
	method void MeteorAttack(number damage, boolean isCrit)
		-- 낙하 이펙트를 먼저 띄우고, 착탄 시점(Card5ImpactDelay)에 데미지를 적용한다
		local map = self:GetCurrentMap()
		if map == nil then return end
		local dotDmg = math.floor(self.Card1Damage * 0.3)
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if not m._dead then
				self:SpawnEffect(self.Card5EffectRUID, m.Entity.TransformComponent.Position, 0, 3, self:GetEffectScaleRatio(m), 1)
				_TimerService:SetTimerOnce(function()
					if isvalid(m) and isvalid(m.Entity) and not m._dead then
						if isCrit then m:TakeDamageCrit(damage * 2)
						else m:TakeDamage(damage) end
						m:ApplyDot(dotDmg, 3, 0.7)
						log("MeteorAttack: impact damage applied dmg=" .. math.floor(isCrit and damage * 2 or damage))
					end
				end, self.Card5ImpactDelay)
			end
		end
	end

	-- 아이스 커터 (Card 11) 판정 반경 — 레벨 무관 고정값 0.96.
	-- 파라미터는 다른 Get* 함수들과 시그니처를 맞추기 위해 유지하지만 값 자체는 레벨과 무관하다.
	method number GetIceCutterRadius(integer level)
		return 0.96
	end

	-- 아이스 커터 (Card 11) 레벨별 데미지 — Lv1~3: 기본(110) / Lv4~5: +50(160)
	method number GetIceCutterDamage(integer level)
		if level >= 4 then return self.Card11Damage + 50 end
		return self.Card11Damage
	end

	-- 아이스 커터 (Card 11) 레벨별 조준 타겟 수 — Lv1~2: 1명 / Lv3~5: 2명 (서로 다른 몬스터를 각각 조준)
	method integer GetIceCutterTargetCount(integer level)
		if level >= 3 then return 2 end
		return 1
	end

	-- 아이스 커터 Lv2부터 붙는 출혈 — 몬스터 자기 자신의 MaxHp 기준 %라서, 탱키한 몬스터일수록
	-- 틱당 절대 피해량이 커진다(MonsterAI.ApplyDot에 미리 계산한 절대값을 넘긴다). Lv5에 5%로 증가.
	method number GetIceCutterBleedPercent(integer level)
		local base = 0
		if level < 2 then base = 0
		elseif level < 5 then base = 0.03
		else base = 0.05 end
		-- SkillInventory 아이스커터(인덱스5) Lv9: 출혈 대미지 +2%, 카드 자체 레벨과 별개로 항상 가산
		if self:GetSkillInvLevel(11) >= 9 then base = base + 0.02 end
		return base
	end

	@ExecSpace("ServerOnly")
	method void IceCutterAttack(number damage, boolean isCrit, MonsterAI primaryTarget)
		-- 레벨별 타겟 수(GetIceCutterTargetCount)만큼 서로 다른 몬스터를 각각 조준해서, 조준한 위치마다
		-- 고정 반경(GetIceCutterRadius, 레벨 무관 0.96) 광역 판정을 동시에 낸다 — 썬더 커터의 다중 조준과
		-- 동일한 방식(FindNextThunderTarget 재사용), 다만 발사 간 딜레이 없이 즉시 전부 발동한다.
		local map = self:GetCurrentMap()
		if map == nil then return end
		local level = self.IceCutterLevel
		local radius = self:GetIceCutterRadius(level)
		local bleedPercent = self:GetIceCutterBleedPercent(level)
		local targetCount = self:GetIceCutterTargetCount(level)

		local target1 = primaryTarget
		local target2 = nil
		if targetCount >= 2 then
			target2 = self:FindNextThunderTarget(target1, nil)
		end

		self:FireIceCutterShot(map, target1, damage, isCrit, radius, bleedPercent)
		if target2 ~= nil then self:FireIceCutterShot(map, target2, damage, isCrit, radius, bleedPercent) end
	end

	-- 아이스 커터 한 방을 shotTarget 위치에 즉시 발동 — 이펙트 스폰 + 그 위치 기준 고정 반경 광역 판정.
	@ExecSpace("ServerOnly")
	method void FireIceCutterShot(Entity map, MonsterAI shotTarget, number damage, boolean isCrit, number radius, number bleedPercent)
		if not isvalid(shotTarget) or not isvalid(shotTarget.Entity) or shotTarget._dead then return end
		local centerPos = shotTarget.Entity.TransformComponent.Position
		local fxPos = Vector3(centerPos.x, centerPos.y + self.Card11EffectYOffset, centerPos.z)
		self:SpawnEffect(self.Card11EffectRUID, fxPos, 0, 1, (radius / 1.2) * (self:GetEffectScaleRatio(shotTarget)), 1)

		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		local hitCount = 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if not m._dead then
				local mp = m.Entity.TransformComponent.Position
				local dx = mp.x - centerPos.x
				local dy = mp.y - centerPos.y
				if (dx * dx + dy * dy) <= (radius * radius) and self:IsSameDepthBand(shotTarget, m) then
					local finalDmg = damage * self:GetIceStackBonus(m)
					if isCrit then m:TakeDamageCrit(finalDmg * 2)
					else m:TakeDamage(finalDmg) end
					if bleedPercent > 0 then
						m:ApplyDot(m.MaxHp * bleedPercent, 3, 1.0)
					end
					hitCount = hitCount + 1
				end
			end
		end
		log("IceCutterAttack: hit=" .. hitCount .. " dmg=" .. math.floor(isCrit and damage * 2 or damage) .. " radius=" .. radius .. " bleed%=" .. math.floor(bleedPercent * 100))
	end

	-- primaryTarget을 제외하고, 이미 이번 시전에서 고른 다른 몬스터(exclude2)도 제외한 채
	-- 접근도(스케일)가 가장 높은 살아있는 몬스터를 반환 — FindSecondTarget과 동일한 선정 방식을
	-- exclude 2개까지 받도록 확장(썬더 커터의 3번째 타겟 탐색에도 재사용하기 위함).
	@ExecSpace("ServerOnly")
	method MonsterAI FindNextThunderTarget(MonsterAI exclude1, MonsterAI exclude2)
		local map = self:GetCurrentMap()
		if map == nil then return nil end
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		local best = nil
		local bestScale = -1
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if not m._dead and m ~= exclude1 and m ~= exclude2 and m._currentScale > bestScale then
				best = m
				bestScale = m._currentScale
			end
		end
		return best
	end

	-- 썬더 커터 (Card 13) — "N발"은 같은 자리를 N번 베는 게 아니라 서로 다른 몬스터 N명을 각각
	-- 조준해서 그 위치에 광역 판정을 낸다(Lv2~4=2명, Lv5=3명). 대상이 부족하면(생존 몬스터가
	-- 적음) 있는 만큼만 발동한다. Lv3부터는 맞은 몬스터를 전부 넉백(스케일을 되돌려 "맨 뒤로 밀려남")시킨다.
	@ExecSpace("ServerOnly")
	method void ThunderCutterAttack(number damage, boolean isCrit, MonsterAI primaryTarget)
		local map = self:GetCurrentMap()
		if map == nil then return end
		local shotCount = self:GetThunderCutterShotCount()
		local knockback = self.ThunderCutterLevel >= 3

		local target1 = primaryTarget
		local target2 = nil
		local target3 = nil
		if shotCount >= 2 then
			target2 = self:FindNextThunderTarget(target1, nil)
		end
		if shotCount >= 3 then
			target3 = self:FindNextThunderTarget(target1, target2)
		end

		self:FireThunderCutterShot(map, target1, 1, shotCount, damage, isCrit, knockback)
		if target2 ~= nil then self:FireThunderCutterShot(map, target2, 2, shotCount, damage, isCrit, knockback) end
		if target3 ~= nil then self:FireThunderCutterShot(map, target3, 3, shotCount, damage, isCrit, knockback) end
	end

	-- 썬더 커터 한 발을 shotTarget 위치에 딜레이 후 발동 — 이펙트 스폰 + 그 위치 기준 광역 판정.
	@ExecSpace("ServerOnly")
	method void FireThunderCutterShot(Entity map, MonsterAI shotTarget, integer shot, integer shotCount, number damage, boolean isCrit, boolean knockback)
		local delay = (shot - 1) * self.Card13ShotInterval
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(map) then return end
			if not isvalid(shotTarget) or not isvalid(shotTarget.Entity) or shotTarget._dead then return end
			local centerPos = shotTarget.Entity.TransformComponent.Position
			local fxPos = Vector3(centerPos.x + self.Card13EffectXOffset, centerPos.y + self.Card13EffectYOffset, centerPos.z)
			-- 아이스 커터와 좌표/스케일 산식은 동일하게 두고, 연출만 좌우 반전(FlipX)해서
			-- 대칭되는 방향으로 베어나가는 것처럼 보이게 한다
			local fx = self:SpawnEffect(self.Card13EffectRUID, fxPos, 0, 1, self.Card13EffectScale * (self:GetEffectScaleRatio(shotTarget)), 1)
			if fx ~= nil then
				local renderer = fx.SpriteRendererComponent
				if renderer ~= nil then renderer.FlipX = true end
			end

			-- 판정 중심을 연출이 실제로 그려지는 X좌표(centerPos.x + XOffset)로 맞춰서, 화면에 보이는
			-- 이펙트 안에 있는 몬스터가 실제로도 맞도록 한다(연출과 판정 중심이 어긋나 있던 문제 수정).
			-- Y는 아이스 커터와 동일하게 판정 기준을 그대로 몬스터 위치로 둔다(연출만 위로 띄움).
			-- shotTarget은 기하 판정과 무관하게 항상 명중(오프셋 때문에 조준한 대상이 사거리 밖으로 빠지는 일을 막는다).
			local hitCenterX = centerPos.x + self.Card13EffectXOffset
			local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
			local hitCount = 0
			for _, mob in ipairs(monsters) do
				---@type MonsterAI
				local m = mob
				if not m._dead then
					local isPrimary = (m == shotTarget)
					local mp = m.Entity.TransformComponent.Position
					local dx = mp.x - hitCenterX
					local dy = mp.y - centerPos.y
					local inRange = (dx * dx + dy * dy) <= (self.Card13Radius * self.Card13Radius)
					if isPrimary or (inRange and self:IsSameDepthBand(shotTarget, m)) then
						if isCrit then m:TakeDamageCrit(damage * 2)
						else m:TakeDamage(damage) end
						if knockback then
							local kbScale = self.Card13KnockbackScale
							if m._isBoss or m._isElite then
								-- 보스/엘리트는 넉백 효율 50% 감소 — 밀려날 목표 스케일을 현재 스케일과의 중간값으로 절충
								kbScale = m._currentScale - (m._currentScale - self.Card13KnockbackScale) * 0.5
							end
							m:ApplyKnockback(kbScale)
						end
						hitCount = hitCount + 1
					end
				end
			end
			log("ThunderCutterAttack: shot=" .. shot .. "/" .. shotCount .. " hit=" .. hitCount .. " dmg=" .. math.floor(isCrit and damage * 2 or damage))
		end, delay)
	end

	-- ── 더블 커터 (Card 20) ────────────────────────────────────────

	-- 타당 데미지 — Lv1:300 / Lv2:350 / Lv3:400
	method number GetDoubleCutterDamage(integer level)
		if level >= 3 then return 400
		elseif level >= 2 then return 350
		end
		return 300
	end

	-- 1단계(제자리 겹침 판정) 후, Card20StationaryDuration 뒤에 좌우로 갈라져 이동을 시작한다.
	@ExecSpace("ServerOnly")
	method void DoubleCutterAttack(boolean isCrit, MonsterAI primaryTarget)
		if not isvalid(primaryTarget) or not isvalid(primaryTarget.Entity) or primaryTarget._dead then return end
		local map = self:GetCurrentMap()
		if map == nil then return end
		local level = self.DoubleCutterLevel
		local damage = self:GetCardDamage(20)
		local centerPos = primaryTarget.Entity.TransformComponent.Position

		-- 1단계: 아이스+썬더 이펙트가 같은 자리에 겹쳐 재생되며 광역 판정(출혈+넉백 동시 적용)
		-- 이 두 이펙트는 여기서 파괴하지 않고 그대로 2단계(좌우 이동)에 재사용한다(끊김 없이 이어지도록).
		-- 공용 "skilleffect" 모델은 SkillEffectAI.Duration=0.8초로 스폰 즉시 자체 파괴 타이머가 걸려서
		-- (1단계 1초 + 2단계 이동 최대 1초 = 총 2초를 버티지 못하고 중간에 사라짐), 반드시
		-- "skilleffectlong"(Duration=2.5초)으로 스폰해야 한다.
		local primaryScale = self:GetEffectScaleRatio(primaryTarget)
		local fxIce = self:SpawnEffectWithModel(self.Card11EffectRUID, Vector3(centerPos.x, centerPos.y + self.Card11EffectYOffset + self.Card20YOffsetAdjust, centerPos.z), 0, 1, (self:GetIceCutterRadius(5) / 1.2) * self.Card20IceScaleMult * primaryScale, 1, "skilleffectlong")
		local fxThunder = self:SpawnEffectWithModel(self.Card13EffectRUID, Vector3(centerPos.x + self.Card20ThunderXOffset, centerPos.y + self.Card13EffectYOffset + self.Card20YOffsetAdjust, centerPos.z), 0, 1, self.Card13EffectScale * primaryScale, 1, "skilleffectlong")

		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		local hitCount = 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if not m._dead then
				local isPrimary = (m == primaryTarget)
				local mp = m.Entity.TransformComponent.Position
				local dx = mp.x - centerPos.x
				local dy = mp.y - centerPos.y
				local inRange = (dx * dx + dy * dy) <= (self.Card20HitRadius * self.Card20HitRadius)
				if isPrimary or (inRange and self:IsSameDepthBand(primaryTarget, m)) then
					local finalDmg = damage * self:GetIceStackBonus(m)
					if isCrit then m:TakeDamageCrit(finalDmg * 2)
					else m:TakeDamage(finalDmg) end
					m:ApplyDot(m.MaxHp * self.Card20BleedPercent, 3, 1.0)
					local kbScale = self.Card20KnockbackScale
					if m._isBoss or m._isElite then
						kbScale = m._currentScale - (m._currentScale - self.Card20KnockbackScale) * 0.5
					end
					m:ApplyKnockback(kbScale)
					hitCount = hitCount + 1
				end
			end
		end
		log("DoubleCutterAttack: stationary hit=" .. hitCount .. " dmg=" .. math.floor(isCrit and damage * 2 or damage))

		-- 2단계: Card20StationaryDuration 뒤 좌우로 갈라져 이동 — 아이스/썬더 어느 쪽이 좌/우로 갈지는 매 캐스트 랜덤(서로 반대 방향)
		-- 1단계에서 스폰한 fxIce/fxThunder를 그대로 넘겨 이어서 이동시킨다(파괴 후 재스폰하지 않음).
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			local iceGoesRight = _UtilLogic:RandomDouble() < 0.5
			local iceDir = iceGoesRight and 1 or -1
			self:LaunchDoubleCutterTravel(fxIce, centerPos, iceDir, true, damage, isCrit, primaryTarget)
			self:LaunchDoubleCutterTravel(fxThunder, centerPos, -iceDir, false, damage, isCrit, primaryTarget)
		end, self.Card20StationaryDuration)
	end

	-- 더블 커터 2단계 — 1단계에서 이미 스폰된 fx(제자리 광역에 쓰인 엔티티)를 그대로 받아
	-- direction(+1=오른쪽/-1=왼쪽) 방향으로 매 틱(Card20TravelTickInterval) 위치를 옮기고, 그 위치
	-- 반경 안의 몬스터를(한 번씩만) 타격한다. isIce=true면 출혈, false면 넉백을 적용.
	-- Card20TravelDistance만큼 이동하면 소멸한다.
	@ExecSpace("ServerOnly")
	method void LaunchDoubleCutterTravel(Entity fx, Vector3 startPos, integer direction, boolean isIce, number damage, boolean isCrit, MonsterAI depthAnchor)
		if not isvalid(fx) then return end
		local yOffset = (isIce and self.Card11EffectYOffset or self.Card13EffectYOffset) + self.Card20YOffsetAdjust
		local startX = startPos.x + (isIce and 0 or self.Card20ThunderXOffset)
		fx.TransformComponent.Position = Vector3(startX, startPos.y + yOffset, startPos.z)
		local renderer = fx.SpriteRendererComponent
		if renderer ~= nil then renderer.FlipX = (direction < 0) end

		local hitSet = {}
		local traveled = 0
		local tickId = 0
		tickId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self) or not isvalid(fx) then
				_TimerService:ClearTimer(tickId)
				return
			end
			traveled = traveled + self.Card20TravelSpeed * self.Card20TravelTickInterval
			local curX = startX + direction * traveled
			local fxPos = fx.TransformComponent.Position
			fx.TransformComponent.Position = Vector3(curX, fxPos.y, fxPos.z)

			local map = self:GetCurrentMap()
			if map ~= nil then
				local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
				for _, mob in ipairs(monsters) do
					---@type MonsterAI
					local m = mob
					if not m._dead and not hitSet[m] then
						local mp = m.Entity.TransformComponent.Position
						local dx = mp.x - curX
						local dy = mp.y - startPos.y
						if (dx * dx + dy * dy) <= (self.Card20HitRadius * self.Card20HitRadius) and self:IsSameDepthBand(depthAnchor, m) then
							hitSet[m] = true
							local finalDmg = damage * self:GetIceStackBonus(m)
							if isCrit then m:TakeDamageCrit(finalDmg * 2)
							else m:TakeDamage(finalDmg) end
							if isIce then
								m:ApplyDot(m.MaxHp * self.Card20BleedPercent, 3, 1.0)
							else
								local kbScale = self.Card20KnockbackScale
								if m._isBoss or m._isElite then
									kbScale = m._currentScale - (m._currentScale - self.Card20KnockbackScale) * 0.5
								end
								m:ApplyKnockback(kbScale)
							end
							log("DoubleCutterAttack: travel(" .. (isIce and "ice" or "thunder") .. ") hit dmg=" .. math.floor(isCrit and finalDmg * 2 or finalDmg))
						end
					end
				end
			end

			if traveled >= self.Card20TravelDistance then
				_TimerService:ClearTimer(tickId)
				if isvalid(fx) then fx:Destroy() end
			end
		end, self.Card20TravelTickInterval)
	end

	-- 아쿠아 트랩 (Card 14) — 메즈 스킬. 화면에 가장 가까이 접근한 순서로 GetAquaTrapTargetCount()명을
	-- 한 번에 골라(MagicClawAttack 등이 쓰는 GetClosestTargets와 동일한 선정 방식) 데미지 +
	-- MonsterAI:ApplyStun(완전 정지, 아쿠아 트랩 자체 연출이 있으니 별 이펙트는 끔) + ApplyLevitate(공중
	-- 부양, 비행 유닛은 내부에서 자동 스킵)으로 속박하고, 속박이 끝날 때까지 각자 위치에서 연출이 끊기지
	-- 않도록 이어붙여 재생한다.
	@ExecSpace("ServerOnly")
	method void AquaTrapAttack(number damage, boolean isCrit)
		local targetCount = self:GetAquaTrapTargetCount()
		local rootDuration = self:GetAquaTrapRootDuration()
		local targets = self:GetClosestTargets(targetCount)
		local hitCount = 0
		for _, target in ipairs(targets) do
			target:ApplyStun(rootDuration, false)
			target:ApplyLevitate(rootDuration)
			-- MonsterAI.ApplyLevitate는 대상을 liftHeight(0.35)만큼 fallDuration(최대 0.25초) 동안
			-- 트윈으로 들어올린다. 연출을 즉시(트윈 시작 전 지상 위치에서) 스폰하면 몬스터가 공중으로
			-- 뜨는 동안 연출은 바닥에 남아있어서 "연출이 위아래 따로 뜨는" 것처럼 보인다 — 트윈이 끝나
			-- 몬스터가 이미 최종 부양 높이에 도달한 뒤에 연출을 스폰해서 항상 몬스터와 같은 높이에서
			-- 시작하게 한다(같은 계산식을 ApplyLevitate와 동일하게 재현).
			local liftDelay = math.min(0.25, rootDuration * 0.3)
			-- 데미지도 liftDelay만큼 같이 늦춰서 연출을 먼저 스폰한 뒤에 적용한다 — 원래는 데미지가
			-- 즉시(t=0) 들어가서, 그 데미지로 대상이 즉사(1방 킬)하면 liftDelay 뒤 콜백의 target._dead
			-- 체크에 걸려 구속 연출 자체가 아예 안 뜨는 문제가 있었다. 연출 엔티티는 대상과 무관하게
			-- 독립적으로 스폰되므로, 스폰만 데미지보다 먼저 시켜두면 대상이 그 직후 죽어도 이미 뜬
			-- 연출은 자기 타이머대로 정상 재생/페이드아웃된다(안 죽으면 메즈 종료 시점까지 재생 후
			-- 페이드아웃하고, 죽으면 그 시점까지 뜬 연출을 그대로 유지할 뿐 별도 처리 불필요).
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
				local fxScale = (self:GetEffectScaleRatio(target)) * self.Card14EffectScale
				self:PlayAquaTrapEffect(target, rootDuration - liftDelay, fxScale)
				if isCrit then target:TakeDamageCrit(damage * 2)
				else target:TakeDamage(damage) end
			end, liftDelay)
			hitCount = hitCount + 1
		end
		log("AquaTrapAttack: hit=" .. hitCount .. "/" .. targetCount .. " dmg=" .. math.floor(isCrit and damage * 2 or damage) .. " root=" .. rootDuration)
	end

	-- 매즈(속박) 지속시간(duration) 전체를 하나의 연출로 한 번에 재생하고, 끝나기
	-- Card14EffectFadeOutDuration 전부터 알파를 서서히 0으로 낮춰 자연스럽게 사라지게 한다(기존엔
	-- 짧은 세그먼트를 반복 이어붙이는 방식이었는데, 세그먼트 경계에서 다시 시작하는 것처럼 보이거나
	-- 1방 킬 시 연출이 아예 안 뜨는 등 버그가 반복돼서 유저 요청으로 단순한 "전체 재생 + 페이드아웃"
	-- 방식으로 교체했다).
	@ExecSpace("ServerOnly")
	method void PlayAquaTrapEffect(MonsterAI target, number duration, number fxScale)
		if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
		-- SpawnEffect는 항상 "플레이어의 현재 맵"(GetCurrentMap)에 스폰한다 — 플레이어가 target이 있는
		-- 존을 떠나버리면, target의(다른 존 기준) 좌표를 그대로 써서 지금 존에 엉뚱하게 이펙트가 뜨는
		-- 버그가 있었다. target이 더 이상 플레이어의 현재 존에 없으면 조용히 스폰을 건너뛴다.
		-- 주의: target.Entity.CurrentMap은 존(Zone13/14/15 등) 단위가 아니라 맵 "파일" 단위(예: map13
		-- 전체)를 반환해서 GetCurrentMap()(존 단위, 예: Zone15)과 비교하면 존이 나뉜 맵에서는 실제
		-- 이동이 없어도 항상 불일치로 판정되는 회귀 버그가 있었다 — 대신 존 인덱스(_spawnZoneIndex,
		-- 스폰 당시 넘겨받아 저장해둔 값)를 플레이어의 현재 존 인덱스와 비교한다.
		if self:GetCurrentMap() == nil or target._spawnZoneIndex ~= _MapManager.CurrentMapIndex then return end
		if duration <= 0 then return end
		local p = target.Entity.TransformComponent.Position
		-- fxAI.Duration을 스폰 후에 덮어쓰는 방식은 무효하다(OnBeginPlay가 스폰과 동기 실행되어 이미
		-- 옛 기본값으로 자체 파괴 타이머가 예약된 뒤임) — 반드시 fx:Destroy(duration)으로 직접 파괴
		-- 타이머를 걸어야 한다([[feedback_skilleffect_duration_timing]]과 동일한 패턴). duration이
		-- 기본 "skilleffect" 모델의 0.8초 캡을 넘길 수 있으므로 "skilleffectlong"(2.5초 캡)을 쓴다.
		local fx = self:SpawnEffectWithModel(self.Card14EffectRUID, p, 0, 1, fxScale, self.Card14EffectBaseAlpha, "skilleffectlong")
		if fx == nil then return end
		fx:Destroy(duration)
		local renderer = fx.SpriteRendererComponent
		if renderer == nil then return end
		local fadeDuration = math.min(self.Card14EffectFadeOutDuration, duration)
		local fadeDelay = duration - fadeDuration
		_TimerService:SetTimerOnce(function()
			if not isvalid(fx) or not isvalid(renderer) then return end
			_TweenLogic:PlayTween(self.Card14EffectBaseAlpha, 0.0, fadeDuration, EaseType.Linear, function(alpha)
				if isvalid(renderer) then renderer:SetAlpha(alpha) end
			end)
		end, fadeDelay)
	end

	-- 헤일 스톤 (Card 15) — 바닥(가장 아래 위치한, GetGroundPriorityTargets) 순으로
	-- GetHailStoneTargetCount()명을 골라 각자 위치에 낙하 연출을 먼저 띄우고, 착탄 시점
	-- (Card15ImpactDelay — 메테오(Card5)와 동일한 "연출 먼저, 착탄 시 데미지" 패턴)에 데미지 +
	-- MonsterAI:AddFreezeStack(콜드빔/프리징 이펙트와 동일한 빙결 스택 시스템 — 슬로우/스택
	-- 인디케이터는 그 쪽에서 이미 다 처리해준다)으로 얼린다. 낙하 경로 판정이 "타겟 위쪽"을 보므로
	-- 지상 몬스터를 우선 타겟팅해야 그 위로 서 있는 다른 몬스터가 경로에 걸릴 확률이 높아진다.
	@ExecSpace("ServerOnly")
	method void HailStoneAttack(number damage, boolean isCrit)
		local targetCount = self:GetHailStoneTargetCount()
		local targets = self:GetGroundPriorityTargets(targetCount)
		local map = self:GetCurrentMap()
		local hitCount = 0
		for _, target in ipairs(targets) do
			local p = target.Entity.TransformComponent.Position
			local fx15 = self:SpawnEffectWithModel(self.Card15EffectRUID, Vector3(p.x, p.y + self.Card15EffectYOffset, p.z), 0, self.Card15EffectPlayRate, self.Card15EffectScale * (self:GetEffectScaleRatio(target)), 1, "skilleffectlong")
			if fx15 ~= nil then fx15:Destroy(self.Card15EffectLifetime) end
			hitCount = hitCount + 1

			_TimerService:SetTimerOnce(function()
				if not isvalid(self) or not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
				local finalDmg = damage * self:GetIceStackBonus(target)
				if isCrit then target:TakeDamageCrit(finalDmg * 2)
				else target:TakeDamage(finalDmg) end
				target:AddFreezeStack()
				-- SkillInventory 헤일스톤(인덱스12) Lv9: 10% 확률로 빙결스택 +1 추가, 카드 자체 레벨과 별개
				if self:GetSkillInvLevel(15) >= 9 and _UtilLogic:RandomDouble() < 0.10 then target:AddFreezeStack() end

				-- 얼음이 타겟 머리 위(경로)에서 떨어지는 연출이라, 그 낙하 경로(타겟 바로 위 세로 통로)
				-- 안에 있는 다른 몬스터는 착탄 시점 기준으로 같이 맞아서 전체 데미지를 받는다(각자 본인
				-- 스택 기준 아이스 보너스 적용). 빙결 스택은 원래 타겟에게만 적용 — 경로에 낀 몬스터는 데미지만.
				local pathHitCount = 0
				if map ~= nil then
					local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
					for _, mob in ipairs(monsters) do
						---@type MonsterAI
						local m = mob
						if not m._dead and m ~= target then
							local isPrimary = false
							for _, t2 in ipairs(targets) do
								if m == t2 then isPrimary = true break end
							end
							if not isPrimary then
								local mp = m.Entity.TransformComponent.Position
								local dxPath = math.abs(mp.x - p.x)
								local inPath = dxPath <= self.Card15PathWidth and mp.y > p.y and (mp.y - p.y) <= self.Card15PathHeight
								if inPath and self:IsSameDepthBand(target, m) then
									local finalPathDmg = damage * self:GetIceStackBonus(m)
									if isCrit then m:TakeDamageCrit(finalPathDmg * 2)
									else m:TakeDamage(finalPathDmg) end
									pathHitCount = pathHitCount + 1
								end
							end
						end
					end
				end
				log("HailStoneAttack: impact dmg=" .. math.floor(isCrit and finalDmg * 2 or finalDmg) .. " path=" .. pathHitCount)
			end, self.Card15ImpactDelay)
		end
		log("HailStoneAttack: cast hit=" .. hitCount .. "/" .. targetCount)
	end

	-- 화면 중앙에 해당하는 월드 X — 카메라가 플레이어를 따라가므로 실제 플레이어 위치가 정답이다.
	-- _MapManager.CurrentMapIndex 기반 GetZoneOffsetX는 존 전환 시점에 따라 실제 위치와 어긋날 수 있어서
	-- (킹페페 X=0인데 화면 중앙에 안 온다는 버그의 원인) 플레이어 엔티티 위치를 직접 조회하도록 바꿨다.
	@ExecSpace("ServerOnly")
	method number GetPlayerCenterX()
		for _, userEntity in pairs(_UserService.UserEntities) do
			if isvalid(userEntity) then
				return userEntity.TransformComponent.WorldPosition.x
			end
		end
		return _MonsterSpawner:GetZoneOffsetX(_MapManager.CurrentMapIndex)
	end

	@ExecSpace("ServerOnly")
	method void KingPepeAttack(number damage, boolean isCrit, MonsterAI primaryTarget, boolean isRepeat)
		-- 타겟 위치와 무관하게, 존 중심(offsetX) 기준 좌/우 고정 위치에서 펭귄이 연출을 재생하고,
		-- 그 위치를 중심으로 한 반경(Card12HitRadius) 안의 몬스터를 지상/공중 구분 없이 전부 타격한다.
		-- Lv1~2는 좌펭귄(RUID_A)만, Lv3부터 우펭귄(RUID_B)도 같이 나간다.
		-- Lv5부터: isRepeat이 아니면(=이번 발동의 첫 타격이면) Card12RepeatDelay 뒤에 한 번 더
		-- 같은 공격을 재실행해서 짧은 2연타를 만든다. isRepeat=true인 재귀 호출은 다시 예약하지 않는다.
		local map = self:GetCurrentMap()
		-- 존 경계(예: 15→16 이동) 순간에는 _MapManager.CurrentMapIndex가 이미 다음 존을 가리키는데
		-- 이전 존 엔티티는 아직 파괴 처리 중이라 map은 non-nil이어도 "죽어가는" 참조일 수 있다 —
		-- isvalid(map)만으로 이 경우를 막는다.
		if map == nil or not isvalid(map) then return end
		local level = self.KingPepeLevel
		local rightActive = level >= 3
		-- SpawnByModelId(..., map)의 좌표는 map 기준 "로컬" 좌표다 — GetPlayerCenterX()는 월드 좌표라서
		-- 존 컨테이너 자체가 월드에서 0이 아닌 곳에 있으면(대부분의 존이 그렇다) 그 차이만큼 그대로 어긋난
		-- 채로 스폰돼 화면 밖 허공에 떴었다. map의 WorldPosition을 빼서 로컬로 변환해야 한다
		-- (MonsterSpawner.ToLocalSpawnPos와 동일한 이유/패턴).
		-- 단, map.TransformComponent 자체가 없는 "루트/host" 존(맵1/4/7/10/13/16처럼 container=nil인
		-- 존)이 실존한다 — 실측 확인(map16.map 루트 엔티티에 TransformComponent가 아예 없음, 자식
		-- 컨테이너 존(Zone14 등)만 갖고 있음). 예전엔 이 경우 조용히 return해버려서 존16 같은 루트
		-- 존에서는 킹페페 연출이 영영 뜨지 않는 버그가 있었다. 루트 존은 애초에 에디터에서 이동된 적
		-- 없는 원점(0,0,0) 취급이 맞으므로, TransformComponent가 없으면 월드 오프셋 0으로 폴백한다.
		local mapWorldPos = Vector3(0, 0, 0)
		if isvalid(map.TransformComponent) then
			mapWorldPos = map.TransformComponent.WorldPosition
		end
		local centerX = self:GetPlayerCenterX() - mapWorldPos.x
		local groundY = self.Card12FixedGroundY - mapWorldPos.y

		local leftPos = Vector3(centerX + self.Card12LeftX, groundY, 0)
		self:SpawnEffect(self.Card12EffectRUID_A, leftPos, 0, 1, self.Card12EffectScale, 1)
		local rightPos = nil
		if rightActive then
			rightPos = Vector3(centerX + self.Card12RightX, groundY + self.Card12RightYOffset, 0)
			self:SpawnEffect(self.Card12EffectRUID_B, rightPos, 0, 1, self.Card12EffectScale, 1)
		end

		-- 대미지는 연출이 뜨자마자가 아니라, 펭귄이 실제로 내려찍는 타이밍(연출 시작 후 약 0.3초)에
		-- 맞춰서 적용한다 — 이렇게 해야 Lv5의 2연타도 "효과 2번 = 대미지 2번"이 타이밍까지 맞게 보인다.
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not isvalid(map) then return end
			-- 판정을 "화면 좌/우 절반" 러프 분할 대신, 실제 펭귄 이펙트가 뜨는 위치를 중심으로 한
			-- 반경 판정(아이스 커터와 동일한 방식)으로 바꿔 이펙트 크기/위치와 판정이 항상 일치하도록 한다.
			local radius = self.Card12HitRadius
			local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
			local hitCount = 0
			for _, mob in ipairs(monsters) do
				---@type MonsterAI
				local m = mob
				if not m._dead and isvalid(m) and isvalid(m.Entity) and isvalid(m.Entity.TransformComponent) then
					local mp = m.Entity.TransformComponent.Position
					local dxL = mp.x - leftPos.x
					local dyL = mp.y - leftPos.y
					local hitLeft = (dxL * dxL + dyL * dyL) <= (radius * radius)
					local hitRight = false
					if rightActive then
						local dxR = mp.x - rightPos.x
						local dyR = mp.y - rightPos.y
						hitRight = (dxR * dxR + dyR * dyR) <= (radius * radius)
					end
					if (hitLeft or hitRight) and self:IsSameDepthBand(primaryTarget, m) then
						if isCrit then m:TakeDamageCrit(damage * 2)
						else m:TakeDamage(damage) end
						hitCount = hitCount + 1
					end
				end
			end
			log("KingPepeAttack: hit=" .. hitCount .. " dmg=" .. math.floor(isCrit and damage * 2 or damage) .. " rightActive=" .. tostring(rightActive))
		end, self.Card12HitDelay)

		-- SkillInventory 페페(인덱스11) Lv9: 2연타 확률 +5%. 카드 자체 레벨이 5 미만이라 원래
		-- 2연타가 없는 상태여도, 이 보너스만으로 독립적으로 2연타가 발동할 수 있어야 한다.
		local repeatChance = (level >= 5) and self.Card12RepeatChance or 0
		if self:GetSkillInvLevel(12) >= 9 then repeatChance = repeatChance + 0.05 end
		if not isRepeat and repeatChance > 0 and _UtilLogic:RandomDouble() < repeatChance then
			_TimerService:SetTimerOnce(function()
				if isvalid(self) then
					-- 2번째 타격은 절반 데미지 — 1타는 온전히, 2타는 50%만 들어가도록
					self:KingPepeAttack(damage * 0.5, isCrit, primaryTarget, true)
				end
			end, self.Card12RepeatDelay)
		end
	end

	@ExecSpace("ServerOnly")
	method MonsterAI FindTarget()
		local map = self:GetCurrentMap()
		if map == nil then return nil end
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		local best = nil
		local bestScale = -1
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local monster = mob
			if not monster._dead and monster._currentScale > bestScale then
				best = monster
				bestScale = monster._currentScale
			end
		end
		return best
	end

	-- ── 에너지볼트 (Card 9) ───────────────────────────────────────

	@ExecSpace("ServerOnly")
	method boolean RollEnergyBoltCrit()
		-- MagicCritical 기본 확률 + Lv3 치명타 보너스 + SkillInventory 에너지볼트 Lv9 보너스(+5%)
		local chance = self:GetMagicCriticalChance()
		chance = chance + self.EnergyBoltCritBonus
		if self:GetSkillInvLevel(9) >= 9 then chance = chance + 0.05 end
		if chance <= 0 then return false end
		return _UtilLogic:RandomDouble() < chance
	end

	@ExecSpace("ServerOnly")
	method MonsterAI FindSecondTarget(MonsterAI exclude)
		-- primaryTarget 다음으로 가까이 온(스케일 큰) 살아있는 몬스터 반환
		local map = self:GetCurrentMap()
		if map == nil then return nil end
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		local best = nil
		local bestScale = -1
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if not m._dead and m ~= exclude and m._currentScale > bestScale then
				best = m
				bestScale = m._currentScale
			end
		end
		return best
	end

	@ExecSpace("ServerOnly")
	method void EnergyBoltAttack(MonsterAI primaryTarget)
		-- 레벨별 Card1 기본공격 배율로 대미지 계산 후 단발 또는 2연발(다른 타겟) 발사
		local damage = self:GetCardDamage(9)
		local isCrit = self:RollEnergyBoltCrit()

		if self.EnergyBoltLevel >= 2 then
			-- Lv2+: 1번째 볼트 → primaryTarget, Lv5이면 즉시 그 자리에서 폭발
			local isLv5 = self.EnergyBoltLevel >= 5
			local boltScale = isLv5 and 1.73 or 1.5
			local boltRate  = isLv5 and 1.28 or 1.5
			local finalDmg1 = damage
			if self.FreezingEffectLevel >= 5 and primaryTarget.FreezeStack >= 5 then
				self:TriggerFreezeExplosion(primaryTarget, finalDmg1, isCrit)
			else
				if isCrit then primaryTarget:TakeDamageCrit(finalDmg1 * 2)
				else primaryTarget:TakeDamage(finalDmg1) end
			end
			local p = primaryTarget.Entity.TransformComponent.Position
			local ofs1 = 0.24 * (primaryTarget._currentScale * primaryTarget._scaleMultiplier)
			self:SpawnEffect(self.Card9EffectRUID, Vector3(p.x, p.y + ofs1, p.z), 0, boltRate, boltScale * (self:GetEffectScaleRatio(primaryTarget)), 1)
			if isLv5 then
				self:EnergyBoltExplosion(primaryTarget, isCrit)
			end
			self:ApplyChainLightning(primaryTarget, finalDmg1, isCrit)
			log("EnergyBoltAttack: 1st bolt dmg=" .. math.floor(isCrit and finalDmg1*2 or finalDmg1) .. " lv=" .. self.EnergyBoltLevel)

			local second = self:FindSecondTarget(primaryTarget)

			_TimerService:SetTimerOnce(function()
				-- 0.1s 후 2번째 볼트 → 다른 적, Lv5이면 그 자리에서 폭발
				local t2 = second
				if t2 == nil or not isvalid(t2) or not isvalid(t2.Entity) or t2._dead then
					t2 = primaryTarget
				end
				if isvalid(t2) and isvalid(t2.Entity) and not t2._dead then
					local finalDmg2 = damage
					if self.FreezingEffectLevel >= 5 and t2.FreezeStack >= 5 then
						self:TriggerFreezeExplosion(t2, finalDmg2, isCrit)
					else
						if isCrit then t2:TakeDamageCrit(finalDmg2 * 2)
						else t2:TakeDamage(finalDmg2) end
					end
					local p2 = t2.Entity.TransformComponent.Position
					local ofs2 = 0.24 * (t2._currentScale * t2._scaleMultiplier)
					self:SpawnEffect(self.Card9EffectRUID, Vector3(p2.x, p2.y + ofs2, p2.z), 0, boltRate, boltScale * (self:GetEffectScaleRatio(t2)), 1)
					if isLv5 then
						self:EnergyBoltExplosion(t2, isCrit)
					end
					self:ApplyChainLightning(t2, finalDmg2, isCrit)
					log("EnergyBoltAttack: 2nd bolt dmg=" .. math.floor(isCrit and finalDmg2*2 or finalDmg2))
				end
			end, 0.1)
		else
			-- Lv1: 단발
			local finalDmgSingle = damage
			if self.FreezingEffectLevel >= 5 and primaryTarget.FreezeStack >= 5 then
				self:TriggerFreezeExplosion(primaryTarget, finalDmgSingle, isCrit)
			else
				if isCrit then primaryTarget:TakeDamageCrit(finalDmgSingle * 2)
				else primaryTarget:TakeDamage(finalDmgSingle) end
			end
			local p = primaryTarget.Entity.TransformComponent.Position
			local ofsSingle = 0.24 * (primaryTarget._currentScale * primaryTarget._scaleMultiplier)
			self:SpawnEffect(self.Card9EffectRUID, Vector3(p.x, p.y + ofsSingle, p.z), 0, 1.5, 1.5 * (self:GetEffectScaleRatio(primaryTarget)), 1)
			self:ApplyChainLightning(primaryTarget, finalDmgSingle, isCrit)
			log("EnergyBoltAttack: single bolt dmg=" .. math.floor(isCrit and finalDmgSingle*2 or finalDmgSingle) .. " lv=" .. self.EnergyBoltLevel)
		end
	end

	@ExecSpace("ServerOnly")
	method void EnergyBoltExplosion(MonsterAI center, boolean isCrit)
		-- Lv5 폭발: 이펙트 1회, 볼트 착탄 지점 좌우 ±explosionOffset(연출이 실제로 닿는 범위)에 있는
		-- 몬스터에게만 그 시점 볼트 데미지×1.2×0.5 피해(유저 요청으로 데미지 50% 축소).
		local expDmg = self:GetCardDamage(9) * 1.2 * 0.5
		local map = self:GetCurrentMap()
		if map == nil then return end

		-- 폭발 이펙트: 볼트 착탄 지점 가까이 대칭으로 스폰(유저 요청 — 거의 볼트에 닿을 정도로 중앙에
		-- 몰아줌. 기존 1.0 → 0.35). 연출 크기도 30% 축소(1.2 → 0.84). 데미지 판정 range는 더 이상
		-- 독립된 고정값이 아니라 explosionOffset과 동일하게 묶어서(유저 요청 "범위도 거기에 닿아야
		-- 대미지 들어가게"), 실제로 연출이 닿는 자리에 있는 몬스터만 맞는다.
		local explosionOffset = 0.35
		local explosionVisualScale = 1.2 * 0.7
		local range = explosionOffset
		local centerX = 0
		if isvalid(center) and isvalid(center.Entity) then
			local cp = center.Entity.TransformComponent.Position
			centerX = cp.x
			local expScale = self:GetEffectScaleRatio(center)
			local fxLeft = self:SpawnEffect(self.Card9ExplosionRUID, Vector3(centerX - explosionOffset, cp.y + 0.5, cp.z), 0, 1.0, explosionVisualScale * expScale, 1)
			if fxLeft ~= nil then
				_TimerService:SetTimerOnce(function()
					if isvalid(fxLeft) then fxLeft:Destroy() end
				end, 0.25)
			end
			local fxRight = self:SpawnEffect(self.Card9ExplosionRUID, Vector3(centerX + explosionOffset, cp.y + 0.5, cp.z), 0, 1.0, explosionVisualScale * expScale, 1)
			if fxRight ~= nil then
				local renderer = fxRight.SpriteRendererComponent
				if renderer ~= nil then
					renderer.FlipX = true
				end
				_TimerService:SetTimerOnce(function()
					if isvalid(fxRight) then fxRight:Destroy() end
				end, 0.25)
			end
		end

		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if not m._dead then
				local dx = math.abs(m.Entity.TransformComponent.Position.x - centerX)
				if dx <= range and self:IsSameDepthBand(center, m) then
					if isCrit then m:TakeDamageCrit(expDmg * 2)
					else m:TakeDamage(expDmg) end
				end
			end
		end
	end

	-- ── 프리징 이펙트 헬퍼 ──────────────────────────────────────

	-- 아이스 계열 스킬(콜드빔/아이스커터/헤일스톤) 전용 — 대상의 빙결 스택 수에 비례한 데미지 배율
	-- (Lv1: +5%/스택, Lv2+: +6%/스택). 썬더계열(썬더볼트/에너지볼트)에는 더 이상 적용되지 않는다.
	@ExecSpace("ServerOnly")
	method number GetIceStackBonus(MonsterAI target)
		local skillInvLevel = self:GetSkillInvLevelByIndex(9)
		if self.FreezingEffectLevel <= 0 and skillInvLevel <= 0 then return 1.0 end
		if target == nil or not isvalid(target) then return 1.0 end
		local stack = target.FreezeStack
		if stack <= 0 then return 1.0 end
		local basePct = 0
		if self.FreezingEffectLevel >= 2 then basePct = 0.06
		elseif self.FreezingEffectLevel >= 1 then basePct = 0.05
		end
		-- SkillInventory 프리징이펙트(인덱스9) 레벨의 +3%/+6%/+9%가 스택당 추가로 항상 가산된다
		local skillInvPct = self:GetSkillInvTierPercent(9, 0.03, 0.06, 0.09)
		local bonusPct = stack * (basePct + skillInvPct)
		return 1.0 + bonusPct
	end

	@ExecSpace("ServerOnly")
	method void ApplyChainLightning(MonsterAI source, number baseDmg, boolean isCrit)
		-- 빙결된 몬스터(source)에게 썬더계열(썬더볼트/에너지볼트) 스킬이 적중했을 때만 발동(확률 없이 항상).
		-- Lv3: 1마리(50%) / Lv4: 2마리(50%,35%) / Lv5: 3마리(50%,35%,15%). 아이스 스택 보너스는 적용되지 않는다.
		if self.FreezingEffectLevel < 3 then return end
		if source == nil or not isvalid(source) then return end
		if source.FreezeStack <= 0 then return end
		local maxHops
		if self.FreezingEffectLevel >= 5 then maxHops = 3
		elseif self.FreezingEffectLevel >= 4 then maxHops = 2
		else maxHops = 1
		end
		local hopMults = {0.50, 0.35, 0.15}
		local chainRadius = 2.5
		local map = self:GetCurrentMap()
		if map == nil then return end
		local sourcePos = source.Entity.TransformComponent.Position
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		local chainCount = 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if not m._dead and m ~= source and m.FreezeStack > 0 then
				local dx = math.abs(m.Entity.TransformComponent.Position.x - sourcePos.x)
				if dx <= chainRadius then
					chainCount = chainCount + 1
					local hopMult = hopMults[chainCount]
					local chainDmg = baseDmg * hopMult
					if isCrit then m:TakeDamageCrit(chainDmg * 2)
					else m:TakeDamage(chainDmg) end
					local mPos = m.Entity.TransformComponent.Position
					local fxPos = Vector3(mPos.x, mPos.y + 0.4, mPos.z)
					local fxScale = (self.FreezingEffectLevel >= 5) and 1.632 or (self.FreezingEffectLevel >= 4) and 1.32 or 0.8
					self:SpawnEffect(self.ChainLightningEffectRUID, fxPos, 0, 1.2, fxScale * (self:GetEffectScaleRatio(m)), 1)
					log("ChainLightning hop" .. chainCount .. ": dmg=" .. math.floor(isCrit and chainDmg*2 or chainDmg) .. " (×" .. hopMult .. ")")
					if chainCount >= maxHops then break end
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void TriggerFreezeExplosion(MonsterAI target, number baseDmg, boolean isCrit)
		-- Lv5: 5스택 + 번개 = 빙결 폭발 (AOE 피해 + 스택 초기화)
		if target == nil or not isvalid(target) then return end
		-- 대상에게 일반 피해 먼저 적용
		if isCrit then target:TakeDamageCrit(baseDmg * 2)
		else target:TakeDamage(baseDmg) end
		-- 빙결 스택 초기화
		target:ResetFreezeStack()
		-- 폭발 이펙트 + AOE 데미지
		local pos = target.Entity.TransformComponent.Position
		local expDmg = baseDmg * 0.8
		local expRadius = 2.5
		local freezeExpScale = self:GetEffectScaleRatio(target)
		local fxLeft = self:SpawnEffect(self.Card9ExplosionRUID, Vector3(pos.x - 0.8, pos.y + 0.5, pos.z), 0, 1.2, 0.98 * freezeExpScale, 1)
		if fxLeft ~= nil then
			_TimerService:SetTimerOnce(function() if isvalid(fxLeft) then fxLeft:Destroy() end end, 0.25)
		end
		local fxRight = self:SpawnEffect(self.Card9ExplosionRUID, Vector3(pos.x + 0.8, pos.y + 0.5, pos.z), 0, 1.2, 0.98 * freezeExpScale, 1)
		if fxRight ~= nil then
			local renderer = fxRight.SpriteRendererComponent
			if renderer ~= nil then renderer.FlipX = true end
			_TimerService:SetTimerOnce(function() if isvalid(fxRight) then fxRight:Destroy() end end, 0.25)
		end
		local map = self:GetCurrentMap()
		if map ~= nil then
			local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
			for _, mob in ipairs(monsters) do
				---@type MonsterAI
				local m = mob
				if not m._dead and m ~= target then
					local dx = math.abs(m.Entity.TransformComponent.Position.x - pos.x)
					if dx <= expRadius then
						if isCrit then m:TakeDamageCrit(expDmg * 2)
						else m:TakeDamage(expDmg) end
					end
				end
			end
		end
		log("FreezeExplosion: 빙결 폭발! x=" .. pos.x .. " aoe_dmg=" .. math.floor(expDmg))
	end

	-- ── 쿨타임 비주얼 (슬롯 인덱스 기반) ────────────────────────

	@ExecSpace("Multicast")
	method void PlayCooldownVisual(integer slotIndex, number cooldown)
		if self:IsServer() then return end

		local overlay = nil
		if slotIndex == 0 then overlay = self.basicAttackCooldown
		elseif slotIndex == 1 then overlay = self.cooldown1
		elseif slotIndex == 2 then overlay = self.cooldown2
		elseif slotIndex == 3 then overlay = self.cooldown3
		elseif slotIndex == 4 then overlay = self.cooldown4
		elseif slotIndex == 5 then overlay = self.cooldown5
		else overlay = self.cooldown6
		end
		if overlay == nil then return end

		overlay.Entity:SetEnable(true)
		overlay.FillAmount = 1
		self:RegisterCooldownVisual(overlay, cooldown)
	end

	-- 같은 오버레이를 추적 중인 항목이 있으면 교체하고, 공용 목록에 새로 등록한다
	@ExecSpace("ClientOnly")
	method void RegisterCooldownVisual(SpriteGUIRendererComponent overlay, number duration)
		for i = #self._activeCooldowns, 1, -1 do
			if self._activeCooldowns[i].overlay == overlay then
				table.remove(self._activeCooldowns, i)
			end
		end
		table.insert(self._activeCooldowns, { overlay = overlay, startTime = _UtilLogic.ElapsedSeconds, duration = duration, reversed = false })
	end

	-- 버프 아이콘 전용: 0→1 방향 애니메이션 (처음 아이콘 보임 → 만료 시 완전히 덮임)
	method void RegisterBuffVisual(SpriteGUIRendererComponent overlay, number duration)
		for i = #self._activeCooldowns, 1, -1 do
			if self._activeCooldowns[i].overlay == overlay then
				table.remove(self._activeCooldowns, i)
			end
		end
		table.insert(self._activeCooldowns, { overlay = overlay, startTime = _UtilLogic.ElapsedSeconds, duration = duration, reversed = true })
	end

	-- ── 레벨업 선택 ──────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method void GenerateLevelUpChoices()
		if self._choiceCard1 ~= 0 then
			self._pendingLevelUps = self._pendingLevelUps + 1
			return
		end

		local pool = {}
		-- 슬롯 5개가 이미 다 찬 상태면, 새로 슬롯을 차지해야 하는 카드의 "해금" 선택지는 아예 풀에
		-- 넣지 않는다 — 예전엔 해금을 뽑아도 GetNextEmptySlot()이 0을 반환해 카드가 레벨만 오르고
		-- 슬롯엔 영영 배치되지 못한 채 사실상 사라졌었다(선택지 낭비 버그)
		local hasEmptySlot = self:GetNextEmptySlot() > 0

		-- 캐릭터별 스킬 분리 — 아래 카드 1~24는 전부 아르카나 전용이다. 실피드(SelectedCharacter==1)는
		-- 이 블록 전체를 건너뛰고, 공용 카드(포션)만 공유한다. 실피드 전용 카드가 생기면 이 아래에
		-- "if isSylph then ... end" 블록을 새로 추가한다(카드 번호는 100번대로 구분).
		local isSylph = (_GameManager.SelectedCharacter == 1)

		-- 포션 — 유일한 공용(캐릭터 무관) 카드
		if self.PotionLevel < 5 then
			table.insert(pool, { card = 6, type = "potion" })
		end

		if not isSylph then

		-- 에너지볼트: 미해금이면 해금(슬롯 여유 있을 때만), 해금 후 레벨 < 5이면 강화
		-- 단, 체인 라이트닝으로 이미 조합된 뒤(ChainLightningLevel>0)에는 에너지볼트 자체의 강화
		-- 선택지를 더 안 준다(에너지볼트가 그 슬롯을 이미 떠났으므로).
		if self.ChainLightningLevel == 0 then
			if self.EnergyBoltLevel == 0 then
				if hasEmptySlot then table.insert(pool, { card = 9, type = "unlock" }) end
			elseif self.EnergyBoltLevel < 5 then
				table.insert(pool, { card = 9, type = "energybolt_up" })
			end
		end

		-- 체인 라이트닝(Card 19, 조합 스킬): 에너지볼트 Lv5 + 매직 부스터 보유 시 등장 — 새 슬롯이
		-- 필요없고 에너지볼트가 있던 슬롯을 그대로 넘겨받으므로 hasEmptySlot 체크를 건너뛴다.
		if self.EnergyBoltLevel >= 5 and self:IsCardUnlocked(7) and self.ChainLightningLevel == 0 then
			table.insert(pool, { card = 19, type = "unlock" })
		elseif self.ChainLightningLevel > 0 and self.ChainLightningLevel < 3 then
			table.insert(pool, { card = 19, type = "chainlightning_up" })
		end

		-- 아이스 커터: 미해금이면 해금(슬롯 여유 있을 때만), 해금 후 레벨 < 5이면 강화 (더블 커터로 조합되면 더 이상 등장하지 않음)
		if self.DoubleCutterLevel == 0 then
			if self.IceCutterLevel == 0 then
				if hasEmptySlot then table.insert(pool, { card = 11, type = "unlock" }) end
			elseif self.IceCutterLevel < 5 then
				table.insert(pool, { card = 11, type = "icecutter_up" })
			end
		end

		-- 페페(Card12): 미해금이면 해금(슬롯 여유 있을 때만), 해금 후 레벨 < 5이면 강화
		-- (킹페페로 이미 조합된 뒤에는 더 이상 등장하지 않음 — 그 슬롯을 이미 떠났으므로)
		if self.GrandPepeLevel == 0 then
			if self.KingPepeLevel == 0 then
				if hasEmptySlot then table.insert(pool, { card = 12, type = "unlock" }) end
			elseif self.KingPepeLevel < 5 then
				table.insert(pool, { card = 12, type = "kingpepe_up" })
			end
		end

		-- 킹페페(Card 21, 조합 스킬): 매직 부스터 + 매직 아머(둘 다 슬롯 없는 패시브) 보유 +
		-- 페페 Lv5 보유 시 등장 — 새 슬롯이 필요없고 페페의 슬롯을 그대로 넘겨받는다.
		if self.KingPepeLevel >= 5 and self:IsCardUnlocked(7) and self:IsCardUnlocked(18) and self.GrandPepeLevel == 0 then
			table.insert(pool, { card = 21, type = "unlock" })
		elseif self.GrandPepeLevel > 0 and self.GrandPepeLevel < 3 then
			table.insert(pool, { card = 21, type = "grandpepe_up" })
		end

		-- 썬더 커터: 미해금이면 해금(슬롯 여유 있을 때만), 해금 후 레벨 < 5이면 강화 (더블 커터로 조합되면 더 이상 등장하지 않음)
		if self.DoubleCutterLevel == 0 then
			if self.ThunderCutterLevel == 0 then
				if hasEmptySlot then table.insert(pool, { card = 13, type = "unlock" }) end
			elseif self.ThunderCutterLevel < 5 then
				table.insert(pool, { card = 13, type = "thundercutter_up" })
			end
		end

		-- 더블 커터 (조합 스킬 — 아이스커터+썬더커터 둘 다 5레벨이면 해금, 슬롯 여유 불필요)
		if self.IceCutterLevel >= 5 and self.ThunderCutterLevel >= 5 and self.DoubleCutterLevel == 0 then
			table.insert(pool, { card = 20, type = "unlock" })
		elseif self.DoubleCutterLevel > 0 and self.DoubleCutterLevel < 3 then
			table.insert(pool, { card = 20, type = "doublecutter_up" })
		end

		-- 아쿠아 트랩: 미해금이면 해금(슬롯 여유 있을 때만), 해금 후 레벨 < 5이면 강화
		-- (아쿠아 서지로 이미 조합된 뒤에는 더 이상 등장하지 않음 — 그 슬롯을 이미 떠났으므로)
		if self.AquaSurgeLevel == 0 then
			if self.AquaTrapLevel == 0 then
				if hasEmptySlot then table.insert(pool, { card = 14, type = "unlock" }) end
			elseif self.AquaTrapLevel < 5 then
				table.insert(pool, { card = 14, type = "aquatrap_up" })
			end
		end

		-- 아쿠아 서지(Card 24, 조합 스킬): 아쿠아 트랩 Lv5 + 메디테이션(슬롯 없는 패시브) 보유 시
		-- 등장 — 새 슬롯이 필요없고 아쿠아 트랩의 슬롯을 그대로 넘겨받는다.
		if self.AquaTrapLevel >= 5 and self:IsCardUnlocked(22) and self.AquaSurgeLevel == 0 then
			table.insert(pool, { card = 24, type = "unlock" })
		elseif self.AquaSurgeLevel > 0 and self.AquaSurgeLevel < 3 then
			table.insert(pool, { card = 24, type = "aquasurge_up" })
		end

		-- 헤일 스톤: 미해금이면 해금(슬롯 여유 있을 때만), 해금 후 레벨 < 5이면 강화
		-- (헤일 버스트로 이미 조합된 뒤에는 더 이상 등장하지 않음 — 그 슬롯을 이미 떠났으므로)
		if self.HailBurstLevel == 0 then
			if self.HailStoneLevel == 0 then
				if hasEmptySlot then table.insert(pool, { card = 15, type = "unlock" }) end
			elseif self.HailStoneLevel < 5 then
				table.insert(pool, { card = 15, type = "hailstone_up" })
			end
		end

		-- 헤일 버스트(Card 23, 조합 스킬): 헤일 스톤 Lv5 + 프리징 이펙트 + 메디테이션(둘 다 슬롯 없는
		-- 패시브) 보유 시 등장 — 새 슬롯이 필요없고 헤일 스톤의 슬롯을 그대로 넘겨받는다.
		if self.HailStoneLevel >= 5 and self:IsCardUnlocked(10) and self:IsCardUnlocked(22) and self.HailBurstLevel == 0 then
			table.insert(pool, { card = 23, type = "unlock" })
		elseif self.HailBurstLevel > 0 and self.HailBurstLevel < 3 then
			table.insert(pool, { card = 23, type = "hailburst_up" })
		end

		-- Card1(파이어샷)은 더 이상 일반 선택지 풀에 상시로 끼지 않는다 — 다른 모든 카드가 업그레이드할
		-- 게 남아있지 않을 때만(아래 "풀이 3개 미만이면 패딩" 로직) 등장한다. 유일하게 상한이 없어서
		-- 항상 채워줄 수 있는 카드이기 때문.

		-- 포션은 함수 최상단(공용 카드 섹션)에서 이미 넣었다 — 여기서 다시 넣지 않는다(중복 방지).

		-- 패시브 카드 (미해금이면 unlock, 해금 후 레벨 < 5이면 강화)
		if not self:IsCardUnlocked(7) then
			table.insert(pool, { card = 7, type = "unlock" })
		elseif self.MagicBoosterLevel < 5 then
			table.insert(pool, { card = 7, type = "booster_up" })
		end
		if not self:IsCardUnlocked(8) then
			table.insert(pool, { card = 8, type = "unlock" })
		elseif self.MagicCriticalLevel < 5 then
			table.insert(pool, { card = 8, type = "critical_up" })
		end

		-- 콜드 빔: 미해금이면 해금(슬롯 여유 있을 때만), 해금 후 레벨 < 5이면 강화 (카드9~15와 동일한 Lv1~5 트랙)
		-- 단, 아이스 스트라이크로 이미 조합된 뒤(IceStrikeLevel>0)에는 콜드빔 자체의 강화 선택지를 더 안 준다
		-- (콜드빔이 그 슬롯을 이미 떠났으므로).
		if self.IceStrikeLevel == 0 then
			if self.ColdBeamLevel == 0 then
				if hasEmptySlot then table.insert(pool, { card = 3, type = "unlock" }) end
			elseif self.ColdBeamLevel < 5 then
				table.insert(pool, { card = 3, type = "coldbeam_up" })
			end
		end

		-- 아이스 스트라이크(Card 17, 조합 스킬): 콜드빔 Lv5 + 프리징 이펙트 보유 시 등장 — 새 슬롯이
		-- 필요없고 콜드빔이 있던 슬롯을 그대로 넘겨받으므로 hasEmptySlot 체크를 건너뛴다.
		if self.ColdBeamLevel >= 5 and self:IsCardUnlocked(10) and self.IceStrikeLevel == 0 then
			table.insert(pool, { card = 17, type = "unlock" })
		elseif self.IceStrikeLevel > 0 and self.IceStrikeLevel < 3 then
			table.insert(pool, { card = 17, type = "icestrike_up" })
		end

		-- 썬더 볼트: 미해금이면 해금(슬롯 여유 있을 때만), 해금 후 레벨 < 5이면 강화 (카드9~15와 동일한 Lv1~5 트랙)
		-- 단, 썬더스톰으로 이미 조합된 뒤(ThunderStormLevel>0)에는 더 이상 썬더볼트 자체의 강화 선택지를 주지 않는다
		-- (썬더볼트가 그 슬롯을 이미 떠났으므로).
		if self.ThunderStormLevel == 0 then
			if self.ThunderBoltLevel == 0 then
				if hasEmptySlot then table.insert(pool, { card = 4, type = "unlock" }) end
			elseif self.ThunderBoltLevel < 5 then
				table.insert(pool, { card = 4, type = "thunderbolt_up" })
			end
		end

		-- 썬더스톰(Card 16, 조합 스킬): 썬더볼트 Lv5 + 매직크리티컬 보유 시 등장 — 새 슬롯이 필요없고
		-- 썬더볼트가 있던 슬롯을 그대로 넘겨받으므로 hasEmptySlot 체크를 건너뛴다(슬롯 6개가 꽉 차도 등장).
		if self.ThunderBoltLevel >= 5 and self:IsCardUnlocked(8) and self.ThunderStormLevel == 0 then
			table.insert(pool, { card = 16, type = "unlock" })
		elseif self.ThunderStormLevel > 0 and self.ThunderStormLevel < 3 then
			table.insert(pool, { card = 16, type = "thunderstorm_up" })
		end

		-- 프리징 이펙트 (패시브) — 2개 항목으로 출현 확률 보강
		if not self:IsCardUnlocked(10) then
			table.insert(pool, { card = 10, type = "unlock" })
			table.insert(pool, { card = 10, type = "unlock" })
		elseif self.FreezingEffectLevel < 5 then
			table.insert(pool, { card = 10, type = "freeze_up" })
			table.insert(pool, { card = 10, type = "freeze_up" })
		end

		-- 매직 아머 (패시브) — 슬롯 없이 레벨만 증가
		if not self:IsCardUnlocked(18) then
			table.insert(pool, { card = 18, type = "unlock" })
		elseif self.MagicArmorLevel < 5 then
			table.insert(pool, { card = 18, type = "armor_up" })
		end

		-- 메디테이션 (패시브) — 슬롯 없이 레벨만 증가
		if not self:IsCardUnlocked(22) then
			table.insert(pool, { card = 22, type = "unlock" })
		elseif self.MeditationLevel < 5 then
			table.insert(pool, { card = 22, type = "meditation_up" })
		end

		end -- if not isSylph

		-- 실피드 전용 카드 — 바람의 시(Card101, 슬롯형 정식 스킬 1호): 미해금이면 해금(슬롯 여유 있을
		-- 때만), 해금 후 레벨 < 5이면 강화
		if isSylph then
			if self.WindPoemLevel == 0 then
				if hasEmptySlot then table.insert(pool, { card = 101, type = "unlock" }) end
			elseif self.WindPoemLevel < 5 then
				table.insert(pool, { card = 101, type = "windpoem_up" })
			end
		end

		-- Fisher-Yates 셔플
		for i = #pool, 2, -1 do
			local j = _UtilLogic:RandomIntegerRange(1, i)
			pool[i], pool[j] = pool[j], pool[i]
		end

		-- 카드 중복 없이 3개 선택 (같은 카드의 dmg+cd 동시 등장 방지)
		local chosen = {}
		local usedCards = {}
		for _, entry in ipairs(pool) do
			if not usedCards[entry.card] then
				usedCards[entry.card] = true
				table.insert(chosen, entry)
				if #chosen == 3 then break end
			end
		end

		-- 풀이 3개 미만이면 상시 기본공격(파이어샷/애로우샷) 강화로 패딩 — 다른 모든 카드가 업그레이드할
		-- 게 없을 때 진입하는 유일한 경로. 5회 이후로는 쿨타임 선택지가 없으므로(영구 고정) 데미지만
		-- 나온다. 실피드(SelectedCharacter==1)는 파이어샷이 아예 안 틱되므로 애로우샷(카드25)으로 패딩해야
		-- 한다 — 안 그러면 실피드가 다른 카드를 다 채운 뒤엔 아무 효과 없는 선택지만 계속 뜨게 된다.
		local basicCard = (_GameManager.SelectedCharacter == 1) and 25 or 1
		local basicUpgradeCount = (basicCard == 25) and self.ArrowShotUpgradeCount or self.Card1UpgradeCount
		local basicMultiplierCap = (basicCard == 25) and self.ArrowShotMultiplierCap or self.Card1MultiplierCap
		while #chosen < 3 do
			local basicType = "dmg"
			if basicUpgradeCount < basicMultiplierCap and _UtilLogic:RandomDouble() < 0.5 then
				basicType = "cd"
			end
			table.insert(chosen, { card = basicCard, type = basicType })
		end

		self._choiceCard1 = chosen[1].card ; self._choiceType1 = chosen[1].type
		self._choiceCard2 = chosen[2].card ; self._choiceType2 = chosen[2].type
		self._choiceCard3 = chosen[3].card ; self._choiceType3 = chosen[3].type

		self:ShowLevelUpChoices(
			self._choiceCard1, self._choiceType1,
			self._choiceCard2, self._choiceType2,
			self._choiceCard3, self._choiceType3)
	end

	-- 카드 6~12(레벨업 선택지 3장)의 짧은 효과 태그 — "광역,스턴" 스타일로 한 줄에 훑어볼 수 있게
	method string GetChoiceEffectTag(integer cardIdx)
		if cardIdx == 6 then return "지속회복"
		elseif cardIdx == 1 then return "기본공격"
		elseif cardIdx == 25 then return "기본공격"
		elseif cardIdx == 2 then return "다단타격"
		elseif cardIdx == 3 then return "관통,둔화"
		elseif cardIdx == 4 then return "관통,스턴"
		elseif cardIdx == 5 then return "광역,화상"
		elseif cardIdx == 7 then return "쿨감버프"
		elseif cardIdx == 8 then return "크리티컬버프"
		elseif cardIdx == 9 then return "관통,연쇄"
		elseif cardIdx == 10 then return "빙결,연쇄"
		elseif cardIdx == 11 then return "광역,출혈"
		elseif cardIdx == 12 then return "고정,광역"
		elseif cardIdx == 13 then return "광역,넉백"
		elseif cardIdx == 14 then return "다중,속박"
		elseif cardIdx == 15 then return "다중,빙결"
		elseif cardIdx == 16 then return "광역,스턴,3연타"
		elseif cardIdx == 17 then return "다중,슬로우,빙결"
		elseif cardIdx == 18 then return "패시브,피해감소"
		elseif cardIdx == 19 then return "연쇄,치명타"
		elseif cardIdx == 20 then return "광역,관통,출혈,넉백"
		elseif cardIdx == 21 then return "고정,광역,확률2연타"
		elseif cardIdx == 22 then return "패시브,피해증가"
		elseif cardIdx == 23 then return "다중,빙결,범위"
		elseif cardIdx == 24 then return "다중,속박,추가타"
		elseif cardIdx == 101 then return "다중,관통"
		end
		return ""
	end

	method string GetPotionIconRUID(integer level)
		if level == 2 then return self.Potion2RUID
		elseif level == 3 then return self.Potion3RUID
		elseif level == 4 then return self.Potion4RUID
		elseif level == 5 then return self.Potion5RUID
		end
		return self.Potion1RUID
	end

	-- 선택 카드 1장을 슬롯 1~5와 동일한 형태(아이콘+Lv+이름+짧은 효과 태그)로 채운다.
	-- "XXXX 해금!" 같은 문장형 타이틀은 더 이상 안 쓰고, level엔 "Lv{n}"만 짧게 표기한다
	method void SetChoiceCardText(SpriteGUIRendererComponent icon, TextComponent title, TextComponent name, TextComponent desc, integer cardIdx, string upgradeType)
		desc.Text = self:GetChoiceEffectTag(cardIdx)

		if cardIdx == 6 then
			local potionNames = {"빨간 포션", "하얀 포션", "장어구이", "쭈쭈바", "엘릭서"}
			local nextLevel = math.min(self.PotionLevel + 1, 5)
			icon.ImageRUID = self:GetPotionIconRUID(nextLevel)
			title.Text = "Lv" .. nextLevel
			name.Text  = potionNames[nextLevel]
			return
		end

		if cardIdx == 7 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.MagicBoosterLevel + 1)
			icon.ImageRUID = self.Card7IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card7Name
			return
		end

		if cardIdx == 8 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.MagicCriticalLevel + 1)
			icon.ImageRUID = self.Card8IconRUID
			title.Text = "Lv" .. nextLevel
