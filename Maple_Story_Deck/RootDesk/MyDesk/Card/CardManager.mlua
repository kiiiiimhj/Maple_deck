		if cardIdx == 151 then return self.ComboAttackLevel > 0 end
		if cardIdx == 152 then return self.SlashLevel > 0 end
		if cardIdx == 153 then return self.BrandishLevel > 0 end
		if cardIdx == 154 then return self.FlashSlashLevel > 0 end
		if cardIdx == 155 then return self.ChargeLevel > 0 end
		if cardIdx == 156 then return self.AuraBladeLevel > 0 end
		if cardIdx == 157 then return self.RagingBlowLevel > 0 end
		if cardIdx == 158 then return self.LeapAttackLevel > 0 end
		if cardIdx == 160 then return self.BraveSlashLevel > 0 end
