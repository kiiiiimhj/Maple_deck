@Logic
script CardManager extends Logic

	-- 카드별 데미지 (기본공격=100 기준 비율)
	@Sync property number Card1Damage = 100
	@Sync property number Card2Damage = 130
	@Sync property number Card3Damage = 110
	@Sync property number Card4Damage = 90
	@Sync property number Card5Damage = 80

	-- 카드별 쿨타임 (초)
	@Sync property number Card1Cooldown = 0.8
	@Sync property number Card2Cooldown = 1.3
	@Sync property number Card3Cooldown = 2.0
	@Sync property number Card4Cooldown = 3.2
	@Sync property number Card5Cooldown = 5.0

	-- 카드별 스킬 이름
	property string Card1Name = "파이어 샷"
	property string Card2Name = "매직 클로"
	property string Card3Name = "콜드 빔"
	property string Card4Name = "썬더 볼트"
	property string Card5Name = "메테오"

	-- 카드별 스킬 아이콘 RUID
	property string Card2IconRUID = "4e76419dd50a4ca99103118dd05e4628"
	property string Card3IconRUID = "31c30270de024b4687f79842a2344fc4"
	property string Card4IconRUID = "aaf8b238c8b14370b008eed503bec731"
	property string Card5IconRUID = "b10fbed8848f49f685863e595d0909f8"

	-- 카드별 스킬 이펙트 RUID (animationclip)
	property string Card1EffectRUID = "602f80c91c2a4bc18d829f00e423f661"
	property string Card2EffectRUID = "598d2d1859e84eaab18ae460a0a1e0a4"
	property string Card3EffectRUID = "9bdeae82f43243ac9d0e271113685f2d"
	property string Card4EffectRUID = "33fc60d9910448a2b36035277b28c354"
	property string ChainLightningEffectRUID = "b499aa0ce95647ceb592198e0ce0d97c"
	property string Card5EffectRUID = "8aaeeb6a40ea49bb80699f1fda5bf428"

	-- 메테오 낙하 이펙트가 착탄(폭발 시작)하는 시점에 맞춰 데미지를 적용하기 위한 지연 시간(초)
	property number Card5ImpactDelay = 0.3

	-- 콜드빔 연출은 0.8s 생존 동안 5프레임 클립이 약 0.605s 주기로 두 번 재생된다(실측).
	-- 두 번째 비주얼이 시작되는 시점에 맞춰 데미지를 반으로 나눠 한 번 더 적용한다.
	property number Card3SecondHitDelay = 0.605

	-- 업그레이드(데미지/쿨타임/해금 불문, 매번)할 때마다 누적되는 카운트 — 매직클로/콜드빔/썬더볼트의 타겟 수·확률 스케일링에 사용
	@Sync property integer Card2UpgradeCount = 0
	@Sync property integer Card3UpgradeCount = 0
	@Sync property integer Card4UpgradeCount = 0

	-- 슬롯별 카드 배치 (0=비어있음, 2~5=카드번호) — 1번 슬롯부터 순서대로 쌓임
	@Sync property integer Slot1Card = 0
	@Sync property integer Slot2Card = 0
	@Sync property integer Slot3Card = 0
	@Sync property integer Slot4Card = 0
	@Sync property integer Slot5Card = 0

	-- 포션
	@Sync property integer PotionLevel = 0
	property number PotionCooldown = 15.0
	property number _potionTimer = 0
	property string Potion1RUID = "234aca1a4ce946119b68e3717991e775"
	property string Potion2RUID = "289c7bdcbdc8484ab7bad688b2519ca7"
	property string Potion3RUID = "2d35e350465c47f39eff7596f5c01f22"
	property string Potion4RUID = "6c5241d1d1114c50943f05c3e5982f72"
	property string Potion5RUID = "1a0816991d0b4274ad2ab5e0abfafbb4"
	property SpriteGUIRendererComponent potionSlot = "e1153f7d-16c0-4e61-849f-2e181d43f0b3"
	property SpriteGUIRendererComponent potionImage = "4193001a-5de7-497b-be4a-49f296d3651b"
	property SpriteGUIRendererComponent potionCooldown = "efb99414-2206-4dce-a52d-96da7c0f3f61"

	-- 엘리트 몬스터 처치 드롭(카드 강화) 연출용 — 동시에 최대 3장 드롭 가능하므로 아이콘 3개 독립 운용
	property SpriteGUIRendererComponent dropFlyIcon = "85419574-ad70-40f3-9f78-392334e80509"
	property SpriteGUIRendererComponent dropFlyIcon2 = "6516c9f2-457c-488c-886b-26ea93066cad"
	property SpriteGUIRendererComponent dropFlyIcon3 = "be0f3299-ada5-4ea6-b9b7-f41e9a85934b"

	-- 카드 드롭이 슬롯에 도착했을 때 재생하는 반짝이 파티클
	property UIBasicParticleComponent slotSparkle = "50d75110-7613-45f0-a45e-a2a8df2aa42a"

	-- 아이템 드롭 등장 Y 좌표 보정 (죽은 위치를 화면 좌표로 환산한 값에 더해 살짝 위로 띄운다)
	property number DropYOffset = 60

	-- 드롭 팝 연출(PlayDropPop 내부 3단계 홉 0.32+0.16+0.11)과 슬롯 비행(FlyCardDropToSlot) 시간 합 —
	-- 서버가 카드 강화를 "카드가 슬롯에 실제로 도착하는 시점"에 맞춰 적용하기 위한 기준값
	property number DropPopDuration = 0.59
	property number DropFlyDuration = 0.6

	-- 카드 슬롯 프레임 비주얼 바인딩
	property SpriteGUIRendererComponent slot1 = "928a6142-681a-42d4-8171-34d4ef8bbd29"
	property SpriteGUIRendererComponent slot2 = "48cc4ad8-2c80-48cb-abb4-aac6326cf80c"
	property SpriteGUIRendererComponent slot3 = "acff74f4-27c4-4fd1-b671-f0ed81a7e880"
	property SpriteGUIRendererComponent slot4 = "f04dcc8a-e646-4039-97cf-c0e5a7c7a62d"
	property SpriteGUIRendererComponent slot5 = "d35d73b8-a7d0-45b7-b9b9-c71bfd64464a"
	-- 빈 카드 슬롯에 보여줄 카드 뒷면 이미지
	property string EmptySlotRUID = "a4027817dbc84dbbba125a5e67464343"
	-- 카드 획득 시 뒤집히는 연출의 절반(접히는 데 걸리는 시간) — 전체 연출은 이 값의 2배
	property number SlotFlipHalfDuration = 0.15
	property TextComponent slotNum1 = "9dbf6804-7f8e-4469-9c8f-1711827c2f1f"
	property TextComponent slotNum2 = "8aaccdf3-adb2-4fee-8979-85e289c1c5b6"
	property TextComponent slotNum3 = "ea960b97-902a-4850-8d31-e5151c5071fa"
	property TextComponent slotNum4 = "a97a4a54-341c-493e-92dc-fed5f9a0709a"
	property TextComponent slotNum5 = "d598dd7c-af41-40f0-9274-efec6ff970b5"
	-- 기본공격(파이어샷) 전용 쿨타임 — 카드슬롯 좌측 원형 칼 아이콘
	property SpriteGUIRendererComponent basicAttackCooldown = "269d97df-acbe-4b92-a02c-da81ecd840aa"
	property SpriteGUIRendererComponent cooldown1 = "36fe1d6a-8c10-4faa-8929-5366fe424eba"
	property SpriteGUIRendererComponent cooldown2 = "74ed2153-ce7a-485a-b608-80622f2cf950"
	property SpriteGUIRendererComponent cooldown3 = "80dae068-7b6d-412d-ba4c-bb6a723a4b01"
	property SpriteGUIRendererComponent cooldown4 = "c52e562e-ba7d-430b-94c8-084cd017b2f6"
	property SpriteGUIRendererComponent cooldown5 = "ea3ddc4c-07ea-478d-91bc-127e283295a2"

	-- 레벨업 선택 UI 바인딩
	property Entity choiceCard1 = "dca81800-b071-410b-b2cb-d33ec977488a"
	property Entity choiceCard2 = "a8324fff-1c67-492e-a60f-ee76c786a2e3"
	property Entity choiceCard3 = "2a1cbc75-3a0a-46fe-a2a4-e5f24a707167"
	property ButtonComponent choiceBtn1 = "dca81800-b071-410b-b2cb-d33ec977488a"
	property ButtonComponent choiceBtn2 = "a8324fff-1c67-492e-a60f-ee76c786a2e3"
	property ButtonComponent choiceBtn3 = "2a1cbc75-3a0a-46fe-a2a4-e5f24a707167"
	property TextComponent choiceTitle1 = "8a9b71e4-ed02-49b3-9860-c1794792457b"
	property TextComponent choiceTitle2 = "73cf59f0-60c0-452d-8147-da0e25191f75"
	property TextComponent choiceTitle3 = "e55e6074-e8c2-43fe-b27e-b6b98de530f6"
	property TextComponent choiceDesc1 = "2e0b298e-445e-4785-878e-cb97b0cbcba4"
	property TextComponent choiceDesc2 = "ccd49d67-753f-40a6-a9a9-d6e9a6937a9b"
	property TextComponent choiceDesc3 = "b5a74801-f027-4fd7-8676-7f288a5808f3"

	-- 패시브 카드 레벨 (max 5)
	-- 부스터: 지속 20+(레벨 삼각수)초, 쿨타임 35초 / 크리티컬: 지속 15+(레벨 삼각수)초, 쿨타임 30초
	-- 레벨 5 → 삼각수 15 → 지속=쿨타임 → 영구 활성
	@Sync property integer MagicBoosterLevel = 0
	@Sync property integer MagicCriticalLevel = 0
	property boolean _boosterActive = false
	property number  _boosterTimer  = 0
	property boolean _critActive    = false
	property number  _critTimer     = 0
	property string Card7Name = "매직 부스터"
	property string Card8Name = "매직 크리티컬"
	property string Card7IconRUID = "d189c25f4a0d4097b702106758500286"  -- 스태프 부스터 아이콘 (공속 증가 계열)
	property string Card8IconRUID = "1b1eea5b619a4a57ba3f20649feda62c"  -- 매직 크리티컬 공식 아이콘
	property number Card7Cooldown = 35.0   -- 매직 부스터 슬롯 쿨타임 (= max 레벨 지속시간 → 영구 활성)
	property number Card8Cooldown = 30.0   -- 매직 크리티컬 슬롯 쿨타임

	-- 에너지볼트 (Card 9) — 레벨업으로 해금/강화하는 주력 스킬 카드
	-- Lv1: 볼트 1발 / Lv2: 데미지 +25% / Lv3: 2연발(0.1s) / Lv4: 치명타 +20% / Lv5: 폭발 추가
	@Sync property integer EnergyBoltLevel = 0
	property number  EnergyBoltCritBonus = 0.0   -- Lv4 치명타 추가 확률
	property string Card9Name = "에너지볼트"
	property string Card9IconRUID = "ff3bf7e0ef354e4a981aa5484053be66"
	property string Card9EffectRUID = "d393500fd23f4537a2dd1f65089fc4a1"    -- 볼트 착탄 이펙트
	property string Card9ExplosionRUID = "64180cd54e1d41e3a1b434f90ed76020" -- Lv5 폭발 이펙트
	property number Card9Cooldown = 1.5

	-- 프리징 이펙트 (Card 10) — 패시브, 콜드빔 빙결 스택 + 번개 보너스 데미지
	-- Lv1: 시스템 활성 / Lv2: 슬로우+1s·보너스증가 / Lv3: 연쇄번개 1대상 / Lv4: 연쇄 3대상 / Lv5: 5스택+번개=빙결폭발
	@Sync property integer FreezingEffectLevel = 0
	property string Card10Name = "프리징 이펙트"
	property string Card10IconRUID = "719213847fdf4b50a109a263e784f0c0"

	-- 버프 아이콘 UI 바인딩
	property Entity boosterBuff = "8ac3662e-b083-4498-8295-33fcfcb9f1e2"
	property SpriteGUIRendererComponent boosterFill = "bfc40004-e62c-4d57-aa03-fc56151442e8"
	property Entity critBuff = "233abc2f-676d-48a2-ac24-f03fb165d4d2"
	property SpriteGUIRendererComponent critFill = "00adcd2c-7b51-41bb-9e52-2f814ea02f02"
	property Entity freezeBuff = "b57044c6-36ce-47ab-92e9-b76aee3ee169"
	property SpriteGUIRendererComponent freezeFill = "f62a3df5-ddf1-4642-9d3b-8b28127a9abe"

	-- 활성 버프 순서 추적 (획득 순으로 왼쪽부터)
	property any _activeBuffOrder = nil

	-- 말풍선 UI 바인딩
	property Entity tooltipPanel = "4615be3c-8628-4e55-ab57-ef285284d988"
	property TextComponent tooltipName = "6bcae722-631a-41a7-b349-89439ec2f81e"
	property TextComponent tooltipDmg = "23e460d7-77a0-4906-8284-d293d3a85748"
	property TextComponent tooltipCd = "8a0eef9f-0bf6-452a-a641-ccbaadf74212"
	property TextComponent tooltipExtra = "44c7b4c3-6481-407f-9ec5-d981eebb1823"
	property ButtonComponent slotBtn1 = "5b6b4c7d-d3c2-4b53-8f33-620eb97e4016"
	property ButtonComponent slotBtn2 = "af45836e-1c6b-4ea1-82c0-f4239fb8d814"
	property ButtonComponent slotBtn3 = "8a207abb-b05d-4a1c-b7ed-189206160352"
	property ButtonComponent slotBtn4 = "dbf63dd0-044b-490b-9812-a71d27bcbd7a"
	property ButtonComponent slotBtn5 = "d61da933-cc33-411a-9adf-a4aef9ce81e2"
	property integer _tooltipToken = 0

	-- 에디터 디버그용 (배포 전 false로 변경)
	property boolean DebugMode = true
	property any _debugKeyHandler = nil

	-- 서버 전용 타이머 (슬롯별)
	property number _timerBasic = 0
	property number _timer1 = 0
	property number _timer2 = 0
	property number _timer3 = 0
	property number _timer4 = 0
	property number _timer5 = 0

	-- 레벨업 선택지 내부 상태
	property integer _choiceCard1 = 0
	property integer _choiceCard2 = 0
	property integer _choiceCard3 = 0
	property string _choiceType1 = ""
	property string _choiceType2 = ""
	property string _choiceType3 = ""
	property integer _pendingLevelUps = 0
	property any _choiceClickHandler1 = nil
	property any _choiceClickHandler2 = nil
	property any _choiceClickHandler3 = nil

	-- 클라이언트 쿨타임 연출 — 캐스트마다 새 타이머를 만들지 않고
	-- 단일 반복 타이머가 활성 쿨타임 목록을 매 틱 갱신한다 (다수 동시 캐스트 시 타이머 고갈 방지)
	property any _activeCooldowns = nil
	property integer _cooldownTimerId = 0

	-- ── 헬퍼 메서드 ────────────────────────────────────────────

	method integer GetSlotCard(integer slotIdx)
		if slotIdx == 1 then return self.Slot1Card
		elseif slotIdx == 2 then return self.Slot2Card
		elseif slotIdx == 3 then return self.Slot3Card
		elseif slotIdx == 4 then return self.Slot4Card
		elseif slotIdx == 5 then return self.Slot5Card
		end
		return 0
	end

	method void AssignCardToSlot(integer slotIdx, integer cardIdx)
		if slotIdx == 1 then self.Slot1Card = cardIdx
		elseif slotIdx == 2 then self.Slot2Card = cardIdx
		elseif slotIdx == 3 then self.Slot3Card = cardIdx
		elseif slotIdx == 4 then self.Slot4Card = cardIdx
		elseif slotIdx == 5 then self.Slot5Card = cardIdx
		end
	end

	method integer GetNextEmptySlot()
		if self.Slot1Card == 0 then return 1 end
		if self.Slot2Card == 0 then return 2 end
		if self.Slot3Card == 0 then return 3 end
		if self.Slot4Card == 0 then return 4 end
		if self.Slot5Card == 0 then return 5 end
		return 0
	end

	method boolean IsCardUnlocked(integer cardIdx)
		if cardIdx == 7 then return self.MagicBoosterLevel > 0 end
		if cardIdx == 8 then return self.MagicCriticalLevel > 0 end
		if cardIdx == 9 then return self.EnergyBoltLevel > 0 end
		if cardIdx == 10 then return self.FreezingEffectLevel > 0 end
		return self.Slot1Card == cardIdx or self.Slot2Card == cardIdx or self.Slot3Card == cardIdx
			or self.Slot4Card == cardIdx or self.Slot5Card == cardIdx
	end

	-- 카드가 현재 어느 슬롯에 들어있는지 (없으면 0)
	method integer GetSlotForCard(integer cardIdx)
		if self.Slot1Card == cardIdx then return 1
		elseif self.Slot2Card == cardIdx then return 2
		elseif self.Slot3Card == cardIdx then return 3
		elseif self.Slot4Card == cardIdx then return 4
		elseif self.Slot5Card == cardIdx then return 5
		end
		return 0
	end

	-- 슬롯별 카드 아이콘 화면 좌표 (DefaultGroup 기준, CardSlots 패널 anchoredPosition(0,90) + 슬롯별 오프셋)
	method Vector2 GetSlotUIPosition(integer slotIdx)
		-- CardSlots 패널이 화면 하단 중앙 기준(anchoredPosition 0,90)으로 앵커되어 있어
		-- 패널 자체의 절대 좌표는 (0,-450)이고, Card1~5는 그 패널 로컬 좌표(0,92.5) 기준으로 떨어져 있다.
		-- DropFlyIcon(화면 정중앙 앵커)과 같은 좌표계로 맞추려면 둘을 더한 절대값을 써야 한다 (-450+92.5=-357.5).
		if slotIdx == 1 then return Vector2(-288, -357.5)
		elseif slotIdx == 2 then return Vector2(-144, -357.5)
		elseif slotIdx == 3 then return Vector2(0, -357.5)
		elseif slotIdx == 4 then return Vector2(144, -357.5)
		else return Vector2(288, -357.5)
		end
	end

	method SpriteGUIRendererComponent GetDropIcon(integer dropIdx)
		if dropIdx == 2 then return self.dropFlyIcon2
		elseif dropIdx == 3 then return self.dropFlyIcon3
		end
		return self.dropFlyIcon
	end

	method SpriteGUIRendererComponent GetSlotRenderer(integer slotIdx)
		if slotIdx == 1 then return self.slot1
		elseif slotIdx == 2 then return self.slot2
		elseif slotIdx == 3 then return self.slot3
		elseif slotIdx == 4 then return self.slot4
		else return self.slot5
		end
	end

	-- 하드코딩된 "/maps/map01" 대신, 실제로 플레이어가 있는 맵을 찾는다.
	-- userEntity.CurrentMap(엔진 네이티브 맵 소속)은 쓰지 않는다 — 그룹D 병합으로 맵11/12가 물리적으로
	-- 같은 파일(map11.map)을 쓰게 된 뒤로는 존11에 있든 존12에 있든 항상 같은 "map11" 엔티티를 반환해서
	-- 구분이 안 되기 때문이다(실측 확인 — 존12로 이동한 뒤에도 카드가 계속 존11에 남겨진 몬스터를 공격).
	-- MonsterSpawner.GetCurrentMap과 동일하게 MapManager.CurrentMapIndex(버튼 이동 때마다 확정적으로
	-- 갱신됨) 기준으로 존11의 루트 또는 존12의 자식 컨테이너를 구분해서 반환한다.
	@ExecSpace("ServerOnly")
	method Entity GetCurrentMap()
		return _MonsterSpawner:GetZoneEntity(_MapManager.CurrentMapIndex)
	end

	method number GetCardDamage(integer cardIdx)
		if cardIdx == 1 then return self.Card1Damage
		elseif cardIdx == 2 then return self.Card2Damage
		elseif cardIdx == 3 then return self.Card3Damage
		elseif cardIdx == 4 then return self.Card4Damage
		elseif cardIdx == 9 then return self:GetEnergyBoltDamage()
		else return self.Card5Damage end
	end

	method number GetEnergyBoltDamage()
		-- 레벨별 Card1 기본공격 배율: Lv1=1.2 / Lv2=1.5 / Lv3=1.8 / Lv4=2.5 / Lv5=3.0
		local multipliers = {1.2, 1.5, 1.8, 2.5, 3.0}
		local idx = math.max(1, math.min(self.EnergyBoltLevel, 5))
		return self.Card1Damage * multipliers[idx]
	end

	method number GetCardCooldown(integer cardIdx)
		if cardIdx == 1 then return self.Card1Cooldown
		elseif cardIdx == 2 then return self.Card2Cooldown
		elseif cardIdx == 3 then return self.Card3Cooldown
		elseif cardIdx == 4 then return self.Card4Cooldown
		elseif cardIdx == 5 then return self.Card5Cooldown
		elseif cardIdx == 7 then return self.Card7Cooldown
		elseif cardIdx == 8 then return self.Card8Cooldown
		elseif cardIdx == 9 then return self.Card9Cooldown
		end
		return 1.0
	end

	method string GetCardIconRUID(integer cardIdx)
		if cardIdx == 2 then return self.Card2IconRUID
		elseif cardIdx == 3 then return self.Card3IconRUID
		elseif cardIdx == 4 then return self.Card4IconRUID
		elseif cardIdx == 5 then return self.Card5IconRUID
		elseif cardIdx == 7 then return self.Card7IconRUID
		elseif cardIdx == 8 then return self.Card8IconRUID
		elseif cardIdx == 9 then return self.Card9IconRUID
		elseif cardIdx == 10 then return self.Card10IconRUID
		end
		return ""
	end

	-- 부스터 지속시간: 기본 20초 + 레벨 삼각수초 (L1=21, L2=23, L3=26, L4=30, L5=35)
	@ExecSpace("ServerOnly")
	method number GetBoosterDuration()
		return 20.0 + self.MagicBoosterLevel * (self.MagicBoosterLevel + 1) / 2.0
	end

	-- 크리티컬 지속시간: 기본 15초 + 레벨 삼각수초 (L1=16, L2=18, L3=21, L4=25, L5=30)
	@ExecSpace("ServerOnly")
	method number GetCritDuration()
		return 15.0 + self.MagicCriticalLevel * (self.MagicCriticalLevel + 1) / 2.0
	end

	-- 매직 부스터 보유 시 항시 쿨타임 감소 적용 (레벨 1=−10%, 이후 +5%씩)
	@ExecSpace("ServerOnly")
	method number GetEffectiveCooldown(integer cardIdx)
		local base = self:GetCardCooldown(cardIdx)
		if self.MagicBoosterLevel == 0 then return base end
		local reduction = 0.10 + (self.MagicBoosterLevel - 1) * 0.05
		reduction = math.min(reduction, 0.70)
		return base * (1.0 - reduction)
	end

	-- 매직 크리티컬 보유 시 항시 크리티컬 판정 (레벨당 +5%)
	@ExecSpace("ServerOnly")
	method boolean RollCrit()
		if self.MagicCriticalLevel == 0 then return false end
		return _UtilLogic:RandomDouble() < (self.MagicCriticalLevel * 0.05)
	end

	-- ── 생명주기 ────────────────────────────────────────────────

	method void OnBeginPlay()
		if self:IsServer() then
			self._timerBasic = self.Card1Cooldown
			self._timer1 = 0
			self._timer2 = 0
			self._timer3 = 0
			self._timer4 = 0
			self._timer5 = 0
			self._potionTimer = 0
			log("CardManager started")
		else
			self._choiceClickHandler1 = self.choiceBtn1.Entity:ConnectEvent(ButtonClickEvent, function() self:SelectLevelUpChoice(1) end)
			self._choiceClickHandler2 = self.choiceBtn2.Entity:ConnectEvent(ButtonClickEvent, function() self:SelectLevelUpChoice(2) end)
			self._choiceClickHandler3 = self.choiceBtn3.Entity:ConnectEvent(ButtonClickEvent, function() self:SelectLevelUpChoice(3) end)

			self.slotBtn1.Entity:ConnectEvent(ButtonClickEvent, function() self:ShowTooltip(1) end)
			self.slotBtn2.Entity:ConnectEvent(ButtonClickEvent, function() self:ShowTooltip(2) end)
			self.slotBtn3.Entity:ConnectEvent(ButtonClickEvent, function() self:ShowTooltip(3) end)
			self.slotBtn4.Entity:ConnectEvent(ButtonClickEvent, function() self:ShowTooltip(4) end)
			self.slotBtn5.Entity:ConnectEvent(ButtonClickEvent, function() self:ShowTooltip(5) end)

			self.tooltipPanel:SetEnable(false)

			-- 기본공격(파이어샷)은 슬롯과 무관하게 항상 활성 — 카드슬롯 좌측 원형 칼 아이콘
			self.basicAttackCooldown.Entity:SetEnable(true)
			self.basicAttackCooldown.FillAmount = 1
			for i = 1, 5 do
				self:UpdateSlotVisual(i, false)
			end
			self:UpdatePotionVisual()

			self._activeCooldowns = {}
			self._activeBuffOrder = {}
			self._cooldownTimerId = _TimerService:SetTimerRepeat(function()
				self:TickCooldownVisuals()
			end, 1/60)

			if self.DebugMode then
				self._debugKeyHandler = _InputService:ConnectEvent(KeyDownEvent, function(e)
					if e.key == KeyboardKey.L then
						self:DebugFreezingLevelUp()
					end
				end)
			end
		end
	end

	-- 활성 쿨타임 연출들을 매 틱 한번에 갱신 (캐스트당 새 타이머를 만들지 않음)
	-- reversed=true 항목은 버프 아이콘용: 0→1 방향(처음엔 아이콘 보이고 점점 덮임)
	@ExecSpace("ClientOnly")
	method void TickCooldownVisuals()
		local now = _UtilLogic.ElapsedSeconds
		local i = 1
		while i <= #self._activeCooldowns do
			local entry = self._activeCooldowns[i]
			local remaining = entry.duration - (now - entry.startTime)
			if remaining <= 0 then
				entry.overlay.FillAmount = 0
				entry.overlay.Entity:SetEnable(false)
				table.remove(self._activeCooldowns, i)
			else
				if entry.reversed then
					entry.overlay.FillAmount = 1.0 - remaining / entry.duration
				else
					entry.overlay.FillAmount = remaining / entry.duration
				end
				i = i + 1
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		if name == "Slot1Card" then self:UpdateSlotVisual(1, true)
		elseif name == "Slot2Card" then self:UpdateSlotVisual(2, true)
		elseif name == "Slot3Card" then self:UpdateSlotVisual(3, true)
		elseif name == "Slot4Card" then self:UpdateSlotVisual(4, true)
		elseif name == "Slot5Card" then self:UpdateSlotVisual(5, true)
		elseif name == "PotionLevel" then self:UpdatePotionVisual()
		elseif name == "FreezingEffectLevel" then
			if self.FreezingEffectLevel > 0 then self:NotifyFreezeOnPermanent() end
		end
	end

	-- ── 클라이언트 UI 갱신 ────────────────────────────────────────

	-- animate=true면 빈 슬롯(카드 뒷면)에서 새 카드로 뒤집히는 연출을 재생한다 (카드 획득 시점).
	-- OnBeginPlay의 최초 일괄 갱신은 animate=false로 호출해 뒤집히지 않고 바로 표시되게 한다.
	@ExecSpace("ClientOnly")
	method void UpdateSlotVisual(integer slotIdx, boolean animate)
		local slot = nil
		local num = nil
		local cooldown = nil
		if slotIdx == 1 then slot = self.slot1 ; num = self.slotNum1 ; cooldown = self.cooldown1
		elseif slotIdx == 2 then slot = self.slot2 ; num = self.slotNum2 ; cooldown = self.cooldown2
		elseif slotIdx == 3 then slot = self.slot3 ; num = self.slotNum3 ; cooldown = self.cooldown3
		elseif slotIdx == 4 then slot = self.slot4 ; num = self.slotNum4 ; cooldown = self.cooldown4
		else slot = self.slot5 ; num = self.slotNum5 ; cooldown = self.cooldown5
		end

		local cardIdx = self:GetSlotCard(slotIdx)
		if cardIdx > 0 then
			local newRUID = self:GetCardIconRUID(cardIdx)
			if animate then
				self:PlaySlotFlip(slot, newRUID)
			else
				slot.ImageRUID = newRUID
				slot.Color = Color(1, 1, 1, 1)
			end
			num.Entity:SetEnable(true)
			-- PlayCooldownVisual이 OnSyncProperty보다 먼저 도착해 이미 쿨타임이 돌고 있을 수 있다 — 그 경우엔 끄면 안 된다.
			if not self:IsCooldownActive(cooldown) then
				cooldown.Entity:SetEnable(false)
				cooldown.FillAmount = 0
			end
		else
			-- 빈 슬롯은 카드 뒷면 이미지로 표시한다 (예전엔 ImageRUID를 비우고 어둡게 칠하기만 했음)
			slot.ImageRUID = self.EmptySlotRUID
			slot.Color = Color(1, 1, 1, 1)
			num.Entity:SetEnable(false)
			cooldown.Entity:SetEnable(false)
		end
	end

	-- 카드 뒷면 → 앞면으로 뒤집히는 연출: UIScale.x를 1→0으로 접고, 정확히 다 접힌 순간(폭이 0일 때)
	-- 이미지를 새 카드로 바꾼 뒤 다시 0→1로 펼친다 — 종이를 세로축으로 뒤집는 느낌
	@ExecSpace("ClientOnly")
	method void PlaySlotFlip(SpriteGUIRendererComponent slot, string newRUID)
		local transform = slot.Entity.UITransformComponent
		_TweenLogic:PlayTween(1.0, 0.0, self.SlotFlipHalfDuration, EaseType.QuadEaseIn, function(value)
			if isvalid(transform) then
				local s = transform.UIScale
				transform.UIScale = Vector3(value, s.y, s.z)
			end
		end)
		_TimerService:SetTimerOnce(function()
			if not isvalid(slot) then return end
			slot.ImageRUID = newRUID
			slot.Color = Color(1, 1, 1, 1)
			if isvalid(transform) then
				_TweenLogic:PlayTween(0.0, 1.0, self.SlotFlipHalfDuration, EaseType.QuadEaseOut, function(value)
					if isvalid(transform) then
						local s = transform.UIScale
						transform.UIScale = Vector3(value, s.y, s.z)
					end
				end)
			end
		end, self.SlotFlipHalfDuration)
	end

	@ExecSpace("ClientOnly")
	method void UpdatePotionVisual()
		if self.PotionLevel == 0 then
			self.potionSlot.Color = Color(0.2, 0.2, 0.2, 0.45)
			self.potionImage.Color = Color(1, 1, 1, 0)
			self.potionCooldown.Entity:SetEnable(false)
		else
			-- 카드슬롯 프레임과 동일한 톤(짙은 남색)으로 칠해서 흰 박스로 보이지 않게 한다
			self.potionSlot.Color = Color(0.15, 0.12, 0.38, 1)
			local ruid = self.Potion1RUID
			if self.PotionLevel == 2 then ruid = self.Potion2RUID
			elseif self.PotionLevel == 3 then ruid = self.Potion3RUID
			elseif self.PotionLevel == 4 then ruid = self.Potion4RUID
			elseif self.PotionLevel == 5 then ruid = self.Potion5RUID
			end
			self.potionImage.ImageRUID = ruid
			self.potionImage.Color = Color(1, 1, 1, 1)
			-- 처음 얻거나 레벨업한 시점엔 보통 쿨타임이 없으므로 오버레이를 끈 채로 둔다.
			-- 단, 체력이 닳아있던 상태라면 같은 프레임에 곧바로 실제 사용(PlayPotionCooldownVisual)이
			-- 먼저 일어나 쿨타임이 이미 돌고 있을 수 있다 — 그 경우엔 여기서 꺼버리면 안 된다.
			if not self:IsCooldownActive(self.potionCooldown) then
				self.potionCooldown.Entity:SetEnable(false)
				self.potionCooldown.FillAmount = 0
			end
		end
	end

	@ExecSpace("ClientOnly")
	method boolean IsCooldownActive(SpriteGUIRendererComponent overlay)
		for i = 1, #self._activeCooldowns do
			if self._activeCooldowns[i].overlay == overlay then return true end
		end
		return false
	end

	@ExecSpace("Multicast")
	method void NotifyBoosterOn(number duration)
		if self:IsServer() then return end
		self:ShowBuffIcon(self.boosterBuff, self.boosterFill, duration)
	end

	@ExecSpace("Multicast")
	method void NotifyBoosterOff()
		if self:IsServer() then return end
		self:HideBuffIcon(self.boosterBuff, self.boosterFill)
	end

	@ExecSpace("Multicast")
	method void NotifyCritOn(number duration)
		if self:IsServer() then return end
		self:ShowBuffIcon(self.critBuff, self.critFill, duration)
	end

	@ExecSpace("Multicast")
	method void NotifyCritOff()
		if self:IsServer() then return end
		self:HideBuffIcon(self.critBuff, self.critFill)
	end

	@ExecSpace("Multicast")
	method void NotifyBoosterOnPermanent()
		if self:IsServer() then return end
		self:ShowBuffIconPermanent(self.boosterBuff, self.boosterFill)
	end

	@ExecSpace("Multicast")
	method void NotifyCritOnPermanent()
		if self:IsServer() then return end
		self:ShowBuffIconPermanent(self.critBuff, self.critFill)
	end

	@ExecSpace("Multicast")
	method void NotifyFreezeOnPermanent()
		if self:IsServer() then return end
		self:ShowBuffIconPermanent(self.freezeBuff, self.freezeFill)
	end

	@ExecSpace("ClientOnly")
	method void ShowBuffIconPermanent(Entity panel, SpriteGUIRendererComponent fill)
		-- 영구 패시브 버프 아이콘 표시 — 잔여시간 fill 없이 아이콘만 상시 표시
		if panel == nil or fill == nil then return end
		if self._activeBuffOrder == nil then self._activeBuffOrder = {} end

		local buffName = ""
		if panel == self.boosterBuff then buffName = "booster"
		elseif panel == self.critBuff then buffName = "crit"
		elseif panel == self.freezeBuff then buffName = "freeze"
		end
		if buffName ~= "" then
			local found = false
			for _, name in ipairs(self._activeBuffOrder) do
				if name == buffName then found = true; break end
			end
			if not found then table.insert(self._activeBuffOrder, buffName) end
		end

		-- fill 오버레이의 activeCooldowns 항목 제거 (이전에 duration 방식으로 등록됐을 경우 정리)
		if self._activeCooldowns ~= nil then
			for i = #self._activeCooldowns, 1, -1 do
				if self._activeCooldowns[i].overlay == fill then
					table.remove(self._activeCooldowns, i)
				end
			end
		end

		panel:SetEnable(true)
		fill.Entity:SetEnable(false)  -- 영구 활성이므로 잔여시간 표시 불필요
		self:RepositionBuffIcons()
	end

	@ExecSpace("ClientOnly")
	method void ShowBuffIcon(Entity panel, SpriteGUIRendererComponent fill, number duration)
		if panel == nil or fill == nil then return end
		if self._activeBuffOrder == nil then self._activeBuffOrder = {} end

		local buffName = ""
		if panel == self.boosterBuff then buffName = "booster"
		elseif panel == self.critBuff then buffName = "crit"
		elseif panel == self.freezeBuff then buffName = "freeze"
		end
		if buffName ~= "" then
			local found = false
			for _, name in ipairs(self._activeBuffOrder) do
				if name == buffName then found = true; break end
			end
			if not found then table.insert(self._activeBuffOrder, buffName) end
		end

		panel:SetEnable(true)
		fill.Entity:SetEnable(true)
		fill.FillAmount = 0.0
		self:RegisterBuffVisual(fill, duration)
		self:RepositionBuffIcons()
	end

	@ExecSpace("ClientOnly")
	method void HideBuffIcon(Entity panel, SpriteGUIRendererComponent fill)
		if panel == nil then return end
		if self._activeBuffOrder == nil then self._activeBuffOrder = {} end

		local buffName = ""
		if panel == self.boosterBuff then buffName = "booster"
		elseif panel == self.critBuff then buffName = "crit"
		elseif panel == self.freezeBuff then buffName = "freeze"
		end
		if buffName ~= "" then
			for i = #self._activeBuffOrder, 1, -1 do
				if self._activeBuffOrder[i] == buffName then
					table.remove(self._activeBuffOrder, i)
				end
			end
		end

		panel:SetEnable(false)
		if fill ~= nil and self._activeCooldowns ~= nil then
			for i = #self._activeCooldowns, 1, -1 do
				if self._activeCooldowns[i].overlay == fill then
					table.remove(self._activeCooldowns, i)
				end
			end
		end
		self:RepositionBuffIcons()
	end

	@ExecSpace("ClientOnly")
	method void RepositionBuffIcons()
		if self._activeBuffOrder == nil then return end
		local iconSize = 50
		local iconGap = 4
		local startX = 20
		local startY = 195
		for i = 1, #self._activeBuffOrder do
			local buffName = self._activeBuffOrder[i]
			local panel = nil
			if buffName == "booster" then panel = self.boosterBuff
			elseif buffName == "crit" then panel = self.critBuff
			elseif buffName == "freeze" then panel = self.freezeBuff
			end
			if panel ~= nil then
				local tf = panel:GetComponent(UITransformComponent)
				if tf ~= nil then
					tf["anchoredPosition"] = Vector2(startX + (i-1) * (iconSize + iconGap), startY)
				end
			end
		end
	end

	-- ── 말풍선 ───────────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void ShowTooltip(integer slotIdx)
		local cardIdx = self:GetSlotCard(slotIdx)
		if cardIdx <= 0 then
			self.tooltipPanel:SetEnable(false)
			return
		end

		-- 이름 (카드 2~4: 강화 횟수 표시)
		local name = ""
		if cardIdx == 2 then
			name = "매직 클로"
			if self.Card2UpgradeCount > 0 then name = name .. " (+" .. self.Card2UpgradeCount .. "강화)" end
		elseif cardIdx == 3 then
			name = "콜드 빔 Lv." .. self.Card3UpgradeCount
		elseif cardIdx == 4 then
			name = "썬더 볼트 Lv." .. self.Card4UpgradeCount
		elseif cardIdx == 5 then name = "메테오"
		elseif cardIdx == 7 then name = "매직 부스터 Lv." .. self.MagicBoosterLevel
		elseif cardIdx == 8 then name = "매직 크리티컬 Lv." .. self.MagicCriticalLevel
		elseif cardIdx == 9 then name = self.Card9Name .. " Lv." .. self.EnergyBoltLevel
		elseif cardIdx == 10 then name = self.Card10Name .. " Lv." .. self.FreezingEffectLevel
		end

		-- 데미지
		local dmg = ""
		if cardIdx == 2 then dmg = "데미지 : " .. math.floor(self.Card2Damage)
		elseif cardIdx == 3 then dmg = "데미지 : " .. math.floor(self.Card3Damage)
		elseif cardIdx == 4 then dmg = "데미지 : " .. math.floor(self.Card4Damage)
		elseif cardIdx == 5 then dmg = "데미지 : " .. math.floor(self.Card5Damage)
		elseif cardIdx == 7 then
			local lv = self.MagicBoosterLevel
			dmg = "쿨타임 -" .. math.min(10 + (lv-1)*5, 70) .. "%  지속 " .. math.floor(20 + lv*(lv+1)/2) .. "s"
		elseif cardIdx == 8 then
			local lv = self.MagicCriticalLevel
			dmg = "크리티컬 " .. (lv*5) .. "%  지속 " .. math.floor(15 + lv*(lv+1)/2) .. "s"
		elseif cardIdx == 9 then
			local lv = self.EnergyBoltLevel
			local mults = {1.2, 1.5, 1.8, 2.5, 3.0}
			local mult = mults[math.max(1, math.min(lv, 5))]
			local hits = (lv >= 3) and "  ×2" or "  ×1"
			dmg = "대미지 : " .. math.floor(self.Card1Damage * mult) .. hits
		elseif cardIdx == 10 then
			local bonusPct = (self.FreezingEffectLevel >= 2) and 15 or 10
			dmg = "번개 보너스 : +" .. bonusPct .. "%/스택"
		end

		-- 쿨타임 (부스터 활성 중이면 실효 쿨타임 추가 표시)
		local cd = self:GetCardCooldown(cardIdx)
		local cdStr = (cardIdx == 10) and "패시브 스킬" or ("쿨타임 : " .. string.format("%.1f", cd) .. "s")
		local boosterOn = false
		if self._activeBuffOrder ~= nil then
			for _, n in ipairs(self._activeBuffOrder) do
				if n == "booster" then boosterOn = true; break end
			end
		end
		if boosterOn and self.MagicBoosterLevel > 0 then
			local reduction = math.min(0.10 + (self.MagicBoosterLevel - 1) * 0.05, 0.70)
			local effectiveCd = cd * (1.0 - reduction)
			cdStr = cdStr .. "  →  " .. string.format("%.1f", effectiveCd) .. "s ★"
		end

		-- 특수 효과 / 추가 정보 (4번째 줄)
		local extraStr = ""
		if cardIdx == 2 then
			extraStr = "타겟 : " .. (1 + self.Card2UpgradeCount) .. "명"
		elseif cardIdx == 3 then
			extraStr = "타겟 : " .. (1 + self.Card3UpgradeCount) .. "명  |  슬로우 3s"
		elseif cardIdx == 4 then
			local targets = 2 + self.Card4UpgradeCount
			local stunPct = math.floor((0.25 + self.Card4UpgradeCount * 0.05) * 100)
			extraStr = "타겟 : " .. targets .. "명  |  스턴 " .. stunPct .. "%"
		elseif cardIdx == 5 then
			extraStr = "전체 범위  |  화염 DoT 3회"
		elseif cardIdx == 9 then
			local lv = self.EnergyBoltLevel
			if lv >= 3 then extraStr = "2연발  0.1초 간격" end
			if lv >= 4 then
				if extraStr ~= "" then extraStr = extraStr .. "  |  " end
				extraStr = extraStr .. "치명타 +20%"
			end
			if lv >= 5 then
				if extraStr ~= "" then extraStr = extraStr .. "  |  " end
				extraStr = extraStr .. "폭발 " .. math.floor(self.Card1Damage * 1.2) .. " 광역"
			end
		elseif cardIdx == 10 then
			local lv = self.FreezingEffectLevel
			if lv >= 5 then
				local aoe = math.floor(self.Card4Damage * 1.75 * 0.8)
				extraStr = "연쇄 3마리  |  5스택 폭발 AOE≈" .. aoe
			elseif lv >= 4 then
				extraStr = "연쇄 번개 3마리  (피해 ×0.5)"
			elseif lv >= 3 then
				extraStr = "연쇄 번개 1마리  (피해 ×0.5)"
			end
		end

		self.tooltipName.Text  = name
		self.tooltipDmg.Text   = dmg
		self.tooltipCd.Text    = cdStr
		self.tooltipExtra.Text = extraStr

		-- 클릭한 슬롯 위로 위치 이동 (꼬리 tip이 슬롯 상단 5px 위에 위치하도록)
		-- 슬롯 top = slotPos.y + 82.5, tail tip = ty - 70 → ty = slotPos.y + 82.5 + 5 + 70
		local slotPos = self:GetSlotUIPosition(slotIdx)
		local tx = math.max(-740, math.min(740, slotPos.x))
		local ty = slotPos.y + 158
		local tf = self.tooltipPanel:GetComponent(UITransformComponent)
		if tf ~= nil then
			tf["anchoredPosition"] = Vector2(tx, ty)
		end

		self.tooltipPanel:SetEnable(true)
		log("툴팁: " .. name .. " / " .. dmg .. " / " .. cdStr .. " / " .. extraStr)

		-- 3초 후 자동 닫기 (토큰으로 중복 방지)
		self._tooltipToken = self._tooltipToken + 1
		local token = self._tooltipToken
		_TimerService:SetTimerOnce(function()
			if self._tooltipToken == token then
				self.tooltipPanel:SetEnable(false)
			end
		end, 3.0)
	end

	-- ── 매 프레임 (서버) ─────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if _GameManager.GameOver then return end
		-- 월드 시작 첫 프레임들에서는 다른 Logic(MonsterSpawner)의 전역 참조가 아직 등록되기 전일 수 있다
		-- (Logic끼리는 초기화 순서가 보장되지 않음) — 그 사이 FindTarget이 _MonsterSpawner를 인덱싱하면
		-- [LEA-2007] AttemptToIndex 에러가 난다. 등록될 때까지 이번 프레임은 건너뛴다.
		if _MonsterSpawner == nil then return end

		local target = self:FindTarget()

		-- 기본공격(파이어샷)은 슬롯 배치와 무관하게 항상 활성
		self._timerBasic = self:TickCard(1, 0, self._timerBasic, delta, target)

		-- 슬롯 1~5: 배치된 카드가 있을 때만 동작 (1번 슬롯부터 채워짐)
		if self.Slot1Card > 0 then self._timer1 = self:TickCard(self.Slot1Card, 1, self._timer1, delta, target) end
		if self.Slot2Card > 0 then self._timer2 = self:TickCard(self.Slot2Card, 2, self._timer2, delta, target) end
		if self.Slot3Card > 0 then self._timer3 = self:TickCard(self.Slot3Card, 3, self._timer3, delta, target) end
		if self.Slot4Card > 0 then self._timer4 = self:TickCard(self.Slot4Card, 4, self._timer4, delta, target) end
		if self.Slot5Card > 0 then self._timer5 = self:TickCard(self.Slot5Card, 5, self._timer5, delta, target) end

		-- 포션 자동 사용 — 체력이 가득 찬 동안은 쿨타임을 돌리지 않고 대기, 실제로 회복이 필요해지는 순간 바로 사용한다
		if self.PotionLevel > 0 then
			self._potionTimer = self._potionTimer - delta
			if self._potionTimer <= 0 and _GameManager.PlayerHp < _GameManager.PlayerMaxHp then
				local healPct = 0.1 + (self.PotionLevel - 1) * 0.05
				local healAmount = math.floor(_GameManager.PlayerMaxHp * healPct)
				_GameManager:HealPlayer(healAmount)
				self:PlayPotionCooldownVisual(self.PotionCooldown)
				-- 체력이 가득 차 대기하는 동안 _potionTimer가 깊은 음수로 쌓일 수 있어,
				-- 더해주는 대신 정확히 쿨타임 값으로 리셋해야 한다 (안 그러면 음수 잔량이 남아 연속으로 재발동된다)
				self._potionTimer = self.PotionCooldown
			end
		end

		-- 매직 부스터/크리티컬은 영구 패시브 — 타이머 카운트다운 없음
	end

	@ExecSpace("ServerOnly")
	method number TickCard(integer cardIndex, integer slotIndex, number timer, number delta, MonsterAI target)
		local cooldown = self:GetEffectiveCooldown(cardIndex)
		local damage   = self:GetCardDamage(cardIndex)

		-- 쿨타임은 0 밑으로 내려가지 않고, 다 차면(0) "활성화 상태"로 대기한다
		if timer > 0 then
			timer = timer - delta
			if timer < 0 then timer = 0 end
		end

		if timer <= 0 then
			local aliveTarget = (target ~= nil and not target._dead)

			-- 적이 없으면 활성화 상태로 대기만 한다 (연출 재생/재시작 없음)
			if aliveTarget then
				local isCrit = self:RollCrit()
				if cardIndex == 2 then
					self:MagicClawAttack(damage, isCrit)
				elseif cardIndex == 3 then
					self:ColdBeamAttack(damage, isCrit)
				elseif cardIndex == 4 then
					self:ThunderAttack(damage, isCrit)
				elseif cardIndex == 5 then
					self:MeteorAttack(damage, isCrit)
				elseif cardIndex == 9 then
					self:EnergyBoltAttack(target)
				else
					if isCrit then target:TakeDamageCrit(damage * 2)
					else target:TakeDamage(damage) end
					if cardIndex == 1 then
						-- 파이어샷: 플레이어 쪽(화면 아래, 크게)에서 시작해 타겟 쪽으로 날아가며
						-- 점점 작아져 화면 속으로 빨려들어가는 듯한 느낌을 준다 (회전 90도, 배속 1.5배, 알파 10% 감소)
						local p1 = target.Entity.TransformComponent.Position
						local hitPos = Vector3(p1.x, p1.y + 0.3, p1.z)
						local startPos = Vector3(hitPos.x, hitPos.y - 0.8, hitPos.z)
						local fx = self:SpawnEffect(self.Card1EffectRUID, startPos, 90, 1.5, 2.5, 0.9)
						self:FlyFireShot(fx, startPos, hitPos)
					end
				end
				-- 적을 맞췄을 때만 쿨타임 연출을 새로 재생하고 다시 채운다
				self:PlayCooldownVisual(slotIndex, cooldown)
				timer = cooldown
			end
		end
		return timer
	end

	@ExecSpace("ServerOnly")
	method Entity SpawnEffect(string ruid, Vector3 pos, number rotationZ, number playRate, number scale, number alpha)
		local map = self:GetCurrentMap()
		if map == nil then return nil end
		-- 타겟 Z를 그대로 물려받으면, 몬스터가 접근하며 MonsterAI:UpdateDepth()로
		-- 계속 Z를 0쪽으로 줄여나가는 동안 이펙트 Z는 스폰 시점에 고정되어버려
		-- 몬스터가 이펙트를 추월해 위로 덮는다. 항상 몬스터보다 앞(Z<0)에 고정한다.
		local fxPos = Vector3(pos.x, pos.y, -0.1)
		local e = _SpawnService:SpawnByModelId("skilleffect", "FX", fxPos, map)
		if e == nil then return nil end
		local renderer = e.SpriteRendererComponent
		if renderer ~= nil then
			renderer.SpriteRUID = ruid
			renderer.PlayRate = playRate
			if alpha ~= 1 then renderer.Color = Color(1, 1, 1, alpha) end
			log("SpawnEffect: ruid=" .. ruid .. " playRate=" .. playRate)
		end
		local tc = e.TransformComponent
		if tc ~= nil and rotationZ ~= 0 then tc.ZRotation = rotationZ end
		if tc ~= nil and scale ~= 1 then tc.Scale = Vector3(scale, scale, 1) end
		return e
	end

	@ExecSpace("ServerOnly")
	method void FlyFireShot(Entity fx, Vector3 startPos, Vector3 endPos)
		-- 플레이어 쪽(아래, 큰 스케일)에서 타겟 쪽(작은 스케일)으로 날아가 화면 속으로 빨려들어가는 느낌을 준다
		if fx == nil then return end
		local duration = 0.16
		local startScale = 2.5
		local endScale = 1.0

		_TweenLogic:PlayTween(0.0, 1.0, duration, EaseType.QuadEaseIn, function(t)
			if not isvalid(fx) then return end
			local x = startPos.x + (endPos.x - startPos.x) * t
			local y = startPos.y + (endPos.y - startPos.y) * t
			-- Z는 항상 -0.1로 고정 (몬스터보다 앞에 유지 — SpawnEffect와 동일한 이유)
			fx.TransformComponent.Position = Vector3(x, y, -0.1)
			local scale = startScale + (endScale - startScale) * t
			fx.TransformComponent.Scale = Vector3(scale, scale, 1)
		end)

		-- 착탄 후: 불꽃이 사방으로 퍼지며 알파가 빠지는 연출
		_TimerService:SetTimerOnce(function()
			if not isvalid(fx) then return end
			local impactDuration = 0.28
			_TweenLogic:PlayTween(0.0, 1.0, impactDuration, EaseType.QuadEaseOut, function(t)
				if not isvalid(fx) then return end
				local s = 1.0 + t * 0.75
				fx.TransformComponent.Scale = Vector3(s, s, 1)
				local renderer = fx.SpriteRendererComponent
				if renderer ~= nil then
					renderer.Color = Color(1, 1, 1, 0.9 * (1.0 - t))
				end
			end)
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) then fx:Destroy() end
			end, impactDuration)
		end, duration)
	end

	-- 살아있는 몬스터를 화면에 가까이 온 순서(스케일 큰 순)로 최대 count명 반환
	@ExecSpace("ServerOnly")
	method table GetClosestTargets(integer count)
		local map = self:GetCurrentMap()
		if map == nil then return {} end
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		local targets = {}
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if not m._dead then table.insert(targets, m) end
		end
		table.sort(targets, function(a, b) return a._currentScale > b._currentScale end)
		local result = {}
		for i = 1, math.min(count, #targets) do
			table.insert(result, targets[i])
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method void MagicClawAttack(number damage, boolean isCrit)
		-- 업그레이드할 때마다 타겟 1명씩 추가 (기본 1명)
		local targets = self:GetClosestTargets(1 + self.Card2UpgradeCount)
		for _, target in ipairs(targets) do
			if isCrit then target:TakeDamageCrit(damage * 2)
			else target:TakeDamage(damage) end
			local p2 = target.Entity.TransformComponent.Position
			self:SpawnEffect(self.Card2EffectRUID, Vector3(p2.x, p2.y + 0.3, p2.z), 0, 1.5, 1.3, 1)
		end
	end

	@ExecSpace("ServerOnly")
	method void ColdBeamAttack(number damage, boolean isCrit)
		-- 업그레이드할 때마다 타겟 1명씩 추가 (기본 1명). 연출상 빔이 두 번 발사되므로 데미지를 반으로 나눠 두 번째 발사 시점에 맞춰 적용한다
		local halfDamage = damage / 2
		local targets = self:GetClosestTargets(1 + self.Card3UpgradeCount)
		local slowDur = (self.FreezingEffectLevel >= 2) and 4.0 or 3.0
		for _, target in ipairs(targets) do
			if isCrit then target:TakeDamageCrit(halfDamage * 2)
			else target:TakeDamage(halfDamage) end
			target:ApplySlow(slowDur)
			if self.FreezingEffectLevel > 0 then target:AddFreezeStack() end
			-- 새 이펙트는 대상 주변으로 퍼지는 얼음 폭발이라 방향성이 없다 — 빔처럼 위쪽에 띄울 필요 없이 대상 위치에 바로 재생한다
			local p3 = target.Entity.TransformComponent.Position
			self:SpawnEffect(self.Card3EffectRUID, p3, 0, 1, 1, 1)

			_TimerService:SetTimerOnce(function()
				if isvalid(target) and isvalid(target.Entity) and not target._dead then
					if isCrit then target:TakeDamageCrit(halfDamage * 2)
					else target:TakeDamage(halfDamage) end
					if self.FreezingEffectLevel > 0 then target:AddFreezeStack() end
					log("ColdBeamAttack: second beam dmg=" .. math.floor(isCrit and halfDamage * 2 or halfDamage))
				end
			end, self.Card3SecondHitDelay)
		end
	end

	@ExecSpace("ServerOnly")
	method void ThunderAttack(number damage, boolean isCrit)
		-- 업그레이드할 때마다 타겟 1명씩 추가 (기본 2명), 감전 확률도 5%씩 추가 (기본 25%)
		local targets = self:GetClosestTargets(2 + self.Card4UpgradeCount)
		local stunChance = 0.25 + self.Card4UpgradeCount * 0.05
		log("ThunderAttack: hit=" .. #targets .. " dmg=" .. math.floor(damage) .. " stunChance=" .. stunChance)
		for _, target in ipairs(targets) do
			local freezeBonus = self:GetFreezeBonus(target)
			local finalDmg = damage * freezeBonus
			-- 빙결폭발 체크 (Lv5, 5스택)
			if self.FreezingEffectLevel >= 5 and target.FreezeStack >= 5 then
				self:TriggerFreezeExplosion(target, finalDmg, isCrit)
			else
				if isCrit then target:TakeDamageCrit(finalDmg * 2)
				else target:TakeDamage(finalDmg) end
			end
			self:SpawnEffect(self.Card4EffectRUID, target.Entity.TransformComponent.Position, 0, 1, 1, 1)
			if _UtilLogic:RandomDouble() < stunChance then
				target:ApplyStun(1.0)
			end
			-- 연쇄번개 (Lv3+)
			self:ApplyChainLightning(target, finalDmg, isCrit)
		end
	end

	@ExecSpace("ServerOnly")
	method void MeteorAttack(number damage, boolean isCrit)
		-- 낙하 이펙트를 먼저 띄우고, 착탄 시점(Card5ImpactDelay)에 데미지를 적용한다
		local map = self:GetCurrentMap()
		if map == nil then return end
		local dotDmg = math.floor(self.Card1Damage * 0.3)
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if not m._dead then
				self:SpawnEffect(self.Card5EffectRUID, m.Entity.TransformComponent.Position, 0, 3, 1, 1)
				_TimerService:SetTimerOnce(function()
					if isvalid(m) and isvalid(m.Entity) and not m._dead then
						if isCrit then m:TakeDamageCrit(damage * 2)
						else m:TakeDamage(damage) end
						m:ApplyDot(dotDmg, 3, 0.7)
						log("MeteorAttack: impact damage applied dmg=" .. math.floor(isCrit and damage * 2 or damage))
					end
				end, self.Card5ImpactDelay)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method MonsterAI FindTarget()
		local map = self:GetCurrentMap()
		if map == nil then return nil end
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		local best = nil
		local bestScale = -1
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local monster = mob
			if not monster._dead and monster._currentScale > bestScale then
				best = monster
				bestScale = monster._currentScale
			end
		end
		return best
	end

	-- ── 에너지볼트 (Card 9) ───────────────────────────────────────

	@ExecSpace("ServerOnly")
	method boolean RollEnergyBoltCrit()
		-- MagicCritical 기본 확률 + Lv4 치명타 보너스
		local chance = (self.MagicCriticalLevel > 0) and (self.MagicCriticalLevel * 0.05) or 0
		chance = chance + self.EnergyBoltCritBonus
		if chance <= 0 then return false end
		return _UtilLogic:RandomDouble() < chance
	end

	@ExecSpace("ServerOnly")
	method MonsterAI FindSecondTarget(MonsterAI exclude)
		-- primaryTarget 다음으로 가까이 온(스케일 큰) 살아있는 몬스터 반환
		local map = self:GetCurrentMap()
		if map == nil then return nil end
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		local best = nil
		local bestScale = -1
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if not m._dead and m ~= exclude and m._currentScale > bestScale then
				best = m
				bestScale = m._currentScale
			end
		end
		return best
	end

	@ExecSpace("ServerOnly")
	method void EnergyBoltAttack(MonsterAI primaryTarget)
		-- 레벨별 Card1 기본공격 배율로 대미지 계산 후 단발 또는 2연발(다른 타겟) 발사
		local damage = self:GetEnergyBoltDamage()
		local isCrit = self:RollEnergyBoltCrit()

		if self.EnergyBoltLevel >= 3 then
			-- Lv3+: 1번째 볼트 → primaryTarget, Lv5이면 즉시 그 자리에서 폭발
			local isLv5 = self.EnergyBoltLevel >= 5
			local boltScale = isLv5 and 1.73 or 1.5
			local boltRate  = isLv5 and 1.28 or 1.5
			local freezeBonus1 = self:GetFreezeBonus(primaryTarget)
			local finalDmg1 = damage * freezeBonus1
			if self.FreezingEffectLevel >= 5 and primaryTarget.FreezeStack >= 5 then
				self:TriggerFreezeExplosion(primaryTarget, finalDmg1, isCrit)
			else
				if isCrit then primaryTarget:TakeDamageCrit(finalDmg1 * 2)
				else primaryTarget:TakeDamage(finalDmg1) end
			end
			local p = primaryTarget.Entity.TransformComponent.Position
			local ofs1 = 0.24 * (primaryTarget._currentScale * primaryTarget._scaleMultiplier)
			self:SpawnEffect(self.Card9EffectRUID, Vector3(p.x, p.y + ofs1, p.z), 0, boltRate, boltScale, 1)
			if isLv5 then
				self:EnergyBoltExplosion(primaryTarget, isCrit)
			end
			self:ApplyChainLightning(primaryTarget, finalDmg1, isCrit)
			log("EnergyBoltAttack: 1st bolt dmg=" .. math.floor(isCrit and finalDmg1*2 or finalDmg1) .. " lv=" .. self.EnergyBoltLevel)

			local second = self:FindSecondTarget(primaryTarget)

			_TimerService:SetTimerOnce(function()
				-- 0.1s 후 2번째 볼트 → 다른 적, Lv5이면 그 자리에서 폭발
				local t2 = second
				if t2 == nil or not isvalid(t2) or not isvalid(t2.Entity) or t2._dead then
					t2 = primaryTarget
				end
				if isvalid(t2) and isvalid(t2.Entity) and not t2._dead then
					local freezeBonus2 = self:GetFreezeBonus(t2)
					local finalDmg2 = damage * freezeBonus2
					if self.FreezingEffectLevel >= 5 and t2.FreezeStack >= 5 then
						self:TriggerFreezeExplosion(t2, finalDmg2, isCrit)
					else
						if isCrit then t2:TakeDamageCrit(finalDmg2 * 2)
						else t2:TakeDamage(finalDmg2) end
					end
					local p2 = t2.Entity.TransformComponent.Position
					local ofs2 = 0.24 * (t2._currentScale * t2._scaleMultiplier)
					self:SpawnEffect(self.Card9EffectRUID, Vector3(p2.x, p2.y + ofs2, p2.z), 0, boltRate, boltScale, 1)
					if isLv5 then
						self:EnergyBoltExplosion(t2, isCrit)
					end
					self:ApplyChainLightning(t2, finalDmg2, isCrit)
					log("EnergyBoltAttack: 2nd bolt dmg=" .. math.floor(isCrit and finalDmg2*2 or finalDmg2))
				end
			end, 0.1)
		else
			-- Lv1~2: 단발
			local freezeBonusSingle = self:GetFreezeBonus(primaryTarget)
			local finalDmgSingle = damage * freezeBonusSingle
			if self.FreezingEffectLevel >= 5 and primaryTarget.FreezeStack >= 5 then
				self:TriggerFreezeExplosion(primaryTarget, finalDmgSingle, isCrit)
			else
				if isCrit then primaryTarget:TakeDamageCrit(finalDmgSingle * 2)
				else primaryTarget:TakeDamage(finalDmgSingle) end
			end
			local p = primaryTarget.Entity.TransformComponent.Position
			local ofsSingle = 0.24 * (primaryTarget._currentScale * primaryTarget._scaleMultiplier)
			self:SpawnEffect(self.Card9EffectRUID, Vector3(p.x, p.y + ofsSingle, p.z), 0, 1.5, 1.5, 1)
			self:ApplyChainLightning(primaryTarget, finalDmgSingle, isCrit)
			log("EnergyBoltAttack: single bolt dmg=" .. math.floor(isCrit and finalDmgSingle*2 or finalDmgSingle) .. " lv=" .. self.EnergyBoltLevel)
		end
	end

	@ExecSpace("ServerOnly")
	method void EnergyBoltExplosion(MonsterAI center, boolean isCrit)
		-- Lv5 폭발: 이펙트 1회, primaryTarget 기준 좌우 ±2.0 범위 내 몬스터에게 Card1×1.2 피해
		local expDmg = self.Card1Damage * 1.2
		local map = self:GetCurrentMap()
		if map == nil then return end

		-- 폭발 이펙트: 좌우 범위 끝에 대칭으로 스폰
		local range = 2.0
		local centerX = 0
		if isvalid(center) and isvalid(center.Entity) then
			local cp = center.Entity.TransformComponent.Position
			centerX = cp.x
			local fxLeft = self:SpawnEffect(self.Card9ExplosionRUID, Vector3(centerX - 1.0, cp.y + 0.5, cp.z), 0, 1.0, 1.2, 1)
			if fxLeft ~= nil then
				_TimerService:SetTimerOnce(function()
					if isvalid(fxLeft) then fxLeft:Destroy() end
				end, 0.25)
			end
			local fxRight = self:SpawnEffect(self.Card9ExplosionRUID, Vector3(centerX + 1.0, cp.y + 0.5, cp.z), 0, 1.0, 1.2, 1)
			if fxRight ~= nil then
				local renderer = fxRight.SpriteRendererComponent
				if renderer ~= nil then
					renderer.FlipX = true
				end
				_TimerService:SetTimerOnce(function()
					if isvalid(fxRight) then fxRight:Destroy() end
				end, 0.25)
			end
		end

		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if not m._dead then
				local dx = math.abs(m.Entity.TransformComponent.Position.x - centerX)
				if dx <= range then
					if isCrit then m:TakeDamageCrit(expDmg * 2)
					else m:TakeDamage(expDmg) end
				end
			end
		end
	end

	-- ── 프리징 이펙트 헬퍼 ──────────────────────────────────────

	@ExecSpace("ServerOnly")
	method number GetFreezeBonus(MonsterAI target)
		-- 빙결 스택에 따른 번개 보너스 배율 반환 (Lv1: +10%/스택, Lv2+: +15%/스택)
		if self.FreezingEffectLevel <= 0 then return 1.0 end
		if target == nil or not isvalid(target) then return 1.0 end
		local stack = target.FreezeStack
		if stack <= 0 then return 1.0 end
		local bonusPct = stack * (self.FreezingEffectLevel >= 2 and 0.15 or 0.10)
		return 1.0 + bonusPct
	end

	@ExecSpace("ServerOnly")
	method void ApplyChainLightning(MonsterAI source, number baseDmg, boolean isCrit)
		-- Lv3: 1마리 / Lv4: 3마리 / Lv5: 4마리 (홉마다 피해 50%→75%→100%→125%)
		if self.FreezingEffectLevel < 3 then return end
		if source == nil or not isvalid(source) then return end
		local maxHops
		if self.FreezingEffectLevel >= 5 then maxHops = 4
		elseif self.FreezingEffectLevel >= 4 then maxHops = 3
		else maxHops = 1
		end
		local chainRadius = 2.5
		local aoeRadius = 1.5  -- Lv5 연쇄 AOE 범위
		local map = self:GetCurrentMap()
		if map == nil then return end
		local sourcePos = source.Entity.TransformComponent.Position
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		local chainCount = 0
		for _, mob in ipairs(monsters) do
			---@type MonsterAI
			local m = mob
			if not m._dead and m ~= source and m.FreezeStack > 0 then
				local dx = math.abs(m.Entity.TransformComponent.Position.x - sourcePos.x)
				if dx <= chainRadius then
					chainCount = chainCount + 1
					-- 홉마다 50%→75%→100%→125% 증가, 연쇄 대상 빙결 스택 보너스 적용
					local hopMult = 0.5 + 0.25 * (chainCount - 1)
					local freezeBonus = self:GetFreezeBonus(m)
					local chainDmg = baseDmg * hopMult * freezeBonus
					if isCrit then m:TakeDamageCrit(chainDmg * 2)
					else m:TakeDamage(chainDmg) end
					local mPos = m.Entity.TransformComponent.Position
					local fxPos = Vector3(mPos.x, mPos.y + 0.4, mPos.z)
					local fxScale = (self.FreezingEffectLevel >= 5) and 1.92 or (self.FreezingEffectLevel >= 4) and 1.32 or 0.8
					self:SpawnEffect(self.ChainLightningEffectRUID, fxPos, 0, 1.2, fxScale, 1)
					-- Lv5: 연쇄 타격 위치 주변 AOE 추가 공격
					if self.FreezingEffectLevel >= 5 then
						for _, mob2 in ipairs(monsters) do
							---@type MonsterAI
							local m2 = mob2
							if not m2._dead and m2 ~= m and m2 ~= source then
								local dx2 = math.abs(m2.Entity.TransformComponent.Position.x - mPos.x)
								if dx2 <= aoeRadius then
									if isCrit then m2:TakeDamageCrit(chainDmg * 2)
									else m2:TakeDamage(chainDmg) end
								end
							end
						end
					end
					log("ChainLightning hop" .. chainCount .. ": dmg=" .. math.floor(isCrit and chainDmg*2 or chainDmg) .. " (×" .. hopMult .. " freeze×" .. string.format("%.2f", freezeBonus) .. ")")
					if chainCount >= maxHops then break end
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void TriggerFreezeExplosion(MonsterAI target, number baseDmg, boolean isCrit)
		-- Lv5: 5스택 + 번개 = 빙결 폭발 (AOE 피해 + 스택 초기화)
		if target == nil or not isvalid(target) then return end
		-- 대상에게 일반 피해 먼저 적용
		if isCrit then target:TakeDamageCrit(baseDmg * 2)
		else target:TakeDamage(baseDmg) end
		-- 빙결 스택 초기화
		target:ResetFreezeStack()
		-- 폭발 이펙트 + AOE 데미지
		local pos = target.Entity.TransformComponent.Position
		local expDmg = baseDmg * 0.8
		local expRadius = 2.5
		local fxLeft = self:SpawnEffect(self.Card9ExplosionRUID, Vector3(pos.x - 0.8, pos.y + 0.5, pos.z), 0, 1.2, 0.98, 1)
		if fxLeft ~= nil then
			_TimerService:SetTimerOnce(function() if isvalid(fxLeft) then fxLeft:Destroy() end end, 0.25)
		end
		local fxRight = self:SpawnEffect(self.Card9ExplosionRUID, Vector3(pos.x + 0.8, pos.y + 0.5, pos.z), 0, 1.2, 0.98, 1)
		if fxRight ~= nil then
			local renderer = fxRight.SpriteRendererComponent
			if renderer ~= nil then renderer.FlipX = true end
			_TimerService:SetTimerOnce(function() if isvalid(fxRight) then fxRight:Destroy() end end, 0.25)
		end
		local map = self:GetCurrentMap()
		if map ~= nil then
			local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
			for _, mob in ipairs(monsters) do
				---@type MonsterAI
				local m = mob
				if not m._dead and m ~= target then
					local dx = math.abs(m.Entity.TransformComponent.Position.x - pos.x)
					if dx <= expRadius then
						if isCrit then m:TakeDamageCrit(expDmg * 2)
						else m:TakeDamage(expDmg) end
					end
				end
			end
		end
		log("FreezeExplosion: 빙결 폭발! x=" .. pos.x .. " aoe_dmg=" .. math.floor(expDmg))
	end

	-- ── 쿨타임 비주얼 (슬롯 인덱스 기반) ────────────────────────

	@ExecSpace("Multicast")
	method void PlayCooldownVisual(integer slotIndex, number cooldown)
		if self:IsServer() then return end

		local overlay = nil
		if slotIndex == 0 then overlay = self.basicAttackCooldown
		elseif slotIndex == 1 then overlay = self.cooldown1
		elseif slotIndex == 2 then overlay = self.cooldown2
		elseif slotIndex == 3 then overlay = self.cooldown3
		elseif slotIndex == 4 then overlay = self.cooldown4
		else overlay = self.cooldown5
		end
		if overlay == nil then return end

		overlay.Entity:SetEnable(true)
		overlay.FillAmount = 1
		self:RegisterCooldownVisual(overlay, cooldown)
	end

	-- 같은 오버레이를 추적 중인 항목이 있으면 교체하고, 공용 목록에 새로 등록한다
	@ExecSpace("ClientOnly")
	method void RegisterCooldownVisual(SpriteGUIRendererComponent overlay, number duration)
		for i = #self._activeCooldowns, 1, -1 do
			if self._activeCooldowns[i].overlay == overlay then
				table.remove(self._activeCooldowns, i)
			end
		end
		table.insert(self._activeCooldowns, { overlay = overlay, startTime = _UtilLogic.ElapsedSeconds, duration = duration, reversed = false })
	end

	-- 버프 아이콘 전용: 0→1 방향 애니메이션 (처음 아이콘 보임 → 만료 시 완전히 덮임)
	method void RegisterBuffVisual(SpriteGUIRendererComponent overlay, number duration)
		for i = #self._activeCooldowns, 1, -1 do
			if self._activeCooldowns[i].overlay == overlay then
				table.remove(self._activeCooldowns, i)
			end
		end
		table.insert(self._activeCooldowns, { overlay = overlay, startTime = _UtilLogic.ElapsedSeconds, duration = duration, reversed = true })
	end

	-- ── 레벨업 선택 ──────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method void GenerateLevelUpChoices()
		if self._choiceCard1 ~= 0 then
			self._pendingLevelUps = self._pendingLevelUps + 1
			return
		end

		local pool = {}

		-- 에너지볼트: 미해금이면 해금, 해금 후 레벨 < 5이면 강화
		if self.EnergyBoltLevel == 0 then
			table.insert(pool, { card = 9, type = "unlock" })
		elseif self.EnergyBoltLevel < 5 then
			table.insert(pool, { card = 9, type = "energybolt_up" })
		end

		-- Card1 기본공격 강화 (상시 강화 가능)
		table.insert(pool, { card = 1, type = "dmg" })
		table.insert(pool, { card = 1, type = "cd" })

		-- 포션
		if self.PotionLevel < 5 then
			table.insert(pool, { card = 6, type = "potion" })
		end

		-- 패시브 카드 (미해금이면 unlock, 해금 후 레벨 < 5이면 강화)
		if not self:IsCardUnlocked(7) then
			table.insert(pool, { card = 7, type = "unlock" })
		elseif self.MagicBoosterLevel < 5 then
			table.insert(pool, { card = 7, type = "booster_up" })
		end
		if not self:IsCardUnlocked(8) then
			table.insert(pool, { card = 8, type = "unlock" })
		elseif self.MagicCriticalLevel < 5 then
			table.insert(pool, { card = 8, type = "critical_up" })
		end

		-- 썬콜법사 빌드: 콜드빔 / 썬더볼트
		if not self:IsCardUnlocked(3) then
			table.insert(pool, { card = 3, type = "unlock_dmg" })
			table.insert(pool, { card = 3, type = "unlock_cd" })
		else
			table.insert(pool, { card = 3, type = "dmg" })
			table.insert(pool, { card = 3, type = "cd" })
		end
		if not self:IsCardUnlocked(4) then
			table.insert(pool, { card = 4, type = "unlock_dmg" })
			table.insert(pool, { card = 4, type = "unlock_cd" })
		else
			table.insert(pool, { card = 4, type = "dmg" })
			table.insert(pool, { card = 4, type = "cd" })
		end

		-- 프리징 이펙트 (패시브) — 2개 항목으로 출현 확률 보강
		if not self:IsCardUnlocked(10) then
			table.insert(pool, { card = 10, type = "unlock" })
			table.insert(pool, { card = 10, type = "unlock" })
		elseif self.FreezingEffectLevel < 5 then
			table.insert(pool, { card = 10, type = "freeze_up" })
			table.insert(pool, { card = 10, type = "freeze_up" })
		end

		-- Fisher-Yates 셔플
		for i = #pool, 2, -1 do
			local j = _UtilLogic:RandomIntegerRange(1, i)
			pool[i], pool[j] = pool[j], pool[i]
		end

		-- 카드 중복 없이 3개 선택 (같은 카드의 dmg+cd 동시 등장 방지)
		local chosen = {}
		local usedCards = {}
		for _, entry in ipairs(pool) do
			if not usedCards[entry.card] then
				usedCards[entry.card] = true
				table.insert(chosen, entry)
				if #chosen == 3 then break end
			end
		end

		-- 풀이 3개 미만이면 Card1 강화로 패딩 (모든 선택지가 최대일 때 대비)
		while #chosen < 3 do
			table.insert(chosen, { card = 1, type = (_UtilLogic:RandomDouble() < 0.5) and "dmg" or "cd" })
		end

		self._choiceCard1 = chosen[1].card ; self._choiceType1 = chosen[1].type
		self._choiceCard2 = chosen[2].card ; self._choiceType2 = chosen[2].type
		self._choiceCard3 = chosen[3].card ; self._choiceType3 = chosen[3].type

		self:ShowLevelUpChoices(
			self._choiceCard1, self._choiceType1,
			self._choiceCard2, self._choiceType2,
			self._choiceCard3, self._choiceType3)
	end

	method void SetChoiceCardText(TextComponent title, TextComponent desc, integer cardIdx, string upgradeType)
		if cardIdx == 6 then
			local potionNames = {"빨간 포션", "하얀 포션", "장어구이", "쭈쭈바", "엘릭서"}
			local healPcts    = {"10%", "15%", "20%", "25%", "30%"}
			local nextLevel = self.PotionLevel + 1
			if nextLevel > 5 then nextLevel = 5 end
			local label = (self.PotionLevel == 0) and " 해금!" or " 강화!"
			title.Text = potionNames[nextLevel] .. label
			desc.Text  = "15초마다 최대 HP의 " .. healPcts[nextLevel] .. " 회복"
			return
		end

		if cardIdx == 7 then
			if upgradeType == "unlock" then
				title.Text = self.Card7Name .. " 해금!"
				desc.Text  = "쿨타임 -10% 영구 적용"
			else  -- booster_up
				local nextLevel = self.MagicBoosterLevel + 1
				local pct = 10 + (nextLevel - 1) * 5
				title.Text = self.Card7Name .. " 강화! (Lv." .. nextLevel .. ")"
				desc.Text  = "쿨타임 -" .. pct .. "% 영구 적용"
			end
			return
		end

		if cardIdx == 8 then
			if upgradeType == "unlock" then
				title.Text = self.Card8Name .. " 해금!"
				desc.Text  = "크리티컬 5% 영구 적용"
			else  -- critical_up
				local nextLevel = self.MagicCriticalLevel + 1
				title.Text = self.Card8Name .. " 강화! (Lv." .. nextLevel .. ")"
				desc.Text  = "크리티컬 " .. (nextLevel * 5) .. "% 영구 적용"
			end
			return
		end

		if cardIdx == 9 then
			if upgradeType == "unlock" then
				title.Text = self.Card9Name .. " 해금! (Lv.1)"
				desc.Text  = "볼트 1발  대미지 " .. math.floor(self.Card1Damage * 1.2)
			else  -- energybolt_up
				local nextLevel = self.EnergyBoltLevel + 1
				if nextLevel == 2 then
					title.Text = self.Card9Name .. " Lv.2"
					desc.Text  = "대미지 +25%  →  " .. math.floor(self.Card1Damage * 1.5)
				elseif nextLevel == 3 then
					title.Text = self.Card9Name .. " Lv.3"
					desc.Text  = "2연발  0.1초 간격"
				elseif nextLevel == 4 then
					title.Text = self.Card9Name .. " Lv.4"
					desc.Text  = "치명타 확률 +20%"
				elseif nextLevel == 5 then
					title.Text = self.Card9Name .. " Lv.5"
					desc.Text  = "폭발 발생  +" .. math.floor(self.Card1Damage * 1.2) .. " 광역"
				end
			end
			return
		end

		if cardIdx == 10 then
			if upgradeType == "unlock" then
				title.Text = self.Card10Name .. " 해금! (Lv.1)"
				desc.Text  = "콜드빔 빙결 스택 쌓기 + 번개 보너스 +10%/스택"
			else  -- freeze_up
				local nextLevel = self.FreezingEffectLevel + 1
				if nextLevel == 2 then
					title.Text = self.Card10Name .. " Lv.2"
					desc.Text  = "슬로우 +1s  번개 보너스 +15%/스택"
				elseif nextLevel == 3 then
					title.Text = self.Card10Name .. " Lv.3"
					desc.Text  = "번개 → 빙결 몬스터 1마리 연쇄"
				elseif nextLevel == 4 then
					title.Text = self.Card10Name .. " Lv.4"
					desc.Text  = "연쇄 → 최대 3마리"
				elseif nextLevel == 5 then
					title.Text = self.Card10Name .. " Lv.5"
					desc.Text  = "5스택 + 번개 = 빙결 폭발"
				end
			end
			return
		end

		local skillNames = {self.Card1Name, self.Card2Name, self.Card3Name, self.Card4Name, self.Card5Name}
		local skillName = (cardIdx >= 1 and cardIdx <= 5) and skillNames[cardIdx] or ("카드 " .. cardIdx)

		if upgradeType == "unlock" or upgradeType == "unlock_dmg" or upgradeType == "unlock_cd" then
			if cardIdx == 3 or cardIdx == 4 then
				title.Text = skillName .. " 해금! (Lv.1)"
			else
				title.Text = skillName .. " 해금!"
			end
		else
			if cardIdx == 3 then
				title.Text = skillName .. " 강화! (Lv." .. (self.Card3UpgradeCount + 1) .. ")"
			elseif cardIdx == 4 then
				title.Text = skillName .. " 강화! (Lv." .. (self.Card4UpgradeCount + 1) .. ")"
			else
				title.Text = skillName
			end
		end

		if upgradeType == "dmg" then desc.Text = "데미지 +20%"
		elseif upgradeType == "cd" then desc.Text = "쿨타임 -15%"
		elseif upgradeType == "unlock" then desc.Text = "기본 스탯으로 해금"
		elseif upgradeType == "unlock_dmg" then desc.Text = "데미지 +20%로 해금"
		elseif upgradeType == "unlock_cd" then desc.Text = "쿨타임 -15%로 해금"
		end
	end

	@ExecSpace("Multicast")
	method void ShowLevelUpChoices(integer card1, string type1, integer card2, string type2, integer card3, string type3)
		if self:IsServer() then return end
		self:SetChoiceCardText(self.choiceTitle1, self.choiceDesc1, card1, type1)
		self:SetChoiceCardText(self.choiceTitle2, self.choiceDesc2, card2, type2)
		self:SetChoiceCardText(self.choiceTitle3, self.choiceDesc3, card3, type3)
		self.choiceCard1:SetEnable(true)
		self.choiceCard2:SetEnable(true)
		self.choiceCard3:SetEnable(true)
	end

	@ExecSpace("Server")
	method void SelectLevelUpChoice(integer choiceIndex)
		local cardIdx = 0
		local upgradeType = ""
		if choiceIndex == 1 then cardIdx = self._choiceCard1 ; upgradeType = self._choiceType1
		elseif choiceIndex == 2 then cardIdx = self._choiceCard2 ; upgradeType = self._choiceType2
		elseif choiceIndex == 3 then cardIdx = self._choiceCard3 ; upgradeType = self._choiceType3
		end
		if cardIdx == 0 then return end

		self:ApplyCardUpgrade(cardIdx, upgradeType)
		self._choiceCard1 = 0 ; self._choiceCard2 = 0 ; self._choiceCard3 = 0
		self:HideLevelUpChoices()

		if self._pendingLevelUps > 0 then
			self._pendingLevelUps = self._pendingLevelUps - 1
			self:GenerateLevelUpChoices()
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyCardUpgrade(integer cardIdx, string upgradeType)
		-- 포션
		if cardIdx == 6 then
			if self.PotionLevel < 5 then
				self.PotionLevel = self.PotionLevel + 1
				self._potionTimer = 0
			end
			return
		end

		-- 매직 부스터 (패시브 — 슬롯 배치 없이 획득 즉시 영구 활성)
		if cardIdx == 7 then
			if upgradeType == "unlock" then
				self.MagicBoosterLevel = 1
			elseif upgradeType == "booster_up" and self.MagicBoosterLevel < 5 then
				self.MagicBoosterLevel = self.MagicBoosterLevel + 1
			end
			self._boosterActive = true
			self:NotifyBoosterOnPermanent()
			log("MagicBooster L" .. self.MagicBoosterLevel .. " 영구 활성")
			return
		end

		-- 매직 크리티컬 (패시브 — 슬롯 배치 없이 획득 즉시 영구 활성)
		if cardIdx == 8 then
			if upgradeType == "unlock" then
				self.MagicCriticalLevel = 1
			elseif upgradeType == "critical_up" and self.MagicCriticalLevel < 5 then
				self.MagicCriticalLevel = self.MagicCriticalLevel + 1
			end
			self._critActive = true
			self:NotifyCritOnPermanent()
			log("MagicCritical L" .. self.MagicCriticalLevel .. " " .. (self.MagicCriticalLevel * 5) .. "% 영구 활성")
			return
		end

		-- 에너지볼트 (슬롯 해금 또는 레벨 강화)
		if cardIdx == 9 then
			if upgradeType == "unlock" then
				self.EnergyBoltLevel = 1
				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 9)
					self:ResetSlotTimer(slotIdx)
					log("Card9(EnergyBolt) -> Slot" .. slotIdx)
				end
			elseif upgradeType == "energybolt_up" and self.EnergyBoltLevel < 5 then
				self.EnergyBoltLevel = self.EnergyBoltLevel + 1
				if self.EnergyBoltLevel == 4 then
					self.EnergyBoltCritBonus = 0.20
					log("EnergyBolt Lv4: 치명타 +20% 적용")
				end
			end
			log("EnergyBolt L" .. self.EnergyBoltLevel)
			return
		end

		-- 프리징 이펙트 (패시브 — 슬롯 없이 레벨만 증가)
		if cardIdx == 10 then
			if upgradeType == "unlock" then
				self.FreezingEffectLevel = 1
			elseif upgradeType == "freeze_up" and self.FreezingEffectLevel < 5 then
				self.FreezingEffectLevel = self.FreezingEffectLevel + 1
			end
			self:NotifyFreezeOnPermanent()
			log("FreezingEffect L" .. self.FreezingEffectLevel .. " 활성")
			return
		end

		-- 매직클로/콜드빔/썬더볼트는 (해금 포함) 업그레이드할 때마다 1씩 누적 — 타겟 수·확률 스케일링에 쓴다
		if cardIdx == 2 then self.Card2UpgradeCount = self.Card2UpgradeCount + 1
		elseif cardIdx == 3 then self.Card3UpgradeCount = self.Card3UpgradeCount + 1
		elseif cardIdx == 4 then self.Card4UpgradeCount = self.Card4UpgradeCount + 1
		end

		-- 데미지 강화
		if upgradeType == "dmg" or upgradeType == "unlock_dmg" then
			if cardIdx == 1 then self.Card1Damage = self.Card1Damage * 1.2
			elseif cardIdx == 2 then self.Card2Damage = self.Card2Damage * 1.2
			elseif cardIdx == 3 then self.Card3Damage = self.Card3Damage * 1.2
			elseif cardIdx == 4 then self.Card4Damage = self.Card4Damage * 1.2
			elseif cardIdx == 5 then self.Card5Damage = self.Card5Damage * 1.2
			end
		end

		-- 쿨타임 강화
		if upgradeType == "cd" or upgradeType == "unlock_cd" then
			if cardIdx == 1 then self.Card1Cooldown = self.Card1Cooldown * 0.85
			elseif cardIdx == 2 then self.Card2Cooldown = self.Card2Cooldown * 0.85
			elseif cardIdx == 3 then self.Card3Cooldown = self.Card3Cooldown * 0.85
			elseif cardIdx == 4 then self.Card4Cooldown = self.Card4Cooldown * 0.85
			elseif cardIdx == 5 then self.Card5Cooldown = self.Card5Cooldown * 0.85
			end
		end

		-- 해금: 다음 빈 슬롯에 배치
		if upgradeType == "unlock" or upgradeType == "unlock_dmg" or upgradeType == "unlock_cd" then
			if not self:IsCardUnlocked(cardIdx) then
				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, cardIdx)
					self:ResetSlotTimer(slotIdx)
					log("Card" .. cardIdx .. " -> Slot" .. slotIdx)
				end
			end
		end

		log("Card" .. cardIdx .. " upgrade: " .. upgradeType)
	end

	@ExecSpace("ServerOnly")
	method void ResetSlotTimer(integer slotIdx)
		if slotIdx == 1 then self._timer1 = 0
		elseif slotIdx == 2 then self._timer2 = 0
		elseif slotIdx == 3 then self._timer3 = 0
		elseif slotIdx == 4 then self._timer4 = 0
		elseif slotIdx == 5 then self._timer5 = 0
		end
	end

	@ExecSpace("ServerOnly")
	method void ResetAllCards()
		self.Card1Damage = 100 ; self.Card2Damage = 130
		self.Card3Damage = 110 ; self.Card4Damage = 90 ; self.Card5Damage = 80

		self.Card1Cooldown = 0.8 ; self.Card2Cooldown = 1.3
		self.Card3Cooldown = 2.0 ; self.Card4Cooldown = 3.2 ; self.Card5Cooldown = 5.0

		self.Card2UpgradeCount = 0 ; self.Card3UpgradeCount = 0 ; self.Card4UpgradeCount = 0

		self.Slot1Card = 0 ; self.Slot2Card = 0 ; self.Slot3Card = 0
		self.Slot4Card = 0 ; self.Slot5Card = 0

		self._timerBasic = self.Card1Cooldown
		self._timer1 = 0 ; self._timer2 = 0 ; self._timer3 = 0 ; self._timer4 = 0 ; self._timer5 = 0

		self.PotionLevel = 0
		self._potionTimer = 0

		self.MagicBoosterLevel = 0
		self.MagicCriticalLevel = 0
		self._boosterActive = false ; self._boosterTimer = 0
		self._critActive    = false ; self._critTimer    = 0
		self:NotifyBoosterOff()
		self:NotifyCritOff()

		self.EnergyBoltLevel = 0
		self.EnergyBoltCritBonus = 0.0
		self.FreezingEffectLevel = 0

		self._choiceCard1 = 0 ; self._choiceCard2 = 0 ; self._choiceCard3 = 0
		self._choiceType1 = "" ; self._choiceType2 = "" ; self._choiceType3 = ""
		self._pendingLevelUps = 0

		self:HideLevelUpChoices()
		self:BroadcastResetCardSlots()
	end

	-- 이어하기 전용: 버프 상태 복원 (카드·레벨은 유지, 보유 중이면 즉시 영구 활성 재표시)
	@ExecSpace("ServerOnly")
	method void ResetBuffsForContinue()
		self._boosterActive = self.MagicBoosterLevel > 0
		self._critActive    = self.MagicCriticalLevel > 0
		if self._boosterActive then self:NotifyBoosterOnPermanent()
		else self:NotifyBoosterOff() end
		if self._critActive then self:NotifyCritOnPermanent()
		else self:NotifyCritOff() end
	end

	@ExecSpace("Multicast")
	method void BroadcastResetCardSlots()
		if self:IsServer() then return end

		-- 슬롯 1~5 전부 잠금 상태로
		local slots    = {self.slot1,    self.slot2,    self.slot3,    self.slot4,    self.slot5}
		local nums     = {self.slotNum1, self.slotNum2, self.slotNum3, self.slotNum4, self.slotNum5}
		local cooldowns = {self.cooldown1, self.cooldown2, self.cooldown3, self.cooldown4, self.cooldown5}
		for i = 1, 5 do
			-- 빈 슬롯은 카드 뒷면 이미지로 표시한다
			slots[i].ImageRUID = self.EmptySlotRUID
			slots[i].Color = Color(1, 1, 1, 1)
			nums[i].Entity:SetEnable(false)
			cooldowns[i].Entity:SetEnable(false)
		end

		-- 기본공격(파이어샷)은 슬롯과 무관하게 항상 활성 — 카드슬롯 좌측 원형 칼 아이콘
		self.basicAttackCooldown.Entity:SetEnable(true)
		self.basicAttackCooldown.FillAmount = 1

		-- 포션 초기화
		self.potionSlot.Color = Color(0.2, 0.2, 0.2, 0.45)
		self.potionImage.Color = Color(1, 1, 1, 0)
		self.potionCooldown.Entity:SetEnable(false)

		-- 버프 아이콘 초기화
		if self.boosterBuff ~= nil then self:HideBuffIcon(self.boosterBuff, self.boosterFill) end
		if self.critBuff ~= nil then self:HideBuffIcon(self.critBuff, self.critFill) end
	end

	@ExecSpace("Multicast")
	method void PlayPotionCooldownVisual(number cooldown)
		if self:IsServer() then return end
		-- PotionLevel 동기화보다 이 호출이 먼저 도착할 수 있어 self.PotionLevel을 다시 확인하면 안 된다
		-- (서버는 이미 PotionLevel > 0을 확인하고 이 메서드를 호출한다)

		self.potionCooldown.Entity:SetEnable(true)
		self.potionCooldown.FillAmount = 1
		self:RegisterCooldownVisual(self.potionCooldown, cooldown)
	end

	@ExecSpace("Multicast")
	method void HideLevelUpChoices()
		if self:IsServer() then return end
		self.choiceCard1:SetEnable(false)
		self.choiceCard2:SetEnable(false)
		self.choiceCard3:SetEnable(false)
	end

	-- ── 엘리트 몬스터 드롭 ───────────────────────────────────────

	-- 드롭 개수 1~3개 (1개 70% / 2개 20% / 3개 10%)
	method integer RollDropCount()
		local r = _UtilLogic:RandomDouble()
		if r < 0.70 then return 1
		elseif r < 0.90 then return 2
		else return 3
		end
	end

	@ExecSpace("ServerOnly")
	method void OnEliteKilled(Vector3 worldPos)
		-- 슬롯에 배치된 카드(2~5, 9) 중에서 무작위로 1~3개를 강화. 강화할 카드가 없으면 골드 100 지급
		local pool = {}
		for cardIdx = 2, 5 do
			if self:IsCardUnlocked(cardIdx) then table.insert(pool, cardIdx) end
		end
		if self:IsCardUnlocked(9) and self.EnergyBoltLevel < 5 then table.insert(pool, 9) end

		if #pool == 0 then
			_GameManager:AddGold(100)
			return
		end

		local dropCount = self:RollDropCount()
		for i = 1, dropCount do
			local cardIdx = pool[_UtilLogic:RandomIntegerRange(1, #pool)]
			local upgradeType = ""
			if cardIdx == 9 then
				upgradeType = "energybolt_up"
			else
				upgradeType = (_UtilLogic:RandomDouble() < 0.5) and "dmg" or "cd"
			end
			local slotIdx = self:GetSlotForCard(cardIdx)

			if slotIdx > 0 then
				-- 아이콘이 3개 독립적으로 운용되므로 stagger 없이 동시에 드롭한다
				local groundDelay = 1.0 + _UtilLogic:RandomDouble() * 1.0

				-- 실제 강화 적용은 "카드가 슬롯에 실제로 도착하는 시점"에 맞춘다
				local arrivalDelay = self.DropPopDuration + groundDelay + self.DropFlyDuration
				_TimerService:SetTimerOnce(function()
					if isvalid(self) then self:ApplyCardUpgrade(cardIdx, upgradeType) end
				end, arrivalDelay)

				self:ScheduleCardDropVisual(worldPos, cardIdx, slotIdx, groundDelay, i)
			else
				-- 강화 대상 카드가 슬롯에 없는 예외 상황(이론상 발생하지 않음) — 보여줄 연출이 없으니 즉시 적용
				self:ApplyCardUpgrade(cardIdx, upgradeType)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void ScheduleCardDropVisual(Vector3 worldPos, integer cardIdx, integer slotIdx, number groundDelay, integer dropIdx)
		local pos2 = Vector2(worldPos.x, worldPos.y)
		self:PlayCardDropVisual(pos2, cardIdx, slotIdx, groundDelay, dropIdx)
	end

	@ExecSpace("Multicast")
	method void PlayCardDropVisual(Vector2 worldPos, integer cardIdx, integer slotIdx, number groundDelay, integer dropIdx)
		if self:IsServer() then return end

		-- 죽은 자리에 카드가 곧바로 떨어져서 보이게 한다 (이게 빠져있으면 "드롭"이 안 보이고 갑자기 날아가는 것처럼 보인다)
		-- dropIdx별 수평 분산: 1=-70, 2=0, 3=+70 (겹침 방지)
		local rawUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(worldPos))
		local spreadX = (dropIdx - 2) * 70
		local startUI = Vector2(rawUI.x + spreadX, rawUI.y + self.DropYOffset)
		local icon = self:GetDropIcon(dropIdx)
		if not isvalid(icon) then return end
		icon.ImageRUID = self:GetCardIconRUID(cardIdx)
		icon.Color = Color(1, 1, 1, 1)
		icon.Entity:SetEnable(true)
		local tc = icon.Entity.UITransformComponent
		tc.anchoredPosition = startUI
		tc.Scale = Vector3(1, 1, 1)

		-- 메이플식 드롭: 좌우 랜덤 방향으로 포물선 홉 → 점점 작아지는 바운스 2회로 바닥에 안착한 뒤,
		-- 서버와 동일한 groundDelay만큼 머물렀다가 슬롯으로 날아간다
		self:PlayDropPop(icon, startUI, function(landUI)
			_TimerService:SetTimerOnce(function()
				self:FlyCardDropToSlot(icon, landUI, slotIdx)
			end, groundDelay)
		end)
	end

	@ExecSpace("ClientOnly")
	method void PlayDropPop(SpriteGUIRendererComponent icon, Vector2 startUI, any onLanded)
		-- 메이플 아이템 드롭 특유의 "톡 튀어나와 바닥에 안착" 모션: 좌우 랜덤 방향 큰 홉 1회 + 점점 작아지는 제자리 바운스 2회
		if not isvalid(icon) then return end
		local dir = (_UtilLogic:RandomDouble() < 0.5) and -1 or 1
		local landUI = Vector2(startUI.x + dir * (45 + _UtilLogic:RandomDouble() * 45), startUI.y)

		self:PlayHop(icon, startUI, landUI, 70, 0.32, function()
			self:PlayHop(icon, landUI, landUI, 24, 0.16, function()
				self:PlayHop(icon, landUI, landUI, 10, 0.11, function()
					if onLanded ~= nil then onLanded(landUI) end
				end)
			end)
		end)
	end

	@ExecSpace("ClientOnly")
	method void PlayHop(SpriteGUIRendererComponent icon, Vector2 fromUI, Vector2 toUI, number height, number duration, any onDone)
		-- fromUI → toUI 로 포물선(사인 아치)을 그리며 한 번 홉. fromUI==toUI면 제자리 바운스
		_TweenLogic:PlayTween(0.0, 1.0, duration, EaseType.QuadEaseOut, function(t)
			if not isvalid(icon) then return end
			local x = fromUI.x + (toUI.x - fromUI.x) * t
			local y = fromUI.y + (toUI.y - fromUI.y) * t + math.sin(t * math.pi) * height
			icon.Entity.UITransformComponent.anchoredPosition = Vector2(x, y)
		end)
		_TimerService:SetTimerOnce(function()
			if onDone ~= nil then onDone() end
		end, duration)
	end

	@ExecSpace("ClientOnly")
	method void FlyCardDropToSlot(SpriteGUIRendererComponent icon, Vector2 startUI, integer slotIdx)
		if not isvalid(icon) then return end
		local endUI = self:GetSlotUIPosition(slotIdx)
		local arcHeight = 220

		_TweenLogic:PlayTween(0.0, 1.0, self.DropFlyDuration, EaseType.QuadEaseOut, function(t)
			if not isvalid(icon) then return end
			local x = startUI.x + (endUI.x - startUI.x) * t
			local y = startUI.y + (endUI.y - startUI.y) * t + math.sin(t * math.pi) * arcHeight
			icon.Entity.UITransformComponent.anchoredPosition = Vector2(x, y)
			local scale = 1.0 - 0.5 * t
			icon.Entity.UITransformComponent.Scale = Vector3(scale, scale, 1)
			icon.Color = Color(1, 1, 1, 1.0 - 0.6 * t)
		end)

		_TimerService:SetTimerOnce(function()
			if not isvalid(icon) then return end
			icon.Entity:SetEnable(false)
			self:PunchSlotScale(slotIdx)
		end, self.DropFlyDuration)
	end

	@ExecSpace("ClientOnly")
	method void PunchSlotScale(integer slotIdx)
		-- 드롭이 도착한 슬롯을 잠깐 확대-축소시키고 반짝이 파티클을 재생해 도착감을 준다
		local slot = self:GetSlotRenderer(slotIdx)
		if slot == nil then return end
		_TweenLogic:ScaleTo(slot.Entity, Vector2(1.3, 1.3), 0.12, EaseType.BackEaseOut)
		self:PlaySlotSparkle(slotIdx)
		_TimerService:SetTimerOnce(function()
			if isvalid(slot) then
				_TweenLogic:ScaleTo(slot.Entity, Vector2(1, 1), 0.15, EaseType.QuadEaseOut)
			end
		end, 0.12)
	end

	@ExecSpace("ClientOnly")
	method void PlaySlotSparkle(integer slotIdx)
		-- 슬롯 위치로 반짝이 파티클을 옮긴 뒤 재생하고, 재생 시간 동안 알파를 1→0으로 서서히 줄여 자연스럽게 사라지게 한다
		if self.slotSparkle == nil then return end
		self.slotSparkle.Entity.UITransformComponent.anchoredPosition = self:GetSlotUIPosition(slotIdx)
		self.slotSparkle.Color = Color(1, 0.9137254901960784, 0.6588235294117647, 1)
		self.slotSparkle:Play()
		_TweenLogic:PlayTween(1.0, 0.0, 0.5, EaseType.QuadEaseIn, function(a)
			if not isvalid(self.slotSparkle) then return end
			local c = self.slotSparkle.Color
			self.slotSparkle.Color = Color(c.r, c.g, c.b, a)
		end)
		_TimerService:SetTimerOnce(function()
			if isvalid(self.slotSparkle) then self.slotSparkle:Stop() end
		end, 0.5)
	end

	-- [DEBUG] L키 → FreezingEffectLevel 순환 (0→1→2→3→4→5→0)
	@ExecSpace("Server")
	method void DebugFreezingLevelUp()
		if not self.DebugMode then return end
		if self.FreezingEffectLevel < 5 then
			self.FreezingEffectLevel = self.FreezingEffectLevel + 1
		else
			self.FreezingEffectLevel = 0
		end
		log("[DEBUG] FreezingEffectLevel = " .. self.FreezingEffectLevel)
	end

	method void OnEndPlay()
		if self:IsClient() then
			if self._choiceClickHandler1 then self.choiceBtn1.Entity:DisconnectEvent(ButtonClickEvent, self._choiceClickHandler1) end
			if self._choiceClickHandler2 then self.choiceBtn2.Entity:DisconnectEvent(ButtonClickEvent, self._choiceClickHandler2) end
			if self._choiceClickHandler3 then self.choiceBtn3.Entity:DisconnectEvent(ButtonClickEvent, self._choiceClickHandler3) end
			if self._cooldownTimerId ~= 0 then
				_TimerService:ClearTimer(self._cooldownTimerId)
				self._cooldownTimerId = 0
			end
			if self._debugKeyHandler then
				_InputService:DisconnectEvent(KeyDownEvent, self._debugKeyHandler)
				self._debugKeyHandler = nil
			end
		end
	end

end
