	-- SkillInventory 바람의 시(인덱스20) Lv9: "추가 타격 +1"을 추가타 확률 100%(사실상 보장)로 해석해
	-- 적용한다 — 카드 자체 레벨과 별개로 항상 가산.
	method number GetWindPoemExtraHitChance()
		local base = 0
		if self.WindPoemLevel >= 2 then base = 0.07 end
		return base + self:GetSkillInvTierPercent(20, 0, 0, 1.0)
	end

	method number GetWindPoemExtraHitPercent()
		if self.WindPoemLevel >= 5 then return 0.80
		elseif self.WindPoemLevel >= 4 then return 0.70
		elseif self.WindPoemLevel >= 3 then return 0.60
		elseif self.WindPoemLevel >= 2 then return 0.50
		end
		return 0
	end

	-- ── 실피드 전용 조합 스킬: 폭풍의 시 (카드 116) — 바람의 시(101) Lv5 + 파이널 어택: 활(112, 패시브)
	-- 보유 시 등장(슬롯이 꽉 차 있어도 뽑기 풀에 노출). 바람의 시 슬롯을 그대로 넘겨받는다(패시브라
	-- 비울 슬롯 없음). Lv1~3. 바람의 시와 동일한 "활 한 번 당기고 화살 연사" 구조를 그대로 재사용한다
	-- (유저 확인: "한번만 당기고 빠르게 연사 바람의시랑 유사"). 다만 화살은 서로 다른 타겟이 아니라
	-- 매 캐스트 최근접 적 1명에게 5/6/7발 전부 집중된다(표의 "단일" + DPS 역산: dmg×횟수/쿨타임이
	-- 주어진 DPS와 정확히 일치). 활 당기는 연출 중간에 바람의 시엔 없던 keydown/6~10(정지 프레임 5장,
	-- 원본 프레임 이어붙이기) 시퀀스를 새로 끼워넣는다(유저 지정: "바람의 시 활대 연출을 6~10 이걸로
	-- 바꾸면되고" — 리소스팩 실측 확인 결과 prepare/keydownend가 바람의 시 Card101BowGlowRUID/
	-- Card101BowEffectRUID와 동일 RUID라 같은 자산 계열임을 확인). 화살마다(=5/6/7발 각각) 추가 타격
	-- 확률을 독립적으로 판정한다(유저 확인: "독립적"). 크리티컬은 바람의 시와 동일하게 캐스트 1회
	-- 판정한 값을 전체 화살에 공용으로 적용한다(바람의 시 FireWindPoemArrow와 동일 패턴).
	@Sync property integer StormPoemLevel = 0
	property string Card116Name = "폭풍의 시"
	property string Card116IconRUID = "d476a239a9b146598670c692e27c2717"
	property string Card116HitRUID = "9b958d5cd4454585b3580ccd959428af"  -- 전용 착탄 연출(8프레임, 유저 재지정)
	property string Card116ArrowRUID = "574a2f0fbe124b81aa24c534726d6956"  -- 전용 화살(6프레임, 유저 지정)
	property string Card116ShootRUID = "3d659525e3b3485e9b808d73229d39cc"  -- 쏘는 연출(16프레임, 유저 지정)
	property number Card116ShootScale = 1.05  -- 유저 요청으로 쏘는 연출 30% 축소(Card101BowScale 1.5 → 1.05)
	property number Card116Cooldown = 3.5  -- 레벨 무관 고정(바람의 시와 동일)
	property number Card116FrameDuration = 0.05  -- 활 당기는 연출/쏘는 연출/착탄 연출 프레임 이어붙이기 간격
	property number Card116ArrowStaggerDelay = 0.1  -- 바람의 시와 동일(화살 순차 발사 간격)
	property number Card116ArrowStartDelay = 0.05  -- 유저 요청: 화살은 즉발("연출 시작하고 0.05초"), 쏘는 연출(0.8초)이 다 끝나길 기다리지 않는다
	-- 유저 요청: "화살 나올때 쏘는연출 중앙에서 나오면 좋겠네" — 쏘는 연출(be93d810..., 480x444,
	-- pivot nx=0.6583/ny=0.3851, msw_resource_api get으로 확인)은 스폰 좌표(Card101BowPosition)를
	-- pivot으로 삼기 때문에 그림의 실제 시각적 중앙은 pivot에서 벗어나 있다. 로컬 중앙 오프셋
	-- ((0.5-nx)*width, (0.5-ny)*height)*Card116ShootScale/100(px→월드 단위)을 Card101BowRotation(90도,
	-- 반시계) 만큼 회전 변환(wx=-ly, wy=lx)한 값 — 화살 스폰점만 이 오프셋만큼 이동시키고 연출 자체의
	-- 스폰 좌표는 건드리지 않는다.
	property number Card116ArrowSpawnXOffset = -0.42
	property number Card116ArrowSpawnYOffset = -0.80

	-- 전용 착탄 연출(9b958d5cd4454585b3580ccd959428af) 8프레임
	method table GetStormPoemHitFrames()
