	property string Card14IconRUID = "77909f8233254133bb6919c386a2d77d"
	property string Card14EffectRUID = "07a6532ec4d245bdb9537dc0a4b6f7fd"
	property number Card14Cooldown = 4.0
	property number Card14EffectFadeOutDuration = 0.4  -- 연출 전체를 매즈 지속시간만큼 한 번에 재생하고, 끝나기 이 시간 전부터 알파를 0으로 서서히 낮춰 자연스럽게 사라지게 한다
	property number Card14EffectScale = 0.8  -- 몬스터가 맨 앞까지 접근했을 때 연출이 너무 커 보여서 20% 축소
	property number Card14EffectBaseAlpha = 0.8  -- 기본 알파를 20% 낮춤(페이드아웃은 이 값에서 0까지 진행)

	-- ── 실피드 전용: 애로우샷 (기본공격, 카드 25) — 아르카나의 파이어샷(Card1)과 완전히 별도의 트랙이다.
	-- 슬롯 배치와 무관하게 항상 발동하는 상시 기본공격이며, GameManager.SelectedCharacter==1(실피드)일
	-- 때만 틱된다(OnUpdate에서 분기). 수치 공식은 파이어샷과 동일(데미지 강화 ×1.2 최대 5회, 이후
	-- +20 고정 / 쿨타임 강화 ×0.85 최대 5회)하되 완전히 독립된 값으로 관리한다. 아이콘은 유저 요청으로
	-- 신규 아이콘 대신 기존 파이어샷 아이콘(칼 모양)을 그대로 재사용한다.
