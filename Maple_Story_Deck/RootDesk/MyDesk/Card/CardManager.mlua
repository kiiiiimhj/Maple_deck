			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card101Name
			return
		end

		-- 카드 2/5(매직 클로/메테오)
		local skillNames = {self.Card1Name, self.Card2Name, self.Card3Name, self.Card4Name, self.Card5Name}
		local skillName = (cardIdx >= 1 and cardIdx <= 5) and skillNames[cardIdx] or ("카드 " .. cardIdx)
		local nextLevel = 1
		if cardIdx == 2 then nextLevel = self.Card2UpgradeCount + 1
		elseif cardIdx == 5 then nextLevel = self.Card5UpgradeCount + 1
		end
		icon.ImageRUID = self:GetCardIconRUID(cardIdx)
		title.Text = "Lv" .. nextLevel
		name.Text  = skillName
	end

	@ExecSpace("Multicast")
	method void ShowLevelUpChoices(integer card1, string type1, integer card2, string type2, integer card3, string type3)
		if self:IsServer() then return end
		self:SetChoiceCardText(self.choiceIcon1, self.choiceTitle1, self.choiceName1, self.choiceDesc1, card1, type1)
		self:SetChoiceCardText(self.choiceIcon2, self.choiceTitle2, self.choiceName2, self.choiceDesc2, card2, type2)
		self:SetChoiceCardText(self.choiceIcon3, self.choiceTitle3, self.choiceName3, self.choiceDesc3, card3, type3)
		self.choiceCard1:SetEnable(true)
		self.choiceCard2:SetEnable(true)
		self.choiceCard3:SetEnable(true)
	end

	@ExecSpace("Server")
	method void SelectLevelUpChoice(integer choiceIndex)
		local cardIdx = 0
		local upgradeType = ""
		if choiceIndex == 1 then cardIdx = self._choiceCard1 ; upgradeType = self._choiceType1
		elseif choiceIndex == 2 then cardIdx = self._choiceCard2 ; upgradeType = self._choiceType2
		elseif choiceIndex == 3 then cardIdx = self._choiceCard3 ; upgradeType = self._choiceType3
		end
		if cardIdx == 0 then return end

		self:ApplyCardUpgrade(cardIdx, upgradeType)
		self._choiceCard1 = 0 ; self._choiceCard2 = 0 ; self._choiceCard3 = 0
		self:HideLevelUpChoices()

		if self._pendingLevelUps > 0 then
			self._pendingLevelUps = self._pendingLevelUps - 1
			self:GenerateLevelUpChoices()
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyCardUpgrade(integer cardIdx, string upgradeType)
		-- 포션
		if cardIdx == 6 then
			if self.PotionLevel < 5 then
				self.PotionLevel = self.PotionLevel + 1
				self._potionTimer = 0
			end
			return
		end

		-- 매직 부스터 (패시브 — 슬롯 배치 없이 획득 즉시 영구 활성)
		if cardIdx == 7 then
			if upgradeType == "unlock" then
				self.MagicBoosterLevel = 1
			elseif upgradeType == "booster_up" and self.MagicBoosterLevel < 5 then
				self.MagicBoosterLevel = self.MagicBoosterLevel + 1
			end
			self._boosterActive = true
			self:NotifyBoosterOnPermanent()
			log("MagicBooster L" .. self.MagicBoosterLevel .. " 영구 활성")
			return
		end

		-- 매직 크리티컬 (패시브 — 슬롯 배치 없이 획득 즉시 영구 활성)
		if cardIdx == 8 then
			if upgradeType == "unlock" then
				self.MagicCriticalLevel = 1
			elseif upgradeType == "critical_up" and self.MagicCriticalLevel < 5 then
				self.MagicCriticalLevel = self.MagicCriticalLevel + 1
			end
			self._critActive = true
			self:NotifyCritOnPermanent()
			log("MagicCritical L" .. self.MagicCriticalLevel .. " " .. math.floor(self:GetMagicCriticalChance() * 100) .. "% 영구 활성")
			return
		end

		-- 에너지볼트 (슬롯 해금 또는 레벨 강화)
		if cardIdx == 9 then
			if upgradeType == "unlock" then
				self.EnergyBoltLevel = 1
				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 9)
					self:ResetSlotTimer(slotIdx)
					log("Card9(EnergyBolt) -> Slot" .. slotIdx)
				end
			elseif upgradeType == "energybolt_up" and self.EnergyBoltLevel < 5 then
				self.EnergyBoltLevel = self.EnergyBoltLevel + 1
				if self.EnergyBoltLevel == 3 then
					self.EnergyBoltCritBonus = 0.20
					log("EnergyBolt Lv3: 치명타 +20% 적용")
				end
			end
			log("EnergyBolt L" .. self.EnergyBoltLevel)
			return
		end

		-- 바람의 시 (실피드 전용, 슬롯 해금 또는 레벨 강화)
		if cardIdx == 101 then
			if upgradeType == "unlock" then
				self.WindPoemLevel = 1
				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 101)
					self:ResetSlotTimer(slotIdx)
					log("Card101(WindPoem) -> Slot" .. slotIdx)
				end
			elseif upgradeType == "windpoem_up" and self.WindPoemLevel < 5 then
				self.WindPoemLevel = self.WindPoemLevel + 1
			end
			log("WindPoem L" .. self.WindPoemLevel)
			return
		end

		-- 프리징 이펙트 (패시브 — 슬롯 없이 레벨만 증가)
		if cardIdx == 10 then
			if upgradeType == "unlock" then
				self.FreezingEffectLevel = 1
			elseif upgradeType == "freeze_up" and self.FreezingEffectLevel < 5 then
				self.FreezingEffectLevel = self.FreezingEffectLevel + 1
			end
			self:NotifyFreezeOnPermanent()
			log("FreezingEffect L" .. self.FreezingEffectLevel .. " 활성")
			return
		end

		-- 매직 아머 (패시브 — 슬롯 없이 레벨만 증가)
		if cardIdx == 18 then
			if upgradeType == "unlock" then
				self.MagicArmorLevel = 1
			elseif upgradeType == "armor_up" and self.MagicArmorLevel < 5 then
				self.MagicArmorLevel = self.MagicArmorLevel + 1
			end
			self:NotifyArmorOnPermanent()
			log("MagicArmor L" .. self.MagicArmorLevel .. " 활성 (피해 " .. math.floor(self:GetMagicArmorReduction() * 100) .. "% 감소)")
			return
		end

		-- 메디테이션 (패시브 — 슬롯 없이 레벨만 증가)
		if cardIdx == 22 then
			if upgradeType == "unlock" then
				self.MeditationLevel = 1
			elseif upgradeType == "meditation_up" and self.MeditationLevel < 5 then
				self.MeditationLevel = self.MeditationLevel + 1
			end
			self:NotifyMeditationOnPermanent()
			log("Meditation L" .. self.MeditationLevel .. " 활성 (데미지 " .. self:GetMeditationPercent() .. "% 증가)")
			return
		end

		-- 헤일 버스트 (조합 스킬 — 헤일 스톤(Card15) 슬롯을 그대로 넘겨받는다. 프리징 이펙트/메디테이션은
		-- 슬롯 없는 패시브라 비울 슬롯이 없음)
		if cardIdx == 23 then
			if upgradeType == "unlock" then
				self.HailBurstLevel = 1
				local hailSlot = self:GetSlotForCard(15)
				if hailSlot > 0 then
					self:AssignCardToSlot(hailSlot, 23)
					self:ResetSlotTimer(hailSlot)
					self:PlayThunderStormFusionEffect(hailSlot)
					log("Card23(HailBurst) fused into Slot" .. hailSlot .. " (was HailStone)")
				else
					log_warning("HailBurst: HailStone not found in any slot — fusion could not place the card")
				end
			elseif upgradeType == "hailburst_up" and self.HailBurstLevel < 3 then
				self.HailBurstLevel = self.HailBurstLevel + 1
			end
			log("HailBurst L" .. self.HailBurstLevel)
			return
		end

		-- 아쿠아 서지 (조합 스킬 — 아쿠아 트랩(Card14) 슬롯을 그대로 넘겨받는다. 메디테이션은
		-- 슬롯 없는 패시브라 비울 슬롯이 없음)
		if cardIdx == 24 then
			if upgradeType == "unlock" then
				self.AquaSurgeLevel = 1
				local aquaSlot = self:GetSlotForCard(14)
