	-- 버프 아이콘 패널 Entity ↔ 내부 buffName 키 매핑. 신규 패시브 추가 시 이 두 함수(과 그 역함수
	-- GetBuffPanelForKey)에만 한 줄씩 추가하면 Show/Hide/Reposition 전부에 반영된다 — 예전에는 아래
	-- 4개 함수(ShowBuffIconPermanent/ShowBuffIcon/HideBuffIcon/RepositionBuffIcons) 각각에 동일한
	-- if/elseif 체인이 중복되어 있어서 하나라도 빠뜨리면 아이콘이 조용히 안 뜨는 문제가 있었다.
	method string GetBuffKeyForPanel(Entity panel)
		if panel == self.boosterBuff then return "booster"
		elseif panel == self.critBuff then return "crit"
		elseif panel == self.freezeBuff then return "freeze"
		elseif panel == self.armorBuff then return "armor"
		elseif panel == self.meditationBuff then return "meditation"
		elseif panel == self.bowAccelBuff then return "bowaccel"
		elseif panel == self.piercingWillBuff then return "piercingwill"
		elseif panel == self.criticalShotBuff then return "criticalshot"
		elseif panel == self.finalAttackBowBuff then return "finalattackbow"
		elseif panel == self.rapidFireBuff then return "rapidfire"
		elseif panel == self.comboBuff then return "combo"
		elseif panel == self.chanceAttackBuff then return "chanceattack"
		elseif panel == self.comaBuff then return "coma"
		elseif panel == self.selfRecoveryBuff then return "selfrecovery"
		elseif panel == self.warriorMasteryBuff then return "warriormastery"
		elseif panel == self.daggerAccelBuff then return "daggeraccel"
		elseif panel == self.criticalEdgeBuff then return "criticaledge"
		elseif panel == self.karmaBuff then return "karma"
		elseif panel == self.physicalTrainingBuff then return "physicaltraining"
		elseif panel == self.darkSightBuff then return "darksight"
		end
		return ""
	end

	method Entity GetBuffPanelForKey(string buffName)
		if buffName == "booster" then return self.boosterBuff
		elseif buffName == "crit" then return self.critBuff
		elseif buffName == "freeze" then return self.freezeBuff
		elseif buffName == "armor" then return self.armorBuff
		elseif buffName == "meditation" then return self.meditationBuff
		elseif buffName == "bowaccel" then return self.bowAccelBuff
		elseif buffName == "piercingwill" then return self.piercingWillBuff
		elseif buffName == "criticalshot" then return self.criticalShotBuff
		elseif buffName == "finalattackbow" then return self.finalAttackBowBuff
		elseif buffName == "rapidfire" then return self.rapidFireBuff
		elseif buffName == "combo" then return self.comboBuff
		elseif buffName == "chanceattack" then return self.chanceAttackBuff
		elseif buffName == "coma" then return self.comaBuff
		elseif buffName == "selfrecovery" then return self.selfRecoveryBuff
		elseif buffName == "warriormastery" then return self.warriorMasteryBuff
		elseif buffName == "daggeraccel" then return self.daggerAccelBuff
		elseif buffName == "criticaledge" then return self.criticalEdgeBuff
		elseif buffName == "karma" then return self.karmaBuff
		elseif buffName == "physicaltraining" then return self.physicalTrainingBuff
		elseif buffName == "darksight" then return self.darkSightBuff
		end
		return nil
	end

	-- 등록된 패시브 버프 아이콘 전부 숨김 — '다시하기' 등 전체 초기화 시 한 곳만 호출하면 되도록
	-- BroadcastResetCardSlots에서 사용(예전엔 booster/crit 2개만 리셋되고 나머지는 리셋 누락 버그가 있었다)
	@ExecSpace("ClientOnly")
	method void HideAllBuffIcons()
		self:HideBuffIcon(self.boosterBuff, self.boosterFill)
		self:HideBuffIcon(self.critBuff, self.critFill)
		self:HideBuffIcon(self.freezeBuff, self.freezeFill)
		self:HideBuffIcon(self.armorBuff, self.armorFill)
		self:HideBuffIcon(self.meditationBuff, self.meditationFill)
		self:HideBuffIcon(self.bowAccelBuff, self.bowAccelFill)
		self:HideBuffIcon(self.piercingWillBuff, self.piercingWillFill)
		self:HideBuffIcon(self.criticalShotBuff, self.criticalShotFill)
		self:HideBuffIcon(self.finalAttackBowBuff, self.finalAttackBowFill)
		self:HideBuffIcon(self.rapidFireBuff, self.rapidFireFill)
		self:HideBuffIcon(self.comboBuff, self.comboFill)
		self:HideBuffIcon(self.chanceAttackBuff, self.chanceAttackFill)
		self:HideBuffIcon(self.comaBuff, self.comaFill)
		self:HideBuffIcon(self.selfRecoveryBuff, self.selfRecoveryFill)
		self:HideBuffIcon(self.warriorMasteryBuff, self.warriorMasteryFill)
		self:HideBuffIcon(self.daggerAccelBuff, self.daggerAccelFill)
		self:HideBuffIcon(self.criticalEdgeBuff, self.criticalEdgeFill)
		self:HideBuffIcon(self.karmaBuff, self.karmaFill)
		self:HideBuffIcon(self.physicalTrainingBuff, self.physicalTrainingFill)
		self:HideBuffIcon(self.darkSightBuff, self.darkSightFill)
	end

	@ExecSpace("ClientOnly")
	method void ShowBuffIconPermanent(Entity panel, SpriteGUIRendererComponent fill)
		-- 영구 패시브 버프 아이콘 표시 — 잔여시간 fill 없이 아이콘만 상시 표시
		if panel == nil or fill == nil then return end
		if self._activeBuffOrder == nil then self._activeBuffOrder = {} end

		local buffName = self:GetBuffKeyForPanel(panel)
		if buffName ~= "" then
			local found = false
			for _, name in ipairs(self._activeBuffOrder) do
				if name == buffName then found = true; break end
			end
			if not found then table.insert(self._activeBuffOrder, buffName) end
		end

		-- fill 오버레이의 activeCooldowns 항목 제거 (이전에 duration 방식으로 등록됐을 경우 정리)
		if self._activeCooldowns ~= nil then
			for i = #self._activeCooldowns, 1, -1 do
				if self._activeCooldowns[i].overlay == fill then
					table.remove(self._activeCooldowns, i)
				end
			end
		end

		panel:SetEnable(true)
		fill.Entity:SetEnable(false)  -- 영구 활성이므로 잔여시간 표시 불필요
		self:RepositionBuffIcons()
	end

	@ExecSpace("ClientOnly")
	method void ShowBuffIcon(Entity panel, SpriteGUIRendererComponent fill, number duration)
		if panel == nil or fill == nil then return end
		if self._activeBuffOrder == nil then self._activeBuffOrder = {} end

		local buffName = self:GetBuffKeyForPanel(panel)
		if buffName ~= "" then
			local found = false
			for _, name in ipairs(self._activeBuffOrder) do
				if name == buffName then found = true; break end
			end
			if not found then table.insert(self._activeBuffOrder, buffName) end
		end

		panel:SetEnable(true)
		fill.Entity:SetEnable(true)
		fill.FillAmount = 0.0
		self:RegisterBuffVisual(fill, duration)
		self:RepositionBuffIcons()
	end

	@ExecSpace("ClientOnly")
	method void HideBuffIcon(Entity panel, SpriteGUIRendererComponent fill)
		if panel == nil then return end
		if self._activeBuffOrder == nil then self._activeBuffOrder = {} end

		local buffName = self:GetBuffKeyForPanel(panel)
		if buffName ~= "" then
			for i = #self._activeBuffOrder, 1, -1 do
				if self._activeBuffOrder[i] == buffName then
					table.remove(self._activeBuffOrder, i)
				end
			end
		end

		panel:SetEnable(false)
		if fill ~= nil and self._activeCooldowns ~= nil then
			for i = #self._activeCooldowns, 1, -1 do
				if self._activeCooldowns[i].overlay == fill then
					table.remove(self._activeCooldowns, i)
				end
			end
		end
		self:RepositionBuffIcons()
	end

	@ExecSpace("ClientOnly")
	method void RepositionBuffIcons()
		if self._activeBuffOrder == nil then return end
		local iconSize = 50
		local iconGap = 4
		local startX = 20
		local startY = 195
		for i = 1, #self._activeBuffOrder do
			local buffName = self._activeBuffOrder[i]
			local panel = self:GetBuffPanelForKey(buffName)
			if panel ~= nil then
				local tf = panel:GetComponent(UITransformComponent)
				if tf ~= nil then
					tf["anchoredPosition"] = Vector2(startX + (i-1) * (iconSize + iconGap), startY)
				end
			end
		end
	end

	-- ── 말풍선 ───────────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void ShowTooltip(integer slotIdx)
		local cardIdx = self:GetSlotCard(slotIdx)
		if cardIdx <= 0 then
			self.tooltipPanel:SetEnable(false)
			return
		end

		-- 이름 (카드 2~4: 강화 횟수 표시)
		local name = ""
		if cardIdx == 2 then
			name = "매직 클로"
			if self.Card2UpgradeCount > 0 then name = name .. " (+" .. self.Card2UpgradeCount .. "강화)" end
		elseif cardIdx == 3 then
			name = "콜드 빔 Lv." .. self.ColdBeamLevel
		elseif cardIdx == 4 then
			name = "썬더 볼트 Lv." .. self.ThunderBoltLevel
		elseif cardIdx == 5 then name = "메테오"
		elseif cardIdx == 7 then name = "매직 부스터 Lv." .. self.MagicBoosterLevel
		elseif cardIdx == 8 then name = "매직 크리티컬 Lv." .. self.MagicCriticalLevel
		elseif cardIdx == 9 then name = self.Card9Name .. " Lv." .. self.EnergyBoltLevel
		elseif cardIdx == 10 then name = self.Card10Name .. " Lv." .. self.FreezingEffectLevel
		elseif cardIdx == 11 then name = self.Card11Name .. " Lv." .. self.IceCutterLevel
		elseif cardIdx == 12 then name = self.Card12Name .. " Lv." .. self.KingPepeLevel
		elseif cardIdx == 13 then name = self.Card13Name .. " Lv." .. self.ThunderCutterLevel
		elseif cardIdx == 14 then name = self.Card14Name .. " Lv." .. self.AquaTrapLevel
		elseif cardIdx == 15 then name = self.Card15Name .. " Lv." .. self.HailStoneLevel
		elseif cardIdx == 16 then name = self.Card16Name .. " Lv." .. self.ThunderStormLevel
		elseif cardIdx == 17 then name = self.Card17Name .. " Lv." .. self.IceStrikeLevel
		elseif cardIdx == 18 then name = self.Card18Name .. " Lv." .. self.MagicArmorLevel
		elseif cardIdx == 19 then name = self.Card19Name .. " Lv." .. self.ChainLightningLevel
		elseif cardIdx == 20 then name = self.Card20Name .. " Lv." .. self.DoubleCutterLevel
		elseif cardIdx == 21 then name = self.Card21Name .. " Lv." .. self.GrandPepeLevel
		elseif cardIdx == 22 then name = self.Card22Name .. " Lv." .. self.MeditationLevel
		elseif cardIdx == 23 then name = self.Card23Name .. " Lv." .. self.HailBurstLevel
		elseif cardIdx == 24 then name = self.Card24Name .. " Lv." .. self.AquaSurgeLevel
		elseif cardIdx == 101 then name = self.Card101Name .. " Lv." .. self.WindPoemLevel
		elseif cardIdx == 102 then name = self.Card102Name .. " Lv." .. self.ArrowBlowLevel
		elseif cardIdx == 103 then name = self.Card103Name .. " Lv." .. self.IceQuiverLevel
		elseif cardIdx == 104 then name = self.Card104Name .. " Lv." .. self.FireQuiverLevel
		elseif cardIdx == 105 then name = self.Card105Name .. " Lv." .. self.PhoenixLevel
		elseif cardIdx == 106 then name = self.Card106Name .. " Lv." .. self.RetreatShotLevel
		elseif cardIdx == 107 then name = self.Card107Name .. " Lv." .. self.UncounterArrowLevel
		elseif cardIdx == 118 then name = self.Card118Name .. " Lv." .. self.ArrowFletterLevel
		elseif cardIdx == 119 then name = self.Card119Name .. " Lv." .. self.UncounterArrowVLevel
		elseif cardIdx == 120 then name = self.Card120Name .. " Lv." .. self.FlashBomberLevel
		elseif cardIdx == 108 then name = self.Card108Name .. " Lv." .. self.FleshMirageLevel
		elseif cardIdx == 114 then name = self.Card114Name .. " Lv." .. self.ArrowIllusionLevel
		elseif cardIdx == 115 then name = self.Card115Name .. " Lv." .. self.EvolveLevel
		elseif cardIdx == 116 then name = self.Card116Name .. " Lv." .. self.StormPoemLevel
		elseif cardIdx == 117 then name = self.Card117Name .. " Lv." .. self.EnhancedArrowBlowLevel
		elseif cardIdx == 109 then name = self.Card109Name .. " Lv." .. self.BowAccelerationLevel
		elseif cardIdx == 110 then name = self.Card110Name .. " Lv." .. self.PiercingWillLevel
		elseif cardIdx == 111 then name = self.Card111Name .. " Lv." .. self.CriticalShotLevel
		elseif cardIdx == 112 then name = self.Card112Name .. " Lv." .. self.FinalAttackBowLevel
		elseif cardIdx == 113 then name = self.Card113Name .. " Lv." .. self.RapidFireLevel
		elseif _CardRegistry:HasCard(cardIdx) then name = _CardRegistry:GetName(cardIdx) .. " Lv." .. self:GetSlotLevelNum(cardIdx)
		end

		-- 데미지
		local dmg = ""
		if cardIdx == 2 then dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 3 then dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 4 then dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 5 then dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 7 then
			dmg = "쿨타임 -" .. math.floor(self:GetMagicBoosterReduction() * 100) .. "%  (영구)"
		elseif cardIdx == 8 then
			dmg = "크리티컬 " .. math.floor(self:GetMagicCriticalChance() * 100) .. "%  (영구)"
		elseif cardIdx == 9 then
			local lv = self.EnergyBoltLevel
			local hits = (lv >= 2) and "  ×2" or "  ×1"
			dmg = "대미지 : " .. math.floor(self:GetCardDamage(cardIdx)) .. hits
		elseif cardIdx == 10 then
			local bonusPct = (self.FreezingEffectLevel >= 2) and 6 or 5
			dmg = "아이스 보너스 : +" .. bonusPct .. "%/스택"
		elseif cardIdx == 11 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx)) .. "  (반경 " .. string.format("%.1f", self:GetIceCutterRadius(self.IceCutterLevel)) .. ")"
		elseif cardIdx == 12 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 13 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx)) .. "  (반경 " .. string.format("%.1f", self.Card13Radius) .. ")"
		elseif cardIdx == 14 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 15 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 16 then
			local d1 = self:GetThunderStormHitDamage(self.ThunderStormLevel, 1)
			local d2 = self:GetThunderStormHitDamage(self.ThunderStormLevel, 2)
			local d3 = self:GetThunderStormHitDamage(self.ThunderStormLevel, 3)
			dmg = "데미지 : " .. d1 .. "/" .. d2 .. "/" .. d3 .. "  (반경 " .. string.format("%.1f", self.Card16Radius) .. ")"
		elseif cardIdx == 17 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 18 then
			dmg = "피해 감소 : -" .. math.floor(self:GetMagicArmorReduction() * 100) .. "%  (영구)"
		elseif cardIdx == 19 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 20 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 21 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 22 then
			dmg = "데미지 증가 : +" .. self:GetMeditationPercent() .. "%  (영구)"
		elseif cardIdx == 23 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 24 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 101 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 102 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 103 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 104 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 105 then
			dmg = "타격당 데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 106 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 107 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 118 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 119 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 120 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 108 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 114 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 115 then
			dmg = "어택1 : " .. math.floor(self:GetCardDamage(cardIdx) * self:GetEvolveAttack1Ratio(self.EvolveLevel)) .. "  |  히트연출 : " .. math.floor(self:GetCardDamage(cardIdx) * 0.50)
		elseif cardIdx == 116 then
			dmg = "1타당 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 117 then
			dmg = "1타당 : " .. math.floor(self:GetCardDamage(cardIdx)) .. "  |  연사 " .. self:GetEnhancedArrowBlowArrowCount(self.EnhancedArrowBlowLevel) .. "발  |  강화 시 " .. self.Card117EnhancedHitCount .. "연타"
		elseif cardIdx == 109 then
			dmg = "쿨타임 -" .. math.floor(self:GetBowAccelerationReduction() * 100) .. "%  (영구)"
		elseif cardIdx == 110 then
			dmg = "크리티컬 " .. math.floor(self:GetPiercingWillChance() * 100) .. "%  (영구)"
		elseif cardIdx == 111 then
			dmg = "크리티컬 대미지 +" .. math.floor(self:GetCriticalShotBonus() * 100) .. "%  (영구)"
		elseif cardIdx == 112 then
			dmg = "추가 공격 확률 " .. math.floor(self:GetFinalAttackBowChance() * 100) .. "%  (영구)"
		elseif cardIdx == 113 then
			dmg = "데미지 증가 : +" .. self:GetRapidFirePercent() .. "%  (영구)"
		elseif cardIdx == 151 then
			dmg = "스택 확률 : " .. math.floor(_CardRegistry:GetChance(151, self.ComboAttackLevel) * 100) .. "%  (영구)"
		elseif cardIdx == 152 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 153 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 154 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 155 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 156 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 157 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 158 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 159 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 160 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 161 then
			dmg = "크리티컬 " .. math.floor(_CardRegistry:GetChance(161, self.ChanceAttackLevel) * 100) .. "%  (영구)"
		elseif cardIdx == 162 then
			dmg = "강화 코마 대미지 " .. self:GetComaBurstPercent(self.ComaLevel) .. "%  (영구)"
		elseif cardIdx == 163 then
			dmg = string.format("%.0f", self.SelfRecoveryInterval) .. "초마다 체력 " .. self:GetSelfRecoveryPercent() .. "% 회복  (영구)"
		elseif cardIdx == 164 then
			dmg = "피해량 증가 : +" .. self:GetWarriorMasteryPercent() .. "%  (영구)"
		elseif cardIdx == 180 then
			dmg = "쿨타임 -" .. math.floor(_CardRegistry:GetChance(180, self.DaggerAccelLevel) * 100) .. "%  (영구)"
		elseif cardIdx == 181 then
			dmg = "크리티컬 " .. math.floor(_CardRegistry:GetChance(181, self.CriticalEdgeLevel) * 100) .. "%  (영구)"
		elseif cardIdx == 182 then
			dmg = "크리티컬 대미지 +" .. math.floor(_CardRegistry:GetChance(182, self.KarmaLevel) * 100) .. "%  (영구)"
		elseif cardIdx == 183 then
			dmg = "피해량 증가 : +" .. math.floor(_CardRegistry:GetChance(183, self.PhysicalTrainingLevel) * 100) .. "%  (영구)"
		elseif cardIdx == 184 then
			dmg = "공격 회피 " .. math.floor(_CardRegistry:GetChance(184, self.DarkSightLevel) * 100) .. "%  (영구)"
		elseif cardIdx == 165 then
			dmg = "1타 : " .. math.floor(self:GetCardDamage(cardIdx)) .. "  |  2타 : " .. math.floor(self:GetCardDamage(cardIdx) * self:GetSpiritBladeSecondHitPercent(self.SpiritBladeLevel))
		elseif cardIdx == 166 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 167 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 168 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 169 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 170 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		elseif cardIdx == 171 then
			dmg = "1타 : " .. math.floor(self:GetCardDamage(cardIdx) * self:GetDoubleStepPercent(self.DoubleStepLevel, 1)) .. "  |  2타 : " .. math.floor(self:GetCardDamage(cardIdx) * self:GetDoubleStepPercent(self.DoubleStepLevel, 2))
		elseif cardIdx == 185 then
			dmg = "1타 : " .. math.floor(self:GetCardDamage(cardIdx) * self:GetAssassinatePercent(self.AssassinateLevel, 1)) .. "  |  2타 : " .. math.floor(self:GetCardDamage(cardIdx) * self:GetAssassinatePercent(self.AssassinateLevel, 2))
		elseif cardIdx == 186 then
			dmg = "타당 : " .. math.floor(self:GetCardDamage(cardIdx) * self:GetSonicBlowPercent(self.SonicBlowLevel))
		elseif cardIdx == 187 then
			local base187 = self:GetCardDamage(cardIdx)
			dmg = "초당 : " .. math.floor(base187) .. "  (DoT)  |  보너스 : " .. math.floor(base187 * self:GetSmokeRampageBonusPercent(self.SmokeRampageLevel)) .. "  (" .. math.floor(self:GetSmokeRampageBonusPercent(self.SmokeRampageLevel) * 100) .. "%)"
		elseif cardIdx == 188 then
			local base188 = self:GetCardDamage(cardIdx)
			dmg = "범위 타격 : " .. math.floor(base188 * self:GetAzureEdgeExplosionPercent(self.AzureEdgeLevel)) .. "  (" .. math.floor(self:GetAzureEdgeExplosionPercent(self.AzureEdgeLevel) * 100) .. "%)"
		elseif cardIdx == 189 then
			local base189 = self:GetCardDamage(cardIdx) * self.Card189HitPercent
			dmg = "메소 1개당 1타 : " .. math.floor(base189) .. "  |  2타 : " .. math.floor(base189)
		elseif cardIdx == 190 then
			dmg = "스킬 복사 " .. math.floor(self:GetDualShadowPartnerSkillPercent(self.DualShadowPartnerLevel) * 100) .. "%  |  기본공격 복사 " .. math.floor(self:GetDualShadowPartnerBasicPercent(self.DualShadowPartnerLevel) * 100) .. "%  (원본 카드 데미지 기준)"
		elseif cardIdx == 191 then
			local lv191 = self.AbyssalFlareLevel
			dmg = "초당 틱 : " .. math.floor(self:GetCardDamage(cardIdx) * self:GetAbyssalFlareTickPercent(lv191)) .. "  (" .. math.floor(self:GetAbyssalFlareTickPercent(lv191) * 100) .. "%)"
		elseif cardIdx == 173 then
			local lv173 = self.SavageBlowLevel
			local base173 = self:GetCardDamage(cardIdx)
			dmg = "1타 : " .. math.floor(base173 * self:GetSavageBlowPercent(lv173, 1)) .. "  |  2타 : " .. math.floor(base173 * self:GetSavageBlowPercent(lv173, 2)) .. "  |  3타 : " .. math.floor(base173 * self:GetSavageBlowPercent(lv173, 3))
		elseif cardIdx == 174 then
			dmg = "초당 : " .. math.floor(self:GetCardDamage(cardIdx)) .. "  (DoT)"
		elseif cardIdx == 175 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx)) .. "  (넉백 후 범위 100%)"
		elseif cardIdx == 176 then
			dmg = "데미지 : " .. math.floor(self:GetCardDamage(cardIdx))
		end

		-- 쿨타임 (부스터 활성 중이면 실효 쿨타임 추가 표시)
		local cd = self:GetCardCooldown(cardIdx)
		local isPassiveCard = cardIdx == 10 or cardIdx == 18 or cardIdx == 22
			or cardIdx == 109 or cardIdx == 110 or cardIdx == 111 or cardIdx == 112 or cardIdx == 113
			or cardIdx == 151 or cardIdx == 161 or cardIdx == 162 or cardIdx == 163 or cardIdx == 164
			or cardIdx == 180 or cardIdx == 181 or cardIdx == 182 or cardIdx == 183 or cardIdx == 184
		local cdStr = isPassiveCard and "패시브 스킬" or ("쿨타임 : " .. string.format("%.1f", cd) .. "s")
		local boosterOn = false
		if self._activeBuffOrder ~= nil then
			for _, n in ipairs(self._activeBuffOrder) do
				if n == "booster" then boosterOn = true; break end
			end
		end
		if boosterOn and self.MagicBoosterLevel > 0 then
			local effectiveCd = cd * (1.0 - self:GetMagicBoosterReduction())
			cdStr = cdStr .. "  →  " .. string.format("%.1f", effectiveCd) .. "s ★"
		end

		-- 특수 효과 / 추가 정보 (4번째 줄)
		local extraStr = ""
		if cardIdx == 2 then
			extraStr = "타겟 : " .. (1 + self.Card2UpgradeCount) .. "명"
		elseif cardIdx == 3 then
			extraStr = "타겟 : " .. self:GetColdBeamTargetCount() .. "명  |  슬로우 3s"
		elseif cardIdx == 4 then
			local targets = self:GetThunderBoltTargetCount()
			local stunPct = math.floor(self:GetThunderBoltStunChance() * 100)
			local stunDur = self:GetThunderBoltStunDuration()
			if stunDur > 0 then
				extraStr = "타겟 " .. targets .. "명  |  스턴 " .. stunPct .. "% " .. string.format("%.0f", stunDur) .. "초(보스/엘리트 " .. string.format("%.1f", stunDur * 0.5) .. "초)"
			else
				extraStr = "타겟 " .. targets .. "명"
			end
		elseif cardIdx == 5 then
			extraStr = "전체 범위  |  화염 DoT 3회"
		elseif cardIdx == 9 then
			local lv = self.EnergyBoltLevel
			if lv >= 2 then extraStr = "2연발  0.1초 간격" end
			if lv >= 3 then
				if extraStr ~= "" then extraStr = extraStr .. "  |  " end
				extraStr = extraStr .. "치명타 20%"
			end
			if lv >= 5 then
				if extraStr ~= "" then extraStr = extraStr .. "  |  " end
				extraStr = extraStr .. "폭발 " .. math.floor(self:GetCardDamage(9) * 1.2) .. " 광역"
			end
		elseif cardIdx == 10 then
			local lv = self.FreezingEffectLevel
			if lv >= 5 then
				extraStr = "연쇄 3마리(50/35/15%)  |  5스택 시 빙결폭발(AOE 80%)"
			elseif lv >= 4 then
				extraStr = "연쇄 번개 2마리 (50%/35%)"
			elseif lv >= 3 then
				extraStr = "연쇄 번개 1마리 (50%)"
			end
		elseif cardIdx == 11 then
			local lv = self.IceCutterLevel
			local bleedPct = math.floor(self:GetIceCutterBleedPercent(lv) * 100)
			extraStr = "타겟 " .. self:GetIceCutterTargetCount(lv) .. "명  |  범위 광역"
			if bleedPct > 0 then extraStr = extraStr .. "  |  출혈 " .. bleedPct .. "%/틱 (3초)" end
		elseif cardIdx == 12 then
			local coverage = (self.KingPepeLevel >= 3) and "2/4 범위" or "1/4 범위"
			extraStr = "고정 위치  |  " .. coverage
			if self.KingPepeLevel >= 5 then extraStr = extraStr .. "  |  25% 확률 2연타(2타 50%)" end
		elseif cardIdx == 13 then
			local lv = self.ThunderCutterLevel
			local shots = self:GetThunderCutterShotCount()
			extraStr = "범위 광역  |  " .. shots .. "타"
			if lv >= 3 then extraStr = extraStr .. "  |  넉백" end
		elseif cardIdx == 14 then
			local targetCount = self:GetAquaTrapTargetCount()
			local rootDuration = self:GetAquaTrapRootDuration()
			extraStr = "타겟 " .. targetCount .. "명  |  속박 " .. string.format("%.0f", rootDuration) .. "초"
		elseif cardIdx == 15 then
			extraStr = "타겟 " .. self:GetHailStoneTargetCount() .. "명  |  빙결 스택+1"
		elseif cardIdx == 16 then
			local lv = self.ThunderStormLevel
			local stunPct = math.floor(self:GetThunderStormStunChance(lv) * 100)
			extraStr = "타겟 " .. self:GetThunderStormTargetCount(lv) .. "명  |  3연타  |  스턴 " .. stunPct .. "% " .. string.format("%.0f", self.Card16StunDuration) .. "초"
		elseif cardIdx == 17 then
			extraStr = "타겟 " .. self:GetIceStrikeTargetCount(self.IceStrikeLevel) .. "명  |  슬로우+빙결 스택2"
		elseif cardIdx == 19 then
			local lv = self.ChainLightningLevel
