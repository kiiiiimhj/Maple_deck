		-- 아이스 커터 (슬롯 해금 또는 레벨 강화)
		if cardIdx == 11 then
			if upgradeType == "unlock" then
				self.IceCutterLevel = 1
				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 11)
					self:ResetSlotTimer(slotIdx)
