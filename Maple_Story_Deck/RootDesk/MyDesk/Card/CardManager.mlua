	-- 레벨별 고정 데미지 — Lv1-2:90 / Lv3-4:130 / Lv5:170
	method number GetWindPoemDamage()
		if self.WindPoemLevel >= 5 then return 85
		elseif self.WindPoemLevel >= 3 then return 65
		end
		return 45
	end

	-- 레벨별 타겟 수 — Lv1-2:2명 / Lv3-5:3명
	method integer GetWindPoemTargetCount()
		if self.WindPoemLevel >= 4 then return 5
		elseif self.WindPoemLevel >= 2 then return 4
		end
		return 3
	end

	-- 추가타(Lv2~5만 존재, Lv1은 없음) — 확률은 레벨 무관 고정 7%, 대미지 비율만 레벨별로 증가
	-- (Lv2:50% / Lv3:60% / Lv4:70% / Lv5:80%). 착탄 연출이 끝난 뒤에 이어서 재생되고, 그 사이
	-- 타겟이 죽어도 연출 자체는 그대로 나온다(유저 요청: "몬스터가 죽어도 추가타 연출은 나오게").
