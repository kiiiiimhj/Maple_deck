			-- 새 슬롯이 필요없고 아이스 퀴버가 있던 슬롯을 그대로 넘겨받으므로 hasEmptySlot 체크를 건너뛴다.
			if self.IceQuiverLevel >= 5 and self.FireQuiverLevel >= 5 and self.ArrowIllusionLevel == 0 then
