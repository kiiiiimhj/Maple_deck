				self.KingPepeLevel = self.KingPepeLevel + 1
			end
			log("KingPepe L" .. self.KingPepeLevel)
			return
		end

		-- 썬더 커터 (슬롯 해금 또는 레벨 강화)
		if cardIdx == 13 then
			if upgradeType == "unlock" then
				self.ThunderCutterLevel = 1
				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 13)
					self:ResetSlotTimer(slotIdx)
					log("Card13(ThunderCutter) -> Slot" .. slotIdx)
				end
			elseif upgradeType == "thundercutter_up" and self.ThunderCutterLevel < 5 then
				self.ThunderCutterLevel = self.ThunderCutterLevel + 1
			end
			log("ThunderCutter L" .. self.ThunderCutterLevel)
			return
		end

		if cardIdx == 14 then
			if upgradeType == "unlock" then
				self.AquaTrapLevel = 1
				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 14)
					self:ResetSlotTimer(slotIdx)
					log("Card14(AquaTrap) -> Slot" .. slotIdx)
				end
			elseif upgradeType == "aquatrap_up" and self.AquaTrapLevel < 5 then
				self.AquaTrapLevel = self.AquaTrapLevel + 1
			end
			log("AquaTrap L" .. self.AquaTrapLevel)
			return
