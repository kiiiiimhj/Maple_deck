				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 15)
					self:ResetSlotTimer(slotIdx)
					log("Card15(HailStone) -> Slot" .. slotIdx)
				end
			elseif upgradeType == "hailstone_up" and self.HailStoneLevel < 5 then
				self.HailStoneLevel = self.HailStoneLevel + 1
			end
			log("HailStone L" .. self.HailStoneLevel)
			return
		end

		if cardIdx == 4 then
			if upgradeType == "unlock" then
				self.ThunderBoltLevel = 1
				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 4)
					self:ResetSlotTimer(slotIdx)
					log("Card4(ThunderBolt) -> Slot" .. slotIdx)
				end
			elseif upgradeType == "thunderbolt_up" and self.ThunderBoltLevel < 5 then
				self.ThunderBoltLevel = self.ThunderBoltLevel + 1
			end
