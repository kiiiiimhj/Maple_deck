		if cardIdx == 160 then
			if upgradeType == "unlock" then
				self.BraveSlashLevel = 1
				local brandishSlot = self:GetSlotForCard(153)
				local leapSlot = self:GetSlotForCard(158)
				if brandishSlot > 0 then
					self:AssignCardToSlot(brandishSlot, 160)
					self:ResetSlotTimer(brandishSlot)
					self:PlayThunderStormFusionEffect(brandishSlot)
					log("Card160(BraveSlash) fused into Slot" .. brandishSlot .. " (was Brandish)")
				else
					log_warning("BraveSlash: Brandish not found in any slot — fusion could not place the card")
				end
				if leapSlot > 0 then
					self:AssignCardToSlot(leapSlot, 0)
					log("BraveSlash: LeapAttack's Slot" .. leapSlot .. " emptied")
				end
			elseif upgradeType == "braveslash_up" and self.BraveSlashLevel < 3 then
				self.BraveSlashLevel = self.BraveSlashLevel + 1
			end
			log("BraveSlash L" .. self.BraveSlashLevel .. " (dmg=" .. math.floor(self:GetBraveSlashDamage(self.BraveSlashLevel)) .. " targets=" .. self:GetBraveSlashTargetCount(self.BraveSlashLevel) .. ")")
			return
		end

		-- 스카링 소드(슬롯형 액티브)
		if cardIdx == 159 then
			if upgradeType == "unlock" then
				self.ScarringSwordLevel = 1
				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, 159)
					self:ResetSlotTimer(slotIdx)
					log("Card159(ScarringSword) -> Slot" .. slotIdx)
				end
			elseif upgradeType == "scarringsword_up" and self.ScarringSwordLevel < 5 then
				self.ScarringSwordLevel = self.ScarringSwordLevel + 1
			end
			log("ScarringSword L" .. self.ScarringSwordLevel .. " (dmg=" .. math.floor(self:GetScarringSwordDamage(self.ScarringSwordLevel)) .. " duration=" .. self:GetScarringSwordDuration(self.ScarringSwordLevel) .. ")")
			return
		end

		-- 스카링 블레이드 (조합 스킬 — 스카링 소드 슬롯을 그대로 넘겨받는다. 찬스 어택/워리어 마스터리는
		-- 둘 다 슬롯 없는 패시브라 비울 슬롯이 없음)
		if cardIdx == 169 then
			if upgradeType == "unlock" then
				self.ScarringBladeLevel = 1
				local scarringSwordSlot = self:GetSlotForCard(159)
				if scarringSwordSlot > 0 then
					self:AssignCardToSlot(scarringSwordSlot, 169)
					self:ResetSlotTimer(scarringSwordSlot)
					self:PlayThunderStormFusionEffect(scarringSwordSlot)
					log("Card169(ScarringBlade) fused into Slot" .. scarringSwordSlot .. " (was ScarringSword)")
				else
					log_warning("ScarringBlade: ScarringSword not found in any slot — fusion could not place the card")
				end
			elseif upgradeType == "scarringblade_up" and self.ScarringBladeLevel < 3 then
				self.ScarringBladeLevel = self.ScarringBladeLevel + 1
			end
			log("ScarringBlade L" .. self.ScarringBladeLevel .. " (dmg=" .. math.floor(self:GetScarringBladeDamage(self.ScarringBladeLevel)) .. " duration=" .. self:GetScarringBladeDuration(self.ScarringBladeLevel) .. ")")
			return
		end

		-- 데미지 강화
		if upgradeType == "dmg" or upgradeType == "unlock_dmg" then
			if cardIdx == 2 then self.Card2Damage = self.Card2Damage * 1.2
			elseif cardIdx == 5 then self.Card5Damage = self.Card5Damage * 1.2
			end
		end

		-- 쿨타임 강화
		if upgradeType == "cd" or upgradeType == "unlock_cd" then
			if cardIdx == 2 then self.Card2Cooldown = self.Card2Cooldown * 0.85
			elseif cardIdx == 5 then self.Card5Cooldown = self.Card5Cooldown * 0.85
			end
		end

		-- 해금: 다음 빈 슬롯에 배치
		if upgradeType == "unlock" or upgradeType == "unlock_dmg" or upgradeType == "unlock_cd" then
			if not self:IsCardUnlocked(cardIdx) then
				local slotIdx = self:GetNextEmptySlot()
				if slotIdx > 0 then
					self:AssignCardToSlot(slotIdx, cardIdx)
					self:ResetSlotTimer(slotIdx)
					log("Card" .. cardIdx .. " -> Slot" .. slotIdx)
				end
			end
		end

		log("Card" .. cardIdx .. " upgrade: " .. upgradeType)
	end

	@ExecSpace("ServerOnly")
	method void ResetSlotTimer(integer slotIdx)
		if slotIdx == 1 then self._timer1 = 0
		elseif slotIdx == 2 then self._timer2 = 0
		elseif slotIdx == 3 then self._timer3 = 0
		elseif slotIdx == 4 then self._timer4 = 0
		elseif slotIdx == 5 then self._timer5 = 0
		elseif slotIdx == 6 then self._timer6 = 0
		end
	end

	-- ── 무기 스킬(장비 인벤토리 등급 스킬, 유저 지정) ────────────────────────────────
	-- 레어 등급 무기 장착 중 "이번 런" 동안 처치 100마리를 채우면, 카드 슬롯/보유 여부와 완전히
	-- 무관하게 Lv.1 스킬이 자동으로(자체 쿨타임으로 반복) 발동되기 시작한다. 어떤 스킬이냐는
	-- ItemGearStruct.SkillVariant(1~4: 썬더볼트/썬더커터/에너지볼트/페페)로 결정되고, 무기 등급이
	-- 레어/레전더리가 아니면(매직/에픽/유니크는 4칸이 전부 같은 수치 보너스라 변형이 의미 없음) 아무
	-- 효과도 없다. 장비는 인게임에서 해제할 수 없으므로 "장착 해제 시 꺼짐" 처리는 불필요하다.
	-- 레전더리의 "기본 공격시 확률로 Lv.3 즉발"은 TickCard 반환값에 발동 여부가 없어 후속 작업으로 미룸.
	property integer WeaponSkillGrade = 0
	property integer WeaponSkillVariant = 1
	property integer WeaponSkillQuality = 0
	property integer WeaponSkillProcChancePerMille = 0
	property integer WeaponSkillKillCount = 0
	property boolean WeaponSkillUnlocked = false
	property number WeaponSkillTimer = 0

	-- 런 시작(최초 시작/다시하기 공통) 시 1회, 로비 장비 인벤토리에서 현재 장착된 무기의 등급+스킬
	-- 변형을 읽어와 이번 런 동안 고정한다(런 중에는 장비를 바꿀 수 없으므로 재확인 불필요).
	-- userId는 호출부(GameManager.StartGame/RestartGame)가 RequestStartGame/RequestRestart의
	-- senderUserId를 그대로 흘려보낸 값 — _UserService.LocalPlayer는 클라이언트 전용 개념이라
	-- 서버(ServerOnly)에서 읽으면 항상 nil이라 절대 쓰면 안 된다(LEA-2007 AttemptToIndex 원인이었음)
	@ExecSpace("ServerOnly")
	method void InitWeaponSkillForRun(string userId)
		self.WeaponSkillGrade = 0
		self.WeaponSkillVariant = 1
		self.WeaponSkillQuality = 0
		self.WeaponSkillProcChancePerMille = 0
		self.WeaponSkillKillCount = 0
		self.WeaponSkillUnlocked = false
		self.WeaponSkillTimer = 0

		local playerEntity = _UserService:GetUserEntityByUserId(userId)
		if not isvalid(playerEntity) then
			log_error("InitWeaponSkillForRun: invalid userId " .. tostring(userId))
			return
		end

		local playerInventory = playerEntity.PkgPlayerInventory
		-- 버그 수정: playerInventory.CurrentJob은 UIInventory.Open()이 ClientOnly에서만 세팅해서
		-- 서버에서는 항상 nil이었다 — ResolveCurrentJob()으로 서버에서도 안전하게 job을 구한다.
		local weaponStruct = playerInventory:GetAttachedGearItemStruct(playerInventory:ResolveCurrentJob(), _GearCategoryEnum.OneHandedWeapon)
		if weaponStruct == nil then return end
		-- 등급 스킬 프록(SkillVariant→실제 스킬카드)은 레거시 스태프 라인만 갖고 있다 — 2026-08-17에 추가된
		-- 신규 8개 라인은 텍스트 효과라 여기서 걸러내야 한다(IsWeaponItem은 9개 라인 전부 true)
		if not _WeaponTierDataLogic:IsLegacyWeapon(weaponStruct.ItemId) then return end

		local gearStruct = weaponStruct:GetGearStruct()
		if gearStruct == nil then return end

		self.WeaponSkillGrade = gearStruct.Grade
		self.WeaponSkillVariant = gearStruct.SkillVariant
		self.WeaponSkillQuality = gearStruct.Quality
		-- 유저 지정: 확률은 중앙값 상수가 아니라 그 아이템에 드롭 시 고정된 실제 값을 그대로 읽어온다
		self.WeaponSkillProcChancePerMille = gearStruct.ProcChancePerMille
		log("InitWeaponSkillForRun: grade=" .. self.WeaponSkillGrade .. " variant=" .. self.WeaponSkillVariant)
	end

	-- 레전더리 등급 무기 장착 중, 기본 공격이 몬스터를 타격할 때마다 호출 — 기본 공격 자체는 그대로
	-- 두고(유저 지정: "기본 공격은 현재상태 유지"), 별개로 확률만 굴려서 통과하면 Lv.3 스킬을 추가 발동한다.
	-- 확률은 그 무기 아이템에 드롭 시 고정된 ProcChancePerMille(1000분율)을 그대로 사용
	@ExecSpace("ServerOnly")
	method void TryProcWeaponSkill()
		if self.WeaponSkillGrade ~= _GearGradeEnum.Legendary then return end
		if _UtilLogic:RandomIntegerRange(1, 1000) <= self.WeaponSkillProcChancePerMille then
			self:CastWeaponSkill(self.WeaponSkillVariant, 3)
		end
	end

	-- 몬스터 처치마다(보스 포함) MonsterAI.Die()가 호출 — 레어 등급 장착 중일 때만 카운트해서
	-- 100마리째에 잠금 해제(그 뒤로는 OnUpdate가 자체 쿨타임으로 계속 반복 발동)
	@ExecSpace("ServerOnly")
	method void OnWeaponSkillKill()
		if self.WeaponSkillUnlocked then return end
		if self.WeaponSkillGrade ~= _GearGradeEnum.Rare then return end

		self.WeaponSkillKillCount = self.WeaponSkillKillCount + 1
		if self.WeaponSkillKillCount >= 100 then
			self.WeaponSkillUnlocked = true
			self.WeaponSkillTimer = 0
			log("WeaponSkill unlocked: variant=" .. self.WeaponSkillVariant)
		end
	end

	-- 고정 레벨(fixedLevel)로 해당 스킬을 1회 시전한다 — 카드 실제 소유/레벨과 완전히 무관하게 동작하도록,
	-- 레벨 프로퍼티를 잠깐 fixedLevel로 바꿔 기존 Get*Damage/Attack 로직을 그대로 재사용한 뒤 원래 값으로
	-- 되돌린다(같은 프레임 안에서 동기 실행되므로 안전 — 다른 스크립트가 그 사이 값을 읽을 일이 없다).
	-- 반환값은 그 레벨 기준 쿨타임(다음 자동 발동까지 대기시간)
	@ExecSpace("ServerOnly")
	method number CastWeaponSkill(integer skillVariant, integer fixedLevel)
		local targets = self:GetClosestTargets(1)
		local target = targets[1]
		if target == nil then return 1.0 end

		if skillVariant == 2 then
			local prev = self.ThunderCutterLevel
			self.ThunderCutterLevel = fixedLevel
			local damage = self:GetThunderCutterDamage()
			local isCrit = self:RollCrit(13)
			self:ThunderCutterAttack(damage, isCrit, target)
			local cooldown = self.Card13Cooldown
			self.ThunderCutterLevel = prev
			return cooldown
		elseif skillVariant == 3 then
			local prev = self.EnergyBoltLevel
			self.EnergyBoltLevel = fixedLevel
			self:EnergyBoltAttack(target)
			local cooldown = self.Card9Cooldown
			self.EnergyBoltLevel = prev
			return cooldown
		elseif skillVariant == 4 then
			local prev = self.KingPepeLevel
			self.KingPepeLevel = fixedLevel
			local damage = self:GetKingPepeDamage()
			local isCrit = self:RollCrit(12)
			self:KingPepeAttack(damage, isCrit, target, false)
			local cooldown = self:GetKingPepeCooldown()
			self.KingPepeLevel = prev
			return cooldown
		end

		-- 기본값(variant 1): 썬더볼트
		local prev = self.ThunderBoltLevel
		self.ThunderBoltLevel = fixedLevel
		local damage = self:GetThunderBoltDamage()
		local isCrit = self:RollCrit(4)
		self:ThunderAttack(damage, isCrit)
		local cooldown = self.Card4Cooldown
		self.ThunderBoltLevel = prev
		return cooldown
	end

	@ExecSpace("ServerOnly")
	method void ResetAllCards()
		self.Card1Damage = 100 ; self.Card2Damage = 130
		self.Card3Damage = 110 ; self.Card4Damage = 90 ; self.Card5Damage = 80

		self.Card1Cooldown = 0.8 ; self.Card2Cooldown = 1.3
		self.Card3Cooldown = 2.5 ; self.Card4Cooldown = 3.2 ; self.Card5Cooldown = 5.0

		self.Card1UpgradeCount = 0
		self.Card2UpgradeCount = 0 ; self.Card5UpgradeCount = 0
		self.ThunderBoltLevel = 0
		self.ColdBeamLevel = 0

		self.ArrowShotDamage = 100
		self.ArrowShotCooldown = 0.8
		self.ArrowShotUpgradeCount = 0

		self.Slot1Card = 0 ; self.Slot2Card = 0 ; self.Slot3Card = 0
		self.Slot4Card = 0 ; self.Slot5Card = 0 ; self.Slot6Card = 0

		self._timerBasic = self.Card1Cooldown
		self._timerBasicArrow = self.ArrowShotCooldown
		self._timer1 = 0 ; self._timer2 = 0 ; self._timer3 = 0 ; self._timer4 = 0 ; self._timer5 = 0 ; self._timer6 = 0

		self.PotionLevel = 0
		self._potionTimer = 0

		self.MagicBoosterLevel = 0
		self.MagicCriticalLevel = 0
		self._boosterActive = false ; self._boosterTimer = 0
		self._critActive    = false ; self._critTimer    = 0
		self:NotifyBoosterOff()
		self:NotifyCritOff()

		self.EnergyBoltLevel = 0
		self.EnergyBoltCritBonus = 0.0
		self.FreezingEffectLevel = 0
		self.IceCutterLevel = 0
		self.KingPepeLevel = 0
		self.ThunderCutterLevel = 0
		self.AquaTrapLevel = 0
		self.HailStoneLevel = 0
		self.ThunderStormLevel = 0
		self.IceStrikeLevel = 0
		self.MagicArmorLevel = 0
		self.ChainLightningLevel = 0
		self.DoubleCutterLevel = 0
		self.GrandPepeLevel = 0
		self.MeditationLevel = 0
		self.HailBurstLevel = 0
		self.AquaSurgeLevel = 0
		self.WindPoemLevel = 0
		self.ArrowBlowLevel = 0
		self.IceQuiverLevel = 0
		self.FireQuiverLevel = 0
		self.PhoenixLevel = 0
		self.RetreatShotLevel = 0
		self.UncounterArrowLevel = 0
		self.FleshMirageLevel = 0
		self.ArrowIllusionLevel = 0
		self.EvolveLevel = 0
		self.StormPoemLevel = 0
		self.EnhancedArrowBlowLevel = 0
		self.ArrowFletterLevel = 0
		self.UncounterArrowVLevel = 0
		self.FlashBomberLevel = 0
		self.BowAccelerationLevel = 0
		self.PiercingWillLevel = 0
		self.CriticalShotLevel = 0
		self.FinalAttackBowLevel = 0
		self.RapidFireLevel = 0

		-- 레이온 전용 (기존엔 여기서 누락되어 "다시하기"해도 레벨이 그대로 남아있는 버그가 있었다)
		self.LeionAttackDamage = 100
		self.LeionAttackCooldown = 0.8
		self.LeionAttackUpgradeCount = 0
		self._timerBasicLeion = self.LeionAttackCooldown
		self.ComboAttackLevel = 0
		-- 쉐이드 전용
		self.ShadeAttackDamage = 100
		self.ShadeAttackCooldown = 0.8
		self.ShadeAttackUpgradeCount = 0
		self._timerBasicShade = self.ShadeAttackCooldown
		self.DoubleStepLevel = 0
		self.DaggerAccelLevel = 0
		self.CriticalEdgeLevel = 0
		self.KarmaLevel = 0
		self.PhysicalTrainingLevel = 0
		self.DarkSightLevel = 0
		-- 버그 수정(2026-08-13, 유저 지적: "Reset() 리셋 누락도 같이 고쳐줘") — 173~179(새비지블로우~
		-- 다크플레어)가 여기서 전부 빠져있어서 "다시하기"해도 레벨이 그대로 남아있었다(레이온에서 이미
		-- 한 번 터졌던 것과 동일한 클래스 버그). 쉐도우 파트너(178)는 소환된 파트너가 있어도 Phoenix
		-- (105)와 동일하게 별도 Destroy 호출 없이 레벨만 0으로 되돌린다 — 기존 패턴과 동일.
		self.SavageBlowLevel = 0
		self.SmokeGrenadeLevel = 0
		self.MuspelheimLevel = 0
		self.StealLevel = 0
		self.MesoExplosionLevel = 0
		self.ShadowPartnerLevel = 0
		self.DarkFlareLevel = 0
		self.AssassinateLevel = 0
		self.SonicBlowLevel = 0
		self.SmokeRampageLevel = 0
		self.AzureEdgeLevel = 0
		self.MesoDetonationLevel = 0
		self.DualShadowPartnerLevel = 0
		self.AbyssalFlareLevel = 0
		self._dualPartnerAEntity = nil
		self._dualPartnerBEntity = nil
		self._dualPartnerABusy = false
		self._dualPartnerBBusy = false
		self.SlashLevel = 0
		self.BrandishLevel = 0
		self.FlashSlashLevel = 0
		self.ChargeLevel = 0
		self.AuraBladeLevel = 0
		self.RagingBlowLevel = 0
		self.LeapAttackLevel = 0
		self.ScarringSwordLevel = 0
		self.BraveSlashLevel = 0
		self.ChanceAttackLevel = 0
		self.ComaLevel = 0
		self.SelfRecoveryLevel = 0
		self._selfRecoveryTimer = 0
		self.WarriorMasteryLevel = 0
		self.SpiritBladeLevel = 0
		self.BurningRushLevel = 0
		self.SlashStormLevel = 0
		self.SolarBladeLevel = 0
		self.ScarringBladeLevel = 0
		self.FuriousBlowLevel = 0

		self._choiceCard1 = 0 ; self._choiceCard2 = 0 ; self._choiceCard3 = 0
		self._choiceType1 = "" ; self._choiceType2 = "" ; self._choiceType3 = ""
		self._pendingLevelUps = 0

		self:HideLevelUpChoices()
		self:BroadcastResetCardSlots()
	end

	-- 이어하기 전용: 버프 상태 복원 (카드·레벨은 유지, 보유 중이면 즉시 영구 활성 재표시)
	@ExecSpace("ServerOnly")
	method void ResetBuffsForContinue()
		self._boosterActive = self.MagicBoosterLevel > 0
		self._critActive    = self.MagicCriticalLevel > 0
		if self._boosterActive then self:NotifyBoosterOnPermanent()
		else self:NotifyBoosterOff() end
		if self._critActive then self:NotifyCritOnPermanent()
		else self:NotifyCritOff() end
	end

	@ExecSpace("Multicast")
	method void BroadcastResetCardSlots()
		if self:IsServer() then return end

		-- 슬롯 1~6 전부 잠금 상태로
		local slots    = {self.slot1,    self.slot2,    self.slot3,    self.slot4,    self.slot5,    self.slot6}
		local icons    = {self.icon1,    self.icon2,    self.icon3,    self.icon4,    self.icon5,    self.icon6}
		local nums     = {self.slotNum1, self.slotNum2, self.slotNum3, self.slotNum4, self.slotNum5, self.slotNum6}
		local cooldowns = {self.cooldown1, self.cooldown2, self.cooldown3, self.cooldown4, self.cooldown5, self.cooldown6}
		local levelTexts = {self.levelText1, self.levelText2, self.levelText3, self.levelText4, self.levelText5, self.levelText6}
		local nameTexts  = {self.nameText1, self.nameText2, self.nameText3, self.nameText4, self.nameText5, self.nameText6}
		local labelBgs   = {self.labelBg1, self.labelBg2, self.labelBg3, self.labelBg4, self.labelBg5, self.labelBg6}
		local levelBadgeBgs = {self.levelBadgeBg1, self.levelBadgeBg2, self.levelBadgeBg3, self.levelBadgeBg4, self.levelBadgeBg5, self.levelBadgeBg6}
		local effectTexts = {self.effectText1, self.effectText2, self.effectText3, self.effectText4, self.effectText5, self.effectText6}
		for i = 1, 6 do
			-- 빈 슬롯은 카드 뒷면 이미지로 표시한다
			slots[i].ImageRUID = self.EmptySlotRUID
			slots[i].Color = Color(1, 1, 1, 1)
			icons[i].Entity:SetEnable(false)
			labelBgs[i].Entity:SetEnable(false)
			levelBadgeBgs[i].Entity:SetEnable(false)
			levelTexts[i].Text = ""
			nameTexts[i].Text = ""
			effectTexts[i].Text = ""
			nums[i].Entity:SetEnable(false)
			cooldowns[i].Entity:SetEnable(false)
		end

		-- 기본공격(파이어샷)은 슬롯과 무관하게 항상 활성 — 카드슬롯 좌측 원형 칼 아이콘
		self.basicAttackCooldown.Entity:SetEnable(true)
		self.basicAttackCooldown.FillAmount = 1

		-- 포션 초기화
		self.potionSlot.Color = Color(0.2, 0.2, 0.2, 0.45)
		self.potionImage.Color = Color(1, 1, 1, 0)
		self.potionCooldown.Entity:SetEnable(false)

		-- 버프 아이콘 초기화 (등록된 패시브 전부 — 예전엔 booster/crit만 리셋해서 아머·메디테이션 등은
		-- 다시하기 후에도 화면에 남는 버그가 있었다)
		self:HideAllBuffIcons()
	end

	@ExecSpace("Multicast")
	method void PlayPotionCooldownVisual(number cooldown)
		if self:IsServer() then return end
		-- PotionLevel 동기화보다 이 호출이 먼저 도착할 수 있어 self.PotionLevel을 다시 확인하면 안 된다
		-- (서버는 이미 PotionLevel > 0을 확인하고 이 메서드를 호출한다)

		self.potionCooldown.Entity:SetEnable(true)
		self.potionCooldown.FillAmount = 1
		self:RegisterCooldownVisual(self.potionCooldown, cooldown)
	end

	@ExecSpace("Multicast")
	method void HideLevelUpChoices()
		if self:IsServer() then return end
		self.choiceCard1:SetEnable(false)
		self.choiceCard2:SetEnable(false)
		self.choiceCard3:SetEnable(false)
	end

	-- ── 엘리트 몬스터 드롭 ───────────────────────────────────────

	-- 드롭 개수 1~3개 (1개 70% / 2개 20% / 3개 10%)
	method integer RollDropCount()
		local r = _UtilLogic:RandomDouble()
		if r < 0.70 then return 1
		elseif r < 0.90 then return 2
		else return 3
		end
	end

	-- 엘리트/보스가 공유하는 "슬롯에 배치된 액티브 카드" 강화 후보 풀. 카드3/4/9/11/12/13/14/15는
	-- Lv1~5 고정 트랙이라 상한(<5) 체크가 있어야 무제한으로 중복 추가되지 않는다
	method table BuildActiveUpgradePool()
		local pool = {}
		-- 실피드는 아르카나 카드가 아예 안 틱되므로(캐릭터별 스킬 분리) 별도 풀을 쓴다
		if _GameManager.SelectedCharacter == 1 then
			if self:IsCardUnlocked(101) and self.WindPoemLevel < 5 then table.insert(pool, 101) end
			if self:IsCardUnlocked(102) and self.ArrowBlowLevel < 5 then table.insert(pool, 102) end
			if self:IsCardUnlocked(103) and self.IceQuiverLevel < 5 then table.insert(pool, 103) end
			if self:IsCardUnlocked(104) and self.FireQuiverLevel < 5 then table.insert(pool, 104) end
			if self:IsCardUnlocked(105) and self.PhoenixLevel < 5 then table.insert(pool, 105) end
			if self:IsCardUnlocked(106) and self.RetreatShotLevel < 5 then table.insert(pool, 106) end
			if self:IsCardUnlocked(107) and self.UncounterArrowLevel < 5 then table.insert(pool, 107) end
			if self:IsCardUnlocked(108) and self.FleshMirageLevel < 5 then table.insert(pool, 108) end
			return pool
		end
		-- 레이온도 아르카나 카드가 안 틱되므로 별도 풀을 쓴다 — 이 분기가 없으면 아래 아르카나 카드
		-- 목록으로 그대로 흘러들어가 전사 컨셉에 안 맞는 카드가 섞여 나온다. (2026-08-02: 이 분기가
		-- 계속 빈 풀이었던 걸 발견/수정 — 이 함수를 재사용하는 엘리트 처치/상자 이스터에그/얄미운
		-- 미니무르/보너스 보스(발록) 전부에서 레이온 스킬이 한 번도 안 나오고 있었다. 유저 지적:
		-- "상자 누르면 아이템 나오는 이스터에그에 스킬 안들어간거 같은데?" — 조합 결과 카드(160,
		-- 165~170)는 상점과 동일한 정책으로 계속 제외한다.
		if _GameManager.SelectedCharacter == 2 then
			if self:IsCardUnlocked(152) and self.SlashLevel < 5 then table.insert(pool, 152) end
			if self:IsCardUnlocked(153) and self.BrandishLevel < 5 then table.insert(pool, 153) end
			if self:IsCardUnlocked(154) and self.FlashSlashLevel < 5 then table.insert(pool, 154) end
			if self:IsCardUnlocked(155) and self.ChargeLevel < 5 then table.insert(pool, 155) end
			if self:IsCardUnlocked(156) and self.AuraBladeLevel < 5 then table.insert(pool, 156) end
			if self:IsCardUnlocked(157) and self.RagingBlowLevel < 5 then table.insert(pool, 157) end
			if self:IsCardUnlocked(158) and self.LeapAttackLevel < 5 then table.insert(pool, 158) end
			if self:IsCardUnlocked(159) and self.ScarringSwordLevel < 5 then table.insert(pool, 159) end
			return pool
		end
		-- 쉐이드도 아르카나 카드가 안 틱되므로 별도 풀을 쓴다(레이온과 동일한 이유 — 위 2026-08-02 주석 참고).
		if _GameManager.SelectedCharacter == 3 then
			if self:IsCardUnlocked(171) and self.DoubleStepLevel < 5 then table.insert(pool, 171) end
			if self:IsCardUnlocked(173) and self.SavageBlowLevel < 5 then table.insert(pool, 173) end
			if self:IsCardUnlocked(174) and self.SmokeGrenadeLevel < 5 then table.insert(pool, 174) end
			if self:IsCardUnlocked(175) and self.MuspelheimLevel < 5 then table.insert(pool, 175) end
			if self:IsCardUnlocked(176) and self.StealLevel < 5 then table.insert(pool, 176) end
			if self:IsCardUnlocked(177) and self.MesoExplosionLevel < 5 then table.insert(pool, 177) end
			if self:IsCardUnlocked(178) and self.ShadowPartnerLevel < 5 then table.insert(pool, 178) end
			if self:IsCardUnlocked(179) and self.DarkFlareLevel < 5 then table.insert(pool, 179) end
			return pool
		end
		if self:IsCardUnlocked(2) then table.insert(pool, 2) end
		if self:IsCardUnlocked(5) then table.insert(pool, 5) end
		if self:IsCardUnlocked(3) and self.ColdBeamLevel < 5 then table.insert(pool, 3) end
		if self:IsCardUnlocked(4) and self.ThunderBoltLevel < 5 then table.insert(pool, 4) end
		if self:IsCardUnlocked(9) and self.EnergyBoltLevel < 5 then table.insert(pool, 9) end
		if self:IsCardUnlocked(11) and self.IceCutterLevel < 5 then table.insert(pool, 11) end
		if self:IsCardUnlocked(12) and self.KingPepeLevel < 5 then table.insert(pool, 12) end
		if self:IsCardUnlocked(13) and self.ThunderCutterLevel < 5 then table.insert(pool, 13) end
		if self:IsCardUnlocked(14) and self.AquaTrapLevel < 5 then table.insert(pool, 14) end
		if self:IsCardUnlocked(15) and self.HailStoneLevel < 5 then table.insert(pool, 15) end
		return pool
	end

	-- ApplyCardUpgrade가 "레벨+1" 분기에서 확인하는 upgradeType 문자열 — 카드별로 다르다.
	-- 슬롯 카드(2/5)는 dmg/cd 중 무작위, 나머지는 고정 카드별 전용 문자열
	method string GetEliteUpgradeType(integer cardIdx)
		if cardIdx == 3 then return "coldbeam_up"
		elseif cardIdx == 4 then return "thunderbolt_up"
		elseif cardIdx == 9 then return "energybolt_up"
		elseif cardIdx == 11 then return "icecutter_up"
		elseif cardIdx == 12 then return "kingpepe_up"
		elseif cardIdx == 13 then return "thundercutter_up"
		elseif cardIdx == 14 then return "aquatrap_up"
		elseif cardIdx == 15 then return "hailstone_up"
		elseif cardIdx == 7 then return "booster_up"
		elseif cardIdx == 8 then return "critical_up"
		elseif cardIdx == 18 then return "armor_up"
		elseif cardIdx == 22 then return "meditation_up"
		elseif cardIdx == 101 then return "windpoem_up"
		elseif cardIdx == 102 then return "arrowblow_up"
		elseif cardIdx == 103 then return "icequiver_up"
		elseif cardIdx == 104 then return "firequiver_up"
		elseif cardIdx == 105 then return "phoenix_up"
		elseif cardIdx == 106 then return "retreatshot_up"
		elseif cardIdx == 107 then return "uncounterarrow_up"
		elseif cardIdx == 108 then return "fleshmirage_up"
		elseif cardIdx == 109 then return "bowaccel_up"
		elseif cardIdx == 110 then return "piercingwill_up"
		elseif cardIdx == 111 then return "criticalshot_up"
		elseif cardIdx == 112 then return "finalattackbow_up"
		elseif cardIdx == 113 then return "rapidfire_up"
		elseif cardIdx == 151 then return "comboattack_up"
		elseif cardIdx == 152 then return "slash_up"
		elseif cardIdx == 153 then return "brandish_up"
		elseif cardIdx == 154 then return "flashslash_up"
		elseif cardIdx == 155 then return "charge_up"
		elseif cardIdx == 156 then return "aurablade_up"
		elseif cardIdx == 157 then return "ragingblow_up"
		elseif cardIdx == 158 then return "leapattack_up"
		elseif cardIdx == 159 then return "scarringsword_up"
		elseif cardIdx == 161 then return "chanceattack_up"
		elseif cardIdx == 162 then return "coma_up"
		elseif cardIdx == 163 then return "selfrecovery_up"
		elseif cardIdx == 164 then return "warriormastery_up"
		elseif cardIdx == 171 then return "doublestep_up"
		elseif cardIdx == 173 then return "savageblow_up"
		elseif cardIdx == 174 then return "smokegrenade_up"
		elseif cardIdx == 175 then return "muspelheim_up"
		elseif cardIdx == 176 then return "steal_up"
		elseif cardIdx == 177 then return "mesoexplosion_up"
		elseif cardIdx == 178 then return "shadowpartner_up"
		elseif cardIdx == 179 then return "darkflare_up"
		elseif cardIdx == 180 then return "daggeraccel_up"
		elseif cardIdx == 181 then return "criticaledge_up"
		elseif cardIdx == 182 then return "karma_up"
		elseif cardIdx == 183 then return "physicaltraining_up"
		elseif cardIdx == 184 then return "darksight_up"
		elseif cardIdx == 185 then return "assassinate_up"
		elseif cardIdx == 186 then return "sonicblow_up"
		elseif cardIdx == 187 then return "smokerampage_up"
		elseif cardIdx == 188 then return "azureedge_up"
		elseif cardIdx == 189 then return "mesodetonation_up"
		elseif cardIdx == 190 then return "dualshadowpartner_up"
		elseif cardIdx == 191 then return "abyssalflare_up"
		end
		return (_UtilLogic:RandomDouble() < 0.5) and "dmg" or "cd"
	end

	-- pool에서 무작위로 dropCount개를 뽑아 강화한다. 슬롯이 있는 카드는 포션/잡템과 동일한 낙하→비행
	-- 연출 뒤 도착 시점에 적용하고, 슬롯이 없는 카드(매직부스터/크리티컬/아머/메디테이션 — 배치 없이
	-- 즉시 영구 활성)는 보여줄 연출이 없으므로 바로 적용한다.
	-- dropIdxOffset: 같은 프레임에 이 메서드가 두 번 이상 호출될 때(보스: 액티브+패시브) 드롭 아이콘
	-- 슬롯이 겹치지 않도록 dropIdx에 더해주는 오프셋
	@ExecSpace("ServerOnly")
	method void GrantCardUpgradesFromPool(table pool, Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale, integer dropCount, integer dropIdxOffset)
		for i = 1, dropCount do
			local cardIdx = pool[_UtilLogic:RandomIntegerRange(1, #pool)]
			local upgradeType = self:GetEliteUpgradeType(cardIdx)
			local slotIdx = self:GetSlotForCard(cardIdx)

			if slotIdx > 0 then
				-- 아이콘이 3개 독립적으로 운용되므로 stagger 없이 동시에 드롭한다
				local groundDelay = 1.0 + _UtilLogic:RandomDouble() * 1.0

				-- 비행형 몬스터(엘리트 포함)는 사망 위치가 공중이므로, 카드도 포션/잡템과 동일하게
				-- 바닥까지 낙하하는 시간만큼 도착 지연에 반영한다 (GameManager.ScheduleLootDrop과 동일 패턴)
				local fallDuration = 0
				if fallHeight > 0 then fallDuration = math.min(0.6, 0.15 + fallHeight / 500) end
				-- 실제 강화 적용은 "카드가 슬롯에 실제로 도착하는 시점"에 맞춘다
				local arrivalDelay = fallDuration + self.DropPopDuration + groundDelay + self.DropFlyDuration
				_TimerService:SetTimerOnce(function()
					if isvalid(self) then self:ApplyCardUpgrade(cardIdx, upgradeType) end
				end, arrivalDelay)

				self:ScheduleCardDropVisual(worldPos, cardIdx, slotIdx, groundDelay, i + dropIdxOffset, fallHeight, groundWorldY, dropScale)
			else
				-- 슬롯 없는 패시브 카드 — 보여줄 연출이 없으니 즉시 적용
				self:ApplyCardUpgrade(cardIdx, upgradeType)
			end
		end
	end

	-- Ep2MiniBeanEasterEggLogic 전용 — 노란 미니빈을 잡으면 엘리트와 동일한 액티브 카드 강화 풀에서
	-- 딱 1개만 확정 지급한다(유저 지정: "잡으면 스킬 1개"). 강화할 카드가 없으면(전부 만렙/미해금)
	-- 엘리트와 동일하게 골드 100으로 대체한다.
	@ExecSpace("ServerOnly")
	method void OnYellowMiniBeanCaught(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		local pool = self:BuildActiveUpgradePool()
		if #pool == 0 then
			_GameManager:AddGold(100)
			return
		end
		self:GrantCardUpgradesFromPool(pool, worldPos, fallHeight, groundWorldY, dropScale, 1, 0)
	end

	@ExecSpace("ServerOnly")
	method void OnEliteKilled(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		-- 슬롯에 배치된 카드(2~5, 9, 11...) 중에서 무작위로 1~3개를 강화. 강화할 카드가 없으면 골드 100 지급
		local pool = self:BuildActiveUpgradePool()
		if #pool == 0 then
			_GameManager:AddGold(100)
			return
		end
		self:GrantCardUpgradesFromPool(pool, worldPos, fallHeight, groundWorldY, dropScale, self:RollDropCount(), 0)
	end

	-- 타락한 켄타우로스(ep2_map4 MapObject_205, MonsterAI._isCorruptedCentaur) 처치 — 유저 지정:
	-- "빨간포션, 슬롯에 있는 스킬 1개 나오게 해줘(엘리트처럼)". 엘리트(OnEliteKilled)와 달리 개수는
	-- 항상 정확히 1개 고정(RollDropCount의 1~3 랜덤 대신)이고, 빨간 포션(potionType=1)이 항상 같이 나간다.
	@ExecSpace("ServerOnly")
	method void OnCorruptedCentaurKilled(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		_GameManager:ApplyPotionDrop(1, worldPos, fallHeight, groundWorldY, dropScale)
		local pool = self:BuildActiveUpgradePool()
		if #pool == 0 then return end
		self:GrantCardUpgradesFromPool(pool, worldPos, fallHeight, groundWorldY, dropScale, 1, 0)
	end

	-- ── 상자(TreasureChestEgg) 드롭 ─────────────────────────────────

	-- 상자 전용 드롭 개수 1~2개(1개 70% / 2개 30%) — 엘리트(RollDropCount, 최대 3개)보다 상한을 낮춘 버전
	method integer RollBoxDropCount()
		local r = _UtilLogic:RandomDouble()
		if r < 0.70 then return 1
		else return 2
		end
	end

	-- TreasureChestEgg.RequestOpen()이 호출. 엘리트와 동일한 액티브 카드 강화 풀을 쓰되 최대 2개까지만
	-- 지급하고, 강화할 카드가 없으면(전부 만렙/미해금) 엘리트의 골드 100 대체 지급 대신 하얀 포션 1개를
	-- 지급한다(potionType=2 — GameManager.ApplyPotionDrop과 동일한 낙하 연출 재사용)
	@ExecSpace("ServerOnly")
	method void OnTreasureBoxOpened(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		local pool = self:BuildActiveUpgradePool()
		if #pool == 0 then
			_GameManager:ApplyPotionDrop(2, worldPos, fallHeight, groundWorldY, dropScale)
			return
		end
		self:GrantCardUpgradesFromPool(pool, worldPos, fallHeight, groundWorldY, dropScale, self:RollBoxDropCount(), 0)
	end

	-- 보스 처치 보상 — 엘리트와 동일한 방식(이미 장착/해금된 카드 레벨업)이지만 엘리트처럼 1~3개
	-- 무작위가 아니라 액티브 1개 + 패시브 1개를 각각 정확히 확정 지급한다. 해당 종류를 하나도
	-- 장착/해금하지 않았으면(풀이 비면) 그 종류는 건너뛴다(엘리트의 골드 100 대체 지급은 하지 않음 —
	-- 보스는 파워엘릭서/골드/경험치를 이미 별도로 확정 지급하기 때문)
	@ExecSpace("ServerOnly")
	method void GrantBossCardRewards(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		local activePool = self:BuildActiveUpgradePool()
		if #activePool > 0 then
			self:GrantCardUpgradesFromPool(activePool, worldPos, fallHeight, groundWorldY, dropScale, 1, 0)
		end

		local passivePool = {}
		if self:IsCardUnlocked(7) and self.MagicBoosterLevel < 5 then table.insert(passivePool, 7) end
		if self:IsCardUnlocked(8) and self.MagicCriticalLevel < 5 then table.insert(passivePool, 8) end
		if self:IsCardUnlocked(18) and self.MagicArmorLevel < 5 then table.insert(passivePool, 18) end
		if self:IsCardUnlocked(22) and self.MeditationLevel < 5 then table.insert(passivePool, 22) end
		if self:IsCardUnlocked(109) and self.BowAccelerationLevel < 5 then table.insert(passivePool, 109) end
		if self:IsCardUnlocked(110) and self.PiercingWillLevel < 5 then table.insert(passivePool, 110) end
		if self:IsCardUnlocked(111) and self.CriticalShotLevel < 5 then table.insert(passivePool, 111) end
		if self:IsCardUnlocked(112) and self.FinalAttackBowLevel < 5 then table.insert(passivePool, 112) end
		if self:IsCardUnlocked(113) and self.RapidFireLevel < 5 then table.insert(passivePool, 113) end
		-- 레이온 슬롯없는 패시브(2026-08-02 추가 — BuildActiveUpgradePool과 동일한 이유로 빠져있었음)
		if self:IsCardUnlocked(151) and self.ComboAttackLevel < 5 then table.insert(passivePool, 151) end
		if self:IsCardUnlocked(161) and self.ChanceAttackLevel < 5 then table.insert(passivePool, 161) end
		if self:IsCardUnlocked(162) and self.ComaLevel < 5 then table.insert(passivePool, 162) end
		if self:IsCardUnlocked(163) and self.SelfRecoveryLevel < 5 then table.insert(passivePool, 163) end
		if self:IsCardUnlocked(164) and self.WarriorMasteryLevel < 5 then table.insert(passivePool, 164) end
		if #passivePool > 0 then
			self:GrantCardUpgradesFromPool(passivePool, worldPos, fallHeight, groundWorldY, dropScale, 1, 1)
		end
	end

	@ExecSpace("ServerOnly")
	method void ScheduleCardDropVisual(Vector3 worldPos, integer cardIdx, integer slotIdx, number groundDelay, integer dropIdx, number fallHeight, number groundWorldY, number dropScale)
		local pos2 = Vector2(worldPos.x, worldPos.y)
		self:PlayCardDropVisual(pos2, cardIdx, slotIdx, groundDelay, dropIdx, fallHeight, groundWorldY, dropScale)
	end

	@ExecSpace("Multicast")
	method void PlayCardDropVisual(Vector2 worldPos, integer cardIdx, integer slotIdx, number groundDelay, integer dropIdx, number fallHeight, number groundWorldY, number dropScale)
		if self:IsServer() then return end

		-- 죽은 자리에 카드가 곧바로 떨어져서 보이게 한다 (이게 빠져있으면 "드롭"이 안 보이고 갑자기 날아가는 것처럼 보인다)
		-- dropIdx별 수평 분산: 1=-70, 2=0, 3=+70 (겹침 방지)
		local rawUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(worldPos))
		local spreadX = (dropIdx - 2) * 70
		local startUI = Vector2(rawUI.x + spreadX, rawUI.y + self.DropYOffset)
		local icon = self:GetDropIcon(dropIdx)
		if not isvalid(icon) then return end
		icon.ImageRUID = self:GetCardIconRUID(cardIdx)
		icon.Color = Color(1, 1, 1, 1)
		icon.Entity:SetEnable(true)
		local tc = icon.Entity.UITransformComponent
		tc.anchoredPosition = startUI
		tc.Scale = Vector3(dropScale, dropScale, 1)
		tc.UIRotation = Vector3(0, 0, self:GetCardIconRotation(cardIdx))
		tc.ZRotation = 0

		-- 메이플식 드롭: 좌우 랜덤 방향으로 포물선 홉 → 점점 작아지는 바운스 2회로 바닥에 안착한 뒤,
		-- 서버와 동일한 groundDelay만큼 머물렀다가 슬롯으로 날아간다
		local continueFromGround = function(groundStartUI)
			self:PlayDropPop(icon, groundStartUI, function(landUI)
				_TimerService:SetTimerOnce(function()
					self:FlyCardDropToSlot(icon, landUI, slotIdx, dropScale)
				end, groundDelay)
			end)
		end

		-- 비행형 엘리트(존15/16 등)는 사망 위치가 공중이므로, 홉 연출 전에 먼저 실제 발판 높이까지
		-- 빙그르르 돌며 떨어지는 연출을 재생한다 (GameManager.PlayLootDropVisual과 동일 패턴 — groundWorldY를
		-- _UILogic으로 직접 변환해서 착지 UI 좌표를 구한다. world 1유닛=100px 같은 근사 상수는 실제 화면
		-- 변환 비율과 달라서 쓰면 안 된다 — 자세한 이유는 GameManager.PlayFallSpin 주석 참고).
		-- GameManager.PlayLootDropVisual/PlayPotionDropVisual과 동일한 착지 보정 재사용(단일 진실 소스) —
		-- 뒤쪽/멀리서 잡힌 몬스터(dropScale이 작을수록)일수록 카드 드롭도 더 위로 보정된다
		local landYCorrection = _GameManager:GetDropLandYCorrection(dropScale)
		-- 카드 드롭 전용 미세 보정 — 위 공용 보정을 카드에 적용해보니 뒤에서 잡은 몬스터는 살짝 더
		-- 내려야 하고 앞에서 잡은 몬스터는 반대로 살짝 더 올려야 했다(유저 실측). dropScale 중간값(0.875)
		-- 기준으로 앞(dropScale 큼)이면 +, 뒤(dropScale 작음)면 -로 소폭 가감한다
		landYCorrection = landYCorrection + (dropScale - 0.875) * self.CardDropFrontBackTweak

		if fallHeight > 0 then
			-- 착지 지점(groundUI)에는 DropYOffset을 더하지 않는다 — 여기 더하면 최종적으로 안착하는
			-- 높이가 실제 바닥보다 계속 떠 보인다(유저 실측 확인: 아이템이 바닥에 안 붙고 공중에 떠있음).
			-- 등장 시작점(startUI)에만 오프셋을 남겨서 "몸에서 팡 튀어나오는" 연출은 그대로 유지한다.
			local groundRawUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(Vector2(worldPos.x, groundWorldY)))
			local groundUI = Vector2(groundRawUI.x + spreadX, groundRawUI.y + landYCorrection)
			self:PlayFallSpin(icon, startUI, groundUI, fallHeight, continueFromGround)
		else
			continueFromGround(Vector2(rawUI.x + spreadX, rawUI.y + landYCorrection))
		end
	end

	-- groundUI: 실제로 떨어질 UI 좌표(호출측이 groundWorldY를 _UILogic으로 변환해서 넘긴다).
	-- GameManager.PlayFallSpinEx와 동일한 구현이어야 하는데(CardManager/GameManager가 별도 Logic이라
	-- 공유 불가) 360의 배수로 맞추는 보정이 빠져있었다(버그 수정 2026-08-22, 유저 지적: "스킬은 회전하다가
	-- 아무 각도로 딱 멈춰"). spinDegrees가 360의 배수가 아니면 낙하 도중 임의의 각도에서 회전이 끝났다가
	-- 착지 순간 ZRotation=0으로 툭 꺾여 보인다 — GameManager 쪽엔 이미 있던 보정을 여기도 동일하게 적용.
	@ExecSpace("ClientOnly")
	method void PlayFallSpin(SpriteGUIRendererComponent icon, Vector2 startUI, Vector2 groundUI, number fallHeight, any onGrounded)
		if not isvalid(icon) then return end
		local duration = math.min(0.6, 0.15 + fallHeight / 500)
		-- 회전량을 항상 360의 배수로 맞춰서, 다 돌고 나면 항상 원래(0도) 각도로 자연스럽게 떨어지게 한다.
		local rawSpinDegrees = 540 + fallHeight
		local spinDegrees = math.floor(rawSpinDegrees / 360 + 0.5) * 360
		if spinDegrees == 0 then spinDegrees = 360 end

		_TweenLogic:PlayTween(0.0, 1.0, duration, EaseType.QuadEaseIn, function(t)
			if not isvalid(icon) then return end
			local pos = Vector2(startUI.x + (groundUI.x - startUI.x) * t, startUI.y + (groundUI.y - startUI.y) * t)
			icon.Entity.UITransformComponent.anchoredPosition = pos
			icon.Entity.UITransformComponent.ZRotation = spinDegrees * t
		end)

		_TimerService:SetTimerOnce(function()
			if not isvalid(icon) then return end
			icon.Entity.UITransformComponent.ZRotation = 0
			if onGrounded ~= nil then onGrounded(groundUI) end
		end, duration)
	end

	@ExecSpace("ClientOnly")
	method void PlayDropPop(SpriteGUIRendererComponent icon, Vector2 startUI, any onLanded)
		-- 메이플 아이템 드롭 특유의 "톡 튀어나와 바닥에 안착" 모션: 좌우 랜덤 방향 큰 홉 1회 + 점점 작아지는 제자리 바운스 2회
		if not isvalid(icon) then return end
		local dir = (_UtilLogic:RandomDouble() < 0.5) and -1 or 1
		local landUI = Vector2(startUI.x + dir * (45 + _UtilLogic:RandomDouble() * 45), startUI.y)

		self:PlayHop(icon, startUI, landUI, 70, 0.32, function()
			self:PlayHop(icon, landUI, landUI, 24, 0.16, function()
				self:PlayHop(icon, landUI, landUI, 10, 0.11, function()
					if onLanded ~= nil then onLanded(landUI) end
				end)
			end)
		end)
	end

	@ExecSpace("ClientOnly")
	method void PlayHop(SpriteGUIRendererComponent icon, Vector2 fromUI, Vector2 toUI, number height, number duration, any onDone)
		-- fromUI → toUI 로 포물선(사인 아치)을 그리며 한 번 홉. fromUI==toUI면 제자리 바운스
		_TweenLogic:PlayTween(0.0, 1.0, duration, EaseType.QuadEaseOut, function(t)
			if not isvalid(icon) then return end
			local x = fromUI.x + (toUI.x - fromUI.x) * t
			local y = fromUI.y + (toUI.y - fromUI.y) * t + math.sin(t * math.pi) * height
			icon.Entity.UITransformComponent.anchoredPosition = Vector2(x, y)
		end)
		_TimerService:SetTimerOnce(function()
			if onDone ~= nil then onDone() end
		end, duration)
	end

	@ExecSpace("ClientOnly")
	method void FlyCardDropToSlot(SpriteGUIRendererComponent icon, Vector2 startUI, integer slotIdx, number dropScale)
		if not isvalid(icon) then return end
		local endUI = self:GetSlotUIPosition(slotIdx)
		local arcHeight = 220

		_TweenLogic:PlayTween(0.0, 1.0, self.DropFlyDuration, EaseType.QuadEaseOut, function(t)
			if not isvalid(icon) then return end
			local x = startUI.x + (endUI.x - startUI.x) * t
			local y = startUI.y + (endUI.y - startUI.y) * t + math.sin(t * math.pi) * arcHeight
			icon.Entity.UITransformComponent.anchoredPosition = Vector2(x, y)
			local scale = (1.0 - 0.5 * t) * dropScale
			icon.Entity.UITransformComponent.Scale = Vector3(scale, scale, 1)
			icon.Color = Color(1, 1, 1, 1.0 - 0.6 * t)
		end)

		_TimerService:SetTimerOnce(function()
			if not isvalid(icon) then return end
			icon.Entity:SetEnable(false)
			self:PunchSlotScale(slotIdx)
		end, self.DropFlyDuration)
	end

	@ExecSpace("ClientOnly")
	method void PunchSlotScale(integer slotIdx)
		-- 드롭이 도착한 슬롯을 잠깐 확대-축소시키고 반짝이 파티클을 재생해 도착감을 준다
		local slot = self:GetSlotRenderer(slotIdx)
		if slot == nil then return end
		_TweenLogic:ScaleTo(slot.Entity, Vector2(1.3, 1.3), 0.12, EaseType.BackEaseOut)
		self:PlaySlotSparkle(slotIdx)
		_TimerService:SetTimerOnce(function()
			if isvalid(slot) then
				_TweenLogic:ScaleTo(slot.Entity, Vector2(1, 1), 0.15, EaseType.QuadEaseOut)
			end
		end, 0.12)
	end

	@ExecSpace("ClientOnly")
	method void PlaySlotSparkle(integer slotIdx)
		-- 슬롯 위치로 반짝이 파티클을 옮긴 뒤 재생하고, 재생 시간 동안 알파를 1→0으로 서서히 줄여 자연스럽게 사라지게 한다
		if self.slotSparkle == nil then return end
		self.slotSparkle.Entity.UITransformComponent.anchoredPosition = self:GetSlotUIPosition(slotIdx)
		self.slotSparkle.Color = Color(1, 0.9137254901960784, 0.6588235294117647, 1)
		self.slotSparkle:Play()
		_TweenLogic:PlayTween(1.0, 0.0, 0.5, EaseType.QuadEaseIn, function(a)
			if not isvalid(self.slotSparkle) then return end
			local c = self.slotSparkle.Color
			self.slotSparkle.Color = Color(c.r, c.g, c.b, a)
		end)
		_TimerService:SetTimerOnce(function()
			if isvalid(self.slotSparkle) then self.slotSparkle:Stop() end
		end, 0.5)
	end

	-- [DEBUG] L키 → FreezingEffectLevel 순환 (0→1→2→3→4→5→0)
	@ExecSpace("Server")
	method void DebugFreezingLevelUp()
		if not self.DebugMode then return end
		if self.FreezingEffectLevel < 5 then
			self.FreezingEffectLevel = self.FreezingEffectLevel + 1
		else
			self.FreezingEffectLevel = 0
		end
		log("[DEBUG] FreezingEffectLevel = " .. self.FreezingEffectLevel)
	end

	-- [DEBUG] K키 → 실제 레벨업과 완전히 동일한 흐름(GameManager.LevelUp)을 강제 실행 —
	-- Wave/체력 증가까지 실제 레벨업과 동일하게 적용되고, 레벨업 선택 팝업도 그대로 떠서 스킬을 직접 고를 수 있다.
	-- DebugMode가 꺼져 있으면(배포 빌드 기준) 아무 동작도 하지 않는다.
	@ExecSpace("Server")
	method void DebugLevelUp()
		if not self.DebugMode then return end
		_GameManager:LevelUp()
		log("[DEBUG] Forced LevelUp -> Lv." .. _GameManager.Level)
	end

	-- [DEBUG] P키 → 타임어택 카운트다운을 10초로 강제 설정(절망의 칼날 등장 테스트용). 타임어택
	-- 모드가 아니면 아무 동작 안 함. DebugMode가 꺼져 있으면(배포 빌드 기준) 아무 동작도 하지 않는다.
	@ExecSpace("Server")
	method void DebugForceTimeAttackNear()
		if not self.DebugMode then return end
		_GameManager:CheatSetTimeAttackRemaining(10)
		log("[DEBUG] TimeAttackRemaining forced to 10s")
	end

	-- [DEBUG] O키 → 실피드(캐릭터 슬롯) 해금 상태를 미해금으로 되돌려 재테스트할 수 있게 한다.
	-- DebugMode가 꺼져 있으면(배포 빌드 기준) 아무 동작도 하지 않는다.
	@ExecSpace("Server")
	method void DebugResetSylphUnlock()
		if not self.DebugMode then return end
		_CharacterUnlockLogic:DebugResetSylphUnlock()
	end

	method void OnEndPlay()
		if self:IsClient() then
			if self._choiceClickHandler1 then self.choiceBtn1.Entity:DisconnectEvent(ButtonClickEvent, self._choiceClickHandler1) end
			if self._choiceClickHandler2 then self.choiceBtn2.Entity:DisconnectEvent(ButtonClickEvent, self._choiceClickHandler2) end
			if self._choiceClickHandler3 then self.choiceBtn3.Entity:DisconnectEvent(ButtonClickEvent, self._choiceClickHandler3) end
			if self._cooldownTimerId ~= 0 then
				_TimerService:ClearTimer(self._cooldownTimerId)
				self._cooldownTimerId = 0
			end
			if self._debugKeyHandler then
				_InputService:DisconnectEvent(KeyDownEvent, self._debugKeyHandler)
				self._debugKeyHandler = nil
			end
		end
	end

end
