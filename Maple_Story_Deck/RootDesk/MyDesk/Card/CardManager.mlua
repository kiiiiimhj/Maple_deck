		if cardIdx == 169 then return self.ScarringBladeLevel > 0 end
		if cardIdx == 170 then return self.FuriousBlowLevel > 0 end
		if cardIdx == 171 then return self.DoubleStepLevel > 0 end
		if cardIdx == 173 then return self.SavageBlowLevel > 0 end
		if cardIdx == 174 then return self.SmokeGrenadeLevel > 0 end
		if cardIdx == 175 then return self.MuspelheimLevel > 0 end
		if cardIdx == 176 then return self.StealLevel > 0 end
