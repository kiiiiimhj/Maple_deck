@Logic
script CardManager extends Logic

	-- 카드별 데미지 (기본공격=100 기준 비율)
	@Sync property number Card1Damage = 100
	@Sync property number Card2Damage = 130
	@Sync property number Card3Damage = 110
	@Sync property number Card4Damage = 90
	@Sync property number Card5Damage = 80

	-- 카드별 쿨타임 (초)
	@Sync property number Card1Cooldown = 0.8
	@Sync property number Card2Cooldown = 1.3
	@Sync property number Card3Cooldown = 2.5
	@Sync property number Card4Cooldown = 3.2
	@Sync property number Card5Cooldown = 5.0

	-- 파이어샷(Card1)은 다른 카드처럼 5회까지만 "레벨" 배율(데미지×1.2 / 쿨타임×0.85)을 따르고,
	-- 6번째 강화부터는 쿨타임 강화가 더 이상 나오지 않고(쿨타임은 5회째 값에 영구 고정) 데미지만
	-- +20 고정값으로 무한 증가한다. 유일하게 상한 없이 무제한 강화 가능한 카드로 유지.
	@Sync property integer Card1UpgradeCount = 0
	property integer Card1MultiplierCap = 5
	property number Card1FlatDamageBonus = 20

	-- 카드별 스킬 이름
	property string Card1Name = "파이어 샷"
	-- 카드1(기본공격)은 원래 아이콘 개념이 없었다(카드슬롯에 못 들어가는 상시 공격) — 레벨업 선택지
	-- 카드에 아이콘이 필요해서 HUD 좌하단 공격 버튼과 동일한 검 아이콘을 재사용한다
	property string Card1IconRUID = "cc55ed79f099cc94fae152e754984ddd"
	property string Card2Name = "매직 클로"
	property string Card3Name = "콜드 빔"
	property string Card4Name = "썬더 볼트"
	property string Card5Name = "메테오"

	-- 카드별 스킬 아이콘 RUID
	property string Card2IconRUID = "4e76419dd50a4ca99103118dd05e4628"
	property string Card3IconRUID = "31c30270de024b4687f79842a2344fc4"
	property string Card4IconRUID = "aaf8b238c8b14370b008eed503bec731"
	property string Card5IconRUID = "b10fbed8848f49f685863e595d0909f8"

	-- 카드별 스킬 이펙트 RUID (animationclip)
	property string Card1EffectRUID = "602f80c91c2a4bc18d829f00e423f661"
	property string Card2EffectRUID = "598d2d1859e84eaab18ae460a0a1e0a4"
	property string Card3EffectRUID = "6c91fa0907cd4247b756ec5f3481ff39"
	-- 이 연출(6c91fa09...)의 리소스 pivot 메타데이터를 확인해보니 프레임 대부분(2~12번)의 정규화 pivot.x가
	-- 1.07~1.2 사이(스프라이트 오른쪽 바깥)라, 스폰 위치를 그대로 pivot으로 쓰면 그림 몸체 전체가 스폰
	-- 지점보다 왼쪽에 렌더링된다("몬스터 왼쪽에 생겨" 버그의 원인). 대표값(nx≈1.15)을 기준으로 스폰 X를
	-- 오른쪽으로 밀어서 대략 재중앙시킨다 — 프레임마다 pivot이 조금씩 달라서(윈드업 프레임 0~1은 nx가
	-- 3.7~4.3까지 뜀) 완벽히 딱 맞진 않지만 대부분의 재생 구간에서는 몬스터 위에 오도록 근사한 값.
	property number Card3EffectXOffset = 1.0
	-- 칼 꽂히는 연출(Card3EffectRUID)이 끝나자마자 바로 이어서 재생하는 2단계 연출(원래 콜드빔이
	-- 쓰던 얼음 버스트+링 이펙트) — Card3ImpactDelay 시점에 맞춰 스폰된다.
	property string Card3SecondEffectRUID = "9bdeae82f43243ac9d0e271113685f2d"
	-- 2단계 연출이 시작되고 나서 데미지가 들어가기까지의 지연(초)
	property number Card3SecondEffectDamageDelay = 0.2
	-- 2단계 연출 재생 시간 — 공용 skilleffect 모델 기본 Duration(0.8초)에서 25% 줄인 값
	property number Card3SecondEffectLifetime = 0.3
	property string Card4EffectRUID = "33fc60d9910448a2b36035277b28c354"
	property string ChainLightningEffectRUID = "c16694ea8a3148b1b48c792eb37c04a4"
	property string Card5EffectRUID = "8aaeeb6a40ea49bb80699f1fda5bf428"

	-- 메테오 낙하 이펙트가 착탄(폭발 시작)하는 시점에 맞춰 데미지를 적용하기 위한 지연 시간(초)
	property number Card5ImpactDelay = 0.3

	-- 칼이 바닥에 꽂히는 시점(착탄)에 맞춰 데미지를 적용하기 위한 지연 시간(초) — 메테오의
	-- Card5ImpactDelay와 동일한 "연출 먼저, 착탄 시 데미지" 패턴. 정확한 프레임레이트를 실측하지
	-- 못해서(연출 종료 이벤트가 발동 안 함, feedback_skilleffect_duration_timing 참고) 7프레임
	-- (0~Card3ImpactFrameIndex) 재생 시간 추정치. 유저가 직접 확인해서 0.38로 확정했다가, 재생 속도를
	-- PlayRate 0.8(20% 감속)로 늦추면서 같은 비율로 늘림(0.38/0.8=0.475).
	property number Card3ImpactDelay = 0.475
	-- 13프레임 중 "칼이 내려찍혀 꽂히는" 정점까지만(0~6번, 프레임별 크기가 6번에서 최대치를 찍고 이후
	-- 줄어드는 걸로 판단) 재생하고 그 뒤 여운(찔린 채 잦아드는) 프레임은 SpriteRendererComponent의
	-- EndFrameIndex로 아예 잘라낸다.
	property integer Card3ImpactFrameIndex = 6

	-- 업그레이드(데미지/쿨타임/해금 불문, 매번)할 때마다 누적되는 카운트 — 매직클로의 타겟 수 스케일링에 사용
	@Sync property integer Card2UpgradeCount = 0
	-- 메테오는 타겟 수 스케일링은 없지만, 카드슬롯 라벨에 Lv를 보여주려고 같은 방식으로 카운트만 추적한다
	@Sync property integer Card5UpgradeCount = 0

	-- 썬더 볼트 (Card 4) — 스킬 대공사로 카드9~15와 동일한 Lv1~5 고정 레벨 트랙으로 전환(무제한
	-- dmg/cd 반복강화 폐기). 데미지/쿨타임 기본값(Card4Damage/Card4Cooldown)은 레벨과 무관하게 고정 —
	-- 레벨별 정확한 수치는 GetThunderBoltDamage 등 Get* 함수 참고.
	-- Lv1(해금): 타겟2명 / Lv2: 스턴25%·2초 / Lv3: 데미지+40 / Lv4: 타겟+1(3명)·스턴3초(+1초) /
	-- Lv5: 데미지+40·스턴30%(+5%). 보스/엘리트는 스턴 지속시간이 절반으로 적용된다.
	@Sync property integer ThunderBoltLevel = 0

	-- 콜드 빔 (Card 3) — 스킬 대공사로 Lv1~5 고정 레벨 트랙으로 전환(무제한 dmg/cd 반복강화 폐기).
	-- Card3Damage/Card3Cooldown은 레벨과 무관하게 고정 — 레벨별 수치는 GetColdBeamDamage 참고.
	-- (2026-07-18) 2타 구조 폐기 — 단일 히트로 전체 데미지를 한 번에 적용하고, 칼이 바닥에 꽂히는
	-- 연출 시점(Card3ImpactDelay)에 맞춰 데미지가 들어간다("연출 먼저, 착탄 시 데미지" 패턴). 슬로우는
	-- Lv1부터 상시 3초 고정(빙결 효과 레벨에 따른 4초 연장 시너지는 폐기).
	-- Lv1(해금): 타겟1명·슬로우3초 / Lv2: 타겟+1(2명) / Lv3: 데미지+50 / Lv4: 타겟+1(3명) / Lv5: 데미지+50.
	@Sync property integer ColdBeamLevel = 0

	-- 슬롯별 카드 배치 (0=비어있음, 2~5=카드번호) — 1번 슬롯부터 순서대로 쌓임
	@Sync property integer Slot1Card = 0
	@Sync property integer Slot2Card = 0
	@Sync property integer Slot3Card = 0
	@Sync property integer Slot4Card = 0
	@Sync property integer Slot5Card = 0
	@Sync property integer Slot6Card = 0

	-- 포션
	@Sync property integer PotionLevel = 0
	property number PotionCooldown = 15.0
	property number _potionTimer = 0
	property string Potion1RUID = "234aca1a4ce946119b68e3717991e775"
	property string Potion2RUID = "289c7bdcbdc8484ab7bad688b2519ca7"
	property string Potion3RUID = "2d35e350465c47f39eff7596f5c01f22"
	property string Potion4RUID = "6c5241d1d1114c50943f05c3e5982f72"
	property string Potion5RUID = "4fd08a6fa90b45448435cf22dba91c1f"
	property SpriteGUIRendererComponent potionSlot = "e1153f7d-16c0-4e61-849f-2e181d43f0b3"
	property SpriteGUIRendererComponent potionImage = "4193001a-5de7-497b-be4a-49f296d3651b"
	property SpriteGUIRendererComponent potionCooldown = "efb99414-2206-4dce-a52d-96da7c0f3f61"

	-- 엘리트 몬스터 처치 드롭(카드 강화) 연출용 — 동시에 최대 3장 드롭 가능하므로 아이콘 3개 독립 운용
	property SpriteGUIRendererComponent dropFlyIcon = "85419574-ad70-40f3-9f78-392334e80509"
	property SpriteGUIRendererComponent dropFlyIcon2 = "6516c9f2-457c-488c-886b-26ea93066cad"
	property SpriteGUIRendererComponent dropFlyIcon3 = "be0f3299-ada5-4ea6-b9b7-f41e9a85934b"

	-- 카드 드롭이 슬롯에 도착했을 때 재생하는 반짝이 파티클
	property UIBasicParticleComponent slotSparkle = "50d75110-7613-45f0-a45e-a2a8df2aa42a"

	-- 아이템 드롭 등장 Y 좌표 보정 (죽은 위치를 화면 좌표로 환산한 값에 더해 살짝 위로 띄운다)
	property number DropYOffset = 60

	-- 드롭 팝 연출(PlayDropPop 내부 3단계 홉 0.32+0.16+0.11)과 슬롯 비행(FlyCardDropToSlot) 시간 합 —
	-- 서버가 카드 강화를 "카드가 슬롯에 실제로 도착하는 시점"에 맞춰 적용하기 위한 기준값
	property number DropPopDuration = 0.59
	property number DropFlyDuration = 0.6
	-- 카드 드롭 착지 앞/뒤 미세 보정 계수(PlayCardDropVisual 참고)
	property number CardDropFrontBackTweak = 80

	-- 카드 슬롯 프레임 비주얼 바인딩
	property SpriteGUIRendererComponent slot1 = "928a6142-681a-42d4-8171-34d4ef8bbd29"
	property SpriteGUIRendererComponent slot2 = "48cc4ad8-2c80-48cb-abb4-aac6326cf80c"
	property SpriteGUIRendererComponent slot3 = "acff74f4-27c4-4fd1-b671-f0ed81a7e880"
	property SpriteGUIRendererComponent slot4 = "f04dcc8a-e646-4039-97cf-c0e5a7c7a62d"
	property SpriteGUIRendererComponent slot5 = "d35d73b8-a7d0-45b7-b9b9-c71bfd64464a"
	property SpriteGUIRendererComponent slot6 = "66d8cc22-f407-4a29-8c31-af13134bf2dd"
	-- 빈 카드 슬롯에 보여줄 카드 뒷면 이미지
	property string EmptySlotRUID = "a4027817dbc84dbbba125a5e67464343"
	-- 카드 획득 시 뒤집히는 연출의 절반(접히는 데 걸리는 시간) — 전체 연출은 이 값의 2배
	property number SlotFlipHalfDuration = 0.15
	property TextComponent slotNum1 = "9dbf6804-7f8e-4469-9c8f-1711827c2f1f"
	property TextComponent slotNum2 = "8aaccdf3-adb2-4fee-8979-85e289c1c5b6"
	property TextComponent slotNum3 = "ea960b97-902a-4850-8d31-e5151c5071fa"
	property TextComponent slotNum4 = "a97a4a54-341c-493e-92dc-fed5f9a0709a"
	property TextComponent slotNum5 = "d598dd7c-af41-40f0-9274-efec6ff970b5"
	property TextComponent slotNum6 = "1edafe20-9d2c-4e72-a616-1383c685c184"
	-- 카드 슬롯 프레임(db543485bfb24d139135ee0602be6d1f) 안에 정사각형으로 들어가는 스킬 아이콘 —
	-- 예전엔 slot{n}(프레임 전체 130x165)에 스킬 아이콘을 직접 늘려 넣어서 찌그러져 보였다
	property SpriteGUIRendererComponent icon1 = "17dd2af2-29a0-45e3-b720-f694cf9619a5"
	property SpriteGUIRendererComponent icon2 = "bdef191b-3724-4a86-a5c7-b2eb09123ba4"
	property SpriteGUIRendererComponent icon3 = "6853b556-6fff-43f3-940f-e413597845a5"
	property SpriteGUIRendererComponent icon4 = "c97cc8fa-5ed2-4bc2-bf23-f4892a30885f"
	property SpriteGUIRendererComponent icon5 = "b2d1699e-8bdc-46d3-ac5b-8546e9552c27"
	property SpriteGUIRendererComponent icon6 = "a0997484-2adb-4d72-a9c5-33fe66433d1e"
	-- 프레임 하단 라벨의 "Lv{n}" / 스킬 이름 2줄
	property TextComponent levelText1 = "05481a44-c65c-483d-9c83-e4d989e6b457"
	property TextComponent levelText2 = "8ea7a766-0d27-47c6-a9f1-540724778742"
	property TextComponent levelText3 = "195a6b05-f3e5-42d1-b894-ccda10261216"
	property TextComponent levelText4 = "2df7d9eb-3b89-4319-b773-2f5147f0d112"
	property TextComponent levelText5 = "864e4559-4b1e-48f3-b35e-bd1c6ad3ab3e"
	property TextComponent levelText6 = "27749aca-8d92-41db-8694-a6ffaee8ea74"
	property TextComponent nameText1 = "0cd5d773-9bf0-40e9-8f32-1065e8651750"
	property TextComponent nameText2 = "499bf86a-e14c-4c6f-96f0-94388cb99116"
	property TextComponent nameText3 = "4914f84f-4589-4d92-8557-899d99166732"
	property TextComponent nameText4 = "9964f333-e79e-403f-954b-36d11b886bdf"
	property TextComponent nameText5 = "75bd3f5c-f692-42c6-8605-d63b893421cc"
	property TextComponent nameText6 = "93785f8b-8294-4654-b773-6e90066186e4"
	-- 이름 밑 짧은 효과 태그 줄(예: "관통,스턴") — 레벨업 선택 카드와 같은 태그를 재사용한다
	property TextComponent effectText1 = "3d9c77e9-9fda-4415-859d-f26865dbfcae"
	property TextComponent effectText2 = "a09c4031-5542-4f6f-bc0d-c5ded36ab2ec"
	property TextComponent effectText3 = "8e2aa8f9-c940-49e2-ae93-23d925a19793"
	property TextComponent effectText4 = "89e401ee-8d35-482d-a6d6-b871e8cbe79a"
	property TextComponent effectText5 = "8321d35a-6bf4-49c6-bb1a-dca856b62999"
	property TextComponent effectText6 = "8bbf28cb-6879-4d83-85ba-fcc9abe5711c"
	-- Lv/이름 텍스트 밑에 깔리는 어두운 라벨 배경 — 카드 뒷면(빈 슬롯)일 땐 반드시 숨겨야 한다
	property SpriteGUIRendererComponent labelBg1 = "755f1480-ef98-4c1f-be9f-b06809a51c26"
	property SpriteGUIRendererComponent labelBg2 = "2b2c5450-6bf9-43e7-9733-eaca7eb18cf9"
	property SpriteGUIRendererComponent labelBg3 = "a1393697-33ba-45b7-97fa-3d24a9d33ab3"
