	-- 착탄 연출 — 원래 바람의 시가 쓰던 hit/2~5 무작위 세트를 여기로 옮겼다(유저 요청). 화살 자체보다
	-- 작게 보이도록 스케일을 낮췄다.
	property string ArrowShotHitRUID2 = "43b0698875a348229caaf9221a8c8b3a"
