	property number Card101BowGlowDuration = 0.3  -- 1) 재생 시간(추정치 — 라이브에서 실제 애니메이션 길이 보고 조정)
	property string Card101BowEffectRUID = "b00ac0d7b06d4489b91b15be39f51edc"  -- 2) 활 쏘는 연출
	property number Card101BowShootDuration = 0.2  -- 2) 재생 시간(추정치) — 이 시간 뒤 화살 발사 시작
	property number Card101BowEffectModelDuration = 2.5  -- 활 쏘는 연출이 쓰는 "skilleffectlong" 모델의 고정 Duration
	property number Card101BowEffectOverlapMargin = 0.3  -- 모델 Duration에서 이 여유만큼 남았을 때 다음 레이어를 겹쳐 스폰
	-- y=3.0으로 처음 잡았다가 화면(카메라) 밖으로 나가 안 보이는 걸 실측 확인 — 이후 라이브로 직접
	-- 보면서 유저가 "경험치바 아래쯤"으로 지정(화면 상단 HUD 바로 아래)해 2.2로 재조정했었다.
	-- 이후 GetBowSpawnPosition을 플레이어 실제 좌표 기준으로 바꾸면서(맵마다 발판 높이가 달라도 항상
	-- 같은 상대 높이가 나오게 하려고) 이 y값의 의미도 "화면 절대 높이"에서 "플레이어 기준 오프셋"으로
	-- 바뀌었다. 맵1에서 플레이어의 실제 로컬 y가 -1.349였던 걸 실측으로 확인해서, 계산상으론 2.2 -
	-- (-1.349) = 3.549가 예전 절대 높이 2.2와 동일한 화면 위치였지만, 라이브 스크린샷으로 직접 보면서
	-- 유저가 3.8로 조금 더 올려 확정했다(유저 요청: "경험치바 아래로 다시" → 스크린샷 확인 → "3.8로하면 될듯").
	property Vector3 Card101BowPosition = Vector3(0, 3.8, -0.1)
