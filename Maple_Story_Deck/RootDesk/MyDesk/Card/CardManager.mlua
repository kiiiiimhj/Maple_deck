				end
			end

			-- 아주르 엣지(Card188, 조합 스킬 — 무스펠하임 슬롯을 그대로 넘겨받고, 스틸 슬롯은 완전히
			-- 비운다. 더블 커터/브레이브 슬래시와 동일한 "액티브 2개 병합" 패턴, 슬롯 여유 불필요)
			if self.MuspelheimLevel >= 5 and self.StealLevel >= 5 and self.AzureEdgeLevel == 0 then
				table.insert(pool, { card = 188, type = "unlock" })
			elseif self.AzureEdgeLevel > 0 and self.AzureEdgeLevel < 3 then
				table.insert(pool, { card = 188, type = "azureedge_up" })
			end

			-- 메소 익스플로젼(Card177, 슬롯형 액티브 6호) — 미해금이면 슬롯 여유 있을 때만 해금
			if self.MesoExplosionLevel == 0 then
				if hasEmptySlot then table.insert(pool, { card = 177, type = "unlock" }) end
			elseif self.MesoExplosionLevel < 5 then
				table.insert(pool, { card = 177, type = "mesoexplosion_up" })
			end

			-- 메소 데토네이션(Card189, 조합 스킬 — 메소 익스플로젼 슬롯을 그대로 넘겨받는다). 카르마(182)
			-- +다크 사이트(184)+피지컬 트레이닝(183, 셋 다 슬롯 없는 패시브) 보유 필요(유저 지정 표).
			if self.MesoExplosionLevel >= 5 and self:IsCardUnlocked(182) and self:IsCardUnlocked(184) and self:IsCardUnlocked(183) and self.MesoDetonationLevel == 0 then
				table.insert(pool, { card = 189, type = "unlock" })
			elseif self.MesoDetonationLevel > 0 and self.MesoDetonationLevel < 3 then
				table.insert(pool, { card = 189, type = "mesodetonation_up" })
			end

			-- 쉐도우 파트너(Card178, 슬롯형 액티브 7호) — 미해금이면 슬롯 여유 있을 때만 해금
			if self.ShadowPartnerLevel == 0 then
				if hasEmptySlot then table.insert(pool, { card = 178, type = "unlock" }) end
			elseif self.ShadowPartnerLevel < 5 then
				table.insert(pool, { card = 178, type = "shadowpartner_up" })
			end

			-- 듀얼 쉐도우 파트너(Card190, 조합 스킬 — 쉐도우 파트너 슬롯을 그대로 넘겨받는다). 다크
			-- 사이트(184)+크리티컬 엣지(181, 둘 다 슬롯 없는 패시브) 보유 필요(유저 지정 표).
			if self.ShadowPartnerLevel >= 5 and self:IsCardUnlocked(184) and self:IsCardUnlocked(181) and self.DualShadowPartnerLevel == 0 then
				table.insert(pool, { card = 190, type = "unlock" })
			elseif self.DualShadowPartnerLevel > 0 and self.DualShadowPartnerLevel < 3 then
				table.insert(pool, { card = 190, type = "dualshadowpartner_up" })
			end

			-- 다크 플레어(Card179, 슬롯형 액티브 8호) — 미해금이면 슬롯 여유 있을 때만 해금
			if self.DarkFlareLevel == 0 then
				if hasEmptySlot then table.insert(pool, { card = 179, type = "unlock" }) end
			elseif self.DarkFlareLevel < 5 then
				table.insert(pool, { card = 179, type = "darkflare_up" })
			end

			-- 어비설 플레어(Card191, 조합 스킬 — 다크 플레어 슬롯을 그대로 넘겨받는다). 대거 액셀레이션
			-- (180)+피지컬 트레이닝(183, 둘 다 슬롯 없는 패시브) 보유 필요(유저 지정 표).
			if self.DarkFlareLevel >= 5 and self:IsCardUnlocked(180) and self:IsCardUnlocked(183) and self.AbyssalFlareLevel == 0 then
				table.insert(pool, { card = 191, type = "unlock" })
			elseif self.AbyssalFlareLevel > 0 and self.AbyssalFlareLevel < 3 then
				table.insert(pool, { card = 191, type = "abyssalflare_up" })
			end

			-- 대거 액셀레이션(Card180, 패시브 — 슬롯 없이 레벨만 증가)
			if self.DaggerAccelLevel == 0 then
				table.insert(pool, { card = 180, type = "unlock" })
			elseif self.DaggerAccelLevel < 5 then
				table.insert(pool, { card = 180, type = "daggeraccel_up" })
			end

			-- 크리티컬 엣지(Card181, 패시브 — 슬롯 없이 레벨만 증가)
			if self.CriticalEdgeLevel == 0 then
				table.insert(pool, { card = 181, type = "unlock" })
			elseif self.CriticalEdgeLevel < 5 then
				table.insert(pool, { card = 181, type = "criticaledge_up" })
			end

			-- 카르마(Card182, 패시브 — 슬롯 없이 레벨만 증가)
			if self.KarmaLevel == 0 then
				table.insert(pool, { card = 182, type = "unlock" })
			elseif self.KarmaLevel < 5 then
				table.insert(pool, { card = 182, type = "karma_up" })
			end

			-- 피지컬 트레이닝(Card183, 패시브 — 슬롯 없이 레벨만 증가)
			if self.PhysicalTrainingLevel == 0 then
				table.insert(pool, { card = 183, type = "unlock" })
			elseif self.PhysicalTrainingLevel < 5 then
				table.insert(pool, { card = 183, type = "physicaltraining_up" })
			end

			-- 다크 사이트(Card184, 패시브 — 슬롯 없이 레벨만 증가)
			if self.DarkSightLevel == 0 then
				table.insert(pool, { card = 184, type = "unlock" })
			elseif self.DarkSightLevel < 5 then
				table.insert(pool, { card = 184, type = "darksight_up" })
			end
		end

		-- Fisher-Yates 셔플
		for i = #pool, 2, -1 do
			local j = _UtilLogic:RandomIntegerRange(1, i)
			pool[i], pool[j] = pool[j], pool[i]
		end

		-- 카드 중복 없이 3개 선택 (같은 카드의 dmg+cd 동시 등장 방지)
		local chosen = {}
		local usedCards = {}
		for _, entry in ipairs(pool) do
			if not usedCards[entry.card] then
				usedCards[entry.card] = true
				table.insert(chosen, entry)
				if #chosen == 3 then break end
			end
		end

		-- 풀이 3개 미만이면 상시 기본공격(파이어샷/애로우샷/레이온 기본공격) 강화로 패딩 — 다른 모든
		-- 카드가 업그레이드할 게 없을 때 진입하는 유일한 경로. 5회 이후로는 쿨타임 선택지가 없으므로
		-- (영구 고정) 데미지만 나온다. 실피드/레이온은 아르카나 파이어샷이 아예 안 틱되므로 각자의
		-- 기본공격(카드25/150)으로 패딩해야 한다 — 안 그러면 다른 카드를 다 채운 뒤엔 아무 효과 없는
		-- 선택지만 계속 뜨게 된다.
		local basicCard = 1
		if _GameManager.SelectedCharacter == 1 then basicCard = 25
		elseif _GameManager.SelectedCharacter == 2 then basicCard = 150
		elseif _GameManager.SelectedCharacter == 3 then basicCard = 172 end
		local basicUpgradeCount = self.Card1UpgradeCount
		local basicMultiplierCap = self.Card1MultiplierCap
		if basicCard == 25 then
			basicUpgradeCount = self.ArrowShotUpgradeCount
			basicMultiplierCap = self.ArrowShotMultiplierCap
		elseif basicCard == 150 then
			basicUpgradeCount = self.LeionAttackUpgradeCount
			basicMultiplierCap = self.LeionAttackMultiplierCap
		elseif basicCard == 172 then
			basicUpgradeCount = self.ShadeAttackUpgradeCount
			basicMultiplierCap = self.ShadeAttackMultiplierCap
		end
		while #chosen < 3 do
			local basicType = "dmg"
			if basicUpgradeCount < basicMultiplierCap and _UtilLogic:RandomDouble() < 0.5 then
				basicType = "cd"
			end
			table.insert(chosen, { card = basicCard, type = basicType })
		end

		self._choiceCard1 = chosen[1].card ; self._choiceType1 = chosen[1].type
		self._choiceCard2 = chosen[2].card ; self._choiceType2 = chosen[2].type
		self._choiceCard3 = chosen[3].card ; self._choiceType3 = chosen[3].type

		self:ShowLevelUpChoices(
			self._choiceCard1, self._choiceType1,
			self._choiceCard2, self._choiceType2,
			self._choiceCard3, self._choiceType3)
	end

	-- 카드 6~12(레벨업 선택지 3장)의 짧은 효과 태그 — "광역,스턴" 스타일로 한 줄에 훑어볼 수 있게
	method string GetChoiceEffectTag(integer cardIdx)
		if cardIdx == 6 then return "지속회복"
		elseif cardIdx == 1 then return "기본공격"
		elseif cardIdx == 25 then return "기본공격"
		elseif cardIdx == 150 then return "기본공격"
		elseif cardIdx == 172 then return "기본공격"
		elseif cardIdx == 2 then return "다단타격"
		elseif cardIdx == 3 then return "관통,둔화"
		elseif cardIdx == 4 then return "관통,스턴"
		elseif cardIdx == 5 then return "광역,화상"
		elseif cardIdx == 7 then return "쿨감버프"
		elseif cardIdx == 8 then return "크리티컬버프"
		elseif cardIdx == 9 then return "관통,연쇄"
		elseif cardIdx == 10 then return "빙결,연쇄"
		elseif cardIdx == 11 then return "광역,출혈"
		elseif cardIdx == 12 then return "고정,광역"
		elseif cardIdx == 13 then return "광역,넉백"
		elseif cardIdx == 14 then return "다중,속박"
		elseif cardIdx == 15 then return "다중,빙결"
		elseif cardIdx == 16 then return "광역,스턴,3연타"
		elseif cardIdx == 17 then return "다중,슬로우,빙결"
		elseif cardIdx == 18 then return "패시브,피해감소"
		elseif cardIdx == 19 then return "연쇄,치명타"
		elseif cardIdx == 20 then return "광역,관통,출혈,넉백"
		elseif cardIdx == 21 then return "고정,광역,확률2연타"
		elseif cardIdx == 22 then return "패시브,피해증가"
		elseif cardIdx == 23 then return "다중,빙결,범위"
		elseif cardIdx == 24 then return "다중,속박,추가타"
		elseif cardIdx == 101 then return "다중,관통"
		elseif cardIdx == 102 then return "단일,확률강화"
		elseif cardIdx == 103 then return "광역,다중,슬로우"
		elseif cardIdx == 104 then return "광역,다중,슬로우대상추가딜"
		elseif cardIdx == 105 then return "소환,광역,지속딜,슬로우대상추가딜"
		elseif cardIdx == 106 then return "횡,관통,다중"
		elseif cardIdx == 107 then return "종,범위,다중"
		elseif cardIdx == 118 then return "횡,관통,크리티컬"
		elseif cardIdx == 119 then return "종,범위,크리티컬"
		elseif cardIdx == 120 then return "넉백,충돌,폭발"
		elseif cardIdx == 108 then return "단일,넉백"
		elseif cardIdx == 114 then return "광역,다중,슬로우,스턴,추가딜"
		elseif cardIdx == 115 then return "소환,광역,2단히트,크리티컬"
		elseif cardIdx == 116 then return "다중,연타,확률추가타"
		elseif cardIdx == 117 then return "단일,연사,확률강화,3연타"
		elseif cardIdx == 109 then return "패시브,쿨감"
		elseif cardIdx == 110 then return "패시브,크리티컬"
		elseif cardIdx == 111 then return "패시브,크리티컬대미지"
		elseif cardIdx == 112 then return "패시브,확률추가공격"
		elseif cardIdx == 113 then return "패시브,피해증가"
		elseif _CardRegistry:HasCard(cardIdx) then return _CardRegistry:GetTags(cardIdx)
		end
		return ""
	end

	method string GetPotionIconRUID(integer level)
		if level == 2 then return self.Potion2RUID
		elseif level == 3 then return self.Potion3RUID
		elseif level == 4 then return self.Potion4RUID
		elseif level == 5 then return self.Potion5RUID
		end
		return self.Potion1RUID
	end

	-- 선택 카드 1장을 슬롯 1~5와 동일한 형태(아이콘+Lv+이름+짧은 효과 태그)로 채운다.
	-- "XXXX 해금!" 같은 문장형 타이틀은 더 이상 안 쓰고, level엔 "Lv{n}"만 짧게 표기한다
	method void SetChoiceCardText(SpriteGUIRendererComponent icon, TextComponent title, TextComponent name, TextComponent desc, integer cardIdx, string upgradeType)
		desc.Text = self:GetChoiceEffectTag(cardIdx)
		-- 이 icon UI 요소는 카드마다 재사용되므로, 회전이 필요한 카드(GetCardIconRotation)가 아니면
		-- 매번 0으로 되돌려야 이전에 표시했던 카드의 회전이 남지 않는다.
		icon.Entity.UITransformComponent.UIRotation = Vector3(0, 0, self:GetCardIconRotation(cardIdx))

		if cardIdx == 6 then
			local potionNames = {"빨간 포션", "하얀 포션", "장어구이", "쭈쭈바", "엘릭서"}
			local nextLevel = math.min(self.PotionLevel + 1, 5)
			icon.ImageRUID = self:GetPotionIconRUID(nextLevel)
			title.Text = "Lv" .. nextLevel
			name.Text  = potionNames[nextLevel]
			return
		end

		if cardIdx == 7 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.MagicBoosterLevel + 1)
			icon.ImageRUID = self.Card7IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card7Name
			return
		end

		if cardIdx == 8 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.MagicCriticalLevel + 1)
			icon.ImageRUID = self.Card8IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card8Name
			return
		end

		if cardIdx == 9 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.EnergyBoltLevel + 1)
			icon.ImageRUID = self.Card9IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card9Name
			return
		end

		if cardIdx == 10 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.FreezingEffectLevel + 1)
			icon.ImageRUID = self.Card10IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card10Name
			return
		end

		if cardIdx == 18 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.MagicArmorLevel + 1)
			icon.ImageRUID = self.Card18IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card18Name
			return
		end

		if cardIdx == 22 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.MeditationLevel + 1)
			icon.ImageRUID = self.Card22IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card22Name
			return
		end

		if cardIdx == 23 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.HailBurstLevel + 1)
			icon.ImageRUID = self.Card23IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card23Name
			return
		end

		if cardIdx == 24 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.AquaSurgeLevel + 1)
			icon.ImageRUID = self.Card24IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card24Name
			return
		end

		if cardIdx == 11 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.IceCutterLevel + 1)
			icon.ImageRUID = self.Card11IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card11Name
			return
		end

		if cardIdx == 12 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.KingPepeLevel + 1)
			icon.ImageRUID = self.Card12IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card12Name
			return
		end

		if cardIdx == 13 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.ThunderCutterLevel + 1)
			icon.ImageRUID = self.Card13IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card13Name
			return
		end

		if cardIdx == 14 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.AquaTrapLevel + 1)
			icon.ImageRUID = self.Card14IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card14Name
			return
		end

		if cardIdx == 15 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.HailStoneLevel + 1)
			icon.ImageRUID = self.Card15IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card15Name
			return
		end

		if cardIdx == 16 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.ThunderStormLevel + 1)
			icon.ImageRUID = self.Card16IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card16Name
			return
		end

		if cardIdx == 17 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.IceStrikeLevel + 1)
			icon.ImageRUID = self.Card17IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card17Name
			return
		end

		if cardIdx == 19 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.ChainLightningLevel + 1)
			icon.ImageRUID = self.Card19IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card19Name
			return
		end

		if cardIdx == 20 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.DoubleCutterLevel + 1)
			icon.ImageRUID = self.Card20IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card20Name
			return
		end

		if cardIdx == 21 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.GrandPepeLevel + 1)
			icon.ImageRUID = self.Card21IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card21Name
			return
		end

		if cardIdx == 4 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.ThunderBoltLevel + 1)
			icon.ImageRUID = self.Card4IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card4Name
			return
		end

		if cardIdx == 3 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.ColdBeamLevel + 1)
			icon.ImageRUID = self.Card3IconRUID
			title.Text = "Lv" .. nextLevel
			name.Text  = self.Card3Name
			return
		end

		if cardIdx == 25 then
			icon.ImageRUID = self.ArrowShotIconRUID
			title.Text = "Lv1"
			name.Text  = self.ArrowShotName
			return
		end

		if cardIdx == 150 then
			icon.ImageRUID = self.LeionAttackIconRUID
			title.Text = "Lv1"
			name.Text  = self.LeionAttackName
			return
		end

		if cardIdx == 172 then
			icon.ImageRUID = self.ShadeAttackIconRUID
			title.Text = "Lv1"
			name.Text  = self.ShadeAttackName
			return
		end

		if cardIdx == 151 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.ComboAttackLevel + 1)
			icon.ImageRUID = _CardRegistry:GetIcon(151)
			title.Text = "Lv" .. nextLevel
			name.Text  = _CardRegistry:GetName(151)
			return
		end

		if cardIdx == 152 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.SlashLevel + 1)
			icon.ImageRUID = _CardRegistry:GetIcon(152)
			title.Text = "Lv" .. nextLevel
			name.Text  = _CardRegistry:GetName(152)
			return
		end

		if cardIdx == 153 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.BrandishLevel + 1)
			icon.ImageRUID = _CardRegistry:GetIcon(153)
			title.Text = "Lv" .. nextLevel
			name.Text  = _CardRegistry:GetName(153)
			return
		end

		if cardIdx == 154 then
			local nextLevel = (upgradeType == "unlock") and 1 or (self.FlashSlashLevel + 1)
			icon.ImageRUID = _CardRegistry:GetIcon(154)
			title.Text = "Lv" .. nextLevel
			name.Text  = _CardRegistry:GetName(154)
			return
		end

		if cardIdx == 155 then
