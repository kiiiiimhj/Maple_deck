	property number _expandedY = 0

	-- 로비 우측 아이콘(TitleGroup/RaidButton)
	property Entity lobbyButton = "cd6375e8-cc7d-43ae-bb10-6f90f9d5f465"

	property Entity lobbyRedDot = "b40718ab-031a-43dd-89f1-3fbb0bdebfbf"

	property ButtonComponent lobbyButtonComp = "cd6375e8-cc7d-43ae-bb10-6f90f9d5f465"

	property number HpBarWidth = 886

	-- 레이드 관전 줌(100 = 기본). 낮출수록 넓게 보인다 — 액자 안에 보스+캐릭터가 다 들어오게.
	-- 이 값은 **PC 기준**이다. 모바일은 Open()에서 화면비 배율을 곱한 뒤 실측으로 재보정한다.
	property number RaidZoomPercent = 70

	-- 실측 보정을 거는 주기/횟수. 한 번만 재면 안 된다 — 레이드 입장은 **맵 전환 + 줌 트윈**이 겹쳐서
	-- 카메라가 언제 자리를 잡는지 일정하지 않다(2026-09-21 실측: 0.45초 뒤에 쟀더니 아직 로비 줌이라
	-- 가로 11.09가 잡혀 범위 가드에 걸려 보정이 통째로 건너뛰어졌다). 잠깐 동안 여러 번 확인한다.
	-- FitCameraForZoom은 이미 맞으면 아무것도 안 하므로(허용 오차 가드) 반복 호출이 안전하다.
	property number RaidCameraFitDelay = 0.45
	property number RaidCameraFitInterval = 0.35
	property integer RaidCameraFitTries = 8
	property integer _raidFitTimerId = 0
	property integer _raidFitLeft = 0

	-- 관전 카메라 오프셋(월드 유닛). x를 음수로 두면 화면이 왼쪽으로 밀려 보스가 가운데로 오고,
	-- y를 음수로 두면 카메라가 내려가 바닥 타일이 더 보인다.
	property Vector2 RaidCameraOffset = Vector2(-0.2, -1.0)

	-- 자쿰(Raid_2)은 맵 바닥이 얕아 발록 값(-1.0)을 쓰면 액자 아래로 맵 바깥 빈 띠가 보였다(유저 지적 2026-09-23)
	property Vector2 RaidCameraOffsetZakum = Vector2(-0.2, -0.3)

	property table GradeColors = {
		"#9aa0a6", "#9aa0a6", "#6fcf97", "#56ccf2", "#9b8cff", "#ffb340", "#ff5d5d",
	}

	-- HUD 갱신 주기(초). 0이면 매 프레임 — 레이드 화면은 보스 체력/남은시간/DPS창이 전부 느리게
	-- 변하는 값이라 매 프레임 다시 쓸 이유가 없다. Refresh() 한 번에 UI 쓰기가 20~30개라
	-- 60fps면 초당 1500회가 넘는다(유저 리포트 2026-09-22 "레이드 들어가면 렉이 너무 심해").
	property number RefreshInterval = 0.1
	property number _refreshTimer = 0

	-- 성능 계측용 — true면 2초마다 평균 fps를 로그로 찍는다. 배포 시 false.
	property boolean DebugFps = false
	property number _fpsAccum = 0
	property integer _fpsFrames = 0
	property number _fpsWorst = 0
	property integer _fpsHitches = 0

	-- 로비 전투 탭에 있는 동안만 레이드 아이콘을 보여준다(스킬/랭킹/유물/상점 탭에서는 숨긴다).
	-- TitleUI.ShowPanelOnly가 SetLobbyTabVisible로 바꿔준다 — 인벤토리/출석/업적 버튼과 같은 규칙.
	property boolean _lobbyTabVisible = true

	-- 레이드에 들어가기 전 있던 자리(나가기로 그대로 돌아간다)
	property boolean _open = false
	property string _returnMap = ""
	property Vector3 _returnPos = Vector3(0, 0, 0)

	-- 입장 대기(텔레포트가 끝나 Raid_1에 도착할 때까지 로비 화면을 그대로 둔다).
	-- 예전엔 요청 즉시 로비를 숨겨서, 이동이 끝나기 전까지 뒤에 있던 map1이 액자 안에 잠깐 보였다
	-- (유저 리포트 2026-09-22 "맵1이 뜨다가 레이드1로 변환된다").
	property number EnterPollInterval = 0.05
	property number EnterTimeout = 6.0
	property boolean _entering = false
	property number _enterWaited = 0
	property integer _enterTimerId = 0

	-- 도착 후 공개 전 준비(유저 리포트 2026-09-22 "레이드 전체 화면이 나왔다가 배경이 나온다",
	-- "들어가면 화면이 팝업에서 움직이는데 너무 렉 걸린다"):
	--   · 액자/배경 이미지를 처음 쓸 때 로딩돼서 맵만 먼저 보였다 → 시작 시 미리 불러 둔다(PreloadAsync)
	--   · 순간이동 뒤 카메라가 예전 자리에서 Damping으로 미끄러져 오고 줌 트윈(0.3초)까지 겹쳐 액자 안에서
	--     화면이 움직였다 → 로비가 가리고 있는 동안 Damping을 거의 0으로 낮추고 줌을 즉시 적용한 뒤
	--     RaidRevealDelay만큼 자리 잡을 시간을 주고 나서 공개한다
	property number RaidRevealDelay = 0.2
	property integer RaidCameraStableTicks = 3
	-- 2026-09-23 유저 리포트(모바일, 간헐): "레이드 들어가면 가끔 발록 대가리 쪽에 포커스 / 줌이 조금씩 왔다 갔다".
	--   · 느린 폰에서는 0.05초 타이머가 **같은 프레임 안에서** 여러 번 돌아 화면 모서리 값이 그대로라 "멈췄다"로
	--     착각했다 → 새 프레임이 그려졌을 때만 센다(_frameNo). 카메라가 따라가는 플레이어 위치도 같이 멈춰야 한다.
	--   · 1.5초 상한이 느린 폰엔 짧아 카메라가 오기 전에 공개됐다 → 3초
	--   · 공개 **뒤에** 모바일 줌 보정이 0.35초마다 8번 돌면서 줌 변화 도중에 재서 과보정↔되돌림이 보였다 →
	--     보정은 로딩이 가리는 동안 끝내고(보정 → 다시 멈춤 확인 → 공개), 공개 뒤에는 줌을 건드리지 않는다
	property number RaidCameraSettleMax = 3.0
	property integer _frameNo = 0
	property number _preRaidZoom = 0
	-- 닫을 때 로비를 먼저 켜고 레이드 팝업을 끄기까지의 간격(초) — 로비가 다 그려질 시간
	property number CloseSwapDelay = 0.1
	property integer _closeSeq = 0
	property number RaidPreloadWaitMax = 2.0
	property boolean _uiPreloaded = false
	property boolean _revealing = false
	property Vector2 _savedDamping = Vector2(2.5, 5.0)
	property boolean _dampingSaved = false
	-- Open에서 입장 로딩 화면(LoadingUI.CoverNow)으로 액자 안쪽을 덮었는지 — 공개/닫기/실패 때 걷는다
	property boolean _loadingCovered = false

