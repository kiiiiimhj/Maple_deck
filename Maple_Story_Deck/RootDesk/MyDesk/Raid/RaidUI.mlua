	property TextGUIRendererComponent rewardRingGrade = "f41488f1-3145-4f48-b7eb-90e6050842e6"
	property TextGUIRendererComponent rewardScrollCount = "ccf820a5-9e54-43b6-94c3-e731e5980739"
	property TextGUIRendererComponent rewardDiaCount = "4dae7cec-2f12-4a31-8463-2317293f99b9"
	property TextGUIRendererComponent rewardNextText = "dbe31833-8172-44db-b16a-36de415205f3"
	property ButtonComponent btnRewardBox = "94aafe14-3280-4fdd-8629-11164c93c6f6"

	-- 등급표 팝업(F~S 전 구간). 품질 확률은 유저 지정으로 넣지 않는다
	property Entity rewardTableDim = "42e65425-8908-4656-bd20-389e415420af"
	property Entity rewardTable = "61292bcc-8218-4ca6-89ef-e379e218e69e"
	property ButtonComponent btnRewardTableClose = "1a22fe10-3484-42dc-9add-430a10b2663f"
	-- 탭 투 스킵(유저 지정 2026-09-23) — 딤이든 표 본체든 아무 데나 누르면 닫힌다
	property ButtonComponent btnRewardTableDim = "42e65425-8908-4656-bd20-389e415420af"
	property ButtonComponent btnRewardTablePanel = "61292bcc-8218-4ca6-89ef-e379e218e69e"

	-- 구석 버튼은 받을 게 있으면 "보상 받기", 없으면 "보상 목록"으로 쓴다(유저 지정 2026-09-23).
	-- 예전엔 받을 게 없으면 버튼 자체를 숨겨서 등급표로 들어갈 입구가 없었다
	property TextGUIRendererComponent claimLabel = "4c103edf-5f3a-48cf-9279-375283d5b37c"

	@ExecSpace("ClientOnly")
	method void PreloadRaidImages()
		-- 레이드 화면(RaidGroup) 안의 모든 이미지를 미리 불러 둔다 — 첫 입장 때 액자가 늦게 뜨는 것 방지
		if not isvalid(self.raidGroup) then
			self._uiPreloaded = true
			return
		end
		local ruids = {}
		-- 엔진 기본 흰 스프라이트(빌더 기본 패널 / 딤·단색 사각형)는 미리 불러오면 [LEA-3015] CannotLoad 에러를 찍는다.
		-- 렌더는 원래 정상이지만 기기에선 에러 때문에 로그 콘솔이 튀어나와서 목록에서 뺀다(2026-09-23 유저 리포트)
		local seen = {
			["2860136c06ab075439721c027de365af"] = true,
			["4fea64a3307cda641809ad8be0d4890b"] = true,
		}
		local stack = { self.raidGroup }
		while #stack > 0 do
			local e = table.remove(stack)
			local sp = e.SpriteGUIRendererComponent
			if sp ~= nil and sp.ImageRUID ~= nil then
				local id = sp.ImageRUID.DataId
				if id ~= nil and id ~= "" and not seen[id] then
					seen[id] = true
					table.insert(ruids, id)
				end
			end
			for _, c in ipairs(e.Children) do table.insert(stack, c) end
		end
		-- 레이드 입장 로딩 그림도 같이(처음 누를 때 로딩 배경이 늦게 뜨지 않게)
		for _, loadingRuid in ipairs({ self.RaidLoadingImageRUID, self.ZakumLoadingImageRUID }) do
			if loadingRuid ~= "" and not seen[loadingRuid] then
				seen[loadingRuid] = true
				table.insert(ruids, loadingRuid)
			end
		end
		if #ruids == 0 then
			self._uiPreloaded = true
			return
		end
		_ResourceService:PreloadAsync(ruids, function()
			if not isvalid(self) then return end
			log("RaidUI: raid images preloaded (" .. tostring(#ruids) .. ")")
			self:WarmupRaidGroup()
		end)
	end

	-- 예열 시간(초) — 미리 불러와도 큰 이미지(액자·배경)는 **처음 화면에 그릴 때** 한 번 더 걸려서
	-- 첫 입장에만 액자 없이 맵이 먼저 보였다(두 번째부터는 즉시 — 실측). 부팅 로딩 화면이 떠 있는 동안
	-- RaidGroup을 거의 투명(0.01)·터치 통과로 잠깐 켜서 한 번 그려 둔다.
	property number RaidWarmupSeconds = 1.0

	@ExecSpace("ClientOnly")
	method void WarmupRaidGroup()
		-- RaidGroup을 안 보이게 한 번 그려서 이미지를 화면용으로 올려 둔다
		if not isvalid(self.raidGroup) or self._open then
			self._uiPreloaded = true
			return
		end
		local cg = self.raidGroup.CanvasGroupComponent
		if cg == nil then
			self._uiPreloaded = true
			return
		end
		cg.GroupAlpha = 0.01
		cg.BlocksRaycasts = false
		cg.Interactable = false
		self.raidGroup.Enable = true
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			self:EndRaidWarmup()
			log("RaidUI: raid group warmed up")
		end, self.RaidWarmupSeconds)
	end

	@ExecSpace("ClientOnly")
	method void EndRaidWarmup()
		-- 예열 상태를 원래대로(불투명·터치 가능) 되돌린다. 입장 중이면 켜 둔 채로 둔다
		local cg = self.raidGroup.CanvasGroupComponent
		if cg ~= nil then
			cg.GroupAlpha = 1
			cg.BlocksRaycasts = true
			cg.Interactable = true
		end
		if not self._open or self._revealing then self.raidGroup.Enable = false end
		self._uiPreloaded = true
		self:ScheduleLoadingImageWarmup()
	end

	@ExecSpace("ClientOnly")
	method void ScheduleLoadingImageWarmup()
		-- 레이드 로딩 그림도 한 번 그려 둔다 — 부팅 로딩 화면이 걷혀 LoadingUI가 쉴 때까지 기다렸다가(최대 15초)
		local tries = 0
		local timerId = 0
		timerId = _TimerService:SetTimerRepeat(function()
			tries = tries + 1
			if not isvalid(self) or tries > 30 then
				_TimerService:ClearTimer(timerId)
				return
			end
			if self._open or self._entering then return end
			if not _LoadingUI:IsIdle() then return end
			_TimerService:ClearTimer(timerId)
			_LoadingUI:WarmImage(self:GetLoadingImageRUID(), 1.0)
		end, 0.5)
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		if isvalid(self.raidGroup) then self.raidGroup.Enable = false end
		self:PreloadRaidImages()
		if isvalid(self.btnClose) then
			self.btnClose.Entity:ConnectEvent(ButtonClickEvent, function() self:Close() end)
		end
		if isvalid(self.btnClaim) then
			self.btnClaim.Entity:ConnectEvent(ButtonClickEvent, function() self:OnClaimClicked() end)
		end
		if isvalid(self.lobbyButtonComp) then
			self.lobbyButtonComp.Entity:ConnectEvent(ButtonClickEvent, function()
				-- 2026-09-21 모바일 실기 리포트("아이콘이 안 눌린다") 진단용 — 이 로그가 없으면
				-- 탭이 버튼까지 오지도 못한 것(딤/네이티브 UI가 먹음), 있으면 그 뒤 처리 문제다
				log("RaidUI: lobby raid icon clicked")
				-- 아직 레이드 튜토리얼을 안 본 유저는 입장 대신 4단계 이미지 안내부터 본다
				-- (RaidTutorialUI가 true를 돌려주면 자기가 처리했다는 뜻 — 여기서 멈춘다)
				if _RaidTutorialUI:TryHandleLobbyClick() then return end
				self:Open()
			end)
		end
		if isvalid(self.dpsToggleBtn) then
			self.dpsToggleBtn.Entity:ConnectEvent(ButtonClickEvent, function() self:ToggleDpsWindow() end)
		end
		if isvalid(self.btnTutorial) then
			self.btnTutorial.Entity:ConnectEvent(ButtonClickEvent, function()
				-- 로딩 중(아직 전투가 안 보일 때)에는 무시 — 공개 뒤에만 연다
				if not self._open or self._revealing or self._loadingCovered then return end
				_RaidTutorialUI:OpenFromRaid()
			end)
		end
		if isvalid(self.btnRevive) then
			self.btnRevive.Entity:ConnectEvent(ButtonClickEvent, function() self:OnReviveClicked() end)
		end
		if isvalid(self.btnClaimPending) then
			self.btnClaimPending.Entity:ConnectEvent(ButtonClickEvent, function() self:OnClaimClicked() end)
		end
		if isvalid(self.btnRewardBox) then
			self.btnRewardBox.Entity:ConnectEvent(ButtonClickEvent, function() self:OpenRewardTable() end)
		end
		if isvalid(self.btnRewardTableClose) then
			self.btnRewardTableClose.Entity:ConnectEvent(ButtonClickEvent, function() self:CloseRewardTable() end)
		end
		-- 탭 투 스킵 — 딤이든 표 본체든 아무 데나 누르면 닫힌다(유저 지정 2026-09-23)
		if isvalid(self.btnRewardTableDim) then
			self.btnRewardTableDim.Entity:ConnectEvent(ButtonClickEvent, function() self:CloseRewardTable() end)
		end
		if isvalid(self.btnRewardTablePanel) then
			self.btnRewardTablePanel.Entity:ConnectEvent(ButtonClickEvent, function() self:CloseRewardTable() end)
		end
		if isvalid(self.revivePanel) then self.revivePanel.Enable = false end
		if isvalid(self.lockDim) then self.lockDim.Enable = false end
		if isvalid(self.lockPanel) then self.lockPanel.Enable = false end
		if isvalid(self.toastText) then self.toastText.Entity.Enable = false end
		self:CloseRewardTable()
		log("RaidUI started (rewardBox=" .. tostring(isvalid(self.rewardBox))
			.. " tapBtn=" .. tostring(isvalid(self.btnRewardBox))
			.. " table=" .. tostring(isvalid(self.rewardTable))
			.. " toast=" .. tostring(isvalid(self.toastText)) .. ")")
	end

	-- ── 입장 / 퇴장 ───────────────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void Open()
		-- 돌아올 자리를 기억해두고 레이드 맵으로 이동한다
		if self._open or self._entering then return end
		local player = _UserService.LocalPlayer
		local alreadyInRaid = false
		if isvalid(player) and isvalid(player.CurrentMap) then
			-- ⚠ 이미 레이드 맵에 있는 상태에서 다시 열면 복귀 지점이 Raid_1로 덮여 로비로 못 돌아간다 —
			--   레이드 맵일 때는 기억해 둔 복귀 지점을 그대로 유지한다.
			if player.CurrentMap.Name ~= _RaidLogic.RaidMapName then
				self._returnMap = player.CurrentMap.Name
				self._returnPos = player.TransformComponent.WorldPosition
			else
				alreadyInRaid = true
			end
		end
		_RaidLogic:RequestEnterRaid()
		if alreadyInRaid then
			self:ShowRaidView()
			return
		end
		-- 누르는 즉시 팝업(액자·HUD)을 띄운다(유저 지정 2026-09-22 "다른 팝업처럼 바로 떴으면",
		-- "가림막은 인게임 들어갈 때 쓰는 로딩으로"). RaidGroup(24)이 LoadingGroup(15)보다 위라서
		-- 액자 안쪽 창에는 입장 로딩 화면이 보이고, 그 뒤에서 이동·카메라 정리가 끝나면 로딩만 걷힌다
		_LoadingUI:CoverNowWithImageTitled(self:GetLoadingImageRUID())
		self._loadingCovered = true
		self:ShowRaidFrame()
		-- 로딩 그림 가운데를 액자 가운데(x≈-24)에 맞춘다 — 그림 속 문양이 액자 장식과 어긋나 보였다(2026-09-23 유저)
		if isvalid(self.raidGroup) then _LoadingUI:AlignContentTo(self.raidGroup:GetChildByName("Frame")) end
		self:SetLoadingHudHidden(true)
		self._entering = true
		self._enterWaited = 0
		self:StopEnterWait()
		self._enterTimerId = _TimerService:SetTimerRepeat(function() self:TickEnterWait() end, self.EnterPollInterval)
		log("RaidUI: waiting for raid map (return=" .. self._returnMap .. ")")
	end

	@ExecSpace("ClientOnly")
	method void TickEnterWait()
		-- 로컬 플레이어가 Raid_1에 들어왔는지 확인하고, 들어왔으면 레이드 화면으로 전환한다
		if not isvalid(self) or not self._entering then
			self:StopEnterWait()
			return
		end
		self._enterWaited = self._enterWaited + self.EnterPollInterval
		local player = _UserService.LocalPlayer
		if isvalid(player) and isvalid(player.CurrentMap) and player.CurrentMap.Name == _RaidLogic.RaidMapName then
			self:StopEnterWait()
			self._entering = false
			self:ShowRaidView()
			return
		end
		if self._enterWaited >= self.EnterTimeout then
			-- 이동이 끝내 안 됐다 — 로비로 되돌리고 포기한다(다시 누르면 재시도)
			self:StopEnterWait()
			self._entering = false
			if isvalid(self.raidGroup) then self.raidGroup.Enable = false end
			self:SetLobbyUIVisible(true)
			self:RevealLoadingIfCovered()
			log_warning("RaidUI: raid map not reached in " .. tostring(self.EnterTimeout) .. "s — stay in lobby")
		end
	end

	@ExecSpace("ClientOnly")
	method void StopEnterWait()
		-- 도착 확인 타이머 정리
		if self._enterTimerId ~= 0 then
			_TimerService:ClearTimer(self._enterTimerId)
			self._enterTimerId = 0
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowRaidView()
		-- Raid_1 도착 후: 로비가 아직 화면을 가리는 동안 관전 카메라를 먼저 자리 잡게 하고,
		-- 액자 이미지 로딩까지 끝나면 그때 로비를 감추고 액자 HUD를 한 번에 보여준다
		self._open = true
		self._revealing = true
		-- 들어올 때마다 캐릭터 자세(유령/서기)를 다시 건다
		self._heroPoseState = ""
		-- 에피2·3 카메라 Y 잠금/커스텀 경계가 남아 있으면 레이드 구도를 덮어쓴다 — 먼저 푼다
		_MapManager:ReleaseCameraLockForOverlay()
		self:SnapCamera(true)
		-- 줌은 트윈 없이 즉시(0초) — 트윈이 공개 뒤까지 이어지면 액자 안에서 화면이 움직여 보인다
		_CameraService:ZoomTo(self.RaidZoomPercent * _MobileScreenFitLogic:GetZoomMultiplier(), 0)
		local camOffset = self.RaidCameraOffset
		if _RaidLogic.RaidId == _RaidLogic.RaidZakum then camOffset = self.RaidCameraOffsetZakum end
		self:SetCameraOffset(camOffset)
		self:SetPlayerVisible(false)
		-- 고정 시간만 기다리면 카메라가 덜 멈춘 채 공개될 때가 있었다(실측: 첫 장면에 구도가 틀어짐).
		-- 화면 왼쪽 위 모서리가 가리키는 월드 좌표를 매 틱 재서, 연속 RaidCameraStableTicks번 거의 안 변하면
		-- (= 위치·줌 모두 멈춤) 공개한다. 최대 RaidCameraSettleMax초까지만 기다린다.
		local waited = 0
		local step = 0.05
		local timerId = 0
		local lastCorner = nil
		local lastPlayerPos = nil
		local lastFrame = -1
		local stableTicks = 0
		local fitted = false
		timerId = _TimerService:SetTimerRepeat(function()
			waited = waited + step
			if not isvalid(self) or not self._open then
				_TimerService:ClearTimer(timerId)
				return
			end
			-- 같은 프레임 안에서 여러 번 불리면 값이 안 바뀐 게 당연하다 — 새 프레임일 때만 판정한다
			if self._frameNo ~= lastFrame then
				lastFrame = self._frameNo
				local corner = _UILogic:ScreenToWorldPosition(Vector2(0, 0))
				local player = _UserService.LocalPlayer
				local playerPos = nil
				if isvalid(player) then playerPos = player.TransformComponent.WorldPosition end
				local cornerStill = lastCorner ~= nil and math.abs(corner.x - lastCorner.x) < 0.005 and math.abs(corner.y - lastCorner.y) < 0.005
				local playerStill = playerPos == nil or (lastPlayerPos ~= nil and math.abs(playerPos.x - lastPlayerPos.x) < 0.005 and math.abs(playerPos.y - lastPlayerPos.y) < 0.005)
				if cornerStill and playerStill then
					stableTicks = stableTicks + 1
				else
					stableTicks = 0
				end
				lastCorner = corner
				lastPlayerPos = playerPos
			end
			local settled = waited >= self.RaidRevealDelay and stableTicks >= self.RaidCameraStableTicks
			-- 모바일 줌 실측 보정은 가려진 동안 한 번 — 줌이 바뀌면 모서리 값이 움직여 멈춤 판정이 다시 시작된다
			if settled and not fitted then
				fitted = true
				_MobileScreenFitLogic:FitCameraForZoom(self.RaidZoomPercent)
				stableTicks = 0
				return
			end
			local cameraReady = (settled and fitted) or waited >= self.RaidCameraSettleMax
			local ready = cameraReady and (self._uiPreloaded or waited >= self.RaidPreloadWaitMax)
			if not ready then return end
			_TimerService:ClearTimer(timerId)
			log(string.format("RaidUI: reveal after %.2fs (cameraStable=%d fitted=%s preloaded=%s)", waited, stableTicks, tostring(fitted), tostring(self._uiPreloaded)))
			self:RevealRaidView()
		end, step)
	end

	@ExecSpace("ClientOnly")
	method void SnapCamera(boolean snap)
		-- true: 카메라 Damping을 거의 0으로 낮춰 플레이어(=레이드 입장 지점)에 즉시 붙인다 / false: 원래 값 복구
		local cam = _CameraService:GetCurrentCameraComponent()
		if cam == nil then return end
		if snap then
			if not self._dampingSaved then
				self._savedDamping = cam.Damping
				self._dampingSaved = true
			end
			cam.Damping = Vector2(0.001, 0.001)
		elseif self._dampingSaved then
			cam.Damping = self._savedDamping
			self._dampingSaved = false
		end
	end

	@ExecSpace("ClientOnly")
	method void RevealRaidView()
		-- 카메라가 자리를 잡은 뒤 실제로 레이드 화면을 공개한다
		self._revealing = false
		-- ⚠ 줌 값을 양쪽에 똑같이 주면 안 된다 — 모바일은 네이티브 시야가 PC보다 좁아서 같은 70이어도
		--   훨씬 확대돼 보이고, 키 큰 마왕 발록의 위아래가 잘린다(유저 리포트 2026-09-21
		--   "레이드 pc랑 모바일 버전 해상도가 달라서 보스잡는게 짤려보여"). ShowRaidView에서 화면비 배율을
		--   곱한 근삿값을 즉시 적용해 뒀고, 여기서 공개 직전에 실측으로 한 번 재보정한다(가려진 상태라 안 보임).
		--   PC는 FitCameraForZoom이 즉시 빠져나가므로 완전히 그대로다.
		--   ⚠ 실측 보정은 ShowRaidView의 대기 루프(가려진 동안)에서 끝낸다. 여기서/공개 뒤에 다시 보정하면
		--     화면이 보이는 상태에서 줌이 조금씩 왔다 갔다 한다(2026-09-23 모바일 리포트) — StartCameraFit은 더 안 쓴다.
		self:Refresh()
		local wasCovered = self._loadingCovered
		self:ShowRaidFrame()
		self:SnapCamera(false)
		if wasCovered then
			-- 로딩이 걷히는 동안에도 체력바·DPS가 로딩 그림 위에 떠 보였다 —
			-- 걷힘이 다 끝난 뒤에 HUD를 켠다(ShowRaidFrame의 Refresh가 켠 잠금/부활 패널도 그때까지 숨김)
			self:SetLoadingHudHidden(true)
			_TimerService:SetTimerOnce(function()
				if not isvalid(self) or not self._open then return end
				self:SetLoadingHudHidden(false)
				self:Refresh()
			end, _LoadingUI:GetLiftRevealSeconds())
		else
			self:SetLoadingHudHidden(false)
		end
		-- 액자 안쪽 창을 가리던 입장 로딩 화면을 걷는다(페이드) — 그 뒤로 이미 자리 잡은 전투가 보인다
		self:RevealLoadingIfCovered()
		log("RaidUI: entering raid (return=" .. self._returnMap .. ")")
	end

	@ExecSpace("ClientOnly")
	method void ShowRaidFrame()
		-- 레이드 팝업(액자·HUD)을 켜고 로비/인게임 HUD를 감춘다 — 여러 번 불러도 안전하다
		-- 예열(WarmupRaidGroup) 도중에 들어온 경우를 대비해 항상 불투명·터치 가능으로 되돌려 연다
		if not isvalid(self.raidGroup) then return end
		local cg = self.raidGroup.CanvasGroupComponent
		if cg ~= nil then
			cg.GroupAlpha = 1
			cg.BlocksRaycasts = true
			cg.Interactable = true
		end
		self:Refresh()
		self.raidGroup.Enable = true
		self:SetLobbyUIVisible(false)
	end

	@ExecSpace("ClientOnly")
	method void SetLoadingHudHidden(boolean hidden)
		-- 로딩 화면이 덮는 동안 체력바·DPS·등급 배지와 잠금/부활 패널을 숨긴다(공개 때 Refresh가 원래대로 켠다)
		if not isvalid(self.raidGroup) then return end
		for _, name in ipairs(self.LoadingHiddenHud) do
			local e = self.raidGroup:GetChildByName(name)
			if isvalid(e) then
				-- 꺼 둔 "이번 주 보상" 패널은 로딩이 걷혀도 다시 켜지 않는다
				if name == "RewardBox" and not self.ShowRewardBox then
					e.Enable = false
				else
					e.Enable = not hidden
				end
			end
		end
		if hidden then
			if isvalid(self.lockDim) then self.lockDim.Enable = false end
			if isvalid(self.lockPanel) then self.lockPanel.Enable = false end
			if isvalid(self.revivePanel) then self.revivePanel.Enable = false end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetRaidGroupVisible(boolean visible)
		-- 레이드 팝업 자체를 잠깐 숨기거나 되돌린다(레이드 안에서 이미지 튜토리얼을 띄울 때 — 로비 그룹보다 위라 가린다)
		if not isvalid(self.raidGroup) then return end
		if visible and not self._open then return end
		self.raidGroup.Enable = visible
	end

	@ExecSpace("ClientOnly")
	method void RevealLoadingIfCovered()
		-- Open에서 CoverNow로 덮어 둔 입장 로딩 화면을 걷는다(덮은 적 없으면 아무것도 안 한다)
		if not self._loadingCovered then return end
		self._loadingCovered = false
		-- 뽑기 덮개처럼 살짝 커졌다가 위로 올라가며 사라진다(2026-09-23 유저 지정)
		_LoadingUI:PlayRevealLift()
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 들어오기 전 맵/좌표로 복귀
		self:StopEnterWait()
		self._entering = false
		self._revealing = false
		self._open = false
		self:RevealLoadingIfCovered()
		self:SetLoadingHudHidden(false)
		-- 등급표를 열어둔 채 나가면 다음에 들어왔을 때 그대로 떠 있다
		self:CloseRewardTable()
		-- 보정 타이머가 남아 있으면 로비로 돌아간 뒤에도 레이드 구도로 줌을 끌어당긴다 — 먼저 끈다
		self:StopCameraFit()
		-- ⚠ 로비(TitleGroup)는 켜기가 한 박자 늦게 그려진다(끄기는 즉시) — 레이드 팝업을 같은 프레임에 끄면
		--   그 틈에 레이드 맵 월드가 줌이 바뀐 채 비쳐 "메인 화면이 움찔"했다(2026-09-24 유저 리포트).
		--   로비를 먼저 켜고, 레이드 팝업은 로비가 다 그려진 뒤에 끈다. 카메라 복구·맵 복귀도 그 뒤(로비가 가린 상태)에 한다.
		self:SetLobbyUIVisible(true)
		self._closeSeq = self._closeSeq + 1
		local seq = self._closeSeq
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or self._closeSeq ~= seq or self._open or self._entering then return end
			self:FinishClose()
		end, self.CloseSwapDelay)
		-- 레이드에서 받은 보상은 로비가 다 그려진 뒤에 배지·장비 버튼으로 날린다(유저 지정 2026-09-24)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or self._open or self._entering then return end
			self:FlyPendingClaim()
		end, self.ClaimFlyDelay)
		log("RaidUI: left raid")
	end

	@ExecSpace("ClientOnly")
	method void FinishClose()
		-- 로비가 화면을 다 덮은 뒤: 레이드 팝업을 끄고, 팝업이 실제로 사라진 다음에 카메라·맵을 되돌린다
		if isvalid(self.raidGroup) then self.raidGroup.Enable = false end
		-- ⚠ 팝업 끄기와 줌 복구를 같은 프레임에 하면 모바일에서 팝업이 한 박자 늦게 사라져, 액자 안 레이드 화면이
		--   로비 줌(약 2배 확대)으로 커졌다가 로비로 바뀌어 보였다(2026-09-24 유저 "화면이 커졌다 다시 원래 크기로").
		local seq = self._closeSeq
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or self._closeSeq ~= seq or self._open or self._entering then return end
			self:RestoreLobbyCamera()
		end, self.CloseSwapDelay)
	end

	@ExecSpace("ClientOnly")
	method void RestoreLobbyCamera()
		-- 레이드 팝업이 사라진 뒤(로비가 화면을 덮은 상태): 카메라를 로비 상태로 되돌리고 원래 맵으로 보낸다
		self:SnapCamera(false)
		-- 줌은 여기서 되돌리지 않는다(2026-09-24 유저 "메인화면 여전히 그러니 다 빼") — 로비는 월드를 가리므로
		-- 줌이 레이드 값으로 남아 있어도 안 보이고, 게임 시작 때 ResetCameraConfine이 기본 줌을 다시 건다
		self:SetCameraOffset(Vector2(0, 0))
		self:SetPlayerVisible(true)
		if self._returnMap ~= "" then
			_RaidLogic:RequestExitRaid(self._returnMap, self._returnPos)
		end
	end

	@ExecSpace("ClientOnly")
	method void StartCameraFit()
		-- 모바일에서 레이드 구도를 PC와 같게 맞추는 실측 보정을 잠깐 동안 반복해서 건다.
		-- 카메라가 자리를 잡기 전에 잰 값은 FitCameraForZoom이 범위 가드로 스스로 걸러낸다.
		self:StopCameraFit()
		self._raidFitLeft = self.RaidCameraFitTries
		self._raidFitTimerId = _TimerService:SetTimerRepeat(function()
			-- 레이드를 이미 닫았으면(빠르게 나갔다면) 로비 줌을 건드리지 않는다
			if not isvalid(self) or not self._open then
				self:StopCameraFit()
				return
			end
			self._raidFitLeft = self._raidFitLeft - 1
			_MobileScreenFitLogic:FitCameraForZoom(self.RaidZoomPercent)
			if self._raidFitLeft <= 0 then self:StopCameraFit() end
		end, self.RaidCameraFitInterval, self.RaidCameraFitDelay)
	end

	@ExecSpace("ClientOnly")
	method void StopCameraFit()
		-- 반복 보정 타이머를 정리한다(레이드를 나갈 때 반드시 불러야 로비 줌을 안 건드린다)
		if self._raidFitTimerId ~= 0 then
			_TimerService:ClearTimer(self._raidFitTimerId)
			self._raidFitTimerId = 0
		end
	end

	@ExecSpace("ClientOnly")
	method void SetCameraOffset(Vector2 offset)
		-- 레이드 화면 구도 맞추기 — 플레이어를 따라가는 기본 카메라를 그대로 쓰되 오프셋만 준다
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local cam = player.CameraComponent
		if cam == nil then return end
		cam.CameraOffset = offset
	end

	@ExecSpace("ClientOnly")
	method void SetPlayerVisible(boolean visible)
		-- 레이드는 관전 화면이라 내 캐릭터는 안 보이게 한다(카메라는 여전히 플레이어를 따라간다)
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local renderer = player.AvatarRendererComponent
		if renderer ~= nil then renderer.Enable = visible end
		local nameTag = player.NameTagComponent
		if nameTag ~= nil then nameTag.Enable = visible end
	end

	@ExecSpace("ClientOnly")
	method void SetLobbyUIVisible(boolean visible)
		-- 레이드 화면에서는 로비/인게임 HUD를 감춘다(액자 안쪽만 보이게)
		for _, name in ipairs({ "TitleGroup", "DefaultGroup" }) do
			local g = _EntityService:GetEntityByPath("/ui/" .. name)
			if isvalid(g) then g.Enable = visible end
		end
	end

	method boolean IsOpen()
		return self._open
	end

	-- ── HUD 갱신 ──────────────────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void Refresh()
		-- 보스 체력(남은 체력 = 1 - 피해율) / 등급 / 남은시간 / DPS창 / 받기 버튼
		local ratio = _RaidLogic:GetRatio()
		local gradeIdx = _RaidLogic:GetGradeIndex()
		if isvalid(self.hpFill) then
			local w = self.HpBarWidth * (1 - ratio)
			if w < 2 then w = 2 end
			self.hpFill.Entity.UITransformComponent.RectSize = Vector2(w, 36)
		end
		if isvalid(self.hpText) then
			self.hpText.Text = _LocalizationService:GetTextFormat("FMT_RAIDUI_001", string.format("%.1f", (1 - ratio) * 100))
		end
		if isvalid(self.gradeText) then
			self.gradeText.Text = _RaidLogic:GetGradeName(gradeIdx)
			self.gradeText.FontColor = self:HexColor(self.GradeColors[gradeIdx + 1])
		end
		if isvalid(self.hintText) then
			-- 시즌은 월~목 4일. 금~일은 정산 구간이라 남은시간 대신 상태를 보여준다
			if _RaidLogic:IsSeasonActive() then
				self.hintText.Text = self:FormatRemain(_RaidLogic:GetSeasonRemainSeconds())
			else
				self.hintText.Text = _LocalizationService:GetText("MLUA_RAIDUI_002")
			end
		end
		self:RefreshLock()
		self:RefreshRevive()
		self:RefreshDpsWindow()
		self:RefreshClaim()
		self:RefreshRewardBox()
	end

	@ExecSpace("ClientOnly")
	method void RefreshLock()
		-- 지난 시즌 미수령 보상이 남아 있으면 새 시즌이 아직 시작되지 않은 상태다 —
		-- 딤드를 깔고(전투는 RaidScene이 멈춘다) 중앙 창에서 보상을 받게 한다.
		local locked = _RaidLogic:HasPendingReward()
		if isvalid(self.lockDim) then self.lockDim.Enable = locked end
		if isvalid(self.lockPanel) then self.lockPanel.Enable = locked end
		-- 버튼 엔티티가 .ui에서 꺼진 채 저장돼 있어(2026-09-23 실측 entEnable=false) 창만 뜨고 버튼이 안 보였다 — 여기서 켠다
		if isvalid(self.btnClaimPending) and self.btnClaimPending.Entity.Enable ~= locked then
			self.btnClaimPending.Entity.Enable = locked
		end
		if locked and isvalid(self.lockGradeText) then
			local grade = _RaidLogic.PendingGrade
			self.lockGradeText.Text = _RaidLogic:GetGradeName(grade)
			self.lockGradeText.FontColor = self:HexColor(self.GradeColors[grade + 1])
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshRevive()
		-- 24시간 넘게 미접속이면 캐릭터들이 유령이 된다 — 화면 중앙에 "부활!" 창을 띄운다.
		-- 단 시즌 잠금(지난 시즌 미수령)이 걸려 있으면 그쪽이 우선이라 부활 창은 감춘다.
		if not isvalid(self.revivePanel) then return end
		self.revivePanel.Enable = _RaidLogic.IsGhost and not _RaidLogic:HasPendingReward()
		self:RefreshHeroPoses()
	end

	-- 유령 자세(유저 지정 2026-09-23 "진짜 메이플에서 죽으면 되는 유령" = Maker 아바타 "사망").
	-- 공식 문서 표: MapleAvatarBodyActionState.Dead = Core "dead" + Parts "stand1" + Loop
	-- (몸통만 유령, 머리·얼굴은 그대로). ⚠ 서버에서 AvatarBodyActionSelector.ActionState=Dead로 바꾸는 것만으로는
	-- 화면이 안 바뀌었다(실측) — 몸통 엔티티에 이벤트를 클라에서 직접 보내야 한다. Parts를 "dead"로 주면 머리가 사라진다.
	property number HeroPoseReapplySeconds = 2.0
	property string _heroPoseState = ""
	property number _heroPoseTimer = 0

	@ExecSpace("ClientOnly")
	method void RefreshHeroPoses()
		-- 유령이면 사망 자세를 주기적으로 다시 건다(늦게 켜진 캐릭터도 잡히게), 부활하면 한 번만 서기로 되돌린다
		local ghost = _RaidLogic.IsGhost == true
		local want = ghost and "dead" or "alive"
		local now = _UtilLogic.ElapsedSeconds
		if want == self._heroPoseState and (not ghost or now < self._heroPoseTimer) then return end
		self._heroPoseState = want
		self._heroPoseTimer = now + self.HeroPoseReapplySeconds
		local user = _UserService.LocalPlayer
		if not isvalid(user) then return end
		local map = user.CurrentMap
		if not isvalid(map) then return end
		for i = 0, 4 do
			local hero = map:GetChildByName("RaidHero" .. tostring(i))
			if isvalid(hero) and hero.Enable and hero.AvatarRendererComponent ~= nil then
				local body = hero.AvatarRendererComponent:GetBodyEntity()
				if isvalid(body) then
					local ev = ActionStateChangedEvent()
					if ghost then
						ev.CoreActionName = "dead"
						ev.PartsActionName = "stand1"
						ev.PlayType = SpriteAnimClipPlayType.Loop
					else
						-- 두손무기(레이온·쉐이드)는 stand2 — RaidScene.GetSwingAction의 무기 계열과 같다
						local stand = (i == 2 or i == 3) and "stand2" or "stand1"
						ev.CoreActionName = stand
						ev.PartsActionName = stand
						ev.PlayType = SpriteAnimClipPlayType.ZigzagLoop
					end
					ev.PlayRate = 1
					body:SendEvent(ev)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnReviveClicked()
		if not _RaidLogic.IsGhost then return end
		_RaidLogic:RequestRevive()
	end

	@ExecSpace("ClientOnly")
	method void ToggleDpsWindow()
		-- 누적 대미지 창 접기/펴기 — 접으면 제목 줄만 남기고 창 높이를 줄인다
		self._dpsCollapsed = not self._dpsCollapsed
		if isvalid(self.members) then
			local tr = self.members.UITransformComponent
			-- ⚠ 창은 중앙 기준이라 높이만 줄이면 위아래가 같이 좁아져 제목 줄이 아래로 내려간다 —
			--   줄어든 높이의 절반만큼 위로 올려서 "펼쳤을 때의 윗변"을 그대로 유지한다.
			if self._expandedY == 0 then self._expandedY = tr.anchoredPosition.y end
			local h = self._dpsCollapsed and self.DpsWindowCollapsedHeight or self.DpsWindowHeight
			tr.RectSize = Vector2(tr.RectSize.x, h)
			local topKeepY = self._expandedY + (self.DpsWindowHeight - h) / 2
			tr.anchoredPosition = Vector2(tr.anchoredPosition.x, topKeepY)
		end
		if isvalid(self.dpsArrow) then
			self.dpsArrow.Text = self._dpsCollapsed and "▶" or "▼"
		end
		self:RefreshDpsWindow()
	end

	@ExecSpace("ClientOnly")
	method void RefreshDpsWindow()
		-- 누적 대미지 내림차순, 기여 없는 줄은 숨김. 접혀 있으면 줄 자체를 감춘다
		if not isvalid(self.members) then return end
		if self._dpsCollapsed then
			for i = 0, 4 do
				local row = self.members:GetChildByName("Row" .. tostring(i))
				if isvalid(row) then row.Enable = false end
			end
			return
		end
		local rows = _RaidLogic:ParseCharDpsCsv()
		for i = 0, 4 do
			local row = self.members:GetChildByName("Row" .. tostring(i))
			if isvalid(row) then
				local data = rows[i + 1]
				if data == nil then
					row.Enable = false
				else
					row.Enable = true
					local icon = row:GetChildByName("Icon")
					if isvalid(icon) then
						icon.SpriteGUIRendererComponent.ImageRUID = DataRef(_RaidLogic:GetCharacterIcon(data.char))
					end
					local value = row:GetChildByName("Value")
					if isvalid(value) then
						value.TextGUIRendererComponent.Text = self:Comma(math.floor(data.dps))
					end
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshClaim()
		-- 구석 버튼은 **항상** 보인다. 받을 게 있으면 "보상 받기", 없으면 "보상 목록"(등급표 입구).
		-- 지난 시즌 미수령분은 중앙 잠금 창의 "보상 받기"가 처리하므로 그때만 감춘다.
		if not isvalid(self.btnClaim) then return end

		local locked = _RaidLogic:HasPendingReward()
		self.btnClaim.Entity.Enable = not locked
		if locked or not isvalid(self.claimLabel) then return end

		-- 문구가 바뀔 때만 쓴다 — Refresh는 0.1초마다 돌기 때문에 매번 쓰면 누르는 중간에 끊긴다
		local key = "MLUA_RAIDUI_004"
		if _RaidLogic:CanClaimNow() then key = "UI_RAIDGROUP_001" end
		if self._claimLabelKey ~= key then
			self._claimLabelKey = key
			self.claimLabel.Text = _LocalizationService:GetText(key)
		end
	end

	property string _claimLabelKey = ""

	-- ── 보상 비행 연출(유저 지정 2026-09-24 "다야/다른 보상 받는 것처럼") ──
	-- 받기를 누르면 토스트만 띄우고, 레이드를 닫고 로비로 돌아가면 받은 보상(다이아/반지·목걸이/주문서)이
	-- 로비 배지·장비 버튼으로 날아간다. 실제 지급·저장은 받기를 누른 순간 서버에서 이미 끝나 있다 —
	-- 연출 도중 앱이 꺼져도 보상은 남는다(여기서 들고 있는 건 "무엇을 날릴지"뿐)
	-- 서버 답이 이 시간 안에 안 오면 다이아 숫자 보류를 푼다
	property number ClaimHoldTimeout = 3.0
	-- 레이드를 닫고 로비가 다 그려질 때까지 기다렸다가 날린다(로비 켜기는 한 박자 늦게 그려진다)
	property number ClaimFlyDelay = 0.35
	property number ClaimFlyStagger = 0.15
	property boolean _claimPending = false
	property integer _claimHoldDia = 0
	property integer _pendingFlyDia = 0
	property table _pendingFlyIcons = {}

	@ExecSpace("ClientOnly")
	method void OnClaimClicked()
		-- 받을 게 있으면 수령, 없으면 등급표를 연다(유저 지정 2026-09-23)
		if _RaidLogic:CanClaimNow() then
			if self._claimPending then return end
			self:BeginClaimHold()
			_RaidLogic:RequestClaim()
			return
		end
		self:OpenRewardTable()
	end

	@ExecSpace("ClientOnly")
	method void BeginClaimHold()
		-- 서버 지급(다이아 잔액 알림)이 오기 **전에** 받을 다이아만큼 배지 숫자를 붙잡아 둔다 — 늦게 잡으면
		-- 새 잔액이 이미 보인 뒤라 아이콘이 도착해도 숫자가 안 오른다(RewardFlyUI.Hold 주석)
		local grade = _RaidLogic:GetGradeIndex()
		if _RaidLogic:HasPendingReward() then grade = _RaidLogic.PendingGrade end
		local dia = _RaidLogic:GetRewardDiamond(grade)
		self._claimPending = true
		self._claimHoldDia = dia
		if dia > 0 then _RewardFlyUI:Hold("diamond", dia) end
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or not self._claimPending then return end
			self._claimPending = false
			self:ReleaseClaimHold()
			log_warning("RaidUI: claim result not received — released diamond hold")
		end, self.ClaimHoldTimeout)
	end

	@ExecSpace("ClientOnly")
	method void ReleaseClaimHold()
		-- 붙잡아 둔 다이아 숫자를 풀어 실제 잔액을 보여준다(실패/무응답)
		if self._claimHoldDia > 0 then _RewardFlyUI:Release("diamond", self._claimHoldDia) end
		self._claimHoldDia = 0
	end

	@ExecSpace("ClientOnly")
	method void OnClaimResult(boolean success, integer gradeIndex, integer raidId)
		-- RaidLogic.NotifyClaimResult(서버 지급 완료 뒤)가 부른다 — 받은 것을 기억해 두고 로비에서 날린다
		self._claimPending = false
		if not success then
			self:ReleaseClaimHold()
			return
		end
		-- 서버가 확정한 등급 기준으로 보류량을 맞춘다(누른 순간과 등급이 달라졌을 수 있다)
		local dia = _RaidLogic:GetRewardDiamond(gradeIndex)
		if dia > self._claimHoldDia then
			_RewardFlyUI:Hold("diamond", dia - self._claimHoldDia)
		elseif dia < self._claimHoldDia then
			_RewardFlyUI:Release("diamond", self._claimHoldDia - dia)
		end
		self._claimHoldDia = 0
		self._pendingFlyDia = self._pendingFlyDia + dia
		for _, itemId in ipairs({ _RaidLogic:GetRewardItemIdFor(raidId), _RaidLogic:GetRewardScrollItemIdFor(raidId) }) do
			local data = _ItemDataLogic:GetData(itemId)
			if data ~= nil and data.RUID ~= "" then table.insert(self._pendingFlyIcons, data.RUID) end
		end
		log(string.format("RaidUI: claim ok grade=%d dia=%d icons=%d (fly on lobby)", gradeIndex, dia, #self._pendingFlyIcons))
		-- 결과가 레이드를 이미 닫은 뒤에 왔으면 바로 날린다
		if not self._open then self:FlyPendingClaim() end
	end

	@ExecSpace("ClientOnly")
	method void FlyPendingClaim()
		-- 로비로 돌아온 뒤: 화면 가운데에서 다이아는 다이아 배지로, 반지·목걸이·주문서는 로비 장비 버튼으로 날아간다
		if self._pendingFlyDia <= 0 and #self._pendingFlyIcons == 0 then return end
		local src = Vector2(0, 0)
		local delay = 0
		if self._pendingFlyDia > 0 then
			_RewardFlyUI:Fly("diamond", self._pendingFlyDia, _GameManager.DiamondIconRUID, src, delay)
			delay = delay + self.ClaimFlyStagger
		end
		for _, ruid in ipairs(self._pendingFlyIcons) do
			_RewardFlyUI:Fly("gear", 1, ruid, src, delay)
			delay = delay + self.ClaimFlyStagger
		end
		log(string.format("RaidUI: reward fly dia=%d items=%d", self._pendingFlyDia, #self._pendingFlyIcons))
		self._pendingFlyDia = 0
		self._pendingFlyIcons = {}
	end

	-- ── 보상 안내 ─────────────────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void ShowClaimToast(string message, boolean success)
		-- 수령 결과를 레이드 화면 안에서 알려준다(위로 떠오르며 서서히 사라짐).
		-- 레이드 화면이 닫혀 있으면 가려질 일이 없으니 전역 토스트를 그대로 쓴다
		if message == nil or message == "" then return end
		if not self._open or not isvalid(self.toastText) then
			_UIToast:ShowMessage(message)
			return
		end

		self._toastToken = self._toastToken + 1
		local token = self._toastToken
		local entity = self.toastText.Entity
		local tr = entity.UITransformComponent
		-- 성공은 금색, 실패는 붉은 기 — 문구를 읽기 전에 색으로 먼저 알게 한다
		local red = 1.0
		local green = 0.88
		local blue = 0.88
		if success then
			green = 0.92
			blue = 0.55
		end

		self.toastText.Text = message
		tr.anchoredPosition = Vector2(self.ToastBaseX, self.ToastBaseY)
		entity.Enable = true
		_TweenLogic:PlayTween(0.0, 1.0, self.ToastSeconds, EaseType.QuadEaseOut, function(t)
			-- 연달아 뜨면 마지막 것만 살린다(이전 트위너 콜백은 조용히 무시)
			if self._toastToken ~= token then return end
			if not isvalid(self.toastText) then return end
			tr.anchoredPosition = Vector2(self.ToastBaseX, self.ToastBaseY + self.ToastRiseY * t)
			local a = 1.0
			if t > 0.6 then a = (1.0 - t) / 0.4 end
			if a < 0 then a = 0 end
			self.toastText.FontColor = Color(red, green, blue, a)
			if t >= 1.0 then entity.Enable = false end
		end)
	end

	@ExecSpace("ClientOnly")
	method void RefreshRewardBox()
		-- 지금 등급이면 무엇을 받는지 + 다음 등급까지 얼마나 남았는지
		if not isvalid(self.rewardBox) then return end
		if not self.ShowRewardBox then
			if self.rewardBox.Enable then self.rewardBox.Enable = false end
			return
		end

		-- 시즌 잠금(딤드)이 걸려 있으면 딤 위에 밝은 패널만 떠서 어색하다 — 그때는 감춘다.
		-- ⚠ Refresh는 0.1초마다 돌기 때문에 **값이 바뀔 때만** 쓴다 — 매번 Enable을 다시 쓰면
		--   누르는 중간에 엔티티가 갱신되면서 ButtonClickEvent(누름→뗌)가 끊긴다
		local locked = _RaidLogic:HasPendingReward()
		if self.rewardBox.Enable == locked then
			self.rewardBox.Enable = not locked
		end
		if locked then return end

		local gradeIdx = _RaidLogic:GetGradeIndex()
		local gearGrade = _RaidLogic:GetRewardGearGrade(gradeIdx)

		if isvalid(self.rewardRingGrade) then
			self.rewardRingGrade.Text = _GearGradeEnum:GetKoreanName(gearGrade)
			self.rewardRingGrade.FontColor = _GearGradeEnum:GetEnumColor(gearGrade)
		end
		if isvalid(self.rewardScrollCount) then
			self.rewardScrollCount.Text = "x" .. tostring(_RaidLogic:GetRewardScrollCount(gradeIdx))
		end
		-- 다이아는 F등급이 0이라 줄 자체를 감춘다(아이콘까지 같이)
		local dia = _RaidLogic:GetRewardDiamond(gradeIdx)
		if isvalid(self.rewardDiaCount) then
			self.rewardDiaCount.Entity.Enable = dia > 0
			if dia > 0 then self.rewardDiaCount.Text = self:Comma(dia) end
		end
		local diaIcon = self.rewardBox:GetChildByName("DiaIcon")
		if isvalid(diaIcon) then diaIcon.Enable = dia > 0 end

		if isvalid(self.rewardNextText) then
			local maxIdx = _RaidLogic:GetMaxGradeIndex()
			if gradeIdx >= maxIdx then
				self.rewardNextText.Text = _LocalizationService:GetText("MLUA_RAIDUI_003")
			else
				local need = _RaidLogic:GetGradeCutPercent(gradeIdx + 1) - _RaidLogic:GetRatio() * 100
				if need < 0 then need = 0 end
				self.rewardNextText.Text = _LocalizationService:GetTextFormat("FMT_RAIDUI_002",
					_RaidLogic:GetGradeName(gradeIdx + 1), string.format("%.1f", need))
			end
		end

	end

	@ExecSpace("ClientOnly")
	method void OpenRewardTable()
		if not isvalid(self.rewardTable) then return end
		-- 로딩 중(아직 전투가 안 보일 때)에는 무시 — 공개 뒤에만 연다(튜토리얼 버튼과 같은 규칙)
		if not self._open or self._revealing or self._loadingCovered then return end
		self:FillRewardTable()
		if isvalid(self.rewardTableDim) then self.rewardTableDim.Enable = true end
		self.rewardTable.Enable = true
		log("RaidUI: reward table opened")
	end

	@ExecSpace("ClientOnly")
	method void CloseRewardTable()
		if isvalid(self.rewardTableDim) then self.rewardTableDim.Enable = false end
		if isvalid(self.rewardTable) then self.rewardTable.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void FillRewardTable()
		-- F~S 7줄을 RaidLogic 값으로 채운다 — 컷 % / 반지 등급 / 주문서 수를 전부 RaidLogic 한 곳에서만
		-- 관리하려고 .ui에는 빈 칸만 두고 여기서 쓴다. 품질 확률은 유저 지정으로 넣지 않는다
		if not isvalid(self.rewardTable) then return end

		local current = _RaidLogic:GetGradeIndex()
		local maxIdx = _RaidLogic:GetMaxGradeIndex()
		-- 보상 장비 열 헤더 — 발록은 반지, 자쿰은 목걸이(2026-09-23)
		local head = self.rewardTable:GetChildByName("Head")
		local ringHead = nil
		if isvalid(head) then ringHead = head:GetChildByName("Ring") end
		if isvalid(ringHead) then
			local headKey = "UI_RAIDGROUP_012"
			if _RaidLogic.RaidId == _RaidLogic.RaidZakum then headKey = "MLUA_RAIDUI_005" end
			ringHead.TextGUIRendererComponent.Text = _LocalizationService:GetText(headKey)
		end
		for i = 0, maxIdx do
			local row = self.rewardTable:GetChildByName("Row" .. tostring(i))
			if isvalid(row) then
				local gearGrade = _RaidLogic:GetRewardGearGrade(i)

				local gradeCell = row:GetChildByName("Grade")
				if isvalid(gradeCell) then
					gradeCell.TextGUIRendererComponent.Text = _RaidLogic:GetGradeName(i)
					gradeCell.TextGUIRendererComponent.FontColor = self:HexColor(self.GradeColors[i + 1])
				end

				local cutCell = row:GetChildByName("Cut")
				if isvalid(cutCell) then
					cutCell.TextGUIRendererComponent.Text = _LocalizationService:GetTextFormat("FMT_RAIDUI_003",
						tostring(_RaidLogic:GetGradeCutPercent(i)))
				end

				local ringCell = row:GetChildByName("Ring")
				if isvalid(ringCell) then
					ringCell.TextGUIRendererComponent.Text = _GearGradeEnum:GetKoreanName(gearGrade)
					ringCell.TextGUIRendererComponent.FontColor = _GearGradeEnum:GetEnumColor(gearGrade)
				end

				local diaCell = row:GetChildByName("Dia")
				if isvalid(diaCell) then
					-- F는 다이아가 없다 — 0 대신 가운뎃줄(—)로 비었음을 보여준다
					local dia = _RaidLogic:GetRewardDiamond(i)
					if dia > 0 then
						diaCell.TextGUIRendererComponent.Text = self:Comma(dia)
						diaCell.TextGUIRendererComponent.FontColor = self:HexColor("#6fd3ff")
					else
						diaCell.TextGUIRendererComponent.Text = "-"
						diaCell.TextGUIRendererComponent.FontColor = self:HexColor("#5a6472")
					end
				end

				local scrollCell = row:GetChildByName("Scroll")
				if isvalid(scrollCell) then
					scrollCell.TextGUIRendererComponent.Text = "x" .. tostring(_RaidLogic:GetRewardScrollCount(i))
				end

				-- 지금 내 등급 줄만 금색으로 밝힌다
				local bg = row:GetChildByName("Bg")
				if isvalid(bg) then
					if i == current then
						bg.SpriteGUIRendererComponent.Color = Color(1, 0.84, 0.36, 0.22)
					elseif i % 2 == 0 then
						bg.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0.06)
					else
						bg.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0.02)
					end
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method string GetLoadingImageRUID()
		-- 지금 열린 레이드의 입장 로딩 그림
		if _RaidLogic.RaidId == _RaidLogic.RaidZakum then return self.ZakumLoadingImageRUID end
		return self.RaidLoadingImageRUID
	end

	-- ── 로비 아이콘 ───────────────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void RefreshLobbyIcon()
		-- 수령까지 끝낸 시즌에는 아이콘을 숨긴다 — 다음 시즌이 시작되면 다시 보인다.
		-- ⚠ 여기에 탭 조건을 같이 걸어야 한다 — 이 메서드는 OnUpdate에서 **매 프레임** 불리므로,
		--   TitleUI가 탭을 바꾸며 아이콘을 꺼도 다음 프레임에 도로 켜진다(유저 리포트 2026-09-22
		--   "탭 누르면 레이드 버튼은 여전히 남아있네").
		if isvalid(self.lobbyButton) then
			self.lobbyButton.Enable = self._lobbyTabVisible and _RaidLogic:IsIconVisible()
		end
		-- 받을 보상이 있을 때 + 캐릭터가 유령이 됐을 때(부활하러 들어가야 한다) 빨간점을 켠다
		if isvalid(self.lobbyRedDot) then
			self.lobbyRedDot.Enable = _RaidLogic:CanClaimNow() or _RaidLogic.IsGhost
		end
		-- 버튼 그림 = 지금 요일의 레이드(월~수 발록 / 목~일 자쿰). 바뀔 때만 쓴다
		local raidId = _RaidLogic.RaidId
		if raidId ~= self._lobbyIconRaidId and isvalid(self.lobbyOverlay) then
			self._lobbyIconRaidId = raidId
			local icon = self.BalrogLobbyIconRUID
			if raidId == _RaidLogic.RaidZakum then icon = self.ZakumLobbyIconRUID end
			self.lobbyOverlay.ImageRUID = DataRef(icon)
			log("RaidUI: lobby icon -> raid " .. raidId)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetLobbyTabVisible(boolean visible)
		-- TitleUI.ShowPanelOnly가 탭을 바꿀 때 부른다(인벤토리/출석/업적 버튼과 같은 규칙)
		self._lobbyTabVisible = visible
		self:RefreshLobbyIcon()
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		self._frameNo = self._frameNo + 1
		self:TickFpsProbe(delta)
		if not self._open then
			self:RefreshLobbyIcon()
			return
		end
		-- HUD는 주기적으로만 다시 그린다(RefreshInterval 주석 참고). 0이면 예전처럼 매 프레임.
		if self.RefreshInterval > 0 then
			self._refreshTimer = self._refreshTimer + delta
			if self._refreshTimer < self.RefreshInterval then return end
			self._refreshTimer = 0
		end
		self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method void TickFpsProbe(number delta)
		-- 성능 계측 — DebugFps가 켜져 있을 때만 2초마다 평균 fps를 찍는다
		-- ⚠ 평균 fps만 보면 안 된다 — 끊김(hitch)은 평균에 묻힌다.
		--   2026-09-22 실측: 평균은 57~58fps로 멀쩡한데 유저는 "렉이 심하다"고 했다.
		--   그래서 구간 최악 프레임(_fpsWorst)과 33ms 넘은 프레임 수(_fpsHitches)를 같이 본다.
		if not self.DebugFps then return end
		self._fpsAccum = self._fpsAccum + delta
		self._fpsFrames = self._fpsFrames + 1
		if delta > self._fpsWorst then self._fpsWorst = delta end
		if delta > 0.033 then self._fpsHitches = self._fpsHitches + 1 end
		if self._fpsAccum < 2.0 then return end
		local fps = self._fpsFrames / self._fpsAccum
		log(string.format("RaidUI FPS %.1f worst=%.0fms hitch>33ms=%d (open=%s, interval=%.2f)",
			fps, self._fpsWorst * 1000, self._fpsHitches, tostring(self._open), self.RefreshInterval))
		self._fpsAccum = 0
		self._fpsFrames = 0
		self._fpsWorst = 0
		self._fpsHitches = 0
	end

	-- ── 유틸 ─────────────────────────────────────────────────────────────────
	method string FormatRemain(integer seconds)
		-- "5d 22h" / 하루 미만이면 "22h 13m"
		if seconds < 0 then seconds = 0 end
		local days = seconds // 86400
		local hours = (seconds % 86400) // 3600
		if days > 0 then return tostring(days) .. "d " .. tostring(hours) .. "h" end
		local minutes = (seconds % 3600) // 60
		return tostring(hours) .. "h " .. tostring(minutes) .. "m"
	end

	method string Comma(integer value)
		local s = tostring(value)
		local out = ""
		local count = 0
		for i = string.len(s), 1, -1 do
			out = string.sub(s, i, i) .. out
			count = count + 1
			if count % 3 == 0 and i > 1 then out = "," .. out end
		end
		return out
	end

	method Color HexColor(string hex)
		if hex == nil or string.len(hex) < 7 then return Color(1, 1, 1, 1) end
		local r = tonumber(string.sub(hex, 2, 3), 16) or 255
		local g = tonumber(string.sub(hex, 4, 5), 16) or 255
		local b = tonumber(string.sub(hex, 6, 7), 16) or 255
		return Color(r / 255, g / 255, b / 255, 1)
	end

end
