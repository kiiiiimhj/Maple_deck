	property Entity panel = "817305c2-47b6-4369-872d-53b257a4028c"

	property ButtonComponent btnClose = "90a71eaf-08c9-47ff-8b68-4646caadb1c5"

	property ButtonComponent btnClaim = "4c103edf-5f3a-48cf-9279-375283d5b37c"

	property TextGUIRendererComponent hpText = "c6828b1c-1e66-4e87-a2af-1a269c9cf484"

	property TextGUIRendererComponent gradeText = "0f00d032-01dd-440c-85eb-cd0317bd5460"

	property TextGUIRendererComponent hintText = "998fa391-e9b0-4876-b490-7175455df94a"

	property SpriteGUIRendererComponent hpFill = "de1b71f2-1951-4f7e-b04a-a6db46493565"

	property Entity members = "3210c962-347a-43b8-af13-574a23107266"

	-- 유령 상태일 때 화면 중앙에 뜨는 "부활!" 창(유저 지정 2026-09-21)
	property Entity revivePanel = "2c498237-9ebc-4847-8d95-e3a77eb6e8fe"

	property ButtonComponent btnRevive = "bebdf3c5-a2ac-4bcc-b23a-6244d04c7780"

	-- 지난 시즌 미수령 보상이 남아 새 시즌이 잠긴 상태(유저 지정 2026-09-21).
	-- 딤드를 깔고 전투를 멈춘 뒤, 중앙 창에서 보상을 받아야 새 시즌이 시작된다.
	property Entity lockDim = "03a9edb4-4ba5-42ab-bb86-7d6937ef7691"

