@Logic
script RaidTutorialUI extends Logic

	-- 레이드 온보딩(유저 지정 2026-09-21). 첫 플레이 온보딩(TutorialGuideUI)과는 별개로,
	-- **로비에서만** 도는 레이드 전용 안내다. 세 덩어리로 나뉜다:
	--
	--   ① 알림 배너  — 첫 게임오버(= 레이드 해금)를 본 뒤 처음 로비에 서면
	--                 "레이드가 생성되었습니다!" 배너가 잠깐 떴다 사라진다(계정당 1회).
	--   ② 손가락 유도 — 배너와 **함께** 우측 레이드 아이콘을 손가락이 콕콕 가리킨다.
	--                 재접속해도 튜토리얼을 볼 때까지 계속 뜬다.
	--                 (딤은 유저 지정으로 뺐다 — 자세한 사유는 ShowGuide 주석 참고)
	--   ③ 이미지 튜토리얼 — 아이콘을 누르면 레이드로 들어가지 않고, 4단계 이미지가 화살표를 따라
	--                 순서대로 나타난다(유저가 만든 레퍼런스와 같은 흐름). 아무 데나 누르면 닫히고
	--                 "봤음"으로 저장된다(= 다음부터 아이콘을 누르면 바로 레이드 입장).
	--
	-- 해금/봤음 상태는 전부 서버(RaidLogic)의 유저별 저장소에 있고 여기서는 @Sync 값만 읽는다.
	--
	-- ⚠ UI 엔티티는 전부 **TitleGroup.ui 안**에 넣었다(별도 .ui 그룹을 새로 만들지 않았다) —
	--   딤 위로 레이드 아이콘 하나만 올리려면 _UILogic:SetSiblingIndex를 써야 하는데, 그건 같은
	--   UIGroup 안의 형제끼리만 통한다. 또 GroupOrder를 새로 잡으면 Maker가 다른 .ui들의 순서까지
	--   재정렬해 버리는 사고가 있었다(2026-08-31 뽑기 팝업이 로비 뒤로 깔린 건).

	-- ── 바인딩(전부 TitleGroup.ui) ───────────────────────────────────────────
	property Entity titleGroup = "4109795c-8f3d-41f1-9403-fefcec8fbb3e"

	property Entity raidButton = "cd6375e8-cc7d-43ae-bb10-6f90f9d5f465"

	property UITransformComponent raidButtonTf = "cd6375e8-cc7d-43ae-bb10-6f90f9d5f465"

	property Entity guideDim = "865f83e3-c036-4535-beb4-b7766c273be6"

	property UITransformComponent guideDimTf = "865f83e3-c036-4535-beb4-b7766c273be6"

	property Entity guideFinger = "df3a2b1c-b0fd-493e-a56d-d37bd5a324ff"

	property UITransformComponent guideFingerTf = "df3a2b1c-b0fd-493e-a56d-d37bd5a324ff"

	property Entity banner = "41affbad-07ed-4445-bcac-c54382be8f81"

	property TextGUIRendererComponent bannerText = "41affbad-07ed-4445-bcac-c54382be8f81"

	property CanvasGroupComponent bannerCanvas = "41affbad-07ed-4445-bcac-c54382be8f81"

	property Entity tutorialRoot = "a95683be-8e36-4b5b-bd1a-dca0e5ba2a42"

	property UITransformComponent tutorialRootTf = "a95683be-8e36-4b5b-bd1a-dca0e5ba2a42"

	property ButtonComponent tutorialDimBtn = "538f95b0-669d-48a6-be22-50613cda8976"

	property Entity step1 = "57df98a8-9897-45df-a39a-2c82e091a7ba"

	property Entity step2 = "cebd56ff-1d92-4b75-b7f9-88ac9d877ed5"

	property Entity step3 = "98b381a2-9763-4739-9f78-70b5736bb55d"

	property Entity step4 = "f39f5d08-725c-42ac-b9d6-2e879b50acc1"

	property Entity arrow1 = "f2063c6d-880d-4cbf-8bc3-b220e18db86d"

	property Entity arrow2 = "c9d7e017-7b9e-43f6-b8eb-f722403333b1"

	property Entity arrow3 = "c24f4f26-8bc4-4cb4-aeac-bd749a9ac7e4"

	-- 부팅/입장 로딩 화면(LoadingGroup/Screen). 이게 덮여 있는 동안은 로비가 "보이는" 게 아니다 —
	-- ⚠ 재접속 실측(2026-09-21): TitleGroup은 로딩 화면 **뒤에서** 이미 켜져 있어서, 이 검사가 없으면
	--   "레이드가 생성되었습니다!" 배너가 검은 로딩 화면 뒤에서 떴다 사라져 유저가 못 본다
	property Entity loadingScreen = "4e3f744a-329a-4aa7-9e36-a0ec50fb2906"

	-- ── 문구 / 연출 값 ───────────────────────────────────────────────────────
	property string BannerMessage = "레이드가 생성되었습니다!"

	-- 배너가 화면에 떠 있는 시간(페이드 제외)
	property number BannerSeconds = 2.6

	property number BannerFadeSeconds = 0.25

	-- 이미지 한 덩이(또는 화살표 하나)가 추가로 나타나는 간격(초).
	-- 순서: 1번 → 화살표 → 2번 → 화살표 → 3번 → 화살표 → 4번
	property number StepInterval = 0.55

	-- 이미지 튜토리얼을 화면에 맞출 때 위아래/좌우에 남길 여백(UI 단위).
	-- 0으로 두면 7덩이(세로 1066)가 화면(1080)에 딱 붙어서 가장자리가 잘려 보인다 —
	-- 2026-09-21 유저 실기 리포트 "위가 짤린다"가 이 경우였다.
	-- 60인 이유: FitOffsetY로 전체를 30 내리고도 아래쪽에 30이 남아야 해서.
	property number FitMargin = 60

	-- 묶음 **전체**를 화면 중앙에서 추가로 더 내릴 양(양수 = 아래로).
	-- 유저 지정 2026-09-21: 화면 기준으로 맞춘 뒤에도 위로 붙어 보여서 그만큼 한 번 더 내린다.
	property number FitOffsetY = 30

	-- 등장 팝(작게 나왔다가 제 크기로)
	property number PopScale = 0.85

	property number PopDuration = 0.18

	-- 손가락 기준 자리 — 레이드 아이콘과 **같은 앵커(오른쪽 가운데)** 라서 안전영역이 달라져도 같이 따라간다.
	-- 아이콘 중심이 오른쪽 끝에서 -108, y -15이므로 손끝이 아이콘에 닿도록 왼쪽 아래로 뺐다.
	property Vector2 FingerRestPos = Vector2(-194, -55)

	-- 찍는 방향/거리(오른쪽 위로 콕) + 왕복 주기 — 온보딩 튜토리얼(TutorialGuideUI)과 같은 값
	property Vector2 FingerTapOffset = Vector2(22, 20)

	property number FingerTapPeriod = 0.7

	-- ── 상태 ─────────────────────────────────────────────────────────────────
	property boolean _guideActive = false

	property boolean _tutorialOpen = false

	property boolean _bannerActive = false

	-- 이번 접속에서 배너를 이미 띄웠는가(서버 저장과 별개로 중복 표시를 막는 로컬 플래그)
	property boolean _announceDone = false

	-- 서버 @Sync가 돌아오기 전에 튜토리얼이 다시 뜨는 걸 막는 로컬 플래그
	property boolean _seenLocal = false

	property number _bannerTime = 0

	property number _tutorialTime = 0

	property integer _revealed = 0

	-- FitToCanvas가 계산한 이미지 묶음 축소 배율(1 = 그대로). 등장 팝 연출의 목표 크기로도 쓴다.
	property number _fitScale = 1

	property number _fingerTime = 0

	-- 딤 위로 올리기 전 레이드 아이콘의 형제 순서(끝나면 그대로 되돌린다 —
	-- 안 되돌리면 아이콘이 상점/랭킹 패널 위에 계속 떠 있게 된다)
	property integer _raidBtnSibling = -1

	property any _dimClickHandler = nil

	property any _touchHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 세 덩어리 모두 꺼진 상태로 시작한다(.ui에 켜서 저장돼 있어도 여기서 끈다)
		if isvalid(self.guideDim) then self.guideDim.Enable = false end
		if isvalid(self.guideFinger) then self.guideFinger.Enable = false end
		if isvalid(self.banner) then self.banner.Enable = false end
		if isvalid(self.tutorialRoot) then self.tutorialRoot.Enable = false end
		if isvalid(self.tutorialDimBtn) then
			self._dimClickHandler = self.tutorialDimBtn.Entity:ConnectEvent(ButtonClickEvent, function()
				self:CloseTutorial()
			end)
		end
		self._touchHandler = _InputService:ConnectEvent(ScreenTouchEvent, self.OnScreenTouch)
		log("RaidTutorialUI started")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 이벤트 정리
		if self._dimClickHandler ~= nil and isvalid(self.tutorialDimBtn) then
			self.tutorialDimBtn.Entity:DisconnectEvent(ButtonClickEvent, self._dimClickHandler)
			self._dimClickHandler = nil
		end
		if self._touchHandler ~= nil then
			_InputService:DisconnectEvent(ScreenTouchEvent, self._touchHandler)
			self._touchHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void OnScreenTouch(ScreenTouchEvent event)
		-- 딤이 탭을 먹어 레이드 아이콘이 안 눌리는 기기가 있어서(2026-09-21 모바일 실기 리포트) 둔 안전망.
		-- 가이드가 떠 있는 동안에만, 화면 터치 좌표가 아이콘 사각형 안이면 UI 버튼 raycast와 무관하게 연다.
		-- ⚠ 메이커 모바일 시뮬레이터(2556×1179)에서는 형제 순서가 정상(dim < btn)이라 재현되지 않았다 —
		--   그래서 순서 보정(EnsureIconAboveDim)은 그대로 두고 이 경로를 추가로 깐다.
		if not self._guideActive then return end
		if self._tutorialOpen then return end
		if not isvalid(self.raidButtonTf) then return end
		local p = _UILogic:ScreenToLocalUIPosition(event.TouchPoint, self.raidButtonTf)
		if p == nil then return end
		-- 아이콘 pivot이 (1, 0.5)라 로컬 원점은 아이콘의 **오른쪽 가운데**다
		local size = self.raidButtonTf.RectSize
		if p.x < -size.x or p.x > 0 then return end
		if p.y < -size.y / 2 or p.y > size.y / 2 then return end
		log(string.format("RaidTutorialUI: icon opened by screen-touch fallback (local %.0f,%.0f)", p.x, p.y))
		self:OpenTutorial()
	end

	@ExecSpace("ClientOnly")
	method boolean IsLobbyVisible()
		-- 로비 화면(타이틀 그룹)이 실제로 떠 있는가. 인게임/레이드 관전 중에는 RaidUI가 이 그룹을 끈다
		if not isvalid(self.titleGroup) then return false end
		if not self.titleGroup.Enable then return false end
		if _RaidUI:IsOpen() then return false end
		-- 로딩 화면이 아직 덮고 있으면 화면상으로는 로비가 아니다(배너가 검은 화면 뒤에서 낭비되는 걸 막는다)
		if isvalid(self.loadingScreen) and self.loadingScreen.Enable then return false end
		return true
	end

	@ExecSpace("ClientOnly")
	method boolean NeedsTutorial()
		-- 해금은 됐는데 아직 이미지 튜토리얼을 안 본 상태인가
		if not _RaidLogic.Loaded then return false end
		if not _RaidLogic.Unlocked then return false end
		if self._seenLocal then return false end
		return not _RaidLogic.TutorialSeen
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 로비에 있을 때만 도는 상태기계: 배너 → 딤+손가락 → (아이콘 클릭) 이미지 튜토리얼
		if not _RaidLogic.Loaded then return end

		if self._tutorialOpen then
			self:TickTutorial(delta)
			return
		end

		-- 배너와 손가락은 한 몸이다(유저 지정 2026-09-21): 가이드가 떠 있는 내내 메시지도 같이 떠 있고,
		-- 가이드가 걷히면(튜토리얼을 열거나 로비를 떠나면) 같이 사라진다. 시간이 지나도 저절로 안 닫힌다.
		local lobby = self:IsLobbyVisible()
		local shouldGuide = lobby and self:NeedsTutorial()
		if shouldGuide and not self._guideActive then
			self:ShowGuide()
		elseif not shouldGuide and self._guideActive then
			self:HideGuide()
		end
		if self._guideActive then
			self:TickFinger(delta)
			self:TickBannerFade(delta)
		end
	end

	-- ── ① 알림 배너 ──────────────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void TickBannerFade(number delta)
		-- 등장 페이드인만 담당한다(닫기는 HideGuide가 한다)
		if not self._bannerActive then return end
		if not isvalid(self.bannerCanvas) then return end
		if self._bannerTime >= self.BannerFadeSeconds then return end
		self._bannerTime = self._bannerTime + delta
		local alpha = self._bannerTime / self.BannerFadeSeconds
		self.bannerCanvas.GroupAlpha = math.max(0, math.min(1, alpha))
	end

	@ExecSpace("ClientOnly")
	method void ShowBanner()
		-- "레이드가 생성되었습니다!" — 가이드와 함께 뜬다. 서버 기록(MarkAnnounceShown)은 첫 표시 때 한 번만.
		self._bannerActive = true
		self._bannerTime = 0
		if isvalid(self.bannerText) then self.bannerText.Text = self.BannerMessage end
		if isvalid(self.bannerCanvas) then self.bannerCanvas.GroupAlpha = 0 end
		if isvalid(self.banner) then
			self.banner.Enable = true
			_UILogic:SetSiblingIndex(self.banner.UITransformComponent, 1000000)
		end
		-- 서버의 "아직 안 알림" 표시는 처음 띄울 때 한 번만 지운다(RPC 매번 쏘지 않게)
		if not self._announceDone then
			self._announceDone = true
			_RaidLogic:MarkAnnounceShown()
		end
		log("RaidTutorialUI: unlock banner shown")
	end

	-- ── ② 딤 + 손가락 ────────────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void ShowGuide()
		-- 손가락만 띄운다(유저 지정 2026-09-21 "딤드 없애고 손가락 가이드랑 메세지만").
		--
		-- ⚠ 딤을 쓰지 않는 이유 — 2026-09-21 실측:
		--   ① `RaidGuideDim`은 alpha 0.72에서 **아예 안 그려진다**(런타임 실측: 빨강 1.0 → 화면 전체 빨강,
		--      검정 1.0 → 전체 검정, 검정 0.72 → 아무것도 안 보임). 같은 스프라이트를 쓰는 튜토리얼 딤은 0.94다.
		--   ② 딤을 살려도 레이드 아이콘이 그 밑에 깔려 탭이 막혔다. `.ui` displayOrder(딤 14 → 아이콘 15)도,
		--      런타임 `SetSiblingIndex`(dim=15 < btn=16)도 실제 그리기/터치 순서를 못 바꿨다.
		--   → 딤 없이 손가락 + 배너만으로 유도한다. 아이콘은 평소처럼 그냥 눌린다.
		self._guideActive = true
		if isvalid(self.guideDim) then self.guideDim.Enable = false end
		if isvalid(self.guideFinger) then
			self._fingerTime = 0
			self.guideFinger.Enable = true
			self.guideFingerTf.anchoredPosition = self.FingerRestPos
			_UILogic:SetSiblingIndex(self.guideFingerTf, 1000000)
		end
		-- 메시지 배너도 같이 띄워 가이드가 끝날 때까지 유지한다
		self:ShowBanner()
		log("RaidTutorialUI: lobby guide shown (finger + banner, no dim)")
	end

	@ExecSpace("ClientOnly")
	method void HideGuide()
		-- 손가락/배너를 걷고 레이드 아이콘의 형제 순서를 원래대로 되돌린다
		self._guideActive = false
		self._bannerActive = false
		if isvalid(self.banner) then self.banner.Enable = false end
		if isvalid(self.guideDim) then self.guideDim.Enable = false end
		if isvalid(self.guideFinger) then self.guideFinger.Enable = false end
		if isvalid(self.raidButtonTf) and self._raidBtnSibling >= 0 then
			_UILogic:SetSiblingIndex(self.raidButtonTf, self._raidBtnSibling)
			self._raidBtnSibling = -1
		end
	end

	@ExecSpace("ClientOnly")
	method void TickFinger(number delta)
		-- 콕콕 — 0~35% 구간에서 빠르게 찍고 나머지 구간에서 천천히 돌아온다(온보딩 손가락과 같은 곡선)
		if not isvalid(self.guideFingerTf) then return end
		self._fingerTime = self._fingerTime + delta
		if self._fingerTime >= self.FingerTapPeriod then
			self._fingerTime = self._fingerTime - self.FingerTapPeriod
		end
		local half = self.FingerTapPeriod * 0.35
		local t = 0
		if self._fingerTime < half then
			t = self._fingerTime / half
		else
			t = 1 - (self._fingerTime - half) / (self.FingerTapPeriod - half)
		end
		local eased = t * t * (3 - 2 * t)
		local base = self.FingerRestPos
		local off = self.FingerTapOffset
		self.guideFingerTf.anchoredPosition = Vector2(base.x + off.x * eased, base.y + off.y * eased)
	end

	-- ── ③ 이미지 튜토리얼 ────────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method boolean TryHandleLobbyClick()
		-- RaidUI의 로비 아이콘 클릭이 먼저 물어본다. 아직 튜토리얼을 안 봤으면 레이드에 들어가는 대신
		-- 이미지 튜토리얼을 띄우고 true를 돌려준다(= 입장은 하지 않는다)
		if not self:NeedsTutorial() then return false end
		self:OpenTutorial()
		return true
	end

	@ExecSpace("ClientOnly")
	method void OpenTutorial()
		-- 4단계 이미지를 전부 감춘 뒤 1번부터 순서대로 나타나게 한다.
		-- ⚠ 진입 경로가 둘이다(버튼 클릭 → TryHandleLobbyClick, 화면 터치 안전망 → OnScreenTouch).
		--   한 탭에 둘 다 들어와도 등장 연출이 처음부터 다시 돌지 않게 여기서 한 번 막는다.
		if self._tutorialOpen then return end
		self:HideGuide()
		self._tutorialOpen = true
		self._tutorialTime = 0
		self._revealed = 0
		for i = 1, 7 do
			local e = self:GetSeqEntity(i)
			if isvalid(e) then e.Enable = false end
		end
		if isvalid(self.tutorialRoot) then
			self.tutorialRoot.Enable = true
			_UILogic:SetSiblingIndex(self.tutorialRootTf, 1000000)
		end
		-- 띄우기 직전에 매번 다시 잰다(기기/회전/안전영역이 바뀌어도 따라간다)
		self:FitToCanvas()
		self:RevealNext()
		log("RaidTutorialUI: image tutorial opened")
	end

	@ExecSpace("ClientOnly")
	method void TickTutorial(number delta)
		-- 다음 덩이가 나타날 때가 됐는지만 본다(전부 나오면 유저가 누를 때까지 그대로 둔다)
		self._tutorialTime = self._tutorialTime + delta
		if self._revealed >= 7 then return end
		if self._tutorialTime < self._revealed * self.StepInterval then return end
		self:RevealNext()
	end

	@ExecSpace("ClientOnly")
	method void RevealNext()
		-- 순서: 1번 이미지 → 화살표 → 2번 → 화살표 → 3번 → 화살표 → 4번
		self._revealed = self._revealed + 1
		local e = self:GetSeqEntity(self._revealed)
		if not isvalid(e) then return end
		e.Enable = true
		local tf = e.UITransformComponent
		if tf ~= nil then
			-- 팝 연출의 최종 크기는 1이 아니라 FitToCanvas가 정한 배율이다(모바일에서 줄여 놓은 걸 되돌리지 않게)
			local s = self._fitScale
			tf.Scale = Vector3(s * self.PopScale, s * self.PopScale, 1)
			_TweenLogic:ScaleTo(e, Vector2(s, s), self.PopDuration, EaseType.QuadEaseOut)
		end
	end

	@ExecSpace("ClientOnly")
	method void FitToCanvas()
		-- .ui에 박아 둔 좌표는 PC 1920×1080 기준이라, 안전영역이 깎인 모바일 캔버스
		-- (아이폰15 프로맥스 ≈2044×1027)에서는 아래쪽 이미지가 화면 밖으로 나간다.
		-- 2026-09-21 실측: 7덩이의 세로 범위가 y -586 ~ +480 = 1066이라 PC(±540)에서도 46,
		-- 모바일(±513)에서는 73이 잘려 있었다.
		-- → 7덩이를 하나의 묶음으로 보고 ① 캔버스 한가운데로 옮기고 ② 그래도 넘치면 통째로 줄인다.
		--   PC에서는 줄이지 않고 위로 53만 올라가고, 모바일에서는 0.96배로 줄어든다.
		-- Skip 안내문(바닥 앵커)은 캔버스를 따라가므로 건드리지 않는다.
		self._fitScale = 1
		if not isvalid(self.titleGroup) then return end
		local canvas = self.titleGroup.UITransformComponent.RectSize
		if canvas.x <= 0 or canvas.y <= 0 then return end
		if self._T.seqOrig == nil then self._T.seqOrig = {} end

		local x0 = 0
		local x1 = 0
		local y0 = 0
		local y1 = 0
		local found = false
		for i = 1, 7 do
			local e = self:GetSeqEntity(i)
			if isvalid(e) and e.UITransformComponent ~= nil then
				local t = e.UITransformComponent
				-- 원본 좌표는 한 번만 저장한다 — 매번 원본 기준으로 다시 계산해야 두 번 줄어들지 않는다
				if self._T.seqOrig[i] == nil then self._T.seqOrig[i] = t.anchoredPosition end
				local p = self:GetSeqFitPos(i)
				local hw = t.RectSize.x / 2
				local hh = t.RectSize.y / 2
				if not found then
					found = true
					x0 = p.x - hw
					x1 = p.x + hw
					y0 = p.y - hh
					y1 = p.y + hh
				else
					x0 = math.min(x0, p.x - hw)
					x1 = math.max(x1, p.x + hw)
					y0 = math.min(y0, p.y - hh)
					y1 = math.max(y1, p.y + hh)
				end
			end
		end
		if not found then return end

		-- 기준 사각형은 **캔버스가 아니라 실제 화면**이다. 모바일 캔버스는 안전영역이라 화면보다 작고,
		-- 특히 아래쪽이 홈바만큼 잘려 있어서 캔버스 중심에 맞추면 내용이 위로 붙는다
		-- (2026-09-21 유저 실기 스샷: 1번 이미지 위가 잘리고 아래는 남음 → "아래로 더 내려야 한다").
		-- 화면 기준이면 세로 여유가 늘어(실측 캔버스 1022 → 화면 1200) 축소도 덜 하게 된다.
		local rx0 = -canvas.x / 2
		local rx1 = canvas.x / 2
		local ry0 = -canvas.y / 2
		local ry1 = canvas.y / 2
		local measured = false
		local sw = _UILogic.ScreenWidth
		local sh = _UILogic.ScreenHeight
		if sw > 0 and sh > 0 then
			local p0 = _UILogic:ScreenToLocalUIPosition(Vector2(0, 0), self.tutorialRootTf)
			local p1 = _UILogic:ScreenToLocalUIPosition(Vector2(sw, sh), self.tutorialRootTf)
			if p0 ~= nil and p1 ~= nil then
				local mx0 = math.min(p0.x, p1.x)
				local mx1 = math.max(p0.x, p1.x)
				local my0 = math.min(p0.y, p1.y)
				local my1 = math.max(p0.y, p1.y)
				-- 부모가 스케일 연출 중이면 값이 폭주한다 — 캔버스의 0.5~2배 안일 때만 채택
				if (mx1 - mx0) > canvas.x * 0.5 and (mx1 - mx0) < canvas.x * 2
					and (my1 - my0) > canvas.y * 0.5 and (my1 - my0) < canvas.y * 2 then
					rx0 = mx0
					rx1 = mx1
					ry0 = my0
					ry1 = my1
					measured = true
				end
			end
		end

		local w = x1 - x0
		local h = y1 - y0
		local availW = (rx1 - rx0) - self.FitMargin * 2
		local availH = (ry1 - ry0) - self.FitMargin * 2
		local scale = 1
		if w > 0 and w > availW then scale = availW / w end
		if h > 0 and h * scale > availH then scale = availH / h end
		if scale <= 0 then scale = 1 end
		self._fitScale = scale

		-- 축소한 뒤의 묶음 중심을 기준 사각형(화면)의 중심으로 끌어온다
		local cx = (x0 + x1) / 2 * scale - (rx0 + rx1) / 2
		-- cy를 키우면 내용이 내려간다(newPos = orig*scale - cy)
		local cy = (y0 + y1) / 2 * scale - (ry0 + ry1) / 2 + self.FitOffsetY
		for i = 1, 7 do
			local e = self:GetSeqEntity(i)
			local p = self:GetSeqFitPos(i)
			if isvalid(e) and p ~= nil and e.UITransformComponent ~= nil then
				e.UITransformComponent.anchoredPosition = Vector2(p.x * scale - cx, p.y * scale - cy)
			end
		end
		log(string.format("RaidTutorialUI: fit rect %.0fx%.0f center(%.0f,%.0f) measured=%s canvas %.0fx%.0f content %.0fx%.0f -> scale %.3f shift(%.0f,%.0f)",
			rx1 - rx0, ry1 - ry0, (rx0 + rx1) / 2, (ry0 + ry1) / 2, tostring(measured),
			canvas.x, canvas.y, w, h, scale, -cx, -cy))
	end

	@ExecSpace("ClientOnly")
	method any GetSeqFitPos(integer index)
		-- 배치 계산에 쓸 기준 좌표 = .ui 원본 그대로. 덩이별 보정이 필요해지면 여기서 index로 갈라 쓴다.
		return self._T.seqOrig[index]
	end

	@ExecSpace("ClientOnly")
	method any GetSeqEntity(integer index)
		-- 등장 순서 → 엔티티
		if index == 1 then return self.step1 end
		if index == 2 then return self.arrow1 end
		if index == 3 then return self.step2 end
		if index == 4 then return self.arrow2 end
		if index == 5 then return self.step3 end
		if index == 6 then return self.arrow3 end
		if index == 7 then return self.step4 end
		return nil
	end

	@ExecSpace("ClientOnly")
	method void CloseTutorial()
		-- "Tap To Skip" — 화면 아무 데나 누르면 닫고 "봤음"으로 저장한다(다음부터는 바로 레이드 입장)
		if not self._tutorialOpen then return end
		self._tutorialOpen = false
		self._seenLocal = true
		if isvalid(self.tutorialRoot) then self.tutorialRoot.Enable = false end
		_RaidLogic:MarkTutorialSeen()
		log("RaidTutorialUI: image tutorial closed (revealed " .. self._revealed .. "/7)")
	end

	@ExecSpace("ClientOnly")
	method void DebugReplay()
		-- 테스트용 — 저장 상태와 무관하게 이미지 튜토리얼을 바로 띄운다
		self._seenLocal = false
		self:OpenTutorial()
	end

end
