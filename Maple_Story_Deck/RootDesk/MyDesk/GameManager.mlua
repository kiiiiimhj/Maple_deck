				-- -121: 존21 이스터에그 전용 가상 존 번호(실제 맵 인덱스와 절대 겹치지 않도록 음수 sentinel —
				-- 2026-08-25: 기존 121을 썼었는데 에피소드3 map4가 실제 mapIndex 121을 쓰게 되면서 충돌
				-- 직전 발견, 음수로 변경) — 뉴그레이 화이트는 존 몬스터 풀 시스템(InitializeStats)을
				-- 거치지 않는 일회성 스폰이라 진짜 존21 풀과 구분해야 한다
				[-121] = {"grey_tentacle"},                                                   -- 뉴그레이 화이트(Zone21AlienEasterEggLogic 전용)
			}
			local pool = pools[appearanceZone]
			if pool == nil then return "" end
			local i = math.max(1, math.min(speciesIdx, #pool))
			return pool[i]
		elseif zoneIndex >= 4 then
			local pool = {"fox_tail", "pig_tail", "orange_mushroom_cap", "orange_mushroom_cap"}  -- 음흉한여우/이상한돼지/주황버섯/시니컬한주황버섯
			local i = math.max(1, math.min(speciesIdx, #pool))
			return pool[i]
		else
			local pool = {
				"snail_shell", "blue_snail_shell", "mushroom_spore", "red_snail_shell", "slime_ooze",
				"pig_tail", "jr_boogie_horn", "stump_tear", "octopus_leg", "ribbon",
			}  -- 달팽이/파란달팽이/스포아/빨간달팽이/슬라임/돼지/주니어부기/스텀프/옥토퍼스/리본돼지(보스)
			local i = math.max(1, math.min(speciesIdx, #pool))
			return pool[i]
		end
	end

	@ExecSpace("ServerOnly")
	method void TryDropWeaponItem(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		if self.GameOver then return end
		if _UtilLogic:RandomDouble() >= self.WeaponDropChance then return end
		self:GrantWeaponItemDrop(worldPos, fallHeight, groundWorldY, dropScale)
	end

	@ExecSpace("ServerOnly")
	method void GrantWeaponItemDrop(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		if self.GameOver then return end
		-- 2026-08-26: CurrentMapIndex 기반 GetUsersByMapName 대신 접속 유저 목록을 직접 쓴다 —
		-- 존 인덱스 밖의 고정 아레나(ep3_map2_ester_1 보너스보스 등)에 있을 때는 CurrentMapIndex가
		-- 그 맵을 가리키지 않아 GetUsersByMapName이 0명을 반환해 드랍이 조용히 씹혔다(월드당
		-- 플레이어 1명뿐이라 이 방식으로 바꿔도 기존 동작은 동일하다).
		local userId = nil
		for _, u in pairs(_UserService.UserEntities) do
			userId = u.PlayerComponent.UserId
			break
		end
		if userId == nil then return end
		
		local grade = (_UtilLogic:RandomDouble() < self.WeaponDropMagicChance) and _GearGradeEnum.Magic or _GearGradeEnum.None
		local quality = _QualityEnum:RollDropQuality()
		
		-- 2026-08-17: 장비 라인이 스태프 하나에서 9종(스태프/활/양손검/자마다르/슈트A/슈트B/투구/장갑/망토)으로
		-- 늘어났다 — 전부 공용 아이템이라 캐릭터 무관 균등 랜덤으로 어느 라인이 떨어질지 먼저 고른다
		local gearItemIds = _WeaponTierDataLogic.GearItemIds
		local itemId = gearItemIds[_UtilLogic:RandomIntegerRange(1, #gearItemIds)]
		
		local skillVariant = _WeaponTierDataLogic:RollSkillVariant()
		local procChancePerMille = _WeaponTierDataLogic:RollProcChancePerMille(itemId, quality)
		
		-- 유저 강한 정정: 등급업마다 재굴림하면 미리보기와 실제 결과가 어긋날 수 있어서, 드롭 시 이
		-- Quality로 None~레전더리 전 등급의 ATK/HP/보너스를 한 번에 굴려서 영구 저장한다(재굴림 없음,
		-- WeaponTierDataLogic.RollAtkByGrade/RollHpByGrade/RollBonusPercentPerMilleByGrade 참고)
		local atkByGrade = _WeaponTierDataLogic:RollAtkByGrade(itemId, quality)
		local hpByGrade = _WeaponTierDataLogic:RollHpByGrade(itemId, quality)
		local bonusPercentPerMilleByGrade = _WeaponTierDataLogic:RollBonusPercentPerMilleByGrade(itemId, quality)
		local atk = atkByGrade[grade]
		local hp = hpByGrade[grade]
		local bonusPercentPerMille = bonusPercentPerMilleByGrade[grade]
		
		local createParam = ItemCreateParamStruct()
		createParam.ItemId = itemId
		createParam.ItemCount = 1
		createParam.Grade = grade
		createParam.Quality = quality
		createParam.ProcChancePerMille = procChancePerMille
		createParam.Atk = atk
		createParam.Hp = hp
		createParam.SkillVariant = skillVariant
		createParam.BonusPercentPerMille = bonusPercentPerMille
		createParam.AtkByGrade = atkByGrade
		createParam.HpByGrade = hpByGrade
		createParam.BonusPercentPerMilleByGrade = bonusPercentPerMilleByGrade
		
		local resultStruct = ItemCreateResultStruct()
		local errorCode = _ItemFactoryLogic:TryAddItem(userId, createParam, resultStruct)
		if errorCode ~= _ErrorCodeEnum.Success then
			log_error("TryDropWeaponItem: TryAddItem failed. Error : " .. tostring(errorCode))
			return
		end
		
		self:PlayWeaponDropVisual(Vector2(worldPos.x, worldPos.y), fallHeight, groundWorldY, dropScale, grade, itemId)
	end

	@ExecSpace("Multicast")
	method void PlayWeaponDropVisual(Vector2 worldPos, number fallHeight, number groundWorldY, number dropScale, integer grade, integer itemId)
		-- 잡템과 동일한 팝-바운스 연출(짧은 홉 3단) 뒤, 평소엔 숨겨진 로비 인벤토리 아이콘으로 날아간다.
		-- 무기 드롭은 극히 드물어서(0.05%) 잡템처럼 슬롯 풀을 둘 필요 없이 단일 슬롯 가드로 충분하다
		if self:IsServer() then return end
		if self._weaponFlyActive then return end
		self._weaponFlyActive = true
		
		local icon = self.weaponFlyIcon
		local rawUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(worldPos))
		local startUI = Vector2(rawUI.x, rawUI.y + self.DropYOffset)
		icon.ImageRUID = _WeaponTierDataLogic:GetDisplayRUID(itemId, grade)
		icon.Color = Color(1, 1, 1, 1)
		icon.Entity:SetEnable(true)
		local tc = icon.Entity.UITransformComponent
		tc.anchoredPosition = startUI
		tc.Scale = Vector3(dropScale, dropScale, 1)
		tc.ZRotation = 0
		
		local continueFromGround = function(groundUI)
			self:PlayDropPop(icon, groundUI, function(landUI)
				_TimerService:SetTimerOnce(function()
					self:FlyWeaponToLobbyIcon(icon, landUI, dropScale)
				end, 0.4)
			end)
		end
		
		local landYCorrection = self:GetDropLandYCorrection(dropScale)
		if fallHeight > 0 then
			local groundUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(Vector2(worldPos.x, groundWorldY)))
			groundUI = Vector2(groundUI.x, groundUI.y + landYCorrection)
			self:PlayFallSpin(icon, startUI, groundUI, fallHeight, continueFromGround)
		else
			continueFromGround(Vector2(rawUI.x, rawUI.y + landYCorrection))
		end
	end

	@ExecSpace("ClientOnly")
	method void FlyWeaponToLobbyIcon(SpriteGUIRendererComponent icon, Vector2 startUI, number dropScale)
		-- 도착 직전 로비 인벤토리 아이콘을 팝인시켜서 "어디로 들어가는지" 보여주고, 아이콘이 도착하면
		-- 펀치 연출 후 짧게 머물렀다가 다시 숨긴다(유저 지정: 평소엔 숨김, 드롭 알림 용도로만 잠깐 노출)
		if not isvalid(icon) then return end
		local lobbyIcon = self.weaponLobbyIcon
		-- .ui 기본값이 알파 0.235(거의 투명)라 Enable만 켜서는 거의 안 보인다 — 매번 불투명하게 강제
		lobbyIcon.Color = Color(1, 1, 1, 1)
		lobbyIcon.Entity.UITransformComponent.Scale = Vector3(0.6, 0.6, 1)
		lobbyIcon.Entity:SetEnable(true)
		_TweenLogic:ScaleTo(lobbyIcon.Entity, Vector2(1, 1), 0.2, EaseType.BackEaseOut)
		
		local endUI = self.WeaponLobbyIconTargetUI
		local arcHeight = 150
		_TweenLogic:PlayTween(0.0, 1.0, self.PotionFlyDuration, EaseType.QuadEaseOut, function(t)
			if not isvalid(icon) then return end
			local x = startUI.x + (endUI.x - startUI.x) * t
			local y = startUI.y + (endUI.y - startUI.y) * t + math.sin(t * math.pi) * arcHeight
			icon.Entity.UITransformComponent.anchoredPosition = Vector2(x, y)
			local scale = (1.0 - 0.5 * t) * dropScale
			icon.Entity.UITransformComponent.Scale = Vector3(scale, scale, 1)
			icon.Color = Color(1, 1, 1, 1.0 - 0.6 * t)
		end)
		
		_TimerService:SetTimerOnce(function()
			if isvalid(icon) then icon.Entity:SetEnable(false) end
			self._weaponFlyActive = false
			if isvalid(lobbyIcon) then
				_TweenLogic:ScaleTo(lobbyIcon.Entity, Vector2(1.15, 1.15), 0.1, EaseType.BackEaseOut)
				_TimerService:SetTimerOnce(function()
					if not isvalid(lobbyIcon) then return end
					_TweenLogic:ScaleTo(lobbyIcon.Entity, Vector2(1, 1), 0.12, EaseType.QuadEaseOut)
					_TimerService:SetTimerOnce(function()
						if isvalid(lobbyIcon) then lobbyIcon.Entity:SetEnable(false) end
					end, 0.9)
				end, 0.1)
			end
		end, self.PotionFlyDuration)
	end

	@ExecSpace("ServerOnly")
	method void TryDropLootItem(Vector3 worldPos, number fallHeight, number groundWorldY, string itemId, number dropScale)
		-- 존16~17을 제외한 전 구간에서 몬스터 처치 시 확률로, 그 몬스터의 실제 드롭템 1개를 지급한다.
		-- 포션과 동일하게 사망 위치에서 바닥에 떨어지는 연출을 보여준 뒤, 가방에 도착하는 시점에 실제로 지급한다
		if self.GameOver then return end
		if itemId == "" then return end
		local chance = self.LootItemDropChance
		-- ep3_map4_ester_1(히든맵, mapIndex 129~133 — [[Ep3Map4Ester1PortalLogic]]) 전용 아이템
		-- 드롭률 2배(유저 지정: "아이템 드롭률 2배 히든맵임")
		local zoneIndex = _MapManager.CurrentMapIndex
		if zoneIndex >= 129 and zoneIndex <= 133 then
			chance = chance * 2
		end
		if _UtilLogic:RandomDouble() >= chance then return end
		self:GrantLootItemDrop(worldPos, fallHeight, groundWorldY, itemId, dropScale)
	end

	@ExecSpace("ServerOnly")
	method void GrantLootItemDrop(Vector3 worldPos, number fallHeight, number groundWorldY, string itemId, number dropScale)
		if itemId == "" then return end
		self:GrantLootItemDropWithIcon(worldPos, fallHeight, groundWorldY, itemId, dropScale, _PlayerInventory:GetItemDef(itemId).icon)
	end

	@ExecSpace("ServerOnly")
	method void GrantLootItemDropWithIcon(Vector3 worldPos, number fallHeight, number groundWorldY, string itemId, number dropScale, string iconRuid)
		if self.GameOver then return end
		if itemId == "" then return end
		-- 실제 지급(AddItem)은 연출이 끝나야 일어나므로, 순번은 드롭이 확정된 지금 미리 예약해둔다
		-- (그래야 나중에 죽은 몬스터의 아이템이 랜덤 딜레이가 짧아 먼저 도착해도 순서가 안 뒤바뀐다)
		_PlayerInventory:ReserveAcquisitionOrder(itemId)
		
		self:ScheduleLootDrop(worldPos, iconRuid, fallHeight, groundWorldY, function()
			_PlayerInventory:AddItem(itemId, 1)
		end, dropScale)
	end

	@ExecSpace("ServerOnly")
	method string GetRandomLootItemId()
		local pool = {
			"snail_shell", "blue_snail_shell", "mushroom_spore", "red_snail_shell", "slime_ooze",
			"pig_tail", "jr_boogie_horn", "stump_tear", "octopus_leg", "ribbon",
			"fox_tail", "orange_mushroom_cap",
			"old_leather", "lorang_claw", "umti_shell", "klang_claw",
			"flying_fish", "clam_shell", "starfish_leg",
			"horned_mushroom_cap", "zombie_mushmom_spore",
			"evileye_tail", "curseeye_tail", "bat_wing",
			"stone_golem_fragment", "dark_stone_golem_fragment", "fairy_antenna",
			"mix_golem_piece", "ice_mix_golem_piece", "royal_fairy_wing",
			"firefly_slime_gel", "fairy_slime_gel",
			"water_elemental_essence", "tree_elemental_leaf",
			"mystic_wisp_dust", "lesser_spellbook_page",
			"lupin_banana", "jaguar_claw", "banana_gull_feather", "zombie_lupin_peel",
			-- 존 그룹 K(map22, 존36~39)/L(map23, 존40~43) 몬스터 잡템 — 처음 추가할 때 이 풀에 반영을
			-- 빠뜨렸었다(유저 지적으로 발견/수정, 2026-08-02). grey_tentacle(존21 외계인 이스터에그
			-- 전용)/erdas_essence/unknown_ticket은 일반 몬스터 잡템이 아니라 의도적으로 계속 제외한다.
			"jr_necki_hide", "ligator_hide", "croco_hide", "swamp_mud", "sprout_mud",
			"melody_broom", "steagy_wing",
			"jr_wraith_bone", "wraith_bone", "skeledog_bone", "mummydog_bandage",
			-- 에피소드2 구름정원(존1~10 = mapIndex 45~54) 몬스터 잡템 — 위와 같은 이유로 처음 추가할 때
			-- 이 풀에 반영을 빠뜨렸었다(2026-08-11 발견/수정)
			"star_pixie_dust", "luna_pixie_moon_shard", "nepenthes_seed", "luster_pixie_wing",
			"ghost_pixie_veil", "dark_nepenthes_seed", "giant_nepenthes_seed",
			-- 에피소드3 map1(존1~10 = mapIndex 89~98) 몬스터 잡템 — 4번째 체크 지점(유저 지적, 2026-08-02)
			-- 반영을 여기서도 빠뜨리지 않는다.
			"lity_fur", "dark_lity_fur", "jr_pepe_feather", "jr_yeti_snowball", "dark_jr_yeti_hide",
			"pepe_coin", "dark_pepe_beak", "hector_tail", "white_fang_tail", "whipped_cream",
			-- 에피소드3 map2(존1~10 = mapIndex 99~108) 신규 잡템
			"paranmini_bean_jelly", "yeti_horn", "dark_yeti_horn", "yeti_pepe_ice_shard", "dark_yeti_pepe_ice_shard",
		}
		return pool[_UtilLogic:RandomIntegerRange(1, #pool)]
	end

	@ExecSpace("ServerOnly")
	method void ForceDropLootItem(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		if self.GameOver then return end
		local itemId = self:GetRandomLootItemId()
		local iconRuid = _PlayerInventory:GetItemDef(itemId).icon
		_PlayerInventory:ReserveAcquisitionOrder(itemId)
		self:ScheduleLootDrop(worldPos, iconRuid, fallHeight, groundWorldY, function()
			_PlayerInventory:AddItem(itemId, 1)
		end, dropScale)
	end

	@ExecSpace("ServerOnly")
	method void ScheduleLootDrop(Vector3 worldPos, string iconRuid, number fallHeight, number groundWorldY, any onGrant, number dropScale)
		self:ScheduleLootDropEx(worldPos, iconRuid, fallHeight, groundWorldY, onGrant, dropScale, false)
	end

	@ExecSpace("ServerOnly")
	method void ScheduleLootDropEx(Vector3 worldPos, string iconRuid, number fallHeight, number groundWorldY, any onGrant, number dropScale, boolean freezeOnFly)
		local dropZone = _MapManager.CurrentMapIndex
		local groundDelay = 0.6 + _UtilLogic:RandomDouble() * 0.6
		local fallDuration = 0
		if fallHeight > 0 then fallDuration = math.min(0.6, 0.15 + fallHeight / 500) end
		local arrivalDelay = fallDuration + self.PotionPopDuration + groundDelay + self.PotionFlyDuration
		
		local granted = false
		local watchTimerId = 0
		watchTimerId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self) or granted then return end
			if _MapManager.CurrentMapIndex ~= dropZone then
				granted = true
				onGrant()
				_TimerService:ClearTimer(watchTimerId)
				self:RequestLootCollectNow()
			end
		end, 0.15)
		
		_TimerService:SetTimerOnce(function()
			if isvalid(self) and not granted then
				granted = true
				onGrant()
				_TimerService:ClearTimer(watchTimerId)
			end
		end, arrivalDelay)
		
		self:PlayLootDropVisual(Vector2(worldPos.x, worldPos.y), iconRuid, groundDelay, fallHeight, groundWorldY, dropScale, freezeOnFly)
	end

	@ExecSpace("ServerOnly")
	method void ScheduleApproachDrop(Vector3 startWorldPos, Vector3 groundWorldPos, string iconRuid, any onGrant, number dropScale)
		local dropZone = _MapManager.CurrentMapIndex
		local groundDelay = 0.6 + _UtilLogic:RandomDouble() * 0.6
		local arrivalDelay = self.KeyApproachDuration + groundDelay + self.PotionFlyDuration
		
		local granted = false
		local watchTimerId = 0
		watchTimerId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self) or granted then return end
			if _MapManager.CurrentMapIndex ~= dropZone then
				granted = true
				onGrant()
				_TimerService:ClearTimer(watchTimerId)
				self:RequestLootCollectNow()
			end
		end, 0.15)
		
		_TimerService:SetTimerOnce(function()
			if isvalid(self) and not granted then
				granted = true
				onGrant()
				_TimerService:ClearTimer(watchTimerId)
			end
		end, arrivalDelay)
		
		self:PlayApproachDropVisual(Vector2(startWorldPos.x, startWorldPos.y), Vector2(groundWorldPos.x, groundWorldPos.y), iconRuid, groundDelay, dropScale)
	end

	@ExecSpace("Multicast")
	method void PlayApproachDropVisual(Vector2 startWorldPos, Vector2 groundWorldPos, string iconRuid, number groundDelay, number dropScale)
		if self:IsServer() then return end
		local slots = self:GetLootSlots()
		local slotIndex = 0
		for i = 1, #slots do
			if not slots[i].busy then
				slotIndex = i
				break
			end
		end
		if slotIndex == 0 then return end
		
		local slot = slots[slotIndex]
		slot.busy = true
		slot.landed = false
		slot.collectRequested = false
		slot.flown = false
		slot.token = slot.token + 1
		slot.dropScale = dropScale
		slot.freezeOnFly = false
		local myToken = slot.token
		local icon = slot.icon
		
		_TimerService:SetTimerOnce(function()
			self:WatchdogClearLootIcon(slotIndex, myToken)
		end, 5.0)
		
		local startUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(startWorldPos))
		local landYCorrection = self:GetDropLandYCorrection(dropScale)
		local rawGroundUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(groundWorldPos))
		local groundUI = Vector2(rawGroundUI.x, rawGroundUI.y + landYCorrection)
		
		icon.ImageRUID = iconRuid
		icon.AnimClipPlayType = SpriteAnimClipPlayType.Loop
		icon.StartFrameIndex = 0
		icon.EndFrameIndex = 2147483647
		icon.PreserveSprite = PreserveSpriteType.None
		icon.Color = Color(1, 1, 1, 1)
		icon.Entity:SetEnable(true)
		local tc = icon.Entity.UITransformComponent
		local startScale = 0.12 * dropScale
		tc.anchoredPosition = startUI
		tc.Scale = Vector3(startScale, startScale, 1)
		tc.ZRotation = 0
		
		-- QuadEaseIn: 처음엔 천천히(작게 멀리) 움직이다가 착지 직전으로 갈수록 빨라지고 커진다 — 원근감을 흉내.
		-- 여기에 sin(t*pi) 부풀림을 더해 이동 중간에만 옆으로 휘었다가 시작/착지 지점(t=0, t=1)에서는
		-- 정확히 원래 좌표로 돌아오게 해서 포물선처럼 보이게 한다.
		local arcSign = (_UtilLogic:RandomDouble() < 0.5) and -1 or 1
		local arcWidth = self.KeyApproachArcWidth * arcSign
		_TweenLogic:PlayTween(0.0, 1.0, self.KeyApproachDuration, EaseType.QuadEaseIn, function(t)
			if not isvalid(icon) then return end
			local x = startUI.x + (groundUI.x - startUI.x) * t + math.sin(t * math.pi) * arcWidth
			local y = startUI.y + (groundUI.y - startUI.y) * t
			icon.Entity.UITransformComponent.anchoredPosition = Vector2(x, y)
			local scale = startScale + (dropScale - startScale) * t
			icon.Entity.UITransformComponent.Scale = Vector3(scale, scale, 1)
		end)
		
		_TimerService:SetTimerOnce(function()
			if not isvalid(icon) then return end
			slot.landed = true
			slot.landUI = groundUI
			if slot.collectRequested then
				self:TryFlyLootToBag(slotIndex, groundUI)
				return
			end
			_TimerService:SetTimerOnce(function()
				self:TryFlyLootToBag(slotIndex, groundUI)
			end, groundDelay)
		end, self.KeyApproachDuration)
	end

	@ExecSpace("ServerOnly")
	method table GetActiveMesoDrops()
		if self._activeMesoDrops == nil then self._activeMesoDrops = {} end
		return self._activeMesoDrops
	end

	@ExecSpace("ServerOnly")
	method table PopLandedMesoDrops(integer count)
		local list = self:GetActiveMesoDrops()
		local result = {}
		local remaining = {}
		for i = 1, #list do
			local drop = list[i]
			if #result < count and drop.landed and not drop.consumed then
				drop.consumed = true
				if drop.watchTimerId ~= 0 then _TimerService:ClearTimer(drop.watchTimerId) end
				if drop.grantTimerId ~= 0 then _TimerService:ClearTimer(drop.grantTimerId) end
				table.insert(result, drop)
			else
				table.insert(remaining, drop)
			end
		end
		self._activeMesoDrops = remaining
		return result
	end

	@ExecSpace("ServerOnly")
	method void RemoveActiveMesoDrop(any drop)
		local list = self:GetActiveMesoDrops()
		for i = 1, #list do
			if list[i] == drop then
				table.remove(list, i)
				return
			end
		end
	end

	@ExecSpace("Server")
	method void ReportMesoLandedPosition(integer dropId, Vector2 landedWorldPos)
		local list = self:GetActiveMesoDrops()
		for i = 1, #list do
			local drop = list[i]
			if drop.id == dropId then
				if not drop.consumed then
					drop.worldPos = Vector3(landedWorldPos.x, landedWorldPos.y, drop.worldPos.z)
				end
				return
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void ScheduleMesoDrop(Vector3 worldPos, number fallHeight, number groundWorldY, integer amount, number dropScale)
		if self.GameOver then return end
		local groundDelay = self.StealMesoGroundDelay
		local fallDuration = 0
		if fallHeight > 0 then fallDuration = math.min(0.6, 0.15 + fallHeight / 500) end
		local arrivalDelay = fallDuration + self.PotionPopDuration + groundDelay + self.PotionFlyDuration
		-- 착지 완료 시점 근사치 — 클라이언트의 PlayDropPop 착지 콜백과 정확히 일치하진 않지만(그쪽은
		-- 홉 트윈까지 더 걸림), "낙하 중인 코인 제외"라는 목적에는 이 정도 근사로 충분하다.
		local landDelay = fallDuration + self.PotionPopDuration
		
		local dropId = self._nextMesoDropId
		self._nextMesoDropId = self._nextMesoDropId + 1
		-- 유저 지적(2026-08-12): "메소 익스플로젼 연출이 메소 좌표에서 동작해야한다" — 비행형 몬스터
		-- 처치로 생긴 메소는 낙하 연출을 거쳐 groundWorldY까지 떨어지는데, 여기 등록하는 좌표가 원래
		-- worldPos(=사망/타격 지점, 공중일 수 있음) 그대로였다. 실제 코인이 화면에 보이는(착지한)
		-- 자리와 맞추기 위해 Y는 groundWorldY(+메소 전용 Y보정)로 저장한다 — 지상 킬은 원래
		-- worldPos.y == groundWorldY라 차이 없음.
		local landedWorldPos = Vector3(worldPos.x, groundWorldY + self.StealMesoYOffset, worldPos.z)
		-- 버그 실측(2026-08-12, 유저 지적: "쿨타임 돌아갈땐 잘보이는데 이미 준비상태면 안보인다" —
		-- 즉발될걸 미리 계산해서 그런듯): 지상 킬(fallHeight<=0)은 등록하는 그 즉시 landed=true로
		-- 처리했었다 — 클라이언트가 코인 아이콘을 스폰하고 팝 연출을 뜰 시간을 전혀 안 기다린
		-- 채였다. 메소 익스플로젼이 이미 쿨타임 0(대기 상태)이면 다음 프레임에 바로 PopLandedMesoDrops로
		-- 꺼내가 버려서, 화면에 뜨기도 전에 터져 사라졌다. 지상/공중 구분 없이 항상 landDelay(공중은
		-- 낙하시간+PotionPopDuration, 지상은 PotionPopDuration만)만큼 기다린 뒤에야 착지 처리한다 —
		-- 이 정도면 클라이언트가 아이콘을 실제로 화면에 띄우기에 충분한 시간이다.
		local drop = { id = dropId, worldPos = landedWorldPos, landed = false, amount = amount, consumed = false, watchTimerId = 0, grantTimerId = 0 }
		table.insert(self:GetActiveMesoDrops(), drop)
		
		_TimerService:SetTimerOnce(function()
			if isvalid(self) and not drop.consumed then drop.landed = true end
		end, landDelay)
		
		local dropZone = _MapManager.CurrentMapIndex
		drop.watchTimerId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self) or drop.consumed then return end
			if _MapManager.CurrentMapIndex ~= dropZone then
				drop.consumed = true
				self:AddGold(amount)
				_TimerService:ClearTimer(drop.watchTimerId)
				if drop.grantTimerId ~= 0 then _TimerService:ClearTimer(drop.grantTimerId) end
				self:RemoveActiveMesoDrop(drop)
				self:RequestLootCollectNow()
			end
		end, 0.15)
		
		drop.grantTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(self) and not drop.consumed then
				drop.consumed = true
				self:AddGold(amount)
				_TimerService:ClearTimer(drop.watchTimerId)
				self:RemoveActiveMesoDrop(drop)
			end
		end, arrivalDelay)
		
		-- 유저 지정: 메소만 0.3 아래로 보정 — 시작점(worldPos.y)/착지점(groundWorldY) 둘 다 같이 낮춰야
		-- 낙하 도중이든 착지 후든 항상 같은 만큼 내려가 보인다.
		self:PlayMesoDropVisual(Vector2(worldPos.x, worldPos.y + self.StealMesoYOffset), groundDelay, fallHeight, groundWorldY + self.StealMesoYOffset, dropScale, dropId)
	end

	@ExecSpace("ClientOnly")
	method table GetMesoSlots()
		if self._mesoSlots == nil then
			self._mesoSlots = {
				{ icon = self.mesoFlyIcon1, busy = false, landed = false, landUI = Vector2(0, 0), collectRequested = false, flown = false, token = 0, dropScale = 1.0, dropId = 0 },
				{ icon = self.mesoFlyIcon2, busy = false, landed = false, landUI = Vector2(0, 0), collectRequested = false, flown = false, token = 0, dropScale = 1.0, dropId = 0 },
				{ icon = self.mesoFlyIcon3, busy = false, landed = false, landUI = Vector2(0, 0), collectRequested = false, flown = false, token = 0, dropScale = 1.0, dropId = 0 },
				{ icon = self.mesoFlyIcon4, busy = false, landed = false, landUI = Vector2(0, 0), collectRequested = false, flown = false, token = 0, dropScale = 1.0, dropId = 0 },
			}
		end
		return self._mesoSlots
	end

	@ExecSpace("Multicast")
	method void ClearMesoIconByDropId(integer dropId)
		if self:IsServer() then return end
		local slots = self:GetMesoSlots()
		for i = 1, #slots do
			local slot = slots[i]
			if slot.busy and slot.dropId == dropId then
				slot.token = slot.token + 1
				if isvalid(slot.icon) then slot.icon.Entity:SetEnable(false) end
				slot.busy = false
				break
			end
		end
	end

	@ExecSpace("Multicast")
	method void PlayMesoDropVisual(Vector2 worldPos, number groundDelay, number fallHeight, number groundWorldY, number dropScale, integer dropId)
		if self:IsServer() then return end
		local slots = self:GetMesoSlots()
		local slotIndex = 0
		for i = 1, #slots do
			if not slots[i].busy then
				slotIndex = i
				break
			end
		end
		if slotIndex == 0 then
			log_warning("PlayMesoDropVisual: all 4 dedicated meso slots busy, visual skipped (grant unaffected)")
			return
		end
		
		local slot = slots[slotIndex]
		slot.busy = true
		slot.landed = false
		slot.collectRequested = false
		slot.flown = false
		slot.token = slot.token + 1
		slot.dropScale = dropScale
		slot.dropId = dropId
		local myToken = slot.token
		local icon = slot.icon
		
		-- 버그 실측: 공용 잡템 워치독은 고정 5초짜리인데, 메소는 groundDelay 자체가 5초(StealMesoGroundDelay)라
		-- 낙하/팝/바운스 연출 시간까지 더하면 정상적으로 날아가기도 전에 워치독이 먼저 발동해 아이콘을
		-- 강제로 지워버렸다(라이브 테스트로 4개 슬롯 전부 재현 확인). 실제 예상 총 소요시간(ScheduleMesoDrop의
		-- arrivalDelay 계산과 동일)보다 여유 있게 잡는다.
		local fallDuration = 0
		if fallHeight > 0 then fallDuration = math.min(0.6, 0.15 + fallHeight / 500) end
		local watchdogDelay = fallDuration + self.PotionPopDuration + groundDelay + self.PotionFlyDuration + 1.0
		_TimerService:SetTimerOnce(function()
			self:WatchdogClearMesoIcon(slotIndex, myToken)
		end, watchdogDelay)
		
		local rawUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(worldPos))
		local startUI = Vector2(rawUI.x, rawUI.y + self.DropYOffset)
		icon.ImageRUID = self.StealMesoIconRUID
		icon.AnimClipPlayType = SpriteAnimClipPlayType.Loop
		icon.PreserveSprite = PreserveSpriteType.AspectOnly
		-- 유저 지정: "공중에서 연출 나는데 드랍되고 연출 나면 좋을거같다" — 착지 전까지는 첫 프레임에 고정
		icon.StartFrameIndex = 0
		icon.EndFrameIndex = 0
		icon.Color = Color(1, 1, 1, 1)
		icon.Entity:SetEnable(true)
		local tc = icon.Entity.UITransformComponent
		tc.anchoredPosition = startUI
		tc.Scale = Vector3(0.3 * dropScale, 0.3 * dropScale, 1)
		tc.ZRotation = 0
		
		_TweenLogic:PlayTween(0.3 * dropScale, 1.2 * dropScale, 0.12, EaseType.BackEaseOut, function(scale)
			if isvalid(icon) then icon.Entity.UITransformComponent.Scale = Vector3(scale, scale, 1) end
		end)
		_TimerService:SetTimerOnce(function()
			if isvalid(icon) then icon.Entity.UITransformComponent.Scale = Vector3(dropScale, dropScale, 1) end
		end, 0.12)
		
		local continueFromGround = function(groundUI)
			self:PlayDropPop(icon, groundUI, function(landUI)
				-- 버그 실측(2026-08-12): 메소 익스플로젼이 서버 착지 근사 타이밍만 보고 이 코인을 조기
				-- 소비(ClearMesoIconByDropId → busy=false)한 뒤 이 슬롯이 다음 스틸 드랍으로 재사용되면,
				-- 아직 안 끝난 이 낙하-착지 콜백 체인(트윈 지연으로 여전히 대기 중)이 나중에 뒤늦게 실행돼
				-- 새 코인의 landed/landUI/프레임 상태를 덮어써버렸다 — "메소 익스플로젼 한 번 쓰면 그
				-- 다음부터 스틸해도 코인이 안 보임" 증상의 원인. WatchdogClearMesoIcon과 동일하게 token으로
				-- "이 클로저가 여전히 내 드랍 것인지" 재검증한 뒤에만 슬롯을 건드린다.
				if slot.token ~= myToken then return end
				slot.landed = true
				slot.landUI = landUI
				-- 유저 지적(2026-08-12): "코인이 바닥에 닿고 살짝 움직일 때가 있다" — PlayDropPop이 착지
				-- 시 좌우로 랜덤 홉(45~90px)을 하는데, 서버 등록 좌표(groundWorldY 기반)는 그 홉 이전
				-- 지점이라 메소 익스플로젼이 실제 코인 위치와 어긋난 곳에서 터졌다. 홉까지 완전히 끝난
				-- 이 시점의 실제 화면 좌표(landUI)를 월드로 역변환해 서버에 보고, 서버 쪽 등록 좌표를
				-- 진짜 최종 정지 위치로 갱신한다.
				self:ReportMesoLandedPosition(dropId, _UILogic:UIToWorldPosition(landUI))
				-- 유저 지정: "바닥에 랜딩했다는거 체크하고 연출 돌리라니깐" — PlayDropPop의 마지막 홉까지
				-- 완전히 끝나 landUI에 도착한 게 확인된 이 콜백 안에서만 애니메이션을 푼다. 혹시라도
				-- 트윈 잔여 오차가 있을 수 있으니 좌표도 landUI로 한 번 더 강제로 스냅한 뒤에 푼다 —
				-- "화면에 보이는 위치"와 "애니메이션 시작"이 반드시 같은 순간에 맞물리게.
				if isvalid(icon) then
					icon.Entity.UITransformComponent.anchoredPosition = landUI
					icon.EndFrameIndex = 2147483647
				end
				if slot.collectRequested then
					self:TryFlyMesoToBag(slotIndex, landUI)
					return
				end
				_TimerService:SetTimerOnce(function()
					if slot.token ~= myToken then return end
					self:TryFlyMesoToBag(slotIndex, landUI)
				end, groundDelay)
			end)
		end
		
		local landYCorrection = self:GetDropLandYCorrection(dropScale)
		
		if fallHeight > 0 then
			local groundUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(Vector2(worldPos.x, groundWorldY)))
			groundUI = Vector2(groundUI.x, groundUI.y + landYCorrection)
			-- 메소는 자체 회전 연출이 있어 낙하 중 통째로 ZRotation 돌리면 겹쳐 보인다 — 위치 낙하만.
			self:PlayFallSpinEx(icon, startUI, groundUI, fallHeight, continueFromGround, true)
		else
			continueFromGround(Vector2(rawUI.x, rawUI.y + landYCorrection))
		end
	end

	@ExecSpace("ClientOnly")
	method void TryFlyMesoToBag(integer slotIndex, Vector2 landUI)
		local slot = self:GetMesoSlots()[slotIndex]
		if slot.flown then return end
		slot.flown = true
		self:FlyMesoToBag(slotIndex, landUI)
	end

	@ExecSpace("ClientOnly")
	method void FlyMesoToBag(integer slotIndex, Vector2 startUI)
		local slot = self:GetMesoSlots()[slotIndex]
		local icon = slot.icon
		if not isvalid(icon) then return end
		-- 유저 지정: 정면(첫 프레임)으로 고정한 채 날아간다
		icon.StartFrameIndex = 0
		icon.EndFrameIndex = 0
		local endUI = self.LootFlyTargetUI
		local arcHeight = 150
		
		_TweenLogic:PlayTween(0.0, 1.0, self.PotionFlyDuration, EaseType.QuadEaseOut, function(t)
			if not isvalid(icon) then return end
			local x = startUI.x + (endUI.x - startUI.x) * t
			local y = startUI.y + (endUI.y - startUI.y) * t + math.sin(t * math.pi) * arcHeight
			icon.Entity.UITransformComponent.anchoredPosition = Vector2(x, y)
			local scale = (1.0 - 0.5 * t) * slot.dropScale
			icon.Entity.UITransformComponent.Scale = Vector3(scale, scale, 1)
			icon.Color = Color(1, 1, 1, 1.0 - 0.6 * t)
		end)
		
		_TimerService:SetTimerOnce(function()
			if not isvalid(icon) then return end
			icon.Entity:SetEnable(false)
			slot.busy = false
			self:PunchBagIcon()
		end, self.PotionFlyDuration)
	end

	@ExecSpace("ClientOnly")
	method void WatchdogClearMesoIcon(integer slotIndex, integer token)
		local slot = self:GetMesoSlots()[slotIndex]
		if slot.token ~= token then return end
		if not slot.busy then return end
		if isvalid(slot.icon) then slot.icon.Entity:SetEnable(false) end
		slot.busy = false
		log_warning("Meso drop visual watchdog: force-cleared a stuck icon (slot " .. slotIndex .. ")")
	end

	@ExecSpace("ClientOnly")
	method table GetLootSlots()
		if self._lootSlots == nil then
			self._lootSlots = {
				{ icon = self.lootFlyIcon1, busy = false, landed = false, landUI = Vector2(0, 0), collectRequested = false, flown = false, token = 0, dropScale = 1.0, freezeOnFly = false },
				{ icon = self.lootFlyIcon2, busy = false, landed = false, landUI = Vector2(0, 0), collectRequested = false, flown = false, token = 0, dropScale = 1.0, freezeOnFly = false },
				{ icon = self.lootFlyIcon3, busy = false, landed = false, landUI = Vector2(0, 0), collectRequested = false, flown = false, token = 0, dropScale = 1.0, freezeOnFly = false },
				{ icon = self.lootFlyIcon4, busy = false, landed = false, landUI = Vector2(0, 0), collectRequested = false, flown = false, token = 0, dropScale = 1.0, freezeOnFly = false },
			}
		end
		return self._lootSlots
	end

	@ExecSpace("Multicast")
	method void PlayLootDropVisual(Vector2 worldPos, string iconRuid, number groundDelay, number fallHeight, number groundWorldY, number dropScale, boolean freezeOnFly)
		-- 사망 위치에 잡템이 떨어진 것처럼 보여준 뒤, 잠시 멈췄다가 가방 아이콘으로 날아간다.
		-- 비행형 몬스터(fallHeight>0)는 먼저 바닥 높이까지 빙그르르 돌며 떨어진 뒤 이어서 홉 연출을 재생한다.
		-- 아이콘 슬롯 4개 중 비어있는 첫 슬롯을 쓴다 — 몰려 죽어서 4개가 전부 busy면 이번 드롭은
		-- 연출 없이 스킵한다(데이터 지급 자체는 서버 타이머로 별도 처리되어 영향 없음)
		if self:IsServer() then return end
		local slots = self:GetLootSlots()
		local slotIndex = 0
		for i = 1, #slots do
			if not slots[i].busy then
				slotIndex = i
				break
			end
		end
		if slotIndex == 0 then return end
		
		local slot = slots[slotIndex]
		slot.busy = true
		slot.landed = false
		slot.collectRequested = false
		slot.flown = false
		slot.token = slot.token + 1
		slot.dropScale = dropScale
		slot.freezeOnFly = freezeOnFly
		local myToken = slot.token
		local icon = slot.icon
		
		-- 어떤 이유로든 정상 경로(가방으로 날아가서 PunchBagIcon)가 끝까지 완주되지 못하면, 아이템이
		-- 화면에 영구히 남아있는 대신 5초 뒤 강제로 정리되도록 안전장치를 걸어둔다
		_TimerService:SetTimerOnce(function()
			self:WatchdogClearLootIcon(slotIndex, myToken)
		end, 5.0)
		
		local rawUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(worldPos))
		local startUI = Vector2(rawUI.x, rawUI.y + self.DropYOffset)
		icon.ImageRUID = iconRuid
		-- 유저 실측: animationclip 아이콘(메소)이 ImageRUID만 넣으면 자동 루프되는 게 아니라 한 번
		-- 재생하고 멈췄다 — GachaUI의 기존 패턴과 동일하게 AnimClipPlayType을 명시적으로 Loop로
		-- 지정해야 계속 돈다(정적 sprite면 이 값은 영향 없음).
		icon.AnimClipPlayType = SpriteAnimClipPlayType.Loop
		-- 유저 지정: "공중에서 연출 나는데 드랍되고 연출 나면 좋을거같다" — 팝업/낙하/바운스가 끝나고
		-- 바닥에 완전히 안착한 뒤부터 재생을 시작한다. freezeOnFly면 일단 첫 프레임에 고정해두고,
		-- 착지 콜백(아래 continueFromGround)에서 전체 범위로 풀어준다. 정적 sprite/freezeOnFly=false는
		-- 처음부터 전체 범위 그대로(기존 동작 유지).
		icon.StartFrameIndex = 0
		if freezeOnFly then
			icon.EndFrameIndex = 0
		else
			icon.EndFrameIndex = 2147483647
		end
		-- 유저 지적: "4번째 프레임에 두껍게 나온다" — 이 animationclip은 프레임마다 원본 픽셀 크기가
		-- 다른데(예: 24x24, 28x24, 24x24, 8x24), PreserveSprite 기본값(None)은 프레임 크기와 무관하게
		-- UITransformComponent의 고정 RectSize에 맞춰 늘려버려서 폭이 좁은 프레임이 옆으로 눌려 두껍게
		-- 보였다. freezeOnFly(메소)일 때만 AspectOnly로 바꿔 프레임마다 원본 비율 그대로 나오게 한다
		-- (다른 정적 아이콘 드랍은 기존 동작 유지).
		if freezeOnFly then
			icon.PreserveSprite = PreserveSpriteType.AspectOnly
		else
			icon.PreserveSprite = PreserveSpriteType.None
		end
		icon.Color = Color(1, 1, 1, 1)
		icon.Entity:SetEnable(true)
		local tc = icon.Entity.UITransformComponent
		tc.anchoredPosition = startUI
		tc.Scale = Vector3(0.3 * dropScale, 0.3 * dropScale, 1)
		tc.ZRotation = 0
		
		-- 등장 순간 살짝 통통 튀듯 팝(작게 시작 → 확 커졌다가 → 원래 크기로) 연출
		_TweenLogic:PlayTween(0.3 * dropScale, 1.2 * dropScale, 0.12, EaseType.BackEaseOut, function(scale)
			if isvalid(icon) then icon.Entity.UITransformComponent.Scale = Vector3(scale, scale, 1) end
		end)
		_TimerService:SetTimerOnce(function()
			if isvalid(icon) then icon.Entity.UITransformComponent.Scale = Vector3(dropScale, dropScale, 1) end
		end, 0.12)
		
		local continueFromGround = function(groundUI)
			self:PlayDropPop(icon, groundUI, function(landUI)
				slot.landed = true
				slot.landUI = landUI
				-- 바닥에 완전히 안착한 시점 — freezeOnFly로 첫 프레임에 고정해뒀던 걸 여기서 풀어서
				-- 이제부터 도는 연출이 시작되게 한다.
				if freezeOnFly and isvalid(icon) then
					icon.EndFrameIndex = 2147483647
				end
				if slot.collectRequested then
					self:TryFlyLootToBag(slotIndex, landUI)
					return
				end
				_TimerService:SetTimerOnce(function()
					self:TryFlyLootToBag(slotIndex, landUI)
				end, groundDelay)
			end)
		end
		
		local landYCorrection = self:GetDropLandYCorrection(dropScale)
		
		if fallHeight > 0 then
			-- 착지 지점(groundUI)에는 DropYOffset을 더하지 않는다 — 여기 더하면 최종적으로 안착하는
			-- 높이가 실제 바닥보다 계속 떠 보인다(유저 실측 확인: 아이템이 바닥에 안 붙고 공중에 떠있음).
			-- 등장 시작점(startUI)에만 오프셋을 남겨서 "몸에서 팡 튀어나오는" 연출은 그대로 유지한다.
			-- 다만 landYCorrection만큼은 착지 지점에도 더한다 — 안 그러면 타일 표면보다 낮게 박힌다(유저 실측 확인)
			local groundUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(Vector2(worldPos.x, groundWorldY)))
			groundUI = Vector2(groundUI.x, groundUI.y + landYCorrection)
			-- 유저 지적: animationclip 아이콘(메소)은 이미 자체 회전 연출이 있어서, 여기서 ZRotation으로
			-- 통째로 또 돌리면 두 회전이 겹쳐 이상하게 보인다 — freezeOnFly면 위치 낙하만 하고 스킵.
			self:PlayFallSpinEx(icon, startUI, groundUI, fallHeight, continueFromGround, freezeOnFly)
		else
			continueFromGround(Vector2(rawUI.x, rawUI.y + landYCorrection))
		end
	end

	@ExecSpace("ClientOnly")
	method void PlayFallSpin(SpriteGUIRendererComponent icon, Vector2 startUI, Vector2 groundUI, number fallHeight, any onGrounded)
		self:PlayFallSpinEx(icon, startUI, groundUI, fallHeight, onGrounded, false)
	end

	@ExecSpace("ClientOnly")
	method void PlayFallSpinEx(SpriteGUIRendererComponent icon, Vector2 startUI, Vector2 groundUI, number fallHeight, any onGrounded, boolean skipRotation)
		-- 비행형 몬스터 전용: 사망 위치가 공중이므로, 바닥(타일) 높이까지 빙그르르 돌면서 떨어지는 연출을 먼저 재생한다
		if not isvalid(icon) then return end
		local duration = math.min(0.6, 0.15 + fallHeight / 500)
		-- 회전량을 항상 360의 배수로 맞춰서, 다 돌고 나면 항상 원래(0도) 각도로 자연스럽게 떨어지게 한다.
		-- 배수가 아니면 낙하 도중 임의의 각도에서 멈췄다가 착지 순간 0도로 툭 꺾여 보였다.
		local rawSpinDegrees = 540 + fallHeight
		local spinDegrees = math.floor(rawSpinDegrees / 360 + 0.5) * 360
		if spinDegrees == 0 then spinDegrees = 360 end
		
		_TweenLogic:PlayTween(0.0, 1.0, duration, EaseType.QuadEaseIn, function(t)
			if not isvalid(icon) then return end
			local pos = Vector2(startUI.x + (groundUI.x - startUI.x) * t, startUI.y + (groundUI.y - startUI.y) * t)
			icon.Entity.UITransformComponent.anchoredPosition = pos
			if not skipRotation then
				icon.Entity.UITransformComponent.ZRotation = spinDegrees * t
			end
		end)
		
		_TimerService:SetTimerOnce(function()
			if not isvalid(icon) then return end
			icon.Entity.UITransformComponent.ZRotation = 0
			if onGrounded ~= nil then onGrounded(groundUI) end
		end, duration)
	end

	@ExecSpace("ServerOnly")
	method void TryDropFreezeItem(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		if self.GameOver then return end
		if _UtilLogic:RandomDouble() >= self.FreezeItemDropChance then return end
		log("FreezeItem dropped (2% roll hit)")
		self:ScheduleFreezeItemDrop(worldPos, fallHeight, groundWorldY, dropScale)
	end

	@ExecSpace("ServerOnly")
	method void ScheduleFreezeItemDrop(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		-- 아이템이 사라지는 시점과 실제 효과 발동 시점이 너무 떨어져 있으면 인지가 안 된다는 지적 —
		-- 낙하시간/연출시간과 무관하게 고정 0.5초 뒤 발동한다.
		local arrivalDelay = 0.5
		
		_TimerService:SetTimerOnce(function()
			if isvalid(self) then self:TriggerGlobalFreeze() end
		end, arrivalDelay)
		
		self:PlayFreezeItemDropVisual(Vector2(worldPos.x, worldPos.y), fallHeight, groundWorldY, dropScale)
	end

	@ExecSpace("Multicast")
	method void PlayFreezeItemDropVisual(Vector2 worldPos, number fallHeight, number groundWorldY, number dropScale)
		-- 사망 위치에서 잡템보다 훨씬 높이 한 번 솟았다가 떨어진 뒤, 아무 곳으로도 날아가지 않고
		-- 그 자리에서 페이드아웃되며 사라진다(획득 연출 없음). 비행형 몬스터는 다른 드롭과 동일하게
		-- 바닥 높이까지 먼저 빙그르르 돌며 떨어진 뒤 이어서 높이 솟는 홉을 재생한다.
		if self:IsServer() then return end
		if self._freezeItemFlyActive then return end
		self._freezeItemFlyActive = true
		
		local rawUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(worldPos))
		local startUI = Vector2(rawUI.x, rawUI.y + self.DropYOffset)
		local icon = self.freezeItemFlyIcon
		icon.ImageRUID = self.FreezeItemIconRUID
		icon.Color = Color(1, 1, 1, 1)
		icon.Entity:SetEnable(true)
		local tc = icon.Entity.UITransformComponent
		tc.anchoredPosition = startUI
		tc.Scale = Vector3(1.25 * dropScale, 1.25 * dropScale, 1)
		
		local landYCorrection = self:GetDropLandYCorrection(dropScale)
		
		local doHighPop = function(fromUI)
			self:PlayHop(icon, fromUI, fromUI, self.FreezeItemPopHeight, self.FreezeItemPopDuration, function()
				-- 페이드아웃 대신 special/0~3(점점 커지는 확장 링)을 순서대로 재생해 "깨지면서
				-- 사라지는" 연출을 낸다.
				if isvalid(icon) then icon.Entity:SetEnable(false) end
				self._freezeItemFlyActive = false
				self:PlayFreezeItemBurst(fromUI)
				self:PlayGlobalFreezeScreenEffect()
			end)
		end
		
		if fallHeight > 0 then
			local groundUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(Vector2(worldPos.x, groundWorldY)))
			groundUI = Vector2(groundUI.x, groundUI.y + landYCorrection)
			self:PlayFallSpin(icon, startUI, groundUI, fallHeight, doHighPop)
		else
			doHighPop(Vector2(rawUI.x, rawUI.y + landYCorrection))
		end
	end

	@ExecSpace("Multicast")
	method void PlayFreezeItemBurst(Vector2 screenPos)
		if self:IsServer() then return end
		local icon = self.freezeItemBurstIcon
		if not isvalid(icon) then return end
		
		if not self._freezeItemBurstEventWired then
			self._freezeItemBurstEventWired = true
			icon.Entity:ConnectEvent(SpriteGUIAnimPlayerEndEvent, function()
				self:OnFreezeItemBurstStageEnd()
			end)
		end
		
		icon.Entity.UITransformComponent.anchoredPosition = screenPos
		self._freezeItemBurstStage = 1
		icon.ImageRUID = self._freezeItemBurstRuids[1]
		icon.Entity:SetEnable(false)
		icon.Entity:SetEnable(true)
		icon.Color = Color(1, 1, 1, 1)
	end

	@ExecSpace("ClientOnly")
	method void OnFreezeItemBurstStageEnd()
		local icon = self.freezeItemBurstIcon
		self._freezeItemBurstStage = self._freezeItemBurstStage + 1
		if self._freezeItemBurstStage > #self._freezeItemBurstRuids then
			if isvalid(icon) then icon.Entity:SetEnable(false) end
			-- 안전장치 — 아래 마지막 조각 진입 시점의 0.57초 타이머가 어떤 이유로든 못 걸렸을
			-- 경우를 대비해, 여기서도 한 번 더 꺼준다(이미 꺼져있으면 무해).
			if isvalid(self.freezeScreenMiddle) then self.freezeScreenMiddle.Entity:SetEnable(false) end
			return
		end
		if isvalid(icon) then
			icon.ImageRUID = self._freezeItemBurstRuids[self._freezeItemBurstStage]
			icon.Entity:SetEnable(false)
			icon.Entity:SetEnable(true)
			icon.Color = Color(1, 1, 1, 1)
			if self._freezeItemBurstStage == #self._freezeItemBurstRuids then
				-- 실측: 조각 1개당 재생시간 약 0.87초, 화면 중앙 눈꽃결정(freezeScreenMiddle)은
				-- 원본 클립이 훨씬 길어서(8초 넘게도 자연 종료 이벤트가 안 옴) 파편이 다 끝나는
				-- 시점에 맞춰 강제로 꺼도 유저 체감상 0.3초 정도 늦게 사라졌다 — 마지막 조각이
				-- 시작되고 0.57초(=0.87-0.3) 뒤, 그 조각이 끝나길 기다리지 않고 미리 꺼서
				-- 파편이 사라지는 타이밍과 맞춘다.
				_TimerService:SetTimerOnce(function()
					if isvalid(self.freezeScreenMiddle) then self.freezeScreenMiddle.Entity:SetEnable(false) end
				end, 0.57)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void TriggerGlobalFreeze()
		log("TriggerGlobalFreeze: freezing all monsters for " .. self.GlobalFreezeDuration .. "s")
		_UIToast:ShowMessage("모든 적 빙결!")
		-- 재적용 시에도(이미 얼어있는 도중 또 밟아도) 남은 시간을 그냥 최대치로 갱신한다 — 스폰 감시
		-- 창(OnUpdate)이 계속 켜져 있어야 그 사이 새로 스폰되는 몬스터도 즉시 얼릴 수 있다.
		self._globalFreezeActive = true
		self._globalFreezeRemaining = self.GlobalFreezeDuration
		-- 실측 확인: _EntityService:GetEntitiesSpawnedByModelId(...)가 런타임에 SpawnByModelId로 스폰된
		-- 몬스터를 단 한 마리도 찾지 못했다(방금 스폰한 5마리로 직접 재현 — 항상 0개 반환) — "이미
		-- 있던 몬스터가 안 언다"는 버그의 진짜 원인은 이 함수 전체가 사실상 no-op이었던 것.
		-- HurricaneSweepHit과 동일하게 존 컨테이너의 자식 트리를 직접 훑는 방식으로 교체한다 —
		-- 이쪽은 실제로 몬스터를 찾아낸다는 게 이미 확인됐다. 보너스 보스는 이 방식이면 자동으로
		-- 걸리지 않는다(MonsterAI가 아니라 별도 모델/컴포넌트라서가 아니라, 같은 컴포넌트라도
		-- _isBonusBoss 체크로 명시적으로 제외해야 하므로 아래에서 따로 건너뛴다).
		local maxZone = _MapManager:GetMaxZoneIndex()
		for zoneIdx = 1, maxZone do
			local map = _MonsterSpawner:GetZoneEntity(zoneIdx)
			if map ~= nil then
				local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
				for i = 1, #monsters do
					---@type MonsterAI
					local ai = monsters[i]
					if not ai._isBonusBoss then ai:ApplyHardFreeze(self.GlobalFreezeDuration) end
				end
			end
		end
		self:PlayGlobalFreezeScreenEffect()
	end

	@ExecSpace("Multicast")
	method void PlayGlobalFreezeScreenEffect()
		if self:IsServer() then return end
		if self._freezeScreenEffectActive then return end
		self._freezeScreenEffectActive = true
		self._freezeScreenPiecesDone = 0
		
		local pieces = { self.freezeScreenLeftUp, self.freezeScreenLeftDown, self.freezeScreenRightUp, self.freezeScreenRightDown, self.freezeScreenMiddle, self.freezeScreenBack, self.freezeScreenBeam }
		if not self._freezeScreenEventsWired then
			self._freezeScreenEventsWired = true
			for i = 1, #pieces do
				local piece = pieces[i]
				if isvalid(piece) then
					piece.Entity:ConnectEvent(SpriteGUIAnimPlayerEndEvent, function()
						self:OnFreezeScreenPieceEnd(piece)
					end)
				end
			end
		end
		
		for i = 1, #pieces do
			if isvalid(pieces[i]) then
				-- 껐다 켜는 것만으로는(같은 프레임 안에서 토글) Onetime 애니메이션이 실제로 처음부터
				-- 재생되지 않는 경우가 있었다 — 재생이 끝난 마지막 프레임(알파가 빠진 것처럼 흐릿하게
				-- 보이는 프레임)에 멈춘 채로 다시 켜지기만 하고, 종료 이벤트도 다시 안 와서 그 자리에
				-- 계속 남아있었다(유저 스크린샷으로 확인). ImageRUID를 실제로 재대입해야 애니메이션
				-- 재생 위치가 확실히 리셋된다.
				local ruid = pieces[i].ImageRUID.DataId
				pieces[i].Entity:SetEnable(false)
				pieces[i].ImageRUID = ruid
				pieces[i].Entity:SetEnable(true)
				pieces[i].Color = Color(1, 1, 1, 1)
			end
		end
		
		-- 안전장치 — 어떤 이유로든 종료 이벤트가 하나라도 안 오면(예: AnimClipPlayType 설정 실수로
		-- Loop가 되어 있으면) 재생 가드가 영원히 true로 남아 다음번부터 연출 자체가 아예 안 나오는
		-- 사고가 있었다. 원본 재생 길이를 충분히 넘는 여유 시간 뒤 강제로 정리한다.
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			if not self._freezeScreenEffectActive then return end
			for i = 1, #pieces do
				if isvalid(pieces[i]) then pieces[i].Entity:SetEnable(false) end
			end
			self._freezeScreenEffectActive = false
			self._freezeScreenPiecesDone = 0
		end, 3.0)
	end

	@ExecSpace("ClientOnly")
	method void OnFreezeScreenPieceEnd(SpriteGUIRendererComponent piece)
		if isvalid(piece) then piece.Entity:SetEnable(false) end
		self._freezeScreenPiecesDone = self._freezeScreenPiecesDone + 1
		if self._freezeScreenPiecesDone >= 7 then
			self._freezeScreenEffectActive = false
			self._freezeScreenPiecesDone = 0
		end
	end

	@ExecSpace("ServerOnly")
	method void TryDropScarecrowItem(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		if self.GameOver then return end
		if _UtilLogic:RandomDouble() >= self.ScarecrowItemDropChance then return end
		log("Scarecrow item dropped (2% roll hit)")
		self:ScheduleScarecrowItemDrop(worldPos, fallHeight, groundWorldY, dropScale)
	end

	@ExecSpace("ServerOnly")
	method void ScheduleScarecrowItemDrop(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		-- 아이템이 사라지는 시점과 실제 효과 발동 시점이 너무 떨어져 있으면 인지가 안 된다는 지적 —
		-- 낙하시간/연출시간과 무관하게 고정 0.5초 뒤 발동한다.
		local arrivalDelay = 0.5
		
		_TimerService:SetTimerOnce(function()
			if isvalid(self) then self:TriggerScarecrowShield() end
		end, arrivalDelay)
		
		self:PlayScarecrowItemDropVisual(Vector2(worldPos.x, worldPos.y), fallHeight, groundWorldY, dropScale)
	end

	@ExecSpace("Multicast")
	method void PlayScarecrowItemDropVisual(Vector2 worldPos, number fallHeight, number groundWorldY, number dropScale)
		-- 얼음 파편과 동일한 패턴 — 잡템보다 훨씬 높이 솟았다가 떨어진 뒤, 획득 연출 없이 그 자리에서
		-- 페이드아웃되며 사라진다.
		if self:IsServer() then return end
		if self._scarecrowItemFlyActive then return end
		self._scarecrowItemFlyActive = true
		
		local rawUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(worldPos))
		local startUI = Vector2(rawUI.x, rawUI.y + self.DropYOffset)
		local icon = self.scarecrowItemFlyIcon
		icon.ImageRUID = self.ScarecrowItemIconRUID
		icon.Color = Color(1, 1, 1, 1)
		icon.Entity:SetEnable(true)
		local tc = icon.Entity.UITransformComponent
		tc.anchoredPosition = startUI
		tc.Scale = Vector3(1.25 * dropScale, 1.25 * dropScale, 1)
		
		local landYCorrection = self:GetDropLandYCorrection(dropScale)
		
		local doHighPop = function(fromUI)
			self:PlayHop(icon, fromUI, fromUI, self.FreezeItemPopHeight, self.FreezeItemPopDuration, function()
				_TweenLogic:PlayTween(1.0, 0.0, self.FreezeItemFadeDuration, EaseType.QuadEaseIn, function(alpha)
					if isvalid(icon) then icon.Color = Color(1, 1, 1, alpha) end
				end)
				_TimerService:SetTimerOnce(function()
					if isvalid(icon) then icon.Entity:SetEnable(false) end
					self._scarecrowItemFlyActive = false
				end, self.FreezeItemFadeDuration)
			end)
		end
		
		if fallHeight > 0 then
			local groundUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(Vector2(worldPos.x, groundWorldY)))
			groundUI = Vector2(groundUI.x, groundUI.y + landYCorrection)
			self:PlayFallSpin(icon, startUI, groundUI, fallHeight, doHighPop)
		else
			doHighPop(Vector2(rawUI.x, rawUI.y + landYCorrection))
		end
	end

	@ExecSpace("ServerOnly")
	method void TriggerScarecrowShield()
		_UIToast:ShowMessage("허수아비 소환!")
		local zoneIdx = _MapManager.CurrentMapIndex
		if self._scarecrowEntities == nil then self._scarecrowEntities = {} end
		if self._scarecrowTimerIds == nil then self._scarecrowTimerIds = {} end
		
		if isvalid(self._scarecrowEntities[zoneIdx]) then
			-- 이 존에 이미 소환되어 있으면 재소환하지 않고 지속시간만 연장
			log("Scarecrow shield extended (zone " .. zoneIdx .. ")")
			local prevTimerId = self._scarecrowTimerIds[zoneIdx]
			if prevTimerId ~= nil and prevTimerId ~= 0 then _TimerService:ClearTimer(prevTimerId) end
			self._scarecrowTimerIds[zoneIdx] = _TimerService:SetTimerOnce(function()
				if isvalid(self) then self:EndScarecrowShield(zoneIdx) end
			end, self.ScarecrowShieldDuration)
			return
		end
		
		local mapName = _MapManager:GetMapName(zoneIdx)
		local users = _UserService:GetUsersByMapName(mapName)
		if #users == 0 then return end
		local player = users[1]
		local map = player.CurrentMap
		if map == nil then return end
		local pos = player.TransformComponent.WorldPosition
		local scarecrow = _SpawnService:SpawnByModelId("scarecrow", "Scarecrow", Vector3(pos.x, pos.y, self.ScarecrowDepthZ), map)
		if scarecrow == nil then return end
		
		self._scarecrowEntities[zoneIdx] = scarecrow
		log("Scarecrow shield summoned for " .. self.ScarecrowShieldDuration .. "s (zone " .. zoneIdx .. ")")
		self._scarecrowTimerIds[zoneIdx] = _TimerService:SetTimerOnce(function()
			if isvalid(self) then self:EndScarecrowShield(zoneIdx) end
		end, self.ScarecrowShieldDuration)
	end

	@ExecSpace("ServerOnly")
	method void EndScarecrowShield(integer zoneIdx)
		if self._scarecrowTimerIds ~= nil then self._scarecrowTimerIds[zoneIdx] = nil end
		local entity = self._scarecrowEntities ~= nil and self._scarecrowEntities[zoneIdx] or nil
		if isvalid(entity) then
			self:PlayScarecrowDeathAnim(entity)
			entity:Destroy(0.3)
		end
		if self._scarecrowEntities ~= nil then self._scarecrowEntities[zoneIdx] = nil end
	end

	@ExecSpace("Multicast")
	method void PlayScarecrowHitFlash(Entity scarecrow)
		if self:IsServer() then return end
		if not isvalid(scarecrow) then return end
		local renderer = scarecrow.SpriteRendererComponent
		if renderer == nil then return end
		renderer.SpriteRUID = self.ScarecrowHitRUID
		_TimerService:SetTimerOnce(function()
			if not isvalid(scarecrow) then return end
			local r = scarecrow.SpriteRendererComponent
			if r ~= nil and r.SpriteRUID == self.ScarecrowHitRUID then
				r.SpriteRUID = self.ScarecrowStandRUID
			end
		end, self.ScarecrowHitFlashDuration)
	end

	@ExecSpace("Multicast")
	method void PlayScarecrowDeathAnim(Entity scarecrow)
		if self:IsServer() then return end
		if not isvalid(scarecrow) then return end
		local renderer = scarecrow.SpriteRendererComponent
		if renderer ~= nil then renderer.SpriteRUID = self.ScarecrowDieRUID end
	end

	@ExecSpace("ServerOnly")
	method void TryDropBounceKnockbackItem(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		if self.GameOver then return end
		if _UtilLogic:RandomDouble() >= self.BounceKnockbackItemDropChance then return end
		log("Bounce knockback item dropped (1% roll hit)")
		self:ScheduleBounceKnockbackItemDrop(worldPos, fallHeight, groundWorldY, dropScale)
	end

	@ExecSpace("ServerOnly")
	method void ScheduleBounceKnockbackItemDrop(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		-- 아이템이 사라지는 시점과 실제 효과 발동 시점이 너무 떨어져 있으면 인지가 안 된다는 지적 —
		-- 낙하시간/연출시간과 무관하게 고정 0.5초 뒤 발동한다.
		local arrivalDelay = 0.5
		
		_TimerService:SetTimerOnce(function()
			if isvalid(self) then self:TriggerBounceKnockback() end
		end, arrivalDelay)
		
		self:PlayBounceKnockbackItemDropVisual(Vector2(worldPos.x, worldPos.y), fallHeight, groundWorldY, dropScale)
	end

	@ExecSpace("Multicast")
	method void PlayBounceKnockbackItemDropVisual(Vector2 worldPos, number fallHeight, number groundWorldY, number dropScale)
		-- 다른 두 아이템과 동일한 "높이 솟았다 사라짐" 연출.
		if self:IsServer() then return end
		if self._bounceItemFlyActive then return end
		self._bounceItemFlyActive = true
		
		local rawUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(worldPos))
		local startUI = Vector2(rawUI.x, rawUI.y + self.DropYOffset)
		local icon = self.bounceItemFlyIcon
		icon.ImageRUID = self.BounceKnockbackItemIconRUID
		icon.Color = Color(1, 1, 1, 1)
		icon.Entity:SetEnable(true)
		local tc = icon.Entity.UITransformComponent
		tc.anchoredPosition = startUI
		tc.Scale = Vector3(1.25 * dropScale, 1.25 * dropScale, 1)
		
		local landYCorrection = self:GetDropLandYCorrection(dropScale)
		
		local doHighPop = function(fromUI)
			self:PlayHop(icon, fromUI, fromUI, self.FreezeItemPopHeight, self.FreezeItemPopDuration, function()
				_TweenLogic:PlayTween(1.0, 0.0, self.FreezeItemFadeDuration, EaseType.QuadEaseIn, function(alpha)
					if isvalid(icon) then icon.Color = Color(1, 1, 1, alpha) end
				end)
				_TimerService:SetTimerOnce(function()
					if isvalid(icon) then icon.Entity:SetEnable(false) end
					self._bounceItemFlyActive = false
				end, self.FreezeItemFadeDuration)
			end)
		end
		
		if fallHeight > 0 then
			local groundUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(Vector2(worldPos.x, groundWorldY)))
			groundUI = Vector2(groundUI.x, groundUI.y + landYCorrection)
			self:PlayFallSpin(icon, startUI, groundUI, fallHeight, doHighPop)
		else
			doHighPop(Vector2(rawUI.x, rawUI.y + landYCorrection))
		end
	end

	@ExecSpace("ServerOnly")
	method void TriggerBounceKnockback()
		_UIToast:ShowMessage("토네이도 발생!")
		local zoneIdx = _MapManager.CurrentMapIndex
		if self._hurricaneEntities == nil then self._hurricaneEntities = {} end
		if self._hurricaneEndTimerIds == nil then self._hurricaneEndTimerIds = {} end
		
		if isvalid(self._hurricaneEntities[zoneIdx]) then
			log("Bounce knockback extended (zone " .. zoneIdx .. ")")
			local prevId = self._hurricaneEndTimerIds[zoneIdx]
			if prevId ~= nil and prevId ~= 0 then _TimerService:ClearTimer(prevId) end
			self._hurricaneEndTimerIds[zoneIdx] = _TimerService:SetTimerOnce(function()
				if isvalid(self) then self:EndBounceKnockback(zoneIdx) end
			end, self.BounceKnockbackDuration)
			return
		end
		
		log("Bounce knockback started for " .. self.BounceKnockbackDuration .. "s (zone " .. zoneIdx .. ")")
		self._hurricaneEndTimerIds[zoneIdx] = _TimerService:SetTimerOnce(function()
			if isvalid(self) then self:EndBounceKnockback(zoneIdx) end
		end, self.BounceKnockbackDuration)
		self:SpawnHurricane(zoneIdx)
	end

	@ExecSpace("ServerOnly")
	method void EndBounceKnockback(integer zoneIdx)
		if self._hurricaneEndTimerIds ~= nil then self._hurricaneEndTimerIds[zoneIdx] = nil end
		local entity = self._hurricaneEntities ~= nil and self._hurricaneEntities[zoneIdx] or nil
		if isvalid(entity) then entity:Destroy() end
		if self._hurricaneEntities ~= nil then self._hurricaneEntities[zoneIdx] = nil end
		if self._hurricaneTargets ~= nil then self._hurricaneTargets[zoneIdx] = nil end
		if self._hurricaneHitCooldownsByZone ~= nil then self._hurricaneHitCooldownsByZone[zoneIdx] = nil end
	end

	@ExecSpace("ServerOnly")
	method void SpawnHurricane(integer zoneIdx)
		local map = _MonsterSpawner:GetZoneEntity(zoneIdx)
		if map == nil then return end
		local startPos = Vector3(0, 1, 0)
		local mapName = _MapManager:GetMapName(zoneIdx)
		local users = _UserService:GetUsersByMapName(mapName)
		if #users > 0 then
			-- 플레이어의 Position은 맵 루트 기준이라, 존 컨테이너(map, 오프셋 보유)에 그대로
			-- 로컬 좌표로 넘기면 존 오프셋만큼 밀려서 옆 존에 스폰된 것처럼 보인다 —
			-- MonsterSpawner.ToLocalSpawnPos와 동일한 변환이 필요하다.
			local worldPos = users[1].TransformComponent.WorldPosition
			startPos = _MonsterSpawner:ToLocalSpawnPos(map, worldPos)
		end
		if self._hurricaneEntities == nil then self._hurricaneEntities = {} end
		if self._hurricaneHitCooldownsByZone == nil then self._hurricaneHitCooldownsByZone = {} end
		self._hurricaneEntities[zoneIdx] = _SpawnService:SpawnByModelId("hurricane", "Hurricane", Vector3(startPos.x, startPos.y, self.HurricaneDepthZ), map)
		self._hurricaneHitCooldownsByZone[zoneIdx] = {}
		self:PickNewHurricaneTarget(zoneIdx, nil)
	end

	@ExecSpace("ServerOnly")
	method void PickNewHurricaneTarget(integer zoneIdx, Entity excludeEntity)
		if self._hurricaneTargets == nil then self._hurricaneTargets = {} end
		self._hurricaneTargets[zoneIdx] = nil
		local map = _MonsterSpawner:GetZoneEntity(zoneIdx)
		if map == nil then return end
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		local alive = {}
		local aliveExcluding = {}
		for i = 1, #monsters do
			---@type MonsterAI
			local m = monsters[i]
			if not m._dead then
				table.insert(alive, m.Entity)
				if m.Entity ~= excludeEntity then table.insert(aliveExcluding, m.Entity) end
			end
		end
		local pool = alive
		if #aliveExcluding > 0 then pool = aliveExcluding end
		if #pool > 0 then
			self._hurricaneTargets[zoneIdx] = pool[_UtilLogic:RandomIntegerRange(1, #pool)]
		end
	end

	@ExecSpace("ServerOnly")
	method void UpdateHurricaneMovement(integer zoneIdx, number delta)
		local hurricane = self._hurricaneEntities ~= nil and self._hurricaneEntities[zoneIdx] or nil
		if not isvalid(hurricane) then return end
		
		-- 몬스터별 재타격 쿨다운 감소
		local cooldowns = self._hurricaneHitCooldownsByZone ~= nil and self._hurricaneHitCooldownsByZone[zoneIdx] or nil
		if cooldowns ~= nil then
			local expired = {}
			for e, cd in pairs(cooldowns) do
				local nv = cd - delta
				if nv <= 0 then table.insert(expired, e) else cooldowns[e] = nv end
			end
			for i = 1, #expired do cooldowns[expired[i]] = nil end
		end
		
		local target = self._hurricaneTargets ~= nil and self._hurricaneTargets[zoneIdx] or nil
		if not isvalid(target) then
			self:PickNewHurricaneTarget(zoneIdx, nil)
			target = self._hurricaneTargets ~= nil and self._hurricaneTargets[zoneIdx] or nil
		end
		
		if isvalid(target) then
			---@type MonsterAI
			local targetAI = target:GetComponent("MonsterAI")
			if targetAI == nil or targetAI._dead then
				self._hurricaneTargets[zoneIdx] = nil
			else
				local hp = hurricane.TransformComponent.Position
				local tp = target.TransformComponent.Position
				local dx = tp.x - hp.x
				local dy = tp.y - hp.y
				local dist = math.sqrt(dx * dx + dy * dy)
				if dist <= self.HurricaneReachDistance then
					-- 도착 — 다음 목적지를 새로 뽑는다(방금 지나친 대상은 다른 몬스터가 남아있는 한 제외)
					self:PickNewHurricaneTarget(zoneIdx, target)
				else
					local step = math.min(dist, self.HurricaneMoveSpeed * delta)
					local nx = hp.x + (dx / dist) * step
					local ny = hp.y + (dy / dist) * step
					hurricane.TransformComponent.Position = Vector3(nx, ny, self.HurricaneDepthZ)
				end
			end
		end
		
		self:HurricaneSweepHit(zoneIdx)
	end

	@ExecSpace("ServerOnly")
	method void HurricaneSweepHit(integer zoneIdx)
		local hurricane = self._hurricaneEntities ~= nil and self._hurricaneEntities[zoneIdx] or nil
		if not isvalid(hurricane) then return end
		local map = _MonsterSpawner:GetZoneEntity(zoneIdx)
		if map == nil then return end
		local hp = hurricane.TransformComponent.Position
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		if self._hurricaneHitCooldownsByZone == nil then self._hurricaneHitCooldownsByZone = {} end
		if self._hurricaneHitCooldownsByZone[zoneIdx] == nil then self._hurricaneHitCooldownsByZone[zoneIdx] = {} end
		local cooldowns = self._hurricaneHitCooldownsByZone[zoneIdx]
		for i = 1, #monsters do
			---@type MonsterAI
			local m = monsters[i]
			if not m._dead then
				local mp = m.Entity.TransformComponent.Position
				local dx = mp.x - hp.x
				local dy = mp.y - hp.y
				local dist = math.sqrt(dx * dx + dy * dy)
				if dist <= self.HurricaneHitRadius then
					local onCooldown = cooldowns[m.Entity] ~= nil
					if not onCooldown then
						self:HurricaneHitTarget(m)
						cooldowns[m.Entity] = self.HurricaneHitCooldown
					end
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void HurricaneHitTarget(MonsterAI target)
		if not isvalid(target) or not isvalid(target.Entity) or target._dead then return end
		local kbScale = self.BounceKnockbackScale
		if target._isBoss or target._isElite then
			kbScale = target._currentScale - (target._currentScale - self.BounceKnockbackScale) * 0.5
		end
		target:ApplyKnockback(kbScale)
	end

	@ExecSpace("ServerOnly")
	method void CheatSetTimeAttackRemaining(number seconds)
		if not self.TimeAttackMode then return end
		self.TimeAttackRemaining = seconds
	end

	@ExecSpace("ServerOnly")
	method void SpawnDespairBlade()
		if self._timeAttackOvertimeActive then return end
		self._timeAttackOvertimeActive = true
		self._despairBladeAttackTimer = self.DespairBladeAttackInterval
		self._despairBladeHoverTime = 0
		self:RespawnDespairBladeAtCurrentZone()
		log("SpawnDespairBlade: 절망의 칼날 등장, 타임어택 오버타임 시작")
	end

	@ExecSpace("ServerOnly")
	method void RespawnDespairBladeAtCurrentZone()
		if isvalid(self._despairBladeEntity) then self._despairBladeEntity:Destroy() end
		self._despairBladeEntity = nil
		local zoneIdx = _MapManager.CurrentMapIndex
		local mapName = _MapManager:GetMapName(zoneIdx)
		local users = _UserService:GetUsersByMapName(mapName)
		if #users == 0 then return end
		local player = users[1]
		local map = player.CurrentMap
		if map == nil then return end
		local pos = player.TransformComponent.WorldPosition
		self._despairBladeEntity = _SpawnService:SpawnByModelId("despairblade", "DespairBlade", Vector3(pos.x, pos.y + self.DespairBladeOffsetY, self.HurricaneDepthZ), map)
		self._despairBladeZone = zoneIdx
	end

	@ExecSpace("ServerOnly")
	method void UpdateDespairBlade(number delta)
		if not self._timeAttackOvertimeActive then return end
		local zoneIdx = _MapManager.CurrentMapIndex
		if zoneIdx ~= self._despairBladeZone or not isvalid(self._despairBladeEntity) then
			self:RespawnDespairBladeAtCurrentZone()
			if not isvalid(self._despairBladeEntity) then return end
		end
		
		local mapName = _MapManager:GetMapName(zoneIdx)
		local users = _UserService:GetUsersByMapName(mapName)
		if #users == 0 then return end
		local player = users[1]
		local playerPos = player.TransformComponent.WorldPosition
		
		self._despairBladeHoverTime = self._despairBladeHoverTime + delta
		local hoverY = math.sin(self._despairBladeHoverTime * self.DespairBladeHoverSpeed) * self.DespairBladeHoverAmplitude
		local hoverX = math.cos(self._despairBladeHoverTime * self.DespairBladeSwaySpeed) * self.DespairBladeSwayAmplitude
		self._despairBladeEntity.TransformComponent.Position = Vector3(playerPos.x + hoverX, playerPos.y + self.DespairBladeOffsetY + hoverY, self.HurricaneDepthZ)
		
		self._despairBladeAttackTimer = self._despairBladeAttackTimer - delta
		if self._despairBladeAttackTimer <= 0 then
			self._despairBladeAttackTimer = self.DespairBladeAttackInterval
			-- 유저 요청: 몬스터가 휘두르는 모션이 먼저 재생되고, 그 스윙이 실제로 닿는 타이밍(임팩트)에
			-- 맞춰 오브가 뜨면서 대미지가 들어가야 한다 — 셋을 동시에 쏘지 않고 스윙 시작 → 임팩트
			-- 지연(DespairBladeImpactDelay) 후 데미지+오브를 함께 트리거한다.
			self:PlayDespairBladeAttackAnim()
			_TimerService:SetTimerOnce(function()
				if isvalid(self) and not self.GameOver then
					self:ApplyDespairBladeDamage()
					self:SpawnDespairBladeOrbEffects()
				end
			end, self.DespairBladeImpactDelay)
		end
	end

	@ExecSpace("Multicast")
	method void PlayDespairBladeAttackAnim()
		if self:IsServer() then return end
		if not isvalid(self._despairBladeEntity) then return end
		local renderer = self._despairBladeEntity.SpriteRendererComponent
		if renderer == nil then return end
		renderer.SpriteRUID = self.DespairBladeAttackRUID
		local bladeEntity = self._despairBladeEntity
		_TimerService:SetTimerOnce(function()
			if isvalid(bladeEntity) then
				local r = bladeEntity.SpriteRendererComponent
				if r ~= nil and r.SpriteRUID == self.DespairBladeAttackRUID then
					r.SpriteRUID = self.DespairBladeFlyRUID
				end
			end
		end, self.DespairBladeAttackAnimDuration)
	end

	@ExecSpace("ServerOnly")
	method void ApplyDespairBladeDamage()
		if self.GameOver then return end
		local dmg = math.floor(self.PlayerMaxHp * self.DespairBladeDamagePercent)
		local armorReduction = _CardManager:GetMagicArmorReduction()
		if armorReduction > 0 then dmg = math.floor(dmg * (1.0 - armorReduction)) end
		self.PlayerHp = self.PlayerHp - dmg
		log("Despair Blade hit! HP:" .. self.PlayerHp .. " (dmg:" .. dmg .. ")")
		if self.PlayerHp <= 0 then
			self.PlayerHp = 0
			self:TriggerGameOver()
		end
	end

	@ExecSpace("ServerOnly")
	method void SpawnDespairBladeOrbEffects()
		local zoneIdx = _MapManager.CurrentMapIndex
		local mapName = _MapManager:GetMapName(zoneIdx)
		local users = _UserService:GetUsersByMapName(mapName)
		if #users == 0 then return end
		local player = users[1]
		local map = player.CurrentMap
		if map == nil then return end
		local p = player.TransformComponent.WorldPosition
		local scales = { 0.6, 1.35, 0.95 }
		-- 오브가 서로 겹쳐 보인다는 지적(유저) — 완전 독립 랜덤은 우연히 겹칠 수 있어서, X를 3개
		-- 구역(좌/중/우)으로 나눠 구역별로만 랜덤을 주는 방식으로 바꿨다. 구역 중심 간격(3.2)이
		-- 오브 스프라이트 반폭(스케일 1.35 기준 약 1.7)의 합보다 넉넉해 겹칠 일이 거의 없다.
		local zoneCenters = { -3.2, 0.0, 3.2 }
		for i = 1, 3 do
			local offsetX = zoneCenters[i] + (_UtilLogic:RandomDouble() * 1.0) - 0.5
			local offsetY = (_UtilLogic:RandomDouble() * 1.3) + 0.3
			local fxPos = Vector3(p.x + offsetX, p.y + offsetY, self.HurricaneDepthZ - 0.2)
			local fx = _SpawnService:SpawnByModelId("skilleffect", "DespairOrb", fxPos, map)
			if fx ~= nil then
				local renderer = fx.SpriteRendererComponent
				if renderer ~= nil then
					renderer.SpriteRUID = self.DespairBladeOrbRUID
					renderer.Color = Color(0.55, 0.2, 0.85, self.DespairBladeOrbAlpha)
				end
				local tc = fx.TransformComponent
				if tc ~= nil then tc.Scale = Vector3(scales[i], scales[i], 1) end
				log("DespairBladeOrb " .. i .. " spawned at " .. fxPos.x .. "," .. fxPos.y .. " scale=" .. scales[i])
			else
				log("DespairBladeOrb " .. i .. " spawn FAILED (nil entity)")
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void ClearDespairBlade()
		if isvalid(self._despairBladeEntity) then self._despairBladeEntity:Destroy() end
		self._despairBladeEntity = nil
		self._despairBladeZone = -1
		self._timeAttackOvertimeActive = false
	end

	@ExecSpace("Multicast")
	method void RequestLootCollectNow()
		if self:IsServer() then return end
		local slots = self:GetLootSlots()
		for i = 1, #slots do
			local slot = slots[i]
			if slot.busy then
				slot.collectRequested = true
				if slot.landed then self:TryFlyLootToBag(i, slot.landUI) end
			end
		end
		local mesoSlots = self:GetMesoSlots()
		for i = 1, #mesoSlots do
			local slot = mesoSlots[i]
			if slot.busy then
				slot.collectRequested = true
				if slot.landed then self:TryFlyMesoToBag(i, slot.landUI) end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ForceFinishLootDrops()
		local slots = self:GetLootSlots()
		for i = 1, #slots do
			local slot = slots[i]
			if slot.busy and not slot.flown and isvalid(slot.icon) then
				slot.flown = true
				local pos = slot.icon.Entity.UITransformComponent.anchoredPosition
				self:FlyLootToBag(i, pos)
			end
		end
		local mesoSlots = self:GetMesoSlots()
		for i = 1, #mesoSlots do
			local slot = mesoSlots[i]
			if slot.busy and not slot.flown and isvalid(slot.icon) then
				slot.flown = true
				local pos = slot.icon.Entity.UITransformComponent.anchoredPosition
				self:FlyMesoToBag(i, pos)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void TryFlyLootToBag(integer slotIndex, Vector2 landUI)
		local slot = self:GetLootSlots()[slotIndex]
		if slot.flown then return end
		slot.flown = true
		self:FlyLootToBag(slotIndex, landUI)
	end

	@ExecSpace("ClientOnly")
	method void FlyLootToBag(integer slotIndex, Vector2 startUI)
		local slot = self:GetLootSlots()[slotIndex]
		local icon = slot.icon
		if not isvalid(icon) then return end
		-- 유저 지정: "날아갈땐 자연스럽게 정면을 보면서 인벤으로 들어가게" — 바닥에 머무는 동안 돌던
		-- animationclip(메소 등)을 가방으로 날아가기 시작하는 순간 첫 프레임(정면)에 고정한다.
		if slot.freezeOnFly then
			icon.StartFrameIndex = 0
			icon.EndFrameIndex = 0
		end
		local endUI = self.LootFlyTargetUI
		local arcHeight = 150
		
		_TweenLogic:PlayTween(0.0, 1.0, self.PotionFlyDuration, EaseType.QuadEaseOut, function(t)
			if not isvalid(icon) then return end
			local x = startUI.x + (endUI.x - startUI.x) * t
			local y = startUI.y + (endUI.y - startUI.y) * t + math.sin(t * math.pi) * arcHeight
			icon.Entity.UITransformComponent.anchoredPosition = Vector2(x, y)
			local scale = (1.0 - 0.5 * t) * slot.dropScale
			icon.Entity.UITransformComponent.Scale = Vector3(scale, scale, 1)
			icon.Color = Color(1, 1, 1, 1.0 - 0.6 * t)
		end)
		
		_TimerService:SetTimerOnce(function()
			if not isvalid(icon) then return end
			icon.Entity:SetEnable(false)
			slot.busy = false
			self:PunchBagIcon()
		end, self.PotionFlyDuration)
	end

	@ExecSpace("ClientOnly")
	method void WatchdogClearLootIcon(integer slotIndex, integer token)
		local slot = self:GetLootSlots()[slotIndex]
		if slot.token ~= token then return end
		if not slot.busy then return end
		if isvalid(slot.icon) then slot.icon.Entity:SetEnable(false) end
		slot.busy = false
		log_warning("Loot drop visual watchdog: force-cleared a stuck icon (slot " .. slotIndex .. ")")
	end

	@ExecSpace("ClientOnly")
	method void PunchBagIcon()
		-- 잡템 도착 시 가방 아이콘을 잠깐 확대-축소시켜 도착감을 준다
		if not isvalid(self.btnInventory) then return end
		_TweenLogic:ScaleTo(self.btnInventory.Entity, Vector2(1.15, 1.15), 0.12, EaseType.BackEaseOut)
		_TimerService:SetTimerOnce(function()
			if isvalid(self.btnInventory) then
				_TweenLogic:ScaleTo(self.btnInventory.Entity, Vector2(1, 1), 0.15, EaseType.QuadEaseOut)
			end
		end, 0.12)
	end

	@ExecSpace("ServerOnly")
	method void ForceDropPotion(Vector3 worldPos, number dropScale)
		if self.GameOver then return end
		local potionType = (_UtilLogic:RandomDouble() < 0.7) and 1 or 2
		-- 보너스 보스는 비행형이 아니라 사망 위치가 항상 바닥이므로 fallHeight=0 고정(groundWorldY는 미사용)
		self:ApplyPotionDrop(potionType, worldPos, 0, worldPos.y, dropScale)
	end

	@ExecSpace("ServerOnly")
	method number GetSkillInvPotionHealBonusPercent()
		local lv = 0
		if _SkillInventory.Levels["1"] ~= nil then lv = _SkillInventory.Levels["1"] end
		if lv >= 3 then return 0.09
		elseif lv >= 2 then return 0.07
		elseif lv >= 1 then return 0.05
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method void ApplyPotionDrop(integer potionType, Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		-- potionType 3 = 파워 엘릭서(보스 확정 드롭) — 비율 회복 대신 완전 회복 + 전체 스킬 쿨타임 초기화
		local healAmount = 0
		if potionType == 3 then
			healAmount = self.PlayerMaxHp
		else
			local basePercent = (potionType == 1) and self.RedPotionHealPercent or self.WhitePotionHealPercent
			-- 유물 레벨업 보너스(레벨 합계 1당 +1%p)를 회복 비율에 더한다.
			-- SkillInventory 포션(스킬 인덱스1) 레벨의 +5%/+7%/+9%도 카드 자체 레벨과 별개로 항상 가산된다.
			local healPercent = basePercent + (_RelicInventory:GetPotionHealBonusPercent() / 100) + self:GetSkillInvPotionHealBonusPercent()
			healAmount = math.floor(self.PlayerMaxHp * healPercent)
		end
		log("HealPotion dropped: type=" .. potionType .. " heal=" .. healAmount)
		
		local applyEffect = function()
			self:HealPlayer(healAmount)
			if potionType == 3 then _CardManager:ResetAllCooldowns() end
		end
		
		-- 포션은 "드랍된 존에 있다가 그 존에서 획득"하는 아이템이지만, 존을 떠났다고 그냥 사라지면
		-- 억울하다 — 이동한 순간 그 자리에서 바로 주운 것으로 치고 획득 연출(HP바로 날아가는 것)로
		-- 즉시 넘어가는 게 맞다. 드랍 시점의 존을 기억해뒀다가, 짧은 주기로 존이 바뀌었는지 감시하면서
		-- 바뀌는 즉시 회복을 적용하고 클라이언트에 "지금 바로 수거하라"고 알린다.
		local dropZone = _MapManager.CurrentMapIndex
		local groundDelay = 0.6 + _UtilLogic:RandomDouble() * 0.6
		local fallDuration = 0
		if fallHeight > 0 then fallDuration = math.min(0.6, 0.15 + fallHeight / 500) end
		local arrivalDelay = fallDuration + self.PotionPopDuration + groundDelay + self.PotionFlyDuration
		
		local healed = false
		local watchTimerId = 0
		watchTimerId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self) or healed then return end
			if _MapManager.CurrentMapIndex ~= dropZone then
				healed = true
				applyEffect()
				_TimerService:ClearTimer(watchTimerId)
				self:RequestPotionCollectNow()
			end
		end, 0.15)
		
		_TimerService:SetTimerOnce(function()
			if isvalid(self) and not healed then
				healed = true
				applyEffect()
				_TimerService:ClearTimer(watchTimerId)
			end
		end, arrivalDelay)
		
		self:PlayPotionDropVisual(Vector2(worldPos.x, worldPos.y), potionType, groundDelay, fallHeight, groundWorldY, dropScale)
	end

	@ExecSpace("Multicast")
	method void PlayPotionDropVisual(Vector2 worldPos, integer potionType, number groundDelay, number fallHeight, number groundWorldY, number dropScale)
		-- 사망 위치에 포션이 떨어진 것처럼 보여준 뒤, 잠시 멈췄다가 HP바로 날아간다.
		-- 비행형 몬스터(fallHeight>0)는 먼저 바닥 높이까지 빙그르르 돌며 떨어진 뒤 이어서 홉 연출을 재생한다
		-- (PlayLootDropVisual과 동일한 패턴 — PlayFallSpin은 공용 메서드).
		if self:IsServer() then return end
		-- 이전 드롭 연출이 아직 진행 중이면 스킵 (회복은 서버에서 별도로 처리됨)
		if self._potionFlyActive then return end
		
		self._potionFlyActive = true
		self._potionLanded = false
		self._potionCollectRequested = false
		self._potionFlown = false
		-- HP바로 날아가는 마지막 단계(FlyPotionToHpBar)는 서버가 별도로 트리거하는 조기수거
		-- (RequestPotionCollectNow)에서도 다시 필요하므로 클로저가 아니라 프로퍼티로 저장해둔다.
		self._potionDropScale = dropScale
		local rawUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(worldPos))
		local startUI = Vector2(rawUI.x, rawUI.y + self.DropYOffset)
		local icon = self.potionFlyIcon
		if potionType == 1 then
			icon.ImageRUID = self.RedPotionRUID
		elseif potionType == 2 then
			icon.ImageRUID = self.WhitePotionRUID
		else
			icon.ImageRUID = self.PowerElixirRUID
		end
		icon.Color = Color(1, 1, 1, 1)
		icon.Entity:SetEnable(true)
		local tc = icon.Entity.UITransformComponent
		tc.anchoredPosition = startUI
		tc.Scale = Vector3(dropScale, dropScale, 1)
		tc.ZRotation = 0
		
		-- 메이플식 드롭: 좌우 랜덤 방향으로 포물선 홉 → 점점 작아지는 바운스 2회로 바닥에 안착한 뒤,
		-- groundDelay만큼 머물렀다가 HP바로 날아간다. 단, 그 사이 존을 떠나 조기 수거 요청이 이미
		-- 와있었다면(홉 중에 존이 바뀐 경우) 대기 없이 바로 날아간다.
		local continueFromGround = function(groundUI)
			self:PlayDropPop(icon, groundUI, function(landUI)
				self._potionLanded = true
				self._potionLandUI = landUI
				if self._potionCollectRequested then
					self:TryFlyPotionToHpBar(icon, landUI)
					return
				end
				_TimerService:SetTimerOnce(function()
					self:TryFlyPotionToHpBar(icon, landUI)
				end, groundDelay)
			end)
		end
		
		local landYCorrection = self:GetDropLandYCorrection(dropScale)
		
		if fallHeight > 0 then
			-- 착지 지점(groundUI)에는 DropYOffset을 더하지 않는다 — 여기 더하면 최종적으로 안착하는
			-- 높이가 실제 바닥보다 계속 떠 보인다(유저 실측 확인: 아이템이 바닥에 안 붙고 공중에 떠있음).
			-- 등장 시작점(startUI)에만 오프셋을 남겨서 "몸에서 팡 튀어나오는" 연출은 그대로 유지한다.
			local groundUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(Vector2(worldPos.x, groundWorldY)))
			groundUI = Vector2(groundUI.x, groundUI.y + landYCorrection)
			self:PlayFallSpin(icon, startUI, groundUI, fallHeight, continueFromGround)
		else
			continueFromGround(Vector2(rawUI.x, rawUI.y + landYCorrection))
		end
	end

	@ExecSpace("Multicast")
	method void RequestPotionCollectNow()
		if self:IsServer() then return end
		if not self._potionFlyActive then return end
		self._potionCollectRequested = true
		if self._potionLanded then
			self:TryFlyPotionToHpBar(self.potionFlyIcon, self._potionLandUI)
		end
	end

	@ExecSpace("ClientOnly")
	method void TryFlyPotionToHpBar(SpriteGUIRendererComponent icon, Vector2 landUI)
		if self._potionFlown then return end
		self._potionFlown = true
		self:FlyPotionToHpBar(icon, landUI)
	end

	@ExecSpace("ClientOnly")
	method void PlayDropPop(SpriteGUIRendererComponent icon, Vector2 startUI, any onLanded)
		-- 메이플 아이템 드롭 특유의 "톡 튀어나와 바닥에 안착" 모션: 좌우 랜덤 방향 큰 홉 1회 + 점점 작아지는 제자리 바운스 2회
		if not isvalid(icon) then return end
		local dir = (_UtilLogic:RandomDouble() < 0.5) and -1 or 1
		local landUI = Vector2(startUI.x + dir * (45 + _UtilLogic:RandomDouble() * 45), startUI.y)
		
		self:PlayHop(icon, startUI, landUI, 70, 0.32, function()
			self:PlayHop(icon, landUI, landUI, 24, 0.16, function()
				self:PlayHop(icon, landUI, landUI, 10, 0.11, function()
					if onLanded ~= nil then onLanded(landUI) end
				end)
			end)
		end)
	end

	@ExecSpace("ClientOnly")
	method void PlayHop(SpriteGUIRendererComponent icon, Vector2 fromUI, Vector2 toUI, number height, number duration, any onDone)
		-- fromUI → toUI 로 포물선(사인 아치)을 그리며 한 번 홉. fromUI==toUI면 제자리 바운스
		_TweenLogic:PlayTween(0.0, 1.0, duration, EaseType.QuadEaseOut, function(t)
			if not isvalid(icon) then return end
			local x = fromUI.x + (toUI.x - fromUI.x) * t
			local y = fromUI.y + (toUI.y - fromUI.y) * t + math.sin(t * math.pi) * height
			icon.Entity.UITransformComponent.anchoredPosition = Vector2(x, y)
		end)
		_TimerService:SetTimerOnce(function()
			if onDone ~= nil then onDone() end
		end, duration)
	end

	@ExecSpace("ClientOnly")
	method void FlyPotionToHpBar(SpriteGUIRendererComponent icon, Vector2 startUI)
		-- 포물선을 그리며 HP바 위치로 날아가는 동안 점점 작아지고 투명해진 뒤 사라지고, HP바를 살짝 펀치 + 반짝임 연출
		if not isvalid(icon) then return end
		local endUI = self.HpBarFlyTargetUI
		local arcHeight = 150
		
		_TweenLogic:PlayTween(0.0, 1.0, self.PotionFlyDuration, EaseType.QuadEaseOut, function(t)
			if not isvalid(icon) then return end
			local x = startUI.x + (endUI.x - startUI.x) * t
			local y = startUI.y + (endUI.y - startUI.y) * t + math.sin(t * math.pi) * arcHeight
			icon.Entity.UITransformComponent.anchoredPosition = Vector2(x, y)
			local scale = (1.0 - 0.5 * t) * self._potionDropScale
			icon.Entity.UITransformComponent.Scale = Vector3(scale, scale, 1)
			icon.Color = Color(1, 1, 1, 1.0 - 0.6 * t)
		end)
		
		_TimerService:SetTimerOnce(function()
			if not isvalid(icon) then return end
			icon.Entity:SetEnable(false)
			self._potionFlyActive = false
			self:PunchHpBar()
		end, self.PotionFlyDuration)
	end

	@ExecSpace("ClientOnly")
	method void PunchHpBar()
		-- 포션 도착 시 HP바를 잠깐 확대-축소시키고 반짝이 파티클을 재생해 도착감을 준다
		_TweenLogic:ScaleTo(self.hpBar.Entity, Vector2(1.06, 1.15), 0.12, EaseType.BackEaseOut)
		self:PlayHpSparkle()
		_TimerService:SetTimerOnce(function()
			if isvalid(self.hpBar) then
				_TweenLogic:ScaleTo(self.hpBar.Entity, Vector2(1, 1), 0.15, EaseType.QuadEaseOut)
			end
		end, 0.12)
	end

	@ExecSpace("ClientOnly")
	method void PlayHpSparkle()
		-- 반짝이 파티클을 재생하고, 재생 시간 동안 알파를 1→0으로 서서히 줄여 자연스럽게 사라지게 한다
		if self.hpSparkle == nil then return end
		self.hpSparkle.Color = Color(1, 0.9137254901960784, 0.6588235294117647, 1)
		self.hpSparkle:Play()
		_TweenLogic:PlayTween(1.0, 0.0, 0.5, EaseType.QuadEaseIn, function(a)
			if not isvalid(self.hpSparkle) then return end
			local c = self.hpSparkle.Color
			self.hpSparkle.Color = Color(c.r, c.g, c.b, a)
		end)
		_TimerService:SetTimerOnce(function()
			if isvalid(self.hpSparkle) then self.hpSparkle:Stop() end
		end, 0.5)
	end

	@ExecSpace("ServerOnly")
	method void AddGold(integer amount)
		-- 엘리트 몬스터 드롭 등 카드 강화와 무관한 보상에 사용. 런 내 골드(리셋됨)와 메인화면
		-- 우측 상단 누적 코인(영구 저장, TotalCoins)을 항상 같이 늘린다 — 골드를 지급하는 모든
		-- 지점은 이 메서드를 거쳐야 두 값이 어긋나지 않는다
		self.Gold = self.Gold + amount
		self.TotalCoins = self.TotalCoins + amount
		self._coinDirty = true
		_TitleUI:NotifyCoinsChanged(self.TotalCoins)
		log("Gold +" .. amount .. " -> " .. self.Gold .. " (TotalCoins:" .. self.TotalCoins .. ")")
	end

	@ExecSpace("ServerOnly")
	method boolean SpendCoins(integer amount)
		-- 메인화면 누적 코인(TotalCoins)에서 소비한다 — 유물 강화 등 런과 무관한 영구 진행 요소가 사용.
		-- 코인이 부족하면 false만 반환하고 아무것도 바꾸지 않는다
		if self.TotalCoins < amount then return false end
		self.TotalCoins = self.TotalCoins - amount
		self._coinDirty = true
		_TitleUI:NotifyCoinsChanged(self.TotalCoins)
		log("Coins -" .. amount .. " -> " .. self.TotalCoins)
		return true
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		if self._coinFlushTimerId then _TimerService:ClearTimer(self._coinFlushTimerId) end
		self:FlushCoinsIfDirty()
		self:FlushVoucherIfDirty()
	end

end