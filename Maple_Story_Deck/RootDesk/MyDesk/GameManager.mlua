				-- 오징어 노예간수와 같은 경로: 조금 떨어진 데서 멈춰 attack1 + 플레이어 자리 착탄 연출.
				name = "헹키",
				stand = "4bc588cffccd4d12980938aa96bd4a17",
				move = "bb6dd90947a94e5fb76adb131267b876",
				attack = "1d98754677ce4776b88c634acf6b6f53",
