			[126] = {"", "", ""},
			[127] = {"", "", ""},
			[128] = {"", "", "", ""},
			-- ep3_map4_ester_1(존1~5 = mapIndex129~133, 이스터에그 전용, 미배선) — 쿨리좀비(attack1)/
			-- 마이너좀비(attack2 전용, 원거리 연출)/플라이아이(없음)/미믹(없음)
			[129] = {"45206ab461ee40869ade8cefdfe58349", "5902420641eb43aa9f951a5638fda3b0"},
			[130] = {"5902420641eb43aa9f951a5638fda3b0", ""},
