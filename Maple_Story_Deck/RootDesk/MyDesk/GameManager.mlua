			[118] = {"d1dce4fdac0f4838b37af3c0fea8fd52", "992f9d470255469ca5bbe69d9551f790", "55966425813d4fa1bea67ad1018dcfb5", "a9e503154e3e4ad5ab0e9e7742dd53ec"},  -- 다크예티와페페/예티와페페/다크예티/예티
			-- 에피소드3 map4(119~128) — 주니어예티/다크주니어예티는 attack1이 없다(기존 99~103 존과 동일 컨벤션)
			[119] = {"", ""},
			[120] = {"", ""},
			[121] = {"", ""},
			[122] = {"", "", ""},
			[123] = {"", ""},
