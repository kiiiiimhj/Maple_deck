			[116] = {0.55, 0.85, 0.85},  -- 예티와페페/웨어울프/라이칸스로프
			[117] = {0.75, 1.25, 1.05},  -- 다크예티와페페/스노우맨/플라이아이
			[118] = {0.75, 0.55, 0.75, 0.75},  -- 다크예티와페페/예티와페페/다크예티/예티
			-- 에피소드3 map4(119~128) — 주니어예티/다크주니어예티(페이즈없는 팩 die1=5프레임=0.55초 기본값)
			[119] = {0.55, 0.55},
			[120] = {0.55, 0.55},
			[121] = {0.55, 0.55},
			[122] = {0.55, 0.55, 0.55},
			[123] = {0.55, 0.55},
			[124] = {0.55, 0.55, 0.55},
			[125] = {0.55, 0.55, 0.55},
			[126] = {0.55, 0.55, 0.55},
			[127] = {0.55, 0.55, 0.55},
			[128] = {0.55, 0.55, 0.55, 0.55},
		}
		local pool = pools[mapIndex]
		if pool == nil then return 0.5 end
		local i = math.max(1, math.min(idx, #pool))
		return pool[i]
	end

	-- 맵 전용 몬스터 풀 attack1 애니메이션 RUID. msw-search로 리소스팩(mob/*.img)을 직접 열어
	-- attack1 클립이 실제로 존재하는 종만 채워 넣었다 — 나머지(및 이 표에 없는 맵)는 빈 문자열로
	-- 두어 MonsterAI가 기존처럼 대체 연출(들이받기/잉크)을 쓰게 한다.
