			[128] = {"", "8049a8708de04238843f029debb2f51a", "", ""},  -- 블러드레인디어/다크주니어예티/플라이아이(비행)/스노우맨(원거리)
		}
		local pool = pools[mapIndex]
		if pool == nil then return "" end
		local i = math.max(1, math.min(idx, #pool))
		return pool[i]
	end

	-- 맵 전용 몬스터 풀 중 지그재그 접근(전진과 독립적으로 X를 사인파로 좌우 흔듦, MonsterAI._isZigzag) 대상
	-- 여부. 기존엔 존27~30(닌자, 잔상 포함)/존32~33(재규어)에 zoneIndex 단위로만 켜져 있었는데, 존 전체가
	-- 단일 종이거나 "비행형만 제외"로 충분했기 때문이다. 에피소드2 map2의 존7~10은 지그재그 종(루이넬류)과
	-- 비-지그재그 지상형 종(라이오너/샐리온류)이 한 존에 섞여 있어 zoneIndex만으로는 구분할 수 없다 —
	-- 그래서 idx까지 함께 보는 이 메서드로 통일한다(닌자/재규어존은 기존 zoneIndex 기준을 그대로 유지).
	@ExecSpace("ServerOnly")
	method boolean GetMapIsZigzag(integer mapIndex, integer idx)
		if mapIndex >= 27 and mapIndex <= 30 then return true end  -- 닌자존(전 종, 비행형은 호출측에서 이미 제외)
		if mapIndex == 32 then return true end  -- 재규어(단일 종)
		if mapIndex == 33 and idx == 2 then return true end  -- 재규어(2번째 종, 1번째는 비행형 바나나갈매기)
		if mapIndex == 61 and idx == 3 then return true end  -- 주니어루이넬
		if mapIndex == 62 and idx == 2 then return true end  -- 루이넬
		if mapIndex == 63 and idx == 3 then return true end  -- 주니어루이넬
		if mapIndex == 64 and idx == 3 then return true end  -- 루이넬
		-- 에피소드3 map1(89~98) 헥터/화이트팽(지그재그)
		if mapIndex == 91 and idx == 3 then return true end  -- 헥터
		if mapIndex == 93 and idx == 2 then return true end  -- 헥터
		if mapIndex == 94 and idx == 3 then return true end  -- 화이트팽
		if mapIndex == 96 and idx == 2 then return true end  -- 화이트팽
		if mapIndex == 97 and idx == 1 then return true end  -- 헥터
		if mapIndex == 98 and idx == 2 then return true end  -- 화이트팽
		return false
	end

