		if mapIndex == 118 and idx == 2 then return "e260beea27054249a6e6af8f29f6e840" end  -- 예티와페페
		if mapIndex == 118 and idx == 3 then return "e260beea27054249a6e6af8f29f6e840" end  -- 다크예티
		if mapIndex == 118 and idx == 4 then return "e260beea27054249a6e6af8f29f6e840" end  -- 예티
		-- 마이너좀비(원거리, ep3_map4_ester_1 129~133, 미배선) 히트 이펙트 — 몽실생크림과 동일 원칙으로
		-- 자기 팩 attack2/info/hit 서브클립 사용.
