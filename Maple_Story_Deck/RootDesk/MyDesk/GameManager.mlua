			[118] = {"2963a436d6074f4c83c9a2684d1df36c", "b95f1c447882480f874f4b45ddb0f33b", "8049a8708de04238843f029debb2f51a", "655c74418f4c4d65932641a375e7a4f5"},  -- 다크예티와페페/예티와페페/다크예티/예티
			-- 에피소드3 map4(119~128) — 주니어예티/다크주니어예티(페이즈없는 팩 voice 사운드 기본값)
			[119] = {"6f3ab281ca93458d9b122b8d5cbf60df", "53324cebb7744fe69b7c972568192375"},
			[120] = {"53324cebb7744fe69b7c972568192375", "53324cebb7744fe69b7c972568192375"},
			[121] = {"6f3ab281ca93458d9b122b8d5cbf60df", "6f3ab281ca93458d9b122b8d5cbf60df"},
			[122] = {"6f3ab281ca93458d9b122b8d5cbf60df", "53324cebb7744fe69b7c972568192375", "6f3ab281ca93458d9b122b8d5cbf60df"},
			[123] = {"53324cebb7744fe69b7c972568192375", "6f3ab281ca93458d9b122b8d5cbf60df"},
			[124] = {"53324cebb7744fe69b7c972568192375", "53324cebb7744fe69b7c972568192375", "6f3ab281ca93458d9b122b8d5cbf60df"},
			[125] = {"6f3ab281ca93458d9b122b8d5cbf60df", "53324cebb7744fe69b7c972568192375", "53324cebb7744fe69b7c972568192375"},
			[126] = {"6f3ab281ca93458d9b122b8d5cbf60df", "6f3ab281ca93458d9b122b8d5cbf60df", "53324cebb7744fe69b7c972568192375"},
			[127] = {"53324cebb7744fe69b7c972568192375", "6f3ab281ca93458d9b122b8d5cbf60df", "6f3ab281ca93458d9b122b8d5cbf60df"},
			[128] = {"6f3ab281ca93458d9b122b8d5cbf60df", "53324cebb7744fe69b7c972568192375", "6f3ab281ca93458d9b122b8d5cbf60df", "53324cebb7744fe69b7c972568192375"},
		}
		local pool = pools[mapIndex]
		if pool == nil then return "" end
		local i = math.max(1, math.min(idx, #pool))
		return pool[i]
	end

	@ExecSpace("ServerOnly")
	method number GetMapScaleMultiplier(integer mapIndex, integer idx)
		if mapIndex == 20 and idx == 2 then return 1.0 end  -- 페어리
		if mapIndex == 22 and idx == 1 then return 1.0 end  -- 로얄 페어리
		if mapIndex >= 19 and mapIndex <= 22 then return 0.68 end  -- 골렘류
		if mapIndex == 31 and idx == 1 then return 1.15 end  -- 루팡
		if mapIndex == 32 and idx == 1 then return 0.9 end  -- 재규어
		if mapIndex == 33 and idx == 1 then return 0.7225 end  -- 바나나갈매기(비행형, 0.85에서 15% 추가 축소: 0.85*0.85)
		if mapIndex == 33 and idx == 2 then return 0.9 end  -- 재규어(재사용)
		if mapIndex == 34 and idx == 1 then return 0.7225 end  -- 바나나갈매기(비행형, 재사용, 0.85*0.85)
		if mapIndex == 34 and idx == 2 then return 1.15 end  -- 좀비루팡
		-- 몽실생크림(에피소드3 map1) — 유저 지정: "크기가 너무크네 한 40줄여주고"
		if mapIndex == 95 and idx == 1 then return 0.6 end  -- 몽실생크림
		if mapIndex == 97 and idx == 2 then return 0.6 end  -- 몽실생크림
		if mapIndex == 98 and idx == 3 then return 0.6 end  -- 몽실생크림
		-- 예티/다크예티/예티와페페/다크예티와페페(에피소드3 map2) — 유저 지정: "너무 큰데 크기 15%줄이고".
		-- 1페이즈(예티와페페 등)/2페이즈 목표(예티 성체 등) 전 슬롯에 동일하게 적용해서, 변신 전후로
		-- 크기가 갑자기 바뀌어 보이지 않는다(ReviveAsPhase2Generic이 스케일을 따로 안 건드리므로, 스폰
		-- 시점에 이미 같은 배율이면 변신해도 자연스럽게 이어짐).
		if mapIndex == 104 and idx == 1 then return 0.85 end  -- 예티
		if mapIndex == 105 and idx == 1 then return 0.85 end  -- 다크예티
		if mapIndex == 105 and idx == 3 then return 0.85 end  -- 예티
		if mapIndex == 106 and idx == 1 then return 0.85 end  -- 예티와페페
		if mapIndex == 106 and idx == 2 then return 0.85 end  -- 다크예티
		if mapIndex == 107 and idx == 1 then return 0.85 end  -- 다크예티와페페
		if mapIndex == 107 and idx == 2 then return 0.85 end  -- 예티와페페
		if mapIndex == 107 and idx == 3 then return 0.85 end  -- 예티
		if mapIndex == 108 and idx == 1 then return 0.85 end  -- 다크예티와페페
		if mapIndex == 108 and idx == 2 then return 0.85 end  -- 예티와페페
		if mapIndex == 108 and idx == 3 then return 0.85 end  -- 다크예티
		-- 에피소드3 map3(109~118)에 재등장하는 예티류(114~118)도 동일하게 0.85.
		if mapIndex == 114 and idx == 1 then return 0.85 end  -- 예티
		if mapIndex == 115 and idx == 1 then return 0.85 end  -- 다크예티
		if mapIndex == 116 and idx == 1 then return 0.85 end  -- 예티와페페
		if mapIndex == 117 and idx == 1 then return 0.85 end  -- 다크예티와페페
		if mapIndex == 118 and idx == 1 then return 0.85 end  -- 다크예티와페페
		if mapIndex == 118 and idx == 2 then return 0.85 end  -- 예티와페페
		if mapIndex == 118 and idx == 3 then return 0.85 end  -- 다크예티
		if mapIndex == 118 and idx == 4 then return 0.85 end  -- 예티
		-- 웨어울프/라이칸스로프/스노우맨(원거리) — 유저 지정(2026-08-25): "크기 20% 줄이고". 플라이아이는
		-- 언급 안 됐으므로 기본값(1.0) 유지.
		if mapIndex == 109 and idx == 1 then return 0.8 end  -- 웨어울프
		if mapIndex == 109 and idx == 2 then return 0.8 end  -- 라이칸스로프
		if mapIndex == 110 and idx == 1 then return 0.8 end  -- 라이칸스로프
		if mapIndex == 111 and idx == 1 then return 0.8 end  -- 웨어울프
		if mapIndex == 111 and idx == 2 then return 0.8 end  -- 스노우맨
		if mapIndex == 112 and idx == 1 then return 0.8 end  -- 웨어울프
		if mapIndex == 112 and idx == 2 then return 0.8 end  -- 라이칸스로프
		if mapIndex == 113 and idx == 1 then return 0.8 end  -- 스노우맨
		if mapIndex == 114 and idx == 2 then return 0.8 end  -- 웨어울프
		if mapIndex == 114 and idx == 3 then return 0.8 end  -- 라이칸스로프
		if mapIndex == 115 and idx == 2 then return 0.8 end  -- 스노우맨
		if mapIndex == 116 and idx == 2 then return 0.8 end  -- 웨어울프
		if mapIndex == 116 and idx == 3 then return 0.8 end  -- 라이칸스로프
		if mapIndex == 117 and idx == 2 then return 0.8 end  -- 스노우맨
		return 1.0
	end

	@ExecSpace("ServerOnly")
	method integer GetMapHitEffectMaxConcurrent(integer mapIndex, integer idx)
		if mapIndex == 104 and idx == 1 then return 3 end
		if mapIndex == 105 and idx == 1 then return 3 end
		if mapIndex == 105 and idx == 3 then return 3 end
		if mapIndex == 106 and idx == 1 then return 3 end
		if mapIndex == 106 and idx == 2 then return 3 end
		if mapIndex == 107 and idx == 1 then return 3 end
		if mapIndex == 107 and idx == 2 then return 3 end
		if mapIndex == 107 and idx == 3 then return 3 end
		if mapIndex == 108 and idx == 1 then return 3 end
		if mapIndex == 108 and idx == 2 then return 3 end
		if mapIndex == 108 and idx == 3 then return 3 end
		-- 에피소드3 map3(109~118)에 재등장하는 예티류(114~118)도 동일하게 3. 스노우맨은 유저 지정이
		-- 없어 기본값(1) 유지.
		if mapIndex == 114 and idx == 1 then return 3 end  -- 예티
		if mapIndex == 115 and idx == 1 then return 3 end  -- 다크예티
		if mapIndex == 116 and idx == 1 then return 3 end  -- 예티와페페
		if mapIndex == 117 and idx == 1 then return 3 end  -- 다크예티와페페
		if mapIndex == 118 and idx == 1 then return 3 end  -- 다크예티와페페
		if mapIndex == 118 and idx == 2 then return 3 end  -- 예티와페페
		if mapIndex == 118 and idx == 3 then return 3 end  -- 다크예티
		if mapIndex == 118 and idx == 4 then return 3 end  -- 예티
		return 1
	end

