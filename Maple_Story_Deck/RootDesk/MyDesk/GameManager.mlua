	-- 방향은 매번 랜덤).
	property number KeyApproachArcWidth = 45

	-- 회복 포션 RUID (CardManager의 포션 강화 아이콘과 동일한 스프라이트 재사용 — 빨간 포션/하얀 포션)
	property string RedPotionRUID = "234aca1a4ce946119b68e3717991e775"

	property string WhitePotionRUID = "289c7bdcbdc8484ab7bad688b2519ca7"

	-- 보스 처치 확정 드롭 — 체력 완전회복 + 모든 스킬 쿨타임 즉시 초기화 (potionType=3, 포션과 동일한
	-- 낙하→HP바 비행 연출을 재사용하되 회복량 대신 전용 효과를 적용한다)
	property string PowerElixirRUID = "f2a7edd1b67a4f8cb4b85a33dc0230a2"

	-- 포션별 회복량 (최대 HP 비율)
	property number RedPotionHealPercent = 0.08

	property number WhitePotionHealPercent = 0.15

	-- HP바 비행 도착 지점 — ui/DefaultGroup.ui HPBar(anchoredPosition 20,265 + size 200,28)의 중심을
	-- 화면 중앙 기준 좌표(DropFlyIcon과 동일한 좌표계)로 환산한 값
	property Vector2 HpBarFlyTargetUI = Vector2(-840, -261)

	-- 포션이 HP바에 도착했을 때 재생하는 반짝이 파티클
	property UIBasicParticleComponent hpSparkle = "e0306988-7548-462c-aae9-8a3d82664c99"

	-- 드롭 팝 연출(PlayDropPop 내부 3단계 홉 0.32+0.16+0.11)과 HP바 비행(FlyPotionToHpBar) 시간 합 —
	-- 서버가 회복을 "포션이 HP바에 실제로 도착하는 시점"에 맞춰 적용하기 위한 기준값
	property number PotionPopDuration = 0.59

	property number PotionFlyDuration = 0.5
	-- 포션이 HP바에 닿아 체력이 오를 때 효과음(유저 지정 2026-09-23)
	property string PotionHealSoundRUID = "e8fc70a330c0478d8c2a9c703de5edd5"
	property number PotionHealSoundVolume = 0.6

	-- 클라이언트 전용: 포션 드롭 연출이 진행 중이면 true — 공용 potionFlyIcon을 덮어쓰지 않도록 가드
	property boolean _potionFlyActive = false

	property number _potionDropScale = 1.0

	-- 드롭 팝(홉) 애니메이션이 끝나 바닥에 착지했는지, 착지 지점이 어디인지 — 존 이탈로 조기 수거를
	-- 요청받았을 때 이미 착지해 있으면 그 자리에서 바로 HP바로 날아가게 하기 위해 기억해둔다
	property boolean _potionLanded = false

	property Vector2 _potionLandUI = Vector2(0, 0)

	-- 아직 홉 애니메이션 중일 때 조기 수거 요청이 왔으면 true로 세워두고, 착지 콜백에서 groundDelay
	-- 대기 없이 바로 날아가도록 한다
	property boolean _potionCollectRequested = false

	-- FlyPotionToHpBar가 이미 시작됐는지 — 조기 수거(RequestPotionCollectNow)와 정상 groundDelay 타이머
	-- 양쪽 경로 모두 착지 후에 이 메서드를 부를 수 있어서, 중복 호출(같은 포션이 두 번 날아가는 것처럼
	-- 보이는 버그)을 막는 가드가 필요하다
	property boolean _potionFlown = false

	property string ShadowVoucherIconRUID = "b4ef5ecaa6584954831a86bd844e287e"

	-- 존별 일시적 경험치 배율(기본 1.0) — ep2_map2_hidden(존85~88) 체류 중 3분짜리 경험치 2배
	-- 이벤트처럼, 특정 존에서만 한시적으로 적용되는 보너스를 위한 범용 훅이다. GameManager는 배율이
	-- "왜" 걸렸는지 몰라도 된다 — Ep2Map2HiddenExpBoostLogic이 존 입장/퇴장/타이머 만료에 맞춰
	-- 이 값만 1.0↔2.0으로 바꿔주면 GetExpPerKill이 자동으로 반영한다.
	property number ExpBoostMultiplier = 1.0

	-- 순수 시간 "단계" 기반 난이도(2026-08-03 3차 재설계 — 화력 비례 방식은 폐기) — 몬스터는 시간이
	-- 지나면 강해지는 게 맞지만(웨이브=킬레이트 기준이면 안 됨), 연속으로 계속 오르면 너무 가팔라진다.
	-- 2026-08-05(2차): 유저가 다시 재지정 — "0~2분까지만 100, 나머지 160/220/300/400/500, 그 뒤로 복리".
	-- 2분 단위 경계 지정이 없어서 균등 2분 간격(0~2/2~4/4~6/6~8/8~10/10~12)으로 가정했다 — 다르면
	-- 알려달라고 안내. 12분(마지막 지정 경계) 이후는 마지막 값(420, 2026-09-12 이전 500) 기준 ×1.15 복리로 계속 가팔라짐.
	property any _hpStepBoundarySeconds = { 120, 240, 360, 480, 600, 720 }  -- 각 계단이 "끝나는" 시각(초) — 2/4/6/8/10/12분

	-- 2026-09-12 유저 지정(A안): 6~12분 3칸 완화 300/400/500 → 260/330/420. 자동 생존 테스트 2판이 빌드와
	-- 무관하게 전부 6분 전후부터 HP가 깎여 무너져서(처치 속도가 스폰을 못 따라감) 이 구간만 낮췄다.
	property any _hpStepValues = { 100, 160, 220, 260, 330, 420 }

	-- ── 몬스터 공격력 전용 시간 계단 (2026-09-11 유저 지정) ──────────────────────────
	-- 체력(_hpStepBoundarySeconds, 2분 격자)과 **경계를 분리**했다. 유저가 "공격력만" 새 커브로
	-- 바꾸길 원했는데, 같은 경계를 공유하면 경계를 1분 격자로 당기는 순간 몬스터 체력까지 2배 가까이
	-- 앞당겨져 버리기 때문(2~3분 HP 100 → 220). 체력 커브는 손대지 않는다.
	--
	-- 초반은 1분 단위로 촘촘하게 오르고 뒤로 갈수록 계단 폭이 넓어진다:
	--   0~1 / 1~2 / 2~3 / 3~5 / 5~7 / 7~9 / 9~12 / 12~15 / 15~20 / 20~25분, 그 뒤 5분 간격
	-- 공격력 계단이 "끝나는" 시각(초). 2026-09-17 유저 지정으로 앞 구간을 넓혔다 —
	-- 3분→4분, 5분→7분으로 합쳐지면서 칸이 10개에서 9개로 줄었다(1/2/4/7/9/12/15/20/25분).
	-- ⚠ GetAtkTimeStep / GetWaveAttack 둘 다 하드코딩 인덱스가 아니라 #로 길이를 읽으므로
	-- 칸 수를 바꿔도 안 어긋난다. 단 attacks 표의 길이와 항상 같아야 한다.
	property any _atkStepBoundarySeconds = { 60, 120, 240, 420, 540, 720, 900, 1200, 1500 }

	-- 거대 네펜데스 2페이즈(부활 후 — 원거리 공격, 실제 사망) 고정 스탯. 네펜데스/다크네펜데스는 그냥
	-- 죽으면 끝 — 별도로 거대 네펜데스를 소환/변신시키지 않는다(유저 요청, 2026-08-10 최종 확정).
	-- 이 프로퍼티들은 존 풀 테이블에 하드코딩된 값과 일치시켜두는 참고용 상수이자 MonsterAI.ReviveAsPhase2가
	-- 실제로 읽어가는 값이다.
	-- ── 에피소드1 보스 로스터 (유저 지정 순서, 2026-09-07) ────────────────────────────
	-- 에피소드1 보스는 "그 존의 일반 몬스터가 2.5배로 커진 것"이 아니라 **전용 외형**을 쓴다.
	-- 보스가 여러 종이 되면서, 이제 **정해진 순서대로** 한 마리씩 나온다. 지금 몇 번째 차례인지는
	-- MonsterSpawner가 들고 있고(`GetEp1BossIndex`), 한 마리 잡을 때마다 다음 번호로 넘어간다.
	-- 마지막 보스까지 잡으면 다시 1번으로 순환한다.
	--   1번 = 블루 머쉬맘        (등장할 때 파란버섯 호위병 4마리를 좌우로 데리고 나온다.
	--                            보스가 죽으면 호위병도 전부 같이 죽는다)
	--   2번 = 가디언 엔젤 슬라임 (사망 시 분열체 4마리 — 아래 Ep1BossSplit* 참고)
	--   3번 = 스텀피             (원거리형 — 조금 떨어진 데서 서서 때리고, 플레이어 자리에 착탄 연출.
	--                            30초마다 attack2로 지하실 박쥐 2마리 소환)
	--   4번 = 다일               (맞을수록 커지고 빨라진다 — growScale*/growAtk*)
	--
	-- ⚠ **순서를 바꾸려면 GetEp1BossDef의 테이블 행 순서만 통째로 바꿔라.** 한 보스의 값이 한 행에
	-- 모여 있으므로 행을 옮기면 그 보스의 모든 값이 같이 따라온다(예전처럼 필드별 테이블로 쪼개면
	-- 한쪽만 옮겨 어긋난다 — 그래서 일부러 행 단위로 묶어뒀다).
	--
	-- ⚠ 재생시간(attackDur / dieDur)은 **추정하지 말고 실측할 것** — 팩마다, 심지어 **같은 팩 안의
	-- 프레임마다** 간격이 다르다(블루 머쉬맘 attack1 실측 = 0.800/0.200/0.050/0.050/0.750초.
	-- "프레임수 × 균등간격"으로 환산했으면 0.6초로 잡아 1/3만 재생하고 잘렸을 값이다).
	-- 측정법: play 중 client 컨텍스트에서
	--   local c = _ResourceService:LoadAnimationClipAndWait(ruid)
	--   local total = 0 ; for _, f in ipairs(c.Frames:ToTable()) do total = total + f.Delay end
	-- 값이 실제보다 길면 클립이 한 바퀴 더 돌아 "연출이 두 번 나온다"로 보이고, 사망 연출이면
	-- 본체가 그만큼 화면에 남는다. 짧으면 잘린다.
	@ExecSpace("ServerOnly")
	method integer GetEp1BossCount()
		-- 에피소드1 보스 순번의 총 개수(= 이 수를 넘기면 다시 1번으로 순환).
		return 4
	end

	@ExecSpace("ServerOnly")
	method any GetEp1BossDef(integer index)
		-- 에피소드1 보스 index번째(1부터)의 외형/사운드/크기/기믹 정의를 한 행으로 반환한다.
		-- 범위를 벗어난 번호는 1번으로 접는다(스포너가 순환시키지만 방어적으로 한 번 더).
		local defs = {
			{
				-- 1번: 블루 머쉬맘 (mob 팩, 유저 지정 2026-09-07). 특수 기믹 없음.
				name = "블루 머쉬맘",
				stand = "19482428daea4bd3adda9e0ab81dce98",   -- stand, 1프레임(정지 포즈)
				move = "96c51e680c0f4f67bf58ceb3f15f70d9",    -- move, 6프레임
				attack = "35f1f02f167d4b8992882490c311c955",  -- attack1, 5프레임
				attackDur = 1.85,                             -- 실측 합계(프레임 간격 불균등)
				hit = "bd8344a59c0e443a8dbfdc75c2251704",     -- hit1, 1프레임(0.600초)
				die = "262b25c6c08a4c96a27b5fc788ab2683",     -- die1, 6프레임
				dieDur = 1.10,                                -- 실측 합계
				attackSfx = "8b9ade41853e4fd9bff74482368b4160",  -- audio/Attack1
				-- 이 팩엔 die 사운드가 없다 — audio/Damage를 사망 비명으로 빌려 쓴다. 대신 피격음으로는
				-- 쓰지 않는다(맞을 때마다 같은 클립이 도배돼서, 엔젤 슬라임과 같은 정책으로 무음).
				dieSfx = "24520559d16847a0b0ac5468c5b9f75f",     -- audio/Damage
				-- 보스 공통 배율(×2.5) 위에 더 곱하는 값. 머쉬맘 스프라이트(120×112)는 일반 몬스터와
				-- 비슷한 크기라 공통 배율만 태우면 화면 절반을 덮는다 — 엔젤 슬라임의 화면상 크기와
				-- 비슷해지도록 맞췄다(최종 2.5 × 0.6 = 1.5배).
				scale = 0.6,
				-- 공격할 때 몬스터 자기 자신 위치에 같이 터지는 연출(팩의 attack1/info/effect — 포자 분출).
				-- 유저 지정 2026-09-07("같이 터지게"). 푼코/쿠스코가 쓰던 _selfAttackEffect 경로를 그대로 탄다.
				-- 지연 0인 이유(추측이 아니라 실측 근거): 이 이펙트 클립의 총 재생시간이 **1.850초로
				-- attack1과 정확히 같다**(15프레임 vs 5프레임인데 합이 동일). 즉 attack1과 처음부터
				-- 끝까지 같이 돌도록 만들어진 짝이라, 시작을 맞춰 띄우는 게 원본 의도다.
				selfFx = "58ad917a8d2c49d4af46d0ab31d6b0ae",
				selfFxDur = 1.85,
				selfFxDelay = 0,
				-- 근접형 — 플레이어 코앞까지 붙고, 플레이어 자리에 뜨는 착탄 연출은 없다
				ranged = false,
				hitFx = "",
				hitFxDur = 0,
				-- 2번째 공격(소환기)이 없는 보스 — summonCooldown이 0이면 소환 로직 자체가 안 돈다
				attack2 = "",
				attack2Dur = 0,
				attack2Sfx = "",
				summonCooldown = 0,
				summonCount = 0,
				summonFx = "",
				summonFxDur = 0,
				-- 맞을수록 성장하는 보스가 아니다(전부 0이면 성장 로직이 안 돈다)
				growScalePerHit = 0,
				growScaleMax = 0,
				growAtkPerHit = 0,
				growAtkMax = 0,
				-- 등장할 때 좌우로 데리고 나오는 호위병(유저 지정 2026-09-07: "조폭 두목과 쫄따구" 느낌).
				-- 소환기(summon*)와 달리 **보스가 뜰 때 딱 한 번** 같이 나오고, 보스가 죽으면 전부 같이
				-- 죽는다. 존을 옮기면 보스와 함께 따라온다(체력 유지).
				-- 이 팩엔 attack1이 없다 — 기존 정책대로 공격 모션 없는 종은 홉(들이받기)으로 때린다.
				escort = {
					name = "파란버섯",
					countPerSide = 2,                             -- 좌우 2마리씩 = 총 4마리
					-- 보스로부터 좌우 간격(월드 유닛). 보스는 접근하면서 커지는데(최종 폭 약 2유닛)
					-- 너무 좁으면 안쪽 2마리가 커진 보스에 가려진다 — 실측 후 1.1 → 1.4로 넓혔다.
					spacing = 1.4,
					stand = "37f823d5d9ad4468a6502ba195317ac1",   -- stand, 2프레임
					move = "cc2e07010a6b4023a2a90bffc0888e06",    -- move, 3프레임
					hit = "98ad22b370a5491b888d25adde7fb907",     -- hit1, 1프레임
					die = "1a9a5cc2eb0045bd96b57b3584555a96",     -- die1, 3프레임
					-- 실측 합계 0.660. "죽었다가 다시 나오는 것처럼 한 바퀴 더 도는" 증상이 보이면
					-- 0.62 정도로 살짝 낮추면 된다(존15 박쥐에서 겪었던 것과 같은 케이스).
					dieDur = 0.66,
					hitSfx = "869aea67272b44b7a2b12e9249432f87",  -- audio/Damage
					dieSfx = "6783b7baa93d49eba29b4d56332f0a7f",  -- audio/Die
					-- 그 시점 일반 몬스터 체력 대비 배율. 유저 지정(2026-09-07): 1.0으로 뒀더니 플레이어가
					-- 몇 초 만에 정리해버려서 "두목 옆 쫄따구" 그림이 남질 않았다 → **2배**.
					hpRatio = 2.0,
					scale = 1.0,
				},
				hasSplit = false,
			},
			{
				-- 2번: 가디언 엔젤 슬라임 (유저 지정 2026-09-06). 클립은 뽑기 보스레이드
				-- (GachaUI._bossSpecies의 "가디언 엔젤 슬라임")와 같은 리소스팩이다.
				name = "가디언 엔젤 슬라임",
				stand = "96af297ca7ff4bbc9fc58849ac3ba473",   -- stand, 24프레임
				move = "b7085b82b6224790a0bd5c8b2c844778",    -- move, 12프레임
				attack = "5126d2297418481894fc9f22456559c4",  -- attack1, 20프레임
				attackDur = 1.8,                              -- 실측: 20 × 0.090
				hit = "ffbd8c4990c04102a365a5078b72c332",     -- hit1, 1프레임
				-- ⚠ 사망 연출은 팩의 die1(b9b432c7…)이 아니라 **skill2** 클립이다 — 유저가 이 RUID를
				-- 콕 집어 지정했다. "죽는 모션이 좀 이상한데?" 소리가 나오면 die1로 바꾸는 자리.
				die = "22953ddb704e442f8b9e9d5c6419b78f",     -- skill2, 21프레임
				-- 클립은 21프레임(1.89초)이지만 **17프레임까지만 쓴다**(유저 지정) — 17 × 0.090 = 1.53초.
				-- 뒤 4프레임은 안 보여주고 그 시점에 알파가 빠지면서 분열이 터진다.
				dieDur = 1.53,
				attackSfx = "fe21c9f0eff348028577e5be813b2853",
				dieSfx = "5b862c8125ff400092c938c96b6bd678",
				-- 슬라임 스프라이트가 커서(stand 494×365, 사망 클립 717×531) 공통 배율만 태우면 화면을
				-- 다 덮는다 — 유저 지정으로 1/10로 줄였다가(0.1) "한 크기 키워달라"로 60% 올렸다.
				scale = 0.16,
				-- 이 보스는 공격 이펙트를 따로 안 쓴다(빈 문자열이면 PlaySelfAttackEffect가 그냥 리턴)
				selfFx = "",
				selfFxDur = 0,
				selfFxDelay = 0,
				ranged = false,
				hitFx = "",
				hitFxDur = 0,
				attack2 = "",
				attack2Dur = 0,
				attack2Sfx = "",
				summonCooldown = 0,
				summonCount = 0,
				summonFx = "",
				summonFxDur = 0,
				-- 맞을수록 성장하는 보스가 아니다(전부 0이면 성장 로직이 안 돈다)
				growScalePerHit = 0,
				growScaleMax = 0,
				growAtkPerHit = 0,
				growAtkMax = 0,
				hasSplit = true,
			},
			{
				-- 3번: 스텀피 (mob 팩, 유저 지정 2026-09-07). **원거리형** — 플레이어에게 붙지 않고
				-- 조금 떨어진 자리(RangedReachedScale)에서 멈춰 공격하고, 대신 플레이어가 서 있는
				-- 자리에 착탄 연출(hitFx)이 뜬다(네펜데스류와 동일한 _hitEffectRUID 경로).
				name = "스텀피",
				stand = "0b6c2f6faccc44da980ce832ab636bf6",   -- stand, 6프레임
				move = "36e33516befa4b2db894d0c7f105b97e",    -- move, 6프레임
				attack = "3a3034172ea14fe0b5e636604e352306",  -- attack1, 24프레임
				-- 실측 3.420초 — 이 팩 중 가장 긴 공격 모션이다. 공격 주기는 자동으로
				-- attackDur+0.7 = 약 4.1초가 된다(머쉬맘 2.55초). 너무 굼뜨면 이 값을 줄여
				-- 클립을 중간에 끊으면 되고(엔젤 슬라임이 21프레임 중 17프레임만 쓰는 것과 같은 방식),
				-- 그만큼 착탄 연출 타이밍(attackDur × 0.5)도 같이 당겨진다.
				attackDur = 3.42,
				hit = "68ca2cd0ecc04b318660b2b3f14e2acd",     -- hit1, 1프레임(0.600초)
				die = "e1b4fc8f0f0f4991b13728ad30c40039",     -- die1, 12프레임
				dieDur = 1.80,                                -- 실측 합계
				attackSfx = "05c2c35cb8d14ad59a0de03e6bd891fc",  -- audio/Attack1
				-- 이 팩은 머쉬맘과 달리 **전용 die 사운드가 있다**(audio/Die) — 빌려 쓸 필요 없음.
				dieSfx = "4c3420d74b6e4ef59493d09ec1edc5ca",     -- audio/Die
				-- 스텀피 원본 179×175. 머쉬맘(120×112, scale 0.6)과 화면상 비슷한 크기가 되도록 맞췄다.
				-- ⚠ 원거리형은 접근을 1.15(RangedReachedScale)에서 멈춘다 — 근접형(1.5)보다 23% 작게
				-- 끝나므로 그만큼 배율을 더 준 값이다(0.4로 잡았다가 실측 후 상향).
				-- 최종 높이 ≈ 175 × (2.5×0.5) × 1.15 ≈ 251px (머쉬맘 112 × 1.5 × 1.5 ≈ 252px).
				scale = 0.5,
				-- 자기 몸에서 터지는 연출은 안 쓴다(이 종은 플레이어 자리에 뜨는 착탄 연출을 쓴다)
				selfFx = "",
				selfFxDur = 0,
				selfFxDelay = 0,
				ranged = true,
				-- 유저 지정: "화면에 뿌려지는 공격 연출은 attack1/info/hit". 유저가 준 RUID는 그 클립의
				-- **0번 프레임 sprite**(d1f246f7…)였는데, 여기서는 3프레임짜리 **animationclip**을 쓴다 —
				-- 같은 이펙트의 움직이는 버전이고, 기존 원거리 종(_hitEffectRUID)도 전부 이 서브클립을
				-- 쓴다. 정지 그림이 낫다는 판단이면 저 sprite RUID로 한 줄만 바꾸면 된다.
				hitFx = "504e309cd9214acf94d450ed1c2a60a6",   -- attack1/info/hit, 3프레임
				hitFxDur = 0.27,                              -- 실측 합계
				growScalePerHit = 0,
				growScaleMax = 0,
				growAtkPerHit = 0,
				growAtkMax = 0,
				-- ── 2번째 공격 = 소환기(유저 지정 2026-09-07: "attack2는 원거리 공격이 아니라 소환") ──
				-- 30초마다 attack2 모션을 쓰면서 지하실 박쥐 2마리를 부른다. 소환 자리에 먼저 연출이
				-- 뜨고, 그 연출이 사라지는 동안 박쥐가 겹쳐서 서서히 나타난다(유저 지정).
				attack2 = "c2e78c4ac4924aa28e2892d108d22f73",  -- attack2, 24프레임
				attack2Dur = 3.42,                             -- 실측 합계
				attack2Sfx = "01c18b475d034421a49eceb0e8177dab",  -- audio/Attack2
				summonCooldown = 30,
				summonCount = 2,
				-- 소환 연출은 지하실 박쥐 팩의 attack1/info/hit/3 **sprite**(정지 그림) — 유저가 이
				-- RUID를 콕 집어 지정했다. 스프라이트라 자체 재생시간이 없어서 아래 시간만큼 띄웠다가
				-- 알파를 빼며 지운다.
				summonFx = "380f732f0f214368b2aad0bce3826e5e",
				summonFxDur = 0.7,
				-- 소환되는 부하 = 지하실 박쥐(비행형). hpRatio는 그 시점 일반 몬스터 체력 대비 배율.
				minion = {
					name = "지하실 박쥐",
					stand = "c0d1dd5966c945b9acb0af29c173faa0",   -- stand, 6프레임
					attack = "898688a3be7b41e082db00b95e2dbe02",  -- attack1, 11프레임(유저 지정)
					attackDur = 0.99,                             -- 실측 합계
					hit = "5bbe31964b654ddfbd36715de53200ba",     -- hit1, 1프레임(0.120초)
					die = "20259b51459644abb50e0b6a9e32c11c",     -- die1, 9프레임
					-- 실측은 0.810인데 일부러 조금 짧게 잡았다 — 이 종(존15 박쥐, GetMapDieDuration에서
					-- 0.75)은 실측값 그대로 쓰면 알파 0 타이머가 걸리기 전에 die1이 한 바퀴 더 돌아
					-- "죽었다 다시 나오는" 것처럼 보인 전력이 있다.
					dieDur = 0.78,
					attackSfx = "66c88e4029ac47e6941c8350c66b507f",  -- audio/Attack1
					hitSfx = "560f6c4fc6be40629da19c063e8b6501",     -- audio/Damage
					dieSfx = "f93c6a22784e439e81d42058c610ef13",     -- audio/Die
					hpRatio = 1.0,
					scale = 1.0,
				},
				hasSplit = false,
			},
			{
				-- 4번: 다일 (mob 팩, 유저 지정 2026-09-07). **맞을수록 커지고 빨라지는** 보스.
				-- 이 팩엔 attack1이 없다 — 유일한 공격 모션인 skill1을 공격 연출로 쓴다
				-- (엔젤 슬라임이 die1 대신 skill2를 사망 연출로 쓰는 것과 같은 방식).
				name = "다일",
				stand = "002f7f9d3abc49928a922e8eb3038cf1",   -- stand, 9프레임
				move = "99712d6acafb4374adc0b10ff16dcbca",    -- move, 6프레임
				attack = "75ec4896515b4423b1d3e26259426b32",  -- skill1, 13프레임(팩에 attack1 없음)
				attackDur = 1.56,                             -- 실측 합계
				hit = "794f9746118f4e73bc99f66c68f96286",     -- hit1, 1프레임(0.600초)
				die = "e133539edc3d486eaa17345a4859661d",     -- die1, 10프레임
				dieDur = 1.50,                                -- 실측 합계
				attackSfx = "16d3d57c44c445e59f43fd59ac3abd56",  -- audio/Skill1(공격 모션이 skill1이라 짝이 맞다)
				dieSfx = "197dac41590b4541accfec6a6bd0c7b6",     -- audio/Die
				-- 다일 원본 195×152. 다른 보스와 화면상 크기를 맞추면 0.44인데, 유저 지정으로
				-- **기본 크기를 20% 줄여서** 0.44 × 0.8 = 0.35로 시작한다(맞으면서 커지는 보스라
				-- 처음부터 크면 최대 성장 시 화면을 덮는다).
				scale = 0.35,
				selfFx = "",
				selfFxDur = 0,
				selfFxDelay = 0,
				ranged = false,
				hitFx = "",
				hitFxDur = 0,
				attack2 = "",
				attack2Dur = 0,
				attack2Sfx = "",
				summonCooldown = 0,
				summonCount = 0,
				summonFx = "",
				summonFxDur = 0,
				-- 유저 지정(2026-09-07). 3단계에 걸쳐 확정됐다:
				--   1차 "크기 4%/공속 2%, 상한 40%/30%" → 2차 "타당 증가폭 2배(8%/4%)"
				--   → 3차 "공격속도 상한 0.5로, 크기도 그에 맞게" ← 지금 값
				-- 공속 상한 0.30 → 0.50(×1.667)에 맞춰 크기 상한도 같은 비율로 0.40 → 0.67로 올렸다
				-- (원래 크기:공속 = 4:3 비율을 그대로 유지 — 0.50 × 4/3 ≈ 0.67).
				-- 상한 도달까지: 크기 9대(0.67/0.08) / 공격속도 13대(0.50/0.04).
				-- 만렙 시 화면상 크기 ≈ 도달스케일 1.5 × 0.875 × 1.67 = 2.19배, 공격 주기 2.26 → 1.51초.
				-- 크기는 에르다스가 쓰던 성장 배율 경로를 그대로 재사용하고(_erdasHitGrowthBonus —
				-- OnUpdate의 스케일 대입 두 곳에 이미 물려 있다), 공격속도는 공격 주기를 나눈다.
				growScalePerHit = 0.08,
				growScaleMax = 0.67,
				growAtkPerHit = 0.04,
				growAtkMax = 0.50,
				hasSplit = false,
			},
		}
		if index < 1 or index > #defs then index = 1 end
		return defs[index]
	end

	-- ── 에피소드1 엘리트 로스터 (유저 지정, 2026-09-08) ──────────────────────────────
	-- 예전 엘리트는 "그 존의 일반 몬스터 1마리를 승급시킨 것"이라 외형이 존마다 제각각이었다.
	-- 이제 보스 로스터와 동일하게 **전용 외형 4종**으로 고정한다(스탯은 그대로 MarkElite의 ×1.15).
	--   1번 = 버섯 샹들리에    (지상 근접)
	--   2번 = 오징어 노예간수  (원거리 — 조금 떨어진 데서 서서 때리고, 플레이어 자리에 착탄 연출)
	--   3번 = 푸른 샘의 정령   (지상 근접)
	--   4번 = 블랙 나이트      (비행 — attack1 모션으로 때리되 유저 지정 타격 이미지를 원거리처럼 띄운다)
	--
	-- 등장 순서는 **가방(shuffled bag) 방식**이다 — MonsterSpawner.DrawEliteIndex가 전담한다(에피 무관 공용).
	-- 첫 엘리트는 무조건 1번(버섯 샹들리에)이고, 그 뒤로는 아직 안 나온 종 중에서만 무작위로 뽑는다.
	-- 4종이 전부 한 번씩 나오면 가방을 다시 4종으로 채워 전체 무작위로 돌아간다.
	--
	-- ⚠ **순서를 바꾸려면 아래 테이블 행 순서만 통째로 바꿔라** — 보스 로스터와 같은 이유로
	-- 한 종의 값이 한 행에 모여 있다. 단, "첫 엘리트 = 1번"은 인덱스 1 고정이므로 1행이 곧 첫 등장 종이다.
	--
	-- ⚠ attackDur/dieDur/hitFxDur은 추정이 아니라 **실측값**이다(2026-09-08, play 중 client 컨텍스트에서
	--   local c = _ResourceService:LoadAnimationClipAndWait(ruid)
	--   local total = 0 ; for _, f in ipairs(c.Frames:ToTable()) do total = total + f.Delay end
	-- 로 직접 잰 프레임 delay 합계):
	--   버섯 샹들리에 attack1 16f/1.920 die1 14f/1.680
	--   오징어 노예간수 attack1 12f/1.440 die1 15f/1.350 hit 4f/0.600
	--   푸른 샘의 정령 attack1 21f/2.520 die1 15f/1.830
	--   블랙 나이트    attack1 24f/3.360 die1  7f/1.200
	@ExecSpace("ServerOnly")
	method integer GetEp1EliteCount()
		-- 에피소드1 엘리트 종의 총 개수(= 가방을 다시 채울 때 들어가는 종 수).
		return 4
	end

	@ExecSpace("ServerOnly")
	method any GetEp1EliteDef(integer index)
		-- 에피소드1 엘리트 index번째(1부터)의 외형/사운드/크기/거동 정의를 한 행으로 반환한다.
		-- 범위를 벗어난 번호는 1번으로 접는다(스포너가 가방으로 관리하지만 방어적으로 한 번 더).
		local defs = {
			{
				-- 1번: 버섯 샹들리에 (resource_pack "mob/3300100.img"). 첫 엘리트 고정 — 유저 지정.
				name = "버섯 샹들리에",
				stand = "9cf209c91b424956b14e801c6698cf5b",
				move = "be70606da9bc41da9067b70c6cfbd00f",
				attack = "63c14432ae8b4a33ba4299b278373bee",
				attackDur = 1.92,
				hit = "9b68e2aadf1e4af8b651cba4c5aca83b",
				die = "4ecca28a3dde4a2fa67bf21791e9f690",
				dieDur = 1.68,
				attackSfx = "36c773b1e4924948baa5fea21b2d51e5",
				hitSfx = "ccb582524dfe41cca177b25937b7e675",
				dieSfx = "4e6f72baeb654faa8aab5416114ac4e1",
				-- 원본 104×84 — 일반 몬스터와 비슷한 크기. 유저 지정(2026-09-08) "엘리트 크기 15%씩 다 늘려줘"
				-- 로 기준 1.0 → 1.15(최종 엘리트 공통 ×1.15 × 1.15)
				scale = 1.15,
				flying = false,
				ranged = false,
				hitFx = "",
				hitFx2 = "",
				hitFxDur = 0,
				hitFxDelay = 0,
				flyAttackInterval = 0,
			},
			{
				-- 2번: 오징어 노예간수 (resource_pack "mob/3300108.img"). 유저 지정 "원거리" —
				-- 기존 원거리 종과 동일하게 조금 떨어진 자리(RangedReachedScale)에서 멈춰 attack1을
				-- 재생하고, 플레이어가 서 있는 자리에 팩의 attack1/info/hit 클립을 착탄 연출로 띄운다.
				name = "오징어 노예간수",
				stand = "0597262707f8408f88de9ef96c57e7c8",
				move = "84e01e5bde504430b31a245fbdd776f3",
				attack = "efc2fbd6022e481b8b3bfe880c566b73",
				attackDur = 1.44,
				hit = "205950b877fc49279cd652546d935e88",
				die = "fe6a03bbd61b46509a0eb52af52c4166",
				dieDur = 1.35,
				attackSfx = "f4aba16ad2f0494b8c98514be3f1b2c5",
				hitSfx = "77f5d84f00e841a8a6873e33999c9687",
				dieSfx = "912181ef97e04ab1bacfb67b6c839251",
				-- 원본 107×96. 유저 지정 15% 증가(1.0 → 1.15)
				scale = 1.15,
				flying = false,
				ranged = true,
				hitFx = "388ff58e2d7e4d82933f8e5cafa78e6b",  -- attack1/info/hit, 4프레임
				hitFx2 = "",
				-- ⚠ 0.60(=클립 실측 길이 4×0.150)으로 두면 파괴 시점과 1바퀴 완료가 정확히 겹쳐
				-- 2바퀴째 첫 프레임이 한 순간 보인다 = 유저가 리포트한 "연출이 루프된다"(2026-09-08).
				-- 마지막 4번째 프레임(0.450~0.600 구간) 재생 도중에 지우도록 살짝 줄인다.
				hitFxDur = 0.55,
				-- 유저 지정(2026-09-08): "공격 모션 8프레임에 타격 연출이 나가야 함".
				-- attack1 실측 = 12프레임 전부 0.120초 균등(총 1.440초)이므로 8번째 프레임이 시작되는
				-- 시점 = 앞 7프레임 합 = 7 × 0.120 = 0.840초.
				hitFxDelay = 0.84,
				flyAttackInterval = 0,
			},
			{
				-- 3번: 푸른 샘의 정령 (resource_pack "mob/3501108.img"). 지상 근접.
				name = "푸른 샘의 정령",
				stand = "882af790938d427591cef1fce348e53e",
				move = "3a4775167ab94ba8a997b3253dcaa925",
				attack = "8529c03d07c048a7bee0f6769ed2bb41",
				attackDur = 2.52,
				hit = "747412fef02d4795a6395574aa3760ca",
				die = "e31322669bf1479897959dd00256ebbd",
				dieDur = 1.83,
				attackSfx = "7d9a2946bbb54d078e96911a78de397f",
				hitSfx = "4d3709b634404e39ad27544c912cd1f8",
				dieSfx = "eac4de6c1f2c4f71b27868612682af96",
				-- 원본 108×144(세로로 긴 편). 유저 지정 15% 증가(1.0 → 1.15)
				scale = 1.15,
				flying = false,
				ranged = false,
				hitFx = "",
				hitFx2 = "",
				hitFxDur = 0,
				hitFxDelay = 0,
				flyAttackInterval = 0,
			},
			{
				-- 4번: 블랙 나이트 (resource_pack "mob/9500673.img"). 유저 지정:
				-- "비행, 어택1로 공격하고 화면에 원거리처럼 타격 이미지 보이게".
				-- → flying=true(배회는 비행형 사인파) + attack(attack1 모션 재생) +
				--   hitFx(플레이어 자리에 뜨는 착탄 연출, 유저가 직접 준 RUID).
				-- hitFx는 animationclip이 아니라 **sprite**(정지 그림, 100×108 — 이 팩의
				-- attack1/info/hit/0)라 자체 재생시간이 없다 — hitFxDur은 화면에 머무는 시간이며
				-- 다른 원거리 종의 기본값(0.5초)을 그대로 쓴다.
				name = "블랙 나이트",
				stand = "64b593069c9f429a9407d2f057ff392e",
				-- 비행형은 접근 이동이 없어 move 클립을 쓰지 않는다(항상 stand로 떠 있다)
				move = "",
				attack = "9e1ea028230c4ec9947005bd3753e659",
				attackDur = 3.36,
				hit = "00764132adb74eb8906c8f04f1a40942",
				die = "58ea0028340a408286d0d217aecda2e2",
				dieDur = 1.20,
				attackSfx = "adf8b1eede764f229c0773a7b9e8e8e9",
				hitSfx = "07050581cb9041c693904e5d3f626419",
				dieSfx = "e4c33a5a53244ea2825e41ecd901b653",
				-- 원본 65×92로 다른 3종(104~108폭)보다 눈에 띄게 좁다 — 화면상 존재감을 맞추려고
				-- 여기만 추가 배율(1.3)을 준 뒤, 유저 지정 15% 증가를 곱했다(1.3 × 1.15 = 1.495)
				scale = 1.495,
				flying = true,
				ranged = false,
				-- 착탄 연출은 이 팩에서 **정지 스프라이트 2장**(attack1/info/hit/0 → /1)으로 쪼개져 있다.
				-- 유저 지정(2026-09-08) "0,1 둘 다 재생" — hitFxDur의 절반씩 순차로 보여준다(0.25초씩).
				hitFx = "18ec4ebc8bdd48c69297180f7c573775",   -- attack1/info/hit/0
				hitFx2 = "663a541fac2e4c41bd38143384d0bb15",  -- attack1/info/hit/1
				hitFxDur = 0.50,
				-- 유저 지정(2026-09-08): "타격 연출 9프레임에 나와야 함".
				-- ⚠ attack1 프레임 간격은 **균등하지 않다**(실측: 1~12프레임 0.130초 / 13~24프레임 0.150초,
				-- 총 24프레임 3.360초). 9번째 프레임이 시작되는 시점 = 앞 8프레임 합 = 8 × 0.130 = 1.040초.
				-- (균등이라 가정하고 3.36÷24로 환산했으면 1.12초로 틀렸을 값이다.)
				hitFxDelay = 1.04,
				-- 비행형은 도달 판정 없이 FlyAttackInterval(1.5초)마다 계속 때리는데, 이 종의 attack1은
				-- 실측 3.36초로 그보다 훨씬 길다 — 그대로 두면 이전 연출이 끝나기 전에 다음 공격이 겹쳐
				-- 들어와 attack1이 영원히 중간에서 다시 시작한다(웨어울프/마노에서 겪은 것과 같은 케이스).
				-- 지상형이 쓰는 것과 같은 공식(재생시간 + 0.7초 휴식)으로 이 개체만 주기를 늘린다.
				flyAttackInterval = 4.06,
			},
		}
		if index < 1 or index > #defs then index = 1 end
		return defs[index]
	end

	-- ── 에피소드2 엘리트 로스터 (유저 지정, 2026-09-08) ────────────────────────────
	-- 에피1 엘리트와 **완전히 같은 def 스키마**라 가방(shuffled bag)·승급·좌표 재배치 인프라가
	-- 코드 수정 없이 그대로 돌아간다. 유저 지정: 4종 전부 "어택 + 화면 타격 연출" 둘 다 있어야 한다
	-- (에피1은 2종만 착탄 연출이 있었다).
	--   1번 = 도둑 까마귀          (지상 근접)
	--   2번 = 목마른 유령          (비행)
	--   3번 = 가고일 나이트        (비행)
	--   4번 = 심연의 마스터 레쉬   (지상 근접)
	--
	-- ⚠ 재생시간은 전부 **실측**(2026-09-08, LoadAnimationClipAndWait의 프레임 delay 합):
	--   도둑 까마귀   attack1 27f/3.240(균등 0.120) die1 14f/1.890(0.150×7 + 0.120×7) 착탄 6f/0.720
	--   목마른 유령   attack1 14f/1.680(균등 0.120) die1 14f/1.680 착탄 6f/0.720
	--   가고일 나이트 attack1 17f/2.700(0.150×12 + 0.180×5) die1 15f/2.700 착탄 4f/0.480
	--   심연의 레쉬   attack1 15f/1.350(균등 0.090) die1 11f/0.990 착탄은 정지 스프라이트 7장(수동 이어붙이기)
	--
	-- ⚠ scale은 에피1 엘리트의 화면 폭(버섯 샹들리에 104px × 엘리트공통 1.15 × def 1.15 ≈ 137px)에
	-- 맞춘 값이다: def.scale = 137.5 ÷ (원본 폭 × 1.15). 최종 배율 = 엘리트 공통 ×1.15 × 이 값.
	--
	-- ⚠ 팩마다 없는 리소스가 있어 아래 예외를 뒀다:
	--   · 가고일 나이트: stand/move가 없고 **fly** 클립만 있다 → stand에 fly를 넣고 move는 빈 문자열.
	--     오디오도 _audio/Damage 하나뿐이라 공격음은 없고, 사망음은 Damage를 빌려 쓴다
	--     (블루 머쉬맘·엘리쟈와 같은 정책).
	--   · 심연의 마스터 레쉬: 합쳐진 attack1/info/hit 클립이 없고 **정지 스프라이트 7장**뿐이다
	--     → hitFxFrames로 수동 이어붙이기(프레임당 0.090초 — 이 팩 attack1과 같은 간격).
	@ExecSpace("ServerOnly")
	method integer GetEp2EliteCount()
		-- 에피소드2 엘리트 종의 총 개수(= 가방을 다시 채울 때 들어가는 종 수).
		return 4
	end

	@ExecSpace("ServerOnly")
	method any GetEp2EliteDef(integer index)
		-- 에피소드2 엘리트 index번째(1부터)의 외형/사운드/크기/거동 정의를 한 행으로 반환한다.
		local defs = {
			{
				-- 1번: 도둑 까마귀 (resource_pack "mob/9001013.img"). 지상 근접.
				name = "도둑 까마귀",
				stand = "d2ca89aebaa641bba3f4d29c75abeec7",
				move = "5c2c8ca152a04e578d30830ff3b4d9d8",
				attack = "5c56fef68a454e6089af87bd2f102850",
				attackDur = 3.24,
				hit = "9cb6b105102940919378e361dd6abd87",
				die = "0b831c5baa814723ba5790b31b8d7898",
				dieDur = 1.89,
				attackSfx = "8e1382f8937845fbaeb0c078b343145c",
				hitSfx = "70b4c565e9884c52892b68725303b92f",
				dieSfx = "12584ba117c14ce38756c44048e3bbe1",
				-- 원본 112×116 → 137.5 ÷ (112 × 1.15) ≈ 1.067에서 유저 지정 **15% 축소**(2026-09-08)
				-- → 1.067 × 0.85 ≈ 0.907
				scale = 0.907,
				flying = false,
				ranged = false,
				-- attack1/info/hit(6f/0.720 실측). 0.72 그대로 두면 소멸과 루프 복귀가 겹쳐 깜빡인다
				-- (오징어 노예간수에서 겪은 함정) — 마지막 프레임 재생 도중에 지우도록 살짝 줄인다.
				hitFx = "b9ec8900ec6844a1acdb5efac8ca2833",
				hitFx2 = "",
				hitFxDur = 0.68,
				-- 0 = 기존 공식(attackDur × 0.5 = 1.62초). 특정 프레임에 맞추려면 초를 직접 적는다.
				hitFxDelay = 0,
				hitFxFrames = nil,
				hitFxFrameDelay = 0,
				flyAttackInterval = 0,
			},
			{
				-- 2번: 목마른 유령 (resource_pack "mob/9500580.img"). 유저 지정 "비행".
				-- ⚠ 이 팩은 이름이 둘("목마른 유령" / "달콤 초코크림")이고 그림은 **초코크림 유령**이다
				-- (썸네일 육안 확인 2026-09-08). "목마른 유령"으로 검색되는 팩은 이것 하나뿐이다.
				name = "목마른 유령",
				stand = "aca2381fee22480db9be87fa9fd10409",
				-- 비행형은 접근 이동이 없어 move 클립을 쓰지 않는다(항상 stand로 떠 있다)
				move = "",
				attack = "b883820e46e2419ea5583c7ebb651944",
				attackDur = 1.68,
				hit = "6ab8fd6a06be40e78537b7f87ad5356a",
				die = "1d8ba252bc704c77b2093f29c9687793",
				dieDur = 1.68,
				attackSfx = "fcbd94b35ea447618a90f5a165735f13",
				hitSfx = "922eb5ecf54f4d62ab4d93964a17c798",
				dieSfx = "f0f9f988d5bd44eaabcce64f8cd66b63",
				-- 원본 181×190(로스터에서 가장 큰 편) → 137.5 ÷ (181 × 1.15) ≈ 0.66
				scale = 0.66,
				flying = true,
				ranged = false,
				hitFx = "0a91445d7e6f4dd4aefcfa287920625b",
				hitFx2 = "",
				hitFxDur = 0.68,
				hitFxDelay = 0,
				hitFxFrames = nil,
				hitFxFrameDelay = 0,
				-- 비행형 공용 주기(1.5초)보다 attack1(1.68초)이 길다 — 지상형과 같은 공식으로 늘린다
				flyAttackInterval = 2.38,
			},
			{
				-- 3번: 가고일 나이트 (resource_pack "mob/9300620.img"). 유저 지정 "비행".
				name = "가고일 나이트",
				-- ⚠ 이 팩엔 stand/move가 없다 — 떠 있는 자세인 **fly** 클립을 stand로 쓴다
				stand = "4dd5e61470fe41b2bdabb69bb4f7efaa",
				move = "",
				attack = "a2bdcb070feb4abe81fdab509f2b3815",
				attackDur = 2.70,
				hit = "d14ca6adb55840d0959b4b3c2dc30ac6",
				die = "fa37b5e1f2ff402fb91b84f7d4a2bca6",
				dieDur = 2.70,
				-- ⚠ 이 팩의 오디오는 _audio/Damage 하나뿐이다 — 공격음은 없고(빈 문자열),
				-- 사망음은 Damage를 비명으로 빌려 쓴다(블루 머쉬맘·엘리쟈와 같은 정책).
				attackSfx = "",
				hitSfx = "31b1ef54bf8b4856b622f888849b18cd",
				dieSfx = "31b1ef54bf8b4856b622f888849b18cd",
				-- 원본 131×101 → 137.5 ÷ (131 × 1.15) ≈ 0.912에서 유저 지정 **15% 확대**(2026-09-08)
				-- → 0.912 × 1.15 ≈ 1.049
				scale = 1.049,
				flying = true,
				ranged = false,
				-- attack1/info/hit(4f/0.480 실측). 이 팩 착탄은 보라색 베기 자국 몇 줄로 **연하다**.
				hitFx = "7cd371e5acce46079ac46c9281d6362a",
				hitFx2 = "",
				hitFxDur = 0.44,
				hitFxDelay = 0,
				hitFxFrames = nil,
				hitFxFrameDelay = 0,
				-- attack1 2.70초 > 비행 공용 주기 1.5초 — 지상형과 같은 공식으로 늘린다
				flyAttackInterval = 3.40,
			},
			{
				-- 4번: 심연의 마스터 레쉬 (resource_pack "mob/9834302.img"). 지상 근접.
				name = "심연의 마스터 레쉬",
				stand = "049cbe28245a4280afb6c5117d000ddc",
				move = "adb4deae4fa74e54bdc86db50d74d9a9",
				attack = "b8e0764973dd476aacf23a203982f41f",
				attackDur = 1.35,
				hit = "e58fe03f2e7143519ac5c5af878eeb70",
				die = "0b8fa50f73b046678c935965ac0f56fe",
				dieDur = 0.99,
				attackSfx = "54af4ee6df2948d1b8d591d36fd7fc78",
				hitSfx = "70c856bb6bd94750b0220219e80207d3",
				dieSfx = "4122b76fef50470cb2a6431904daa09c",
				-- 원본 212×176(로스터 최대) → 137.5 ÷ (212 × 1.15) ≈ 0.564
				scale = 0.564,
				flying = false,
				ranged = false,
				-- ⚠ 이 팩엔 합쳐진 attack1/info/hit 클립이 **없고** 정지 스프라이트 7장뿐이다
				-- (attack1/info/hit/0~6, 초록 별폭발). 그래서 hitFx 대신 hitFxFrames로 수동 이어붙인다 —
				-- MonsterAI.PlayRangedHitEffect가 프레임 목록이 있으면 그쪽 경로로 넘긴다.
				hitFx = "",
				hitFx2 = "",
				-- 7장 × 0.090초(이 팩 attack1과 같은 프레임 간격) = 0.630초
				hitFxDur = 0.63,
				hitFxDelay = 0,
				hitFxFrames = {
					"43c95cde3d29477aa90455f783438976",  -- hit/0 100×84
					"46bbead986cb4389987b91f96c62efeb",  -- hit/1 240×240
					"981f089514c44f8baabb3f847108e2bd",  -- hit/2 240×240
					"cd0c28234d0e490c8a94a4abade77c00",  -- hit/3 240×240
					"ab316f477ab0424b887bf4955f8c1d66",  -- hit/4 228×228
					"f51e5f7372dc45109da540a6dd039ee4",  -- hit/5 200×200
					"e343aed743294b9587d36b2daacf90ab",  -- hit/6 172×164
				},
				hitFxFrameDelay = 0.09,
				flyAttackInterval = 0,
			},
		}
		if index < 1 or index > #defs then index = 1 end
		return defs[index]
	end

	-- ── 에피소드3 엘리트 로스터 (유저 지정, 2026-09-12) ──────────────────────────────
	-- 에피1·2와 **같은 def 스키마** + 선택 키 2개(charge / chargeWindup — 없으면 nil이라 기존 종은 무관).
	--   1. 호브 헥터 (mob/9300276.img) — 유저 지정 "돌진형". 첫 엘리트 = 이 종 고정(가방 규칙).
	--   2. 정예 핀호브 (mob/9300278.img) — 지상 근접.
	--   3. 흉폭한 호브 (mob/9300280.img) — 지상 근접.
	--   4. 헹키 (mob/7130004.img) — 유저 지정 "원거리".
	-- (컴뱃 호브 mob/9300279는 유저 지정으로 제외.)
	-- 재생시간은 전부 클라 LoadAnimationClipAndWait로 프레임 Delay를 합산한 실측값(2026-09-12).
	-- scale은 137.5 ÷ (원본 **긴 변** × 1.15) — 이 로스터엔 세로로 긴 종(핀호브 84×107, 헹키 89×101)이 있어
	-- 폭 기준으로 잡으면 한 종만 1.4배로 커진다. 넷 다 원본이 100px 안팎이라 긴 변 기준이 화면 크기를 고르게 맞춘다.
	@ExecSpace("ServerOnly")
	method integer GetEp3EliteCount()
		-- 에피소드3 엘리트 종의 총 개수(= 가방을 다시 채울 때 들어가는 종 수).
		return 4
	end

	@ExecSpace("ServerOnly")
	method any GetEp3EliteDef(integer index)
		-- 에피소드3 엘리트 index번째(1부터)의 외형/사운드/크기/거동 정의를 한 행으로 반환한다.
