				-- 원본 457×419(로스터 최대) → 70 ÷ 457 ≈ 0.153
				scale = 0.153,
				selfFx = "",
				selfFxDur = 0,
				selfFxDelay = 0,
				ranged = false,
				hitFx = "",
				hitFxDur = 0,
				hitFxDelay = 0,
				attack2 = "",
