				-- → 피격 성장은 에피1 다일/에피2 망치병과 같은 growScale·growAtk 경로 재사용,
				--   공격 순환은 attackVariants(3슬롯, 소환 없음).
				name = "익스트림 빅풋",
				stand = "b22baa415a664534bf06fe25188d96d8",
				move = "2e4afb862df34b93b9b157f88e7b7817",
				attack = "0cbe35a70ac84fa2a3095a4659c3e93e",
				attackDur = 1.89,
