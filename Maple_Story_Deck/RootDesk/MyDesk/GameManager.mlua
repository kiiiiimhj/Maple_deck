	property number DespairBladeOrbAlpha = 0.75

	-- 아이템 드롭 등장 Y 좌표 보정 (죽은 위치를 화면 좌표로 환산한 값에 더해 살짝 위로 띄운다)
	property number DropYOffset = 60

	-- 드롭(잡템/포션/카드 공용) 착지 지점 Y 보정 — 몬스터 사망 위치(WorldPosition)를 그대로 착지 좌표로
	-- 쓰면 타일 표면보다 살짝 낮게 보정되어 아이템이 바닥을 뚫고 내려간 것처럼 보인다(유저 실측 확인).
	-- 착지 시점에만 이만큼 위로 올린다 — 등장 시작점(DropYOffset)과는 별개다
	property number DropLandYOffset = 30

	-- 깊이(dropScale) 보정 — 몬스터 스프라이트가 의사3D 깊이 시스템(MonsterAI._currentScale)으로 작아질수록
	-- (멀리, 뒤쪽에서 잡힐수록) 중심 피벗 기준 축소라 발이 실제 WorldPosition보다 화면상 더 위로 보인다.
	-- dropScale이 1(가까움)에 가까울수록 보정 0, 0.75(가장 멂 — GetEffectScaleRatio 하한)에 가까울수록
	-- 이 값의 최대치만큼 DropLandYOffset에 추가로 더한다 — 뒤에서 잡힌 몬스터일수록 보정량이 자동으로
	-- 커지므로 앞/뒤 몬스터에 서로 다른 보정이 걸린다(유저 실측: 멀리서 죽은 몬스터의 드롭일수록 더 깊이 파고들어 보임)
	property number DropLandDepthCompensation = 100

	-- 잡템/포션/카드 드롭이 공통으로 쓰는 착지 Y 보정치. dropScale은 각 드롭 시점에 계산되는
	-- CardManager.GetEffectScaleRatio(mob) 값을 그대로 넘겨받는다(죽은 몬스터가 화면상 얼마나
	-- 멀리/뒤에 있었는지)
	-- 에피2 map1 열쇠 이스터에그(object-3428_75) 전용 — 표준 드롭(펑 튀어나와 바운스)과 달리 오브젝트
	-- 위치에서 작게 시작해 점점 커지며 다가와 바닥에 착지하는 연출(PlayApproachDropVisual)의 소요 시간
	property number KeyApproachDuration = 0.9

	-- 버그 수정(2026-08-21, 유저 지정: "지금 수직 낙하하는데 살짝 포물선으로 떨어지면 더 좋을듯") —
	-- 시작점과 착지점의 x가 같아서(오브젝트 바로 아래로 착지) 그대로 두면 완전히 수직으로 떨어져 보였다.
	-- sin(t*pi)로 이동 경로 중간에만 옆으로 살짝 부풀렸다가 착지 시점엔 다시 0으로 돌아오게 해서(시작/
	-- 착지 좌표 자체는 그대로 유지) 포물선처럼 휘어져 떨어지는 것처럼 보이게 한다(UI px 기준, 좌우
	-- 방향은 매번 랜덤).
	property number KeyApproachArcWidth = 45

	-- 회복 포션 RUID (CardManager의 포션 강화 아이콘과 동일한 스프라이트 재사용 — 빨간 포션/하얀 포션)
	property string RedPotionRUID = "234aca1a4ce946119b68e3717991e775"

	property string WhitePotionRUID = "289c7bdcbdc8484ab7bad688b2519ca7"

	-- 보스 처치 확정 드롭 — 체력 완전회복 + 모든 스킬 쿨타임 즉시 초기화 (potionType=3, 포션과 동일한
	-- 낙하→HP바 비행 연출을 재사용하되 회복량 대신 전용 효과를 적용한다)
	property string PowerElixirRUID = "f2a7edd1b67a4f8cb4b85a33dc0230a2"

	-- 포션별 회복량 (최대 HP 비율)
	property number RedPotionHealPercent = 0.08

	property number WhitePotionHealPercent = 0.15

	-- HP바 비행 도착 지점 — ui/DefaultGroup.ui HPBar(anchoredPosition 20,265 + size 200,28)의 중심을
	-- 화면 중앙 기준 좌표(DropFlyIcon과 동일한 좌표계)로 환산한 값
	property Vector2 HpBarFlyTargetUI = Vector2(-840, -261)

	-- 포션이 HP바에 도착했을 때 재생하는 반짝이 파티클
	property UIBasicParticleComponent hpSparkle = "e0306988-7548-462c-aae9-8a3d82664c99"

	-- 드롭 팝 연출(PlayDropPop 내부 3단계 홉 0.32+0.16+0.11)과 HP바 비행(FlyPotionToHpBar) 시간 합 —
	-- 서버가 회복을 "포션이 HP바에 실제로 도착하는 시점"에 맞춰 적용하기 위한 기준값
	property number PotionPopDuration = 0.59

	property number PotionFlyDuration = 0.5

	-- 클라이언트 전용: 포션 드롭 연출이 진행 중이면 true — 공용 potionFlyIcon을 덮어쓰지 않도록 가드
	property boolean _potionFlyActive = false

	property number _potionDropScale = 1.0

	-- 드롭 팝(홉) 애니메이션이 끝나 바닥에 착지했는지, 착지 지점이 어디인지 — 존 이탈로 조기 수거를
	-- 요청받았을 때 이미 착지해 있으면 그 자리에서 바로 HP바로 날아가게 하기 위해 기억해둔다
	property boolean _potionLanded = false

	property Vector2 _potionLandUI = Vector2(0, 0)

	-- 아직 홉 애니메이션 중일 때 조기 수거 요청이 왔으면 true로 세워두고, 착지 콜백에서 groundDelay
	-- 대기 없이 바로 날아가도록 한다
	property boolean _potionCollectRequested = false

	-- FlyPotionToHpBar가 이미 시작됐는지 — 조기 수거(RequestPotionCollectNow)와 정상 groundDelay 타이머
	-- 양쪽 경로 모두 착지 후에 이 메서드를 부를 수 있어서, 중복 호출(같은 포션이 두 번 날아가는 것처럼
	-- 보이는 버그)을 막는 가드가 필요하다
	property boolean _potionFlown = false

	property string ShadowVoucherIconRUID = "b4ef5ecaa6584954831a86bd844e287e"

	-- 존별 일시적 경험치 배율(기본 1.0) — ep2_map2_hidden(존85~88) 체류 중 3분짜리 경험치 2배
	-- 이벤트처럼, 특정 존에서만 한시적으로 적용되는 보너스를 위한 범용 훅이다. GameManager는 배율이
	-- "왜" 걸렸는지 몰라도 된다 — Ep2Map2HiddenExpBoostLogic이 존 입장/퇴장/타이머 만료에 맞춰
	-- 이 값만 1.0↔2.0으로 바꿔주면 GetExpPerKill이 자동으로 반영한다.
	property number ExpBoostMultiplier = 1.0

	-- 순수 시간 "단계" 기반 난이도(2026-08-03 3차 재설계 — 화력 비례 방식은 폐기) — 몬스터는 시간이
	-- 지나면 강해지는 게 맞지만(웨이브=킬레이트 기준이면 안 됨), 연속으로 계속 오르면 너무 가팔라진다.
	-- 2026-08-05(2차): 유저가 다시 재지정 — "0~2분까지만 100, 나머지 160/220/300/400/500, 그 뒤로 복리".
	-- 2분 단위 경계 지정이 없어서 균등 2분 간격(0~2/2~4/4~6/6~8/8~10/10~12)으로 가정했다 — 다르면
	-- 알려달라고 안내. 12분(마지막 지정 경계) 이후는 마지막 값(500) 기준 ×1.15 복리로 계속 가팔라짐.
	property any _hpStepBoundarySeconds = { 120, 240, 360, 480, 600, 720 }  -- 각 계단이 "끝나는" 시각(초) — 2/4/6/8/10/12분

	property any _hpStepValues = { 100, 160, 220, 300, 400, 500 }

	-- 거대 네펜데스 2페이즈(부활 후 — 원거리 공격, 실제 사망) 고정 스탯. 네펜데스/다크네펜데스는 그냥
	-- 죽으면 끝 — 별도로 거대 네펜데스를 소환/변신시키지 않는다(유저 요청, 2026-08-10 최종 확정).
	-- 이 프로퍼티들은 존 풀 테이블에 하드코딩된 값과 일치시켜두는 참고용 상수이자 MonsterAI.ReviveAsPhase2가
	-- 실제로 읽어가는 값이다.
	property string GiantNepenthesStandRUID = "886d6be444184e68b0afc64787e954b3"

	property string GiantNepenthesHitRUID = "b1e10364d7ea466888f7f47ef003a6a2"

	property string GiantNepenthesDieRUID = "de99d3f275ee45cca15499da5030732e"

	property number GiantNepenthesDieDuration = 0.95  -- 9프레임 실측

	property string GiantNepenthesHitSoundRUID = "284272e75e314f109b029492bb414c9d"

	property string GiantNepenthesDieSoundRUID = "d256f6a4ecd44de5989a2cc761cfeffb"

	-- 2페이즈 원거리 공격(attack1, 가시 발사류 포즈) — 유저 요청: "원거리 공격이고 리소스는 두번째
	-- 제이슨에 다있어". 존 몬스터 풀(GetMapAttackRUID 등)에는 등록하지 않는다 — 거대 네펜데스는
	-- 1페이즈로 스폰돼 처음엔 _neverAttacks=true라 attackRUID 자체가 쓰이지 않고, 2페이즈로 부활한
	-- 순간에만 MonsterAI가 이 값을 직접 읽어간다.
	property string GiantNepenthesAttackRUID = "e825245dc11548828c63e2a85fe9ada9"

	property number GiantNepenthesAttackDuration = 0.95  -- 9프레임 실측

	property string GiantNepenthesAttackSoundRUID = "e51a6be9ae184a6dbeac7c0693f53e96"

	-- 원거리 히트 이펙트(attack1/info/hit 서브클립) — 유저 요청: "문어처럼(먹물쏘는거) 얘네도 원거리니깐
	-- 같은 방식으로 히트 이펙트 나와야해". 네펜데스/다크네펜데스와 동일하게 MonsterAI.PlayRangedHitEffect가
	-- 플레이어 위치에 재생한다.
	property string GiantNepenthesHitEffectRUID = "bba719e6ae0049409e76562224bc3603"

	-- 공식값(0.05+0.1*5=0.55)에서 낮춤 — 네펜데스류 히트 이펙트와 동일한 "루프 두 번" 문제 방지(유저
	-- 요청: "연출이 1번만 루프되야함")
	property number GiantNepenthesHitEffectDuration = 0.42

	-- 거대 네펜데스 1페이즈(첫 등장 — 패시브, 공격 없음) 전용 외형. 죽으면(1페이즈 사망 연출) 실제로는
	-- 죽지 않고 위 2페이즈 스탯으로 부활한다(MonsterAI.DieAndRevivePhase1/ReviveAsPhase2). 1페이즈
	-- 리소스팩(mob/9300378)엔 hit1이 없어 피격 시 스프라이트/사운드 교체 없이 데미지 숫자만 뜬다(의도적).
	property string GiantNepenthesPhase1StandRUID = "0f285fb7a373471a97604f2d28bc54a7"

	property string GiantNepenthesPhase1DieRUID = "f33024cc36ca413696fa90cb98655864"

	property number GiantNepenthesPhase1DieDuration = 0.95  -- 9프레임 실측

	property string GiantNepenthesPhase1DieSoundRUID = "a1288c9a3d2845babadf4f5fe25dd423"

	-- 무기 드롭(유저 지정: 킬당 0.05%, 태초의 마을 전 구간 공통 — 보스/엘리트/그림자존 등 몬스터 종류 무관).
	-- 등급은 노말 90% / 매직 10%로 굴리고(유저 지정), 품질(F~S)은 등급과 무관하게 동일한 확률표
	-- (QualityEnum.RollDropQuality())로 별도로 굴린다. ATK는 그 등급+품질 구간 내에서 1회 확정 롤
	-- (WeaponTierDataLogic.RollAtk) 후 영구 저장. 잡템과 달리 로비 전용 장비 인벤토리(PkgPlayerInventory)에
	-- 직접 지급 — 가방(_PlayerInventory)이 아니다.
	property number WeaponDropMagicChance = 0.10

	method number GetDropLandYCorrection(number dropScale)
		return self.DropLandYOffset + math.max(0, 1.0 - dropScale) * self.DropLandDepthCompensation
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 존마다 독립적인 허리케인이 동시에 여러 개 활성화될 수 있으므로 전부 갱신한다.
		if self._hurricaneEntities ~= nil then
			local activeZones = {}
			for zoneIdx, _ in pairs(self._hurricaneEntities) do table.insert(activeZones, zoneIdx) end
			for i = 1, #activeZones do
				self:UpdateHurricaneMovement(activeZones[i], delta)
			end
		end
		if self._globalFreezeActive then
			self._globalFreezeRemaining = self._globalFreezeRemaining - delta
			if self._globalFreezeRemaining <= 0 then
				self._globalFreezeActive = false
				self._globalFreezeRemaining = 0
			end
		end
		
		-- 타임어택 카운트다운은 당연히 타임어택 모드에서만 돈다
		if self.TimeAttackMode and self.GameStarted and not self.GameOver then
			if not self._timeAttackOvertimeActive then
				self.TimeAttackRemaining = self.TimeAttackRemaining - delta
				if self.TimeAttackRemaining <= 0 then
					self.TimeAttackRemaining = 0
					self:SpawnDespairBlade()
				end
			end
		end
		
		-- ⚠ 절망의 칼날 틱은 TimeAttackMode 조건 "밖"에 있어야 한다. 이 몹은 타임어택 오버타임뿐
		-- 아니라 빠른 이동 안전장치 3단계(MapManager.RegisterZoneArrival, 9연속 이동)로도 소환되는데,
		-- 예전엔 틱이 TimeAttackMode 분기 안에 있어서 일반 모드로 9연속 이동해 소환된 칼날은
		-- 따라오지도 공격하지도 않고 소환 위치에 가만히 떠 있기만 했다(유저 리포트로 발견).
		if self._timeAttackOvertimeActive and self.GameStarted and not self.GameOver then
			self:UpdateDespairBlade(delta)
		end
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self._scarecrowEntities = {}
		self._scarecrowTimerIds = {}
		self._hurricaneEntities = {}
		self._hurricaneTargets = {}
		self._hurricaneEndTimerIds = {}
		self._hurricaneHitCooldownsByZone = {}
		self.PlayerHp = self.PlayerMaxHp
		self.Exp = 0
		self.ExpNeeded = 120
		self.Gold = 0
		self.Level = 1
		self.Wave = 1
		self.GameOver = false
		self:NotifyExpChanged(self.Exp, self.ExpNeeded, self.Level, false)
		
		-- 누적 코인은 런과 무관하게 전역 저장소에서 불러온다 (RelicInventory와 동일한 dirty-flag 패턴)
		self._coinStorage = _DataStorageService:GetGlobalDataStorage("PlayerCoins")
		local errorCode, raw = self._coinStorage:GetAndWait("TotalCoins")
		if errorCode == 0 and raw ~= nil and raw ~= "" then
			local loaded = tonumber(raw)
			if loaded ~= nil then self.TotalCoins = loaded end
		end
		self._coinFlushTimerId = _TimerService:SetTimerRepeat(function()
			self:FlushCoinsIfDirty()
			self:FlushVoucherIfDirty()
			self:FlushDiamondIfDirty()
		end, 3.0)
		
		-- 야누스의 검 교환권도 TotalCoins와 동일하게 전역 저장소에서 불러온다
		self._voucherStorage = _DataStorageService:GetGlobalDataStorage("PlayerCoins")
		local voucherErrorCode, voucherRaw = self._voucherStorage:GetAndWait("ShadowVoucher")
		if voucherErrorCode == 0 and voucherRaw ~= nil and voucherRaw ~= "" then
			local loadedVoucher = tonumber(voucherRaw)
			if loadedVoucher ~= nil then self.ShadowVoucher = loadedVoucher end
		end
		
		-- 다이아도 같은 스토리지("PlayerCoins")에 별도 키로 얹는다. 저장된 값이 아예 없을 때만
		-- (= 이 월드에서 다이아를 처음 만나는 유저) 시작 지급을 하고 즉시 dirty로 찍어 저장되게 한다 —
		-- 이미 0으로 저장된 유저(다 써버린 유저)에게 다시 지급되면 안 되므로 "값 없음"과 "0"을 구분한다
		self._diamondStorage = _DataStorageService:GetGlobalDataStorage("PlayerCoins")
		local diamondErrorCode, diamondRaw = self._diamondStorage:GetAndWait("Diamond")
		if diamondErrorCode == 0 and diamondRaw ~= nil and diamondRaw ~= "" then
			local loadedDiamond = tonumber(diamondRaw)
			if loadedDiamond ~= nil then self.Diamond = loadedDiamond end
		else
			self.Diamond = self.DiamondStartingAmount
			self._diamondDirty = true
			log("GameManager: first-time diamond grant = " .. self.Diamond)
		end
		
		log("GameManager started")
	end

	@ExecSpace("Server")
	method void RequestCoinSync()
		-- TitleUI.OnBeginPlay가 호출한다. TotalCoins는 @Sync라 자동 전파되지만, 서버가 스토리지에서
		-- 불러오는(OnBeginPlay, GetAndWait) 시점과 클라이언트가 자기 UI를 초기화하는 시점 사이에는
		-- 순서 보장이 없다 — 클라이언트가 먼저 뜨면 아직 로드 전인 기본값(0)을 그대로 표시해버려서
		-- "코인이 초기화된 것처럼 보이는" 버그가 된다. 클라이언트가 준비된 시점에 직접 요청(pull)하면
		-- 그 시점 서버는 이미 OnBeginPlay를 끝낸 뒤이므로(월드 시작이 클라이언트 접속보다 항상 먼저다)
		-- 항상 정확한 값을 받을 수 있다
		_TitleUI:NotifyCoinsChanged(self.TotalCoins)
	end

	@ExecSpace("ServerOnly")
	method void FlushCoinsIfDirty()
		-- SetAndWait를 쓴다 — Async 콜백을 기다리지 않고 OnEndPlay가 먼저 끝나버리면(에디터/월드 종료 시)
		-- 저장이 씹힐 수 있어서, 드물게 호출되는 이 경로는 블로킹 저장으로 확실히 반영되게 한다
		if not self._coinDirty then return end
		self._coinDirty = false
		self._coinStorage:SetAndWait("TotalCoins", tostring(self.TotalCoins))
	end

	@ExecSpace("ServerOnly")
	method void FlushVoucherIfDirty()
		if not self._voucherDirty then return end
		self._voucherDirty = false
		self._voucherStorage:SetAndWait("ShadowVoucher", tostring(self.ShadowVoucher))
	end

	@ExecSpace("ServerOnly")
	method void FlushDiamondIfDirty()
		-- 코인/교환권과 동일한 지연 flush. 뽑기는 연타될 수 있어서 차감할 때마다 저장하지 않고
		-- 3초 타이머에 모아서 한 번만 쓴다
		if not self._diamondDirty then return end
		self._diamondDirty = false
		self._diamondStorage:SetAndWait("Diamond", tostring(self.Diamond))
	end

	@ExecSpace("Server")
	method void RequestDiamondSync()
		-- RequestCoinSync와 같은 이유 — 클라이언트가 준비된 시점에 직접 당겨와야 서버 스토리지
		-- 로드 전의 기본값(0)을 잠깐 표시하는 문제가 안 생긴다
		_TitleUI:NotifyDiamondChanged(self.Diamond)
	end

	@ExecSpace("ServerOnly")
	method void AddDiamond(integer amount)
		self.Diamond = self.Diamond + amount
		self._diamondDirty = true
		_TitleUI:NotifyDiamondChanged(self.Diamond)
	end

	@ExecSpace("ServerOnly")
	method boolean SpendDiamond(integer amount)
		-- 뽑기 결제. 부족하면 false만 반환하고 아무것도 바꾸지 않는다
		if self.Diamond < amount then return false end
		self.Diamond = self.Diamond - amount
		self._diamondDirty = true
		_TitleUI:NotifyDiamondChanged(self.Diamond)
		return true
	end

	-- 존16~17 몬스터 처치 시 MonsterAI.Die()가 호출 — 확률 판정 후 성공하면 1개 지급.
	-- 일반 잡템과 동일하게 사망 위치에서 바닥에 떨어졌다가 가방으로 날아가는 연출을 보여준 뒤 지급한다
	@ExecSpace("ServerOnly")
	method void TryDropShadowVoucher(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		if self.GameOver then return end
		if _UtilLogic:RandomDouble() >= self.ShadowVoucherDropChance then return end
		self:ScheduleLootDrop(worldPos, self.ShadowVoucherIconRUID, fallHeight, groundWorldY, function()
			self:AddShadowVoucher(1)
		end, dropScale)
		log("ShadowVoucher dropped!")
	end

	@ExecSpace("ServerOnly")
	method void AddShadowVoucher(integer amount)
		self.ShadowVoucher = self.ShadowVoucher + amount
		self._voucherDirty = true
		_ShadowShopUI:NotifyVoucherChanged(self.ShadowVoucher)
	end

	@ExecSpace("ServerOnly")
	method boolean SpendShadowVoucher(integer amount)
		-- 그림자 숲 샵 구매 결제. 부족하면 false만 반환하고 아무것도 바꾸지 않는다
		if self.ShadowVoucher < amount then return false end
		self.ShadowVoucher = self.ShadowVoucher - amount
		self._voucherDirty = true
		_ShadowShopUI:NotifyVoucherChanged(self.ShadowVoucher)
		return true
	end

	@ExecSpace("Server")
	method void RequestGachaSpend(integer cost, integer count, boolean isSkill)
		-- 뽑기 결제 요청. 잔액 검증/차감은 서버에서만 하고, 성공했을 때만 요청한 클라이언트에게
		-- 연출 시작을 허가한다(실패하면 아무 응답도 보내지 않아 팝업이 그대로 대기 상태로 남는다).
		-- 실제 보상 지급(RequestAddRelic / RequestAddSkill)은 기존과 동일하게 연출이 끝나는 시점에
		-- 클라이언트가 개별로 요청한다 — 결제만 이 경로로 앞당겼다.
		if not self:SpendDiamond(cost) then
			log("RequestGachaSpend: not enough diamond (cost=" .. cost .. ", have=" .. self.Diamond .. ")")
			return
		end
		_GachaUI:OnGachaSpendApproved(count, isSkill, senderUserId)
	end

	-- HP/EXP 동기화 → UI 갱신
	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		if name == "PlayerHp" or name == "PlayerMaxHp" then
			self.hpBar.MaxValue = self.PlayerMaxHp
			self.hpBar.Value = self.PlayerHp
			self.hpText.Text = tostring(math.floor(self.PlayerHp / self.PlayerMaxHp * 100)) .. "%"
			if name == "PlayerHp" and self.PlayerHp < self._prevPlayerHp then
				self:ShakeCameraOnHit()
			end
			self._prevPlayerHp = self.PlayerHp
		elseif name == "Gold" then
			self.goldText.Text = ": " .. self.Gold
		elseif name == "TimeAttackMode" then
			self.timeAttackTimerBg.Enable = self.TimeAttackMode
			self:RefreshTimeAttackTimerUI()
		elseif name == "TimeAttackRemaining" then
			self:RefreshTimeAttackTimerUI()
		end
	end

	-- 타임어택 카운트다운 HUD 텍스트를 MM:SS로 갱신한다. TimeAttackRemaining이 매 프레임 바뀌는
	-- @Sync 값이라 OnSyncProperty를 통해 계속 호출된다.
	@ExecSpace("ClientOnly")
	method void RefreshTimeAttackTimerUI()
		if not self.TimeAttackMode then return end
		local remaining = math.max(0, math.floor(self.TimeAttackRemaining))
		local minutes = math.floor(remaining / 60)
		local seconds = remaining % 60
		self.timeAttackTimerText.Text = string.format("%02d:%02d", minutes, seconds)
	end

	@ExecSpace("ClientOnly")
	method void InitPlayerNameUI()
		-- 로비 진입 시 TitleUI가 1회 호출 — 하드코딩된 "Player" 대신 실제 유저 닉네임을 표시한다
		local localPlayer = _UserService.LocalPlayer
		if localPlayer ~= nil and localPlayer.PlayerComponent ~= nil then
			self.playerNameText.Text = localPlayer.PlayerComponent.Nickname
		end
	end

	-- 경험치 바 갱신 연출. @Sync 프로퍼티 갱신과 이 Multicast 호출은 서로 다른 채널이라 순서 보장이
	-- 없어서(다른 곳에서 이미 한번 겪은 문제), self.Exp/ExpNeeded/Level을 클라이언트에서 다시 읽지 않고
	-- 서버가 확정한 값을 파라미터로 직접 넘긴다 — 레벨업 순간엔 Exp가 훅 줄어드는데, 그걸 동기화 타이밍에
	-- 의존해서 감지하려다 보니 "차있던 데서 줄어드는 것처럼" 보이는 버그가 났었다.
	@ExecSpace("Multicast")
	method void NotifyExpChanged(number newExp, number newExpNeeded, integer newLevel, boolean didLevelUp)
		if not self:IsClient() then return end
		local ratio = math.max(0, math.min(1, newExp / newExpNeeded))
		local startRatio = self.expBarFill.FillAmount
		if didLevelUp then startRatio = 0 end
		-- 몬스터가 여러 마리 거의 동시에 죽으면(광역기 등) NotifyExpChanged가 0.4초(ExpBarFillDuration)
		-- 안에 연달아 여러 번 호출되는데, PlayTween은 호출할 때마다 독립된 새 트위너를 만들 뿐 이전
		-- 트위너를 취소하지 않는다 — 그래서 먼저 시작된 트위너와 나중 트위너가 같은 프레임에 동시에
		-- FillAmount를 서로 다른 값으로 덮어써서 바가 순간적으로 뒤로 가는 것처럼 보이는 버그가 있었다.
		-- 토큰으로 "가장 최근에 시작된 트위너"만 실제로 값을 쓰게 하고, 그 전 트위너의 콜백은 조용히 무시한다.
		self._expTweenToken = self._expTweenToken + 1
		local token = self._expTweenToken
		_TweenLogic:PlayTween(startRatio, ratio, self.ExpBarFillDuration, EaseType.QuadEaseOut, function(value)
			if self._expTweenToken ~= token then return end
			if isvalid(self.expBarFill) then self.expBarFill.FillAmount = value end
		end)
		self.expLevelText.Text = "Lv." .. newLevel
		self.expText.Text = math.floor(newExp) .. " / " .. math.floor(newExpNeeded)
	end

	-- 플레이어 피격 시 화면을 살짝 흔든다
	@ExecSpace("ClientOnly")
	method void ShakeCameraOnHit()
		local cam = _CameraService:GetCurrentCameraComponent()
		if cam == nil then return end
		cam:ShakeCamera(0.2, 0.15)
		log("ShakeCameraOnHit triggered")
	end

	-- 원거리(먹물) 공격 몬스터가 플레이어에게 도달했을 때 MonsterAI가 호출 — 몬스터 위치 근처 화면 좌표에
	-- 먹물 스플랫 아이콘을 툭 튀어나오듯 팝시킨 뒤, 잠깐 붙어있다가 알파를 서서히 빼며 사라지게 한다
	@ExecSpace("Multicast")
	method void PlayInkSplat(Vector2 worldPos)
		if self:IsServer() then return end
		if self._inkSplatActive then return end
		self._inkSplatActive = true
		
		local rawUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(worldPos))
		local offsetX = (_UtilLogic:RandomDouble() * 2 - 1) * 220
		local offsetY = (_UtilLogic:RandomDouble() * 2 - 1) * 140
		local splatY = rawUI.y + offsetY
		-- 유저 지정(2026-08-22): "좌표가 너무 아래일때있어서 하단 30%는 제외" — 캔버스는 1920x1080
		-- 중앙원점(ui-fundamentals.md 기준, Y 범위 -540~+540)이므로 하단 30%(-540~-540+1080*0.3=-216)를
		-- 잘라내고, 그 밑으로 떨어지면 화면 하단 30% 경계선(-216)에 고정한다.
		local screenBottomExcludeY = -216
		if splatY < screenBottomExcludeY then splatY = screenBottomExcludeY end
		local splatUI = Vector2(rawUI.x + offsetX, splatY)
		
		local icon = self.inkSplatIcon
		icon.Color = Color(1, 1, 1, 1)
		icon.Entity:SetEnable(true)
		local tc = icon.Entity.UITransformComponent
		tc.anchoredPosition = splatUI
		tc.Scale = Vector3(0.3, 0.3, 1)
		
		-- 팝: 작은 크기에서 순간적으로 튀어나오듯 확대되며 화면에 붙는다 (요청에 따라 최종 크기를
		-- 1.0 → InkSplatMaxScale로 키움)
		_TweenLogic:PlayTween(0.3, self.InkSplatMaxScale, 0.12, EaseType.QuadEaseOut, function(scale)
			if isvalid(icon) then icon.Entity.UITransformComponent.Scale = Vector3(scale, scale, 1) end
		end)
		
		-- 잠깐 붙어있다가 알파를 서서히 빼며 사라짐 (요청에 따라 페이드 시간을 0.8 → InkSplatFadeDuration로 단축)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			_TweenLogic:PlayTween(1.0, 0.0, self.InkSplatFadeDuration, EaseType.QuadEaseIn, function(alpha)
				if isvalid(icon) then icon.Color = Color(1, 1, 1, alpha) end
			end)
			_TimerService:SetTimerOnce(function()
				if isvalid(icon) then icon.Entity:SetEnable(false) end
				self._inkSplatActive = false
			end, self.InkSplatFadeDuration)
		end, 0.5)
	end

	-- 원거리 히트 이펙트(네펜데스/다크네펜데스/거대네펜데스 2페이즈 공용) 재생 — MonsterAI가 공격
	-- 판정 시점에 호출한다. PlayInkSplat과 동일하게 상한(maxConcurrent)에 도달했으면 새 요청을 그냥
	-- 버려서, 여러 마리가 동시에 쏴도 화면엔 최대 maxConcurrent개까지만 뜬다(유저 요청: "문어처럼" —
	-- 기존 종은 전부 1을 넘겨 기존 동작 그대로, 예티류만 3을 넘겨 최대 3개까지 동시 허용). scaleRatio는
	-- CardManager.GetEffectScaleRatio(깊이감 보정)에 MonsterAI._hitEffectScaleMultiplier(종별 추가
	-- 배율, GetMapHitEffectScaleMultiplier 참고 — 유저 지정 2026-08-25: 몽실생크림 20%·예티류 15%
	-- 축소)까지 이미 곱해져서 들어온다. alpha는 종별 투명도(예티류만 15% 감소, 기본 1.0=무영향).
	@ExecSpace("ServerOnly")
	method void PlayRangedHitEffect(Vector3 worldPos, string effectRUID, number duration, Entity map, number scaleRatio, integer maxConcurrent, number alpha)
		local activeCount = self._rangedHitEffectActiveCounts[effectRUID] or 0
		if activeCount >= maxConcurrent then return end
		if effectRUID == "" or map == nil then return end
		self._rangedHitEffectActiveCounts[effectRUID] = activeCount + 1
		local fx = _SpawnService:SpawnByModelId("skilleffect", "RangedHitFX", worldPos, map)
		if fx ~= nil then
			local renderer = fx.SpriteRendererComponent
			if renderer ~= nil then
				renderer.SpriteRUID = effectRUID
				renderer.Color = Color(1, 1, 1, alpha)
			end
			-- 유저 요청으로 기존 1.5배에서 한 번 더 1.5배(총 2.25배)로 키웠다
			local scale = scaleRatio * 1.5 * 1.5
			fx.TransformComponent.Scale = Vector3(scale, scale, 1)
			fx:Destroy(duration)
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(self) then
				local cur = self._rangedHitEffectActiveCounts[effectRUID] or 0
				self._rangedHitEffectActiveCounts[effectRUID] = math.max(0, cur - 1)
			end
		end, duration)
	end

	-- 몬스터 처치 시 MonsterAI가 호출
	@ExecSpace("ServerOnly")
	method void OnMonsterKilled()
		if self.GameOver then return end
		
		self:AddGold(self:GetGoldPerKill())
		self.Exp = self.Exp + self:GetExpPerKill()
		log("Kill! EXP:" .. self.Exp .. "/" .. self.ExpNeeded .. " Gold:" .. self.Gold)
		
		-- 2026-08-03: 보스 등장이 처치 기반(웨이브9 80%)에서 순수 시간 기반(MonsterSpawner의
		-- FirstBossTime/BossRepeatInterval 타이머)으로 바뀌면서 이 조기 트리거는 더 이상 필요 없다.
		
		if self.Exp >= self.ExpNeeded then
			self:LevelUp()
		else
			self:NotifyExpChanged(self.Exp, self.ExpNeeded, self.Level, false)
		end
	end

	-- 보스가 죽을 때 MonsterAI가 호출. 2026-08-03: 보스가 시간 기반 반복 이벤트로 바뀌면서 원샷
	-- 가드(예전 BossDefeated 체크)를 제거했다 — 이제 잡을 때마다 매번 보상을 지급한다. 맵4+ 잠금해제도
	-- 더 이상 여기서 하지 않는다(LevelUp()이 Level==10 도달 시 독립적으로 이미 처리함).
	@ExecSpace("ServerOnly")
	method void OnBossDefeated(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		self.BossDefeated = true
		_MonsterSpawner:ClearCurrentBoss()
		-- 보스 처치는 큰 보상으로 확정 레벨업 1회를 보장한다(그 시점 누적 Exp와 무관하게). 뺄셈이 아니라
		-- 필요경험치만큼을 그대로 더해서(기존에 쌓아둔 Exp는 보존) 문턱을 확실히 넘기고, 그 뒤로는 일반
		-- 레벨업과 동일한 연출(0%부터 다시 차오름)로 자연스럽게 이어지게 한다.
		-- 보스 처치 보상(ExpPerKill/GoldPerKill)도 여기서 함께 지급한다 — 예전엔 MonsterAI.Die()가
		-- OnMonsterKilled()와 OnBossDefeated()를 둘 다 호출해서, 이미 차오르던 경험치 바 트윈을
		-- OnBossDefeated의 강제 0% 리셋이 거의 같은 프레임에 덮어써 "차오르다가 갑자기 줄어드는"
		-- 연출로 보이는 버그가 있었다. 지금은 Die()가 보스일 때 OnMonsterKilled()를 호출하지 않고
		-- OnBossDefeated() 한 번만 처치 보상까지 전부 처리한다.
		self:AddGold(self:GetGoldPerKill())
		self.Exp = self.Exp + self:GetExpPerKill() + self.ExpNeeded
		self:LevelUp()
		-- 엘리트 드롭과 동일한 방식(이미 장착/해금된 카드 레벨업)으로 액티브 1개 + 패시브 1개 확정 지급
		_CardManager:GrantBossCardRewards(worldPos, fallHeight, groundWorldY, dropScale)
		-- 파워 엘릭서 확정 드롭 (potionType=3 — 체력완전회복 + 전체 스킬 쿨타임 초기화)
		self:ApplyPotionDrop(3, worldPos, fallHeight, groundWorldY, dropScale)
		log("GameManager: Boss defeated (Wave " .. self.Wave .. ")")
	end

	-- 몬스터 처치 시 실제로 지급할 골드 (기본값 그대로) — 유물 골드 보너스는 킬마다 곱하지 않는다.
	-- GoldPerKill이 작아서(기본 5) 킬마다 곱하면 math.floor에 보너스가 통째로 묻혀 버렸다.
	-- 대신 TriggerGameOver()에서 이번 런에 모은 골드 총액에 한 번에 곱해서 지급한다.
	@ExecSpace("ServerOnly")
	method integer GetGoldPerKill()
		return self.GoldPerKill
	end

	-- 몬스터 처치 시 실제로 지급할 경험치 — 유물 레벨업 보너스(레벨 합계 1당 +1%)를 반영한다.
	-- 2026-08-05: MonsterSpawner가 DoubleSpawnAfterSeconds(2분)부터 스폰 수를 2배로 늘리는 대신,
	-- 같은 시점부터 킬당 경험치를 절반으로 줄여 총 유입량이 갑자기 튀지 않게 균형을 맞춘다(유저 지정).
	@ExecSpace("ServerOnly")
	method number GetExpPerKill()
		local bonusPercent = _RelicInventory:GetExpBonusPercent()
		local amount = self.ExpPerKill * (1 + bonusPercent / 100)
		if _MonsterSpawner._elapsedPlayTime >= _MonsterSpawner.DoubleSpawnAfterSeconds then
			amount = amount * 0.5
		end
		amount = amount * self.ExpBoostMultiplier
		return amount
	end

	-- 웨이브별 몬스터 공격력 반환 (Wave 10 보스, 11부터는 9번째 값 기준으로 계속 성장 — 무한 웨이브)
	@ExecSpace("ServerOnly")
	method integer GetWaveAttack(integer wave)
		-- 달팽이→파란달팽이→스포아→빨간달팽이→슬라임→돼지→주니어부기→스텀프→옥토퍼스→리본돼지(보스)
		-- Card1 쿨타임 0.8s 기준 1회 공격당 대미지 (플레이어 HP=100)
		local attacks = {3, 3, 5, 7, 10, 12, 14, 16, 18, 20}
		local base = 0
		if wave <= 10 then
			base = attacks[wave]
		else
			base = math.floor(attacks[9] + 3 * (wave - 9))
		end
		-- 공격력도 체력과 같은 에피소드 배율을 쓴다(2026-09-02 유저 지정: "체력 늘어난 만큼").
		-- 체력만 올리면 몬스터가 단단하기만 하고 위협적이지는 않아서 난이도 체감이 안 맞는다.
		return math.floor(base * self:GetEpisodeStatMultiplier())
	end

	@ExecSpace("ServerOnly")
	method integer GetTimeStep()
		local elapsed = _MonsterSpawner._elapsedPlayTime
		for i = 1, #self._hpStepBoundarySeconds do
			if elapsed < self._hpStepBoundarySeconds[i] then return i - 1 end
		end
		local lastBoundary = self._hpStepBoundarySeconds[#self._hpStepBoundarySeconds]
		return #self._hpStepBoundarySeconds + math.floor((elapsed - lastBoundary) / 300.0)
	end

	-- 계단별 몬스터 체력 — 0~5단계(0~12분)는 유저 지정 고정값, 6단계부터(12분 이후)는 마지막 값(500)
	-- 기준 ×1.15 복리로 계단이 진행될수록 절대 증가폭이 점점 커진다(완만→가파름).
	@ExecSpace("ServerOnly")
	method integer GetTimeStepHp(integer step)
		local stepCount = #self._hpStepValues
		local base = 0
		if step < stepCount then
			base = self._hpStepValues[step + 1]
		else
			local lastValue = self._hpStepValues[stepCount]
			base = math.floor(lastValue * (1.15 ^ (step - stepCount + 1)))
		end
		-- 에피소드가 올라갈수록 같은 시간대라도 몬스터가 단단해진다(2026-09-02 유저 지정).
		-- 장비 등급/강화 진행도가 이 배율을 한 단계씩 앞서도록 EnhanceScrollLogic 수치를 잡아두었다.
		return math.floor(base * self:GetEpisodeStatMultiplier())
	end

	-- 에피소드별 몬스터 능력치 배율 — 체력과 공격력에 함께 곱한다. 표에 없으면 1.0(기본).
	--   1 태초의 마을 100% / 2 구름정원 125% / 3 엘나스 150%
	-- 맵 선택 화면(WorldSelect)이 이 값을 그대로 읽어 "공격력 125% / 체력 125%"로 표시한다.
	method number GetEpisodeStatMultiplier()
		return self:GetEpisodeStatMultiplierFor(self.SelectedEpisode)
	end

	-- 특정 에피소드의 배율 — 맵 선택 화면처럼 아직 고르지 않은 에피소드를 미리 보여줄 때 쓴다
	method number GetEpisodeStatMultiplierFor(integer episode)
		local mult = self._episodeStatMultipliers[episode]
		if mult == nil then return 1.0 end
		return mult
	end

	-- 웨이브별 몬스터 접근 속도 반환 (Wave 10 보스만 느리게 접근, 11부터는 평시 속도로 복귀)
	@ExecSpace("ServerOnly")
	method number GetWaveApproachSpeed(integer wave)
		-- Wave 10 보스: (1.5-0.3)/0.08 = 15초 교전 창 → 카드 풀업그레이드 시 도달 전 처치 가능
		if wave == 10 then return 0.08 end
		return 0.3
	end

