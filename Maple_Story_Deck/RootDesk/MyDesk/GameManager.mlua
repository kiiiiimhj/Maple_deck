	end

	-- 웨이브별 몬스터 move(이동) 애니메이션 RUID — 접근 연출(스케일만 커지던 것) 중에 제자리서 걷는
	-- 모션을 보여주기 위해 추가. 도달하면 다시 stand로 복귀한다(MonsterAI.OnUpdate 참고).
	@ExecSpace("ServerOnly")
	method string GetWaveMoveRUID(integer wave)
		local ruids = {
			"663faffc64194c08b9371439b1948eb8",  -- Wave  1: 달팽이
			"ca6e5b65e1d643838ba920fbbeb32d8f",  -- Wave  2: 파란 달팽이
			"4a0350be4a734dffac3f0f14d20caaf6",  -- Wave  3: 스포아
			"4f8eab1a9fbf4a35b28f986c4fa12f48",  -- Wave  4: 빨간 달팽이
			"dc932872543f4a02bf41e977ab79e5ad",  -- Wave  5: 슬라임
			"8baad61512be4b33b2a0879fec7a266e",  -- Wave  6: 돼지
			"84a2e710c5ea4cb1843b52ad777a2074",  -- Wave  7: 주니어 부기
			"d5de0c972d044d3cad5d0ecb7d8c96e7",  -- Wave  8: 스텀프
			"3e5f23a5c00541c698fe3836b1ea244d",  -- Wave  9: 옥토퍼스
			"efd4d44e0da7496bac4c350def33a108",  -- Wave 10: 리본 돼지 (보스)
		}
		local idx = math.min(wave, #ruids)
		return ruids[idx]
	end

	-- 웨이브별 몬스터 attack1 애니메이션 RUID. 원본 리소스에 attack1이 없는 몬스터(3/5/6/8/9/10웨이브)는
	-- 빈 문자열 — MonsterAI가 빈 값이면 스프라이트 교체 대신 스케일 들이받기 연출로 대체한다
	--
	-- ⚠ 버그 수정(2026-09-05, 유저 리포트: "달팽이종류 몬스터 공격모션이 다 빠진듯") — 달팽이 3종
	--   (웨이브 1/2/4)의 attack1은 **1프레임짜리 정지 포즈이고 stand와 눈으로 구분이 안 된다**
	--   (실측: 달팽이 40×28 1프레임, 파란/빨간 36×36 1프레임 — 썸네일 대조까지 확인).
	--   2026-08-27 무홉 정책([[feedback_monster_attack_no_hop_policy]])이 "attack1이 있으면 홉을 빼고
	--   포즈 교체만" 하도록 바꾸면서, 이 3종은 "구분 안 되는 포즈로 0.25초 교체"만 남아 공격이 아예
	--   안 보이게 됐다. 유저 지시 원문도 "그 모션 없는애들만 점프하는 걸로 만들어(기존 달팽이처럼)"라
	--   달팽이는 원래 홉 쪽이 정답이다 — 빈 문자열로 되돌려 들이받기+홉 대체 연출을 복구한다.
	@ExecSpace("ServerOnly")
	method string GetWaveAttackRUID(integer wave)
		local ruids = {
			"",                                    -- Wave  1: 달팽이 (attack1이 stand와 같은 1프레임 → 홉으로 대체)
			"",                                    -- Wave  2: 파란 달팽이 (동일)
			"",                                    -- Wave  3: 스포아 (없음)
			"",                                    -- Wave  4: 빨간 달팽이 (동일)
			"",                                    -- Wave  5: 슬라임 (없음)
			"",                                    -- Wave  6: 돼지 (없음)
			"bcc04483577743d9993960f38dfa04d3",  -- Wave  7: 주니어 부기 (12프레임짜리 진짜 공격 모션)
			"",                                    -- Wave  8: 스텀프 (없음)
			"",                                    -- Wave  9: 옥토퍼스 (없음)
			"",                                    -- Wave 10: 리본 돼지 (없음)
		}
		local idx = math.max(1, math.min(wave, #ruids))
		return ruids[idx]
	end

	-- 웨이브 종별 attack1 재생시간(초) — 맵 몬스터의 GetMapAttackDuration과 같은 역할.
	-- ⚠ 버그 수정(2026-09-05): 웨이브 분기는 이 값을 아예 안 넘겨서 MonsterAI._attackDuration이 기본
	--   0.25초에 머물렀다. 주니어 부기 attack1은 12프레임(1.25초)이라 4/5가 잘려 나가 공격 모션이
	--   거의 안 보였다(맵 몬스터 쪽 "이 값이 없으면 기본값 0.25초에 잘려서 공격 모션이 거의 안 보인다"
	--   주석과 완전히 같은 케이스). 프레임당 0.1초 + 0.05초 기준(이 코드베이스 실측 관례).
	@ExecSpace("ServerOnly")
	method number GetWaveAttackDuration(integer wave)
		if wave == 7 then return 1.25 end  -- 주니어 부기 (12프레임)
		return 0.25
	end

	-- 맵4~6 전용 몬스터 풀 (idx 1~4) stand 애니메이션 RUID. HP/공격력은 GetWaveHp/GetWaveAttack을
	-- 그대로 재사용한다(웨이브가 맵과 무관한 전역 값이라 별도 스탯 테이블이 필요 없다) — 외형만 이 4종에서 무작위로 고른다
	@ExecSpace("ServerOnly")
	method string GetZoneStandRUID(integer idx)
		local ruids = {
			"d6bf82f05b5441dcbcb77171b5b8f7b5",  -- 1: 음흉한 여우
			"53f5e84a36444f6a92ae64881ddfa44c",  -- 2: 이상한 돼지
