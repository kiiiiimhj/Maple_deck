				summonCooldown = 20.0,
				summonCount = 2,
				-- 소환 자리 바닥 연출 — 엘리트 발밑 오라와 같은 마법진(EliteAuraRUID)을 쓴다
				summonFx = "34887ea12dd34598a59c8fb9fb210c13",
				summonFxDur = 0.9,
				growScalePerHit = 0,
				growScaleMax = 0,
				growAtkPerHit = 0,
				growAtkMax = 0,
				escort = nil,
				hasSplit = false,
				flying = false,
				hpMultiplier = 1.0,
				atkMultiplier = 1.0,
				zigzag = false,
				atkGrowPerAttack = 0,
				atkGrowMax = 0,
				dashAfterAttack = false,
				partnerAttackDelay = 0,
				partner = nil,
				-- 소환 부하: 얼어붙은 레프 보병 (mob/8645404.img) — **지상형**이다.
				-- 기존 부하(스텀피의 박쥐)는 비행형이라 minionFlying으로 갈라 준다.
				minionFlying = false,
				minion = {
					name = "얼어붙은 레프 보병",
					stand = "f52d095a1ef44fde8afd7a9562602f10",
					move = "7cc0e79e626d489aa1ac679766445167",
