			-- ep3_map4_ester_1(존1~5 = mapIndex129~133, 이스터에그 전용, 미배선) — 쿨리좀비/마이너좀비/플라이아이/미믹
			[129] = {"0a6e44cfa31b4da0890d2926cf8ebb16", "5362c11134bc4bd8a506a3428fde6480"},
			[130] = {"5362c11134bc4bd8a506a3428fde6480", "da1ea90aa01a4d1ba8bf15f1f9a5e4f6"},
			[131] = {"da1ea90aa01a4d1ba8bf15f1f9a5e4f6", "2cb9983c00004f84b6460c7fbb336a22"},
			[132] = {"2cb9983c00004f84b6460c7fbb336a22", "0a6e44cfa31b4da0890d2926cf8ebb16"},
			[133] = {"0a6e44cfa31b4da0890d2926cf8ebb16", "5362c11134bc4bd8a506a3428fde6480", "da1ea90aa01a4d1ba8bf15f1f9a5e4f6", "2cb9983c00004f84b6460c7fbb336a22"},
		}
		local pool = pools[mapIndex]
		if pool == nil then return "" end
		local i = math.max(1, math.min(idx, #pool))
		return pool[i]
	end

