					hitSfx = "63734e1142a242c4a1e2906f8b2198da",
					dieSfx = "63734e1142a242c4a1e2906f8b2198da",
					hpRatio = 2.0,
					-- 원본 182×157 → 120 ÷ 182 ≈ 0.66
					scale = 0.66,
					charge = true,
				},
				hasSplit = false,
				flying = false,
				hpMultiplier = 1.0,
				atkMultiplier = 1.0,
				zigzag = false,
				atkGrowPerAttack = 0,
				atkGrowMax = 0,
				dashAfterAttack = false,
				partnerAttackDelay = 0,
				partner = nil,
				minionFlying = false,
				minion = nil,
			},
			{
				-- 3번: 구미호 (mob/7220001.img).
				-- 유저 지정: "원거리, 체력 20% 이하되면 삼미호 4마리 소환, 엘리트 소환 마법진 비슷한 게
				--            바닥에서 나오고 생성되면 멋질듯".
				-- → hpSummonRatio/hpSummonCount(신규)로 **한 번만** 터지는 HP 임계 소환. 소환 연출은
				--   엘리트 발밑 오라와 같은 마법진(EliteAuraRUID)을 바닥에서 재생한다.
				name = "구미호",
				stand = "959ea412aeac4065bdb2c58e8be26d91",
				move = "730a07e8f4b7415d820a39deb22c3f9e",
