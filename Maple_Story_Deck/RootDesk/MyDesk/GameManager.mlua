			[125] = {"", "", "53a9227119764c268fbedade502834a8"},  -- 블러드레인디어/스노우맨(원거리)/다크주니어예티
			[126] = {"53a9227119764c268fbedade502834a8", "", ""},  -- 다크주니어예티/레인디어/플라이아이(비행)
