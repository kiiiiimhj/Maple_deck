					hitSfx = "fef9aa8955c4419bbb36a3e0daf577d6",
					dieSfx = "a04392e3c42648639411d560f4c57e1b",
					hpRatio = 2.0,
					-- 원본 186×182 → 120 ÷ 186 ≈ 0.65
					scale = 0.65,
					ranged = false,
				},
			},
			{
				-- 2번: 골드예티와 페페킹 (mob/3300006.img).
