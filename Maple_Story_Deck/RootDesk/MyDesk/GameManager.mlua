	@ExecSpace("ServerOnly")
	method number GetMapPhase2AttackDuration(integer mapIndex, integer idx)
		if mapIndex == 99 and idx == 1 then return 0.95 end  -- 주니어예티→예티(성체)
		if mapIndex == 100 and idx == 2 then return 0.95 end  -- 주니어예티→예티(성체)
		if mapIndex == 102 and idx == 2 then return 0.95 end  -- 주니어예티→예티(성체)
		if mapIndex == 99 and idx == 2 then return 0.95 end  -- 다크주니어예티→다크예티
		if mapIndex == 101 and idx == 1 then return 0.95 end  -- 다크주니어예티→다크예티
		if mapIndex == 103 and idx == 2 then return 0.95 end  -- 다크주니어예티→다크예티
		if mapIndex == 104 and idx == 1 then return 0.95 end
		if mapIndex == 105 and idx == 1 then return 0.95 end
		if mapIndex == 105 and idx == 3 then return 0.95 end
		if mapIndex == 106 and idx == 1 then return 0.95 end  -- 예티와페페→예티
		if mapIndex == 106 and idx == 2 then return 0.95 end
		if mapIndex == 107 and idx == 1 then return 0.95 end  -- 다크예티와페페→다크예티
		if mapIndex == 107 and idx == 2 then return 0.95 end  -- 예티와페페→예티
		if mapIndex == 107 and idx == 3 then return 0.95 end
		if mapIndex == 108 and idx == 1 then return 0.95 end  -- 다크예티와페페→다크예티
		if mapIndex == 108 and idx == 2 then return 0.95 end  -- 예티와페페→예티
		if mapIndex == 108 and idx == 3 then return 0.95 end
		if mapIndex == 114 and idx == 1 then return 0.95 end  -- 예티→다크예티
		if mapIndex == 115 and idx == 1 then return 0.95 end  -- 다크예티→다크예티와페페
		if mapIndex == 116 and idx == 1 then return 0.95 end  -- 예티와페페→예티
		if mapIndex == 117 and idx == 1 then return 0.95 end  -- 다크예티와페페→다크예티
		if mapIndex == 118 and idx == 1 then return 0.95 end
		if mapIndex == 118 and idx == 2 then return 0.95 end
		if mapIndex == 118 and idx == 3 then return 0.95 end
		if mapIndex == 118 and idx == 4 then return 0.95 end
		-- 에피소드3 map4(119~128) — 전 슬롯이 주니어예티/다크주니어예티→예티(성체)/다크예티 전환 대상
		if mapIndex >= 119 and mapIndex <= 128 then return 0.95 end
		return 0.25
	end

