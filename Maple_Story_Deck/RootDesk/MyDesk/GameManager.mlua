	-- 아니라 8자에 가까운 자연스러운 궤적이 되게 한다.
	property number DespairBladeSwayAmplitude = 0.4

	property number DespairBladeSwaySpeed = 1.3

	-- 플레이어 기준 상대 위치(살짝 위쪽에 붙어서 위협적으로 떠 있는 느낌)
	property number DespairBladeOffsetY = 0.9

	-- 평소 떠다니는 모습(fly)과 공격 순간 잠깐 바뀌는 모습(attack1) — mob/8644705.img(절망의 칼날) 리소스팩
	property string DespairBladeFlyRUID = "0dbd5ede7c7b4b8a8252eca643db30e4"

	property string DespairBladeAttackRUID = "b6c7305f6c1348a3a46a52bfe7c79383"

	-- attack1은 11프레임 — GetMapAttackDuration의 11프레임 종(루팡 등)과 동일하게 초당 약 10프레임
	-- 기준 1.1초 필요. 0.35초로 짧게 잡았더니 중간에 잘려 보였다(유저 지적, 이 프로젝트에 이미
	-- 있던 "짤림" 버그와 동일 원인 — GetMapAttackDuration 주석 참고).
	property number DespairBladeAttackAnimDuration = 1.1

	-- 스윙 시작(PlayDespairBladeAttackAnim) 후 실제로 대미지/오브가 터지기까지의 지연 — 스윙 애니메이션
	-- 총 길이(1.1초)의 중후반부에서 "닿는" 느낌을 주기 위한 값.
	property number DespairBladeImpactDelay = 0.55

	-- 공격 순간 원거리 몬스터 공격 연출처럼 플레이어 주변에 흩뿌리는 오브 3개 — 크기를 서로 다르게
	-- 줘서 불규칙해 보이게 한다(유저 요청: "크기 불규칙하게 한 3개"). 공용 skilleffect 모델
	-- (SkillEffectAI.Duration=0.8초)에 태워서 다른 스킬 이펙트와 동일하게 자동으로 사라진다.
