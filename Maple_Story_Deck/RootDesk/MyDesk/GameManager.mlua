@Logic
script GameManager extends Logic

	-- 플레이어 스탯
	@Sync
	property integer PlayerHp = 100

	@Sync
	property integer PlayerMaxHp = 100

	-- 경험치 / 레벨
	@Sync
	property integer Level = 1

	@Sync
	property number Exp = 0

	@Sync
	property number ExpNeeded = 120

	-- 골드 (런 전용 — "다시하기" 누르면 0으로 리셋됨)
	@Sync
	property integer Gold = 0

	-- 골드 유물 보너스를 마지막으로 정산한 시점의 Gold 값 — TriggerGameOver()가 이 값 이후로
	-- "새로 번" 골드에만 보너스를 곱한다 (이어하기로 여러 번 게임오버가 나도 이미 보너스 받은
	-- 골드를 또 보너스 대상에 포함시키는 중복 적용을 막는다)
	property integer _goldBonusCheckpoint = 0

	@Sync
	property integer TotalCoins = 0

	-- 메인화면 우측 상단에 표시되는 누적 코인 — 런이 끝나도 리셋되지 않고 전역 저장소에 영구 저장됨
	property any _coinStorage = nil

	property boolean _coinDirty = false

	property any _coinFlushTimerId = nil

	@Sync
	property integer ShadowVoucher = 0

	-- 그림자 숲 샵(존18 NPC) 전용 재화 — 야누스의 검 교환권. TotalCoins와 동일한 패턴(전역 저장소,
	-- dirty-flag 지연 flush)으로 런이 끝나도 리셋되지 않고 영구 보존된다. 존16~17 몬스터 처치 시
	-- 5% 확률로 드롭(MonsterAI.Die 참고).
	property number ShadowVoucherDropChance = 0.05

	property any _voucherStorage = nil

	property boolean _voucherDirty = false

	@Sync
	property integer Diamond = 0

	-- 뽑기 전용 재화(다이아) — TotalCoins/ShadowVoucher와 완전히 동일한 패턴(전역 저장소 "PlayerCoins",
	-- dirty-flag 지연 flush)으로 런과 무관하게 영구 보존된다. 아직 인게임 획득처가 없으므로, 저장된
	-- 값이 아예 없는 신규 유저에게만 DiamondStartingAmount를 1회 지급한다(획득처가 생기면 이 지급은
	-- 빼면 된다). 잔액 표시는 로비 우상단 배지(TitleGroup/DiamondBadge)와 뽑기 팝업 두 곳.
	property integer DiamondStartingAmount = 3000

	property any _diamondStorage = nil

	property boolean _diamondDirty = false

	property string DiamondIconRUID = "81462aeb825b4660991cef05651271cf"

	-- 웨이브
	@Sync
	property integer Wave = 1

	-- 보스를 한 번이라도 잡았는지 여부 — 2026-08-03 이전에는 맵4+ 잠금해제 판정에도 쓰였지만,
	-- 그 잠금해제는 이미 LevelUp()에서 Level==10 도달로 독립적으로 처리돼서 더는 그 용도로 안 쓰인다.
	-- 보스가 시간 기반 반복 이벤트로 바뀌면서 OnBossDefeated()의 원샷 가드로도 더는 쓰지 않음(매번 보상
	-- 지급) — 과거 세이브/화면 호환을 위해 값 자체는 유지.
	@Sync
	property boolean BossDefeated = false

	-- 시간 기반 보스/엘리트 난이도 배율(2026-08-03) — 둘 다 "그 시점 일반 몬스터 체력/공격력"에 곱해서
	-- 산정한다(더 이상 고정된 웨이브 번호에 못 박히지 않음). 엘리트는 MarkElite()에 이미 자체 배율
	-- (1.15)이 있어 별도 프로퍼티 없이 그대로 둠 — 이 둘은 보스 전용.
	property number BossHpMultiplier = 7.0

	property number BossAttackMultiplier = 2.0

	-- 게임 상태
	@Sync
	property boolean GameOver = false

	-- 이번 런에서 "이어하기"를 누른 횟수 — 누를 때마다 다음 이어하기 비용이 비싸진다.
	-- "다시하기"(처음부터, RestartGame)로만 0으로 리셋된다
	@Sync
	property integer ContinueCount = 0

	property any _continueCostTable = { 900, 1500, 2400, 3600 }

	@Sync
	property boolean GameStarted = false

	@Sync
	property integer SelectedCharacter = 0

	@Sync
	property integer SelectedEpisode = 1

	-- 에피소드별 몬스터 능력치 배율(2026-09-02 유저 지정) — 체력(GetTimeStepHp)과 공격력(GetWaveAttack)에
	-- 같은 값을 곱한다. 키가 없는 에피소드는 1.0.
	property any _episodeStatMultipliers = { [1] = 1.0, [2] = 1.25, [3] = 1.5 }

	@Sync
	property boolean TimeAttackMode = false

	-- 타이틀 화면에서 "게임 시작" 버튼을 눌러야 실제 웨이브/스폰이 시작된다 (그 전까지는 대기)
	-- 캐릭터 선택 팝업(WorldCharacterSelectUI)에서 고른 캐릭터 — 0=아르카나, 1=실피드.
	-- CardManager.OnUpdate가 이 값을 보고 기본공격(파이어샷 vs 애로우샷) 트랙을 분기한다.
	-- 시작 팝업(WorldCharacterSelectUI)에서 고른 월드/에피소드 — 1=에피소드1(태초의 마을), 2=에피소드2
	-- (구름정원). "다시하기"는 이 값을 건드리지 않는다(같은 에피소드로 재시작).
	-- 게임 모드 — 무제한 모드(false, 기존과 동일) / 타임어택 모드(true, 20분 제한). 캐릭터 선택
	-- 팝업의 체크박스에서 고른 값이 RequestStartGame으로 전달돼 여기 저장된다. "다시하기"는 이
	-- 값을 건드리지 않는다(같은 모드로 재시작 — 로비로 나가서 다시 고르기 전까지 유지).
	property number TimeAttackDuration = 1200

	-- 랭킹 보드 id — RankingConfigDataSet.csv의 Id 열과 반드시 일치해야 한다(1=무제한, 2=타임어택)
	property integer RankBoardIdUnlimited = 1

	property integer RankBoardIdTimeAttack = 2

	-- 랭킹 저장값의 하위 자릿수를 생존 초로 쓰기 위한 배율(동점 타이브레이커). 자세한 설명은 EncodeRankScore 참고
	property integer RankScoreTimeScale = 10000

	-- 입장 로딩 화면이 화면을 가리고 있는 동안 몬스터 스폰 시작을 미루는 시간(초).
	-- ⚠ LoadingUI.FadeInSeconds + LoadingUI.HoldSeconds 와 같은 값이어야 한다 — 화면이 밝아지는
	-- 순간에 맞춰 전투가 시작되도록 맞춰둔 값이다. 한쪽만 고치면 어긋난다(검은 화면에서 이미
	-- 맞고 있거나, 밝아진 뒤 한참 아무것도 안 나오거나).
	property number EntryDelaySeconds = 1.55

	@Sync
	property number TimeAttackRemaining = 0

	@Sync
	property boolean _timeAttackOvertimeActive = false

	@Sync
	property boolean _timeAttackOvertimeDeath = false

	@Sync
	property boolean _gaveUp = false

	-- 몬스터 처치당 경험치/골드. 2026-08-05: 2분 이후 절반(GetExpPerKill 참고)으로 깎였을 때 정확히
	-- 15가 되도록 30으로 상향(2분 전에는 30, 2분 후 15) — 유저가 "지금 10인데 15로" 요청.
	-- 카운트가 0이 된 뒤(절망의 칼날 등장 이후) 상태 — GameOverUI가 "이어하기/다시하기 둘 다"와
	-- "다시하기만" 중 어느 쪽을 보여줄지 이 두 플래그로 판정한다. _timeAttackOvertimeDeath는
	-- TriggerGameOver 시점에 _timeAttackOvertimeActive를 그대로 캡처해 둔 값이라, 게임오버
	-- 팝업이 열려있는 동안(다음 판정 전까지) 죽은 원인을 안정적으로 유지한다.
	-- 옵션 팝업의 "게임 종료"로 스스로 끝낸 판인지(유저 지정 2026-08-30). 죽은 게 아니라 포기한 거라
	-- 이어하기를 주지 않고 GameOverUI가 "다시하기만" 모드로 뜬다. RestartGame/RequestContinue에서 해제.
	property number ExpPerKill = 30

	-- 몬스터 1마리 처치당 지급 골드 (유저 지정 2026-09-01: 5 → 1).
	-- 유물 성배(8번)의 골드 % 보너스는 킬마다가 아니라 TriggerGameOver에서 런 총액에 한 번에 곱한다.
	property integer GoldPerKill = 1

	-- 클라이언트 전용: 화면 흔들림 판정을 위한 이전 HP 기억
	property integer _prevPlayerHp = 100

	-- 피격 무적 (동시 다중 피격 방지)
	property boolean _hitImmune = false
	-- 유물 팬더 허수아비(15번) 저체력 무적 상태.
	-- _relicInvulnUntil 은 무적이 끝나는 시각(ElapsedSeconds) — 기본 피격 무적(0.8초) 해제 타이머가
	-- 유물 무적을 먼저 풀어버리지 않도록 비교용으로 쓴다.
	-- _relicInvulnArmed 는 재장전 여부 — 체력이 10% 위로 올라오면 다시 true가 된다.
	property number _relicInvulnUntil = 0
	property boolean _relicInvulnArmed = true

	-- UI 바인딩 (클라이언트 전용)
	property SliderComponent hpBar = "da3cd53f-f7a1-4345-b09b-2f0e7d0b658e"

	property TextComponent hpText = "7d054dd7-e575-4be3-8664-9994e2a4b172"

	property TextComponent playerNameText = "0c08115d-3aa6-4305-b587-c672c7398a4b"

	property SpriteGUIRendererComponent expBarFill = "f611e821-754b-437f-9633-2b26ea571c8d"

	property TextComponent expLevelText = "7e10b488-7eb5-44c2-98b0-87c80f1f38ec"

	property TextComponent expText = "998eb743-a64b-4cf3-af6c-f9dc870c315c"

	property TextComponent goldText = "96a9909e-7c1c-43e4-928f-1e97f0dcc8a3"

	-- 타임어택 모드 전용 카운트다운 HUD(경험치바 바로 아래) — 무제한 모드에서는 계속 꺼져있다
	property Entity timeAttackTimerBg = "b208537e-2e71-4bb2-b2cc-8ad505628625"

	property TextComponent timeAttackTimerText = "91bf9edc-56aa-4c8b-83dc-d52537ab705a"

	-- 경험치 바가 순간이동하듯 뚝뚝 끊기지 않고 부드럽게 차오르는 데 걸리는 시간
	property number ExpBarFillDuration = 0.4

	-- 클라이언트 전용: NotifyExpChanged가 연달아 호출될 때 이전 트위너의 콜백을 무효화하기 위한 토큰
	property integer _expTweenToken = 0

	-- 일반 몬스터 처치 시 회복 포션 드롭 연출용 아이콘 (월드 사망 위치 → HP바로 포물선 비행)
	property SpriteGUIRendererComponent potionFlyIcon = "831d845f-6b01-459e-9724-3c7e26bf1af0"

	-- 원거리(먹물) 공격 몬스터가 도달했을 때 재생하는 화면 잉크 스플랫 아이콘 (ui/DefaultGroup.ui InkSplat)
	property SpriteGUIRendererComponent inkSplatIcon = "a2391bcc-9ccb-48f4-8aea-a358b123557e"

	property boolean _inkSplatActive = false

	-- 원거리 히트 이펙트(네펜데스/다크네펜데스/거대네펜데스 2페이즈/스코피류/몽실생크림/예티류 공용)
	-- 중복 방지 — PlayInkSplat과 동일한 취지: 유저 요청 "몬스터마다 다 쏘는거 같은데 문어처럼 변경해줘,
	-- 문어는 몬스터가 많아도 개별로 다 쏘진 않았던거 같아서". 동시 출력 개수를 boolean 하나가 아니라
	-- 카운터로 관리한다 — 종마다 상한(maxConcurrent)이 다르기 때문(기존 종은 1, 예티류는 유저 지정으로
	-- 3 — MonsterAI._hitEffectMaxConcurrent/GameManager.GetMapHitEffectMaxConcurrent 참고). 상한 도달 시
	-- 새 요청은 그냥 버린다(대기열 없음).
	-- 버그 수정(2026-08-25, 유저 리포트 "스노우맨은 원거리인데 타격 이펙트도 빠진거 같다") — 이 카운터가
	-- effectRUID 구분 없이 전역 스칼라 하나였다. 예티류(먹물 RUID, maxConcurrent=3)가 동시에 여러 마리
	-- 쏘면 이 전역 카운터가 계속 1 이상으로 차 있게 되고, 스노우맨(전용 RUID, maxConcurrent=1)이 그
	-- 사이에 요청을 보내면 자기 RUID는 하나도 안 떴는데도 "상한 도달"로 오판해 매번 버려졌다 — 서로
	-- 다른 시각 이펙트인데 같은 예산을 나눠 쓰고 있었던 게 원인. effectRUID별로 독립된 카운터를 쓰도록
	-- 테이블로 바꾼다.
	property table _rangedHitEffectActiveCounts = {}

	-- 잉크 스플랫 최종 크기(팝 연출이 도달하는 스케일)와 페이드 아웃 소요 시간 — 기존 1.0/0.8초보다
	-- 더 크고 더 빨리 사라지게 해달라는 요청으로 조정
	property number InkSplatMaxScale = 1.3

	property number InkSplatFadeDuration = 0.5

	-- 회복 포션 드롭 확률 (배타적 — 빨강 1%, 흰색 0.5%, 나머지 98.5%는 드롭 없음. 2026-08-04: 유저 요청으로 5%/2%→1%/0.5% 하향)
	property number RedPotionDropChance = 0.01

	property number WhitePotionDropChance = 0.005

	-- 일반 잡템(가방행) 드롭 확률 — 존16~17(그림자 존)은 야누스의 검 교환권 전용이라 제외한다
	property number LootItemDropChance = 0.35

	-- 스틸(Card176) 전용 — 메소 드랍 아이콘(골드 메소주머니) + 바닥에 머무는 시간(유저 지정: 5초)
	property string StealMesoIconRUID = "5c78b56b91964dcaa83c1d30b8cd3cce"  -- 유저 지정

	property number StealMesoGroundDelay = 5.0

	-- 유저 지정: 메소가 실제 잡템/캐스트 이펙트 위치보다 위에 떠 보여서 0.3(월드 유닛) 아래로 보정.
	-- Card176EffectYOffset(캐스트 이펙트용)과는 완전히 별개 — 메소는 UI 좌표계 아이콘이라 시작점(worldPos.y)과
	-- 착지 지점(groundWorldY) 둘 다 이 값만큼 낮춰서 ScheduleMesoDrop에서 함께 적용한다.
	property number StealMesoYOffset = -0.3

	-- 잡템 드롭 연출용 아이콘 (포션과 동일한 방식 — 월드 사망 위치 → 가방 아이콘으로 포물선 비행).
	-- 짧은 시간에 여러 마리가 죽어도 겹치지 않도록 4개를 돌려쓴다(2개였을 때 몰려 죽으면 슬롯이
	-- 부족해 드롭이 밀리는 문제가 실측됨)
	property SpriteGUIRendererComponent lootFlyIcon1 = "54e5fc11-ff74-4d52-9b94-562e62bbe4c0"

	property SpriteGUIRendererComponent lootFlyIcon2 = "a1209f8e-2506-4f2b-8d19-45b1e8285b09"

	property SpriteGUIRendererComponent lootFlyIcon3 = "b71cf15a-16d4-4a2d-8643-2473071ac27c"

	property SpriteGUIRendererComponent lootFlyIcon4 = "365a8647-5b4d-4d7b-943c-86d6412215d7"

	-- 스틸(Card176) 메소 전용 슬롯 4개 — 공용 lootFlyIcon 4개 풀과 완전히 별도. 유저 지적: 스틸이 한 번에
	-- 2~4명을 때리면 그만큼의 메소가 동시에 잡템/포션 등과 함께 공용 슬롯 4개를 다퉈서, 메소가 100%
	-- 확정임에도 화면에 아이콘이 안 뜨는 경우(=슬롯 부족으로 연출만 스킵, 지급 자체는 정상)가 있었다.
	-- 스틸 최대 타겟 수(레벨5=4명)만큼 전용 슬롯을 마련해서 자기들끼리도 서로 경합하지 않게 한다.
	property SpriteGUIRendererComponent mesoFlyIcon1 = "f99f3148-4ab7-467a-a93d-f93e95dc0fb6"

	property SpriteGUIRendererComponent mesoFlyIcon2 = "9e357cb7-4dbd-4473-9f0d-fb73b6eb0930"

	property SpriteGUIRendererComponent mesoFlyIcon3 = "66ad9cba-ef6a-4e89-ba76-15671047d010"

	property SpriteGUIRendererComponent mesoFlyIcon4 = "c16f450b-85ac-4035-a081-9a5a9e853b4d"

	property any _mesoSlots = nil

	-- 메소 익스플로젼(Card177) 전용 — 서버 권위 메소 드랍 목록. _mesoSlots는 ClientOnly(시각 전용)라
	-- 서버 스킬 로직이 "지금 필드에 떨어져 있는 메소가 어디 있는지" 알 방법이 없었다 — 이 목록이
	-- 그 서버측 대응. 각 항목: { id, worldPos, landed, amount, consumed, watchTimerId, grantTimerId }
	property any _activeMesoDrops = nil

	property integer _nextMesoDropId = 1

