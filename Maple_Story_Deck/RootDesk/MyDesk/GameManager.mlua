			[131] = {"", "8fd92a46c6db421083bc9ba9df1dafb9"},  -- 플라이아이(비행)/미믹
			[132] = {"8fd92a46c6db421083bc9ba9df1dafb9", "d5f67f8282954a2b87e2dc00fed0fe16"},  -- 미믹/쿨리좀비
			[133] = {"d5f67f8282954a2b87e2dc00fed0fe16", "2cfaec1131fe475f9fa9d02d1e07ae26", "", "8fd92a46c6db421083bc9ba9df1dafb9"},  -- 쿨리좀비/마이너좀비/플라이아이(비행)/미믹
		}
		local pool = pools[mapIndex]
		if pool == nil then return "" end
		local i = math.max(1, math.min(idx, #pool))
		return pool[i]
	end

