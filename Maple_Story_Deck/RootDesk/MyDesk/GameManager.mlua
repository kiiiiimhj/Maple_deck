			[103] = {"", ""},  -- 파랑미니빈(비행, 없음)/다크주니어예티(없음)
			[104] = {"a9e503154e3e4ad5ab0e9e7742dd53ec", "", ""},  -- 예티/다크리티(비행, 없음)/리티(비행, 없음)
			[105] = {"55966425813d4fa1bea67ad1018dcfb5", "", "a9e503154e3e4ad5ab0e9e7742dd53ec"},  -- 다크예티/파랑미니빈(비행, 없음)/예티
			[106] = {"992f9d470255469ca5bbe69d9551f790", "55966425813d4fa1bea67ad1018dcfb5", ""},  -- 예티와페페/다크예티/다크리티(비행, 없음)
			[107] = {"d1dce4fdac0f4838b37af3c0fea8fd52", "992f9d470255469ca5bbe69d9551f790", "a9e503154e3e4ad5ab0e9e7742dd53ec"},  -- 다크예티와페페/예티와페페/예티
			[108] = {"d1dce4fdac0f4838b37af3c0fea8fd52", "992f9d470255469ca5bbe69d9551f790", "55966425813d4fa1bea67ad1018dcfb5"},  -- 다크예티와페페/예티와페페/다크예티
			-- 에피소드3 map3(109~118) — 플라이아이는 attack1이 없어 빈 문자열(들이받기 대체 연출).
			[109] = {"162762aec53e40dfab8cbaa0425ea0ba", "1d6be47d8a514b31ad0c746243573326"},  -- 웨어울프/라이칸스로프
			[110] = {"1d6be47d8a514b31ad0c746243573326", ""},  -- 라이칸스로프/플라이아이
			[111] = {"162762aec53e40dfab8cbaa0425ea0ba", "022330aea10449ac970a86ee17db8709"},  -- 웨어울프/스노우맨
			[112] = {"162762aec53e40dfab8cbaa0425ea0ba", "1d6be47d8a514b31ad0c746243573326", ""},  -- 웨어울프/라이칸스로프/플라이아이
			[113] = {"022330aea10449ac970a86ee17db8709", ""},  -- 스노우맨/플라이아이
			[114] = {"a9e503154e3e4ad5ab0e9e7742dd53ec", "162762aec53e40dfab8cbaa0425ea0ba", "1d6be47d8a514b31ad0c746243573326"},  -- 예티/웨어울프/라이칸스로프
			[115] = {"55966425813d4fa1bea67ad1018dcfb5", "022330aea10449ac970a86ee17db8709", ""},  -- 다크예티/스노우맨/플라이아이
			[116] = {"992f9d470255469ca5bbe69d9551f790", "162762aec53e40dfab8cbaa0425ea0ba", "1d6be47d8a514b31ad0c746243573326"},  -- 예티와페페/웨어울프/라이칸스로프
			[117] = {"d1dce4fdac0f4838b37af3c0fea8fd52", "022330aea10449ac970a86ee17db8709", ""},  -- 다크예티와페페/스노우맨/플라이아이
			[118] = {"d1dce4fdac0f4838b37af3c0fea8fd52", "992f9d470255469ca5bbe69d9551f790", "55966425813d4fa1bea67ad1018dcfb5", "a9e503154e3e4ad5ab0e9e7742dd53ec"},  -- 다크예티와페페/예티와페페/다크예티/예티
			-- 에피소드3 map4(119~128) — 주니어예티/다크주니어예티는 attack1이 없다(기존 99~103 존과 동일 컨벤션)
			[119] = {"", ""},
			[120] = {"", ""},
			[121] = {"", ""},
			[122] = {"", "", ""},
			[123] = {"", ""},
			[124] = {"", "", ""},
			[125] = {"", "", ""},
			[126] = {"", "", ""},
			[127] = {"", "", ""},
			[128] = {"", "", "", ""},
			-- ep3_map4_ester_1(존1~5 = mapIndex129~133, 이스터에그 전용, 미배선) — 쿨리좀비(attack1)/
			-- 마이너좀비(attack2 전용, 원거리 연출)/플라이아이(없음)/미믹(없음)
			[129] = {"45206ab461ee40869ade8cefdfe58349", "5902420641eb43aa9f951a5638fda3b0"},
			[130] = {"5902420641eb43aa9f951a5638fda3b0", ""},
			[131] = {"", ""},
			[132] = {"", "45206ab461ee40869ade8cefdfe58349"},
			[133] = {"45206ab461ee40869ade8cefdfe58349", "5902420641eb43aa9f951a5638fda3b0", "", ""},
		}
		local pool = pools[mapIndex]
		if pool == nil then return "" end
		local i = math.max(1, math.min(idx, #pool))
		return pool[i]
	end

	-- 맵 전용 몬스터 풀 attack1 스프라이트를 원래 포즈로 되돌리기까지 대기하는 시간(초). 기존엔 전 종이
	-- 0.25초로 고정돼 있었는데, 자이언트 쉐도우(존27의 2번째 종)의 attack1 클립은 8프레임이라 die1과
	-- 같은 재생 속도(초당 약 10프레임, die1 14프레임=1.45초로 역산) 기준 실제 재생에 약 0.8초가 필요해서
	-- 0.25초에 중간에 잘려 보였다 — 유저가 "공격모션이 짤리는듯" 피드백. 이 종만 실측 길이로 늘리고,
	-- 나머지(짧은 클립)는 기존 0.25초를 그대로 유지한다. 루팡/좀비루팡(11프레임 attack1)도 같은 이유로 추가.
	@ExecSpace("ServerOnly")
	method number GetMapAttackDuration(integer mapIndex, integer idx)
		if mapIndex == 27 and idx == 2 then return 0.8 end
		if mapIndex == 31 and idx == 1 then return 1.1 end
		if mapIndex == 34 and idx == 2 then return 1.1 end
		-- 에피소드2 네펜데스류 attack1(7프레임 실측 길이)
		if mapIndex == 46 and idx == 2 then return 0.75 end
		if mapIndex == 50 and idx == 1 then return 0.75 end
		if mapIndex == 53 and idx == 3 then return 0.75 end
		if mapIndex == 54 and idx == 3 then return 0.75 end
		if mapIndex == 56 and idx == 2 then return 0.75 end
		if mapIndex == 59 and idx == 3 then return 0.75 end
		-- 스코피/골든스코피 attack1(481276dd.../5ff34e9f...) 실측 길이(15프레임=1.55초) — GetMapAttackRUID
		-- 참고. 이 값이 없으면 기본값 0.25초에 잘려서 공격 모션이 거의 안 보인다.
		if mapIndex == 65 and idx == 2 then return 1.55 end  -- 골든스코피
		if mapIndex == 67 and idx == 1 then return 1.55 end  -- 스코피
		if mapIndex == 68 and idx == 1 then return 1.55 end  -- 골든스코피
		if mapIndex == 71 and idx == 1 then return 1.55 end  -- 스코피
		if mapIndex == 72 and idx == 1 then return 1.55 end  -- 골든스코피
		if mapIndex == 73 and idx == 2 then return 1.55 end  -- 골든스코피
		if mapIndex == 77 and idx == 1 then return 1.55 end  -- 스코피
		if mapIndex == 78 and idx == 1 then return 1.55 end  -- 골든스코피
		if mapIndex == 81 and idx == 1 then return 1.55 end  -- 스코피
		if mapIndex == 82 and idx == 1 then return 1.55 end  -- 골든스코피
		if mapIndex == 83 and idx == 2 then return 1.55 end  -- 골든스코피
		if mapIndex == 84 and idx == 3 then return 1.55 end  -- 골든스코피
		-- 에피소드3 map1(89~98) — 헥터/화이트팽 attack1(8프레임=0.85초), 몽실생크림 attack1(14프레임=1.45초).
		if mapIndex == 91 and idx == 3 then return 0.85 end  -- 헥터
		if mapIndex == 93 and idx == 2 then return 0.85 end  -- 헥터
		if mapIndex == 94 and idx == 3 then return 0.85 end  -- 화이트팽
		if mapIndex == 95 and idx == 1 then return 1.45 end  -- 몽실생크림
		if mapIndex == 96 and idx == 2 then return 0.85 end  -- 화이트팽
		if mapIndex == 97 and idx == 1 then return 0.85 end  -- 헥터
		if mapIndex == 97 and idx == 2 then return 1.45 end  -- 몽실생크림
		if mapIndex == 98 and idx == 2 then return 0.85 end  -- 화이트팽
		if mapIndex == 98 and idx == 3 then return 1.45 end  -- 몽실생크림
		-- 에피소드3 map2(99~108) — 예티/다크예티/예티와페페/다크예티와페페(1페이즈) attack1 전부 9프레임=0.95초.
		if mapIndex == 104 and idx == 1 then return 0.95 end  -- 예티
		if mapIndex == 105 and idx == 1 then return 0.95 end  -- 다크예티
		if mapIndex == 105 and idx == 3 then return 0.95 end  -- 예티
		if mapIndex == 106 and idx == 1 then return 0.95 end  -- 예티와페페
		if mapIndex == 106 and idx == 2 then return 0.95 end  -- 다크예티
		if mapIndex == 107 and idx == 1 then return 0.95 end  -- 다크예티와페페
		if mapIndex == 107 and idx == 2 then return 0.95 end  -- 예티와페페
		if mapIndex == 107 and idx == 3 then return 0.95 end  -- 예티
		if mapIndex == 108 and idx == 1 then return 0.95 end  -- 다크예티와페페
		if mapIndex == 108 and idx == 2 then return 0.95 end  -- 예티와페페
		if mapIndex == 108 and idx == 3 then return 0.95 end  -- 다크예티
		-- 에피소드3 map3(109~118) — attack1 프레임수 실측: 웨어울프/라이칸스로프 12프레임(1.25초),
		-- 스노우맨 29프레임(2.95초, 준비+투척 동작이 긴 스킬성 클립). 플라이아이는 attack1이 없어 항목 없음.
		if mapIndex == 109 and idx == 1 then return 1.25 end  -- 웨어울프
		if mapIndex == 109 and idx == 2 then return 1.25 end  -- 라이칸스로프
		if mapIndex == 110 and idx == 1 then return 1.25 end  -- 라이칸스로프
		if mapIndex == 111 and idx == 1 then return 1.25 end  -- 웨어울프
		if mapIndex == 111 and idx == 2 then return 2.95 end  -- 스노우맨
		if mapIndex == 112 and idx == 1 then return 1.25 end  -- 웨어울프
		if mapIndex == 112 and idx == 2 then return 1.25 end  -- 라이칸스로프
		if mapIndex == 113 and idx == 1 then return 2.95 end  -- 스노우맨
		if mapIndex == 114 and idx == 1 then return 0.95 end  -- 예티
		if mapIndex == 114 and idx == 2 then return 1.25 end  -- 웨어울프
		if mapIndex == 114 and idx == 3 then return 1.25 end  -- 라이칸스로프
		if mapIndex == 115 and idx == 1 then return 0.95 end  -- 다크예티
		if mapIndex == 115 and idx == 2 then return 2.95 end  -- 스노우맨
		if mapIndex == 116 and idx == 1 then return 0.95 end  -- 예티와페페
		if mapIndex == 116 and idx == 2 then return 1.25 end  -- 웨어울프
		if mapIndex == 116 and idx == 3 then return 1.25 end  -- 라이칸스로프
		if mapIndex == 117 and idx == 1 then return 0.95 end  -- 다크예티와페페
		if mapIndex == 117 and idx == 2 then return 2.95 end  -- 스노우맨
		if mapIndex == 118 and idx == 1 then return 0.95 end  -- 다크예티와페페
		if mapIndex == 118 and idx == 2 then return 0.95 end  -- 예티와페페
		if mapIndex == 118 and idx == 3 then return 0.95 end  -- 다크예티
		if mapIndex == 118 and idx == 4 then return 0.95 end  -- 예티
		-- ep3_map4_ester_1(129~133, 이스터에그 전용, 미배선) — 쿨리좀비 attack1(10프레임=1.0초),
		-- 마이너좀비 attack2(13프레임=1.3초, 원거리 전용)
		if mapIndex == 129 and idx == 1 then return 1.0 end  -- 쿨리좀비
		if mapIndex == 129 and idx == 2 then return 1.3 end  -- 마이너좀비
		if mapIndex == 130 and idx == 1 then return 1.3 end  -- 마이너좀비
		if mapIndex == 132 and idx == 2 then return 1.0 end  -- 쿨리좀비
		if mapIndex == 133 and idx == 1 then return 1.0 end  -- 쿨리좀비
		if mapIndex == 133 and idx == 2 then return 1.3 end  -- 마이너좀비
		return 0.25
	end

	-- 원거리 종 전용 히트 이펙트(attack1/info/hit 서브클립) RUID — 네펜데스/다크네펜데스에 한해 채운다
	-- (유저 요청: "문어처럼(먹물쏘는거) 얘네도 원거리니깐 같은 방식으로 히트 이펙트 나와야해"). 거대
	-- 네펜데스 2페이즈는 존 풀을 거치지 않으므로 GiantNepenthesHitEffectRUID를 별도로 직접 읽는다
	-- (MonsterAI.ReviveAsPhase2 참고).
	@ExecSpace("ServerOnly")
	method string GetMapHitEffectRUID(integer mapIndex, integer idx)
		if mapIndex == 46 and idx == 2 then return "b3ac51bad61642048fc0ba959847bb44" end  -- 네펜데스
		if mapIndex == 50 and idx == 1 then return "adc1da51e5464f6bbd64fbaa2d0dcec8" end  -- 다크네펜데스
		if mapIndex == 53 and idx == 3 then return "b3ac51bad61642048fc0ba959847bb44" end  -- 네펜데스
		if mapIndex == 54 and idx == 3 then return "adc1da51e5464f6bbd64fbaa2d0dcec8" end  -- 다크네펜데스
		if mapIndex == 56 and idx == 2 then return "b3ac51bad61642048fc0ba959847bb44" end  -- 네펜데스
		if mapIndex == 59 and idx == 3 then return "adc1da51e5464f6bbd64fbaa2d0dcec8" end  -- 다크네펜데스
		-- 버그 수정(2026-08-20, 유저 리포트 "스코피/골든스코피는 원거리인데 네펜데스처럼 화면 공격
		-- 연출이 있어야함") — GetMapIsRanged는 이미 스코피/골든스코피를 원거리로 표시하고 있었고
		-- MonsterAI._attackRUID(스코피는 attack1 애니메이션이 있음) 분기도 PlayRangedHitEffect()를
		-- 무조건 호출하고 있었지만, 정작 재생할 RUID(GetMapHitEffectRUID)가 비어있어서 아무것도 안
		-- 나왔다 — 데이터만 빠진 상태였다. GetMapIsRanged의 스코피/골든스코피 항목과 정확히 동일한
		-- (mapIndex, idx) 조합에 유저가 지정한 RUID를 채운다.
		if mapIndex == 65 and idx == 2 then return "213cc0d103e541218fb6005d221d2829" end  -- 골든스코피
		if mapIndex == 67 and idx == 1 then return "213cc0d103e541218fb6005d221d2829" end  -- 스코피
		if mapIndex == 68 and idx == 1 then return "213cc0d103e541218fb6005d221d2829" end  -- 골든스코피
		if mapIndex == 71 and idx == 1 then return "213cc0d103e541218fb6005d221d2829" end  -- 스코피
		if mapIndex == 72 and idx == 1 then return "213cc0d103e541218fb6005d221d2829" end  -- 골든스코피
		if mapIndex == 73 and idx == 2 then return "213cc0d103e541218fb6005d221d2829" end  -- 골든스코피
		if mapIndex == 77 and idx == 1 then return "213cc0d103e541218fb6005d221d2829" end  -- 스코피
		if mapIndex == 78 and idx == 1 then return "213cc0d103e541218fb6005d221d2829" end  -- 골든스코피
		if mapIndex == 81 and idx == 1 then return "213cc0d103e541218fb6005d221d2829" end  -- 스코피
		if mapIndex == 82 and idx == 1 then return "213cc0d103e541218fb6005d221d2829" end  -- 골든스코피
		if mapIndex == 83 and idx == 2 then return "213cc0d103e541218fb6005d221d2829" end  -- 골든스코피
		if mapIndex == 84 and idx == 3 then return "213cc0d103e541218fb6005d221d2829" end  -- 골든스코피
		-- 몽실생크림(원거리, 에피소드3 map1) 히트 이펙트 — 유저 지정: "원거리니깐 이 연출 화면에
		-- 보이게해야지"(mob/9500579.img attack1/info/hit 서브클립).
		if mapIndex == 95 and idx == 1 then return "7820fab74d294b2d96947f3488cfb4cc" end  -- 몽실생크림
		if mapIndex == 97 and idx == 2 then return "7820fab74d294b2d96947f3488cfb4cc" end  -- 몽실생크림
		if mapIndex == 98 and idx == 3 then return "7820fab74d294b2d96947f3488cfb4cc" end  -- 몽실생크림
		-- 예티/다크예티/예티와페페/다크예티와페페(에피소드3 map2) — 유저 지정: "얘넨 원거리라 히트 연출
		-- 있어야함", 문어 먹물처럼 화면에 쏴지는 전용 RUID(4개 종 공용 태그 리소스).
		if mapIndex == 104 and idx == 1 then return "e260beea27054249a6e6af8f29f6e840" end  -- 예티
		if mapIndex == 105 and idx == 1 then return "e260beea27054249a6e6af8f29f6e840" end  -- 다크예티
		if mapIndex == 105 and idx == 3 then return "e260beea27054249a6e6af8f29f6e840" end  -- 예티
		if mapIndex == 106 and idx == 1 then return "e260beea27054249a6e6af8f29f6e840" end  -- 예티와페페
		if mapIndex == 106 and idx == 2 then return "e260beea27054249a6e6af8f29f6e840" end  -- 다크예티
		if mapIndex == 107 and idx == 1 then return "e260beea27054249a6e6af8f29f6e840" end  -- 다크예티와페페
		if mapIndex == 107 and idx == 2 then return "e260beea27054249a6e6af8f29f6e840" end  -- 예티와페페
		if mapIndex == 107 and idx == 3 then return "e260beea27054249a6e6af8f29f6e840" end  -- 예티
		if mapIndex == 108 and idx == 1 then return "e260beea27054249a6e6af8f29f6e840" end  -- 다크예티와페페
		if mapIndex == 108 and idx == 2 then return "e260beea27054249a6e6af8f29f6e840" end  -- 예티와페페
		if mapIndex == 108 and idx == 3 then return "e260beea27054249a6e6af8f29f6e840" end  -- 다크예티
		-- 에피소드3 map3(109~118) — 스노우맨(원거리, 유저 지정)은 자체 attack1/info/hit 서브클립을 쓴다.
		-- 예티류(114~118에 재등장)는 위와 동일한 먹물 RUID를 그대로 이어서 쓴다.
		if mapIndex == 111 and idx == 2 then return "61a7400399b74971ac00644cecde6c77" end  -- 스노우맨
		if mapIndex == 113 and idx == 1 then return "61a7400399b74971ac00644cecde6c77" end  -- 스노우맨
		if mapIndex == 115 and idx == 2 then return "61a7400399b74971ac00644cecde6c77" end  -- 스노우맨
		if mapIndex == 117 and idx == 2 then return "61a7400399b74971ac00644cecde6c77" end  -- 스노우맨
		if mapIndex == 114 and idx == 1 then return "e260beea27054249a6e6af8f29f6e840" end  -- 예티
		if mapIndex == 115 and idx == 1 then return "e260beea27054249a6e6af8f29f6e840" end  -- 다크예티
		if mapIndex == 116 and idx == 1 then return "e260beea27054249a6e6af8f29f6e840" end  -- 예티와페페
		if mapIndex == 117 and idx == 1 then return "e260beea27054249a6e6af8f29f6e840" end  -- 다크예티와페페
		if mapIndex == 118 and idx == 1 then return "e260beea27054249a6e6af8f29f6e840" end  -- 다크예티와페페
		if mapIndex == 118 and idx == 2 then return "e260beea27054249a6e6af8f29f6e840" end  -- 예티와페페
		if mapIndex == 118 and idx == 3 then return "e260beea27054249a6e6af8f29f6e840" end  -- 다크예티
		if mapIndex == 118 and idx == 4 then return "e260beea27054249a6e6af8f29f6e840" end  -- 예티
		-- 마이너좀비(원거리, ep3_map4_ester_1 129~133, 미배선) 히트 이펙트 — 몽실생크림과 동일 원칙으로
		-- 자기 팩 attack2/info/hit 서브클립 사용.
		if mapIndex == 129 and idx == 2 then return "d83c452979174c8ab4c1e4a513673ddf" end  -- 마이너좀비
		if mapIndex == 130 and idx == 1 then return "d83c452979174c8ab4c1e4a513673ddf" end  -- 마이너좀비
		if mapIndex == 133 and idx == 2 then return "d83c452979174c8ab4c1e4a513673ddf" end  -- 마이너좀비
		return ""
	end

	-- 스노우맨(원거리, ep3_map3 109~118) 전용 — 몬스터 위치에서 플레이어 위치까지 실제로 날아가는
	-- 눈덩이 투사체 서브클립(attack1/info/ball, 유저 제공). GetMapHitEffectRUID(attack1/info/hit,
	-- 착탄 순간 플레이어 위치에 뜨는 정지형 이펙트)와는 별개 — 이건 몬스터→플레이어로 이동하는
	-- 투사체 자체를 그린다(MonsterAI.PlayRangedProjectile이 사용). 빈 문자열이면 투사체 없이
	-- 착탄 이펙트만 뜬다(기존 동작 그대로 유지).
	@ExecSpace("ServerOnly")
	method string GetMapProjectileRUID(integer mapIndex, integer idx)
		if mapIndex == 111 and idx == 2 then return "1325ee6c65874b01ae5581b3f3d7a3f8" end  -- 스노우맨
		if mapIndex == 113 and idx == 1 then return "1325ee6c65874b01ae5581b3f3d7a3f8" end  -- 스노우맨
		if mapIndex == 115 and idx == 2 then return "1325ee6c65874b01ae5581b3f3d7a3f8" end  -- 스노우맨
		if mapIndex == 117 and idx == 2 then return "1325ee6c65874b01ae5581b3f3d7a3f8" end  -- 스노우맨
		return ""
	end

	-- 네펜데스/다크네펜데스 히트 이펙트 재생 시간(둘 다 6프레임 실측)
	@ExecSpace("ServerOnly")
	method number GetMapHitEffectDuration(integer mapIndex, integer idx)
		-- 공식값(0.05+0.1*6=0.65)대로 Destroy를 걸었더니 실제 재생속도가 가정한 10fps보다 살짝
		-- 빨라서 한 바퀴 다 돈 뒤 처음 프레임으로 되돌아가 "두 번 루프되는" 것처럼 보였다(반딧불
		-- 슬라임 등 기존에도 반복된 케이스와 동일 원인) — 유저 요청: "연출이 1번만 루프되야함".
		-- 루프 시작 전에 확실히 끊기도록 공식값보다 낮춘다.
		if mapIndex == 46 and idx == 2 then return 0.5 end
		if mapIndex == 50 and idx == 1 then return 0.5 end
		if mapIndex == 53 and idx == 3 then return 0.5 end
		if mapIndex == 54 and idx == 3 then return 0.5 end
		if mapIndex == 56 and idx == 2 then return 0.5 end
		if mapIndex == 59 and idx == 3 then return 0.5 end
		-- 스코피/골든스코피 원거리 히트 이펙트(4프레임 실측, msw-search) — 네펜데스와 같은 이유로
		-- 공식값(0.05+0.1*4=0.45)보다 살짝 낮춰서 재생 중 프레임0으로 되감기는 것을 방지한다.
		if mapIndex == 65 and idx == 2 then return 0.35 end  -- 골든스코피
		if mapIndex == 67 and idx == 1 then return 0.35 end  -- 스코피
		if mapIndex == 68 and idx == 1 then return 0.35 end  -- 골든스코피
		if mapIndex == 71 and idx == 1 then return 0.35 end  -- 스코피
		if mapIndex == 72 and idx == 1 then return 0.35 end  -- 골든스코피
		if mapIndex == 73 and idx == 2 then return 0.35 end  -- 골든스코피
		if mapIndex == 77 and idx == 1 then return 0.35 end  -- 스코피
		if mapIndex == 78 and idx == 1 then return 0.35 end  -- 골든스코피
		if mapIndex == 81 and idx == 1 then return 0.35 end  -- 스코피
		if mapIndex == 82 and idx == 1 then return 0.35 end  -- 골든스코피
		if mapIndex == 83 and idx == 2 then return 0.35 end  -- 골든스코피
		if mapIndex == 84 and idx == 3 then return 0.35 end  -- 골든스코피
		-- 몽실생크림 히트 이펙트(6프레임 실측) — 네펜데스와 동일 이유(공식값 0.65가 실제 재생시간보다
		-- 살짝 길어 루프 시작 전에 끊기도록 0.5로 낮춤).
		if mapIndex == 95 and idx == 1 then return 0.5 end  -- 몽실생크림
		if mapIndex == 97 and idx == 2 then return 0.5 end  -- 몽실생크림
		if mapIndex == 98 and idx == 3 then return 0.5 end  -- 몽실생크림
		-- 예티류 먹물 히트 이펙트(4프레임 실측, msw-search) — 스코피/골든스코피와 동일 프레임수라
		-- 동일하게 공식값(0.45)보다 낮춘 0.35를 쓴다.
		if mapIndex == 104 and idx == 1 then return 0.35 end
		if mapIndex == 105 and idx == 1 then return 0.35 end
		if mapIndex == 105 and idx == 3 then return 0.35 end
		if mapIndex == 106 and idx == 1 then return 0.35 end
		if mapIndex == 106 and idx == 2 then return 0.35 end
		if mapIndex == 107 and idx == 1 then return 0.35 end
		if mapIndex == 107 and idx == 2 then return 0.35 end
		if mapIndex == 107 and idx == 3 then return 0.35 end
		if mapIndex == 108 and idx == 1 then return 0.35 end
		if mapIndex == 108 and idx == 2 then return 0.35 end
		if mapIndex == 108 and idx == 3 then return 0.35 end
		-- 에피소드3 map3(109~118) — 예티류(114~118) 먹물 이펙트는 위와 동일하게 0.35.
		if mapIndex == 114 and idx == 1 then return 0.35 end
		if mapIndex == 115 and idx == 1 then return 0.35 end
		if mapIndex == 116 and idx == 1 then return 0.35 end
		if mapIndex == 117 and idx == 1 then return 0.35 end
		if mapIndex == 118 and idx == 1 then return 0.35 end
		if mapIndex == 118 and idx == 2 then return 0.35 end
		if mapIndex == 118 and idx == 3 then return 0.35 end
		if mapIndex == 118 and idx == 4 then return 0.35 end
		-- 스노우맨 히트 이펙트(attack1/info/hit 5프레임 실측) — 공식값(0.55)보다 낮춘 0.45.
		if mapIndex == 111 and idx == 2 then return 0.45 end
		if mapIndex == 113 and idx == 1 then return 0.45 end
		if mapIndex == 115 and idx == 2 then return 0.45 end
		if mapIndex == 117 and idx == 2 then return 0.45 end
		-- 마이너좀비 히트 이펙트(attack2/info/hit 6프레임 실측, 몽실생크림과 동일 원칙) — 0.5.
		if mapIndex == 129 and idx == 2 then return 0.5 end
		if mapIndex == 130 and idx == 1 then return 0.5 end
		if mapIndex == 133 and idx == 2 then return 0.5 end
		return 0.25
	end

	-- 맵 전용 몬스터 풀 중 원거리 공격 종인지 여부 — 맵12의 3번째 종(불가사리 문어 슬라임, 먹물)에 이어
	-- 존31(루팡)/존34의 2번째 종(좀비루팡)도 추가(그룹J, 정글 컨셉 — 둘 다 attack1이 있어 먹물 대체 연출은
	-- 타지 않고 스폰 위치만 MonsterSpawner.GetRangedTileRange의 존별 전용 타일섬으로 바뀐다).
	@ExecSpace("ServerOnly")
	method boolean GetMapIsRanged(integer mapIndex, integer idx)
		if mapIndex == 12 and idx == 3 then return true end
		if mapIndex == 31 and idx == 1 then return true end
		if mapIndex == 34 and idx == 2 then return true end
		-- 에피소드2 네펜데스류(원거리)
		if mapIndex == 46 and idx == 2 then return true end
		if mapIndex == 50 and idx == 1 then return true end
		if mapIndex == 53 and idx == 3 then return true end
		if mapIndex == 54 and idx == 3 then return true end
		if mapIndex == 56 and idx == 2 then return true end
		if mapIndex == 59 and idx == 3 then return true end
		-- 에피소드2 map3/map4(니할 사막 컨셉) 스코피/골든스코피(원거리)
		if mapIndex == 65 and idx == 2 then return true end
		if mapIndex == 67 and idx == 1 then return true end
		if mapIndex == 68 and idx == 1 then return true end
		if mapIndex == 71 and idx == 1 then return true end
		if mapIndex == 72 and idx == 1 then return true end
		if mapIndex == 73 and idx == 2 then return true end
		if mapIndex == 77 and idx == 1 then return true end
		if mapIndex == 78 and idx == 1 then return true end
		if mapIndex == 81 and idx == 1 then return true end
		if mapIndex == 82 and idx == 1 then return true end
		if mapIndex == 83 and idx == 2 then return true end
		if mapIndex == 84 and idx == 3 then return true end
		-- 에피소드3 map1(89~98) 몽실 생크림(원거리, 자체 attack1 보유 — 홉 없이 제자리에서 공격 포즈만 재생)
		if mapIndex == 95 and idx == 1 then return true end
		if mapIndex == 97 and idx == 2 then return true end
		if mapIndex == 98 and idx == 3 then return true end
		-- 에피소드3 map2(99~108) 예티/다크예티/예티와페페/다크예티와페페 — 유저 지정: "얘넨 원거리라
		-- 히트 연출 있어야함". 전부 자체 attack1을 보유하므로 몽실생크림과 동일 패턴(홉 없이 제자리
		-- 공격 포즈 재생).
		if mapIndex == 104 and idx == 1 then return true end  -- 예티
		if mapIndex == 105 and idx == 1 then return true end  -- 다크예티
		if mapIndex == 105 and idx == 3 then return true end  -- 예티
		if mapIndex == 106 and idx == 1 then return true end  -- 예티와페페
		if mapIndex == 106 and idx == 2 then return true end  -- 다크예티
		if mapIndex == 107 and idx == 1 then return true end  -- 다크예티와페페
		if mapIndex == 107 and idx == 2 then return true end  -- 예티와페페
		if mapIndex == 107 and idx == 3 then return true end  -- 예티
		if mapIndex == 108 and idx == 1 then return true end  -- 다크예티와페페
		if mapIndex == 108 and idx == 2 then return true end  -- 예티와페페
		if mapIndex == 108 and idx == 3 then return true end  -- 다크예티
		-- 에피소드3 map3(109~118) — 스노우맨(유저 지정 원거리)과 재등장하는 예티류(114~118) 전부 원거리.
		if mapIndex == 111 and idx == 2 then return true end  -- 스노우맨
		if mapIndex == 113 and idx == 1 then return true end  -- 스노우맨
		if mapIndex == 115 and idx == 2 then return true end  -- 스노우맨
		if mapIndex == 117 and idx == 2 then return true end  -- 스노우맨
		if mapIndex == 114 and idx == 1 then return true end  -- 예티
		if mapIndex == 115 and idx == 1 then return true end  -- 다크예티
		if mapIndex == 116 and idx == 1 then return true end  -- 예티와페페
		if mapIndex == 117 and idx == 1 then return true end  -- 다크예티와페페
		if mapIndex == 118 and idx == 1 then return true end  -- 다크예티와페페
		if mapIndex == 118 and idx == 2 then return true end  -- 예티와페페
		if mapIndex == 118 and idx == 3 then return true end  -- 다크예티
		if mapIndex == 118 and idx == 4 then return true end  -- 예티
		-- ep3_map4_ester_1(129~133, 이스터에그 전용, 미배선) 마이너좀비(원거리, attack2 전용)
		if mapIndex == 129 and idx == 2 then return true end  -- 마이너좀비
		if mapIndex == 130 and idx == 1 then return true end  -- 마이너좀비
		if mapIndex == 133 and idx == 2 then return true end  -- 마이너좀비
		return false
	end

	-- 맵 전용 몬스터 풀 중 원거리(칼자국) 공격 종인지 여부 — 존27의 2번째 종(자이언트 쉐도우)만 해당.
	-- 먹물(GetMapIsRanged)과 달리 자체 attack1 애니메이션을 대체하지 않고 화면 슬래시 마크를 그 위에
	-- 얹는다(MonsterAI.OnReachPlayer 참고).
	@ExecSpace("ServerOnly")
	method boolean GetMapIsRangedSlash(integer mapIndex, integer idx)
		return mapIndex == 27 and idx == 2
	end

	-- 맵 전용 몬스터 풀 중 비행형 종인지 여부 — 맵15의 2번째 종(박쥐), 맵16의 1번째 종(내면의 그림자),
	-- 맵20의 2번째 종(페어리), 맵22의 1번째 종(로얄 페어리).
	-- 맵24(워터/트리 엘리먼트 둘 다 비행형), 맵25의 1번째 종(미스틱 위습), 맵26의 1/3번째 종(워터 엘리먼트/미스틱 위습).
	-- 맵28의 2번째 종(스티지) — 유저가 처음엔 "쉐도우 블레이드가 비행형"이라고 했다가 "스티지가 비행형"으로
	-- 정정했다(쉐도우 블레이드 자신은 지상형).
	-- 비행형은 발판 레이캐스트로 바닥에 고정되지 않고 화면 안 임의의 높이(공중)에 스폰된다
	-- (MonsterSpawner.GetSpawnPosition 참고)
	@ExecSpace("ServerOnly")
	method boolean GetMapIsFlying(integer mapIndex, integer idx)
		if mapIndex == 15 and idx == 2 then return true end
		if mapIndex == 16 and idx == 1 then return true end
		if mapIndex == 20 and idx == 2 then return true end
		if mapIndex == 22 and idx == 1 then return true end
		if mapIndex == 24 then return true end
		if mapIndex == 25 and idx == 1 then return true end
		if mapIndex == 26 and (idx == 1 or idx == 3) then return true end
		if mapIndex == 28 and idx == 2 then return true end
		if mapIndex == 33 and idx == 1 then return true end  -- 바나나갈매기
		if mapIndex == 34 and idx == 1 then return true end  -- 바나나갈매기(재사용)
		if mapIndex == 37 and idx == 3 then return true end  -- 스티지(존28 재사용)
		if mapIndex == 38 and idx == 3 then return true end  -- 스티지(재사용)
		if mapIndex == 39 and (idx == 1 or idx == 2) then return true end  -- 멜러디/스티지
		if mapIndex == 40 and idx == 1 then return true end  -- 주니어 레이스
		if mapIndex == 42 and idx == 1 then return true end  -- 레이스
		if mapIndex == 43 and idx == 2 then return true end  -- 레이스(재사용)
		-- 에피소드2 — 러스터픽시/고스트픽시(비행형)
		if mapIndex == 47 and idx == 1 then return true end  -- 러스터픽시
		if mapIndex == 48 and (idx == 1 or idx == 2) then return true end  -- 러스터픽시/고스트픽시
		if mapIndex == 50 and idx == 2 then return true end  -- 러스터픽시
		if mapIndex == 51 and idx == 1 then return true end  -- 고스트픽시
		if mapIndex == 52 and idx == 2 then return true end  -- 러스터픽시
		if mapIndex == 54 and idx == 2 then return true end  -- 고스트픽시
		-- 에피소드2 map2(존1~10 = mapIndex 55~64) — 러스터픽시/고스트픽시(비행형)
		if mapIndex == 58 then return true end  -- 러스터픽시/고스트픽시(2종 전부)
		if mapIndex == 61 and idx == 2 then return true end  -- 고스트픽시
		if mapIndex == 63 and idx == 2 then return true end  -- 고스트픽시
		if mapIndex == 64 and (idx == 1 or idx == 2) then return true end  -- 러스터픽시/고스트픽시
		-- 에피소드2 map3/map4(니할 사막 컨셉) 발광 박쥐(비행형)
		if mapIndex == 67 and idx == 2 then return true end
		if mapIndex == 68 and idx == 3 then return true end
		if mapIndex == 69 and idx == 1 then return true end
		if mapIndex == 70 and idx == 3 then return true end
		if mapIndex == 74 and idx == 3 then return true end
		if mapIndex == 76 and idx == 2 then return true end
		if mapIndex == 80 and idx == 3 then return true end
		if mapIndex == 83 and idx == 1 then return true end
		-- 에피소드3 map1(89~98) 리티/다크리티(비행형)
		if mapIndex == 90 and idx == 1 then return true end  -- 리티
		if mapIndex == 91 and idx == 2 then return true end  -- 리티
		if mapIndex == 93 and idx == 1 then return true end  -- 다크리티
		if mapIndex == 95 and idx == 2 then return true end  -- 리티
		if mapIndex == 96 and idx == 3 then return true end  -- 다크리티
		-- 에피소드3 map2(99~108) 리티/다크리티/파랑미니빈(비행형)
		if mapIndex == 100 and idx == 1 then return true end  -- 리티
		if mapIndex == 101 and idx == 2 then return true end  -- 리티
		if mapIndex == 101 and idx == 3 then return true end  -- 파랑미니빈
		if mapIndex == 102 and idx == 1 then return true end  -- 다크리티
		if mapIndex == 103 and idx == 1 then return true end  -- 파랑미니빈
		if mapIndex == 104 and idx == 2 then return true end  -- 다크리티
		if mapIndex == 104 and idx == 3 then return true end  -- 리티
		if mapIndex == 105 and idx == 2 then return true end  -- 파랑미니빈
		if mapIndex == 106 and idx == 3 then return true end  -- 다크리티
		-- 에피소드3 map3(109~118) 플라이아이(비행형, fly 클립을 stand로 재사용)
		if mapIndex == 110 and idx == 2 then return true end  -- 플라이아이
		if mapIndex == 112 and idx == 3 then return true end  -- 플라이아이
		if mapIndex == 113 and idx == 2 then return true end  -- 플라이아이
		if mapIndex == 115 and idx == 3 then return true end  -- 플라이아이
		if mapIndex == 117 and idx == 3 then return true end  -- 플라이아이
		-- ep3_map4_ester_1(129~133, 이스터에그 전용, 미배선) 플라이아이(비행형)
		if mapIndex == 130 and idx == 2 then return true end  -- 플라이아이
		if mapIndex == 131 and idx == 1 then return true end  -- 플라이아이
		if mapIndex == 133 and idx == 3 then return true end  -- 플라이아이
		return false
	end

	-- 맵 전용 몬스터 풀 중 돌진형 종인지 여부 — 에피소드2 map3/map4(니할 사막 컨셉) 맘무트/골든맘무트/트라고스.
	-- 스폰 후 GetMapChargeShakeDuration만큼 제자리에서 떨다가(위아래 진동), 그 뒤로 먼지 이펙트를 뒤에
	-- 남기며 빠르게 돌진해 접근한다(MonsterAI._isCharge 상태머신 참고).
	@ExecSpace("ServerOnly")
	method boolean GetMapIsCharge(integer mapIndex, integer idx)
		if mapIndex == 66 and idx == 3 then return true end  -- 맘무트
		if mapIndex == 68 and idx == 2 then return true end  -- 골든맘무트
		if mapIndex == 70 and (idx == 1 or idx == 2) then return true end  -- 트라고스/골든맘무트
		if mapIndex == 71 and idx == 2 then return true end  -- 골든맘무트
		if mapIndex == 73 and idx == 1 then return true end  -- 트라고스
		if mapIndex == 74 and idx == 1 then return true end  -- 트라고스
		if mapIndex == 80 and (idx == 1 or idx == 2) then return true end  -- 맘무트/골든맘무트
		if mapIndex == 81 and idx == 2 then return true end  -- 골든맘무트
		if mapIndex == 84 and idx == 1 then return true end  -- 맘무트
		return false
	end

	-- 돌진형 종의 제자리 떨림(wind-up) 지속시간(초) — 맘무트/골든맘무트=2초, 트라고스=1초(유저 지정).
	@ExecSpace("ServerOnly")
	method number GetMapChargeShakeDuration(integer mapIndex, integer idx)
		if mapIndex == 70 and idx == 1 then return 1.0 end  -- 트라고스
		if mapIndex == 73 and idx == 1 then return 1.0 end  -- 트라고스
		if mapIndex == 74 and idx == 1 then return 1.0 end  -- 트라고스
		return 2.0  -- 맘무트/골든맘무트
	end

	-- 처치해도(공격을 안 받아서) 절대 반격하지 않는 고정형 종 — 거대 네펜데스 1페이즈(첫 등장) 전용
	-- (MonsterAI._neverAttacks). InitializeStats(zoneIndex>=7 경로)가 스폰 즉시 이 값을 읽어 반영한다.
	-- 2페이즈(부활 후)는 MonsterAI.ReviveAsPhase2가 _neverAttacks를 직접 false로 바꿔 원거리 공격을 켠다.
	@ExecSpace("ServerOnly")
	method boolean GetMapNeverAttacks(integer mapIndex, integer idx)
		if mapIndex == 51 and idx == 2 then return true end  -- 거대네펜데스
		if mapIndex == 52 and idx == 1 then return true end  -- 거대네펜데스
		if mapIndex == 54 and idx == 1 then return true end  -- 거대네펜데스
		if mapIndex == 60 and idx == 1 then return true end  -- 거대네펜데스
		if mapIndex == 62 and idx == 1 then return true end  -- 거대네펜데스
		if mapIndex == 63 and idx == 1 then return true end  -- 거대네펜데스
		return false
	end

	-- 거대 네펜데스 2단계 부활 메커니즘(MonsterAI._isGiantNepenthes) 대상 여부. GetMapNeverAttacks와
	-- 지금은 같은 슬롯을 가리키지만 의도적으로 별도 플래그로 분리한다 — 훗날 "공격 안 함"이 다른 종에도
	-- 쓰이게 되면 그 종까지 이 부활 메커니즘을 같이 타는 사고를 막기 위함.
	@ExecSpace("ServerOnly")
	method boolean GetMapIsGiantNepenthes(integer mapIndex, integer idx)
		if mapIndex == 51 and idx == 2 then return true end  -- 거대네펜데스
		if mapIndex == 52 and idx == 1 then return true end  -- 거대네펜데스
		if mapIndex == 54 and idx == 1 then return true end  -- 거대네펜데스
		if mapIndex == 60 and idx == 1 then return true end  -- 거대네펜데스
		if mapIndex == 62 and idx == 1 then return true end  -- 거대네펜데스
		if mapIndex == 63 and idx == 1 then return true end  -- 거대네펜데스
		return false
	end

	-- 에피소드3 map2 예티/다크예티/예티와페페/다크예티와페페 전용 범용 2단계 부활 메커니즘
	-- (MonsterAI._hasPhase2, 유저 지정 — "거대 네펜데스처럼 페이즈가 나눠져있는 몬스터"). 거대 네펜데스와
	-- 달리 종마다 1/2페이즈 외형이 전부 달라서 고정 프로퍼티가 아니라 이 존 풀 테이블로 관리한다.
	-- 예티→다크예티, 다크예티→다크예티와페페(페페 지원 합류), 예티와페페→예티(유저 지정 die1=
	-- c1fc1074...로 확인, 2026-08-25 정정 — 페페가 먼저 쓰러지고 격노한 예티만 남는 방향),
	-- 다크예티와페페→다크예티로 전환된다(듀오가 되었다가, 듀오 상태에서 다시 죽으면 페페 쪽이 먼저
	-- 쓰러지고 예티만 남는 서사 — 유저 지정).
	@ExecSpace("ServerOnly")
	method boolean GetMapHasPhase2(integer mapIndex, integer idx)
		-- 주니어예티 3슬롯(99/1, 100/2, 102/2)은 이 함수를 거치지 않는다 — MonsterAI.InitializeStats가
		-- GetMapIsJuniorYetiPhase2Roll로 먼저 걸러서 스폰 시점 50% 코인플립으로 직접 결정한다
		-- (그 결과가 곧 이 몬스터의 _hasPhase2다). 아래는 항상 확정(_hasPhase2=true)인 나머지 종만 다룬다.
		if mapIndex == 104 and idx == 1 then return true end  -- 예티
		if mapIndex == 105 and idx == 1 then return true end  -- 다크예티
		if mapIndex == 105 and idx == 3 then return true end  -- 예티
		if mapIndex == 106 and idx == 1 then return true end  -- 예티와페페
		if mapIndex == 106 and idx == 2 then return true end  -- 다크예티
		if mapIndex == 107 and idx == 1 then return true end  -- 다크예티와페페
		if mapIndex == 107 and idx == 2 then return true end  -- 예티와페페
		if mapIndex == 107 and idx == 3 then return true end  -- 예티
		if mapIndex == 108 and idx == 1 then return true end  -- 다크예티와페페
		if mapIndex == 108 and idx == 2 then return true end  -- 예티와페페
		if mapIndex == 108 and idx == 3 then return true end  -- 다크예티
		-- 에피소드3 map3(109~118)에 재등장하는 예티류(114~118)도 동일하게 2페이즈.
		if mapIndex == 114 and idx == 1 then return true end  -- 예티
		if mapIndex == 115 and idx == 1 then return true end  -- 다크예티
		if mapIndex == 116 and idx == 1 then return true end  -- 예티와페페
		if mapIndex == 117 and idx == 1 then return true end  -- 다크예티와페페
		if mapIndex == 118 and idx == 1 then return true end  -- 다크예티와페페
		if mapIndex == 118 and idx == 2 then return true end  -- 예티와페페
		if mapIndex == 118 and idx == 3 then return true end  -- 다크예티
		if mapIndex == 118 and idx == 4 then return true end  -- 예티
		return false
	end

	-- 2페이즈 발동 확률(항상 1.0 — 이 함수를 거치는 종은 전부 확정 부활이다). 주니어예티는 여기 없다 —
	-- "50% 확률로 부활하냐 마냐"가 아니라 "스폰될 때부터 이미 어느 개체인지가 정해져 있다"(유저 최종
	-- 지정, 2026-08-25 재재정정: "예티는 죽을때 바로죽거나 페이즈2로 넘어가 그확률이 50%... 스폰될때
	-- 정할꺼면 [페이즈없는 예티 팩]/[페이즈있는 예티 팩] 이거 쓰면 되고") — 그래서 코인플립은
	-- MonsterAI.InitializeStats에서 스폰 시점에 한 번만 일어나고, 그 결과(_hasPhase2)가 이미 확정이라
	-- Die()에서 또 확률을 굴릴 필요가 없다(=1.0).
	@ExecSpace("ServerOnly")
	method number GetMapPhase2Chance(integer mapIndex, integer idx)
		return 1.0
	end

	-- 주니어예티(라이트) 3슬롯(99/1, 100/2, 102/2) + 다크주니어예티 3슬롯(99/2, 101/1, 103/2) 판별 —
	-- 이 6슬롯만 GetMapHasPhase2를 거치지 않고 MonsterAI.InitializeStats에서 스폰 시점에 직접 50%
	-- 코인플립으로 "페이즈있는"/"페이즈없는" 두 리소스팩 중 하나를 확정한다. 어느 종(라이트/다크)인지는
	-- GetMapIsJuniorYetiDark로 별도 판별한다. 유저 지정 리소스팩(2026-08-25, 다크는 재재재후속):
	--   [라이트] 페이즈없는 예티(resource_pack "주니어 예티", 그냥 죽는다 — voice 사운드):
	--     stand=1975dd704eec461ab49bdeb0c11c54d9 move=842a6865f7074f94ac4a190ed90e2e21
	--     hit1=63a1a5f280f04e55b935d6a2155edcef die1=13b9f2b2f7664cc5a08e663f2fe0502b(5프레임=0.55초)
	--     hitSound(voice)=6f4dcabb6d9941a38f84c1cc6b5cdad8 dieSound(voice)=6f3ab281ca93458d9b122b8d5cbf60df
	--   [라이트] 페이즈있는 예티(resource_pack "주니어 예티", die1 자체가 변신 모션 — effect 사운드):
	--     stand=48399164e47a4c0ebf7b09332ffee38f move=6f11483b09a942f4b954e238f86e4d13
	--     hit1=59be70295ac0403ba16e0ed911920906 die1=f7ee11ac35cd4983b592d51cbabc0a55(16프레임=1.65초,
	--     msw-search 실측 — 예전에 0.75초로 잘못 줄였다가 "die1이 도중에 끊긴다"는 유저 리포트의 원인이었음)
	--     hitSound(effect)=a0f695a2323c43378124889d88ef1d1e dieSound(effect)=3f970229ffde4240b129112a59925f93
	--   [다크] 페이즈없는 다크주니어예티(resource_pack "다크 주니어 예티" — voice 사운드):
	--     stand=ce56cf9613174f80976dab5b61f7b604 move=8d2b8951794d406a86cc580e9eeff18d
	--     hit1=cbe070cdf1fa4611a3529f3d70296a33 die1=fad50a0e478c40fcbd383e069bc278da(5프레임=0.55초)
	--     hitSound(voice)=f5b7e04a5ac6496cac77b016ea13a16f dieSound(voice)=53324cebb7744fe69b7c972568192375
	--   [다크] 페이즈있는 다크주니어예티(resource_pack "다크 주니어 예티", die1=변신 모션 — effect 사운드):
	--     stand=92b8be5ea1164ccf839ebfc3f76ecb46 move=1e7b429eb65e497db96b0c70defbc971
	--     hit1=8cab9c536b5347e7b29c62310d9709df die1=5c4af8b63f6d4bb981bd14257751e34c(16프레임=1.65초, 실측)
	--     hitSound(effect)=19da3f9e06b948f49b8ad43647b3e73a dieSound(effect)=7b1c4562c6564cc5bbf7594f20c95260
	-- 실제 값 대입은 MonsterAI.InitializeStats에 하드코딩되어 있다(RUID 6개+dieDuration 2개뿐이라 이
	-- 함수는 판별만 담당). 다크 쪽 2페이즈 목표(부활 후 외형)는 기존에 이미 검증된 zone104 idx1(예티→
	-- 다크예티)의 다크예티 값을 그대로 재사용한다(GetMapPhase2*RUID 테이블의 99/2, 101/1, 103/2 슬롯).
	@ExecSpace("ServerOnly")
	method boolean GetMapIsJuniorYetiPhase2Roll(integer mapIndex, integer idx)
		if mapIndex == 99 and idx == 1 then return true end  -- 주니어예티(라이트)
		if mapIndex == 100 and idx == 2 then return true end  -- 주니어예티(라이트)
		if mapIndex == 102 and idx == 2 then return true end  -- 주니어예티(라이트)
		if mapIndex == 99 and idx == 2 then return true end  -- 다크주니어예티
		if mapIndex == 101 and idx == 1 then return true end  -- 다크주니어예티
		if mapIndex == 103 and idx == 2 then return true end  -- 다크주니어예티
		-- 에피소드3 map4(존1~10 = mapIndex 119~128, 유저 지정: 이 맵은 종 구성 자체가 주니어예티+
		-- 다크주니어예티뿐이라 존의 모든 슬롯이 스폰타임 50% 코인플립 대상이다.
		if mapIndex >= 119 and mapIndex <= 128 then return true end
		return false
	end

	-- 위 6슬롯 중 다크주니어예티 3슬롯만 골라낸다 — MonsterAI가 이 값으로 라이트/다크 리소스팩 세트를 고른다.
	@ExecSpace("ServerOnly")
	method boolean GetMapIsJuniorYetiDark(integer mapIndex, integer idx)
		if mapIndex == 99 and idx == 2 then return true end
		if mapIndex == 101 and idx == 1 then return true end
		if mapIndex == 103 and idx == 2 then return true end
		-- 에피소드3 map4(119~128) — 존마다 라이트/다크 비율을 다르게 섞는다(map3는 종 다양성으로
		-- 베리에이션했다면 여기는 라이트/다크 비율로 베리에이션). 119:라이트+다크 120:다크+다크
		-- 121:라이트+라이트 122:라이트+다크+라이트 123:다크+라이트 124:다크+다크+라이트
		-- 125:라이트+다크+다크 126:라이트+라이트+다크 127:다크+라이트+라이트 128:라이트+다크+라이트+다크
		if mapIndex == 119 and idx == 2 then return true end
		if mapIndex == 120 and idx == 1 then return true end
		if mapIndex == 120 and idx == 2 then return true end
		if mapIndex == 122 and idx == 2 then return true end
		if mapIndex == 123 and idx == 1 then return true end
		if mapIndex == 124 and idx == 1 then return true end
		if mapIndex == 124 and idx == 2 then return true end
		if mapIndex == 125 and idx == 2 then return true end
		if mapIndex == 125 and idx == 3 then return true end
		if mapIndex == 126 and idx == 3 then return true end
		if mapIndex == 127 and idx == 1 then return true end
		if mapIndex == 128 and idx == 2 then return true end
		if mapIndex == 128 and idx == 4 then return true end
		return false
	end

	-- Phase2(2페이즈 부활 외형 / 주니어예티 스킨변형 외형) 공용 stand RUID.
	@ExecSpace("ServerOnly")
	method string GetMapPhase2StandRUID(integer mapIndex, integer idx)
		local pools = {
			[99] = {"2fa39477afb34d8cb6412b7fe5085f42", "f6467914a7f84409b2937fa3668db94d"},  -- 주니어예티→예티(성체) / 다크주니어예티→다크예티
			[100] = {"", "2fa39477afb34d8cb6412b7fe5085f42"},  -- 주니어예티→예티(성체)
			[101] = {"f6467914a7f84409b2937fa3668db94d", "", ""},  -- 다크주니어예티→다크예티
			[102] = {"", "2fa39477afb34d8cb6412b7fe5085f42"},  -- 주니어예티→예티(성체)
			[103] = {"", "f6467914a7f84409b2937fa3668db94d"},  -- 다크주니어예티→다크예티
			[104] = {"f6467914a7f84409b2937fa3668db94d", "", ""},  -- 예티→다크예티
			[105] = {"70329bd13ca243198d1afac3f77143a6", "", "f6467914a7f84409b2937fa3668db94d"},  -- 다크예티→다크예티와페페 / 예티→다크예티
			-- 유저 정정(2026-08-25): "예티와페페는 죽는 연출 끝나면 예티로, 다크예티와페페는 다크예티로"
			-- (페페가 먼저 쓰러지고 예티가 격노해서 혼자 남는 방향 — 기존엔 반대로 짜서 수정)
			[106] = {"2fa39477afb34d8cb6412b7fe5085f42", "70329bd13ca243198d1afac3f77143a6", ""},  -- 예티와페페→예티 / 다크예티→다크예티와페페
			[107] = {"f6467914a7f84409b2937fa3668db94d", "2fa39477afb34d8cb6412b7fe5085f42", "f6467914a7f84409b2937fa3668db94d"},  -- 다크예티와페페→다크예티 / 예티와페페→예티 / 예티→다크예티
			[108] = {"f6467914a7f84409b2937fa3668db94d", "2fa39477afb34d8cb6412b7fe5085f42", "70329bd13ca243198d1afac3f77143a6"},  -- 다크예티와페페→다크예티 / 예티와페페→예티 / 다크예티→다크예티와페페
			-- 에피소드3 map3(109~118)에 재등장하는 예티류 — idx2/3(웨어울프 등)은 hasPhase2=false라
			-- 이 테이블을 아예 조회하지 않으므로 idx1 하나만 있으면 충분하다(118만 4종 전부 해당).
			[114] = {"f6467914a7f84409b2937fa3668db94d"},  -- 예티→다크예티
			[115] = {"70329bd13ca243198d1afac3f77143a6"},  -- 다크예티→다크예티와페페
			[116] = {"2fa39477afb34d8cb6412b7fe5085f42"},  -- 예티와페페→예티
			[117] = {"f6467914a7f84409b2937fa3668db94d"},  -- 다크예티와페페→다크예티
			[118] = {"f6467914a7f84409b2937fa3668db94d", "2fa39477afb34d8cb6412b7fe5085f42", "70329bd13ca243198d1afac3f77143a6", "f6467914a7f84409b2937fa3668db94d"},  -- 다크예티와페페→다크예티 / 예티와페페→예티 / 다크예티→다크예티와페페 / 예티→다크예티
			-- 에피소드3 map4(119~128) — 주니어예티→예티(성체) / 다크주니어예티→다크예티(기존 99~103과 동일 목표)
			[119] = {"2fa39477afb34d8cb6412b7fe5085f42", "f6467914a7f84409b2937fa3668db94d"},
			[120] = {"f6467914a7f84409b2937fa3668db94d", "f6467914a7f84409b2937fa3668db94d"},
			[121] = {"2fa39477afb34d8cb6412b7fe5085f42", "2fa39477afb34d8cb6412b7fe5085f42"},
			[122] = {"2fa39477afb34d8cb6412b7fe5085f42", "f6467914a7f84409b2937fa3668db94d", "2fa39477afb34d8cb6412b7fe5085f42"},
			[123] = {"f6467914a7f84409b2937fa3668db94d", "2fa39477afb34d8cb6412b7fe5085f42"},
			[124] = {"f6467914a7f84409b2937fa3668db94d", "f6467914a7f84409b2937fa3668db94d", "2fa39477afb34d8cb6412b7fe5085f42"},
			[125] = {"2fa39477afb34d8cb6412b7fe5085f42", "f6467914a7f84409b2937fa3668db94d", "f6467914a7f84409b2937fa3668db94d"},
			[126] = {"2fa39477afb34d8cb6412b7fe5085f42", "2fa39477afb34d8cb6412b7fe5085f42", "f6467914a7f84409b2937fa3668db94d"},
			[127] = {"f6467914a7f84409b2937fa3668db94d", "2fa39477afb34d8cb6412b7fe5085f42", "2fa39477afb34d8cb6412b7fe5085f42"},
			[128] = {"2fa39477afb34d8cb6412b7fe5085f42", "f6467914a7f84409b2937fa3668db94d", "2fa39477afb34d8cb6412b7fe5085f42", "f6467914a7f84409b2937fa3668db94d"},
		}
		local pool = pools[mapIndex]
		if pool == nil then return "" end
		local i = math.max(1, math.min(idx, #pool))
		return pool[i]
	end

	-- MonsterAI.Die()가 2페이즈로 이미 진화한 상태(_phase2Revived=true)로 죽을 때 쓴다 — 유저 리포트
	-- (2026-08-26, "다크 예티 잡으면 뿔나오잖아 근데 그게 예티 뿔로나와 다크 예티 잡템이 아니라"):
	-- ReviveAsPhase2Generic은 외형(스프라이트/사운드)만 진화 후 걸로 갈아끼우고 _speciesIdx/스폰존은
	-- 스폰 시점(진화 전) 값 그대로 두므로, GetMonsterLootItemId를 그대로 쓰면 진화 전 몬스터의 잡템이
	-- 나온다. 진화 목적지는 GetMapPhase2StandRUID가 이미 갖고 있는 값과 1:1 대응(예티↔라이트, 다크예티/
	-- 다크예티와페페↔다크)이므로, 그 stand RUID→잡템ID 매핑만 추가한다(주니어예티 라이트/다크 성장 포함 —
	-- 존99~103/119~128의 성체 진화 목적지도 이 표를 그대로 조회한다).
	@ExecSpace("ServerOnly")
	method string GetMonsterLootItemIdPhase2(integer mapIndex, integer idx)
		local standRUID = self:GetMapPhase2StandRUID(mapIndex, idx)
		if standRUID == "f6467914a7f84409b2937fa3668db94d" then return "dark_yeti_horn"           -- 다크예티
		elseif standRUID == "2fa39477afb34d8cb6412b7fe5085f42" then return "yeti_horn"             -- 예티
		elseif standRUID == "70329bd13ca243198d1afac3f77143a6" then return "dark_yeti_pepe_ice_shard" -- 다크예티와페페
		end
		return ""
	end

