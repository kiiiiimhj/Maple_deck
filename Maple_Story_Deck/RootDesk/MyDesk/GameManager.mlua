	@ExecSpace("ServerOnly")
	method number GetMapHitEffectDuration(integer mapIndex, integer idx)
		-- 공식값(0.05+0.1*6=0.65)대로 Destroy를 걸었더니 실제 재생속도가 가정한 10fps보다 살짝
		-- 빨라서 한 바퀴 다 돈 뒤 처음 프레임으로 되돌아가 "두 번 루프되는" 것처럼 보였다(반딧불
		-- 슬라임 등 기존에도 반복된 케이스와 동일 원인) — 유저 요청: "연출이 1번만 루프되야함".
		-- 루프 시작 전에 확실히 끊기도록 공식값보다 낮춘다.
		if mapIndex == 46 and idx == 2 then return 0.5 end
		if mapIndex == 50 and idx == 1 then return 0.5 end
		if mapIndex == 53 and idx == 3 then return 0.5 end
		if mapIndex == 54 and idx == 3 then return 0.5 end
		if mapIndex == 56 and idx == 2 then return 0.5 end
		if mapIndex == 59 and idx == 3 then return 0.5 end
		-- 스코피/골든스코피 원거리 히트 이펙트(4프레임 실측, msw-search) — 네펜데스와 같은 이유로
		-- 공식값(0.05+0.1*4=0.45)보다 살짝 낮춰서 재생 중 프레임0으로 되감기는 것을 방지한다.
		if mapIndex == 65 and idx == 2 then return 0.35 end  -- 골든스코피
		if mapIndex == 67 and idx == 1 then return 0.35 end  -- 스코피
		if mapIndex == 68 and idx == 1 then return 0.35 end  -- 골든스코피
		if mapIndex == 71 and idx == 1 then return 0.35 end  -- 스코피
		if mapIndex == 72 and idx == 1 then return 0.35 end  -- 골든스코피
		if mapIndex == 73 and idx == 2 then return 0.35 end  -- 골든스코피
		if mapIndex == 77 and idx == 1 then return 0.35 end  -- 스코피
		if mapIndex == 78 and idx == 1 then return 0.35 end  -- 골든스코피
		if mapIndex == 81 and idx == 1 then return 0.35 end  -- 스코피
		if mapIndex == 82 and idx == 1 then return 0.35 end  -- 골든스코피
		if mapIndex == 83 and idx == 2 then return 0.35 end  -- 골든스코피
		if mapIndex == 84 and idx == 3 then return 0.35 end  -- 골든스코피
		-- 몽실생크림 히트 이펙트(6프레임 실측) — 네펜데스와 동일 이유(공식값 0.65가 실제 재생시간보다
		-- 살짝 길어 루프 시작 전에 끊기도록 0.5로 낮춤).
		if mapIndex == 95 and idx == 1 then return 0.5 end  -- 몽실생크림
		if mapIndex == 97 and idx == 2 then return 0.5 end  -- 몽실생크림
		if mapIndex == 98 and idx == 3 then return 0.5 end  -- 몽실생크림
		-- 예티류 먹물 히트 이펙트(4프레임 실측, msw-search) — 스코피/골든스코피와 동일 프레임수라
		-- 동일하게 공식값(0.45)보다 낮춘 0.35를 쓴다.
		if mapIndex == 104 and idx == 1 then return 0.35 end
		if mapIndex == 105 and idx == 1 then return 0.35 end
		if mapIndex == 105 and idx == 3 then return 0.35 end
		if mapIndex == 106 and idx == 1 then return 0.35 end
		if mapIndex == 106 and idx == 2 then return 0.35 end
		if mapIndex == 107 and idx == 1 then return 0.35 end
		if mapIndex == 107 and idx == 2 then return 0.35 end
		if mapIndex == 107 and idx == 3 then return 0.35 end
		if mapIndex == 108 and idx == 1 then return 0.35 end
		if mapIndex == 108 and idx == 2 then return 0.35 end
		if mapIndex == 108 and idx == 3 then return 0.35 end
		-- 에피소드3 map3(109~118) — 예티류(114~118) 먹물 이펙트는 위와 동일하게 0.35.
		if mapIndex == 114 and idx == 1 then return 0.35 end
		if mapIndex == 115 and idx == 1 then return 0.35 end
		if mapIndex == 116 and idx == 1 then return 0.35 end
		if mapIndex == 117 and idx == 1 then return 0.35 end
		if mapIndex == 118 and idx == 1 then return 0.35 end
		if mapIndex == 118 and idx == 2 then return 0.35 end
		if mapIndex == 118 and idx == 3 then return 0.35 end
		if mapIndex == 118 and idx == 4 then return 0.35 end
		-- 스노우맨 히트 이펙트(attack1/info/hit 5프레임 실측) — 공식값(0.55)보다 낮춘 0.45.
		if mapIndex == 111 and idx == 2 then return 0.45 end
		if mapIndex == 113 and idx == 1 then return 0.45 end
		if mapIndex == 115 and idx == 2 then return 0.45 end
		if mapIndex == 117 and idx == 2 then return 0.45 end
		-- 마이너좀비 히트 이펙트(attack2/info/hit 6프레임 실측, 몽실생크림과 동일 원칙) — 0.5.
		if mapIndex == 129 and idx == 2 then return 0.5 end
		if mapIndex == 130 and idx == 1 then return 0.5 end
		if mapIndex == 133 and idx == 2 then return 0.5 end
		return 0.25
	end

	@ExecSpace("ServerOnly")
	method boolean GetMapIsRanged(integer mapIndex, integer idx)
		if mapIndex == 12 and idx == 3 then return true end
		if mapIndex == 31 and idx == 1 then return true end
		if mapIndex == 34 and idx == 2 then return true end
		-- 에피소드2 네펜데스류(원거리)
		if mapIndex == 46 and idx == 2 then return true end
		if mapIndex == 50 and idx == 1 then return true end
		if mapIndex == 53 and idx == 3 then return true end
		if mapIndex == 54 and idx == 3 then return true end
		if mapIndex == 56 and idx == 2 then return true end
		if mapIndex == 59 and idx == 3 then return true end
		-- 에피소드2 map3/map4(니할 사막 컨셉) 스코피/골든스코피(원거리)
		if mapIndex == 65 and idx == 2 then return true end
		if mapIndex == 67 and idx == 1 then return true end
		if mapIndex == 68 and idx == 1 then return true end
		if mapIndex == 71 and idx == 1 then return true end
		if mapIndex == 72 and idx == 1 then return true end
		if mapIndex == 73 and idx == 2 then return true end
		if mapIndex == 77 and idx == 1 then return true end
		if mapIndex == 78 and idx == 1 then return true end
		if mapIndex == 81 and idx == 1 then return true end
		if mapIndex == 82 and idx == 1 then return true end
		if mapIndex == 83 and idx == 2 then return true end
		if mapIndex == 84 and idx == 3 then return true end
		-- 에피소드3 map1(89~98) 몽실 생크림(원거리, 자체 attack1 보유 — 홉 없이 제자리에서 공격 포즈만 재생)
		if mapIndex == 95 and idx == 1 then return true end
		if mapIndex == 97 and idx == 2 then return true end
		if mapIndex == 98 and idx == 3 then return true end
		-- 에피소드3 map2(99~108) 예티/다크예티/예티와페페/다크예티와페페 — 유저 지정: "얘넨 원거리라
		-- 히트 연출 있어야함". 전부 자체 attack1을 보유하므로 몽실생크림과 동일 패턴(홉 없이 제자리
		-- 공격 포즈 재생).
		if mapIndex == 104 and idx == 1 then return true end  -- 예티
		if mapIndex == 105 and idx == 1 then return true end  -- 다크예티
		if mapIndex == 105 and idx == 3 then return true end  -- 예티
		if mapIndex == 106 and idx == 1 then return true end  -- 예티와페페
		if mapIndex == 106 and idx == 2 then return true end  -- 다크예티
		if mapIndex == 107 and idx == 1 then return true end  -- 다크예티와페페
		if mapIndex == 107 and idx == 2 then return true end  -- 예티와페페
		if mapIndex == 107 and idx == 3 then return true end  -- 예티
		if mapIndex == 108 and idx == 1 then return true end  -- 다크예티와페페
		if mapIndex == 108 and idx == 2 then return true end  -- 예티와페페
		if mapIndex == 108 and idx == 3 then return true end  -- 다크예티
		-- 에피소드3 map3(109~118) — 스노우맨(유저 지정 원거리)과 재등장하는 예티류(114~118) 전부 원거리.
		if mapIndex == 111 and idx == 2 then return true end  -- 스노우맨
		if mapIndex == 113 and idx == 1 then return true end  -- 스노우맨
		if mapIndex == 115 and idx == 2 then return true end  -- 스노우맨
		if mapIndex == 117 and idx == 2 then return true end  -- 스노우맨
		if mapIndex == 114 and idx == 1 then return true end  -- 예티
		if mapIndex == 115 and idx == 1 then return true end  -- 다크예티
		if mapIndex == 116 and idx == 1 then return true end  -- 예티와페페
		if mapIndex == 117 and idx == 1 then return true end  -- 다크예티와페페
		if mapIndex == 118 and idx == 1 then return true end  -- 다크예티와페페
		if mapIndex == 118 and idx == 2 then return true end  -- 예티와페페
		if mapIndex == 118 and idx == 3 then return true end  -- 다크예티
		if mapIndex == 118 and idx == 4 then return true end  -- 예티
		-- ep3_map4_ester_1(129~133, 이스터에그 전용, 미배선) 마이너좀비(원거리, attack2 전용)
		if mapIndex == 129 and idx == 2 then return true end  -- 마이너좀비
		if mapIndex == 130 and idx == 1 then return true end  -- 마이너좀비
		if mapIndex == 133 and idx == 2 then return true end  -- 마이너좀비
		return false
	end

