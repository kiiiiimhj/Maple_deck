		elseif mapIndex == 41 then return 2
		elseif mapIndex == 42 then return 2
		elseif mapIndex == 43 then return 2
		-- 에피소드2(Ep2_map1, 존1~10 = 내부 mapIndex 45~54) — 구름정원 컨셉: 픽시류/네펜데스류.
		-- 45(존1):스타픽시/루나픽시  46(존2):루나픽시/네펜데스(원거리)  47(존3):러스터픽시(비행)/스타픽시
		-- 48(존4):러스터픽시(비행)/고스트픽시(비행)  49(존5):스타픽시/루나픽시  50(존6):다크네펜데스(원거리)/러스터픽시(비행)
		-- 51(존7):고스트픽시(비행)/거대네펜데스(고정형)  52(존8):거대네펜데스(고정형)/러스터픽시(비행)
		-- 53(존9):스타픽시/루나픽시/네펜데스(원거리)  54(존10):거대네펜데스(고정형)/고스트픽시(비행)/다크네펜데스(원거리)
		elseif mapIndex == 46 then return 2
