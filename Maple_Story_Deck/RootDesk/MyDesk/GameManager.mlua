@Logic
script GameManager extends Logic

	-- 플레이어 스탯
	@Sync
	property integer PlayerHp = 100

	@Sync
	property integer PlayerMaxHp = 100

	-- 경험치 / 레벨
	@Sync
	property integer Level = 1

	@Sync
	property number Exp = 0

	@Sync
	property number ExpNeeded = 120

	-- 골드 (런 전용 — "다시하기" 누르면 0으로 리셋됨)
	@Sync
	property integer Gold = 0

	-- 이번 런 몬스터 처치 수(인게임 HUD 골드 아래 표시, 2026-09-16) — 골드와 같이 "다시하기"에 0으로 리셋
	@Sync
	property integer KillCount = 0

	-- 골드 유물 보너스를 마지막으로 정산한 시점의 Gold 값 — TriggerGameOver()가 이 값 이후로
	-- "새로 번" 골드에만 보너스를 곱한다 (이어하기로 여러 번 게임오버가 나도 이미 보너스 받은
	-- 골드를 또 보너스 대상에 포함시키는 중복 적용을 막는다)
	property integer _goldBonusCheckpoint = 0

	-- 주간 레이드에 이미 넘겨준 이번 판 DPS(위 골드 체크포인트와 같은 이유 — 이어하기로 게임오버가
	-- 여러 번 나도 같은 판이 중복 누적되지 않게 "늘어난 차액"만 넘긴다). TriggerGameOver 참고
	property number _raidCreditedDps = 0

	@Sync
	property integer TotalCoins = 0

	-- 메인화면 우측 상단에 표시되는 누적 코인 — 런이 끝나도 리셋되지 않고 전역 저장소에 영구 저장됨
	property any _coinStorage = nil

	property boolean _coinDirty = false

	property any _coinFlushTimerId = nil

	@Sync
	property integer ShadowVoucher = 0

	-- 그림자 숲 샵(존18 NPC) 전용 재화 — 야누스의 검 교환권. TotalCoins와 동일한 패턴(전역 저장소,
	-- dirty-flag 지연 flush)으로 런이 끝나도 리셋되지 않고 영구 보존된다. 존16~17 몬스터 처치 시
	-- 5% 확률로 드롭(MonsterAI.Die 참고).
	-- 유저 지정(2026-09-18): "너무 안 나온다" → 5% → 10%
	property number ShadowVoucherDropChance = 0.15

	property any _voucherStorage = nil

	property boolean _voucherDirty = false

	@Sync
	property integer Diamond = 0

	-- 뽑기 전용 재화(다이아) — TotalCoins/ShadowVoucher와 완전히 동일한 패턴(유저별 저장소 "Wallet.Diamond",
	-- dirty-flag 지연 flush)으로 런과 무관하게 영구 보존된다. 아직 인게임 획득처가 없으므로, 저장된
	-- 값이 아예 없는 신규 유저에게만 DiamondStartingAmount를 1회 지급한다(획득처가 생기면 이 지급은
	-- 빼면 된다). 잔액 표시는 로비 우상단 배지(TitleGroup/DiamondBadge)와 뽑기 팝업 두 곳.
	-- 2026-09-17 출시 준비로 3000 -> 0. 개발 중엔 뽑기 테스트 편하라고 3000을 얹어뒀는데,
	-- 그대로 내보내면 신규 유저 전원이 공짜 다이아 3000을 들고 시작한다(상점 최저가 300 = 440코인).
	property integer DiamondStartingAmount = 0

	property any _diamondStorage = nil

	property boolean _diamondDirty = false

	property string DiamondIconRUID = "81462aeb825b4660991cef05651271cf"

	-- 웨이브
	@Sync
	property integer Wave = 1

	-- 보스를 한 번이라도 잡았는지 여부 — 2026-08-03 이전에는 맵4+ 잠금해제 판정에도 쓰였지만,
	-- 그 잠금해제는 이미 LevelUp()에서 Level==10 도달로 독립적으로 처리돼서 더는 그 용도로 안 쓰인다.
	-- 보스가 시간 기반 반복 이벤트로 바뀌면서 OnBossDefeated()의 원샷 가드로도 더는 쓰지 않음(매번 보상
	-- 지급) — 과거 세이브/화면 호환을 위해 값 자체는 유지.
	@Sync
	property boolean BossDefeated = false

	-- 시간 기반 보스/엘리트 난이도 배율(2026-08-03) — 둘 다 "그 시점 일반 몬스터 체력/공격력"에 곱해서
	-- 산정한다(더 이상 고정된 웨이브 번호에 못 박히지 않음). 엘리트는 MarkElite()에 이미 자체 배율
	-- (1.15)이 있어 별도 프로퍼티 없이 그대로 둠 — 이 둘은 보스 전용.
	-- 2026-09-12 유저 지정 "보스 체력 2배" → 7.0 → 14.0 (첫 보스는 MonsterSpawner.FirstBossHp 고정값이 따로 있다)
	property number BossHpMultiplier = 14.0

	-- 2026-09-12 유저 지정 2.0 → 1.5
	property number BossAttackMultiplier = 1.5

	-- 게임 상태
	@Sync
	property boolean GameOver = false

	-- 이번 런에서 "이어하기"를 누른 횟수 — 누를 때마다 다음 이어하기 비용이 비싸진다.
	-- "다시하기"(처음부터, RestartGame)로만 0으로 리셋된다
	@Sync
	property integer ContinueCount = 0

	-- 이어하기 비용(다이아). 유저 지정 2026-09-10: 1회 50 / 2회 100 / 3회 150 / 4회부터는 계속 200.
	-- GetContinueCost 가 표 길이를 넘는 인덱스를 마지막 칸으로 잡아주므로 4번째 값이 그대로 반복된다.
	-- 예전엔 코인(TotalCoins) 900/1500/2400/3600 이었는데, 결제 재화를 다이아로 바꾸면서 같이 조정했다
	property any _continueCostTable = { 50, 100, 150, 200 }

	@Sync
	property boolean GameStarted = false

	@Sync
	property integer SelectedCharacter = 0

	@Sync
	property integer SelectedEpisode = 1

	-- 에피소드별 몬스터 능력치 배율(2026-09-02 유저 지정) — 체력(GetTimeStepHp)과 공격력(GetWaveAttack)에
	-- 같은 값을 곱한다. 키가 없는 에피소드는 1.0.
	property any _episodeStatMultipliers = { [1] = 1.0, [2] = 1.25, [3] = 1.5 }

	@Sync
	property boolean TimeAttackMode = false

	-- 타이틀 화면에서 "게임 시작" 버튼을 눌러야 실제 웨이브/스폰이 시작된다 (그 전까지는 대기)
	-- 캐릭터 선택 팝업(WorldCharacterSelectUI)에서 고른 캐릭터 — 0=아르카나, 1=실피드.
	-- CardManager.OnUpdate가 이 값을 보고 기본공격(파이어샷 vs 애로우샷) 트랙을 분기한다.
	-- 시작 팝업(WorldCharacterSelectUI)에서 고른 월드/에피소드 — 1=에피소드1(태초의 마을), 2=에피소드2
	-- (구름정원). "다시하기"는 이 값을 건드리지 않는다(같은 에피소드로 재시작).
	-- 게임 모드 — 무제한 모드(false, 기존과 동일) / 타임어택 모드(true, 15분 제한). 캐릭터 선택
	-- 팝업의 체크박스에서 고른 값이 RequestStartGame으로 전달돼 여기 저장된다. "다시하기"는 이
	-- 값을 건드리지 않는다(같은 모드로 재시작 — 로비로 나가서 다시 고르기 전까지 유지).
	-- 2026-09-14 유저 지정: 20분(1200) → 15분(900). "20분 너무 길다"
	property number TimeAttackDuration = 900

	-- 랭킹 보드 id — RankingConfigDataSet.csv의 Id 열과 반드시 일치해야 한다(1=무제한, 2=타임어택)
	property integer RankBoardIdUnlimited = 1

	property integer RankBoardIdTimeAttack = 2

	-- 랭킹 저장값의 하위 자릿수를 생존 초로 쓰기 위한 배율(동점 타이브레이커). 자세한 설명은 EncodeRankScore 참고
	property integer RankScoreTimeScale = 10000

	-- 입장 로딩 화면이 화면을 가리고 있는 동안 몬스터 스폰 시작을 미루는 시간(초).
	-- ⚠ LoadingUI.FadeInSeconds + LoadingUI.HoldSeconds 와 같은 값이어야 한다 — 화면이 밝아지는
	-- 순간에 맞춰 전투가 시작되도록 맞춰둔 값이다. 한쪽만 고치면 어긋난다(검은 화면에서 이미
	-- 맞고 있거나, 밝아진 뒤 한참 아무것도 안 나오거나).
	property number EntryDelaySeconds = 1.55

	@Sync
	property number TimeAttackRemaining = 0

	-- 첫 플레이 튜토리얼의 "카드 선택" 단계에서만 켜지는 전역 일시정지(TutorialLogic이 소유).
	-- 유저 지정(2026-09-10): "카드 선택 시에는 몬스터 이동 X, 타이머 등 나머지 기능은 다 멈춰야 함" —
	-- 단, 튜토리얼 때만이고 평소 레벨업은 지금처럼 실시간으로 진행된다.
	-- 이 플래그 하나를 아래 네 곳의 OnUpdate 최상단에서 함께 본다:
	--   GameManager(타임어택 카운트다운/허리케인/절망의칼날) · MonsterSpawner(스폰·경과시간) ·
	--   CardManager(플레이어 자동 공격·쿨다운) · MonsterAI(몬스터 이동·공격)
	-- 새 런이 시작될 때마다 반드시 false로 되돌린다(StartGame/Restart) — 정지가 남아 게임이
	-- 멈춘 채로 시작되는 사고를 막기 위한 것
	@Sync
	property boolean TutorialPaused = false

	-- 옵션 팝업이 열려 있는 동안의 전역 일시정지(유저 지정 2026-09-13: "옵션 누르면 게임 일시 정지
	-- 되어야함"). TutorialPaused와 **완전히 같은 정지 지점**을 쓰지만 소유자가 달라서 플래그를 나눴다 —
	-- 하나로 합치면 튜토리얼이 끝나면서 옵션 정지까지 같이 풀리는 사고가 난다.
	-- 실제 판정은 두 플래그를 OR한 IsGamePaused() 하나로만 하고, 각 OnUpdate는 그것만 본다.
	-- 클라(OptionUI)가 RequestSetOptionPaused로 서버에 요청해서 켠다.
	@Sync
	property boolean OptionPaused = false

	-- 인게임(게임오버 아님)에서 간이 다이아 상점이 열려 있는 동안의 정지(유저 지정 2026-09-17 —
	-- 6번 슬롯 해금에 다이아가 모자랄 때 상점을 띄우는데, 그동안 몬스터에게 맞으면 안 된다).
	-- 옵션 정지와 소유자가 달라 플래그를 나눴다. 켜고 끄는 곳은 DiaShopUI.OpenInGame / Close 한 쌍뿐.
	@Sync
	property boolean ShopPaused = false

	-- 전역 일시정지 여부 — 튜토리얼 카드선택 정지 / 옵션 팝업 정지 / 인게임 다이아 상점 정지.
	-- ⚠ 정지 판정은 반드시 이 메서드로만 할 것. 개별 플래그를 직접 보면 한쪽이 빠진다
	-- (다른 Logic에서는 콜론 호출로만 접근 — feedback_cross_logic_field_access_nil).
	method boolean IsGamePaused()
		-- 몬스터 이동/공격·스폰·플레이어 자동공격·타이머를 통째로 멈춰야 하는 상태인지
		return self.TutorialPaused or self.OptionPaused or self.ShopPaused
	end

	-- 안전지대 정지(유저 지정 2026-09-17 — "그림자 상점에 가만히 서 있어도 시간이 흐른다 / 콜로세움도 / 포션 같은 것도").
	-- 두 단계로 나뉜다:
	--   ① 플레이 시계 정지(IsPlayClockFrozen): 몬스터 없는 존(18 그림자상점 / 35 택시 / 44 보물상자) + 콜로세움.
	--      에피소드 보상·랭킹 생존초·난이도 계단·엘리트 시계·웨이브/보스 타이머·타임어택 카운트다운이 멈춘다.
	--   ② 전투 틱 정지(SafeAreaFrozen): ①에서 보물상자(44)만 뺀 곳 — 44는 상자가 몬스터를 불러 실제로 싸우는 곳이라
	--      공격/포션이 돌아야 한다. 여기선 CardManager.OnUpdate(자동공격·스킬 쿨타임·포션·장비 버프 감쇠·
	--      무기 스킬 타이머)를 통째로 멈춘다. 셀프 리커버리는 유저 지정으로 예외(계속 회복). 클라 쿨타임 게이지도 이 @Sync 값을 보고 같이 멈춘다(CardManager.TickCooldownVisuals).
	@Sync
	property boolean SafeAreaFrozen = false

	@ExecSpace("ServerOnly")
	method boolean IsPlayClockFrozen()
		-- 플레이 시계를 멈춰야 하는 곳인지(위 ① 참고)
		return _MonsterSpawner:IsNoMonsterZone(_MapManager.CurrentMapIndex) or _MapManager:IsInColosseum()
	end

	method boolean IsSafeAreaFrozen()
		-- 전투 틱을 멈춰야 하는 곳인지(위 ② 참고). 서버가 매 프레임 계산해 @Sync로 내려주므로 클라에서도 쓸 수 있다
		return self.SafeAreaFrozen
	end

	-- 인게임 다이아 상점 열림/닫힘을 서버에 알린다(정지 플래그는 서버가 소유 + @Sync로 되돌아온다).
	@ExecSpace("Server")
	method void RequestSetShopPaused(boolean paused)
		-- 인게임 다이아 상점 정지 토글. 게임오버 뒤엔 정지가 남지 않게 항상 해제로 정리한다
		if self.GameOver then
			self.ShopPaused = false
			return
		end
		self.ShopPaused = paused
		log("GameManager: ShopPaused = " .. tostring(paused))
	end

	-- 옵션 팝업 열림/닫힘을 서버에 알린다(정지 플래그는 서버가 소유 + @Sync로 되돌아온다).
	@ExecSpace("Server")
	method void RequestSetOptionPaused(boolean paused)
		-- 옵션 팝업 정지 토글
		if self.GameOver then
			-- 게임오버 뒤에는 정지가 남아 다음 판 시작을 막을 수 있으니 항상 해제로 정리한다
			self.OptionPaused = false
			return
		end
		self.OptionPaused = paused
		log("GameManager: OptionPaused = " .. tostring(paused))
	end

	@Sync
	property boolean _timeAttackOvertimeActive = false

	@Sync
	property boolean _timeAttackOvertimeDeath = false

	@Sync
	property boolean _gaveUp = false

	-- 몬스터 처치당 경험치/골드. 2026-08-05: 2분 이후 절반(GetExpPerKill 참고)으로 깎였을 때 정확히
	-- 15가 되도록 30으로 상향(2분 전에는 30, 2분 후 15) — 유저가 "지금 10인데 15로" 요청.
	-- 카운트가 0이 된 뒤(절망의 칼날 등장 이후) 상태 — GameOverUI가 "이어하기/다시하기 둘 다"와
	-- "다시하기만" 중 어느 쪽을 보여줄지 이 두 플래그로 판정한다. _timeAttackOvertimeDeath는
	-- TriggerGameOver 시점에 _timeAttackOvertimeActive를 그대로 캡처해 둔 값이라, 게임오버
	-- 팝업이 열려있는 동안(다음 판정 전까지) 죽은 원인을 안정적으로 유지한다.
	-- 옵션 팝업의 "게임 종료"로 스스로 끝낸 판인지(유저 지정 2026-08-30). 죽은 게 아니라 포기한 거라
	-- 이어하기를 주지 않고 GameOverUI가 "다시하기만" 모드로 뜬다. RestartGame/RequestContinue에서 해제.
	property number ExpPerKill = 30

	-- 몬스터 1마리 처치당 지급 골드 (유저 지정 2026-09-01: 5 → 1). 에피1 기준값 — 에피2·3은 아래
	-- _episodeKillGoldChances 확률표로 이 값에 +0~2가 붙는다.
	-- 유물 성배(8번)의 골드 % 보너스는 킬마다가 아니라 TriggerGameOver에서 런 총액에 한 번에 곱한다.
	property integer GoldPerKill = 1

	-- 엘리트/보스 처치 골드(유저 지정 2026-09-16: 엘리트 5, 보스 20). 엘리트는 GetKillGold, 보스는
	-- OnBossDefeated가 쓴다. 에피1 보스 분열체는 스탯만 엘리트급이라 엘리트 골드에서 뺀다(MonsterAI.Die)
	property integer EliteGoldPerKill = 5
	property integer BossGoldPerKill = 20

	-- 에피소드별 일반 처치 골드 확률표(유저 지정 2026-09-16) — i번째 값 = "GoldPerKill + (i-1)"골드가 나올 확률.
	-- 에피1은 표에 없어서 GoldPerKill(1) 고정, 에피2 1~2골드(70/30%), 에피3 1~3골드(50/30/20%).
	-- 잡템 점수 비율(1:1.8:2.6, PlayerInventory.GetAllItemDefs)과 별개로 높은 에피일수록 골드를 더 받게 한다.
	-- 엘리트/보스 골드는 에피 무관.
