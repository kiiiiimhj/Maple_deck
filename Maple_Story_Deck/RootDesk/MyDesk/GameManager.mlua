	-- 앞이고(UpdateDepth 참고, 몬스터 Z는 1.5-scale 범위라 최소 0 근처) 항상 그보다 확실히 작은
	-- 고정값을 쓴다.
	property number HurricaneDepthZ = -1.0

	@Sync
	property Entity _despairBladeEntity = nil

	-- 타임어택 모드 카운트가 0이 되면 등장하는 "절망의 칼날" — 비행형, 유일하게 존을 넘어가도
	-- 플레이어를 계속 따라다닌다. 다른 몬스터(MonsterAI._paused)와 달리 존 전환 시 사라지지
	-- 않고 그 존으로 다시 소환되는 방식으로 구현한다(엔진에 엔티티 재부모 API가 없어서 이동 대신
	-- 파괴+재소환). 죽지 않는 존재(공격만 반복) — 타임어택이 반드시 끝나게 만드는 장치다.
	-- 클라이언트에서 공격 연출(PlayDespairBladeAttackAnim)이 이 엔티티를 직접 참조해야 해서 @Sync —
	-- 존 전환마다 파괴+재소환되지만 그때마다 새로 대입되므로 Entity가 맵 전환에 끊기는 문제와 무관하다.
	property integer _despairBladeZone = -1

	property number DespairBladeAttackInterval = 1.5

	property integer _despairBladeAttackAnimTimerId = 0

	property number _despairBladeAttackTimer = 0

	-- 공격 1회당 최대 체력의 15% 고정 데미지(유저 지정) — 전용 경로(ApplyDespairBladeDamage)에서
	-- PlayerMaxHp에 곱한다. 현재 체력 비례가 아니라 최대 체력 기준 고정값이라 몇 대 맞으면 죽는지가
	-- 항상 일정하다(대략 7대).
	property number DespairBladeDamagePercent = 0.15

	property number _despairBladeHoverTime = 0

	property number DespairBladeHoverAmplitude = 0.25

