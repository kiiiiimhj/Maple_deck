				attackSfx = "dfdb42ea2af84241baa1e44f8473a797",
				dieSfx = "0ed6566aef22430a9c6d3285f651b1c0",
				-- 원본 184×160 → 175/184 ÷ 2.5 ≈ 0.38. 2마리가 같이 뜨므로 화면이 붐비지 않게 조금 더 줄였다.
				scale = 0.34,
				selfFx = "",
				selfFxDur = 0,
				selfFxDelay = 0,
				ranged = false,
				-- 유저 지정 RUID(픽시맘·파파픽시 공용 착탄 연출, 4f/0.520 실측)
				hitFx = "1441d2292eea4dd39238b0606368bc2c",
				hitFxDur = 0.52,
				-- 유저 지정 "히트프레임 15일 때" — attack1 앞 14프레임이 0.130초 균등이라 14 × 0.130 = 1.820초
				hitFxDelay = 1.82,
				attack2 = "",
				attack2Dur = 0,
				attack2Sfx = "",
				summonCooldown = 0,
				summonCount = 0,
				summonFx = "",
				summonFxDur = 0,
				growScalePerHit = 0,
				growScaleMax = 0,
				growAtkPerHit = 0,
				growAtkMax = 0,
				escort = nil,
				hasSplit = false,
				-- ── 에피2 신규 필드 ──
				flying = true,
				hpMultiplier = 0.75,
				atkMultiplier = 0.75,
				zigzag = false,
				atkGrowPerAttack = 0,
				atkGrowMax = 0,
				dashAfterAttack = false,
				-- 같이 등장하는 동반 보스. 파트너는 본체가 뜬 뒤 partnerAttackDelay초 늦게 첫 공격을 시작한다.
				partnerAttackDelay = 0.5,
				partner = {
					name = "파파픽시",
					stand = "b86fe397c76642988d4a5f6ef3f3ee40",
					move = "2a540ac83f884074968fd1bf31aa6914",
					attack = "0d40b03cad1e48e5be50ccebb3f6caa0",
					attackDur = 4.29,
					hit = "01d47ddeb32b43aeb5bc15e91732698e",
					die = "dfc2415dabcd44768fe485897ed859a8",
					dieDur = 1.08,
					attackSfx = "1ca4b123394748d384d34359ab93f1b6",
					dieSfx = "cbab46e10b1343aabe6d52411b10c3ed",
					-- 원본 184×165 — 픽시맘과 거의 같은 크기라 같은 배율
					scale = 0.34,
					hitFx = "1441d2292eea4dd39238b0606368bc2c",
					hitFxDur = 0.52,
					hitFxDelay = 1.82,
				},
			},
			{
				-- 2번: 엘리쟈 (mob/8220000.img, '조종당하는 엘리쟈').
				-- 유저 지정: "재규어처럼 지그재그 이동", "공격할 때마다 공격속도 5% 증가 최대 60%",
				-- "공격하고 잔상이 생기듯이 휙~ 좌우로 이동".
				name = "엘리쟈",
				stand = "d458879e2e2949f2bb2e915ff67fbc64",
				move = "e4e1fb8384994d8890b786f7b9df93a3",
				attack = "8c933520034f4a3a8fb4163495ab714e",
				attackDur = 3.60,
				hit = "5ee4cd91882446e99905bea46f26e8e6",
				die = "1ebdf7b4f5b64af3a385a18551a410fe",
				dieDur = 1.80,
				attackSfx = "f0b9aa38b71241db8d6ec117d0add0cf",
				-- ⚠ 이 팩엔 audio/Die가 없다 — 블루 머쉬맘과 같은 정책으로 audio/Damage를 사망 비명으로 빌려 쓴다
				dieSfx = "24f9a3efb46b4ab7adfce22c336d7d01",
				-- 원본 161×124 → 175/161 ÷ 2.5 ≈ 0.435
				scale = 0.435,
				selfFx = "",
				selfFxDur = 0,
				selfFxDelay = 0,
				ranged = false,
				hitFx = "",
				hitFxDur = 0,
				hitFxDelay = 0,
				attack2 = "",
				attack2Dur = 0,
				attack2Sfx = "",
				summonCooldown = 0,
				summonCount = 0,
				summonFx = "",
				summonFxDur = 0,
				-- 피격 성장은 없다(엘리쟈는 **공격**할 때 빨라지는 쪽 — 아래 atkGrow* 참고)
				growScalePerHit = 0,
				growScaleMax = 0,
				growAtkPerHit = 0,
				growAtkMax = 0,
				escort = nil,
				hasSplit = false,
				flying = false,
				hpMultiplier = 1.0,
				atkMultiplier = 1.0,
				zigzag = true,
				atkGrowPerAttack = 0.05,
				atkGrowMax = 0.60,
				dashAfterAttack = true,
				partnerAttackDelay = 0,
				partner = nil,
				-- ── 페이즈2 변신 (유저 지정 2026-09-08) ────────────────────────────────
				-- "체력 50% 이하가 되면 아이들 상태로 변하고 변신(이때 대미지 안 들어감),
				--  <RUID> 이 연출이 엘리쟈를 덮고, 다크 엘리쟈의 루트로 변한다. 변하고는 그냥 고정으로
				--  공격속도 2배."
				-- 기존 _hasPhase2(HP 0에서 부활하는 예티/네펜데스 계열)와는 **다른 경로**다 —
				-- 이쪽은 죽지 않고 HP 비율에서 한 번만 모습을 바꾼다.
				phase2HpRatio = 0.5,
				-- 변신 연출: 다크 엘리쟈 팩의 attack1/info/hit(실측 4f/0.480). 원본이 82×83으로 작아서
				-- 엘리쟈 화면 폭(≈175px)을 덮으려면 확대가 필요하다 → 175/82 ≈ 2.1배.
				phase2Fx = "0af392e096f444c7b6f29a6b9de757a6",
				phase2FxDur = 0.48,
				phase2FxScale = 2.1,
				-- 연출 전에 아이들(stand)로 잠깐 굳는 시간. 이 구간부터 무적이 걸린다.
				phase2IdleDur = 0.3,
				-- 변신 후 공격속도 배수(고정). 성장(atkGrow*)은 변신과 동시에 꺼진다.
				phase2AtkSpeedMult = 2.0,
				-- 변신 후 외형(다크 엘리쟈 팩)
				phase2 = {
					name = "다크 엘리쟈",
					stand = "0757bf61ab194e23960de8dedb9caf27",
					move = "09ccc7e7efb04b61b96558578b18db33",
					attack = "86848fa9d2774ab6b20ed670e182e06b",
					attackDur = 3.60,
					hit = "148b12c731ae4c32aed1f99c6e7edacf",
					die = "f74a85e9ac2846a7b697a7747b2606ad",
					dieDur = 1.68,
					attackSfx = "acb3346586b644bd93c5137a6621670c",
					dieSfx = "f937b9ae65054e81895d9555e92b1616",
					-- 원본 176×168 → 175/176 ÷ 2.5 ≈ 0.40 (엘리쟈와 화면상 크기가 비슷해진다)
					scale = 0.40,
					-- 유저 지정(2026-09-08): "다크 엘리쟈 공격하고 화면에 <RUID> 이거 뜨면 더 좋을듯".
					-- 변신 연출(phase2Fx)과 **같은 클립**을 착탄 연출로도 쓴다 — 변신 → 그 기운을 계속
					-- 두르고 때리는 그림. 1페이즈(엘리쟈)엔 hitFx가 없으므로 변신 전엔 안 뜬다.
					-- 실측 4프레임 0.480초 → 0.44로 잡아 루프 재시작 직전에 지운다.
					hitFx = "0af392e096f444c7b6f29a6b9de757a6",
					hitFxDur = 0.44,
					-- 0 = 기존 공식(attackDur × 0.5 = 1.80초)
					hitFxDelay = 0,
				},
			},
			{
				-- 3번: 의식에 휘말린 망치병 (mob/8644410.img).
				-- 유저 지정: "맞을 때마다 크기가 증가하고 공격속도 5%씩 증가, 최대 60%".
				-- 크기 증가폭은 유저 지정(2026-09-08): 피격 **한 방에 +10%**, 상한 +80%.
				name = "의식에 휘말린 망치병",
				stand = "42c0d2e56d6742c7a205167e6687c371",
				move = "1492720e458249f0bdbb82f6c98228bf",
				attack = "5c355fd5c76c45339d5ff56bda9112b2",
				attackDur = 2.16,
				hit = "e2a384b034b547d381c1b9180e362a1e",
				die = "0188ee78bebb46fe8be7ef247e2046e7",
				dieDur = 2.88,
				attackSfx = "19e0ca779a49428bac582f7523cf8503",
				dieSfx = "87ee9f641769488e92c87c01aa21372a",
				-- 원본 252×245로 이 로스터에서 가장 크다 → 175/252 ÷ 2.5 ≈ 0.278.
				-- 다일과 같은 이유(맞으면서 커지는 보스라 처음부터 크면 만렙에 화면을 덮음)로 20% 더 줄였다.
				scale = 0.222,
				selfFx = "",
				selfFxDur = 0,
				selfFxDelay = 0,
				ranged = false,
				hitFx = "",
				hitFxDur = 0,
				hitFxDelay = 0,
				attack2 = "",
				attack2Dur = 0,
				attack2Sfx = "",
				summonCooldown = 0,
				summonCount = 0,
				summonFx = "",
				summonFxDur = 0,
				-- 피격 성장(에피1 다일이 쓰던 경로를 그대로 재사용한다).
				-- 유저 지정 갱신(2026-09-08): "한 방에 10%씩 크게, 상한은 같고" — 처음엔 다일 비율로
				-- 6.7%였는데 10%로 올렸다. 상한 80%는 그대로라 8대만 맞으면 최대 크기에 도달한다.
				growScalePerHit = 0.10,
				growScaleMax = 0.80,
				growAtkPerHit = 0.05,
				growAtkMax = 0.60,
				escort = nil,
				hasSplit = false,
				flying = false,
				hpMultiplier = 1.0,
				atkMultiplier = 1.0,
				zigzag = false,
				atkGrowPerAttack = 0,
				atkGrowMax = 0,
				dashAfterAttack = false,
				partnerAttackDelay = 0,
				partner = nil,
			},
			{
				-- 4번: 크세르크세스 (유저 제공 팩 "크세르크세스").
				-- ⚠ 유저 정정(2026-09-08): **가운데(본체)는 "크세르크세스"**, 좌우 호위 4마리만
				-- "사랑에 빠진 크세르크세스"다 — 처음엔 둘 다 "사랑에 빠진" 팩으로 넣었었다.
				-- 호위 방식 자체는 그대로(블루 머쉬맘처럼 좌우 2마리씩, 보스가 죽으면 같이 죽음).
				name = "크세르크세스",
				stand = "a311145b16c74d15a19686adb2c318ea",
				move = "fe48518c185e49739f8c32c71692f9b1",
				-- 유저 지정(2026-09-08): 공격 연출을 이 클립으로 교체. 실측 42프레임 5.400초(균등 0.120)
				-- — 기존 433243cf…(4.20초)보다 1.2초 길다. 공격 주기는 attackDur+0.7 규칙을 그대로
				-- 따르므로 6.10초가 된다(로스터에서 가장 느린 공격 주기).
				attack = "070bcf50421e457ba33d9d539cd8a1b7",
				attackDur = 5.40,
				hit = "70f42038a51c41c6879102502d2a6450",
				die = "7a391705f0074a3aa11e82981ae13748",
				-- ⚠ 실측 50프레임 5.970초 — 이 로스터에서 가장 긴 사망 연출이다
				dieDur = 5.97,
				attackSfx = "f0d619693ac94e08bb3f64a9a7f088c8",
				dieSfx = "295ee52ea9cd4b60878c60e29a9f0630",
				-- 원본 200×269(호위보다 훨씬 크다) → 175/200 ÷ 2.5 = 0.35
				scale = 0.35,
				selfFx = "",
				selfFxDur = 0,
				selfFxDelay = 0,
				ranged = false,
				-- 유저 지정(2026-09-08): 근접 보스지만 공격할 때 **화면(플레이어 자리)에** 이 연출을 띄운다
				-- — 블랙 나이트/오징어 노예간수와 같은 방식(지상 attack1 종도 PlayRangedHitEffect를 탄다).
				-- 실측 5프레임 0.450초(균등 0.090) → 0.42로 잡아 루프 재시작 직전에 지운다
				-- (0.45 딱 맞추면 소멸과 루프 복귀가 겹쳐 깜빡인다 — 오징어 간수에서 겪은 함정).
				hitFx = "818a73844264428d93baebad62e55e7a",
				hitFxDur = 0.42,
				-- 0 = 기존 공식(attackDur × 0.5 = 2.70초). 특정 프레임에 맞추려면 여기에 초를 직접 적는다.
				hitFxDelay = 0,
				attack2 = "",
				attack2Dur = 0,
				attack2Sfx = "",
				summonCooldown = 0,
				summonCount = 0,
				summonFx = "",
				summonFxDur = 0,
				growScalePerHit = 0,
				growScaleMax = 0,
				growAtkPerHit = 0,
				growAtkMax = 0,
				-- 블루 머쉬맘의 파란버섯과 완전히 같은 구조 — 보스가 뜰 때 좌우 2마리씩 같이 나오고,
				-- 보스가 죽으면 전부 같이 죽는다. 여기서는 호위도 보스와 **같은 종**이라 클립을 그대로 쓴다.
				escort = {
					-- 호위는 "사랑에 빠진 크세르크세스"(mob 팩) — 본체(크세르크세스)와 다른 종이다
					name = "사랑에 빠진 크세르크세스",
					countPerSide = 2,
					spacing = 1.4,
					stand = "9d5829d27e464b72b61c320295eadc37",
					move = "d3689f6e27e24582be6c1228768a5681",
					hit = "5b87df72d1784081b5446642fc4457d1",
					die = "fa53799ac25b4745b15772cb34e63935",
					dieDur = 2.04,
					hitSfx = "95c33479ec3f46778ca3340e1434722c",   -- audio/Damage
					dieSfx = "211efe5f96194c4b94717ebe859a6c4c",   -- audio/Die
					hpRatio = 2.0,
					-- 본체(최종 2.5 × 0.46 = 1.15배)보다 확실히 작게 — 두목/쫄따구 구분이 되도록
					scale = 0.8,
				},
				hasSplit = false,
				flying = false,
				hpMultiplier = 1.0,
				atkMultiplier = 1.0,
				zigzag = false,
				atkGrowPerAttack = 0,
				atkGrowMax = 0,
				dashAfterAttack = false,
				partnerAttackDelay = 0,
				partner = nil,
			},
		}
		if index < 1 or index > #defs then index = 1 end
		return defs[index]
	end

	-- ── 에피소드3 보스 로스터 (유저 지정, 2026-09-08) ──────────────────────────────
	-- 에피1·2와 **같은 def 스키마**를 그대로 쓴다. 에피3에서만 필요한 거동은 아래 신규 필드로 붙였고,
	-- 에피1·2 def엔 그 키가 없어 MonsterAI가 nil을 기본값으로 접어 읽는다.
	--   1번 = 설산의 마녀        (근접, **attack2로 때린다** + skill2로 얼어붙은 레프 보병 2기 소환 / 쿨 20초.
	--                             등장하자마자 첫 행동이 소환)
	--   2번 = 골드예티와 페페킹  (근접, 베어울프 2마리 **돌진형** 호위 대동)
	--   3번 = 구미호             (원거리, HP 50% 이하에서 삼미호 4마리 소환 — 바닥 마법진 연출)
	--   4번 = 하이레프 리더      (비행, attack1↔attack2 **번갈아** 사용. attack2 차례에 얼어붙은 레프 법사
--                             1기 소환 — 소환 쿨 6초, 부하도 비행형, 리더가 죽으면 부하도 같이 제거)
	--   5번 = 익스트림 빅풋      (근접, 맞을수록 크기·공속 증가 + attack1~3 **돌아가며** 사용)
	--
	-- ⚠ 재생시간은 전부 **실측**(2026-09-08, LoadAnimationClipAndWait의 프레임 delay 합):
	--   마녀 attack2 26f/3.900 skill2 22f/4.020 die1 13f/1.560 · 보병 attack1 15f/1.350 die1 21f/1.890
	--   예티 attack1 21f/2.520 die1 23f/3.450 착탄 5f/0.300 · 베어울프 attack1 15f/2.040 die1 7f/1.050
	--   구미호 attack1 26f/3.120 die1 8f/1.500 착탄 4f/0.480 · 삼미호 attack1 14f/1.790 die1 6f/0.720
	--   리더 attack1 16f/1.440 attack2 19f/1.710 die1 29f/2.610 · 법사 attack1 30f/1.800 die1 22f/1.320
	--   빅풋 attack1 18f/1.890 attack2 23f/1.740 attack3 25f/2.580 die1 28f/2.520
	--
	-- ⚠ scale은 에피1·2와 같은 기준(화면 폭 ≈175px)이다: def.scale = 70 ÷ 원본 폭
	--   (최종 배율 = 보스 공통 ×2.5 × 이 값). 호위·부하는 ×2.5를 안 타는 절대 배율이라 120 ÷ 원본 폭.
	@ExecSpace("ServerOnly")
	method integer GetEp3BossCount()
		-- 에피소드3 보스 순번의 총 개수
		return 5
	end

	@ExecSpace("ServerOnly")
	method any GetEp3BossDef(integer index)
		-- 에피소드3 보스 index번째(1부터)의 외형/사운드/크기/기믹 정의를 한 행으로 반환한다.
		local defs = {
			{
				-- 1번: 설산의 마녀 (mob/6090001.img).
				-- 유저 지정: "근접(어택2 사용), 히트는 <RUID>, 스킬2 사용해 얼어붙은 보병 2명 소환
				--            쿨타임 20초, 등장하면 먼저 소환부터".
				-- → attack에 **attack2 클립**을 넣고(유저가 지정한 공격 모션), 소환기(attack2 슬롯)에는
				--   **skill2 클립**을 넣는다. 소환 우선은 기존 스텀피 경로가 이미 그렇게 동작한다
				--   (_summonTimer = 0으로 시작 → 도달 순간 첫 행동이 소환).
				name = "설산의 마녀",
				stand = "4b50438f59154f41aba918b2d28bb8d2",
