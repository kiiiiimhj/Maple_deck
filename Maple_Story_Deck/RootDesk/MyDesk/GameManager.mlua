				attackDur = 3.90,
				hit = "79d70b581e22411abbd0f142c038b7ad",
				die = "ba9ce08382224dd9ad9e3a97428d4cdd",
				dieDur = 1.56,
				attackSfx = "7e20c0872d4d45d0a525d5fc746d6688",  -- _audio/Attack2
				dieSfx = "b8000451037c4bffa65426e767cb8e09",
				-- 원본 144×160 → 70 ÷ 144 ≈ 0.486
				scale = 0.486,
				selfFx = "",
				selfFxDur = 0,
				selfFxDelay = 0,
				ranged = false,
				-- 유저 지정 RUID(이 팩의 attack3/info/hit, 실측 4f/0.480). 0.48 그대로면 소멸과 루프
				-- 복귀가 겹쳐 깜빡인다 → 0.44로 살짝 줄인다.
				hitFx = "0719861214fa45578488a1083f49df5a",
				hitFxDur = 0.44,
				hitFxDelay = 0,
