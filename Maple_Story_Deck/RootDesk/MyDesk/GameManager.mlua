		elseif mapIndex == 34 then return 2
		elseif mapIndex == 36 then return 2
		elseif mapIndex == 37 then return 3
		elseif mapIndex == 38 then return 3
		elseif mapIndex == 39 then return 2
		elseif mapIndex == 40 then return 2
		elseif mapIndex == 41 then return 2
		elseif mapIndex == 42 then return 2
		elseif mapIndex == 43 then return 2
		-- 에피소드2(Ep2_map1, 존1~10 = 내부 mapIndex 45~54) — 구름정원 컨셉: 픽시류/네펜데스류.
		-- 45(존1):스타픽시/루나픽시  46(존2):루나픽시/네펜데스(원거리)  47(존3):러스터픽시(비행)/스타픽시
		-- 48(존4):러스터픽시(비행)/고스트픽시(비행)  49(존5):스타픽시/루나픽시  50(존6):다크네펜데스(원거리)/러스터픽시(비행)
		-- 51(존7):고스트픽시(비행)/거대네펜데스(고정형)  52(존8):거대네펜데스(고정형)/러스터픽시(비행)
		-- 53(존9):스타픽시/루나픽시/네펜데스(원거리)  54(존10):거대네펜데스(고정형)/고스트픽시(비행)/다크네펜데스(원거리)
		elseif mapIndex == 46 then return 2
		elseif mapIndex == 50 then return 2
		elseif mapIndex == 53 then return 3
		elseif mapIndex == 54 then return 3
		-- 에피소드2 map2(존1~10 = 내부 mapIndex 55~64) — 라이오너/그류핀/샐리온/루이넬류 컨셉.
		-- 55(존1):주니어샐리온  56(존2):주니어라이오너/네펜데스(원거리)  57(존3):주니어라이오너/주니어그류핀
		-- 58(존4):러스터픽시(비행)/고스트픽시(비행)  59(존5):주니어라이오너/주니어그류핀/다크네펜데스(원거리)
		-- 60(존6):거대네펜데스/주니어그류핀/샐리온  61(존7):라이오너/고스트픽시(비행)/주니어루이넬(지그재그)
		-- 62(존8):거대네펜데스/루이넬(지그재그)/샐리온  63(존9):거대네펜데스/고스트픽시(비행)/주니어루이넬(지그재그)
		-- 64(존10):러스터픽시(비행)/고스트픽시(비행)/루이넬(지그재그)
		elseif mapIndex == 55 then return 1
		elseif mapIndex == 56 then return 2
		elseif mapIndex == 57 then return 2
		elseif mapIndex == 58 then return 2
		elseif mapIndex == 59 then return 3
		elseif mapIndex == 60 then return 3
		elseif mapIndex == 61 then return 3
		elseif mapIndex == 62 then return 3
		elseif mapIndex == 63 then return 3
		elseif mapIndex == 64 then return 3
		-- 에피소드2 map3(존1~10 = 내부 mapIndex 65~74) — 니할 사막 컨셉: 스코피/저빌/페넥/맘무트/트라고스/
		-- 캐피바라/발광박쥐. 65:캐피바라/골든스코피  66:골든페넥/골든저빌/맘무트  67:스코피/발광박쥐
		-- 68:골든스코피/골든맘무트/발광박쥐  69:발광박쥐/골든페넥/캐피바라  70:트라고스/골든맘무트/발광박쥐
		-- 71:스코피/골든맘무트/페넥  72:골든스코피/캐피바라  73:트라고스/골든스코피  74:트라고스/캐피바라/발광박쥐
		elseif mapIndex == 65 then return 2
		elseif mapIndex == 66 then return 3
		elseif mapIndex == 67 then return 2
		elseif mapIndex == 68 then return 3
		elseif mapIndex == 69 then return 3
		elseif mapIndex == 70 then return 3
		elseif mapIndex == 71 then return 3
		elseif mapIndex == 72 then return 2
		elseif mapIndex == 73 then return 2
		elseif mapIndex == 74 then return 3
		-- 에피소드2 map4(존1~10 = 내부 mapIndex 75~84) — 니할 사막 컨셉 연장.
		-- 75:저빌/골든저빌  76:골든저빌/발광박쥐  77:스코피/골든저빌  78:골든스코피/페넥  79:페넥/골든페넥
		-- 80:맘무트/골든맘무트/발광박쥐  81:스코피/골든맘무트  82:골든스코피/골든페넥  83:발광박쥐/골든스코피
		-- 84:맘무트/골든저빌/골든스코피
		elseif mapIndex == 75 then return 2
		elseif mapIndex == 76 then return 2
		elseif mapIndex == 77 then return 2
		elseif mapIndex == 78 then return 2
		elseif mapIndex == 79 then return 2
		elseif mapIndex == 80 then return 3
		elseif mapIndex == 81 then return 2
		elseif mapIndex == 82 then return 2
		elseif mapIndex == 83 then return 2
		elseif mapIndex == 84 then return 3
		-- 에피소드3 map1(존1~10 = 내부 mapIndex 89~98) — 리티/다크리티(비행)/주니어페페/주니어예티/
		-- 다크주니어예티/페페/다크페페/헥터(지그재그)/화이트팽(지그재그)/몽실생크림(원거리) 10종을 골고루 분포.
		-- 89(존1):주니어예티/주니어페페  90(존2):리티(비행)/주니어예티  91(존3):주니어페페/리티(비행)/헥터(지그재그)
		-- 92(존4):다크주니어예티/주니어예티  93(존5):다크리티(비행)/헥터(지그재그)/주니어페페
		-- 94(존6):페페/다크주니어예티/화이트팽(지그재그)  95(존7):몽실생크림(원거리)/리티(비행)/페페
		-- 96(존8):다크페페/화이트팽(지그재그)/다크리티(비행)  97(존9):헥터(지그재그)/몽실생크림(원거리)/다크페페
		-- 98(존10):다크페페/화이트팽(지그재그)/몽실생크림(원거리)
		elseif mapIndex == 89 then return 2
		elseif mapIndex == 90 then return 2
		elseif mapIndex == 91 then return 3
		elseif mapIndex == 92 then return 2
		elseif mapIndex == 93 then return 3
		elseif mapIndex == 94 then return 3
		elseif mapIndex == 95 then return 3
		elseif mapIndex == 96 then return 3
		elseif mapIndex == 97 then return 3
		elseif mapIndex == 98 then return 3
		-- 에피소드3 map2(존1~10 = mapIndex 99~108)
		elseif mapIndex == 99 then return 2
		elseif mapIndex == 100 then return 2
		elseif mapIndex == 101 then return 3
		elseif mapIndex == 102 then return 2
		elseif mapIndex == 103 then return 2
		elseif mapIndex == 104 then return 3
		elseif mapIndex == 105 then return 3
		elseif mapIndex == 106 then return 3
		elseif mapIndex == 107 then return 3
		elseif mapIndex == 108 then return 3
		-- 에피소드3 map3(존1~10 = mapIndex 109~118, 유저 지정: 웨어울프/라이칸스로프/스노우맨(원거리)/
		-- 플라이아이(비행) + 기존 예티류(전부 원거리+2페이즈) 베리에이션)
		elseif mapIndex == 109 then return 2
		elseif mapIndex == 110 then return 2
		elseif mapIndex == 111 then return 2
		elseif mapIndex == 112 then return 3
		elseif mapIndex == 113 then return 2
		elseif mapIndex == 114 then return 3
		elseif mapIndex == 115 then return 3
		elseif mapIndex == 116 then return 3
		elseif mapIndex == 117 then return 3
		elseif mapIndex == 118 then return 4
		-- 에피소드3 map4(존1~10 = mapIndex 119~128, 유저 지정: 주니어예티+다크주니어예티만 섞어서
		-- 배치, 존마다 라이트/다크 비율을 다르게 해 map3(종 다양성)와 다른 방식으로 베리에이션)
		elseif mapIndex == 119 then return 2
		elseif mapIndex == 120 then return 2
		elseif mapIndex == 121 then return 2
		elseif mapIndex == 122 then return 3
		elseif mapIndex == 123 then return 2
		elseif mapIndex == 124 then return 3
		elseif mapIndex == 125 then return 3
		elseif mapIndex == 126 then return 3
		elseif mapIndex == 127 then return 3
		elseif mapIndex == 128 then return 4
		-- ep3_map4_ester_1(존1~5 = mapIndex129~133, 이스터에그 전용, 미배선) — 쿨리좀비/마이너좀비/
		-- 플라이아이/미믹 4종 베리에이션. 존5(133)만 4종 전부 등장하는 마무리 존.
		elseif mapIndex == 129 then return 2
		elseif mapIndex == 130 then return 2
		elseif mapIndex == 131 then return 2
		elseif mapIndex == 132 then return 2
		elseif mapIndex == 133 then return 4
		end
		if mapIndex >= 45 and mapIndex <= 54 then return 2 end
		return 1
	end

