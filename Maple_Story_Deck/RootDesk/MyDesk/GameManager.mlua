	@ExecSpace("ServerOnly")
	method void OnMonsterReached(number dmgMultiplier, boolean ignoreHitImmune)
		if self.GameOver then return end
		if self._hitImmune and not ignoreHitImmune then return end
		
		-- 허수아비가 소환되어 있는 동안은 몬스터의 공격을 플레이어 대신 허수아비가 맞는다 —
		-- 플레이어 HP는 전혀 깎이지 않고, 허수아비만 맞는 연출을 재생한다. 존마다 독립적이므로
		-- 지금 플레이어가 있는 존의 허수아비만 확인한다(다른 몬스터는 도달 자체를 못 함).
		local zoneScarecrow = self._scarecrowEntities ~= nil and self._scarecrowEntities[_MapManager.CurrentMapIndex] or nil
		if isvalid(zoneScarecrow) then
			self:PlayScarecrowHitFlash(zoneScarecrow)
			return
		end
		
		self._hitImmune = true
		-- 2026-08-03: 몬스터 공격력은 처치 기반 Wave 대신 시간 단계(GetTimeStep, 0부터 시작)를 쓴다.
		-- GetWaveAttack의 attacks 테이블은 1부터 시작하는 기존 인덱싱을 그대로 쓰므로 +1 보정한다.
		local timeStep = self:GetTimeStep()
		local dmg = math.floor(self:GetWaveAttack(timeStep + 1) * dmgMultiplier)
		local armorReduction = _CardManager:GetMagicArmorReduction()
		if armorReduction > 0 then dmg = math.floor(dmg * (1.0 - armorReduction)) end
		
		-- 장비 등급 스킬의 방어 계열은 (1) 확률 무효화/무적 → (2) 받는 피해 감소% → (3) 보호막 흡수
		-- 순서로 적용된다. 보호막은 감소가 끝난 "실제로 들어올 피해"만 깎아야 계산이 어긋나지 않는다
		if _GearEffectLogic:ShouldNullifyDamage() then
			log("Player hit nullified by gear effect")
			_TimerService:SetTimerOnce(function()
				if isvalid(self) then self._hitImmune = false end
			end, 0.8)
			return
		end
		
		local gearReduction = _GearEffectLogic:GetDamageTakenReduction()
		if gearReduction > 0 then dmg = math.floor(dmg * (1.0 - gearReduction)) end
		dmg = _GearEffectLogic:AbsorbDamage(dmg)
		
		self.PlayerHp = self.PlayerHp - dmg
		log("Player hit! HP:" .. self.PlayerHp .. " (Wave " .. self.Wave .. " timeStep:" .. timeStep .. " dmg:" .. dmg .. ")")
		-- 슈트B 레전더리(HP 20% 이하 즉시 회복)는 피해가 적용된 "뒤"에 판정해야 한다
		_GearEffectLogic:OnAfterDamaged()
		
		_TimerService:SetTimerOnce(function()
			if isvalid(self) then self._hitImmune = false end
		end, 0.8)
		
		if self.PlayerHp <= 0 then
			self.PlayerHp = 0
			self:TriggerGameOver()
		end
	end

	@ExecSpace("ServerOnly")
	method void LevelUp()
		self.Level = self.Level + 1
		-- OnBossDefeated()는 그 시점의 누적 경험치가 ExpNeeded 미만이어도 강제로 LevelUp()을 호출한다.
		-- 그냥 빼기만 하면 음수 Exp가 남는데, 경험치 바 갱신(NotifyExpChanged)의 ratio 계산이
		-- math.max(0, ...)로 음수를 0에 고정시켜서, 그 뒤로 몬스터를 잡아 조금씩 채워도 다시 0을
		-- 넘기 전까지는 바가 안 움직이는 것처럼 보이는 버그가 있었다 — 0 밑으로 내려가지 않게 고정한다.
		self.Exp = math.max(0, self.Exp - self.ExpNeeded)
		self.ExpNeeded = self:GetExpNeededForLevel(self.Level)
		self.Wave = self.Wave + 1
		self.PlayerMaxHp = self.PlayerMaxHp + 15
		self.PlayerHp = math.min(self.PlayerHp + 15, self.PlayerMaxHp)
		-- 맵4+ 잠금 기준이 보스 처치 대신 레벨5(2026-08-04: 유저 요청으로 10→5 완화)라, 맵 이동 없이
		-- 그 자리에서 레벨업만으로 5를 찍을 수도 있다 — NotifyBossDefeated(true)를 그대로 재사용해
		-- 맵3에 있는 클라이언트의 자물쇠를 즉시 갱신한다(파라미터 이름과 달리 실제로는 "맵4+ 잠금
		-- 해제 알림"으로 동작한다)
		if self.Level == 5 then
			_MapMoveUI:NotifyBossDefeated(true)
		end
		log("Level Up! Lv." .. self.Level .. " | Wave:" .. self.Wave .. " | MaxHP:" .. self.PlayerMaxHp)
		_CardManager:GenerateLevelUpChoices()
		self:NotifyExpChanged(self.Exp, self.ExpNeeded, self.Level, true)
	end

	method number GetExpNeededForLevel(integer level)
		if level == 1 then return 120
		elseif level == 2 then return 300
		elseif level == 3 then return 450
		elseif level == 4 then return 600
		elseif level == 5 then return 750
		elseif level == 6 then return 850
		elseif level == 7 then return 950
		elseif level == 8 then return 1000
		elseif level == 9 then return 1050
		elseif level == 10 then return 1080
		elseif level == 11 then return 1100
		elseif level == 12 then return 1120
		elseif level <= 21 then return 1150 + (level - 13) * 30 -- 13~21: 1150~1390
		end
		return 1550 + (level - 22) * 20                          -- 22+: 1550부터 계속 완만히 증가
	end

	@ExecSpace("Server")
	method void RequestGiveUp()
		if self.GameOver then return end
		log("GameManager: give up requested from option popup")
		-- GameOver보다 먼저 켜야 한다 — 클라 GameOverUI는 GameOver가 켜지는 순간 버튼 구성을
		-- 결정하므로, 이 플래그가 늦게 도착하면 이어하기 버튼이 한 프레임 보였다 사라진다.
		self._gaveUp = true
		self:TriggerGameOver()
	end

	@ExecSpace("ServerOnly")
	method void TriggerGameOver()
		-- 타임어택 오버타임(절망의 칼날 등장 이후) 도중 죽었는지를 게임오버 팝업이 열려있는 동안
		-- 안정적으로 참조할 수 있도록 이 시점에 캡처해 둔다 — GameOverUI가 이 값으로 "이어하기+다시하기"
		-- 대신 "다시하기만" 노출할지 결정한다.
		self._timeAttackOvertimeDeath = self._timeAttackOvertimeActive
		self.GameOver = true
		_MonsterSpawner:StopSpawning()
		-- 유물 골드 보너스는 킬마다 곱하지 않고, 게임오버 시점에 이번 구간(직전 정산 이후) 동안
		-- 모은 골드 총액에 한 번에 곱해서 지급한다 — 정수 내림 오차가 킬 단위보다 훨씬 작아진다
		local bonusPercent = _RelicInventory:GetGoldBonusPercent()
		local earnedSinceBonus = self.Gold - self._goldBonusCheckpoint
		if bonusPercent > 0 and earnedSinceBonus > 0 then
			local bonusGold = math.floor(earnedSinceBonus * bonusPercent / 100)
			if bonusGold > 0 then
				self:AddGold(bonusGold)
				log("Gold relic bonus applied: +" .. bonusGold .. " (" .. bonusPercent .. "% of " .. earnedSinceBonus .. ")")
			end
		end
		self._goldBonusCheckpoint = self.Gold
		-- 가방 환전은 여기서 하지 않는다 — "이어하기"를 고르면 가방 아이템은 그대로 유지되어야 하므로,
		-- 실제로 "처음부터 다시하기"를 선택했을 때(RestartGame)만 환전+초기화한다
		--
		-- 랭킹 등록은 여기(죽은 시점)에서 한 번만 한다. "이어하기"로 런이 이어지면 가방이 더 쌓이므로
		-- 다음 게임오버 때 더 높은 점수로 다시 등록되고, SetScoreAndWait가 기존 최고점보다 높을 때만
		-- 갱신하므로 중복 등록이어도 최고 기록만 남는다.
		-- SetScoreAndWait는 DataStorage 왕복(AndWait)이라 전투 코드 흐름을 그대로 붙잡으면 안 된다 —
		-- 타이머로 한 프레임 넘겨서 실행한다.
		_TimerService:SetTimerOnce(function() self:SubmitRankingScore() end, 0)
		log("Game Over!")
	end

	@ExecSpace("ServerOnly")
	method integer CalcRunScore()
		local defs = _PlayerInventory:GetAllItemDefs()
		local orderedIds = _PlayerInventory:GetOrderedItemIds()
		local total = 0
		for i, itemId in ipairs(orderedIds) do
			local def = defs[itemId]
			if def ~= nil then
				total = total + _PlayerInventory:GetItemCount(itemId) * def.coinValue
			end
		end
		return total
	end

	@ExecSpace("ServerOnly")
	method integer EncodeRankScore(integer score, integer survivalSeconds)
		local tail = survivalSeconds
		if tail < 0 then tail = 0 end
		if tail > self.RankScoreTimeScale - 1 then tail = self.RankScoreTimeScale - 1 end
		return score * self.RankScoreTimeScale + tail
	end

	@ExecSpace("ServerOnly")
	method void SubmitRankingScore()
		-- 이번 런의 기록을 해당 모드의 랭킹 보드에 등록한다(기존 최고점보다 높을 때만 갱신).
		local score = self:CalcRunScore()
		if score <= 0 then
			log("GameManager: ranking submit skipped (score=0)")
			return
		end
		
		local boardId = self.RankBoardIdUnlimited
		if self.TimeAttackMode then
			boardId = self.RankBoardIdTimeAttack
		end
		
		local configData = _RankingConfigDataSetLogic:GetData(boardId)
		if configData == nil then
			log_error("GameManager: ranking configData is nil. boardId=" .. tostring(boardId))
			return
		end
		
		local survivalSeconds = math.floor(_MonsterSpawner._elapsedPlayTime)
		local stored = self:EncodeRankScore(score, survivalSeconds)
		local cycleIndex = configData:GetCycleIndex(_DateTimeLogic:GetTimeElapsed())
		
		for _, userEntity in ipairs(_UserService.UserEntities.Values) do
			if isvalid(userEntity) and userEntity.PlayerDBManager.IsLoadSuccess then
				local tag = userEntity.PlayerComponent.Nickname
				userEntity.PlayerRanking:SetScoreAndWait(boardId, cycleIndex, stored, tag, "", false)
			end
		end
		
		-- 방금 등록한 기록이 곧바로 목록에 보이도록 조회 캐시를 버린다 — 안 그러면 로비로 돌아가
		-- 랭킹을 열었을 때 LiveCacheSeconds 동안 직전(내 기록 없는) 목록이 그대로 보인다
		_RankingViewLogic:InvalidateLiveCache(boardId)
		
		log(string.format("GameManager: ranking submitted. boardId=%d score=%d survival=%ds stored=%d", boardId, score, survivalSeconds, stored))
	end

	@ExecSpace("Server")
	method void RequestStartGame(boolean timeAttack, integer characterIndex, integer episode)
		self:StartGame(timeAttack, characterIndex, senderUserId, episode)
	end

	@ExecSpace("ServerOnly")
	method void StartGame(boolean timeAttack, integer characterIndex, string userId, integer episode)
		-- 버그 수정(2026-08-26, 유저 리포트 "아르카나 말고 다른 캐릭 골랐는데 에너지볼트같은 공격이
		-- 적한테 들어가네") — GameOver 없이(죽지 않은 채) 타이틀로 돌아가 "게임 시작"을 다시 누르면
		-- TitleUI.OnStartClicked가 RequestStartGame(다시하기 아님)을 호출한다. 이땐 GameStarted가 이미
		-- true라 아래에서 바로 return하는데, 그 전에도 SelectedCharacter는 새로 골든 캐릭터로 이미
		-- 바뀐 상태였다 — 문제는 카드 슬롯(Slot1Card 등)이 리셋되지 않아 이전 캐릭터(예: 아르카나)가
		-- 배정해둔 카드(예: 에너지볼트, 카드9)가 그대로 남아 계속 틱된다는 것. 캐릭터가 실제로
		-- 바뀐 경우에만 ResetAllCards()로 슬롯을 비운다(같은 캐릭터로 다시 누른 경우는 진행 중인 런을
		-- 그대로 이어가야 하므로 건드리지 않는다).
		local characterChanged = self.GameStarted and characterIndex ~= self.SelectedCharacter
		self.SelectedCharacter = characterIndex
		self.SelectedEpisode = episode
		self.TimeAttackMode = timeAttack
		self.TimeAttackRemaining = timeAttack and self.TimeAttackDuration or 0
		-- 타이틀 화면에서 처음 한 번만 실제 웨이브 스폰을 활성화한다. 그 전까지 OnBeginPlay에서
		-- 곧바로 스폰을 켜두면, 유저가 타이틀 화면을 보는 동안에도 몬스터가 쌓이게 된다.
		if self.GameStarted then
			if characterChanged then
				_CardManager:ResetAllCards()
				log("GameManager: character changed without dying (" .. characterIndex .. "), cards reset")
			end
			return
		end
		_MapManager:SetEpisodeRange(episode)
		-- MapManager.OnUpdate의 자동 시작-리다이렉트는 월드 시작 직후(에피소드를 고르기 한참 전) 이미
		-- 에피1 기본값(존1)으로 1회 소비돼버린 상태다 — 에피소드2/3를 골랐다면 여기서 명시적으로 다시
		-- 옮겨줘야 한다(RestartGame은 항상 이 호출을 하므로 이 분기는 "최초 시작"에서만 필요).
		-- GameStarted를 이 이동보다 반드시 뒤에 켠다 — SilentMoveToMap은 GameStarted가 true일 때만
		-- 내부에서 ActivateMap(몬스터 스폰)을 같이 실행하는데, 그걸 여기서 미리 켜놓으면 바로 아래
		-- BeginGameplay()의 ActivateMap과 겹쳐 초기 스폰이 두 번(그래서 에피1보다 몬스터가 더 많이)
		-- 일어나는 버그가 있었다(유저 리포트로 발견) — 에피1 새 시작은 이 분기를 안 타서 항상
		-- BeginGameplay() 한 번뿐이었으므로 에피2/3만 비대칭이었다.
		if episode == 2 or episode == 3 then
			_MapManager:SilentMoveToMap(_MapManager.CurrentMapIndex, _MapManager.DesiredStartMapIndex)
		end
		self.GameStarted = true
		-- 입장 로딩 화면이 화면을 가리고 있는 동안은 몬스터를 풀지 않는다 — 화면만 가리고 스폰은
		-- 그대로 돌리면 "인식도 못 했는데 죽어있는" 문제가 오히려 심해진다(유저 리포트가 바로 그것).
		-- 화면이 밝아지는 순간(EntryDelaySeconds 경과)에 맞춰 전투를 시작한다.
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			_MapManager:BeginGameplay()
			log("GameManager: gameplay begun after entry loading")
		end, self.EntryDelaySeconds)
		_CardManager:InitWeaponSkillForRun(userId)
		-- 장비 등급 스킬(무기 외 4부위 포함)의 런 상태도 같은 시점에 초기화한다
		_GearEffectLogic:InitForRun(userId)
		log("GameManager: game started (TimeAttackMode=" .. tostring(timeAttack) .. ", SelectedCharacter=" .. characterIndex .. ", Episode=" .. episode .. ")")
	end

	@ExecSpace("Server")
	method void RequestRestart(boolean timeAttack, integer characterIndex, integer episode)
		self:RestartGame(timeAttack, characterIndex, senderUserId, episode)
	end

	method integer GetContinueCost()
		local idx = self.ContinueCount + 1
		if idx > #self._continueCostTable then idx = #self._continueCostTable end
		return self._continueCostTable[idx]
	end

	@ExecSpace("Server")
	method void RequestContinue()
		local cost = self:GetContinueCost()
		if not self:SpendCoins(cost) then
			log("RequestContinue: not enough coins (cost=" .. cost .. ", have=" .. self.TotalCoins .. ")")
			return
		end
		self.ContinueCount = self.ContinueCount + 1
		self._gaveUp = false
		self:ContinueGame()
	end

	@ExecSpace("ServerOnly")
	method void RestartGame(boolean timeAttack, integer characterIndex, string userId, integer episode)
		-- 처음부터 다시 시작: 모든 상태를 초기화
		self.SelectedCharacter = characterIndex
		self.SelectedEpisode = episode
		_MapManager:SetEpisodeRange(episode)
		self.PlayerMaxHp = 100
		self.PlayerHp = 100
		self.Level = 1
		self.Exp = 0
		self.ExpNeeded = 120
		self.Gold = 0
		self._goldBonusCheckpoint = 0
		self.Wave = 1
		self.GameOver = false
		self.ContinueCount = 0
		self._hitImmune = false
		self.TimeAttackMode = timeAttack
		self.TimeAttackRemaining = timeAttack and self.TimeAttackDuration or 0
		self._timeAttackOvertimeDeath = false
		self._gaveUp = false
		self:ClearDespairBlade()
		-- 레벨10(또는 보스 처치)으로 열렸던 맵4+ 잠금도 "처음부터"에 포함된다 — 새 런에서는 다시 잠근다.
		-- 위에서 Level을 이미 1로 되돌렸기 때문에 여기서 Level로 조건을 걸면 항상 거짓이 되어 버린다 —
		-- 그냥 무조건 다시 잠그고 알린다(이미 잠겨있었어도 아무 부작용 없는 멱등 호출)
		self.BossDefeated = false
		_MapMoveUI:NotifyBossDefeated(false)
		-- 이전 런에서 맵4+까지 진행했더라도 시작 맵(map02)으로 되돌린다. 이미 시작 맵이면 내부에서 no-op
		_MapManager:SilentMoveToMap(_MapManager.CurrentMapIndex, _MapManager.DesiredStartMapIndex)
		-- 버그 수정(2026-08-21) — 로비/게임오버 화면이 StopBGM(true)로 채널을 끊어놨을 수 있으므로,
		-- 시작 맵과 같은 파일이어도(no-op이어도) 무조건 다시 튼다(MapManager.ForcePlayBgmForCurrentMap 참고)
		_MapManager:ForcePlayBgmForCurrentMap()
		_CardManager:ResetAllCards()
		_CardManager:InitWeaponSkillForRun(userId)
		-- 장비 등급 스킬(무기 외 4부위 포함)의 런 상태도 같은 시점에 초기화한다
		_GearEffectLogic:InitForRun(userId)
		-- 그림자숲 상점 스킬 슬롯(3~5번)도 새 런 기준으로 다시 뽑는다 — 매진 상태도 같이 초기화된다
		_ShadowShopUI:ForceReroll()
		-- 존21 외계인 이스터에그도 새 런에서는 다시 도전할 수 있게 초기화한다("이어하기"는 건드리지 않음)
		_Zone21AlienEasterEggLogic:ResetForNewRun()
		-- 존27 석상 이스터에그(얄미운 미니무르)도 동일한 정책으로 초기화
		_NinjaStatuePuzzleLogic:ResetForNewRun()
		-- 존40~43 에르다스 이스터에그 + 존44(map24) 보물상자도 동일한 정책으로 초기화
		_Map23ErdasEasterEggLogic:ResetForNewRun()
		_Map24TreasureChestLogic:ResetForNewRun()
		-- 에피2 map1 보유 스킬 이스터에그(object-3428_19)도 동일한 정책으로 초기화
		_Ep2Map1SkillEasterEggLogic:ResetForNewRun()
		-- 에피2 map1 선물 NPC(object-3428_84)도 동일한 정책으로 초기화(다시 2번 도전 + 잡템 재추첨)
		_Ep2Map1GiftNpcLogic:ResetForNewRun()
		-- 에피2 map1 열쇠 이스터에그(object-3428_75)도 동일한 정책으로 초기화(다시 2번 도전 가능)
		_Ep2Map1KeyEasterEggLogic:ResetForNewRun()
		-- 에피2 map1 구름/상자 이스터에그(object-3428_79 구름 + object-3428_31 상자)도 동일한 정책으로
		-- 초기화 — 구름이 다시 나타나고(5번 눌러야 걷힘) 상자도 다시 열 수 있다
		_Ep2Map1CloudEasterEggLogic:ResetForNewRun()
		_Ep2Map1ChestEasterEggLogic:ResetForNewRun()
		-- 에피2 map2 아이템 이스터에그(MapObject_46)도 동일한 정책으로 초기화(다시 2번 도전 가능)
		_Ep2Map2ItemEasterEggLogic:ResetForNewRun()
		-- 에피2 미니빈 이스터에그(MapObject_41/222/153/223)도 동일한 정책으로 초기화 — 남아있던
		-- 미니빈은 정리하고 다시 도전할 수 있게 한다
		_Ep2MiniBeanEasterEggLogic:ResetForNewRun()
		-- 에피2 map2(여신 탑) 석상 퍼즐(MapObject_37/195/36/196/38/263)도 동일한 정책으로 초기화 — 들고
		-- 있던/놓았던 아이템을 전부 원위치로 되돌리고 보상 오브젝트(MapObject_224)도 다시 숨긴다
		_Ep2Map2StatuePuzzleLogic:ResetForNewRun()
		-- 에피2 map2 스킬함 이스터에그(MapObject_269→240)도 동일한 정책으로 초기화 — 숨겼던 오브젝트를
		-- 다시 보이게 하고 원위치로 되돌린다
		_Ep2Map2SkillChestLogic:ResetForNewRun()
		-- 에피2 map2 뒤집기 포션 이스터에그(MapObject_230)도 동일한 정책으로 초기화 — 다시 뒤집힌
		-- 상태로 되돌려서 재도전할 수 있게 한다
		_Ep2Map2FlipPotionLogic:ResetForNewRun()
		-- 에피2 map3 지쳐버린 기사 존1 드래그 트리거(MapObject_67)도 동일한 정책으로 초기화 — 원위치로
		-- 되돌려서 재도전할 수 있게 한다(존2~10 우선 스폰 여부는 위 ResetTiredKnightTracking이 따로 처리)
		_Ep2Map3TiredKnightLogic:ResetForNewRun()
		-- 에피2 map3 object-658 소환수(있으면) 즉시 정리 — 다시하기 시 이전 런의 소환수가 남아있지 않게 한다
		_Ep2Map3SummonLogic:ResetForNewRun()
		-- 에피2 map4 MapObject_205 켄타우로스 무리 이스터에그 — 다시하기 시 클릭 카운트/사용 여부 리셋
		_Ep2Map4CentaurLogic:ResetForNewRun()
		-- 에피2 map4 조각 퍼즐(MapObject_111 등 7개) — 다시하기 시 조각 원위치 + 공개 오브젝트 다시 숨김
		_Ep2Map4PiecePuzzleLogic:ResetForNewRun()
		-- 몬스터 갤러리 전투 미니게임 — 새 런마다 무료 재도전 1회를 다시 쓸 수 있게 리셋
		_Ep2Map2ArenaLogic:ResetForNewRun()
		-- ep2_map2_hidden 경험치 2배 이벤트(3분, 1회성) — 새 런에서 다시 쓸 수 있게 소진 플래그/배율 초기화
		_Ep2Map2HiddenExpBoostLogic:ResetForNewRun()
		-- "처음부터 다시하기": 이번 런에 가방에 쌓인 잡템은 골드로 환전한 뒤 가방을 비운다
		_PlayerInventory:ConvertAllToCoins()
		_MonsterSpawner:ClearAllMonsters()
		-- 카페테리아 가마솥(ep2_map3 존4)은 ClearAllMonsters 이후에 다시 스폰해야 한다 — 먼저 하면
		-- 방금 새로 스폰한 솥단지까지 같이 지워진다. 구름(MapObject_17)도 여기서 원상복구한다.
		_Ep2Map3CauldronLogic:ResetForNewRun()
		-- 에피3 map1(엘라스 산맥) 한겨울의 주황버섯 이스터에그(MapObject_120)도 동일한 정책으로 초기화 —
		-- 오브젝트를 원위치로 되돌려서 다시 도전할 수 있게 한다
		_Ep3Map1MushroomLogic:ResetForNewRun()
		-- 에피3 map1 가리개 스킬 이스터에그(MapObject_80→100)도 동일한 정책으로 초기화 — 가리개를
		-- 다시 보이게(알파1.0) 되돌려서 재도전할 수 있게 한다
		_Ep3Map1SkillCoverLogic:ResetForNewRun()
		-- 에피4 map1 이스터에그 준비 작업(선행 배치, MapObject_106→111)도 동일한 정책으로 초기화
		_Ep3Map1InvitationEasterEggLogic:ResetForNewRun()
		-- 에피3 map2 잡템 수집 이스터에그(object-15_131)도 동일한 정책으로 초기화 — 다시 도전 가능 +
		-- 잡템 목표도 재추첨된다
		_Ep3Map2CollectLogic:ResetForNewRun()
		-- 에피3 map3 잡템 수집 이스터에그(object-15_131, 2종×25개)도 동일한 정책으로 초기화
		_Ep3Map3CollectLogic:ResetForNewRun()
		-- 에피3 map2 가리개 스킬 이스터에그(object-15_127→133)도 동일한 정책으로 초기화 — 가리개를
		-- 다시 보이게(알파1.0) 되돌려서 재도전할 수 있게 한다
		_Ep3Map2SkillCoverLogic:ResetForNewRun()
		-- 에피3 map2 존10 "길잃은 루돌프" 이스터에그도 동일한 정책으로 초기화 — 남은 불량 루돌프를
		-- 정리하고 길잃은 루돌프를 다시 스폰한다
		_Ep3Map2LostRudolphLogic:ResetForNewRun()
		-- 에피3 map2 zone5 "상자 뒤에 숨은 선물" 이스터에그도 동일한 정책으로 초기화 — 상자 3개를
		-- 원래 자리로 되돌리고 선물을 다시 보이게 한다
		_Ep3Map2HiddenGiftLogic:ResetForNewRun()
		-- 에피3 map2 랜덤 보너스 보스(커플예티)도 동일한 정책으로 초기화 — 떠 있던 보스를 정리하고
		-- 다음 스폰 간격을 새로 굴리게 한다
		_Ep3Map2BonusBossLogic:ResetForNewRun()
		-- 에피3 map3 "자격의 증표" 이스터에그(object-15_108 등 16개 중 1개 당첨)도 동일한 정책으로
		-- 초기화 — 유저 지정: "다시하기나 새로시작하면 드랍되는 위치가 바뀌는거" — 당첨 오브젝트를 새로 뽑는다
		_Ep3Map3ItemEasterEggLogic:ResetForNewRun()
		-- 에피3 map3 "푼코" 군집형 비행 이스터에그(object-15_73)도 동일한 정책으로 초기화 — 새 런에서
		-- 다시 눌러 소환할 수 있고, 쿠스코 등장 확률도 다시 판정된다
		_Ep3Map3PunkoEasterEggLogic:ResetForNewRun()
		-- 에피3 map4 "푼코" 이스터에그(object-15_73/143/171/172, 오브젝트 4개 각자 런당 1회)도 동일하게 초기화
		_Ep3Map4PunkoEasterEggLogic:ResetForNewRun()
		-- 에피3 map4 히든맵 포탈(portal-3)도 초기화 — 새 런에서는 다시 숨겨지고 오브젝트 4개를 다시 눌러야 함
		_Ep3Map4Ester1PortalLogic:ResetForNewRun()
		_MonsterSpawner:ResetEliteTracking()
		-- 지쳐버린 기사(Tired Knight) 존별 스폰 여부도 초기화 — 새 런에서 존마다 다시 1마리씩 등장한다
		_MonsterSpawner:ResetTiredKnightTracking()
		-- StartGame과 같은 이유로 스폰 재개도 입장 로딩 시간만큼 미룬다(GameOverUI의 "다시하기"도
		-- 로딩 화면을 띄운다) — 검은 화면 뒤에서 몹이 이미 달려오고 있으면 안 된다
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			_MonsterSpawner:RestartSpawning()
			log("GameManager: spawning restarted after entry loading")
		end, self.EntryDelaySeconds)
		self:NotifyExpChanged(self.Exp, self.ExpNeeded, self.Level, true)
		log("Game restarted (full reset)")
	end

	@ExecSpace("ServerOnly")
	method void ContinueGame()
		-- 이어하기: 레벨/경험치/골드/웨이브 유지, 체력 회복
		self.PlayerHp = self.PlayerMaxHp
		self.GameOver = false
		-- 버프 카드(7/8) 상태 초기화 → 이어하기 직후 즉시 재발동
		_CardManager:ResetBuffsForContinue()
		-- 기존 몬스터를 제거하지 않고 스폰 위치로 밀어냄 (먼지 이펙트 포함)
		_MonsterSpawner:PushAllMonstersBack()
		-- 타이머 리셋 없이 재개 → 이어하기 직후 추가 스폰 배치 없음
		_MonsterSpawner:ResumeSpawning()
		log("Game continued (Wave " .. self.Wave .. ", Lv." .. self.Level .. ")")
	end

	@ExecSpace("ServerOnly")
	method void HealPlayer(integer amount)
		-- 포션 사용 시 체력 회복 (최대 HP 초과 불가)
		if self.GameOver then return end
		self.PlayerHp = math.min(self.PlayerHp + amount, self.PlayerMaxHp)
		log("Player healed " .. amount .. " -> HP:" .. self.PlayerHp)
	end

	@ExecSpace("ServerOnly")
	method void TryDropHealPotion(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		-- 일반 몬스터 처치 시 가끔 회복 포션을 드롭한다 (빨강/흰색은 배타적 — 합쳐서 15% 확률)
		if self.GameOver then return end
		
		-- 유물 레벨업 보너스(레벨 합계 1당 +0.5%p)를 두 확률에 동일하게 얹는다
		local bonusChance = _RelicInventory:GetPotionChanceBonusPercent() / 100
		local redChance = self.RedPotionDropChance + bonusChance
		local whiteChance = self.WhitePotionDropChance + bonusChance
		
		local r = _UtilLogic:RandomDouble()
		local potionType = 0
		if r < redChance then
			potionType = 1
		elseif r < redChance + whiteChance then
			potionType = 2
		end
		if potionType == 0 then return end
		
		self:ApplyPotionDrop(potionType, worldPos, fallHeight, groundWorldY, dropScale)
	end

