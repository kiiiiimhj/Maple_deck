	@ExecSpace("ServerOnly")
	method number GetZoneDieDuration(integer idx)
		local durations = {
			0.95,  -- 1: 음흉한 여우      9프레임
			1.05,  -- 2: 이상한 돼지     10프레임
			0.35,  -- 3: 주황버섯         3프레임
			0.45,  -- 4: 시니컬한 주황버섯 4프레임
		}
		local i = math.max(1, math.min(idx, #durations))
		return durations[i]
	end

