				attack2Sfx = "",
				summonCooldown = 0,
				summonCount = 0,
				summonFx = "",
				summonFxDur = 0,
				-- 맞을수록 성장(에피2 망치병과 같은 값 — 한 방에 크기 +10%/공속 +5%, 상한 +80%/+60%)
				growScalePerHit = 0.10,
				growScaleMax = 0.80,
				growAtkPerHit = 0.05,
				growAtkMax = 0.60,
				escort = nil,
				hasSplit = false,
				flying = false,
				hpMultiplier = 1.0,
				atkMultiplier = 1.0,
				zigzag = false,
