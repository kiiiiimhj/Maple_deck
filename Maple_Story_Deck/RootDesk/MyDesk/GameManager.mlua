	-- ── 엘리트 로스터 라우터 (에피소드 무관) ──────────────────────────────────────
	-- 보스 라우터(HasBossRoster/GetBossCount/GetBossDef)와 완전히 같은 구조다. 엘리트 인프라
	-- (가방 뽑기 / 승급 / 좌표 재배치 / 외형 덮어쓰기)는 전부 이 세 메서드만 거치므로,
	-- 새 에피소드 로스터를 붙일 때 여기 한 줄만 추가하면 된다.
	@ExecSpace("ServerOnly")
	method boolean HasEliteRoster()
		-- 지금 에피소드에 전용 엘리트 로스터가 있나(없으면 예전처럼 "그 존 몬스터 1마리 승급"만 한다)
		return self.SelectedEpisode == 1 or self.SelectedEpisode == 2 or self.SelectedEpisode == 3
	end

	@ExecSpace("ServerOnly")
	method integer GetEliteCount()
		-- 지금 에피소드의 엘리트 종 수
		if self.SelectedEpisode == 2 then return self:GetEp2EliteCount() end
		if self.SelectedEpisode == 3 then return self:GetEp3EliteCount() end
		return self:GetEp1EliteCount()
	end

	@ExecSpace("ServerOnly")
	method any GetEliteDef(integer index)
		-- 지금 에피소드의 index번째 엘리트 정의
		if self.SelectedEpisode == 2 then return self:GetEp2EliteDef(index) end
		if self.SelectedEpisode == 3 then return self:GetEp3EliteDef(index) end
		return self:GetEp1EliteDef(index)
	end

	-- ── 에피소드2 보스 로스터 (유저 지정, 2026-09-08) ──────────────────────────────
	-- 에피1과 **완전히 같은 def 스키마**를 쓴다 — 그래서 호위(escort)/피격성장(growScale·growAtk)/
	-- 순번 순환 같은 기존 보스 인프라가 코드 수정 없이 그대로 돌아간다. 에피2에서만 필요한 거동
	-- (비행 / 동반 보스 / 지그재그 / 공격마다 공속증가 / 공격 후 대시)은 아래 신규 필드로 추가했고,
	-- 에피1 def에는 그 필드가 없으므로 MonsterAI 쪽에서 nil을 기본값으로 접어 읽는다.
	--   1번 = 픽시맘 + 파파픽시 (둘 다 **비행**, 한 차례에 같이 등장 — partner 필드)
	--   2번 = 엘리쟈             (근접, 지그재그 + 공격할 때마다 공속↑ + 공격 후 잔상 대시
	--                            + HP 50% 이하에서 다크 엘리쟈로 변신 — 변신 중 무적, 이후 공속 고정 2배)
	--   3번 = 의식에 휘말린 망치병 (근접, 맞을 때마다 크기 +10%·공속↑ — 상한 +80%)
	--   4번 = 크세르크세스        (좌우 2마리씩 호위 4마리 대동 — 블루 머쉬맘 방식.
	--                            호위는 본체와 **다른 종**인 "사랑에 빠진 크세르크세스")
	--
	-- ⚠ 재생시간은 전부 **실측**(2026-09-08, LoadAnimationClipAndWait의 프레임 delay 합):
	--   픽시맘 attack1 21f/2.730 die1 7f/1.080 · 파파픽시 attack1 33f/4.290 die1 7f/1.080
	--   엘리쟈 attack1 30f/3.600 die1 12f/1.800 · 망치병 attack1 18f/2.160 die1 24f/2.880
	--   크세르크세스 attack1 35f/4.200 die1 43f/5.970 · 다크 엘리쟈 attack1 30f/3.600 die1 14f/1.680
	--   픽시 공용 착탄 4f/0.520 · 엘리쟈 변신 연출 4f/0.480
	--
	-- ⚠ scale은 에피1 보스들의 화면상 폭(≈175px = 머쉬맘 120×1.5 / 다일 195×0.875)에 맞춘 값이다.
	-- 최종 배율 = 보스 공통 ×2.5 × 이 값.
	@ExecSpace("ServerOnly")
	method integer GetEp2BossCount()
		-- 에피소드2 보스 순번의 총 개수(= 이 수를 넘기면 다시 1번으로 순환).
		return 4
	end

	@ExecSpace("ServerOnly")
	method any GetEp2BossDef(integer index)
		-- 에피소드2 보스 index번째(1부터)의 외형/사운드/크기/기믹 정의를 한 행으로 반환한다.
		local defs = {
			{
				-- 1번: 픽시맘 (mob/9300472.img) — 파트너인 파파픽시와 **같이** 등장하는 비행 보스.
				-- 유저 지정: "둘 다 비행형", "체력 0.75 / 공격력도 (2마리니까)", "첫 등장 시 동시에
				-- 공격하지 말고 0.5초 텀을 두고 따로".
				name = "픽시맘",
