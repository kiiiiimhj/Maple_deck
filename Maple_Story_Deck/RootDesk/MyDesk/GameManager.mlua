			[15] = {"", "898688a3be7b41e082db00b95e2dbe02", ""},  -- 커즈아이(없음)/박쥐(비행형)/이블아이(없음)
			[16] = {"a707f3a77f75478aa77533669d3a29c9", ""},  -- 내면의 그림자(비행형)/그림자 보어(없음)
