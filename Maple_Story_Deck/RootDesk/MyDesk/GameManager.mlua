			-- 2종씩 로테이션(129:쿨리/마이너 130:마이너/플라이아이 131:플라이아이/미믹 132:미믹/쿨리),
			-- 존5(133)는 4종 전부 등장하는 마무리 존. msw-search 실측(mob/5130107.img 쿨리좀비,
			-- mob/5130108.img 마이너좀비, mob/4230107.img 플라이아이, mob/8220027.img 미믹).
			[129] = {"37bd3ffa840f4558a179db705941b684", "a2dc6411ae4a40bc8ddbee6cb0d6ac0f"},  -- 쿨리좀비/마이너좀비
			[130] = {"a2dc6411ae4a40bc8ddbee6cb0d6ac0f", "04d56278279f45c6a99f6726ef5c91fe"},  -- 마이너좀비/플라이아이
			[131] = {"04d56278279f45c6a99f6726ef5c91fe", "66a2ee4f4ccf4e1f9525b8fd64f08efb"},  -- 플라이아이/미믹
			[132] = {"66a2ee4f4ccf4e1f9525b8fd64f08efb", "37bd3ffa840f4558a179db705941b684"},  -- 미믹/쿨리좀비
			[133] = {"37bd3ffa840f4558a179db705941b684", "a2dc6411ae4a40bc8ddbee6cb0d6ac0f", "04d56278279f45c6a99f6726ef5c91fe", "66a2ee4f4ccf4e1f9525b8fd64f08efb"},  -- 쿨리좀비/마이너좀비/플라이아이/미믹
		}
		local pool = pools[mapIndex]
		if pool == nil then return "" end
		local i = math.max(1, math.min(idx, #pool))
		return pool[i]
	end

	-- 맵 전용 몬스터 풀(존7+) move(이동) 애니메이션 RUID. 비행형 종(GetMapIsFlying이 true인 인덱스)은
	-- 접근을 스케일이 아니라 자유비행으로 표현하므로 move 연출이 필요 없어 빈 문자열로 둔다
