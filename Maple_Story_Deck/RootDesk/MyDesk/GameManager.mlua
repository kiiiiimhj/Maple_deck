			-- ep3_map4_ester_1(존1~5 = mapIndex129~133, 이스터에그 전용, 미배선) — 쿨리좀비/마이너좀비/플라이아이/미믹
			[129] = {"2791ef817267473bbe413b8dd157bc43", "9763a6106a3b4e1aba9b59e94206d875"},
			[130] = {"9763a6106a3b4e1aba9b59e94206d875", "d69b6340252740a48b4631ce00d058c7"},
			[131] = {"d69b6340252740a48b4631ce00d058c7", "a320d3528783442fb87c16492fc27910"},
			[132] = {"a320d3528783442fb87c16492fc27910", "2791ef817267473bbe413b8dd157bc43"},
			[133] = {"2791ef817267473bbe413b8dd157bc43", "9763a6106a3b4e1aba9b59e94206d875", "d69b6340252740a48b4631ce00d058c7", "a320d3528783442fb87c16492fc27910"},
		}
		local pool = pools[mapIndex]
		if pool == nil then return "" end
		local i = math.max(1, math.min(idx, #pool))
		return pool[i]
	end

