@Component
script Ep5GourdInspectTrigger extends Component

	property Entity Source = nil
	property any _touchHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		if self._touchHandler == nil then self._touchHandler = self.Entity:ConnectEvent(TouchEvent,self.OnTouched) end
	end

	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		if not _GameManager.GameStarted or _GameManager.GameOver or _GameManager:IsGamePaused() or _TitleUI.titleGroup.Enable then return end
		if _CardManager:IsMonsterUnderTouch(event.TouchPoint) then return end
		self:RequestInspect()
	end

	@ExecSpace("Server")
	method void RequestInspect()
		local source = self.Source:GetComponent("script.Ep5RoofGourdTrigger")
		if not source:ValidUser(senderUserId) or not source:IsInspectAvailable() then return end
		self.Entity:GetComponent("script.MushroomInspectChallenge"):BeginForUser(senderUserId)
	end

	@ExecSpace("ServerOnly")
	method boolean IsInspectAvailable()
		return isvalid(self.Source) and self.Source:GetComponent("script.Ep5RoofGourdTrigger"):IsInspectAvailable()
	end

	@ExecSpace("ServerOnly")
	method void OnInspectSuccess(string userId)
		if isvalid(self.Source) then self.Source:GetComponent("script.Ep5RoofGourdTrigger"):OpenGourd(userId) end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._touchHandler ~= nil then self.Entity:DisconnectEvent(TouchEvent,self._touchHandler) self._touchHandler = nil end
	end
end
