@Component
script Ep5Map4HusbandTrigger extends Component
	property any _touchHandler = nil
	method void OnBeginPlay()
		if self:IsClient() then self._touchHandler = self.Entity:ConnectEvent(TouchEvent, self.OnTouched) end
	end
	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		if _GameManager.GameOver or not _GameManager.GameStarted or _GameManager:IsGamePaused() then return end
		if _TitleUI.titleGroup.Enable or _CardManager:IsMonsterUnderTouch(event.TouchPoint) then return end
		if self.Entity.Name == "FolkDecor_326" and self:IsWifeUnderTouch(event.TouchPoint) then return end
		self:RequestTouch()
	end
	@ExecSpace("ClientOnly")
	method boolean IsWifeUnderTouch(Vector2 point)
		local wife = self.Entity.CurrentMap:GetChildByName("FolkDecor_323")
		local t = wife.TouchReceiveComponent local tf = wife.TransformComponent
		local p = _UILogic:ScreenToWorldPosition(point) local pos = tf.WorldPosition local sc = tf.Scale
		return math.abs(p.x-pos.x-t.Offset.x*sc.x)<=t.TouchArea.x*math.abs(sc.x)*0.5
			and math.abs(p.y-pos.y-t.Offset.y*sc.y)<=t.TouchArea.y*math.abs(sc.y)*0.5
	end
	@ExecSpace("Server")
	method void RequestTouch()
		_Ep5Map4HusbandLogic:OnObjectTouched(self.Entity, senderUserId)
	end
	method void OnEndPlay()
		if self:IsClient() and self._touchHandler ~= nil then self.Entity:DisconnectEvent(TouchEvent, self._touchHandler) end
	end
end
