@Component
script Ep5SealTrigger extends Component
	property string Role = "altar"
	property any _touchHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Use the world touch receiver for PC clicks and mobile taps.
		self._touchHandler=self.Entity:ConnectEvent(TouchEvent,self.OnTouched)
	end

	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		-- No map object can be requested while a title or other modal owns input.
		if not _GameManager.GameStarted or _GameManager.GameOver or _TitleUI.titleGroup.Enable then return end
		if _GameManager:IsGamePaused() then return end
		self:RequestTouch()
	end

	@ExecSpace("Server")
	method void RequestTouch()
		-- Every role is validated again by the server-side quest controller.
		if self.Role=="entrance" then _Ep5FinalSealLogic:OnEntranceTouched(self.Entity,senderUserId)
		elseif self.Role=="return" then _Ep5FinalSealLogic:OnReturnTouched(self.Entity,senderUserId)
		else _Ep5FinalSealLogic:OnAltarTouched(self.Entity,senderUserId) end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Disconnect the touch subscription created at startup.
		if self._touchHandler~=nil then self.Entity:DisconnectEvent(TouchEvent,self._touchHandler) self._touchHandler=nil end
	end
end
