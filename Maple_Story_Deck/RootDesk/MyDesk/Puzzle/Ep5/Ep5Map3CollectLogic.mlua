@Logic
script Ep5Map3CollectLogic extends Logic

	-- ep5_map3: 4–5 flowers; exactly goal+1 of the eight plants yield one item per run.
	-- The turn-in uses the standard quest reward.
	@Sync property boolean Redeemed = false
	@Sync property string PickedItemId = ""

	@Sync property integer GiftAmount = 0
	property table TargetItems = {"ep5_village_flower"}
	property boolean _preparing = false
	property integer _generation = 0
	property table _iconBounds = {}
	property boolean _accepted = false
	property boolean _planReady = false
	property table _rewardFlowers = {}

	property number BubbleXOffset = -1.25
	property number BubbleYOffset = 1.25
	property number BubbleShowDuration = 2.0

	-- 교환 완료 하트 말풍선(Map04CollectLogic과 같은 GiftBubble 값)
	property string HeartBubbleModelId = "giftbubble"
	property string HeartIconRUID = "7ecb5769578f4b05808afaad17ee83ac"
	property Vector3 HeartIconPosition = Vector3(-0.4361, -0.2908, 0)
	property Vector3 HeartIconScale = Vector3(5.788959, 5.78895855, 1)

	property any _activeBubble = nil

	-- Ep5Map3CollectTrigger.RequestTouch()가 터치된 오브젝트 엔티티를 넘긴다
	@ExecSpace("ServerOnly")
	method void OnObjectTouched(Entity touchedObject)
		-- 목표 확정 → 모자라면 진행상황 말풍선, 다 모았으면 교환+보상
		if self.Redeemed or self._preparing or not _GameManager.GameStarted or _GameManager.GameOver or _GameManager:IsGamePaused() then return end
		if _GameManager:GetSelectedEpisode() ~= 5 or _MapManager.CurrentMapIndex ~= 213 then return end
		if not isvalid(touchedObject) then return end
		local map = touchedObject.CurrentMap
		if map == nil or map.Name ~= "ep5_map3" or touchedObject.Name ~= "FolkDecor_341" then return end
		local worldPos = touchedObject.TransformComponent.WorldPosition
		local bubblePos = Vector3(worldPos.x + self.BubbleXOffset, worldPos.y + self.BubbleYOffset, worldPos.z - 0.5)

		-- 처음 누른 순간(목표를 정한 순간)엔 가방에 이미 있어도 "X전체개수" 의뢰 말풍선만 띄운다 — 다시 눌렀을 때 보유 중이면 클리어(유저 지정 2026-10-06, 예전엔 뭔지도 모르고 바로 클리어됐다)
		local firstTap = false
		if not self._accepted then
			local generation = self._generation
			self._preparing = true
			self:EnsureHarvestPlan()
			self:PrepareQuestIcons()
			self._preparing = false
			if generation ~= self._generation then return end
			self._accepted = true
			log("[VRF] ep5 map3 flower quest accepted goal=" .. self.GiftAmount)
			firstTap = true
		end
		local itemId = self.PickedItemId

		local have = _PlayerInventory:GetItemCount(itemId)
		if firstTap then have = 0 end
		-- 다 모으는 순간 "아이템을 다 모았다!" 토스트(PlayerInventory.WatchQuestItems, 유저 지정 2026-10-06)
		_PlayerInventory:WatchQuestItems("Ep5Map3Harvest", {itemId}, self.GiftAmount)
		if have < self.GiftAmount then
			local remaining = self.GiftAmount - have
			self:ClearBubble()
			local bubble = _CollectBubbleLogic:SpawnItemQuestBubble(map, bubblePos, "Ep5Map3CollectBubble", itemId, "X" .. remaining, false)
			if bubble ~= nil then
				self._activeBubble = bubble
				self:ScheduleBubbleDestroy(bubble)
			end
			log("[VRF] Ep5Map3Collect: still collecting - " .. itemId .. " (" .. have .. "/" .. self.GiftAmount .. ", " .. remaining .. " left)")
			return
		end

		if not _PlayerInventory:RemoveItem(itemId,self.GiftAmount) then return end
		self.Redeemed = true
		_PlayerInventory:ClearQuestWatch("Ep5Map3Harvest")
		_Ep4Map1EasterEggLogic:GrantStandardReward(touchedObject)
		_AchievementLogic:OnEasterEgg()
		log("[VRF] ep5 map3 flower quest redeemed amount=" .. self.GiftAmount .. " standard=true")
		self:SpawnHeartBubble(map, bubblePos)
	end

	@ExecSpace("ServerOnly")
	method void EnsureHarvestPlan()
		if self._planReady then return end
		self.PickedItemId = "ep5_village_flower"
		self.GiftAmount = _UtilLogic:RandomIntegerRange(4,5)
		local map = _EntityService:GetEntityByPath("/maps/ep5_map3") local pool = {}
		for _,obj in ipairs(map.Children:ToTable()) do
			if obj.SpriteRendererComponent ~= nil and obj.SpriteRendererComponent.SpriteRUID == "ce08ca41ce0447c28f1a9aa89e581a41" then table.insert(pool,obj.Name) end
		end
		table.sort(pool) self._rewardFlowers = {}
		for i=1,math.min(self.GiftAmount+1,#pool) do
			local name = table.remove(pool,_UtilLogic:RandomIntegerRange(1,#pool)) self._rewardFlowers[name] = true
		end
		self._planReady = true
		log("[VRF] ep5 map3 harvest plan goal=" .. self.GiftAmount .. " rewards=" .. (self.GiftAmount+1) .. " total=8")
	end

	@ExecSpace("ServerOnly")
	method boolean IsRewardFlower(string name)
		self:EnsureHarvestPlan()
		return self._rewardFlowers[name] == true
	end

	@ExecSpace("ServerOnly")
	method table GetIconBounds(string ruid)
		if self._iconBounds[ruid] ~= nil then return self._iconBounds[ruid] end
		local sprites = {}
		if _ResourceService:GetTypeAndWait(ruid) == ResourceType.AnimationClip then
			local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
			for _,frame in ipairs(clip.Frames:ToTable()) do table.insert(sprites,frame.FrameSprite) end
		else table.insert(sprites,_ResourceService:LoadSpriteAndWait(ruid)) end
		local left = math.huge local right = -math.huge local bottom = math.huge local top = -math.huge
		for _,sprite in ipairs(sprites) do
			local pivot = sprite.PivotPixel
			left = math.min(left,-pivot.x) right = math.max(right,sprite.Width-pivot.x)
			bottom = math.min(bottom,-pivot.y) top = math.max(top,sprite.Height-pivot.y)
		end
		local bounds = {left,right,bottom,top} self._iconBounds[ruid] = bounds return bounds
	end

	@ExecSpace("ServerOnly")
	method void PrepareQuestIcons()
		local b = self:GetIconBounds("ce08ca41ce0447c28f1a9aa89e581a41")
		_CollectBubbleLogic._monsterByItem.ep5_village_flower = {"ce08ca41ce0447c28f1a9aa89e581a41",b[1],b[2],b[3],b[4]}
		_CollectBubbleLogic._itemBounds.ep5_village_flower = self:GetIconBounds("ce08ca41ce0447c28f1a9aa89e581a41")
	end

	@ExecSpace("ServerOnly")
	method void ClearBubble()
		-- 떠 있는 말풍선을 지운다
		if self._activeBubble ~= nil and isvalid(self._activeBubble) then
			self._activeBubble:Destroy()
		end
		self._activeBubble = nil
	end

	@ExecSpace("ServerOnly")
	method void ScheduleBubbleDestroy(Entity bubble)
		-- BubbleShowDuration 뒤 자동으로 지운다
		_TimerService:SetTimerOnce(function()
			if isvalid(bubble) then bubble:Destroy() end
			if self._activeBubble == bubble then self._activeBubble = nil end
		end, self.BubbleShowDuration)
	end

	@ExecSpace("ServerOnly")
	method void SpawnHeartBubble(Entity map, Vector3 pos)
		-- 교환 완료 하트 말풍선(GiftBubble)
		self:ClearBubble()
		local bubble = _SpawnService:SpawnByModelId(self.HeartBubbleModelId, "Ep5Map3CollectHeart", pos, map)
		if bubble == nil then return end
		_CollectBubbleLogic:ApplyForegroundDepth(bubble)
		self._activeBubble = bubble
		local icon = bubble:GetChildByName("Icon")
		if icon ~= nil and icon.SpriteRendererComponent ~= nil then
			icon.SpriteRendererComponent.SpriteRUID = self.HeartIconRUID
			icon.TransformComponent.Position = self.HeartIconPosition
			icon.TransformComponent.Scale = self.HeartIconScale
			icon.Enable = true
		end
		local count = bubble:GetChildByName("Count")
		if count ~= nil then count.Enable = false end
		self:ScheduleBubbleDestroy(bubble)
	end

	-- GameManager.RestartGame()이 호출 — 새 런에서는 다시 교환 가능하고 목표도 재추첨
	@ExecSpace("ServerOnly")
	method void ResetForNewRun()
		self._generation = self._generation + 1
		self.Redeemed = false
		self.PickedItemId = ""
		self.GiftAmount = 0
		self._accepted = false self._planReady = false self._rewardFlowers = {}
		_PlayerInventory:ClearQuestWatch("Ep5Map3Harvest")
		self:ClearBubble()
	end

end
