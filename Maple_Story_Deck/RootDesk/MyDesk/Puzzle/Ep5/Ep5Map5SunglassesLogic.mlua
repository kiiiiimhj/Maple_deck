@Logic
script Ep5Map5SunglassesLogic extends Logic

	-- ep5_map5 FolkDecor_223: find one pair of sunglasses near the scarecrows and return them.
	-- Reward uses the existing standard quest rewards and the NPC puts his sunglasses back on.
	@Sync property boolean Redeemed = false
	@Sync property boolean Found = false
	@Sync property string PickedItemId = ""

	@Sync property integer GiftAmount = 0
	property table TargetItems = {"ep5_sunglasses"}
	property string _winnerPath = ""
	property table _candidateNames = {"FolkDecor_224","FolkDecor_231","FolkDecor_255","FolkDecor_263","FolkDecor_279","FolkDecor_321"}
	property boolean _preparing = false
	property integer _generation = 0
	property table _iconBounds = {}
	property string OriginalRUID = "637b59ccc01f41c3b4eff64e35701393"
	property string CompletedRUID = "925d65faeb7d430186e1a53a834f6255"

	property number BubbleXOffset = -1.25
	property number BubbleYOffset = 1.25
	property number BubbleShowDuration = 2.0

	-- 교환 완료 하트 말풍선(Map04CollectLogic과 같은 GiftBubble 값)
	property string HeartBubbleModelId = "giftbubble"
	property string HeartIconRUID = "7ecb5769578f4b05808afaad17ee83ac"
	property Vector3 HeartIconPosition = Vector3(-0.4361, -0.2908, 0)
	property Vector3 HeartIconScale = Vector3(5.788959, 5.78895855, 1)

	property any _activeBubble = nil

	-- Ep5Map5SunglassesTrigger.RequestTouch()가 터치된 오브젝트 엔티티를 넘긴다
	@ExecSpace("ServerOnly")
	method void OnObjectTouched(Entity touchedObject, string userId)
		-- 목표 확정 → 모자라면 진행상황 말풍선, 다 모았으면 교환+보상
		if self.Redeemed or self._preparing or not _GameManager.GameStarted or _GameManager.GameOver or _GameManager:IsGamePaused() then return end
		if _GameManager:GetSelectedEpisode() ~= 5 or _MapManager.CurrentMapIndex ~= 230 then return end
		if not isvalid(touchedObject) then return end
		local map = touchedObject.CurrentMap
		if map == nil or map.Name ~= "ep5_map5" or touchedObject ~= map:GetChildByName("FolkDecor_223") then return end
		local player = _UserService:GetUserEntityByUserId(userId)
		if not isvalid(player) or player.CurrentMap ~= map or not touchedObject.Enable then return end
		local worldPos = touchedObject.TransformComponent.WorldPosition
		local bubblePos = Vector3(worldPos.x + self.BubbleXOffset, worldPos.y + self.BubbleYOffset, worldPos.z - 0.5)

		-- 처음 누른 순간(목표를 정한 순간)엔 가방에 이미 있어도 "X전체개수" 의뢰 말풍선만 띄운다 — 다시 눌렀을 때 보유 중이면 클리어(유저 지정 2026-10-06, 예전엔 뭔지도 모르고 바로 클리어됐다)
		local firstTap = false
		if self.PickedItemId == "" then
			local generation = self._generation
			self._preparing = true
			self.PickedItemId = "ep5_sunglasses"
			self.GiftAmount = 1
			self:PrepareQuestIcons()
			self._preparing = false
			if generation ~= self._generation then return end
			_UIToast:ShowMessage("EP5_MAP5_GLASSES_ASK",userId)
			log("[VRF] ep5 map5 sunglasses quest accepted goal=1")
			firstTap = true
		end
		local itemId = self.PickedItemId

		local have = _PlayerInventory:GetItemCount(itemId)
		if firstTap then have = 0 end
		-- 다 모으는 순간 "아이템을 다 모았다!" 토스트(PlayerInventory.WatchQuestItems, 유저 지정 2026-10-06)
		_PlayerInventory:WatchQuestItems("Ep5Map5Sunglasses", {itemId}, self.GiftAmount)
		if have < self.GiftAmount then
			local remaining = self.GiftAmount - have
			self:ClearBubble()
			local bubble = _CollectBubbleLogic:SpawnItemQuestBubble(map, bubblePos, "Ep5Map5SunglassesBubble", itemId, "X" .. remaining, false)
			if bubble ~= nil then
				self._activeBubble = bubble
				self:ScheduleBubbleDestroy(bubble)
			end
			log("[VRF] Ep5Map5Sunglasses: still collecting - " .. itemId .. " (" .. have .. "/" .. self.GiftAmount .. ", " .. remaining .. " left)")
			return
		end

		if not _PlayerInventory:RemoveItem(itemId,self.GiftAmount) then return end
		self.Redeemed = true
		_PlayerInventory:ClearQuestWatch("Ep5Map5Sunglasses")
		touchedObject.SpriteRendererComponent.SpriteRUID = self.CompletedRUID
		_Ep4Map1EasterEggLogic:GrantStandardReward(touchedObject)
		local rewardPos = touchedObject.TransformComponent.WorldPosition
		local fall = _GameManager:GetGroundFallFor(touchedObject,rewardPos)
		_GameManager:GrantLootItemDrop(rewardPos,fall.x,fall.y,"ep5_farmer_gift",1)
		_UIToast:ShowMessage("EP5_MAP5_GLASSES_DONE",userId)
		_AchievementLogic:OnEasterEgg()
		log("[VRF] ep5 map5 sunglasses redeemed amount=1 npcChanged=true standardReward=true key=1")
		self:SpawnHeartBubble(map, bubblePos)
	end

	@ExecSpace("ServerOnly")
	method table GetIconBounds(string ruid)
		if self._iconBounds[ruid] ~= nil then return self._iconBounds[ruid] end
		local sprites = {}
		if _ResourceService:GetTypeAndWait(ruid) == ResourceType.AnimationClip then
			local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
			for _,frame in ipairs(clip.Frames:ToTable()) do table.insert(sprites,frame.FrameSprite) end
		else table.insert(sprites,_ResourceService:LoadSpriteAndWait(ruid)) end
		local left = math.huge local right = -math.huge local bottom = math.huge local top = -math.huge
		for _,sprite in ipairs(sprites) do
			local pivot = sprite.PivotPixel
			left = math.min(left,-pivot.x) right = math.max(right,sprite.Width-pivot.x)
			bottom = math.min(bottom,-pivot.y) top = math.max(top,sprite.Height-pivot.y)
		end
		local bounds = {left,right,bottom,top} self._iconBounds[ruid] = bounds return bounds
	end

	@ExecSpace("ServerOnly")
	method void PrepareQuestIcons()
		local b = self:GetIconBounds("b143965cd0f24ab4bd68833095e6d542")
		_CollectBubbleLogic._monsterByItem.ep5_sunglasses = {"b143965cd0f24ab4bd68833095e6d542",b[1],b[2],b[3],b[4]}
		_CollectBubbleLogic._itemBounds.ep5_sunglasses = self:GetIconBounds("1203307a291c4ca68ac9bb186569699b")
	end

	@ExecSpace("ServerOnly")
	method void ClearBubble()
		-- 떠 있는 말풍선을 지운다
		if self._activeBubble ~= nil and isvalid(self._activeBubble) then
			self._activeBubble:Destroy()
		end
		self._activeBubble = nil
	end

	@ExecSpace("ServerOnly")
	method void ScheduleBubbleDestroy(Entity bubble)
		-- BubbleShowDuration 뒤 자동으로 지운다
		_TimerService:SetTimerOnce(function()
			if isvalid(bubble) then bubble:Destroy() end
			if self._activeBubble == bubble then self._activeBubble = nil end
		end, self.BubbleShowDuration)
	end

	@ExecSpace("ServerOnly")
	method void SpawnHeartBubble(Entity map, Vector3 pos)
		-- 교환 완료 하트 말풍선(GiftBubble)
		self:ClearBubble()
		local bubble = _SpawnService:SpawnByModelId(self.HeartBubbleModelId, "Ep5Map5SunglassesHeart", pos, map)
		if bubble == nil then return end
		_CollectBubbleLogic:ApplyForegroundDepth(bubble)
		self._activeBubble = bubble
		local icon = bubble:GetChildByName("Icon")
		if icon ~= nil and icon.SpriteRendererComponent ~= nil then
			icon.SpriteRendererComponent.SpriteRUID = self.HeartIconRUID
			icon.TransformComponent.Position = self.HeartIconPosition
			icon.TransformComponent.Scale = self.HeartIconScale
			icon.Enable = true
		end
		local count = bubble:GetChildByName("Count")
		if count ~= nil then count.Enable = false end
		self:ScheduleBubbleDestroy(bubble)
	end

	-- GameManager.RestartGame()이 호출 — 새 런에서는 다시 교환 가능하고 목표도 재추첨
	@ExecSpace("ServerOnly")
	method void ResetForNewRun()
		-- Pick one fixed winning scarecrow for this run; retries and NPC touches never reroll it.
		self._winnerPath = "/maps/ep5_map5/" .. self._candidateNames[_UtilLogic:RandomIntegerRange(1,#self._candidateNames)]
		self._generation = self._generation + 1
		self.Redeemed = false self.Found = false
		self.PickedItemId = ""
		self.GiftAmount = 0
		_PlayerInventory:ClearQuestWatch("Ep5Map5Sunglasses")
		self:ClearBubble()
		local map = _EntityService:GetEntityByPath("/maps/ep5_map5")
		if isvalid(map) then
			map:GetChildByName("FolkDecor_223").SpriteRendererComponent.SpriteRUID = self.OriginalRUID
			for _,obj in pairs(map.Children) do local trigger=obj:GetComponent("script.Ep5Map5SunglassesInspectTrigger") if trigger~=nil then trigger:ResetForNewRun() end end
		end
		log("[VRF] ep5 map5 sunglasses reset originalNpc=true winner="..self._winnerPath)
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Reset the quest, restored NPC and all six searchable scarecrows for this run.
		self:ResetForNewRun()
	end

	@ExecSpace("ServerOnly")
	method void OnSearchSuccess(Entity obj, string userId)
		-- A successful timing challenge checks the fixed winner. Empty scarecrows are searched once per run.
		if self.PickedItemId == "" or self.Found or self.Redeemed or not isvalid(obj) then return end
		local trigger = obj:GetComponent("script.Ep5Map5SunglassesInspectTrigger")
		if trigger == nil or not trigger:ValidUser(userId) then return end
		_Ep1TouchEasterEggLogic._used[obj.Path] = true
		if obj.Path ~= self._winnerPath then
			_EasterEggMessageLogic:Miss()
			log("[VRF] ep5 map5 sunglasses empty object="..obj.Name)
			return
		end
		self.Found = true
		local p = obj.TransformComponent.WorldPosition local f = _GameManager:GetGroundFallFor(obj,p)
		_GameManager:GrantLootItemDrop(p,f.x,f.y,"ep5_sunglasses",1)
		_UIToast:ShowMessage("EP5_MAP5_GLASSES_FOUND",userId)
		log("[VRF] ep5 map5 sunglasses found object="..obj.Name.." count=1")
	end

end
