@Logic
script Ep3Map2CollectLogic extends Logic

	-- 에피소드3 map2 이스터에그: object-15_131(Ep3Map2CollectTrigger가 붙은 오브젝트) — 교환(퀘스트) 구조.
	-- Ep2Map1GiftNpcLogic과 동일한 수집 패턴(1번째 클릭에 목표 잡템 무작위 확정 + "아이콘 X 목표수"
	-- 말풍선, 이후 몇 번을 눌러도 목표치를 못 채웠으면 "아이콘 X 남은개수"로 진행상황만 계속 보여줌)을
	-- 그대로 재사용하되 개수만 30→50으로 다르다(유저 지정). 목표 잡템은 에피3 map2(존1~10 = mapIndex
	-- 99~108) 몬스터가 떨어뜨리는 잡템 풀 중 1종을 무작위로 고정한다(GameManager.GetMonsterLootItemId
	-- 참고, 예티/리티 계열이라 map1 89~103과 겹치는 잡템도 있음).
	-- 보상 구조는 유저 지정으로 GiftNpc(스킬 OR 대체 포션)와 다르다 — 하얀 포션(potionType=2)을 항상
	-- 확정 지급하고, 추가로 보유 슬롯 스킬 1개도 강화한다(CardManager.OnCorruptedCentaurKilled와 동일한
	-- "포션 + 스킬 동시지급" 패턴 — 강화할 스킬이 하나도 없으면 스킬 부분만 건너뛰고 포션은 그대로 나감).
	-- "다시하기"/"새로 시작"에서는 GameManager.RestartGame()이 ResetForNewRun()을 호출해 초기화되지만
	-- (다시 도전 가능 + 잡템도 재추첨), "이어하기"는 건드리지 않는다.
	@Sync property boolean Redeemed = false
	@Sync property string PickedItemId = ""

	property integer GiftAmount = 50
	property string HeartIconRUID = "7ecb5769578f4b05808afaad17ee83ac"
	property number BubbleShowDuration = 2.0
	property string BubbleModelId = "giftbubble"
	-- Ep2Map1GiftNpcLogic과 동일한 시작값(1단계) — 유저가 Maker에서 미리보기 배치로 직접 오른쪽/위로
	-- 옮기면(2단계) 그 결과를 여기 반영한다(오브젝트 월드 좌표 기준 상대 오프셋)
	property number BubbleXOffset = -0.7652970
	property number BubbleYOffset = 0.9155867
	property Vector3 HeartIconPosition = Vector3(-0.4361, -0.2908, 0)
	property Vector3 HeartIconScale = Vector3(5.788959, 5.78895855, 1)
	property Vector3 DefaultIconPosition = Vector3(-0.7126, -0.2924, 0)
	property Vector3 DefaultIconScale = Vector3(2.73173356, 2.73173332, 1)
	property string TextFont = "Maple"
	property Color TextOutlineColor = Color(0, 0, 0, 1)
	property number TextOutlineWidth = 0.4188931
	property number TextFaceDilate = 0.3590512
	property Color TextFontColor = Color(1, 1, 1, 1)
	property number TextFontSize = 3
	property Vector2 TextRectSize = Vector2(0.59, 0.45)

	-- 에피3 map2(존1~10) 몬스터 전용 잡템 — GameManager.GetMonsterLootItemId의 [99]~[108] 풀을
	-- 중복 제거해서 고정 목록으로 둔다(맵 전체 어느 존에서든 나올 수 있는 9종)
	property table _map2ItemPool = {
		"jr_yeti_snowball", "dark_jr_yeti_hide", "lity_fur", "paranmini_bean_jelly",
		"dark_lity_fur", "yeti_horn", "dark_yeti_horn", "yeti_pepe_ice_shard",
		"dark_yeti_pepe_ice_shard",
	}

	property any _activeBubble = nil

	-- Ep3Map2CollectTrigger.RequestTouch()가 호출 — 터치된 오브젝트 엔티티를 그대로 받는다
	-- (Logic에 UUID를 property로 박아두면 맵 미로드 시점에 nil이 되는 문제 회피, 다른 이스터에그와 동일 이유)
	@ExecSpace("ServerOnly")
	method void OnObjectTouched(Entity touchedObject)
		if self.Redeemed then return end

		local map = touchedObject.CurrentMap
		if map == nil then return end
		local worldPos = touchedObject.TransformComponent.WorldPosition
		local bubblePos = Vector3(worldPos.x + self.BubbleXOffset, worldPos.y + self.BubbleYOffset, worldPos.z - 0.5)

		if self.PickedItemId == "" then
			self.PickedItemId = self._map2ItemPool[_UtilLogic:RandomIntegerRange(1, #self._map2ItemPool)]
		end

		local have = _PlayerInventory:GetItemCount(self.PickedItemId)
		if have < self.GiftAmount then
			local remaining = self.GiftAmount - have
			local itemDef = _PlayerInventory:GetItemDef(self.PickedItemId)
			self:SpawnBubble(map, bubblePos, itemDef.icon, "X" .. remaining, true, 1.0, self.DefaultIconPosition, self.DefaultIconScale)
			log("Ep3Map2Collect: still collecting - " .. self.PickedItemId .. " (" .. have .. "/" .. self.GiftAmount .. ", " .. remaining .. " left)")
			return
		end

		self.Redeemed = true
		_PlayerInventory:RemoveItem(self.PickedItemId, self.GiftAmount)

		local fall = self:ComputeDropFall(touchedObject)
		local fallHeight = fall.x
		local groundWorldY = fall.y

		-- 하얀 포션은 스킬 유무와 무관하게 항상 지급(유저 지정)
		_GameManager:ApplyPotionDrop(2, worldPos, fallHeight, groundWorldY, 1.0)

		local pool = _CardManager:BuildActiveUpgradePool()
		if #pool > 0 then
			_CardManager:GrantCardUpgradesFromPool(pool, worldPos, fallHeight, groundWorldY, 1.0, 1, 0)
			log("Ep3Map2Collect: redeemed " .. self.PickedItemId .. " x" .. self.GiftAmount .. " for white potion + 1 card upgrade")
		else
			log("Ep3Map2Collect: redeemed " .. self.PickedItemId .. " x" .. self.GiftAmount .. " for white potion (no upgradeable skill)")
		end

		self:SpawnBubble(map, bubblePos, self.HeartIconRUID, "", false, 1.0, self.HeartIconPosition, self.HeartIconScale)
	end

	-- 보상 낙하 연출용 착지 좌표를 실측 대신 매번 레이캐스트로 구한다(Ep2Map2SkillChestLogic.ComputeDropFall과
	-- 동일 로직 재사용 — MonsterAI.mlua의 비행형 몬스터 사망 처리와 같은 방식)
	@ExecSpace("ServerOnly")
	method Vector3 ComputeDropFall(Entity refEntity)
		-- 반환: [1]=fallHeight(UI px 근사, 낙하 연출 시간/회전량용), [2]=groundWorldY(실제 착지 월드 Y)
		local worldPos = refEntity.TransformComponent.WorldPosition
		local fallHeight = 0
		local groundWorldY = worldPos.y
		local map = refEntity.CurrentMap
		if map ~= nil then
			---@type FootholdComponent
			local foothold = map:GetComponent("FootholdComponent")
			if foothold ~= nil then
				local hits = foothold:RaycastAll(Vector2(worldPos.x, worldPos.y), Vector2(0, -1), 50)
				local groundY = nil
				local bestDist = nil
				for i = 1, #hits do
					local h = hits[i]
					local y = h:GetYByX(worldPos.x)
					local dist = worldPos.y - y
					if bestDist == nil or dist < bestDist then
						bestDist = dist
						groundY = y
					end
				end
				if groundY ~= nil and worldPos.y > groundY then
					fallHeight = (worldPos.y - groundY) * 100
					groundWorldY = groundY
				end
			end
		end
		return Vector3(fallHeight, groundWorldY, 0)
	end

	-- 말풍선(GiftBubble.model)을 스폰하고 아이콘/텍스트를 채운 뒤 BubbleShowDuration 후 파괴한다.
	-- Ep2Map1GiftNpcLogic.SpawnBubble과 동일 구현(순서/깜빡임 방지 이유 동일)
	@ExecSpace("ServerOnly")
	method void SpawnBubble(Entity map, Vector3 pos, string iconRuid, string text, boolean showText, number scale, Vector3 iconPos, Vector3 iconScale)
		if self._activeBubble ~= nil and isvalid(self._activeBubble) then
			self._activeBubble:Destroy()
			self._activeBubble = nil
		end
		local bubble = _SpawnService:SpawnByModelId(self.BubbleModelId, "Ep3Map2CollectBubble", pos, map)
		if bubble == nil then
			log_error("Ep3Map2Collect: GiftBubble spawn failed")
			return
		end
		self._activeBubble = bubble

		local baseScale = bubble.TransformComponent.Scale
		bubble.TransformComponent.Scale = Vector3(baseScale.x * scale, baseScale.y * scale, baseScale.z)

		local icon = bubble:GetChildByName("Icon")
		if icon ~= nil and icon.SpriteRendererComponent ~= nil then
			icon.SpriteRendererComponent.SpriteRUID = iconRuid
			icon.TransformComponent.Position = iconPos
			icon.TransformComponent.Scale = iconScale
			icon.Enable = true
		end

		local count = bubble:GetChildByName("Count")
		if count ~= nil then
			local textRenderer = count.TextRendererComponent
			if textRenderer ~= nil then
				textRenderer.Text = text
				textRenderer.Font = self.TextFont
				textRenderer.FontColor = self.TextFontColor
				textRenderer.FontSize = self.TextFontSize
				textRenderer.OutlineColor = self.TextOutlineColor
				textRenderer.OutlineWidth = self.TextOutlineWidth
				textRenderer.FaceDilate = self.TextFaceDilate
				textRenderer.RectSize = self.TextRectSize
				textRenderer.Wrapping = false
			end
			count.Enable = showText
		end

		_TimerService:SetTimerOnce(function()
			if isvalid(bubble) then bubble:Destroy() end
			if self._activeBubble == bubble then self._activeBubble = nil end
		end, self.BubbleShowDuration)
	end

	-- GameManager.RestartGame()이 호출 — 새 런에서는 다시 교환 도전 가능하고, 잡템 목표도 재추첨된다
	@ExecSpace("ServerOnly")
	method void ResetForNewRun()
		self.Redeemed = false
		self.PickedItemId = ""
		if self._activeBubble ~= nil and isvalid(self._activeBubble) then
			self._activeBubble:Destroy()
		end
		self._activeBubble = nil
	end

end
