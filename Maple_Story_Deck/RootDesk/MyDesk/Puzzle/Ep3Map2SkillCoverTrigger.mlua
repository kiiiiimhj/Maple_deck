@Component
script Ep3Map2SkillCoverTrigger extends Component

	-- 에피소드3 map2 이스터에그 — object-15_127(가리개)에 부착. 클릭할 때마다
	-- Ep3Map2SkillCoverLogic.OnCoverClicked()를 호출한다(알파 0.5씩 감소, 0되면 사라지고 뒤의
	-- object-15_133이 클릭 가능해짐). Ep3Map1SkillCoverTrigger와 동일한 단순 클릭 패턴.
	property any _touchHandler = nil

	method void OnBeginPlay()
		if self:IsClient() then
			self._touchHandler = self.Entity:ConnectEvent(TouchEvent, self.OnTouched)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		if _GameManager.GameOver then return end
		if _TitleUI.titleGroup.Enable then return end
		if _Ep3Map2SkillCoverLogic.CoverCleared then return end
		self:RequestClick()
	end

	@ExecSpace("Server")
	method void RequestClick()
		_Ep3Map2SkillCoverLogic:OnCoverClicked()
	end

	method void OnEndPlay()
		if self:IsClient() then
			if self._touchHandler ~= nil then self.Entity:DisconnectEvent(TouchEvent, self._touchHandler) end
		end
	end

end
