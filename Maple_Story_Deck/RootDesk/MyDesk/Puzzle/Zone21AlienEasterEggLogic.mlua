@Logic
script Zone21AlienEasterEggLogic extends Logic

	-- 존21 이스터에그: object-2737(Zone21AlienObjectTrigger가 붙은 터치 오브젝트)을 2번 터치하면
	-- "외계인의 습격" 토스트와 함께 뉴그레이 화이트(비행형, 공격모션 있음) 7마리가 등장한다.
	-- 1회성이지만 오브젝트 자체는 사라지지 않는다(Enable/Visible을 건드리지 않음) — Triggered 플래그로만 막는다.
	-- "다시하기"/"새로 시작"에서는 GameManager.RestartGame()이 ResetForNewRun()을 호출해 다시 도전할 수 있게
	-- 초기화되지만, "이어하기"(ContinueGame)는 이 플래그를 건드리지 않으므로 같은 런 안에서는 다시 실행되지 않는다.
	@Sync property boolean Triggered = false
	property integer _touchCount = 0

	property string AlienStandRUID = "d4ae577677034eaaa0b902e3c20edf15"
	property string AlienHitRUID = "3a7a801833a5499da7cb3c47034860ba"
	property string AlienDieRUID = "b20afa308a3c46949aa4555d480257a0"
	property number AlienDieDuration = 1.45
	property string AlienAttackRUID = "5dc23024fff6431ea8699ff131b5c784"
	property integer AlienCount = 7
	property integer AlienZoneIndex = 21
	-- ⚠ 버그 수정(2026-08-27, Ep3Map3PunkoEasterEggLogic 개발 중 자체 발견) — 원래는 잡템 드롭이 진짜
	-- 존21 몬스터 풀(믹스골렘 등)과 섞이지 않도록 InitializeAlienInvader에 실존 mapIndex와 안 겹치는
	-- 가상 음수 zoneIndex(과거 AlienLootZoneIndex=-121)를 넘겼었다. 그런데 이 값이 MonsterAI.
	-- SetSpawnZone을 통해 _zoneMonsterRegistry(존별 몬스터 등록/타겟팅 레지스트리)의 키로도 그대로
	-- 쓰인다는 게 실측으로 드러났다 — CardManager.GetMonstersInCurrentZone(모든 카드/스킬 타겟팅의
	-- 단일 진입점, 실제 현재 존 mapIndex로만 조회)이 가상 인덱스로 등록된 이 몬스터들을 절대 못 찾아서,
	-- **플레이어가 뉴그레이 화이트를 공격 자체를 할 수 없는(때리기만 하고 못 잡는) 몬스터**가 되는
	-- 치명적 버그였다([[feedback_arena_map_zoneindex_leak_checklist]] 동일 계열, 라이브 실측으로 확인).
	-- AlienZoneIndex(21)는 이미 실존하는 진짜 mapIndex라 잡템 풀 오염 방지용 별도 가상값 자체가 필요
	-- 없다 — 그냥 AlienZoneIndex를 그대로 넘기도록 수정(잡템은 존21 정상 풀과 섞이지만 무해).

	-- Zone21AlienObjectTrigger.RequestTouch()가 호출
	@ExecSpace("ServerOnly")
	method void OnObjectTouched()
		if self.Triggered then return end
		self._touchCount = self._touchCount + 1
		log("Zone21AlienEasterEgg: touch " .. self._touchCount .. "/2")
		if self._touchCount < 2 then return end

		self.Triggered = true
		self:SpawnAlienWave()
		_UIToast:ShowMessage("외계인의 습격이 일어납니다!")
		log("Zone21AlienEasterEgg: triggered!")
	end

	@ExecSpace("ServerOnly")
	method void SpawnAlienWave()
		local map = _MonsterSpawner:GetZoneEntity(self.AlienZoneIndex)
		if map == nil then
			log_error("Zone21AlienEasterEgg: zone entity not found")
			return
		end
		local offsetX = _MonsterSpawner:GetZoneOffsetX(self.AlienZoneIndex)
		-- 현재 난이도 기준 체력/속도로 스케일해서, 이스터에그를 언제 발견하든 그 시점 난이도에 맞게 나온다.
		-- 2026-08-03 3차 재설계: 순수 시간 단계 기반(GetTimeStep/GetTimeStepHp)으로 되돌림
		local hp = _GameManager:GetTimeStepHp(_GameManager:GetTimeStep())
		local speed = _GameManager:GetWaveApproachSpeed(_GameManager.Wave)

		for i = 1, self.AlienCount do
			-- 비행형 스폰 공식(MonsterSpawner.GetSpawnPosition 존7+ 비행형 분기와 동일) 재사용
			local fx = (_UtilLogic:RandomDouble() * 10) - 5 + offsetX
			local fy = _MonsterSpawner.FlyingMinY + _UtilLogic:RandomDouble() * (_MonsterSpawner.FlyingMaxY - _MonsterSpawner.FlyingMinY)
			local worldPos = Vector3(fx, fy, 0)
			local localPos = _MonsterSpawner:ToLocalSpawnPos(map, worldPos)

			local entity = _SpawnService:SpawnByModelId(_MonsterSpawner.MonsterModelId, "AlienInvader", localPos, map)
			if entity == nil then
				log_error("Zone21AlienEasterEgg: SpawnByModelId failed")
			else
				---@type MonsterAI
				local ai = entity:GetComponent("script.MonsterAI")
				if ai ~= nil then
					ai:InitializeAlienInvader(self.AlienZoneIndex, hp, speed, self.AlienStandRUID, self.AlienHitRUID, self.AlienDieRUID, self.AlienDieDuration, self.AlienAttackRUID)
				end
			end
		end
		log("Zone21AlienEasterEgg: spawned " .. self.AlienCount .. " alien invaders")
	end

	-- GameManager.RestartGame()이 호출 — 새 런에서는 오브젝트를 다시 두 번 눌러 재도전할 수 있다
	@ExecSpace("ServerOnly")
	method void ResetForNewRun()
		self.Triggered = false
		self._touchCount = 0
	end

end
