@Logic
script InspectChallengeLogic extends Logic

	-- 돋보기 타이밍 도전(MushroomInspectChallenge)이 여러 이스터에그에 붙어도(2026-10-24 유저 지정)
	-- 화면 UI는 하나라 한 번에 한 오브젝트만 열리게 하고, 돋보기 벡터 그림은 클라에서 한 번만 그린다.
	property string _activePath = ""
	property boolean _artReady = false

	@ExecSpace("ServerOnly")
	method boolean TryClaim(string path)
		-- 다른 오브젝트 도전이 열려 있으면 거절한다
		if self._activePath ~= "" and self._activePath ~= path then return false end
		self._activePath = path
		return true
	end

	@ExecSpace("ServerOnly")
	method void Release(string path)
		-- 자기 도전만 풀 수 있다
		if self._activePath == path then self._activePath = "" end
	end

	@ExecSpace("ClientOnly")
	method boolean ClaimArt()
		-- 처음 부른 컴포넌트만 true를 받아 그림을 그린다
		if self._artReady then return false end
		self._artReady = true
		return true
	end
end
