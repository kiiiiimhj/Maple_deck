@Logic
script Ep2Map2FlipPotionLogic extends Logic

	-- 에피소드2 map2(여신 탑) 이스터에그 — MapObject_230(Scale.x=-1로 뒤집혀 있는 오브젝트)을 클릭하면
	-- Scale.x를 1로 바꿔서 원래 방향으로 고정하고(다시 클릭해도 안 바뀜), 흰 포션(potionType=2)을
	-- 확률 없이 확정 지급한다(GameManager.ApplyPotionDrop, Ep2Map2SkillChestLogic과 동일 패턴).
	@Sync property boolean Triggered = false

	property string TargetObjectPath = "/maps/ep2_map2/MapObject_230"

	-- GameManager.ApplyPotionDrop의 potionType — 2=흰색(White) 포션
	property integer PotionType = 2

	property any _startScale = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		local target = _EntityService:GetEntityByPath(self.TargetObjectPath)
		if target ~= nil then
			self._startScale = target.TransformComponent.Scale
		else
			log_error("Ep2Map2FlipPotion: target entity not found at " .. self.TargetObjectPath)
		end
	end

	-- 버그 수정(2026-08-22, 유저 지적) — MonsterAI.mlua 비행형 몬스터 사망 처리와 동일한 방식으로 아래로
	-- 레이캐스트해서 실제 발판 높이까지 낙하 연출이 나오게 한다([[project_ep2map2_skillchest_easteregg]]
	-- GrantReward의 ComputeDropFall과 동일한 로직 — 서로 다른 Logic이라 공유 불가, 그대로 복제).
	@ExecSpace("ServerOnly")
	method Vector3 ComputeDropFall(Entity refEntity)
		local worldPos = refEntity.TransformComponent.WorldPosition
		local fallHeight = 0
		local groundWorldY = worldPos.y
		local map = refEntity.CurrentMap
		if map ~= nil then
			---@type FootholdComponent
			local foothold = map:GetComponent("FootholdComponent")
			if foothold ~= nil then
				local hits = foothold:RaycastAll(Vector2(worldPos.x, worldPos.y), Vector2(0, -1), 50)
				local groundY = nil
				local bestDist = nil
				for i = 1, #hits do
					local h = hits[i]
					local y = h:GetYByX(worldPos.x)
					local dist = worldPos.y - y
					if bestDist == nil or dist < bestDist then
						bestDist = dist
						groundY = y
					end
				end
				if groundY ~= nil and worldPos.y > groundY then
					fallHeight = (worldPos.y - groundY) * 100
					groundWorldY = groundY
				end
			end
		end
		return Vector3(fallHeight, groundWorldY, 0)
	end

	-- Ep2Map2FlipPotionTrigger.RequestTouch()가 호출 — 클릭된 오브젝트 엔티티를 그대로 받는다
	@ExecSpace("ServerOnly")
	method void OnObjectTouched(Entity obj)
		if self.Triggered then return end
		if not isvalid(obj) then return end

		self.Triggered = true
		local scale = obj.TransformComponent.Scale
		obj.TransformComponent.Scale = Vector3(1, scale.y, scale.z)
		log("Ep2Map2FlipPotion: flipped to Scale.x=1, granting white potion")

		local fall = self:ComputeDropFall(obj)
		local worldPos = obj.TransformComponent.WorldPosition
		_GameManager:ApplyPotionDrop(self.PotionType, worldPos, fall.x, fall.y, 1.0)
		-- 유저 지정: 이 토스트 메세지는 제거(2026-08-22, "필요없음")
	end

	-- GameManager.RestartGame()이 호출 — 새 런에서는 다시 뒤집힌 상태로 되돌려 재도전할 수 있게 한다
	@ExecSpace("ServerOnly")
	method void ResetForNewRun()
		self.Triggered = false
		local target = _EntityService:GetEntityByPath(self.TargetObjectPath)
		if target ~= nil and isvalid(target) and self._startScale ~= nil then
			target.TransformComponent.Scale = self._startScale
		end
	end

end
