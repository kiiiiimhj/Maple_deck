@Component
script Ep3Map2SkillRewardTrigger extends Component

	-- 에피소드3 map2 이스터에그 — object-15_133(가리개 뒤에 숨은 보상 오브젝트)에 부착. 가리개
	-- (object-15_127)의 알파가 0이 되기 전까지는 클릭을 무시한다. 가리개 쪽
	-- TouchReceiveComponent.RelayEventToBehind=false로 물리적으로도 막혀있지만, 이 스크립트에서도
	-- CoverCleared 플래그로 한 번 더 방어한다(Ep3Map1SkillRewardTrigger와 동일 패턴). 클릭되면
	-- Ep3Map2SkillCoverLogic.OnRewardClicked()가 보유 슬롯 스킬 강화(없으면 확정 포션)를 지급한다.
	property any _touchHandler = nil

	method void OnBeginPlay()
		if self:IsClient() then
			self._touchHandler = self.Entity:ConnectEvent(TouchEvent, self.OnTouched)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		if _GameManager.GameOver then return end
		if _TitleUI.titleGroup.Enable then return end
		if not _Ep3Map2SkillCoverLogic.CoverCleared then return end
		if _Ep3Map2SkillCoverLogic.Triggered then return end
		self:RequestClick()
	end

	@ExecSpace("Server")
	method void RequestClick()
		_Ep3Map2SkillCoverLogic:OnRewardClicked()
	end

	method void OnEndPlay()
		if self:IsClient() then
			if self._touchHandler ~= nil then self.Entity:DisconnectEvent(TouchEvent, self._touchHandler) end
		end
	end

end
