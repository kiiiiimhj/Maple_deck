@Logic
script Ep4EasterEggUI extends Logic
	-- 퀴즈/기부 공용 나무 팝업. 문구는 이미지에 넣지 않고 네 언어 번역 키를 사용한다.
	property Entity popupGroup = "51b07701-6550-4311-ba7f-cf99d673dfac"
	property Entity quizPanel = "670506c1-c45d-4561-93ea-9c81387ba420"
	property Entity donatePanel = "ba9de357-070c-4019-8237-65af27beff56"
	property integer _session = 0
	property integer _revision = 0
	property boolean _pending = false
	property boolean _open = false
	property string _mode = ""
	property integer _question = 0
	property integer _step = 0
	property boolean _failed = false
	property integer _donateStep = 0
	property integer _cost = 0
	property integer _gold = 0
	property string _locale = ""
	-- 퀴즈를 연 쪽: "ep4"(루디브리엄) 또는 "map18"(에피1 직업 퀴즈, 2026-10-05). 답/재도전/닫기를 그쪽으로 보낸다
	property string _owner = "ep4"
	property string _questionPrefix = "EP4_QUIZ_Q"
	property table _connections = {}
	property string GreenButtonRUID = "93fd99637232481b8565d2135945bd7e"
	property string GrayButtonRUID = "6a34f87232c649cfaa6d770aae45e293"
	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 정적 버튼은 한 번 연결하고 시작 화면에서는 팝업을 숨긴다.
		self.popupGroup.Enable=false
		self:Bind(self.quizPanel:GetChildByName("BtnTrue"),function() self:Answer(true) end)
		self:Bind(self.quizPanel:GetChildByName("BtnFalse"),function() self:Answer(false) end)
		self:Bind(self.quizPanel:GetChildByName("BtnRetry"),function()
			if self._pending then return end
			self._pending=true
			if self._owner=="map18" then _Map18JobQuizLogic:RequestRetry(self._session,self._revision)
			else _Ep4Map1EasterEggLogic:RequestRetry(self._session,self._revision) end
		end)
		self:Bind(self.quizPanel:GetChildByName("BtnClose"),function() self:Cancel() end)
		self:Bind(self.donatePanel:GetChildByName("BtnClose"),function() self:Cancel() end)
		self:Bind(self.donatePanel:GetChildByName("BtnNo"),function() self:Cancel() end)
		self:Bind(self.donatePanel:GetChildByName("BtnYes"),function()
			if self._pending then return end
			self._pending=true _Ep4Map1EasterEggLogic:RequestDonate(self._session,self._revision)
		end)
		log("Ep4EggUI: ready localized quiz and donation")
	end
	@ExecSpace("ClientOnly")
	method void Bind(Entity entity, any action)
		-- 공통 클릭음과 해제 가능한 연결 목록을 사용한다.
		local h=entity:ConnectEvent(ButtonClickEvent,function()
			_SoundService:PlaySound("972843e759204d3e9ad84e7d3fa94f83",0.4) action()
		end)
		table.insert(self._connections,{entity=entity,eventHandler=h})
	end
	@ExecSpace("Client")
	method void ShowQuiz(integer session, integer revision, integer question, integer step, boolean failed)
		-- 서버가 새 문제를 내려준 뒤에만 다음 입력을 받는다.
		self._owner="ep4" self._questionPrefix="EP4_QUIZ_Q"
		self:OpenQuiz(session,revision,question,step,failed)
	end
	@ExecSpace("Client")
	method void ShowJobQuiz(integer session, integer revision, integer question, integer step, boolean failed)
		-- 에피1 map18 직업 퀴즈(Map18JobQuizLogic) — 같은 팝업, 문제 키만 MAP18_QUIZ_Q
		self._owner="map18" self._questionPrefix="MAP18_QUIZ_Q"
		self:OpenQuiz(session,revision,question,step,failed)
	end
	@ExecSpace("ClientOnly")
	method void OpenQuiz(integer session, integer revision, integer question, integer step, boolean failed)
		-- 퀴즈 팝업 공통 표시
		self._session=session self._revision=revision self._question=question self._step=step self._failed=failed
		self._pending=false self._open=true self._mode="quiz"
		self.popupGroup.Enable=true self.quizPanel.Enable=true self.donatePanel.Enable=false
		self:RefreshTexts()
		log("Ep4EggUI: quiz owner=" .. self._owner .. " step=" .. step .. " q=" .. question .. " failed=" .. tostring(failed))
	end
	@ExecSpace("ClientOnly")
	method void Answer(boolean answer)
		-- 빠른 두 번 클릭은 서버 응답 전에도 막는다.
		if self._pending or self._failed then return end
		self._pending=true
		if self._owner=="map18" then _Map18JobQuizLogic:RequestAnswer(self._session,self._revision,answer)
		else _Ep4Map1EasterEggLogic:RequestAnswer(self._session,self._revision,answer) end
	end
	@ExecSpace("Client")
	method void ShowDonation(integer session, integer revision, integer step, integer cost, integer gold)
		-- 회색도 클릭은 가능하게 남겨 부족 안내를 서버에서 띄운다.
		self._session=session self._revision=revision self._donateStep=step self._cost=cost self._gold=gold
		self._pending=false self._open=true self._mode="donate" self._owner="ep4"
		self.popupGroup.Enable=true self.quizPanel.Enable=false self.donatePanel.Enable=true
		self:RefreshTexts()
	end
	@ExecSpace("ClientOnly")
	method void Cancel()
		-- 서버가 모달을 닫는 동안 연타 입력을 막고, 정지 해제는 서버가 담당한다.
		if self._pending then return end
		self._pending=true
		if self._owner=="map18" then _Map18JobQuizLogic:RequestCancel(self._session)
		else _Ep4Map1EasterEggLogic:RequestCancel(self._session) end
	end
	@ExecSpace("Client")
	method void HideModal(integer session)
		-- 지난 세션의 늦은 닫기 응답이 새 팝업을 지우지 않는다.
		if session~=self._session then return end
		self._open=false self._pending=false self._mode="" self.popupGroup.Enable=false
	end
	@ExecSpace("ClientOnly")
	method void RefreshTexts()
		-- 현재 언어에 맞춰 제목/문제/설명/버튼을 모두 직접 번역한다.
		self._locale=_LocalizationService.CurrentLocaleId
		local tr=_LocalizationService:GetTranslatorForLocale(self._locale)
		local p=self._mode=="quiz" and self.quizPanel or self.donatePanel
		p:GetChildByName("Title").TextGUIRendererComponent.Text=tr:GetText(self._mode=="quiz" and "EP4_QUIZ_TITLE" or "EP4_DONATE_TITLE")
		if self._mode=="quiz" then
			p:GetChildByName("Progress").TextGUIRendererComponent.Text=tr:GetTextFormat("EP4_QUIZ_PROGRESS",self._step)
			p:GetChildByName("Question").TextGUIRendererComponent.Text=tr:GetText(self._failed and "EP4_QUIZ_WRONG" or (self._questionPrefix .. self._question))
			p:GetChildByName("Rule").TextGUIRendererComponent.Text=tr:GetText("EP4_QUIZ_RULE")
			p:GetChildByName("BtnTrue").Enable=not self._failed
			p:GetChildByName("BtnFalse").Enable=not self._failed
			p:GetChildByName("BtnRetry").Enable=self._failed
			p:GetChildByName("BtnTrue").TextGUIRendererComponent.Text=tr:GetText("EP4_QUIZ_TRUE")
			p:GetChildByName("BtnFalse").TextGUIRendererComponent.Text=tr:GetText("EP4_QUIZ_FALSE")
			p:GetChildByName("BtnRetry").TextGUIRendererComponent.Text=tr:GetText("EP4_QUIZ_RETRY")
		else
			p:GetChildByName("Question").TextGUIRendererComponent.Text=tr:GetTextFormat("EP4_DONATE_ASK",self._cost)
			p:GetChildByName("Progress").TextGUIRendererComponent.Text=tr:GetTextFormat("EP4_DONATE_PROGRESS",self._donateStep)
			p:GetChildByName("Gold").TextGUIRendererComponent.Text=tr:GetTextFormat("EP4_DONATE_GOLD",self._gold)
			p:GetChildByName("Rule").TextGUIRendererComponent.Text=tr:GetText("EP4_DONATE_RULE")
			local yes=p:GetChildByName("BtnYes")
			yes.SpriteGUIRendererComponent.ImageRUID=self._gold>=self._cost and self.GreenButtonRUID or self.GrayButtonRUID
			yes.TextGUIRendererComponent.Text=tr:GetText("EP4_DONATE_YES")
			p:GetChildByName("BtnNo").TextGUIRendererComponent.Text=tr:GetText("EP4_DONATE_NO")
		end
	end
	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 열려 있는 중 언어/보유 골드가 바뀌면 회색/초록 상태를 갱신한다.
		if not self._open then return end
		if self._locale~=_LocalizationService.CurrentLocaleId then self:RefreshTexts() end
		if self._mode=="donate" and self._gold~=_GameManager.TotalCoins then self._gold=_GameManager.TotalCoins self:RefreshTexts() end
	end
	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 세션이 끝나면 모든 버튼 연결과 열린 UI를 정리한다.
		for _,rec in ipairs(self._connections) do if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent,rec.eventHandler) end end
		self._connections={} self._open=false
		if isvalid(self.popupGroup) then self.popupGroup.Enable=false end
	end
end
