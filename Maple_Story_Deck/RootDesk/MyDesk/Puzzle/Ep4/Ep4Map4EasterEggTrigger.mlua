@Component
script Ep4Map4EasterEggTrigger extends Component
	property integer EggNumber = 1
	property any _touchHandler = nil
	method void OnBeginPlay()
		if self:IsClient() then self._touchHandler=self.Entity:ConnectEvent(TouchEvent,self.OnTouched) end
	end
	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		if _GameManager.GameOver or not _GameManager.GameStarted or _GameManager:IsGamePaused() then return end
		if _TitleUI.titleGroup.Enable or _CardManager:IsMonsterUnderTouch(event.TouchPoint) then return end
		-- 돋보기 도전이 붙어 있으면(2026-10-24 유저 지정) 도전부터, 성공해야 원래 판정을 탄다
		if self.Entity:GetComponent("script.MushroomInspectChallenge")~=nil then self:RequestInspect() else self:RequestTouch() end
	end
	@ExecSpace("Server")
	method void RequestTouch()
		_Ep4Map4EasterEggLogic:OnObjectTouched(self.EggNumber,self.Entity,senderUserId)
	end
	@ExecSpace("Server")
	method void RequestInspect()
		local inspect=self.Entity:GetComponent("script.MushroomInspectChallenge")
		if inspect~=nil then inspect:BeginForUser(senderUserId) end
	end
	@ExecSpace("ServerOnly")
	method boolean IsInspectAvailable()
		return _Ep4Map4EasterEggLogic:IsEggAvailable(self.EggNumber)
	end
	@ExecSpace("ServerOnly")
	method void OnInspectSuccess(string userId)
		_Ep4Map4EasterEggLogic:OnInspectSuccess(self.EggNumber,self.Entity,userId)
	end
	method void OnEndPlay()
		if self:IsClient() and self._touchHandler~=nil then self.Entity:DisconnectEvent(TouchEvent,self._touchHandler) end
	end
end
