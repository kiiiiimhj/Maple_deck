@Component
script Ep4EasterEggTrigger extends Component
	-- 기존 오브젝트 위치/그림을 유지한 채 월드 터치만 연결한다.
	property integer EggNumber = 1
	property any _touchHandler = nil
	method void OnBeginPlay()
		-- 클라이언트 터치를 서버 검증 경로로 전달한다.
		if self:IsClient() then self._touchHandler=self.Entity:ConnectEvent(TouchEvent,self.OnTouched) end
	end
	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		-- 모달/로비/게임오버 뒤 클릭과 몬스터에 겹친 터치를 막는다.
		if _GameManager.GameOver or not _GameManager.GameStarted or _GameManager:IsGamePaused() then return end
		if _TitleUI.titleGroup.Enable or _CardManager:IsMonsterUnderTouch(event.TouchPoint) then return end
		self:RequestTouch()
	end
	@ExecSpace("Server")
	method void RequestTouch()
		-- 호출자와 실제 엔티티를 전달한다. 클라이언트가 다른 오브젝트를 지정할 수 없다.
		_Ep4Map1EasterEggLogic:OnObjectTouched(self.EggNumber,self.Entity,senderUserId)
	end
	method void OnEndPlay()
		-- 맵 재입장 때 중복 연결을 남기지 않는다.
		if self:IsClient() and self._touchHandler~=nil then self.Entity:DisconnectEvent(TouchEvent,self._touchHandler) end
	end
end
