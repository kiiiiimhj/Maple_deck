@Component
script Ep4BenoaArenaTrigger extends Component
	property string Role = "seal"
	property any _touchHandler = nil

	method void OnBeginPlay()
		if self:IsClient() then self._touchHandler=self.Entity:ConnectEvent(TouchEvent,self.OnTouched) end
	end

	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		if not _GameManager.GameStarted or _GameManager.GameOver or _TitleUI.titleGroup.Enable then return end
		if self.Role=="return" and _GameManager:IsGamePaused() then return end
		-- 봉인 획득 대기 중에는 전투가 멈춰 있어도 봉인 터치는 받는다.
		if self.Role~="return" and (not _Ep4PapulatusLogic.SealWaiting or _Ep4PapulatusLogic.SealOpening) then return end
		self:RequestTouch()
	end

	@ExecSpace("Server")
	method void RequestTouch()
		if self.Role=="return" then _Ep4PapulatusLogic:OnReturnPortalTouched(self.Entity,senderUserId)
		else _Ep4PapulatusLogic:OnSealTouched(self.Entity,senderUserId) end
	end

	method void OnEndPlay()
		if self:IsClient() and self._touchHandler~=nil then self.Entity:DisconnectEvent(TouchEvent,self._touchHandler) self._touchHandler=nil end
	end
end
