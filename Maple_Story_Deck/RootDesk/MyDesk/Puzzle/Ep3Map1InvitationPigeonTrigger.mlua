@Component
script Ep3Map1InvitationPigeonTrigger extends Component

	-- 에피소드4 map1 이스터에그(선행 작업, ep3_map1에 배치) — MapObject_111에 부착. 초대권
	-- (ep4_invitation_ticket)을 보유한 상태에서 클릭하면 Ep3Map1InvitationEasterEggLogic.
	-- OnPigeonObjectTouched()가 비둘기를 스폰해 11시 방향 화면 밖으로 날려보내고 안내 메세지를
	-- 띄운다. 초대권이 없으면 Logic에서 경고 토스트만 띄우고 무시한다.
	property any _touchHandler = nil

	method void OnBeginPlay()
		if self:IsClient() then
			self._touchHandler = self.Entity:ConnectEvent(TouchEvent, self.OnTouched)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		if _GameManager.GameOver then return end
		if _TitleUI.titleGroup.Enable then return end
		self:RequestClick()
	end

	@ExecSpace("Server")
	method void RequestClick()
		_Ep3Map1InvitationEasterEggLogic:OnPigeonObjectTouched(self.Entity)
	end

	method void OnEndPlay()
		if self:IsClient() then
			if self._touchHandler ~= nil then self.Entity:DisconnectEvent(TouchEvent, self._touchHandler) end
		end
	end

end
