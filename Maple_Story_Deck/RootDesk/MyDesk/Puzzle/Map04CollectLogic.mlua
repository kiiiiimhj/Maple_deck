@Logic
script Map04CollectLogic extends Logic

	-- 에피1 map04 존6 이스터에그(유저 지정 2026-09-30): object-1917_1(초조하게 좌우로 왔다갔다하는 NPC,
	-- Map04CollectTrigger) — 누르면 "몬스터 그림 → 그 몬스터 잡템 X30" 말풍선. 다른 잡템 이스터에그
	-- (Ep3Map2CollectLogic)와 같은 교환 구조: 1번째 클릭에 목표(몬스터+잡템) 무작위 확정, 못 채운 동안은
	-- "X남은개수"로 진행상황, 다 모아서 누르면 잡템 30개를 가져가고 보상.
	-- 목표 풀 = 에피1 map04 전체(존4~6, 4종) + map07 전체(존7~10, 7종 — 존10은 존9 풀 재사용, 보너스 보스 제외)
	--   (유저 정정 2026-09-30 "4맵 전체, 7맵 전체" — 처음엔 존3 웨이브 종까지 넣었다가 뺐다).
	--   잡템은 GameManager.GetMonsterLootItemId, 그림은 GetWaveStandRUID/GetZoneStandRUID/GetMapStandRUID와 같은 값.
	-- 보상(유저 지정): **계정 최초 1회**는 유물 무료 뽑기권 1장(유저별 저장소 키 Map04Collect.FirstReward),
	--   그 뒤 런부터는 다른 이스터에그와 동일 — 하얀 포션 + 보유 스킬 1개 강화 + 덤(EasterEggBonusLogic).
	-- "다시하기"/"새로 시작"은 GameManager.RestartGame()이 ResetForNewRun()으로 초기화(목표 재추첨).
	@Sync property boolean Redeemed = false
	@Sync property integer PickedIdx = 0

	property integer GiftAmount = 30
	property string FirstRewardStorageKey = "Map04Collect.FirstReward"
	property integer FirstRewardRelicPulls = 1
	property string RelicPullIconRUID = "3fccc38bffbd45b68cd1fc049809de54"
	-- 교환할 때마다 같이 주는 열쇠(존12 잠긴 상자용, PlayerInventory old_chest_key)
	property string RewardKeyItemId = "old_chest_key"

	-- 말풍선 모양/칸 크기는 공용 CollectBubbleLogic(다른 잡템 퀘스트와 같은 규격). 여기선 위치만
	property number BubbleXOffset = -1.25
	property number BubbleYOffset = 1.25
	property number BubbleShowDuration = 2.0

	-- 교환 완료 하트 말풍선(Ep3Map2CollectLogic과 같은 GiftBubble 값)
	property string HeartBubbleModelId = "giftbubble"
	property string HeartIconRUID = "7ecb5769578f4b05808afaad17ee83ac"
	property Vector3 HeartIconPosition = Vector3(-0.4361, -0.2908, 0)
	property Vector3 HeartIconScale = Vector3(5.788959, 5.78895855, 1)


	-- 목표 후보: {stand 애니메이션 RUID, 잡템 id, 좌, 우, 아래, 위} — 기준점(발끝) 기준 그림 외곽 px(모든 프레임 합집합, msw-search 실측)
	property table _targets = {
		{"d6bf82f05b5441dcbcb77171b5b8f7b5", "fox_tail", -53, 35, 0, 72},             -- 음흉한 여우(map04 = 존4~6)
		{"53f5e84a36444f6a92ae64881ddfa44c", "pig_tail", -43, 33, -2, 56},             -- 이상한 돼지
		{"a95cfed2c8fe4d2cb64cbb62db051f92", "orange_mushroom_cap", -27, 37, 0, 60},  -- 주황버섯
		{"a4e381810620417694ee0f0abe7acb40", "orange_mushroom_cap", -27, 37, 0, 60},  -- 시니컬한 주황버섯
		{"52fc9a75b6174bfa96af66c49dbb3369", "stump_tear", -31, 49, 0, 80},           -- 고스텀프(존7)
		{"9d4f9e8f572548f692438ffa817eb52d", "stump_tear", -31, 33, 0, 76},           -- 엑스텀프
		{"af64c62c1dcf427998c3c52f0a060fec", "old_leather", -51, 39, 0, 52},          -- 와일드보어(존8)
		{"eadfe08070d343a9afafe0fd6290f1c6", "old_leather", -33, 35, 0, 48},          -- 아이언호그
		{"4286356e1f6a4c03a6ef125123a49bbe", "stump_tear", -31, 49, 0, 80},           -- 히죽대는 고스텀프(존9~10)
		{"e6c2fd7213d44cd3a5dd5eed2e8fb1ce", "old_leather", -34, 34, 0, 64},          -- 아이언보어
		{"67523b05f66f470cb86b2c6cc46af861", "old_leather", -59, 43, 0, 68},          -- 파이어보어
	}


	property any _activeBubble = nil

	-- Map04CollectTrigger.RequestTouch()가 터치된 오브젝트 엔티티를 넘긴다(다른 이스터에그와 같은 이유)
	@ExecSpace("ServerOnly")
	method void OnObjectTouched(Entity touchedObject)
		-- 목표 확정 → 모자라면 진행상황 말풍선, 다 모았으면 교환+보상
		if self.Redeemed then return end
		local map = touchedObject.CurrentMap
		if map == nil then return end
		local worldPos = touchedObject.TransformComponent.WorldPosition
		local bubblePos = Vector3(worldPos.x + self.BubbleXOffset, worldPos.y + self.BubbleYOffset, worldPos.z - 0.5)

		-- 처음 누른 순간(목표를 정한 순간)엔 가방에 이미 있어도 "X전체개수" 의뢰 말풍선만 띄운다 — 다시 눌렀을 때 보유 중이면 클리어(유저 지정 2026-10-06, 예전엔 뭔지도 모르고 바로 클리어됐다)
		local firstTap = false
		if self.PickedIdx <= 0 then
			self.PickedIdx = _UtilLogic:RandomIntegerRange(1, #self._targets)
			firstTap = true
		end
		local target = self._targets[self.PickedIdx]
		local itemId = target[2]

		local have = _PlayerInventory:GetItemCount(itemId)
		if firstTap then have = 0 end
		-- 다 모으는 순간 "아이템을 다 모았다!" 토스트(PlayerInventory.WatchQuestItems, 유저 지정 2026-10-06)
		_PlayerInventory:WatchQuestItems("Map04", {itemId}, self.GiftAmount)
		if have < self.GiftAmount then
			local remaining = self.GiftAmount - have
			self:SpawnTargetBubble(map, bubblePos, target, "X" .. remaining)
			log("Map04Collect: still collecting - " .. itemId .. " (" .. have .. "/" .. self.GiftAmount .. ", " .. remaining .. " left)")
			return
		end

		self.Redeemed = true
		_PlayerInventory:RemoveItem(itemId, self.GiftAmount)
		local fall = self:ComputeDropFall(touchedObject)
		local fallHeight = fall.x
		local groundWorldY = fall.y

		if self:TryClaimFirstReward() then
			-- 계정 최초 1회: 유물 무료 뽑기권(Map24TreasureChestLogic 최초 처치 보상과 같은 연출·적립 경로)
			local amount = self.FirstRewardRelicPulls
			-- 이스터에그 뽑기권 12시간 한도(5장)에 이것도 센다(유저 지정 2026-09-30)
			_PullTicketDropLogic:CountExternalGrant(amount)
			_GameManager:ScheduleLootDrop(worldPos, self.RelicPullIconRUID, fallHeight, groundWorldY, function()
				_AttendanceLogic:AddFreePulls(amount, false)
				_RunLootLogic:AddTicket(self.RelicPullIconRUID, amount)
				_UIToast:ShowMessage("FMT_MAP24TREASURECHESTLOGIC_001|" .. tostring(amount))
			end, 1.0)
			log("Map04Collect: redeemed " .. itemId .. " x" .. self.GiftAmount .. " -> FIRST reward relic pulls x" .. amount)
		else
			-- 그 뒤로는 다른 잡템 이스터에그와 동일: 하얀 포션 + 스킬 1개 강화 + 덤
			_GameManager:ApplyPotionDrop(2, worldPos, fallHeight, groundWorldY, 1.0)
			local pool = _CardManager:BuildActiveUpgradePool()
			if #pool > 0 then
				_CardManager:GrantCardUpgradesFromPool(pool, worldPos, fallHeight, groundWorldY, 1.0, 1, 0)
			end
			_EasterEggBonusLogic:RollBonus(worldPos, fallHeight, groundWorldY)
			log("Map04Collect: redeemed " .. itemId .. " x" .. self.GiftAmount .. " -> white potion + card upgrade(pool=" .. #pool .. ") + bonus roll")
		end

		-- 매번 추가 보상: 존12(map11 Zone12) 잠긴 보물상자 열쇠 1개(유저 지정 2026-09-30)
		if self.RewardKeyItemId ~= "" then
			_GameManager:GrantLootItemDrop(worldPos, fallHeight, groundWorldY, self.RewardKeyItemId, 1.0)
		end

		self:SpawnHeartBubble(map, bubblePos)
	end

	@ExecSpace("ServerOnly")
	method boolean TryClaimFirstReward()
		-- 이 계정이 처음 교환하는 거면 표시를 저장하고 true. 저장소 오류면 일반 보상으로(false)
		-- 인스턴스당 플레이어 1명 — 지금 들어와 있는 유저의 저장소를 쓴다(Map24TreasureChestLogic과 동일)
		local storage = nil
		for _, userEntity in pairs(_UserService.UserEntities) do
			if isvalid(userEntity) and userEntity.PlayerComponent ~= nil then
				storage = _DataStorageService:GetUserDataStorage(userEntity.PlayerComponent.ProfileCode)
				break
			end
		end
		if storage == nil then
			log_warning("Map04Collect: no user storage — normal reward")
			return false
		end
		local code, raw = storage:GetAndWait(self.FirstRewardStorageKey)
		if code == 0 and raw ~= nil and raw ~= "" then return false end
		if code ~= 0 and code ~= 1000002 then
			log_warning("Map04Collect: first-reward flag load failed code=" .. tostring(code) .. " — normal reward")
			return false
		end
		local saveCode = storage:SetAndWait(self.FirstRewardStorageKey, "1")
		if saveCode ~= 0 then
			log_warning("Map04Collect: first-reward flag save failed code=" .. tostring(saveCode) .. " — normal reward")
			return false
		end
		return true
	end

	-- 보상 낙하 연출용 착지 좌표(Ep3Map2CollectLogic.ComputeDropFall과 동일)
	@ExecSpace("ServerOnly")
	method Vector3 ComputeDropFall(Entity refEntity)
		-- 반환: x=fallHeight(UI px 근사), y=groundWorldY(실제 착지 월드 Y)
		local worldPos = refEntity.TransformComponent.WorldPosition
		local fallHeight = 0
		local groundWorldY = worldPos.y
		local map = refEntity.CurrentMap
		if map ~= nil then
			---@type FootholdComponent
			local foothold = map:GetComponent("FootholdComponent")
			if foothold ~= nil then
				local hits = foothold:RaycastAll(Vector2(worldPos.x, worldPos.y), Vector2(0, -1), 50)
				local groundY = nil
				local bestDist = nil
				for i = 1, #hits do
					local y = hits[i]:GetYByX(worldPos.x)
					local dist = worldPos.y - y
					if bestDist == nil or dist < bestDist then
						bestDist = dist
						groundY = y
					end
				end
				if groundY ~= nil and worldPos.y > groundY then
					fallHeight = (worldPos.y - groundY) * 100
					groundWorldY = groundY
				end
			end
		end
		return Vector3(fallHeight, groundWorldY, 0)
	end

	@ExecSpace("ServerOnly")
	method void ClearBubble()
		-- 떠 있는 말풍선을 지운다
		if self._activeBubble ~= nil and isvalid(self._activeBubble) then
			self._activeBubble:Destroy()
		end
		self._activeBubble = nil
	end

	@ExecSpace("ServerOnly")
	method void ScheduleBubbleDestroy(Entity bubble)
		-- BubbleShowDuration 뒤 자동으로 지운다
		_TimerService:SetTimerOnce(function()
			if isvalid(bubble) then bubble:Destroy() end
			if self._activeBubble == bubble then self._activeBubble = nil end
		end, self.BubbleShowDuration)
	end

	@ExecSpace("ServerOnly")
	method void SpawnTargetBubble(Entity map, Vector3 pos, table target, string countText)
		-- "몬스터 그림 → 잡템 X남은개수"(공용 CollectBubbleLogic)
		self:ClearBubble()
		local mb = {target[3], target[4], target[5], target[6]}
		local bubble = _CollectBubbleLogic:SpawnQuestBubble(map, pos, "Map04CollectBubble", target[1], mb, target[2], countText, false)
		if bubble == nil then return end
		self._activeBubble = bubble
		self:ScheduleBubbleDestroy(bubble)
	end

	@ExecSpace("ServerOnly")
	method void SpawnHeartBubble(Entity map, Vector3 pos)
		-- 교환 완료 하트 말풍선(GiftBubble, Ep3Map2CollectLogic과 같은 값)
		self:ClearBubble()
		local bubble = _SpawnService:SpawnByModelId(self.HeartBubbleModelId, "Map04CollectHeart", pos, map)
		if bubble == nil then return end
		self._activeBubble = bubble
		local icon = bubble:GetChildByName("Icon")
		if icon ~= nil and icon.SpriteRendererComponent ~= nil then
			icon.SpriteRendererComponent.SpriteRUID = self.HeartIconRUID
			icon.TransformComponent.Position = self.HeartIconPosition
			icon.TransformComponent.Scale = self.HeartIconScale
			icon.Enable = true
		end
		local count = bubble:GetChildByName("Count")
		if count ~= nil then count.Enable = false end
		self:ScheduleBubbleDestroy(bubble)
	end

	-- GameManager.RestartGame()이 호출 — 새 런에서는 다시 교환 가능하고 목표도 재추첨
	@ExecSpace("ServerOnly")
	method void ResetForNewRun()
		self.Redeemed = false
		self.PickedIdx = 0
		_PlayerInventory:ClearQuestWatch("Map04")
		self:ClearBubble()
	end

	-- 테스트 전용: 계정 최초 보상 표시를 지운다(콘솔은 클라 컨텍스트라 Server)
	@ExecSpace("Server")
	method void DebugResetFirstReward()
		for _, userEntity in pairs(_UserService.UserEntities) do
			if isvalid(userEntity) and userEntity.PlayerComponent ~= nil then
				local storage = _DataStorageService:GetUserDataStorage(userEntity.PlayerComponent.ProfileCode)
				storage:SetAsync(self.FirstRewardStorageKey, "", function(code, key) end)
				log("Map04Collect: debug first-reward flag cleared")
				return
			end
		end
	end

end
