@Component
script Ep3Map2BonusPortalTrigger extends Component

	-- ep3_map2의 기존 네이티브 portal-3에 부착(유저 지정: "맵1 비둘기 이스터에그 완료하면 이 포탈이
	-- 생겨, 누르면 보너스 보스있는데로 이동"). 평소엔 Enable=false로 숨겨져 있다가
	-- Ep3Map1InvitationEasterEggLogic.OnPigeonObjectTouched()가 켜준다. 네이티브 PortalComponent의
	-- 자동 워크스루 텔레포트(PortalEntityRef) 대신, 이 프로젝트의 다른 모든 존 이동과 동일하게
	-- "누르면 이동" 방식으로 쓰기 위해 터치 판정을 직접 붙였다(Map24TreasureChestLogic.SpawnReturnPortal과
	-- 동일 패턴).
	property any _touchHandler = nil

	method void OnBeginPlay()
		if self:IsClient() then
			self._touchHandler = self.Entity:ConnectEvent(TouchEvent, self.OnTouched)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		if _GameManager.GameOver then return end
		if _TitleUI.titleGroup.Enable then return end
		self:RequestClick()
	end

	@ExecSpace("Server")
	method void RequestClick()
		_Ep3Map2BonusBossLogic:OnPortalTouched()
	end

	method void OnEndPlay()
		if self:IsClient() then
			if self._touchHandler ~= nil then self.Entity:DisconnectEvent(TouchEvent, self._touchHandler) end
		end
	end

end
