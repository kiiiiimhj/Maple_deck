@Component
script Ep3Map1InvitationTicketTrigger extends Component

	-- 에피소드4 map1 이스터에그(선행 작업, ep3_map1에 배치) — MapObject_106에 부착. 클릭하면
	-- Ep3Map1InvitationEasterEggLogic.OnTicketObjectTouched()가 "초대권"(ep4_invitation_ticket)을
	-- 확정 지급한다(런당 1번, Ep3Map1SkillRewardTrigger와 동일한 클릭 패턴).
	property any _touchHandler = nil

	method void OnBeginPlay()
		-- 클라이언트에서만 터치 이벤트를 구독한다.
		if self:IsClient() then
			self._touchHandler = self.Entity:ConnectEvent(TouchEvent, self.OnTouched)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		-- 게임오버/타이틀 화면에서는 무시한다.
		if _GameManager.GameOver then return end
		if _TitleUI.titleGroup.Enable then return end
		self:RequestClick()
	end

	@ExecSpace("Server")
	method void RequestClick()
		-- 실제 지급 판정은 서버 권위로 Logic에서 처리한다.
		_Ep3Map1InvitationEasterEggLogic:OnTicketObjectTouched(self.Entity)
	end

	method void OnEndPlay()
		if self:IsClient() then
			if self._touchHandler ~= nil then self.Entity:DisconnectEvent(TouchEvent, self._touchHandler) end
		end
	end

end
