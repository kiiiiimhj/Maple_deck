@Component
script Map21TreePuzzlePieceTrigger extends Component

	-- 1=object-1177_3, 2=object-1177_4, 3=object-1177_5, 4=object-1177_7
	-- (Map21TreePuzzleLogic._targets/_movedFlags의 키와 매칭)
	property integer PieceIndex = 1

	property any _touchHandler = nil
	property any _holdHandler = nil
	property any _releaseHandler = nil

	property boolean _dragging = false
	property integer _activeTouchId = 0
	-- 잡은 순간의 "손가락 월드좌표 - 오브젝트 위치" 오프셋 — 이게 없으면 잡자마자 오브젝트 중심이
	-- 손가락 위치로 순간이동해버린다(유저가 잡은 지점 그대로 유지되어야 자연스러운 드래그가 된다)
	property number _dragOffsetX = 0
	property number _dragOffsetY = 0

	method void OnBeginPlay()
		if self:IsClient() then
			self._touchHandler = self.Entity:ConnectEvent(TouchEvent, self.OnTouched)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		if _GameManager.GameOver then return end
		if _TitleUI.titleGroup.Enable then return end
		if self._dragging then return end
		self._dragging = true
		self._activeTouchId = event.TouchId

		local worldTouch = _UILogic:ScreenToWorldPosition(event.TouchPoint)
		local pos = self.Entity.TransformComponent.Position
		self._dragOffsetX = pos.x - worldTouch.x
		self._dragOffsetY = pos.y - worldTouch.y

		self._holdHandler = _InputService:ConnectEvent(ScreenTouchHoldEvent, self.OnDragHold)
		self._releaseHandler = _InputService:ConnectEvent(ScreenTouchReleaseEvent, self.OnDragRelease)
	end

	-- 유저가 손가락/커서를 움직이는 동안 계속 따라온다 — 오브젝트 자체를 직접 끌 수 있어야 한다는
	-- 유저 지적으로, 자동으로 목표 좌표까지 이동시키던 이전 방식(탭 한 번에 스냅)은 제거했다.
	@ExecSpace("ClientOnly")
	method void OnDragHold(ScreenTouchHoldEvent event)
		if not self._dragging then return end
		if event.TouchId ~= self._activeTouchId then return end
		local worldTouch = _UILogic:ScreenToWorldPosition(event.TouchPoint)
		local pos = self.Entity.TransformComponent.Position
		self.Entity.TransformComponent.Position = Vector3(worldTouch.x + self._dragOffsetX, worldTouch.y + self._dragOffsetY, pos.z)
	end

	@ExecSpace("ClientOnly")
	method void OnDragRelease(ScreenTouchReleaseEvent event)
		if not self._dragging then return end
		if event.TouchId ~= self._activeTouchId then return end
		self._dragging = false
		if self._holdHandler ~= nil then
			_InputService:DisconnectEvent(ScreenTouchHoldEvent, self._holdHandler)
			self._holdHandler = nil
		end
		if self._releaseHandler ~= nil then
			_InputService:DisconnectEvent(ScreenTouchReleaseEvent, self._releaseHandler)
			self._releaseHandler = nil
		end

		local pos = self.Entity.TransformComponent.Position
		self:RequestCheckPlacement(pos.x, pos.y)
	end

	-- 놓은 위치가 목표(왼쪽 짝의 대칭 좌표)에 오차범위 이내로 들어왔는지는 서버가 최종 판정한다
	@ExecSpace("Server")
	method void RequestCheckPlacement(number x, number y)
		_Map21TreePuzzleLogic:CheckPiecePlacement(self.PieceIndex, self.Entity, x, y)
	end

	method void OnEndPlay()
		if self:IsClient() then
			if self._touchHandler ~= nil then self.Entity:DisconnectEvent(TouchEvent, self._touchHandler) end
			if self._holdHandler ~= nil then _InputService:DisconnectEvent(ScreenTouchHoldEvent, self._holdHandler) end
			if self._releaseHandler ~= nil then _InputService:DisconnectEvent(ScreenTouchReleaseEvent, self._releaseHandler) end
		end
	end

end
