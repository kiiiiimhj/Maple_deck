@Component
script Ep2Map2GalleryHudGate extends Component

	-- 몬스터 갤러리 맵(ep2_map2_estermap_1) 체류 중 상시 게임 HUD(카드슬롯/체력바/골드 등,
	-- ui/DefaultGroup.ui)를 숨긴다. 유저 지적: "딤드가 UI보다도 더 위에 있어야지 ㅋ 카드슬롯이랑
	-- 이런거" — 월드 스프라이트(GalleryDim)는 별도 렌더 패스인 UI 위로 절대 그려질 수 없어서, 딤드를
	-- UI 위로 올리는 대신 갤러리 체류 동안 HUD 자체를 꺼서 가리는 방식으로 해결한다.
	-- 맵 root 엔티티(ep2_map2_estermap_1)에 붙는 Component라 AGENTS.md 권장 패턴대로
	-- OnMapEnter/OnMapLeave를 그대로 쓸 수 있다(@Logic인 Ep2Map2ArenaLogic은 이 훅이 안 온다).
	-- 이 맵을 드나드는 모든 플레이어에 대해 호출되므로(다른 플레이어 포함) 로컬 플레이어 본인일
	-- 때만 반응하도록 걸러야 한다.

	@ExecSpace("ClientOnly")
	method void OnMapEnter(Entity entered)
		if entered ~= _UserService.LocalPlayer then return end
		self:SetHudVisible(false)
	end

	@ExecSpace("ClientOnly")
	method void OnMapLeave(Entity left)
		if left ~= _UserService.LocalPlayer then return end
		self:SetHudVisible(true)
	end

	@ExecSpace("ClientOnly")
	method void SetHudVisible(boolean visible)
		local hud = _EntityService:GetEntityByPath("/ui/DefaultGroup")
		if hud ~= nil then hud.Enable = visible end
	end

end
