@Logic
script Ep3Map3CollectLogic extends Logic

	-- 에피소드3 map3 이스터에그: object-15_131(Ep3Map3CollectTrigger가 붙은 오브젝트) — Ep3Map2CollectLogic과
	-- 동일한 수집 패턴이지만 유저 지정으로 목표가 2종류다: 에피3 map3(존1~10 = mapIndex109~118) 몬스터
	-- 전용 잡템 4종(werewolf_fang/lycan_claw/snowman_crystal/flyeye_eyeball) 중 서로 다른 2종을
	-- 무작위로 고정하고, 각각 25개씩(유저 지정 "잡템 25개씩 2종류 랜덤") 모아와야 한다.
	-- 버그 수정(2026-08-26, 유저 지적: "2개 얹혀줘야 내가하지 퀘스트 템 2개랑 xN 2개 있어야지") —
	-- 처음엔 공용 GiftBubble.model(아이콘/텍스트 슬롯 1개)을 그대로 써서 한 번에 목표 하나씩만
	-- 순차로 보여줬는데, 유저가 두 목표를 동시에(아이콘 2개+진행수 2개) 보고 싶어했다. 공용 모델을
	-- 직접 고치면 이걸 쓰는 다른 모든 이스터에그(GiftNpc/Ep3Map2Collect/SkillChest/HiddenGift)에
	-- 영향이 가므로, `GiftBubble.model`을 복제해 아이콘/텍스트 슬롯 2쌍(Icon1/Count1, Icon2/Count2)을
	-- 가진 전용 모델 `DualGiftBubble.model`(modelId "dualgiftbubble")을 새로 만들어 이 이스터에그만
	-- 쓰게 했다. 배경 버블 Scale.x도 0.488→0.62로 살짝 넓혀서 두 쌍이 나란히 들어갈 여유를 줬다.
	-- 보상은 Ep3Map2CollectLogic과 동일 정책(흰 포션 확정 + 보유 슬롯 스킬 1개, 강화할 스킬 없으면
	-- 포션만) — 유저가 보상을 따로 지정하지 않아서 가장 가까운 선례를 그대로 재사용함(다르게 원하면
	-- 알려줄 것).
	-- 말풍선 위치는 유저가 직접 Maker Hierarchy에서 CollectBubblePreview 엔티티(DualGiftBubble.model
	-- 그대로 배치한 순수 위치 참고용, 게임 로직과 연결 안 됨)를 드래그해 잡을 수 있게 배치해뒀다.
	-- 유저가 원하는 자리로 옮긴 뒤 그 결과 좌표를 BubbleXOffset/BubbleYOffset(오브젝트 월드좌표
	-- 기준 상대 오프셋)에 반영하면 된다 — Icon1/Icon2/Count1/Count2 개별 위치를 더 조정하고 싶으면
	-- DualGiftBubble.model 자체를 고치면 된다(요청하면 바로 반영 가능).
	@Sync property boolean Redeemed = false
	@Sync property string PickedItemId1 = ""
	@Sync property string PickedItemId2 = ""

	property integer GiftAmount = 25
	property number BubbleShowDuration = 2.0
	property string BubbleModelId = "dualgiftbubble"
	-- 유저가 Maker에서 CollectBubblePreview를 직접 옮긴 결과 반영(2026-08-26, 오브젝트 월드좌표
	-- 기준 상대 오프셋 — object-15_131 Position(46.20799, -0.666326463) 대비 프리뷰 최종 위치
	-- (45.2118034, 0.2948975)의 차이)
	property number BubbleXOffset = -0.9961866
	property number BubbleYOffset = 0.961223963
	-- 진행 말풍선(공용 CollectBubbleLogic, 유저 지정 2026-09-30): 목표 2개면 NPC 좌우에 1개씩 대칭(오른쪽은 배경만
	-- 뒤집음), 다 모은 목표는 말풍선을 안 띄운다(남은 게 1개면 왼쪽 자리에 1개만).
	property number QuestBubbleXOffset = -1.25
	property number QuestBubbleYOffset = 1.25
	property number QuestBubbleRightXOffset = 1.25
	property table _activeBubbles = {}
	property string TextFont = "Maple"
	property Color TextOutlineColor = Color(0, 0, 0, 1)
	property number TextOutlineWidth = 0.4188931
	property number TextFaceDilate = 0.3590512
	property Color TextFontColor = Color(1, 1, 1, 1)
	property number TextFontSize = 3
	property Vector2 TextRectSize = Vector2(0.59, 0.45)

	-- 에피3 map3(존1~10) 신규 몬스터 4종 전용 잡템 — GameManager.GetMonsterLootItemId의 [109]~[118]
	-- 풀 중 이 맵에서 처음 등장한 종만(예티류 재사용 잡템 제외, Ep3Map2CollectLogic과 동일한 범위 원칙)
	property table _map3ItemPool = {
		"werewolf_fang", "lycan_claw", "snowman_crystal", "flyeye_eyeball",
	}



	-- Ep3Map3CollectTrigger.RequestTouch()가 호출
	@ExecSpace("ServerOnly")
	method void OnObjectTouched(Entity touchedObject)
		if self.Redeemed then return end

		local map = touchedObject.CurrentMap
		if map == nil then return end
		local worldPos = touchedObject.TransformComponent.WorldPosition

		-- 처음 누른 순간(목표를 정한 순간)엔 가방에 이미 있어도 "X전체개수" 의뢰 말풍선만 띄운다 — 다시 눌렀을 때 보유 중이면 클리어(유저 지정 2026-10-06, 예전엔 뭔지도 모르고 바로 클리어됐다)
		local firstTap = false
		if self.PickedItemId1 == "" then
			self:PickTwoDistinctItems()
			firstTap = true
		end

		local have1 = _PlayerInventory:GetItemCount(self.PickedItemId1)
		local have2 = _PlayerInventory:GetItemCount(self.PickedItemId2)
		if firstTap then
			have1 = 0
			have2 = 0
		end

		if have1 < self.GiftAmount or have2 < self.GiftAmount then
			-- 두 목표를 동시에 보여준다 — 아직 하나라도 못 채웠으면 진행상황 말풍선만 띄우고 끝.
			local remaining1 = math.max(0, self.GiftAmount - have1)
			local remaining2 = math.max(0, self.GiftAmount - have2)
			-- 다 모은 쪽은 빼고 남은 목표만 말풍선으로(유저 지정 "1개 완료하면 1개만")
			local list = {}
			if remaining1 > 0 then table.insert(list, {self.PickedItemId1, "X" .. remaining1}) end
			if remaining2 > 0 then table.insert(list, {self.PickedItemId2, "X" .. remaining2}) end
			self:ShowQuestBubbles(touchedObject, list)
			log("Ep3Map3Collect: still collecting - " .. self.PickedItemId1 .. " (" .. have1 .. "/" .. self.GiftAmount ..
				") + " .. self.PickedItemId2 .. " (" .. have2 .. "/" .. self.GiftAmount .. ")")
			return
		end

		-- 두 목표 모두 채워짐 — 교환 완료
		self.Redeemed = true
		_PlayerInventory:RemoveItem(self.PickedItemId1, self.GiftAmount)
		_PlayerInventory:RemoveItem(self.PickedItemId2, self.GiftAmount)

		local fall = self:ComputeDropFall(touchedObject)
		local fallHeight = fall.x
		local groundWorldY = fall.y

		-- 흰 포션은 스킬 유무와 무관하게 항상 지급(Ep3Map2CollectLogic과 동일 정책 재사용)
		_GameManager:ApplyPotionDrop(2, worldPos, fallHeight, groundWorldY, 1.0)

		local pool = _CardManager:BuildActiveUpgradePool()
		if #pool > 0 then
			_CardManager:GrantCardUpgradesFromPool(pool, worldPos, fallHeight, groundWorldY, 1.0, 1, 0)
			log("Ep3Map3Collect: redeemed " .. self.PickedItemId1 .. "+" .. self.PickedItemId2 .. " x" .. self.GiftAmount .. " each for white potion + 1 card upgrade")
		else
			log("Ep3Map3Collect: redeemed " .. self.PickedItemId1 .. "+" .. self.PickedItemId2 .. " x" .. self.GiftAmount .. " each for white potion (no upgradeable skill)")
		end
		-- 덤(유저 지정 2026-09-18): 버프 포션 5% / 다이아 5%
		_EasterEggBonusLogic:RollBonus(worldPos, fallHeight, groundWorldY)

		-- 완료 연출(2026-08-27, 유저 지적: "하트말고 퀘스트 템으로 보여줘야지 xn개도") — 하트 대신
		-- 실제로 모은 퀘스트 아이템 아이콘을 그대로 보여주고, 개수도 "X{GiftAmount}"로 함께 표시한다.
		self:ShowQuestBubbles(touchedObject, {{self.PickedItemId1, "X" .. self.GiftAmount}, {self.PickedItemId2, "X" .. self.GiftAmount}})
	end

	-- 4종 중 서로 다른 2종을 무작위로 뽑는다(첫 뽑기에서 같은 게 나오면 다시 뽑는 단순 재시도 방식 —
	-- 후보가 4개뿐이라 무한루프 위험 없음)
	@ExecSpace("ServerOnly")
	method void PickTwoDistinctItems()
		self.PickedItemId1 = self._map3ItemPool[_UtilLogic:RandomIntegerRange(1, #self._map3ItemPool)]
		repeat
			self.PickedItemId2 = self._map3ItemPool[_UtilLogic:RandomIntegerRange(1, #self._map3ItemPool)]
		until self.PickedItemId2 ~= self.PickedItemId1
	end

	-- Ep3Map2CollectLogic.ComputeDropFall과 동일 로직 재사용
	@ExecSpace("ServerOnly")
	method Vector3 ComputeDropFall(Entity refEntity)
		local worldPos = refEntity.TransformComponent.WorldPosition
		local fallHeight = 0
		local groundWorldY = worldPos.y
		local map = refEntity.CurrentMap
		if map ~= nil then
			---@type FootholdComponent
			local foothold = map:GetComponent("FootholdComponent")
			if foothold ~= nil then
				local hits = foothold:RaycastAll(Vector2(worldPos.x, worldPos.y), Vector2(0, -1), 50)
				local groundY = nil
				local bestDist = nil
				for i = 1, #hits do
					local h = hits[i]
					local y = h:GetYByX(worldPos.x)
					local dist = worldPos.y - y
					if bestDist == nil or dist < bestDist then
						bestDist = dist
						groundY = y
					end
				end
				if groundY ~= nil and worldPos.y > groundY then
					fallHeight = (worldPos.y - groundY) * 100
					groundWorldY = groundY
				end
			end
		end
		return Vector3(fallHeight, groundWorldY, 0)
	end



	@ExecSpace("ServerOnly")
	method void ClearQuestBubbles()
		-- 떠 있는 진행 말풍선 전부 지운다
		for _, b in ipairs(self._activeBubbles) do
			if isvalid(b) then b:Destroy() end
		end
		self._activeBubbles = {}
	end

	@ExecSpace("ServerOnly")
	method void ShowQuestBubbles(Entity npc, table list)
		-- list = {{잡템id, 글자}, ...} — 1개면 왼쪽, 2개면 왼쪽(정방향)+오른쪽(배경만 좌우반전)
		self:ClearQuestBubbles()
		local map = npc.CurrentMap
		if map == nil then return end
		local wp = npc.TransformComponent.WorldPosition
		local spawned = {}
		for i, entry in ipairs(list) do
			local mirror = i == 2
			local xOff = self.QuestBubbleXOffset
			if mirror then xOff = self.QuestBubbleRightXOffset end
			local pos = Vector3(wp.x + xOff, wp.y + self.QuestBubbleYOffset, wp.z - 0.5)
			local bubble = _CollectBubbleLogic:SpawnItemQuestBubble(map, pos, "Ep3Map3QuestBubble" .. i, entry[1], entry[2], mirror)
			if bubble ~= nil then table.insert(spawned, bubble) end
		end
		self._activeBubbles = spawned
		_TimerService:SetTimerOnce(function()
			for _, b in ipairs(spawned) do
				if isvalid(b) then b:Destroy() end
			end
		end, self.BubbleShowDuration)
	end

	-- GameManager.RestartGame()이 호출 — 새 런에서는 다시 교환 도전 가능하고, 두 목표도 재추첨된다
	@ExecSpace("ServerOnly")
	method void ResetForNewRun()
		self.Redeemed = false
		self.PickedItemId1 = ""
		self.PickedItemId2 = ""
		self:ClearQuestBubbles()
	end

end
