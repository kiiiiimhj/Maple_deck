@Logic
script Map21RelicEasterEgg extends Logic
	@Sync property boolean Triggered = false
	@Sync property boolean SealOpening = false
	@Sync property boolean AwaitingAcquire = false
	property integer RunRevision = 0
	property string _rescueUserId = ""
	property boolean _claimBusy = false
	property string ArrowHintPath = "/maps/map21/RelicArrowHint"
	property string RelicObjectPath = "/maps/map21/object-236_2"
	property ButtonComponent btnReturn = "5c99574e-2a7c-405a-bd55-fed32b22abde"
	property any _returnHandler = nil
	property boolean _returnButtonVisible = false

	method boolean IsRescueComplete()
		return _CharacterUnlockLogic.SylphUnlocked and not _CompanionRescueMakerTest:RepeatRescue(1)
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		if isvalid(self.btnReturn) then
			self._returnHandler=self.btnReturn.Entity:ConnectEvent(ButtonClickEvent,self.OnReturnClicked)
			self.btnReturn.Entity.Enable=false
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		local show=(_MapManager.CurrentMapIndex==35) and self:IsRescueComplete() and not self.SealOpening and not self.AwaitingAcquire
		if show==self._returnButtonVisible then return end
		self._returnButtonVisible=show
		if isvalid(self.btnReturn) then self.btnReturn.Entity.Enable=show end
	end

	@ExecSpace("ClientOnly")
	method void OnReturnClicked()
		self:RequestReturn()
	end

	@ExecSpace("Server")
	method void RequestReturn()
		if not self:IsRescueUser(senderUserId) or not self:IsRescueComplete() then return end
		if _GameManager.GameOver or _GameManager:IsGamePaused() or _MapManager._moveLocked then return end
		self:ReturnToMap20()
	end

	@ExecSpace("ServerOnly")
	method boolean IsRescueUser(string userId)
		local user=_UserService:GetUserEntityByUserId(userId)
		return isvalid(user) and _MapManager.CurrentMapIndex==35 and user.CurrentMap==_EntityService:GetEntityByPath("/maps/map21") and not _MapManager.AwayOnSideMap
	end

	@ExecSpace("ServerOnly")
	method void RefreshScene()
		local show=not self:IsRescueComplete() and not self.AwaitingAcquire
		for _,name in ipairs({"object-236_2","SealedSylph","SylphSealAura"}) do
			local e=_EntityService:GetEntityByPath("/maps/map21/"..name)
			if isvalid(e) then e.Enable=show end
		end
		local arrow=_EntityService:GetEntityByPath(self.ArrowHintPath)
		if isvalid(arrow) then arrow.Enable=show and _Map21TreePuzzleLogic.Solved and not self.Triggered end
	end

	@ExecSpace("ServerOnly")
	method void ApplyAlreadyUnlockedState()
		self.Triggered=self:IsRescueComplete() self:RefreshScene()
	end

	@ExecSpace("ServerOnly")
	method void OnPuzzleSolved()
		self:RefreshScene()
		if not self:IsRescueComplete() then _UIToast:ShowMessage("CHARACTER_RESCUE_READY") end
		log("SylphRescue: puzzle complete, rescue hint visible")
	end

	@ExecSpace("ServerOnly")
	method void OnObjectTouched(Entity relicObject)
		self:OnRescueTouched(relicObject,_CharacterUnlockLogic:GetSoleUserId())
	end

	@ExecSpace("ServerOnly")
	method void AcquireAndTravel()
		self:AcquireRescueForUser(_CharacterUnlockLogic:GetSoleUserId())
	end

	@ExecSpace("ServerOnly")
	method void OnRescueTouched(Entity target, string userId)
		if not _Map21TreePuzzleLogic.Solved or self.Triggered or self:IsRescueComplete() then return end
		if not isvalid(target) or not target.Enable or not self:IsRescueUser(userId) then return end
		if target~=_EntityService:GetEntityByPath(self.RelicObjectPath) and target~=_EntityService:GetEntityByPath(self.ArrowHintPath) then return end
		if not _GameManager.GameStarted or _GameManager.GameOver or _GameManager:IsGamePaused() or _MapManager._moveLocked then return end
		self.Triggered=true self.SealOpening=true self._rescueUserId=userId
		_GameManager:SetEasterEggPaused(true)
		self:RefreshScene()
		local revision=self.RunRevision
		log("SylphRescue: seal opening, gameplay paused")
		_TimerService:SetTimerOnce(function()
			if revision~=self.RunRevision or _GameManager.GameOver or not self:IsRescueUser(userId) then return end
			self.SealOpening=false self.AwaitingAcquire=true self:RefreshScene()
			_CharacterUnlockUI:Open("c8d5851228a844da80c8c94586b06aa7","MLUA_MAP21RELICEASTEREGG_001","MLUA_MAP21RELICEASTEREGG_002",userId)
			log("SylphRescue: unlock popup opened")
		end,2.2)
	end

	@ExecSpace("ServerOnly")
	method void AcquireRescueForUser(string userId)
		if not self.AwaitingAcquire or self._claimBusy or userId~=self._rescueUserId or not self:IsRescueUser(userId) or _GameManager.GameOver then return end
		self._claimBusy=true local revision=self.RunRevision
		local saved=_CharacterUnlockLogic:UnlockSylph()
		if revision~=self.RunRevision then return end
		self._claimBusy=false
		if not saved then
			_CharacterUnlockUI:Open("c8d5851228a844da80c8c94586b06aa7","MLUA_MAP21RELICEASTEREGG_001","MLUA_MAP21RELICEASTEREGG_002",userId)
			return
		end
		_CompanionRescueMakerTest:CompleteRescue(1)
		self.AwaitingAcquire=false self._rescueUserId="" self:RefreshScene()
		_GameManager:SetEasterEggPaused(false)
		self:ReturnToMap20()
		log("SylphRescue: acquired, returning to zone34")
	end

	@ExecSpace("ServerOnly")
	method void ResetForNewRun()
		self.RunRevision=self.RunRevision+1
		local waiting=self.SealOpening or self.AwaitingAcquire
		self.Triggered=self:IsRescueComplete() self.SealOpening=false self.AwaitingAcquire=false
		self._rescueUserId="" self._claimBusy=false
		if waiting then _GameManager:SetEasterEggPaused(false) end
		self:RefreshScene()
		local seal=_EntityService:GetEntityByPath(self.RelicObjectPath)
		if isvalid(seal) then seal:GetComponent("script.SylphSealVisual"):ResetVisual() end
		self:CloseRescuePopup()
	end

	@ExecSpace("Client")
	method void CloseRescuePopup()
		if _CharacterUnlockUI._pendingCharacterName~="MLUA_MAP21RELICEASTEREGG_001" then return end
		_AcquisitionFxUI:StopTarget(_CharacterUnlockUI.iconSprite.Entity)
		_CharacterUnlockUI.popupGroup.Enable=false _CharacterUnlockUI._pendingCharacterName=""
	end

	@ExecSpace("ServerOnly")
	method void PrepareMakerTest()
		_CompanionRescueMakerTest:PrepareEntry()
	end

	method void OnEndPlay()
		if self:IsClient() and self._returnHandler~=nil and isvalid(self.btnReturn) then self.btnReturn.Entity:DisconnectEvent(ButtonClickEvent,self._returnHandler) end
	end

	@ExecSpace("ServerOnly")
	method void ReturnToMap20()
		-- 맵21(택시 이스터에그 비밀 구역)에서 맵20의 마지막 존(존34)으로 돌아간다
		local targetIndex = 34
		local mapName = _MapManager:GetMapName(targetIndex)
		local spawnPos = _MapManager:GetSpawnPositionForIndex(targetIndex)

		local revision=self.RunRevision
		_MapTransitionLogic:PlayCover("right")
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) or revision~=self.RunRevision or _GameManager.GameOver then return end
			for _, userEntity in pairs(_UserService.UserEntities) do
				_TeleportService:TeleportToMapPosition(userEntity, spawnPos, mapName)
			end
			_MapManager.CurrentMapIndex = targetIndex
			_MonsterSpawner:ActivateMap(targetIndex)
			-- 일반 존 이동(MoveToMap/DoScrollMapChange 등)은 전부 도착한 맵의 몬스터를 Resume()
			-- 해주는데, 이 텔레포트 경로만 그 호출이 빠져 있었다(유저 지적: "다시 존으로 복귀하는데
			-- 거기서 몬스터가 멈춰있는데... 다시 움직이고 공격해야함") — 존을 벗어나 있는 동안
			-- 새로 스폰된 몬스터는 SpawnBatchOnMap에서 기본적으로 Pause()된 채로 태어나므로, 도착
			-- 즉시 풀어줘야 한다.
			_MapManager:SetMonstersPaused(_MonsterSpawner:GetZoneEntity(targetIndex), false)
			-- 맵21에 있는 동안 MapMoveUI가 숨겨뒀던 좌/우 이동 버튼을 되돌려 놓는다(존34로 정상
			-- 복귀했다는 걸 명시적으로 알려줘야 한다 — MapMoveUI.OnSyncProperty는 자기 자신의 @Sync만
			-- 감지하므로 CurrentMapIndex 변경을 자동으로 못 본다)
			_MapMoveUI:NotifyMapChanged(targetIndex)
			_TimerService:SetTimerOnce(function()
				if isvalid(self) then _MapTransitionLogic:PlayReveal("right") end
			end, _MapTransitionLogic.CameraSettleDelay)
		end, _MapTransitionLogic.CoverDuration)
	end

end
