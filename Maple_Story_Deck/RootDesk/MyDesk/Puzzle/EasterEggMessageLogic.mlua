@Logic
script EasterEggMessageLogic extends Logic

	-- 이스터에그 반응 대사(유저 지정 2026-09-30: "누르면 템 나오는데 아무 대사도 없으니 좀 그래").
	-- 종류마다 3줄 중 하나를 무작위로 토스트로 띄운다(GameText.csv MLUA_EASTEREGGMSG_*).
	--   Found  : 터치해서 아이템이 나왔을 때        Miss   : 터치했는데 꽝
	--   Chest  : 보물상자류를 열었을 때             Puzzle : 오브젝트 옮기기/석상 돌리기 퍼즐을 맞췄을 때
	-- ⚠ 토스트는 한 번에 하나만 보이고 새 메시지가 이전 걸 덮는다(대기열 없음). 퍼즐처럼 원래 결과 메시지
	--   ("맵 어딘가에 변화가 생겼습니다" 등)가 있으면 PuzzleThen으로 대사를 먼저 띄우고 결과는 FollowDelay 뒤에 띄운다.

	property number FollowDelay = 2.2
	-- 꽝 대사를 띄운 누적 횟수 — 돋보기 도전(MushroomInspectChallenge)이 "성공했는데 꽝이었나"를 이 값 변화로 판단한다
	property integer _missCount = 0

	@ExecSpace("ServerOnly")
	method integer GetMissCount()
		return self._missCount
	end

	@ExecSpace("ServerOnly")
	method void ShowRandom(string group)
		-- MLUA_EASTEREGGMSG_{group}_1~3 중 하나
		local key = "MLUA_EASTEREGGMSG_" .. group .. "_" .. tostring(_UtilLogic:RandomIntegerRange(1, 3))
		_UIToast:ShowMessage(key)
		log("EasterEggMessage: " .. key)
	end

	@ExecSpace("ServerOnly")
	method void Found()
		-- 아이템 발견
		self:ShowRandom("FOUND")
	end

	@ExecSpace("ServerOnly")
	method void Miss()
		-- 꽝
		self._missCount = self._missCount + 1
		self:ShowRandom("MISS")
	end

	@ExecSpace("ServerOnly")
	method void Chest()
		-- 보물상자
		self:ShowRandom("CHEST")
	end

	@ExecSpace("ServerOnly")
	method void Reveal()
		-- 구름/가리개를 걷어서 뒤에 숨은 게 드러났을 때(유저 지정 2026-09-30)
		self:ShowRandom("REVEAL")
	end

	@ExecSpace("ServerOnly")
	method void Puzzle()
		-- 퍼즐 정답
		self:ShowRandom("PUZZLE")
	end

	@ExecSpace("ServerOnly")
	method void ShowThen(string group, string followKey)
		-- 대사를 먼저 띄우고, 원래 있던 결과 메시지(followKey)는 FollowDelay 뒤에(토스트가 서로 덮지 않게)
		self:ShowRandom(group)
		if followKey == nil or followKey == "" then return end
		_TimerService:SetTimerOnce(function()
			_UIToast:ShowMessage(followKey)
		end, self.FollowDelay)
	end

	@ExecSpace("ServerOnly")
	method void PuzzleThen(string followKey)
		-- 퍼즐 정답 대사 → (잠시 뒤) 원래 결과 메시지
		self:ShowThen("PUZZLE", followKey)
	end

	-- ── 존 입장 힌트(유저 지정 2026-10-28) ─────────────────────────────────────────────
	-- 캐릭터 해금 이스터에그가 있는 존에 들어가면 한 판에 한 번 힌트 토스트를 띄운다. 해금했거나 퍼즐을 이미 풀었으면 안 띄운다.
	--   존35(map21, 실피드 나무 퍼즐)     : 실피드 해금 전
	--   존58(ep2_map2 Zone4, 석상 퍼즐)   : 레이온 해금 전 + 석상 퍼즐 미해결
	--   존65(ep2_map3, 지친 기사 소환)    : 레이온 해금 전 + 지친 기사 미발동
	property integer _hintLastZone = -1
	property any _hintShown = nil
	property integer _hintRun = -1

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if not _GameManager.GameStarted or _GameManager.GameOver then self._hintLastZone = -1 return end
		local run = _PetLogic.RunToken
		if self._hintShown == nil or self._hintRun ~= run then self._hintShown = {} self._hintRun = run end
		local zone = _MapManager.CurrentMapIndex
		if zone == self._hintLastZone then return end
		self._hintLastZone = zone
		local key = self:GetZoneHintKey(zone)
		if key == "" or self._hintShown[zone] then return end
		self._hintShown[zone] = true
		-- 존 이동 연출(와이프)이 걷힌 뒤 보이게 조금 늦춘다
		_TimerService:SetTimerOnce(function()
			if _MapManager.CurrentMapIndex == zone and not _GameManager.GameOver then _UIToast:ShowMessage(key) end
		end, 1.0)
		log("EasterEggMessage: zone hint zone=" .. zone .. " key=" .. key)
	end

	@ExecSpace("ServerOnly")
	method string GetZoneHintKey(integer zone)
		if zone == 35 and not _CharacterUnlockLogic.SylphUnlocked then return "ZONE_HINT_SYLPH_TREE" end
		if zone == 58 and not _CharacterUnlockLogic.LeionUnlocked and not _Ep2Map2StatuePuzzleLogic.Solved then return "ZONE_HINT_LEION_TORCH" end
		if zone == 65 and not _CharacterUnlockLogic.LeionUnlocked and not _Ep2Map3TiredKnightLogic.Triggered then return "ZONE_HINT_TIRED_KNIGHT" end
		return ""
	end

end
