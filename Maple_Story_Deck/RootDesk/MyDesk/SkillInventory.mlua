	property any _storage = nil

	property boolean _dirty = false

	property any _flushTimerId = nil

	method integer GetMaxLevelForSkill(integer skillIndex)
		return self.maxLevel
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 월드 시작 시 저장된 스킬 조각/레벨을 전역 저장소에서 불러온다
		self._storage = _DataStorageService:GetGlobalDataStorage("SkillInventory")
		local errorCode, raw = self._storage:GetAndWait("Counts")
		if errorCode == 0 and raw ~= nil and raw ~= "" then
			local loaded = _UtilLogic:StringToTable(raw)
			if loaded ~= nil then
				for i = 0, self.skillCount - 1 do
					local key = tostring(i)
					if loaded[key] ~= nil then
						self.Counts[key] = loaded[key]
					end
				end
			end
		end
		local levelErrorCode, levelRaw = self._storage:GetAndWait("Levels")
		if levelErrorCode == 0 and levelRaw ~= nil and levelRaw ~= "" then
			local loadedLevels = _UtilLogic:StringToTable(levelRaw)
			if loadedLevels ~= nil then
				for i = 0, self.skillCount - 1 do
					local key = tostring(i)
					if loadedLevels[key] ~= nil then
						self.Levels[key] = loadedLevels[key]
					end
				end
			end
		end
		-- 레드닷 상태도 재시작 사이에 유지한다(확인 안 한 새 스킬은 다음 접속에도 계속 표시)
		local newErrorCode, newRaw = self._storage:GetAndWait("NewSet")
		if newErrorCode == 0 and newRaw ~= nil and newRaw ~= "" then
			local loadedNew = _UtilLogic:StringToTable(newRaw)
			if loadedNew ~= nil then
				for i = 0, self.skillCount - 1 do
					local key = tostring(i)
					if loadedNew[key] ~= nil then
						self.NewSet[key] = loadedNew[key]
					end
				end
			end
		end
		-- 5초마다 변경이 있을 때만 저장한다 (RelicInventory와 동일한 dirty-flag 패턴)
		self._flushTimerId = _TimerService:SetTimerRepeat(function() self:FlushIfDirty() end, 3.0)
		log("SkillInventory started")
	end

	@ExecSpace("Server")
	method void RequestAddSkill(integer skillIndex)
		-- 스킬 조각을 획득했을 때 호출 — GachaUI(스킬 뽑기)가 호출한다.
		if skillIndex < 0 or skillIndex >= self.skillCount then return end
		local key = tostring(skillIndex)
		-- 유저 요청: 처음 뽑히는 순간(조각 0개→1개 이상)에만 레드닷을 켠다. 스킬은 레벨 개념상
		-- 조각이 0개여도 이미 Lv.1 취급이라(RequestLevelUpSkill 참고) 레벨이 아니라 "조각을 이번에
		-- 처음 받았는가"로 새 스킬 여부를 판정한다.
		local wasOwned = self.Counts[key] ~= nil and self.Counts[key] > 0
		local current = 0
		if self.Counts[key] ~= nil then current = self.Counts[key] end
		self.Counts[key] = current + 1
		if not wasOwned then
			self.NewSet[key] = true
		end
		self._dirty = true
	end

	-- 스킬 탭에서 슬롯을 눌러 확인했을 때 호출 — 레드닷을 끈다
	@ExecSpace("Server")
	method void MarkSkillSeen(integer skillIndex)
		if skillIndex < 0 or skillIndex >= self.skillCount then return end
		local key = tostring(skillIndex)
		if self.NewSet[key] then
			self.NewSet[key] = nil
			self._dirty = true
		end
	end

	method boolean IsSkillNew(integer skillIndex)
		local key = tostring(skillIndex)
		return self.NewSet[key] == true
	end

	-- 스킬 탭 아이콘(로비 상단 btnSkill)에 표시할 레드닷 — 하나라도 미확인 스킬이 있으면 true
	method boolean HasAnyNewSkill()
		for i = 0, self.skillCount - 1 do
			if self.NewSet[tostring(i)] == true then return true end
		end
		return false
	end

	@ExecSpace("Server")
	method void RequestLevelUpSkill(integer skillIndex)
		-- 스킬 탭에서 슬롯을 눌러 업그레이드 팝업에서 강화 버튼을 눌렀을 때 호출된다
		if skillIndex < 0 or skillIndex >= self.skillCount then return end
		local key = tostring(skillIndex)
		-- 강화 안 한 기본 상태는 Lv.1(0이 아니다) — 처음 누르는 강화도 currentLevel=1 기준 비용을 쓴다.
		-- ⚠ nil이 아니라 "0보다 큰가"로 본다. 저장소에 0이 한 번 기록되면 nil 체크로는 못 걸러서
		-- currentLevel이 0으로 깨지고, GetFragmentCostForLevel(0, grade)가 nil을 돌려준다(1-based 표).
		-- 유물에서 실제로 이 방식으로 터졌다 — RelicInventory.GetEffectiveLevel 주석 참고
		local currentLevel = 1
		local storedLevel = self.Levels[key]
		if storedLevel ~= nil and storedLevel > 0 then currentLevel = storedLevel end
		if currentLevel >= self:GetMaxLevelForSkill(skillIndex) then
			log("SkillInventory: skill " .. key .. " already at max level")
			return
		end
		
		local nextLevel = currentLevel + 1
		local grade = self:GetSkillGrade(skillIndex)
		local fragmentCost = self:GetFragmentCostForLevel(currentLevel, grade)
		local goldCost = self:GetGoldCostForLevel(currentLevel, grade)
		
		local haveFragments = 0
		if self.Counts[key] ~= nil then haveFragments = self.Counts[key] end
		if haveFragments < fragmentCost then
			log("SkillInventory: not enough fragments for skill " .. key)
			return
		end
		-- 유물 강화와 동일하게 런과 무관한 메인화면 누적 코인(TotalCoins)으로 결제한다
		if not _GameManager:SpendCoins(goldCost) then
			log("SkillInventory: not enough coins for skill " .. key)
			return
		end
		
		self.Counts[key] = haveFragments - fragmentCost
		self.Levels[key] = nextLevel
		self._dirty = true
		log("SkillInventory: skill " .. key .. " leveled up to " .. tostring(nextLevel))
	end

	-- currentLevel(1~9)이 현재 레벨일 때 다음 레벨로 올리는 데 필요한 조각 개수(등급별)
	method integer GetFragmentCostForLevel(integer currentLevel, integer grade)
		return self._levelFragmentCostByGrade[grade][currentLevel]
	end

	method string GetSkillName(integer skillIndex)
		local def = self._skillDefs[skillIndex + 1]
		if def == nil then return "스킬" end
		return def.name
	end

	method string GetSkillIconRuid(integer skillIndex)
		local def = self._skillDefs[skillIndex + 1]
		if def == nil then return "" end
		return def.icon
	end

	method integer GetSkillCount()
		-- 다른 Logic(GachaUI 등)이 스킬 전체를 순회할 때 쓴다 — skillCount 필드를 로직 밖에서
		-- 직접 읽으면 런타임에 nil이 잡힐 수 있어서 접근자로 노출한다
		return self.skillCount
	end

	-- 뽑기 등급 가중치(1=일반 / 2=매직 / 3=레어). 확률 공개 팝업(GachaUI)과 실제 추첨이 같은 값을
	-- 보도록 여기 한 곳에만 둔다 — 예전엔 GachaUI가 자기 사본을 들고 굴려서 어긋날 여지가 있었다
	property any GachaGradeWeights = { 55, 30, 15 }

	method integer GetGachaGradeWeight(integer grade)
		-- GachaUI 확률 공개 팝업이 읽는다(표시와 실제 추첨이 같은 표를 쓰게)
		local w = self.GachaGradeWeights[grade]
		if w == nil then return 0 end
		return w
	end

	@ExecSpace("ServerOnly")
	method integer RollGachaSkillIndex()
		-- 등급을 가중 추첨한 뒤 그 등급 안에서는 균등하게 하나 고른다(해당 등급이 비면 일반=1로 내린다).
		-- ⚠ 2026-09-16: 예전엔 GachaUI(클라)가 굴린 뒤 연출이 끝나고 RequestAddSkill을 따로 불렀다.
		-- 연출 중 끊기면 다이아만 빠지는 문제가 있어서, 결제와 같은 흐름에서 서버가 굴리도록 옮겼다
		local buckets = { {}, {}, {} }
		for i = 0, self.skillCount - 1 do
			local g = self:GetSkillGrade(i)
			if g >= 1 and g <= 3 then table.insert(buckets[g], i) end
		end
		local total = 0
		for i = 1, 3 do total = total + self:GetGachaGradeWeight(i) end
		local roll = _UtilLogic:RandomDouble() * total
		local grade = 1
		local acc = 0
		for i = 1, 3 do
			acc = acc + self:GetGachaGradeWeight(i)
			if roll < acc then
				grade = i
				break
			end
		end
		local bucket = buckets[grade]
		if bucket == nil or #bucket == 0 then bucket = buckets[1] end
		if bucket == nil or #bucket == 0 then return 0 end
		return bucket[_UtilLogic:RandomIntegerRange(1, #bucket)]
	end

	-- 1=일반 / 2=매직 / 3=레어
	method integer GetSkillGrade(integer skillIndex)
		local def = self._skillDefs[skillIndex + 1]
		if def == nil then return 1 end
		return def.grade
	end

	-- currentLevel(1~9)이 현재 레벨일 때 다음 레벨로 올리는 데 필요한 골드(등급별)
	method integer GetGoldCostForLevel(integer currentLevel, integer grade)
		return self._levelGoldCostByGrade[grade][currentLevel]
	end

	-- 캐릭터 필터용 — 인덱스 구간으로 캐릭터를 판별한다.
	-- 0~19=아르카나(20) / 20~39=실피드(20) / 40~59=레이온(20) / 60~79=쉐이드(20) / 80~101=린(22).
	-- ⚠ 린만 22종이라 "캐릭터당 20개"로 계산하면 안 된다(_skillDefs 주석 참고).
	-- SkillUI의 _characterFilter(0/1/2/3/4)와 동일한 번호 체계.
	method integer GetSkillCharacter(integer skillIndex)
		if skillIndex >= 80 then return 4
		elseif skillIndex >= 60 then return 3
		elseif skillIndex >= 40 then return 2
		elseif skillIndex >= 20 then return 1
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method void FlushIfDirty()
		if not self._dirty then return end
		self._dirty = false
		local plainCounts = {}
		local plainLevels = {}
		local plainNew = {}
		for i = 0, self.skillCount - 1 do
			local key = tostring(i)
			-- 0은 저장하지 않는다 — 의미 없는 0이 쌓이면 다음 로드에서 "값이 있다"로 오인돼
			-- 기본 레벨(1)을 0으로 덮어버린다(유물에서 실제로 터진 버그, RelicInventory 주석 참고)
			if self.Counts[key] ~= nil and self.Counts[key] > 0 then plainCounts[key] = self.Counts[key] end
			if self.Levels[key] ~= nil and self.Levels[key] > 0 then plainLevels[key] = self.Levels[key] end
			if self.NewSet[key] == true then plainNew[key] = true end
		end
		self._storage:SetAndWait("Counts", _UtilLogic:TableToString(plainCounts))
		self._storage:SetAndWait("Levels", _UtilLogic:TableToString(plainLevels))
		self._storage:SetAndWait("NewSet", _UtilLogic:TableToString(plainNew))
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- 획득 개수나 레벨이 갱신될 때마다 스킬 탭 UI를 새로고침한다
		if name == "Counts" or name == "Levels" or name == "NewSet" then
			_SkillUI:RefreshAllSkillSlots()
			_SkillUpgradeUI:RefreshPanel()
		end
		if name == "NewSet" then
			_TitleUI:RefreshSkillNavDot()
		end
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		if self._flushTimerId then _TimerService:ClearTimer(self._flushTimerId) end
		self:FlushIfDirty()
	end

end

