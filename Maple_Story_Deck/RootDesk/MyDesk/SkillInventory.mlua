	property any _storage = nil

	property boolean _dirty = false

	property any _flushTimerId = nil

	method integer GetMaxLevelForSkill(integer skillIndex)
		return self.maxLevel
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 월드 시작 시 저장된 스킬 조각/레벨을 전역 저장소에서 불러온다
		self._storage = _DataStorageService:GetGlobalDataStorage("SkillInventory")
		local errorCode, raw = self._storage:GetAndWait("Counts")
		if errorCode == 0 and raw ~= nil and raw ~= "" then
			local loaded = _UtilLogic:StringToTable(raw)
			if loaded ~= nil then
				for i = 0, self.skillCount - 1 do
					local key = tostring(i)
					if loaded[key] ~= nil then
						self.Counts[key] = loaded[key]
					end
				end
			end
		end
		local levelErrorCode, levelRaw = self._storage:GetAndWait("Levels")
		if levelErrorCode == 0 and levelRaw ~= nil and levelRaw ~= "" then
			local loadedLevels = _UtilLogic:StringToTable(levelRaw)
			if loadedLevels ~= nil then
				for i = 0, self.skillCount - 1 do
					local key = tostring(i)
					if loadedLevels[key] ~= nil then
						self.Levels[key] = loadedLevels[key]
					end
				end
			end
		end
		-- 5초마다 변경이 있을 때만 저장한다 (RelicInventory와 동일한 dirty-flag 패턴)
		self._flushTimerId = _TimerService:SetTimerRepeat(function() self:FlushIfDirty() end, 3.0)
		log("SkillInventory started")
	end

	@ExecSpace("Server")
	method void RequestAddSkill(integer skillIndex)
		-- 스킬 조각을 획득했을 때 호출할 진입점 (RelicInventory.RequestAddRelic과 동일 패턴) —
		-- 아직 어떤 시스템도 이걸 호출하지 않는다(조각 획득처는 추후 결정). 구조만 미리 맞춰둔다
		if skillIndex < 0 or skillIndex >= self.skillCount then return end
		local key = tostring(skillIndex)
		local current = 0
		if self.Counts[key] ~= nil then current = self.Counts[key] end
		self.Counts[key] = current + 1
		self._dirty = true
	end

	@ExecSpace("Server")
	method void RequestLevelUpSkill(integer skillIndex)
		-- 스킬 탭에서 슬롯을 눌러 업그레이드 팝업에서 강화 버튼을 눌렀을 때 호출된다
		if skillIndex < 0 or skillIndex >= self.skillCount then return end
		local key = tostring(skillIndex)
		-- 강화 안 한 기본 상태는 Lv.1(0이 아니다) — 처음 누르는 강화도 currentLevel=1 기준 비용을 쓴다
		local currentLevel = 1
		if self.Levels[key] ~= nil then currentLevel = self.Levels[key] end
		if currentLevel >= self:GetMaxLevelForSkill(skillIndex) then
			log("SkillInventory: skill " .. key .. " already at max level")
			return
		end
		
		local nextLevel = currentLevel + 1
		local grade = self:GetSkillGrade(skillIndex)
		local fragmentCost = self:GetFragmentCostForLevel(currentLevel, grade)
		local goldCost = self:GetGoldCostForLevel(currentLevel, grade)
		
		local haveFragments = 0
		if self.Counts[key] ~= nil then haveFragments = self.Counts[key] end
		if haveFragments < fragmentCost then
			log("SkillInventory: not enough fragments for skill " .. key)
			return
		end
		-- 유물 강화와 동일하게 런과 무관한 메인화면 누적 코인(TotalCoins)으로 결제한다
		if not _GameManager:SpendCoins(goldCost) then
			log("SkillInventory: not enough coins for skill " .. key)
			return
		end
		
		self.Counts[key] = haveFragments - fragmentCost
		self.Levels[key] = nextLevel
		self._dirty = true
		log("SkillInventory: skill " .. key .. " leveled up to " .. tostring(nextLevel))
	end

	-- currentLevel(1~9)이 현재 레벨일 때 다음 레벨로 올리는 데 필요한 조각 개수(등급별)
	method integer GetFragmentCostForLevel(integer currentLevel, integer grade)
		return self._levelFragmentCostByGrade[grade][currentLevel]
	end

	method string GetSkillName(integer skillIndex)
		local def = self._skillDefs[skillIndex + 1]
		if def == nil then return "스킬" end
		return def.name
	end

	method string GetSkillIconRuid(integer skillIndex)
		local def = self._skillDefs[skillIndex + 1]
		if def == nil then return "" end
		return def.icon
	end

	method integer GetSkillCount()
		-- 다른 Logic(GachaUI 등)이 스킬 전체를 순회할 때 쓴다 — skillCount 필드를 로직 밖에서
		-- 직접 읽으면 런타임에 nil이 잡힐 수 있어서 접근자로 노출한다
		return self.skillCount
	end

	-- 1=일반 / 2=매직 / 3=레어
	method integer GetSkillGrade(integer skillIndex)
		local def = self._skillDefs[skillIndex + 1]
		if def == nil then return 1 end
		return def.grade
	end

	-- currentLevel(1~9)이 현재 레벨일 때 다음 레벨로 올리는 데 필요한 골드(등급별)
	method integer GetGoldCostForLevel(integer currentLevel, integer grade)
		return self._levelGoldCostByGrade[grade][currentLevel]
	end

	-- 캐릭터 필터용 — 인덱스 구간으로 캐릭터를 판별한다(0~19=아르카나 / 20~39=실피드 / 40~59=레이온).
	-- SkillUI의 _characterFilter(0/1/2)와 동일한 번호 체계.
	method integer GetSkillCharacter(integer skillIndex)
		if skillIndex >= 40 then return 2
		elseif skillIndex >= 20 then return 1
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method void FlushIfDirty()
		if not self._dirty then return end
		self._dirty = false
		local plainCounts = {}
		local plainLevels = {}
		for i = 0, self.skillCount - 1 do
			local key = tostring(i)
			if self.Counts[key] ~= nil then plainCounts[key] = self.Counts[key] end
			if self.Levels[key] ~= nil then plainLevels[key] = self.Levels[key] end
		end
		self._storage:SetAndWait("Counts", _UtilLogic:TableToString(plainCounts))
		self._storage:SetAndWait("Levels", _UtilLogic:TableToString(plainLevels))
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- 획득 개수나 레벨이 갱신될 때마다 스킬 탭 UI를 새로고침한다
		if name == "Counts" or name == "Levels" then
			_SkillUI:RefreshAllSkillSlots()
			_SkillUpgradeUI:RefreshPanel()
		end
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		if self._flushTimerId then _TimerService:ClearTimer(self._flushTimerId) end
		self:FlushIfDirty()
	end

end