@Logic
script InventoryBootstrap extends Logic

	property Entity InventoryEntity = "f5cb1fa3-87bb-4968-8af4-4d682d6eb199"

	@ExecSpace("ClientOnly")
	method void OpenInventory()
		self.InventoryEntity.UIInventory:Toggle()
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleKeyDownEvent(KeyDownEvent event)
		-- I키로 장비 인벤토리를 여는 로비 전용 단축키.
		-- 인게임(TitleGroup이 꺼진 상태)에서는 무시한다 — 이 인벤토리는 "로비에서 장착 →
		-- 게임 시작 시 효과 적용" 개념이라 전투 중에 열릴 이유가 없고, 열리면 조작 화면을
		-- 가린다. 로비 좌상단 장비 버튼(TitleUI.btnEquip)은 그대로 동작한다.
		if event.key == KeyboardKey.I then
			if _TitleUI.titleGroup.Enable == false then
				return
			end
			if _UserService.LocalPlayer.PkgPlayerInventory.InitSyncEnd == false then
				return
			end
			self:OpenInventory()
		end
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserEnterEvent(UserEnterEvent event)
		local user = _UserService:GetUserEntityByUserId(event.UserId)
		if _DataLoadLogic:IsLoadSuccessAndWait(user) == false then
			return
		end
		
		if user.PlayerJob:IsJobLockedAll() then
			user.PlayerJob:UnlockJob(_PlayerJobCodeEnum.Adele)
		end
	end

end