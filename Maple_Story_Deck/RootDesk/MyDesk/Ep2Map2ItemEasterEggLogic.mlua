@Logic
script Ep2Map2ItemEasterEggLogic extends Logic

	@Sync
	property boolean Triggered = false

	-- 에피소드2 map2 이스터에그: MapObject_46(Ep2Map2ItemEasterEggTrigger)을 2번 터치하면 포션 또는
	-- 인게임 특수아이템(빙결/허수아비/토네이도) 중 1개를 무작위로 지급한다(유저 지정). 4종 전부
	-- GameManager가 몬스터 처치 확률 드롭에 쓰는 것과 동일한 "즉시 발동" 메서드를 그대로 재사용한다 —
	-- 확률 굴림(Try*)은 건너뛰고 확정 지급 버전(Schedule*/ApplyPotionDrop)만 직접 호출한다.
	--   1) 포션: ApplyPotionDrop(potionType) — 빨강/흰색 중 50/50 무작위(포션 회복 비율은 아이템마다
	--      다르므로 어느 쪽이 나와도 "포션류"로 통칭)
	--   2) 빙결: ScheduleFreezeItemDrop — 전 맵 몬스터 빙결(TriggerGlobalFreeze)
	--   3) 허수아비: ScheduleScarecrowItemDrop — 존에 허수아비 소환(대신 맞아줌)
	--   4) 토네이도: ScheduleBounceKnockbackItemDrop — 존에 토네이도 발생
	-- 다른 Ep2Map1/2 이스터에그와 동일한 런 정책: "다시하기"/"새로 시작"에서 ResetForNewRun()이 호출돼
	-- 다시 도전할 수 있다("이어하기"는 건드리지 않음).
	property integer _touchCount = 0

	property integer RequiredTouchCount = 2

	-- MapObject_46 바로 아래 착지 지점의 실측 지면 Y(MapBuilder.getFootholds로 x=15.27 부근 확인:
	-- Id 25/26 구간, walk=1, y=-1.13)
	property number LandingWorldY = -1.13

	-- Ep2Map2ItemEasterEggTrigger.RequestTouch()가 호출 — 터치된 오브젝트 엔티티를 그대로 받는다
	-- (Logic에 UUID를 property로 박아두면 맵 미로드 시점에 nil이 되는 문제 회피, 다른 이스터에그와 동일 이유)
	@ExecSpace("ServerOnly")
	method void OnObjectTouched(Entity touchedObject)
		if self.Triggered then return end
		self._touchCount = self._touchCount + 1
		log("Ep2Map2ItemEasterEgg: touch " .. self._touchCount .. "/" .. self.RequiredTouchCount)
		if self._touchCount < self.RequiredTouchCount then return end
		
		self.Triggered = true
		local worldPos = touchedObject.TransformComponent.WorldPosition
		local pick = _UtilLogic:RandomIntegerRange(1, 4)
		if pick == 1 then
			local potionType = (_UtilLogic:RandomDouble() < 0.5) and 1 or 2
			_GameManager:ApplyPotionDrop(potionType, worldPos, 0, self.LandingWorldY, 1.0)
			log("Ep2Map2ItemEasterEgg: triggered, granted potion (type=" .. potionType .. ")")
		elseif pick == 2 then
			_GameManager:ScheduleFreezeItemDrop(worldPos, 0, self.LandingWorldY, 1.0)
			log("Ep2Map2ItemEasterEgg: triggered, granted freeze item")
		elseif pick == 3 then
			_GameManager:ScheduleScarecrowItemDrop(worldPos, 0, self.LandingWorldY, 1.0)
			log("Ep2Map2ItemEasterEgg: triggered, granted scarecrow item")
		else
			_GameManager:ScheduleBounceKnockbackItemDrop(worldPos, 0, self.LandingWorldY, 1.0)
			log("Ep2Map2ItemEasterEgg: triggered, granted tornado item")
		end
	end

	-- GameManager.RestartGame()이 호출 — 새 런에서는 오브젝트를 다시 두 번 눌러 재도전할 수 있다
	@ExecSpace("ServerOnly")
	method void ResetForNewRun()
		self.Triggered = false
		self._touchCount = 0
	end

end