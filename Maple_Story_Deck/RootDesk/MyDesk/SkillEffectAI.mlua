@Component
script SkillEffectAI extends Component

	property number Duration = 2.0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 스킬 연출 엔티티의 수명 관리 — Duration이 지나면 스스로 파괴된다
		-- (SkillEffect=0.8초 / SkillEffectLong=2.5초, 각 모델의 Values에서 주입).
		-- 호출부가 별도로 Destroy를 걸지 않는 연출(예: 썬더볼트 ThunderAttack)은 이 타이머가
		-- 유일한 소멸 경로다 — 이 컴포넌트가 등록되지 않으면 연출이 화면에 영구히 남는다.
		-- 그래서 CardManager:SpawnEffectWithModel 쪽에도 동일한 수명의 안전망 타이머를 이중으로 걸어뒀다.
		_TimerService:SetTimerOnce(function()
			if isvalid(self) and isvalid(self.Entity) then
				self.Entity:Destroy()
			end
		end, self.Duration)
	end

	method void OnEndPlay()
		-- 별도 정리 대상 없음 — 위 타이머는 1회성이고 isvalid로 방어된다.
	end

end
