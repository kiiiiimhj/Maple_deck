@Logic
script TutorialLogic extends Logic

	-- 첫 플레이 온보딩 튜토리얼의 서버 쪽 진행 상태 + "본 적 있음" 저장소.
	--
	-- 유저 지정(2026-09-10 ~ 09-11) 흐름 — Step 프로퍼티가 현재 어디까지 왔는지를 들고 있다:
	--   Step 0 (대기)   첫 웨이브 몬스터가 **누를 만한 크기로 다가올 때까지** 아무것도 안 띄우고 기다린다.
	--                   스폰 직후엔 스케일 0.3(맨 뒤, 아주 작음)이라 눌러도 잘 안 잡힌다 — 유저 지정
	--                   "맨 뒤에서 나오는 거 말고 중간쯤"이라 AimPauseMinScale까지 커지면 시작한다
	--   Step 1 (에임)   게임 전체 정지 + 딤 + 손가락이 몬스터를 따라다니며 콕콕 + 안내 문구
	--                   → 플레이어가 실제로 몬스터를 눌러 포커스를 잡으면 정지를 풀고 다음 단계
	--   Step 2 (사냥)   "몬스터를 잡아서 레벨을 올려보세요!" → 레벨업으로 카드 3장이 뜰 때까지
	--   Step 3 (카드)   게임 전체 정지 + 딤 + 손가락이 카드를 콕콕 → 카드 한 장 고를 때까지
	--                   (카드 슬롯 3장만 딤 위로 올려 정상 노출 — 나머지는 전부 어두워지고 입력도 막힌다)
	--   Step 4 (종료)   마무리 문구 몇 초 뒤 종료, 다시는 안 뜬다
	--
	-- 에임 단계를 건너뛰고(몬스터를 한 번도 안 누른 채) 레벨업해도 막히지 않는다 — 그때는 카드
	-- 단계가 그대로 이어받는다. 즉 Step은 "여기까지 왔다"는 진행도이지 통과 조건이 아니다.
	--
	-- 화면 연출은 전부 클라이언트(TutorialGuideUI)가 하고 여기서는 Multicast로 단계만 알린다.
	-- "본 적 있음" 플래그는 코인/다이아/인벤 확장과 같은 전역 저장소("PlayerCoins")에 키만 얹는다.

	@Sync
	property boolean TutorialSeen = false

	-- 튜토리얼이 진행 중인가. CardManager가 "이번 레벨업 카드가 튜토리얼 단계인지" 판단할 때 쓴다
	@Sync
	property boolean Active = false

	-- 현재 진행 단계(위 주석의 1~4). 0이면 아직 시작 전이거나 이미 끝난 상태
	@Sync
	property integer Step = 0

	property any _storage = nil

	property string StorageKey = "TutorialSeen"

	-- 카드 선택 단계의 정지가 어떤 이유로든(클라 이탈 등) 안 풀렸을 때 게임이 영영 멈추지 않게 하는
	-- 안전장치. 이 시간이 지나면 튜토리얼을 강제 종료하고 정지를 푼다
	property number PauseFailSafeSeconds = 120

	property integer _failSafeTimerId = 0

	-- 첫 웨이브가 제대로 모인 뒤에 멈추기 위한 최소 마릿수(유저 지정: "처음이 5마리였나? 걔네들").
	-- 진입 직후엔 한 마리만 걸어 나와 있을 수 있는데, 그 상태로 멈추면 화면이 허전하다
	property integer AimMinMonsterCount = 4

	-- 첫 몬스터가 보인 뒤 이만큼만 더 기다렸다가 멈춘다. 웨이브는 스폰 큐로 한 마리씩 들어오므로
	-- (MonsterSpawner.ProcessSpawnQueueTick) 곧바로 멈추면 한두 마리만 서 있고, 마릿수만 기다리면
	-- 그 사이에 레벨업이 먼저 나버린다(유저 지적: "레벨업 하면 튜토리얼이 시작되는데 처음에
	-- 몬스터 나올 때부터 시작되어야 해"). 둘 중 **먼저 충족되는 쪽**으로 연다.
	--
	-- ⚠ 몬스터 크기 조건은 일부러 없다 — 어차피 멈춘 뒤 AimMonsterScale로 끌어올리므로,
	-- 크기가 커질 때까지 기다리면 그냥 시작만 늦어진다
	property number AimWaveSettleSeconds = 0.5

	property number _aimSettleElapsed = 0

	-- 멈춘 뒤 몬스터들을 이 크기까지 키운다(유저 지정: "걔네들 크기 살짝 키운 상태,
	-- 맨 뒤에서 나오는 거 말고 중간쯤"). 스케일이 곧 깊이라서 키우면 화면 중간으로 걸어 나온 모습이 되고,
	-- 터치 판정 상자(RequestFocusTarget)도 같은 스케일을 쓰므로 누르기 쉬워진다.
	-- 도달 임계(1.5)보다는 낮게 둬서 "플레이어에게 도착한" 상태로 바뀌지 않게 한다.
	--
	-- ⚠ 복원은 따로 하지 않는다 — 정지가 풀리면 MonsterAI.OnUpdate가 매 프레임
	-- _currentScale 기준으로 Transform.Scale을 다시 쓰므로 그 값에서 자연스럽게 이어진다
	property number AimMonsterScale = 1.15

	-- 몬스터가 끝내 안 다가오는 예외 상황(전부 즉사 등)에서 에임 단계를 영영 못 여는 걸 막는다.
	-- 이 시간이 지나면 크기 조건을 무시하고 그냥 시작한다
	property number AimWaitTimeoutSeconds = 25

	property number _aimWaitElapsed = 0

	-- ── 이스터에그 튜토리얼(유저 지정 2026-09-17) ─────────────────────────────────
	-- 에피1 map04 존4(EasterEggObject 버섯이 있는 존)에 들어가고 EggDelaySeconds 뒤,
	-- 게임 정지 + 월드 딤(버섯·몬스터는 딤 위로 보임) + 손가락이 버섯을 콕콕 + 안내 배너.
	-- 버섯을 누르면(TreasureChestEgg.RequestOpen → NotifyEggObjectOpened) 정지를 풀고 끝, 계정당 1회.
	-- 첫 플레이 온보딩이 진행 중이면 기다렸다가 끝난 뒤에 뜬다. 이미 이번 판에 버섯을 눌러 숨겨진 상태면 안 띄운다.
	-- "봤음" 저장 키는 온보딩과 같은 전역 저장소("PlayerCoins")의 EggTutorialSeen.
	@Sync
	property boolean EggTutorialSeen = false

	@Sync
	property boolean EggActive = false

	property string EggStorageKey = "EggTutorialSeen"
	property integer EggEpisode = 1
	property integer EggZoneIndex = 4
	property string EggObjectPath = "/maps/map04/EasterEggObject"
	property number EggDelaySeconds = 1.0

	-- 존에 들어온 뒤 흐른 시간(-1이면 그 존 밖)
	property number _eggZoneElapsed = -1

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 월드 시작 시 "이미 본 유저인지"를 한 번 읽어 @Sync로 클라이언트에 내려준다
		self._storage = _DataStorageService:GetGlobalDataStorage("PlayerCoins")
		local errorCode, raw = self._storage:GetAndWait(self.StorageKey)
		self.TutorialSeen = (errorCode == 0 and raw == "1")
		local eggCode, eggRaw = self._storage:GetAndWait(self.EggStorageKey)
		self.EggTutorialSeen = (eggCode == 0 and eggRaw == "1")
		log("TutorialLogic started (seen=" .. tostring(self.TutorialSeen) .. ", eggSeen=" .. tostring(self.EggTutorialSeen) .. ")")
	end

	method boolean HasSeenTutorial()
		-- 클라이언트가 "지금 자동으로 띄워야 하는지" 판단할 때 쓰는 접근자
		return self.TutorialSeen
	end

	method boolean IsActive()
		-- CardManager 등 다른 Logic이 튜토리얼 진행 여부를 물을 때 쓰는 접근자
		return self.Active
	end

	method boolean IsWaitingForAim()
		-- 에임 단계(대기 0 / 진행 1)를 아직 안 끝냈는가.
		-- CardManager가 이때 올라온 레벨업 카드를 뒤로 미뤄 순서를 "에임 → 사냥 → 카드"로 고정한다 —
		-- 안 그러면 첫 레벨업이 빨리 터지는 판에서는 에임 안내를 아예 못 보고 지나간다(실측)
		return self.Active and self.Step < 2
	end

	@ExecSpace("Server")
	method void RequestBegin()
		-- 인게임 진입 직후 클라이언트가 호출한다. 이미 본 유저면 서버가 최종적으로 걸러낸다
		if self.TutorialSeen then return end
		if self.Active then return end

		self.Active = true
		self.Step = 0
		self._aimWaitElapsed = 0
		self._aimSettleElapsed = 0
		log("TutorialLogic: begin — waiting for first wave (user=" .. senderUserId .. ")")
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- Step 0 동안만 도는 감시자: 첫 웨이브가 누를 만한 크기로 다가오면 에임 단계를 연다.
		-- ⚠ 이 Logic의 OnUpdate는 TutorialPaused 가드를 걸지 않는다 — 정지를 거는 주체가 여기라서
		-- 자기 자신까지 멈추면 아무도 정지를 풀 수 없다
		self:TickEggTutorial(delta)
		if not self.Active then return end
		if self.Step ~= 0 then return end

		self._aimWaitElapsed = self._aimWaitElapsed + delta

		-- 몬스터가 한 마리라도 보이기 시작하면 그때부터 "웨이브 정착" 타이머를 돌린다
		local alive = _CardManager:GetAliveMonsterCount()
		if alive > 0 then
			self._aimSettleElapsed = self._aimSettleElapsed + delta
		else
			self._aimSettleElapsed = 0
		end

		local ready = false
		if alive > 0 then
			-- 목표 마릿수가 차거나, 잠깐 기다렸으면 바로 연다 — 둘 중 먼저 오는 쪽
			ready = (alive >= self.AimMinMonsterCount)
				or (self._aimSettleElapsed >= self.AimWaveSettleSeconds)
		end
		-- 몬스터가 끝내 안 나오는 예외 상황 대비(전체 타임아웃)
		if not ready and self._aimWaitElapsed >= self.AimWaitTimeoutSeconds then ready = true end
		if not ready then return end

		self.Step = 1
		_GameManager.TutorialPaused = true
		-- ⚠ 연출을 먼저 띄우고 크기 조정은 그 다음에 한다 — 순서가 반대면 크기 조정에서 문제가 생겼을 때
		-- 정지만 걸린 채 안내가 안 뜨는 최악의 상태(게임이 멈췄는데 아무 설명도 없음)가 된다
		self:ShowStepAim()
		-- 몬스터가 딤 "위"에 보여야 하므로 UI 딤이 아니라 월드 딤을 쓴다(CardManager 주석 참고)
		_CardManager:ShowTutorialAimDim()
		-- 정지가 걸린 뒤에 키워야 한다 — MonsterAI.OnUpdate가 살아있으면 다음 프레임에 바로 덮어쓴다
		local grown = _CardManager:GrowMonstersForTutorialAim(self.AimMonsterScale)
		log(string.format("TutorialLogic: aim step opened (waited %.1fs, settle %.1fs, grown=%d, lv=%d)",
			self._aimWaitElapsed, self._aimSettleElapsed, grown, _GameManager.Level))

		-- 카드 단계와 같은 안전장치 — 어떤 이유로든 안 풀리면 강제로 재개시킨다
		self:ClearFailSafe()
		self._failSafeTimerId = _TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			log_warning("TutorialLogic: aim pause fail-safe fired — resuming")
			self:ResumeFromAim()
		end, self.PauseFailSafeSeconds)
	end

	@ExecSpace("ServerOnly")
	method void ResumeFromAim()
		-- 에임 단계에서 빠져나와 게임을 다시 굴린다(정상 통과 / 안전장치 공용 경로)
		self:ClearFailSafe()
		_CardManager:HideTutorialAimDim()
		_GameManager.TutorialPaused = false
		self.Step = 2
		self:ShowStep1()
		-- 에임 단계를 기다리느라 미뤄둔 레벨업이 있으면 지금 꺼내 카드 단계로 이어준다
		_CardManager:FlushPendingLevelUps()
	end

	@ExecSpace("ServerOnly")
	method void NotifyFocusTargetSet()
		-- CardManager.RequestFocusTarget이 실제로 몬스터를 찍었을 때 호출한다.
		-- 에임 단계를 실습으로 통과한 셈이니 정지를 풀고 사냥 단계로 넘긴다(이미 지난 단계면 무시)
		if not self.Active then return end
		if self.Step ~= 1 then return end

		log("TutorialLogic: aim step cleared")
		self:ResumeFromAim()
	end

	@ExecSpace("ServerOnly")
	method void NotifyChoicesShown()
		-- CardManager.GenerateLevelUpChoices가 카드 3장을 띄운 직후 호출한다.
		-- 여기서 게임 전체를 멈춘다 — 몬스터 이동/공격, 스폰, 타임어택 타이머, 플레이어 자동 공격까지
		-- 전부 _GameManager.TutorialPaused 하나로 걸린다(각 OnUpdate 최상단 가드).
		if not self.Active then return end
		if _GameManager.TutorialPaused then return end

		self.Step = 3
		_GameManager.TutorialPaused = true
		self:ShowStep2()

		self:ClearFailSafe()
		self._failSafeTimerId = _TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			log_warning("TutorialLogic: pause fail-safe fired — forcing finish")
			self:Finish()
		end, self.PauseFailSafeSeconds)
	end

	@ExecSpace("ServerOnly")
	method void NotifyCardChosen()
		-- CardManager.SelectLevelUpChoice가 실제로 한 장을 적용한 직후 호출한다
		if not self.Active then return end

		self:Finish()
		self:ShowStep3()
	end

	@ExecSpace("ServerOnly")
	method void Finish()
		-- 정지 해제 + 진행 상태 종료 + "봤음" 저장. 정상 종료와 안전장치가 같은 경로를 탄다
		self:ClearFailSafe()
		_GameManager.TutorialPaused = false
		self.Active = false
		self.Step = 4
		self:MarkSeen()
	end

	@ExecSpace("ServerOnly")
	method void ClearFailSafe()
		-- 안전장치 타이머 정리(중복 등록 방지)
		if self._failSafeTimerId ~= 0 then
			_TimerService:ClearTimer(self._failSafeTimerId)
			self._failSafeTimerId = 0
		end
	end

	@ExecSpace("ServerOnly")
	method void MarkSeen()
		-- 한 번 본 뒤로는 옵션 팝업의 "게임 방법"으로만 다시 볼 수 있다
		if self.TutorialSeen then return end

		self.TutorialSeen = true
		self._storage:SetAndWait(self.StorageKey, "1")
		log("TutorialLogic: marked as seen")
	end

	-- ── 이스터에그 튜토리얼 ──────────────────────────────────────────────────────
	@ExecSpace("ServerOnly")
	method void TickEggTutorial(number delta)
		-- 매 프레임: 에피1 존4에 EggDelaySeconds 머물면 시작. 진행 중에 게임오버가 나면 조용히 취소(다음에 다시 뜸)
		if self.EggActive then
			if _GameManager.GameOver then self:EndEggTutorial(false) end
			return
		end
		if self.EggTutorialSeen or self.Active then return end
		if not _GameManager.GameStarted or _GameManager.GameOver or _GameManager:IsGamePaused() then
			self._eggZoneElapsed = -1
			return
		end
		if _GameManager.SelectedEpisode ~= self.EggEpisode or _MapManager.CurrentMapIndex ~= self.EggZoneIndex then
			self._eggZoneElapsed = -1
			return
		end
		if self._eggZoneElapsed < 0 then self._eggZoneElapsed = 0 end
		self._eggZoneElapsed = self._eggZoneElapsed + delta
		if self._eggZoneElapsed < self.EggDelaySeconds then return end

		local egg = _EntityService:GetEntityByPath(self.EggObjectPath)
		if not isvalid(egg) or not egg.Enable then return end
		self:BeginEggTutorial()
	end

	@ExecSpace("ServerOnly")
	method void BeginEggTutorial()
		self.EggActive = true
		_GameManager.TutorialPaused = true
		self:ShowEggStep(self.EggObjectPath)
		-- 버섯(OrderInLayer 2)·몬스터는 딤(0) 위에 그려진다 — 에임 단계와 같은 월드 딤
		_CardManager:ShowTutorialAimDim()
		log("TutorialLogic: egg tutorial opened (zone " .. self.EggZoneIndex .. ")")

		self:ClearFailSafe()
		self._failSafeTimerId = _TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			log_warning("TutorialLogic: egg tutorial fail-safe fired — resuming")
			self:EndEggTutorial(true)
		end, self.PauseFailSafeSeconds)
	end

	@ExecSpace("ServerOnly")
	method void NotifyEggObjectOpened(string entityPath)
		-- TreasureChestEgg.RequestOpen이 열릴 때마다 부른다 — 튜토리얼 대상 오브젝트가 진행 중에 눌렸으면 끝낸다
		if not self.EggActive then return end
		if entityPath ~= self.EggObjectPath then return end
		log("TutorialLogic: egg tutorial cleared")
		self:EndEggTutorial(true)
	end

	@ExecSpace("ServerOnly")
	method void EndEggTutorial(boolean markSeen)
		-- 정지/딤/손가락 해제. markSeen=false(게임오버로 취소)면 다음에 다시 뜬다
		self:ClearFailSafe()
		_CardManager:HideTutorialAimDim()
		_GameManager.TutorialPaused = false
		self.EggActive = false
		self._eggZoneElapsed = -1
		self:HideEggStep()
		if markSeen and not self.EggTutorialSeen then
			self.EggTutorialSeen = true
			self._storage:SetAndWait(self.EggStorageKey, "1")
			log("TutorialLogic: egg tutorial marked as seen")
		end
	end

	@ExecSpace("Multicast")
	method void ShowEggStep(string objectPath)
		if self:IsServer() then return end
		_TutorialGuideUI:ShowEggStep(objectPath)
	end

	@ExecSpace("Multicast")
	method void HideEggStep()
		if self:IsServer() then return end
		_TutorialGuideUI:HideEggStep()
	end

	@ExecSpace("Multicast")
	method void ShowStepAim()
		-- 아래 네 Multicast는 서버에서도 호출되므로 서버 실행분은 즉시 빠져나온다(UI는 클라 전용)
		if self:IsServer() then return end
		_TutorialGuideUI:ShowStepAim()
	end

	@ExecSpace("Multicast")
	method void ShowStep1()
		if self:IsServer() then return end
		_TutorialGuideUI:ShowStep1()
	end

	@ExecSpace("Multicast")
	method void ShowStep2()
