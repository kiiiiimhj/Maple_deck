@Logic
script RankSeasonLogic extends Logic

	-- 랭킹 주간 시즌 + 시즌 보상(유저 지정 2026-10-06).
	--   · 시즌은 매주 월요일 00:00(한국 시간)에 새로 시작한다. 첫 리셋은 2026-10-12(월) 00:00 —
	--     그 전까지(= 지금까지 쌓인 영구 기록)가 시즌 1이고, 저장소 이름도 예전 그대로(Ranking_<Key>_1)라
	--     기존 기록이 시즌 1 성적으로 그대로 쓰인다.
	--   · 보드(무제한/타임어택)마다 따로 순위 보상: 1위 2000 / 2위 1000 / 3위 500 / 4~10위 300 /
	--     11~30위 200 / 31~50위 100 / 그 밖 50 다이아. 0점(기록 없음)은 보상 없음.
	--   · 시즌이 끝난 뒤 받기 버튼으로 직접 받는다. 안 받으면 그 보드의 새 시즌 기록이 남지 않는다
	--     (GameManager.SubmitRankingScore가 IsSubmitBlocked로 거른다).
	-- 시즌 번호는 RankingConfigData:GetCycleIndex가 이 Logic에 물어본다 — 랭킹 패키지의 제출/조회/스냅샷이
	-- 전부 같은 시즌 번호를 쓰게 하려고 한 곳에 모았다.
	-- 저장: 유저별 UserDataStorage 키 "RankSeason" = JSON { c1, c2 = 보드별 마지막으로 받은 시즌,
	--       p1, p2 = 보드별 마지막으로 기록을 낸 시즌 }. p가 없으면(이 기능 전 기록) 시즌 1을 확인한다.

	property string StorageKey = "RankSeason"
	-- 첫 리셋 시각 = 2026-10-12 00:00 KST = 2026-10-11 15:00 UTC (OnBeginPlay에서 계산)
	property integer FirstResetMs = 0
	property integer WeekMs = 604800000
	property integer KstOffsetMs = 32400000

	-- 순위 상한 → 다이아 (위에서부터 처음 맞는 줄). 마지막 줄은 그 밖 전부
	property any RewardTiers = { {1, 2000}, {2, 1000}, {3, 500}, {10, 300}, {30, 200}, {50, 100} }
	property integer RewardOutside = 50
	property any BoardIds = {1, 2}

	-- 서버 상태(인스턴스당 1명 — 다른 계정 Logic과 같은 전제)
	property boolean _loaded = false
	property string _profileCode = ""
	property string _userId = ""
	property table _claimed = {}
	property table _played = {}
	-- 보드 → { season, rank, amount } (받을 보상이 있을 때만)
	property table _pending = {}
	property integer _pendingComputedSeason = 0
	property boolean _claimBusy = false

	method void OnBeginPlay()
		self.FirstResetMs = DateTime(2026, 10, 11, 15, 0, 0).Elapsed
		log("RankSeasonLogic: firstReset=" .. tostring(self.FirstResetMs) .. " now=" .. tostring(DateTime.UtcNow.Elapsed) .. " season=" .. tostring(self:GetSeasonIndex(DateTime.UtcNow.Elapsed)))
	end

	-- ── 시즌 계산(양쪽 공용) ───────────────────────────────────────────────
	method integer GetSeasonIndex(integer nowMs)
		-- 첫 리셋 전 = 시즌 1, 그 뒤로 월요일마다 +1
		local base = self.FirstResetMs
		if base == 0 then base = DateTime(2026, 10, 11, 15, 0, 0).Elapsed end
		if nowMs < base then return 1 end
		return (nowMs - base) // self.WeekMs + 2
	end

	method integer GetSeasonEndMs(integer season)
		-- 그 시즌이 끝나는(다음 시즌이 시작하는) 순간
		local base = self.FirstResetMs
		if base == 0 then base = DateTime(2026, 10, 11, 15, 0, 0).Elapsed end
		return base + (season - 1) * self.WeekMs
	end

	method integer GetRewardForRank(integer rank)
		if rank <= 0 then return 0 end
		for _, tier in ipairs(self.RewardTiers) do
			if rank <= tier[1] then return tier[2] end
		end
		return self.RewardOutside
	end

	-- ── 로드/저장 ──────────────────────────────────────────────────────────
	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserEnterEvent(UserEnterEvent event)
		local user = _UserService:GetUserEntityByUserId(event.UserId)
		if user == nil then return end
		self._profileCode = user.PlayerComponent.ProfileCode
		self._userId = event.UserId
		local ds = _DataStorageService:GetUserDataStorage(self._profileCode)
		local code, raw = ds:GetAndWait(self.StorageKey)
		if code ~= 0 and code ~= 1000002 then
			log_warning("RankSeasonLogic: load failed code=" .. tostring(code))
			return
		end
		self._claimed = {}
		self._played = {}
		if code == 0 and raw ~= nil and raw ~= "" then
			local t = _HttpService:JSONDecode(raw)
			if t ~= nil then
				for _, id in ipairs(self.BoardIds) do
					self._claimed[id] = math.floor(tonumber(t["c" .. id]) or 0)
					local p = tonumber(t["p" .. id])
					if p ~= nil then self._played[id] = math.floor(p) end
				end
			end
		end
		self._loaded = true
		self:RecomputePending()
		self:PushStatus(event.UserId, 0)
	end

	@ExecSpace("ServerOnly")
	method boolean SaveAndWait()
		local t = {}
		for _, id in ipairs(self.BoardIds) do
			t["c" .. id] = self._claimed[id] or 0
			if self._played[id] ~= nil then t["p" .. id] = self._played[id] end
		end
		local ds = _DataStorageService:GetUserDataStorage(self._profileCode)
		local code = ds:SetAndWait(self.StorageKey, _HttpService:JSONEncode(t))
		if code ~= 0 then
			log_warning("RankSeasonLogic: save failed code=" .. tostring(code))
			return false
		end
		return true
	end

	-- ── 받을 보상 계산 ─────────────────────────────────────────────────────
	@ExecSpace("ServerOnly")
	method void RecomputePending()
		-- 보드마다 "기록을 낸 마지막 시즌"이 이미 끝났고 아직 안 받았으면 그 시즌 순위로 보상을 잡는다
		local season = self:GetSeasonIndex(DateTime.UtcNow.Elapsed)
		self._pending = {}
		for _, id in ipairs(self.BoardIds) do
			local candidate = self._played[id] or 1
			local claimed = self._claimed[id] or 0
			if candidate < season and candidate > claimed then
				local got = self:GetRankAndWait(id, candidate)
				local rank = got.rank
				local score = got.score
				if rank > 0 then
					self._pending[id] = { season = candidate, rank = rank, amount = self:GetRewardForRank(rank) }
					log(string.format("RankSeasonLogic: pending board=%d season=%d rank=%d score=%d amount=%d", id, candidate, rank, score, self._pending[id].amount))
				end
			end
		end
		self._pendingComputedSeason = season
	end

	@ExecSpace("ServerOnly")
	method table GetRankAndWait(integer boardId, integer season)
		-- 내 점수 → 나보다 높은 점수 개수 + 1 = 순위. 0점(기록 없음)이면 0
		local ds = _RankingDataStorageLogic:GetSortableDS(boardId, season)
		if ds == nil then return { rank = 0, score = 0 } end
		local code, myScore = ds:GetAndWait(self._profileCode)
		if code ~= 0 or myScore == nil or myScore <= 0 then return { rank = 0, score = 0 } end
		local errorCode, pages = ds:GetSortedAndWait(SortDirection.Descending, myScore + 1, math.maxinteger)
		if errorCode ~= 0 then
			log_warning("RankSeasonLogic: GetSortedAndWait failed code=" .. tostring(errorCode))
			return { rank = 0, score = 0 }
		end
		local above = 0
		while true do
			local items = pages:GetCurrentPageDatas()
			if items == nil then break end
			for _, item in pairs(items) do
				if item.Value > myScore then above = above + 1 end
			end
			if pages.IsLastPage == true then break end
			pages:MoveToNextPageAndWait()
		end
		return { rank = above + 1, score = myScore }
	end

	@ExecSpace("ServerOnly")
	method void EnsureFresh()
		-- 접속해 있는 동안 월요일이 지나갔으면 다시 계산한다
		if self._loaded and self._pendingComputedSeason ~= self:GetSeasonIndex(DateTime.UtcNow.Elapsed) then
			self:RecomputePending()
		end
	end

	-- ── GameManager(랭킹 제출)가 부르는 것 ─────────────────────────────────
	@ExecSpace("ServerOnly")
	method boolean IsSubmitBlocked(integer boardId)
		-- 지난 시즌 보상을 안 받았으면 새 기록을 남기지 않는다. 로드 실패 때도 막아서
		-- "보상 받을 시즌"이 새 기록으로 덮이는 일이 없게 한다
		if not self._loaded then return true end
		self:EnsureFresh()
		return self._pending[boardId] ~= nil
	end

	@ExecSpace("ServerOnly")
	method void MarkPlayed(integer boardId, integer season)
		-- 기록을 낸 시즌을 적어 둔다 — 시즌이 끝나면 이 시즌 순위로 보상을 확인한다
		if not self._loaded or self._played[boardId] == season then return end
		self._played[boardId] = season
		self:SaveAndWait()
	end

	-- ── 클라이언트 요청 ────────────────────────────────────────────────────
	@ExecSpace("Server")
	method void RequestStatus(integer seq)
		-- 랭킹 탭을 열 때 / 게임 시작 버튼을 누를 때
		if senderUserId ~= self._userId then return end
		self:EnsureFresh()
		self:PushStatus(senderUserId, seq)
	end

	@ExecSpace("ServerOnly")
	method void PushStatus(string userId, integer seq)
		local list = {}
		for _, id in ipairs(self.BoardIds) do
			local p = self._pending[id]
			if p ~= nil then
				list[#list + 1] = { board = id, season = p.season, rank = p.rank, amount = p.amount }
			end
		end
		local nowMs = DateTime.UtcNow.Elapsed
		local season = self:GetSeasonIndex(nowMs)
		self:ReceiveStatus(list, season, self:GetSeasonEndMs(season), nowMs, seq, userId)
	end

	@ExecSpace("Client")
	method void ReceiveStatus(table pending, integer season, integer endMs, integer nowMs, integer seq)
		_RankUI:OnSeasonStatus(pending, season, endMs, nowMs, seq)
	end

	@ExecSpace("Server")
	method void RequestClaim(integer boardId)
		if senderUserId ~= self._userId or not self._loaded or self._claimBusy then return end
		self:EnsureFresh()
		local p = self._pending[boardId]
		if p == nil then
			self:ClaimResult(boardId, 0, senderUserId)
			return
		end
		self._claimBusy = true
		local prev = self._claimed[boardId] or 0
		self._claimed[boardId] = p.season
		-- 받은 기록을 먼저 저장하고 성공했을 때만 지급한다(재접속 중복 수령 방지)
		if not self:SaveAndWait() then
			self._claimed[boardId] = prev
			self._claimBusy = false
			self:ClaimResult(boardId, 0, senderUserId)
			return
		end
		self._pending[boardId] = nil
		-- 클라 연출(보류)이 잔액 갱신보다 먼저 도착하도록 지급보다 앞서 알린다(상점 구매와 같은 순서)
		self:ClaimResult(boardId, p.amount, senderUserId)
		_GameManager:AddDiamond(p.amount)
		_GameManager:FlushDiamondIfDirty()
		self._claimBusy = false
		log(string.format("RankSeasonLogic: claimed board=%d season=%d rank=%d +%d diamond", boardId, p.season, p.rank, p.amount))
		self:PushStatus(senderUserId, 0)
	end

	@ExecSpace("Client")
	method void ClaimResult(integer boardId, integer amount)
		_RankUI:OnSeasonClaimResult(boardId, amount)
	end

end
