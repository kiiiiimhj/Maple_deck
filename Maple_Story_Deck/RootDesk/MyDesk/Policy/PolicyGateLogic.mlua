@Logic
script PolicyGateLogic extends Logic

	-- 지역별 정책(_PolicyService) 게이트 — 2026-09-17 출시 준비로 추가.
	--
	-- PolicyInfo가 주는 값은 2개뿐이다:
	--   ArePaidRandomItemsRestricted : 유료 확률형 아이템(= 현금으로 산 재화로 돌리는 뽑기)이 금지된 지역인가
	--   IsPaidItemTradingAllowed     : 유료 구매 아이템의 유저간 거래 허용 여부
	-- 이 월드엔 유저간 거래가 없으므로 실제로 지키는 건 앞의 하나다.
	-- 우리 뽑기는 다이아로 돌리고 다이아는 상점에서 월드코인(현금)으로 사므로 정확히 규제 대상이다.
	--
	-- ⚠ _PolicyService는 @ReleaseOnly + ServerOnly라 **Maker에서는 항상 nil**을 돌려준다.
	-- 그래서 nil = "규제 없음"으로 보고 기존 동작을 그대로 유지한다(에디터/조회실패에서 뽑기가
	-- 통째로 막히면 개발이 불가능하다). 실제 차단 동작은 배포 환경에서만 확인할 수 있다.
	--
	-- 판단은 플랫폼이 한다 — 어느 지역이 막히는지 우리가 알 필요는 없고, 내려온 플래그만 따르면 된다.

	-- 클라(GachaUI)가 버튼을 끄고 안내를 띄우려고 읽는다
	@Sync
	property boolean PaidGachaBlocked = false

	-- 조회가 끝났는지. 아직이면 클라는 기존 상태를 그대로 둔다(깜빡임 방지)
	@Sync
	property boolean PolicyChecked = false

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserEnterEvent(UserEnterEvent event)
		-- 입장 시 1회 조회한다. AndWait가 아니라 Async를 쓰는 이유는 입장 처리를 멈추지 않기 위해서다
		-- (AttendanceLogic 등 다른 로드가 같은 시점에 몰린다).
		self:CheckFor(event.UserId)
	end

	@ExecSpace("ServerOnly")
	method void CheckFor(string userId)
		-- 지역 정책을 비동기로 조회해 @Sync 플래그로 내려준다.
		--
		-- 출시 환경이 아니면 아예 부르지 않는다 — 그냥 호출하면 엔진이 입장마다
		-- "[LIA-3050] InvalidEnvironment : 출시 환경에서만 동작하는 함수입니다"를 콘솔에 찍는다
		-- (동작에는 문제 없지만 로그가 더러워진다. 엔진 메시지도 이 검사를 쓰라고 안내한다).
		if not Environment:IsPublishedPlay() then
			self.PaidGachaBlocked = false
			self.PolicyChecked = true
			log("PolicyGateLogic: 출시 환경이 아님(Maker) -> 정책 조회 생략, 유료 뽑기 허용")
			return
		end

		_PolicyService:GetPolicyInfoForUserAsync(userId, function(info)
			if info == nil then
				-- Maker이거나 조회 실패 — 규제 없음으로 보고 기존 동작 유지
				self.PaidGachaBlocked = false
				self.PolicyChecked = true
				log("PolicyGateLogic: policy info = nil (Maker 또는 조회 실패) -> 유료 뽑기 허용")
				return
			end

			self.PaidGachaBlocked = info.ArePaidRandomItemsRestricted
			self.PolicyChecked = true
			log("PolicyGateLogic: ArePaidRandomItemsRestricted=" .. tostring(info.ArePaidRandomItemsRestricted)
				.. " IsPaidItemTradingAllowed=" .. tostring(info.IsPaidItemTradingAllowed))
		end)
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- 조회가 끝나 플래그가 내려오면 뽑기 UI를 다시 그린다(입장 직후 몇 프레임 뒤에 도착한다).
		if name == "PaidGachaBlocked" or name == "PolicyChecked" then
			_GachaUI:NotifyPolicyChanged()
		end
	end

	method boolean IsPaidGachaBlocked()
		-- 다른 Logic/UI가 읽는 접근자. 다른 Logic의 property를 직접 읽으면 nil이 나올 수 있어
		-- 이 프로젝트는 항상 접근자를 거친다(GetEquippedKey 등과 같은 규칙).
		return self.PaidGachaBlocked
	end

	method boolean IsPolicyChecked()
		-- 조회 완료 여부 접근자.
		return self.PolicyChecked
	end

end
