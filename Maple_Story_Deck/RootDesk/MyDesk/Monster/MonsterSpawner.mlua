@Logic
script MonsterSpawner extends Logic

	-- 스폰 설정
	property string MonsterModelId = "monster" -- Monster.model EntryKey
	property number SpawnInterval = 4.0       -- 첫 스폰 간격 (초)
	property number MinInterval = 0.6         -- 최소 간격
	property number IntervalDecay = 0.1       -- 웨이브마다 빨라지는 양

	-- 무리 스폰 설정 (한 번에 여러 마리, 맵 하나당)
	property integer BaseSpawnCount = 2       -- 기본 최소 스폰 수 (Wave 1부터)
	property integer SpawnCountVariance = 2   -- 추가 랜덤 범위 (0~variance)
	property integer SpawnCountPerWaves = 2   -- 이 웨이브마다 스폰 수 +1
	property integer MaxSpawnCount = 6        -- 한 번에 최대 스폰 수

	-- 맵 하나에 동시에 존재할 수 있는 일반 몬스터 총 개수 상한(보스는 대상 아님 — 항상 1마리뿐).
	-- 현재 플레이 중인 맵과 그 외(지나간/안 가본) 맵을 분리한다 — 지나간 맵은 아무도 안 죽이는데
	-- 계속 스폰만 되다가 나중에 방문해서 한꺼번에 재개(Resume)되면 몰려있는 것처럼 보이는 현상이 있어서,
	-- 지금 있는 맵보다 더 낮은 상한을 둔다.
	property integer MaxMonstersPerMap = 20
	property integer MaxMonstersPerMapBackground = 10

	-- 내부
	property number _timer = 0
	property boolean _running = false
	property integer _lastEliteWave = 0  -- 이 웨이브엔 이미 엘리트를 냈다 (같은 웨이브에서 중복 스폰 방지)

	-- 엘리트 재등장 주기 (웨이브5 고정 등장 이후, 잡을 때마다 다음 엘리트까지 랜덤 대기)
	property number MinEliteRespawnDelay = 180.0  -- 3분
	property number MaxEliteRespawnDelay = 300.0  -- 5분
	property number _nextEliteTimer = -1  -- -1이면 대기 중 아님
	property any _activeMaps = nil  -- {[mapIndex] = true, ...} — 한 번이라도 방문해서 스폰이 시작된 맵만 기록
	-- 웨이브10 보스는 전역에 동시에 1마리만 존재해야 한다. 이게 없으면 플레이어가 보스를 못 잡고
	-- 여러 맵을 옮겨 다니는 동안(SpawnWave 20초 주기 + ActivateMap의 최초 진입 스폰이 각각 트리거되어)
	-- 맵마다 보스가 하나씩 쌓여서, 나중에 그 맵들을 다시 방문하면 "죽인 보스가 다른 맵에서 또 나오는"
	-- 것처럼 보이는 버그가 생긴다.
	property Entity _currentBoss = nil

	-- 존12 원거리(먹물) 종 전용 고정 스폰 구역 — 유저가 Maker에서 직접 깔아둔 "타일 섬" 발판(FootholdComponent
	-- 레이어 "2", 실측: 월드 X 9.06~15.24, Y 0.9~1.75, 경사/계단 있음). 발판은 항상 맵 루트(월드) 기준이라
	-- Zone12 컨테이너 오프셋과 무관하게 이미 월드 좌표다 — 하드코딩된 Y 대신 GetGroundY로 실제 발판 표면에
	-- 레이캐스트해서 스폰한다(이전엔 Y를 고정값으로 하드코딩해서, 유저가 발판 모양을 바꿀 때마다 실제
	-- 발판 위치와 계속 어긋나 허공에 뜨는 버그가 반복됐다).
	property number RangedTileMinX = 9.5
	property number RangedTileMaxX = 14.8
	-- 이 메커니즘은 존12 전용(맵7~10에는 추가하지 않기로 확정 — 범위 축소)이라 mapIndex 하드코딩을
	-- 유지한다. 아래 GetMapIsRangedSpecies가 이 조건을 감싼다.

	-- 비행형 종(맵15 박쥐) 전용 스폰 높이 범위 — 발판 레이캐스트로 바닥에 고정되지 않고 이 Y 범위
	-- 안에서 공중에 무작위로 스폰된다(이 게임은 몬스터가 실제로 날아다니지 않고 스케일만 커지며
	-- "접근"을 표현하므로, 비행형의 차이는 스폰 높이가 바닥이 아니라 공중이라는 것뿐이다).
	property number FlyingMinY = -0.3
	property number FlyingMaxY = 2.0

	-- 존13~15 전용 스폰 방식: GetZonePlatformBands처럼 발판 좌표를 코드에 하드코딩하는 대신, 매 스폰마다
	-- FootholdComponent를 직접 레이캐스트해서 실제 발판 위에 스폰한다 — 유저가 Maker에서 발판을 옮기거나
	-- 지워도 코드를 다시 맞출 필요가 없다(하드코딩 밴드가 발판 편집 때마다 어긋나던 근본 문제 해결).
	-- 그룹A~C(맵1~10)는 이번엔 손대지 않고 그대로 두고, 이 방식이 안정적으로 검증되면 나중에 전체로 넓힌다.
	property number MinFlatRunWidth = 0.5   -- 이보다 좁게 이어진 발판 구간은 스폰 후보에서 제외
	property number EdgeMarginGround = 0.4  -- 바닥 발판 양끝 제외 여유
	property number EdgeMarginAerial = 0.15 -- 공중 발판 양끝 제외 여유 (좁은 발판이라 넓게 깎으면 폭 비례
	-- 확률 선택에서 거의 안 뽑히는 이중 페널티가 생겨 작게 잡음 — 존13 중앙 발판 폭 0.9 기준 실사용폭
	-- 0.36→0.6로 완화)
	property number AerialHeightThreshold = 0.3  -- 이 맵의 최저 발판 Y보다 이만큼 높으면 "공중 발판"으로 간주
	property number FlatSlopeTolerance = 0.05  -- 발판 시작/끝 Y차가 이 이하면 "수평"으로 간주(엔진 IsHorizontal()이
	-- 사람이 손으로 그린 발판의 미세한 오차까지 엄격히 걸러내면, 눈에는 평평한 기둥 꼭대기 같은 발판이
	-- 계속 걸러져서 후보에서 빠지는 문제가 있어 자체 허용오차로 판정한다)
	property any _baselineGroundYCache = nil  -- {[mapIndex] = y, ...} — 맵마다 한 번만 전체 발판을 훑어 계산

	-- 유저가 존15 중앙 기둥을 지우고 대신 CustomFootholdComponent 오브젝트("foothold-848_1~3", 실측
	-- OwnerId 3개)로 교체함 — 이 3개 발판 위에는 몬스터가 스폰되지 않게 OwnerId로 제외한다. 좌표(X범위)가
	-- 아니라 소유 엔티티 ID로 판정해서, 유저가 Maker에서 이 오브젝트를 옮기거나 크기를 바꿔도 계속 걸러진다.
	property string Zone15ExcludedFootholdOwnerId1 = "9e591620-aa5a-49c1-b23b-d9907ec6f3ba"
	property string Zone15ExcludedFootholdOwnerId2 = "35bc9d79-4793-4039-8357-b37c2cda364a"
	property string Zone15ExcludedFootholdOwnerId3 = "7b48d3a1-c42a-4f2c-8a13-efefddea1917"

	-- 맵10 보너스 스테이지 설정 — 등장하면 정신없이 돌아다니며 무적으로 히트당 보상만 지급하는 보스.
	-- 첫 방문은 100% 등장, 이후 재방문마다 BonusBossChance 확률로 재판정. 실패하면(또는 지속시간이
	-- 끝나면) 맵9와 같은 몬스터 풀을 그대로 재사용하는 평소 웨이브 스폰으로 대체된다.
	property string BonusBossModelId = "bonusboss"       -- BonusBoss.model EntryKey
	property string BonusBossSpriteRUID = "0d577f299dbd49c996f2dac8aee99a23"
	property number BonusBossChance = 0.30
	property number BonusBossDuration = 30.0
	property boolean _map10Visited = false
	property Entity _bonusBoss = nil
	property boolean _bonusBossActive = false

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self._timer = self.SpawnInterval
		-- 타이틀 화면에서 "게임 시작"을 누르기 전까지는 웨이브 타이머가 돌면 안 된다 —
		-- MapManager.BeginGameplay()가 GameManager.StartGame() 시점에 BeginGameplay()를 호출해서 켠다.
		self._running = false
		-- MapManager의 OnBeginPlay가 이것보다 먼저 실행돼 ActivateMap()으로 이미 _activeMaps를
		-- 채워놨을 수 있으므로, nil일 때만 초기화한다 (무조건 덮어쓰면 그 활성화가 날아간다)
		if self._activeMaps == nil then self._activeMaps = {} end
	end

	-- 웨이브1~5는 4.0초로 고정, 웨이브6부터 6.0초에서 시작해 웨이브당 IntervalDecay(0.1초)씩 감소
	-- (최소 MinInterval까지). Wave10 보스는 OnUpdate에서 별도로 20초 고정 처리한다.
	method number GetSpawnInterval(integer wave)
		if wave <= 5 then return 4.0 end
		return math.max(self.MinInterval, 6.0 - self.IntervalDecay * (wave - 6))
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if not self._running then return end
		if self.MonsterModelId == "" then return end

		self._timer = self._timer - delta
		if self._timer <= 0 then
			self:SpawnWave()
			-- Wave 10 보스만 20초 간격(15초 접근 + 여유), 11부터는 다시 일반 웨이브처럼 점점 빨라짐
			if _GameManager.Wave == 10 then
				self._timer = 20.0
			else
				self._timer = self:GetSpawnInterval(_GameManager.Wave)
			end
		end

		if self._nextEliteTimer > 0 then
			self._nextEliteTimer = self._nextEliteTimer - delta
			if self._nextEliteTimer <= 0 then
				self._nextEliteTimer = -1
				self:SpawnRandomElite()
			end
		end
	end

	-- 현재 웨이브에 맞는 몬스터를 스폰한다. 일반 몬스터는 "이미 한 번 방문해서 활성화된" 맵에만 동시에
	-- 등장하고(안 가본 맵은 스폰 안 됨), 보스/엘리트는 플레이어가 실제로 있는 맵에서만 1번 등장한다
	@ExecSpace("ServerOnly")
	method void SpawnWave()
		local wave = _GameManager.Wave
		local currentMap = self:GetCurrentMap()

		if wave == 10 then
			-- 보스: 정확히 웨이브10에서만, 플레이어가 있는 맵에 1마리. 11부터는 else 분기로 이어져
			-- 지금까지 나온 몬스터들이 섞인 일반 웨이브가 계속된다 (무한 웨이브)
			-- 이미 어딘가에 살아있는 보스가 있으면 새로 스폰하지 않는다 (전역 1마리 제한)
			if isvalid(self._currentBoss) then return end
			if currentMap == nil then return end
			local mapIndex = _MapManager.CurrentMapIndex
			if self:IsNoMonsterZone(mapIndex) then return end
			local spawned = self:SpawnBatchOnMap(currentMap, wave, true, false, mapIndex)
			if #spawned > 0 then self._currentBoss = spawned[1] end
		else
			-- 일반 웨이브: 활성화된(=한 번 이상 방문한) 맵에만 동시 스폰. 엘리트는 플레이어가 있는 맵의 무리에서만 뽑는다
			if self._activeMaps == nil then return end
			for idx = _MapManager.MinMapIndex, _MapManager.MaxMapIndex do
				-- 맵10에 보너스 보스가 떠 있는 동안은 평소 웨이브 몬스터를 같이 스폰하지 않는다
				if idx == 10 and self._bonusBossActive then continue end
				-- 존18(그림자 존 안전지대)은 몬스터가 아예 없어야 한다
				if self:IsNoMonsterZone(idx) then continue end
				if self._activeMaps[idx] then
					local map = self:GetZoneEntity(idx)
					if map ~= nil then
						self:SpawnBatchOnMap(map, wave, false, map == currentMap, idx)
					end
				end
			end
		end
	end

	-- 몬스터가 절대 스폰되지 않아야 하는 맵/존 — 지금은 존18(그림자 존 안전지대)만 해당.
	@ExecSpace("ServerOnly")
	method boolean IsNoMonsterZone(integer mapIndex)
		return mapIndex == 18
	end

	-- 존별 스폰 X 오프셋 — MapManager.ZoneInfo가 단일 진실 소스다(그룹A/B/C로 존이 늘어나도 여기 손댈
	-- 필요 없음). 이 값은 아래 GetSpawnPosition의 "±5 범위" 로컬 스폰 로직의 중심으로 쓰인다.
	@ExecSpace("ServerOnly")
	method number GetZoneOffsetX(integer mapIndex)
		local info = _MapManager:GetZoneInfo(mapIndex)
		return (info ~= nil) and info.spawnX or 0
	end

	-- mapIndex가 가리키는 "존"의 실제 엔티티(스폰 부모/일시정지 스코프용)를 반환한다. MapManager.ZoneInfo에서
	-- 물리 파일/자식 컨테이너 이름을 조회 — container가 nil이면 맵 루트 자신, 아니면 그 자식 컨테이너.
	@ExecSpace("ServerOnly")
	method Entity GetZoneEntity(integer mapIndex)
		local info = _MapManager:GetZoneInfo(mapIndex)
		local fileName = (info ~= nil) and info.file or string.format("map%02d", mapIndex)
		local rootMap = _EntityService:GetEntityByPath("/maps/" .. fileName)
		if rootMap == nil then return nil end
		if info ~= nil and info.container ~= nil then
			return rootMap:GetChildByName(info.container, false)
		end
		return rootMap
	end

	-- GameManager.OnBossDefeated()가 보스 처치 시점에 호출 — 다음 SpawnWave/ActivateMap 틱부터
	-- 다시 보스를 스폰할 수 있게 참조를 비운다 (사실상 Wave가 곧 11로 넘어가 다시 안 쓰이지만,
	-- 넘어가기 직전의 짧은 틈에도 중복 스폰을 막기 위해 명시적으로 정리한다)
	@ExecSpace("ServerOnly")
	method void ClearCurrentBoss()
		self._currentBoss = nil
	end

	-- GameManager.OnMonsterKilled()가 웨이브9 진행도 80% 시점에 호출 — SpawnWave()의 wave==10 분기와
	-- 동일한 스폰을 실제 Wave가 아직 9일 때 앞당겨 실행한다. wave 파라미터는 10을 그대로 넘겨서
	-- 보스 모델/스탯(WaveMonsterModelId[10] 등)은 원래와 동일하게 유지한다.
	@ExecSpace("ServerOnly")
	method void TrySpawnBossEarly()
		if isvalid(self._currentBoss) then return end
		local currentMap = self:GetCurrentMap()
		if currentMap == nil then return end
		local mapIndex = _MapManager.CurrentMapIndex
		if self:IsNoMonsterZone(mapIndex) then return end
		local spawned = self:SpawnBatchOnMap(currentMap, 10, true, false, mapIndex)
		if #spawned > 0 then self._currentBoss = spawned[1] end
	end

	-- MapManager가 호출: 플레이어가 이 맵에 처음 도착했을 때 스폰을 활성화하고, 그 자리에서 바로 한 무리를
	-- 즉시 스폰한다(이동하기 전까지 진행된 현재 웨이브 기준). 이미 활성화된 맵이면 아무 것도 하지 않는다.
	@ExecSpace("ServerOnly")
	method void ActivateMap(integer mapIndex)
		-- 다른 Logic의 OnBeginPlay가 이것보다 먼저 실행돼 _activeMaps가 아직 nil일 수 있으므로 지연 초기화
		if self._activeMaps == nil then self._activeMaps = {} end
		if self._activeMaps[mapIndex] then return end
		self._activeMaps[mapIndex] = true
		if self:IsNoMonsterZone(mapIndex) then return end

		local map = self:GetZoneEntity(mapIndex)
		if map == nil then return end

		local wave = _GameManager.Wave
		if wave == 10 then
			-- 처음 도착한 맵이라도 이미 다른 맵에 보스가 살아있으면 여기서 또 스폰하지 않는다
			if isvalid(self._currentBoss) then return end
			local spawned = self:SpawnBatchOnMap(map, wave, true, false, mapIndex)
			if #spawned > 0 then self._currentBoss = spawned[1] end
		else
			-- 지금 도착한 맵이 곧 "플레이어가 있는 맵"이므로 엘리트 후보 자격도 준다
			self:SpawnBatchOnMap(map, wave, false, true, mapIndex)
		end
	end

	-- 지정한 맵 하나에 몬스터 무리를 스폰. allowElite=true인 호출에서만 엘리트 승급 후보가 된다.
	-- 스폰되는 맵이 플레이어의 현재 맵이 아니라고 "확실히" 판단될 때만 새로 태어난 몬스터를 일시정지시킨다 —
	-- 안 그러면 화면 밖 맵에서 계속 새로 스폰되는 애들이 기본값(안 멈춤)으로 태어나서 몰래 공격한다.
	-- 반대로 GetCurrentMap()이 nil(아직 어느 맵인지 모름 — 월드 시작 직후 _UserService.UserEntities가
	-- 비어있는 순간과 겹칠 수 있음)이면 "다른 맵"으로 단정하지 않고 활성 상태로 스폰한다 — 그렇지 않으면
	-- 게임 시작하자마자 첫 맵의 몬스터가 통째로 멈춰있는 채로 태어나는 버그가 생긴다.
	@ExecSpace("ServerOnly")
	method table SpawnBatchOnMap(Entity map, integer wave, boolean isBoss, boolean allowElite, integer mapIndex)
		local currentMap = self:GetCurrentMap()
		local isCurrentMap = (currentMap == nil) or (map == currentMap)

		local count = 1
		if not isBoss then
			local variance = math.floor(_UtilLogic:RandomDouble() * (self.SpawnCountVariance + 1))
			if wave <= 10 then
				count = self.BaseSpawnCount + variance + math.floor((wave - 1) / self.SpawnCountPerWaves)
			else
				-- 웨이브10 보스 이후(무한 웨이브)는 체력/공격력이 계속 커지는 쪽으로 난이도를 올리므로
				-- 마리 수는 다시 초반 수준으로 되돌린다 — 안 그러면 "이미 최대치(6마리)인데 한 마리당
				-- 체력도 계속 늘어나는" 이중 스케일링으로 순식간에 감당 불가능해진다
				count = self.BaseSpawnCount + variance
			end
			count = math.min(count, self.MaxSpawnCount)

			-- 이미 이 맵에 몬스터가 상한만큼 쌓여있으면 이번 스폰은 건너뛴다 (오래 방치된 맵 몬스터 무한 누적 방지)
			-- — 지금 있는 맵은 MaxMonstersPerMap, 그 외(지나간/안 가본) 맵은 더 낮은 MaxMonstersPerMapBackground 적용
			local maxForThisMap = isCurrentMap and self.MaxMonstersPerMap or self.MaxMonstersPerMapBackground
			local existingCount = #map:GetChildComponentsByTypeName("script.MonsterAI", false)
			if existingCount >= maxForThisMap then return {} end
			count = math.min(count, maxForThisMap - existingCount)
			if count <= 0 then return {} end
		end

		local spawned = {}
		for i = 1, count do
			-- 맵 전용 풀(zoneIndex>=7)은 종을 먼저 뽑아서 스폰 위치 결정에도 같이 써야 한다 —
			-- 원거리 종은 중앙 구역에만, 근접 종은 중앙을 피해서 스폰시키려면 위치보다 종 선택이 먼저 필요하다
			local speciesIdx = self:RollSpeciesForMap(mapIndex)
			local pos = self:GetSpawnPosition(mapIndex, isBoss, speciesIdx, map)

			local entity = _SpawnService:SpawnByModelId(
				self.MonsterModelId,
				"Monster",
				self:ToLocalSpawnPos(map, pos),
				map
			)
			if entity == nil then
				log_error("MonsterSpawner: SpawnByModelId failed")
			else
				---@type MonsterAI
				local ai = entity:GetComponent("script.MonsterAI")
				if ai ~= nil then
					ai:InitializeStats(mapIndex, wave, isBoss, speciesIdx)
					if not isCurrentMap then ai:Pause() end
				end
				table.insert(spawned, entity)
			end
		end

		-- 웨이브 5(딱 한 번)에만 플레이어가 있는 맵의 스폰 그룹 중 1마리를 엘리트로 승급한다.
		-- 웨이브10 보스 이후(11부터의 무한 웨이브)는 지금까지 나온 몬스터가 섞여서 나오되 보스/엘리트는
		-- 제외한 "일반 몬스터"만 나와야 하므로 wave<=10으로 명시적으로 막는다.
		if allowElite and wave <= 10 and wave % 10 == 5 and wave ~= self._lastEliteWave and #spawned > 0 then
			self._lastEliteWave = wave
			local eliteIdx = _UtilLogic:RandomIntegerRange(1, #spawned)
			---@type MonsterAI
			local ai = spawned[eliteIdx]:GetComponent("script.MonsterAI")
			if ai ~= nil then ai:MarkElite() end
		end

		local label = isBoss and "BOSS" or "monster(s)"
		log("MonsterSpawner: spawned " .. count .. " " .. label .. " on " .. map.Name .. " (Wave " .. wave .. ")")
		return spawned
	end

	-- MonsterAI.Die()가 엘리트 처치 시점에 호출 — 다음 엘리트 등장까지 3~5분 랜덤 대기를 시작한다
	@ExecSpace("ServerOnly")
	method void OnEliteKilled()
		self._nextEliteTimer = self.MinEliteRespawnDelay + _UtilLogic:RandomDouble() * (self.MaxEliteRespawnDelay - self.MinEliteRespawnDelay)
		log("MonsterSpawner: next elite in " .. math.floor(self._nextEliteTimer) .. "s")
	end

	-- _nextEliteTimer 만료 시 호출 — 플레이어가 있는 맵에 엘리트 몬스터 1마리를 즉시 스폰한다
	@ExecSpace("ServerOnly")
	method void SpawnRandomElite()
		local map = self:GetCurrentMap()
		if map == nil then
			-- 플레이어 위치를 아직 모르면 잠시 후 재시도
			self._nextEliteTimer = 5.0
			return
		end
		if self:IsNoMonsterZone(_MapManager.CurrentMapIndex) then
			-- 존18(안전지대)에 있는 동안은 엘리트도 스폰하지 않는다 — 다음 타이머에 다시 시도
			self._nextEliteTimer = 5.0
			return
		end

		local mapIndex = _MapManager.CurrentMapIndex
		local wave = _GameManager.Wave
		local speciesIdx = self:RollSpeciesForMap(mapIndex)
		local pos = self:GetSpawnPosition(mapIndex, false, speciesIdx, map)
		local entity = _SpawnService:SpawnByModelId(self.MonsterModelId, "Monster", self:ToLocalSpawnPos(map, pos), map)
		if entity == nil then
			log_error("MonsterSpawner: SpawnRandomElite failed")
			return
		end

		---@type MonsterAI
		local ai = entity:GetComponent("script.MonsterAI")
		if ai ~= nil then
			ai:InitializeStats(mapIndex, wave, false, speciesIdx)
			ai:MarkElite()
		end
		log("MonsterSpawner: random elite spawned on " .. map.Name)
	end

	-- 맵 전용 몬스터 풀(zoneIndex>=7)에서 쓸 종 인덱스를 미리 뽑는다. 스폰 위치 결정(GetSpawnPosition)과
	-- 외형 초기화(MonsterAI.InitializeStats)가 같은 종을 참조해야 해서 두 호출보다 먼저 실행한다.
	-- 맵1~6은 풀 개념이 없으므로 0(= "위치 로직에서 무시") 반환.
	@ExecSpace("ServerOnly")
	method integer RollSpeciesForMap(integer mapIndex)
		if mapIndex < 7 then return 0 end
		local appearanceZone = self:ResolveAppearanceZone(mapIndex)
		return _UtilLogic:RandomIntegerRange(1, _GameManager:GetMapMonsterCount(appearanceZone))
	end

	-- 맵10(보너스 스테이지)은 별도 풀이 없고 맵9 풀을 그대로 재사용한다 — MonsterAI.InitializeStats와
	-- 동일한 규칙을 스폰 위치 결정 쪽에서도 써야 해서 별도 헬퍼로 뽑아둔다
	@ExecSpace("ServerOnly")
	method integer ResolveAppearanceZone(integer mapIndex)
		if mapIndex == 10 then return 9 end
		return mapIndex
	end

	-- speciesIdx가 가리키는 종이 이 맵(zoneIndex>=7) 풀에서 원거리(먹물) 종인지 여부
	@ExecSpace("ServerOnly")
	method boolean GetMapIsRangedSpecies(integer mapIndex, integer speciesIdx)
		return _GameManager:GetMapIsRanged(self:ResolveAppearanceZone(mapIndex), speciesIdx)
	end

	-- speciesIdx가 가리키는 종이 이 맵(zoneIndex>=7) 풀에서 비행형 종인지 여부 (지금은 맵15의 박쥐만 해당)
	@ExecSpace("ServerOnly")
	method boolean GetMapIsFlyingSpecies(integer mapIndex, integer speciesIdx)
		return _GameManager:GetMapIsFlying(self:ResolveAppearanceZone(mapIndex), speciesIdx)
	end

	-- safeMin~safeMax 범위에서 avoidMin~avoidMax 구간을 제외하고 X를 뽑는다. 좌/우 남은 폭에 비례해서
	-- 어느 쪽에서 뽑을지 정하므로, 한쪽 폭이 0이어도(구간이 끝에 붙어있어도) 자연스럽게 반대쪽만 나온다.
	@ExecSpace("ServerOnly")
	method number RollXAvoidingRange(number safeMin, number safeMax, number avoidMin, number avoidMax)
		local leftWidth = math.max(0, avoidMin - safeMin)
		local rightWidth = math.max(0, safeMax - avoidMax)
		local totalWidth = leftWidth + rightWidth
		if totalWidth <= 0 then
			-- 피할 구간이 안전범위 전체를 덮으면(설정 실수 등) 그냥 안전범위 전체에서 뽑는다
			return safeMin + _UtilLogic:RandomDouble() * (safeMax - safeMin)
		end
		local roll = _UtilLogic:RandomDouble() * totalWidth
		if roll < leftWidth then
			return safeMin + roll
		else
			return avoidMax + (roll - leftWidth)
		end
	end

	-- 실제로 플레이어가 있는 맵을 찾는다 (보스/엘리트 스폰 위치 판정용, 스폰 시 일시정지 여부 판정용).
	-- 그룹D 병합(맵11+12가 같은 map11.map 파일)으로 CurrentMapName만으로는 11/12를 구분할 수 없게
	-- 됐다 — 대신 MapManager.CurrentMapIndex(버튼 이동 때마다 확정적으로 갱신됨)를 신뢰하고,
	-- GetZoneEntity로 맵 루트 또는 Zone12 자식 컨테이너를 구분해서 반환한다.
	@ExecSpace("ServerOnly")
	method Entity GetCurrentMap()
		return self:GetZoneEntity(_MapManager.CurrentMapIndex)
	end

	-- SpawnByModelId의 spawnPosition은 parent 기준 로컬 좌표다. GetSpawnPosition은 발판 레이캐스트를
	-- 위해 항상 월드 좌표를 계산해 반환하므로(Zone12처럼 parent 자체가 오프셋을 가진 컨테이너일 수 있음),
	-- 실제 스폰 직전에 parent의 WorldPosition을 빼서 로컬로 변환해야 한다. 이걸 빼먹으면 Zone12(오프셋 +25)
	-- 컨테이너 밑에서 오프셋이 두 번 겹쳐 적용돼(발판 계산의 +15 오프셋 + 부모의 +25 오프셋) 몬스터가
	-- 발판 오른쪽 끝(33.92)을 한참 벗어난 곳(35~45)에서 스폰되는 버그가 있었다(parent가 원점인 다른 맵은
	-- WorldPosition이 (0,0,0)이라 이 변환이 항등이므로 기존 동작에 영향 없음).
	-- 맵 루트 엔티티(map01 등)는 애초에 TransformComponent 자체가 없다(실측 확인 — [LEA-2007] AttemptToIndex)
	-- 이 경우 오프셋 없이 worldPos를 그대로 쓰면 된다(루트는 항상 원점이므로 로컬==월드).
	@ExecSpace("ServerOnly")
	method Vector3 ToLocalSpawnPos(Entity parent, Vector3 worldPos)
		local transform = parent.TransformComponent
		if transform == nil then return worldPos end
		local parentWorld = transform.WorldPosition
		return Vector3(worldPos.x - parentWorld.x, worldPos.y - parentWorld.y, worldPos.z - parentWorld.z)
	end

	-- x좌표 위치의 발판 Y값을 찾아서 반환한다 (발판이 없으면 0에 스폰 — 맵마다 발판 높이가 달라도 항상 바닥 위에 스폰되도록)
	@ExecSpace("ServerOnly")
	method number GetGroundY(Entity map, number x)
		if map == nil then return 0 end
		---@type FootholdComponent
		local foothold = map:GetComponent("FootholdComponent")
		if foothold == nil then return 0 end

		local hit = foothold:Raycast(Vector2(x, 100), Vector2(0, -1), 200)
		if hit == nil then return 0 end
		return hit:GetYByX(x)
	end

	-- 맵4~6은 바닥 발판 + 공중 발판이 따로 있어서(getFootholds()로 확인한 좌표를 그대로 하드코딩),
	-- 아래로 레이캐스트하는 GetGroundY 방식으로는 맨 위 발판만 걸려 공중 발판에 스폰이 안 된다.
	-- 발판 폭에 비례한 확률로 밴드를 하나 고르고 그 안에서 X를 뽑아 "타일이 있는 곳은 다 등장 가능"하게 한다.
	@ExecSpace("ServerOnly")
	method table GetZonePlatformBands(integer mapIndex)
		if mapIndex == 4 then
			return {
				{ y = -1.22, xMin = -7.15, xMax = 7.15 },   -- 바닥
				{ y = 1.18, xMin = -7.15, xMax = -0.95 },   -- 좌측 공중 발판
			}
		elseif mapIndex == 5 then
			return {
				{ y = -1.22, xMin = -7.15, xMax = 7.15 },   -- 바닥
				{ y = 1.18, xMin = 0.05, xMax = 7.15 },     -- 우측 공중 발판
			}
		elseif mapIndex == 6 then
			return {
				{ y = -1.22, xMin = -7.15, xMax = 7.15 },   -- 바닥
				{ y = 1.78, xMin = -1.75, xMax = 1.75 },    -- 중앙 공중 발판
			}
		elseif mapIndex == 8 then
			-- 맵8 중앙은 낮은 언덕 구조다 — 바닥(y=-1.18)에서 완만한 경사(슬로프)로 올라가 중앙에
			-- 평평한 정상부(y=2.42)가 있고, 반대쪽 경사로 다시 내려온다. 이전에 그룹C 병합 데이터가
			-- 일부 유실돼 "석조 아치"로 잘못 파악했던 적이 있는데(발판 173개 전량 재검증 후 재병합으로
			-- 수정 완료), 실제 발판 데이터 기준으로 다시 확인한 정확한 형태다. 경사면 자체는 밴드가
			-- 표현할 수 없는 구간이라 스폰 대상에서 자연히 빠지고(밴드는 고정 Y만 쓰므로), 바닥과
			-- 언덕 정상 평지 두 곳만 명시한다.
			return {
				{ y = -1.18, xMin = -7.07, xMax = 7.07 },   -- 바닥
				{ y = 2.42, xMin = -3.15, xMax = 1.35 },    -- 언덕 정상 평지
			}
		elseif mapIndex == 9 then
			-- 맵9는 우측에 장식용 절벽 발판(계단식, y≈2.6~4.6)이 따로 있는데 이건 배경 연출 전용이라
			-- 밴드를 바닥 하나로만 명시해서 몬스터가 그 위로는 절대 스폰되지 않게 한다
			return {
				{ y = -1.18, xMin = -7.15, xMax = 7.15 },   -- 바닥만
			}
		elseif mapIndex == 10 then
			-- 맵10(보너스 스테이지)은 보너스 보스가 없을 때 맵9와 같은 몬스터 풀로 폴백 스폰될 때 쓰인다
			return {
				{ y = -1.18, xMin = -7.07, xMax = 7.07 },   -- 바닥만
			}
		end
		-- 존13~15는 더 이상 하드코딩 밴드를 쓰지 않는다 — GetSpawnPositionFromFootholds가 FootholdComponent를
		-- 직접 레이캐스트해서 실제 발판을 찾는다(위 주석 "존13~15 전용 스폰 방식" 참고).
		return nil
	end

	-- 존13~15 전용: 랜덤 X를 쏴서 "맞으면 쓰고 아니면 다시 쏘는" 방식 대신, FootholdComponent가 이미
	-- 알고 있는 발판 전체(GetFootholdAll)를 한 번에 훑어서 밟을 수 있는 평평한 구간을 직접 뽑고, 그중
	-- 하나를 폭 비례 확률로 고른다 — "밟을 수 있는지" 판단은 이미 GetFlatRuns가 코드로 갖고 있으니
	-- 그 결과에만 스폰하면 된다.
	@ExecSpace("ServerOnly")
	method Vector3 GetSpawnPositionFromFootholds(integer mapIndex, boolean isBoss, Entity map)
		local mapName = _MapManager:GetMapName(mapIndex)
		local rootMap = _EntityService:GetEntityByPath("/maps/" .. mapName)
		local offsetX = self:GetZoneOffsetX(mapIndex)
		if rootMap == nil then return Vector3(offsetX, 0, 0) end

		---@type FootholdComponent
		local footholdComp = rootMap:GetComponent("FootholdComponent")
		if footholdComp == nil then return Vector3(offsetX, 0, 0) end

		local runs = self:GetFlatRuns(footholdComp)
		local baselineY = self:GetBaselineGroundY(mapIndex, footholdComp)

		if isBoss then
			-- 보스는 임팩트를 위해 존 중앙을 포함하는 바닥(baselineY) 구간에 고정 스폰
			for i = 1, #runs do
				if math.abs(runs[i].y - baselineY) <= self.FlatSlopeTolerance and offsetX >= runs[i].xMin and offsetX <= runs[i].xMax then
					return Vector3(offsetX, runs[i].y, 0)
				end
			end
			return Vector3(offsetX, baselineY, 0)
		end

		local safeMin = offsetX - 5
		local safeMax = offsetX + 5

		-- 폭 비례 확률만 쓰면 공중 발판처럼 좁은 구간은 계속 안 뽑힐 수 있다 — 그래서 폭 비례로 고르기
		-- 전에, 비어있는(몬스터가 하나도 없는) 공중 발판이 있으면 이번 스폰은 그쪽에 무조건 먼저 배정한다.
		-- 이미 몬스터가 있으면 더 채우지 않고 아래 폭 비례 선택(주로 바닥)으로 넘어간다.
		if map ~= nil then
			for i = 1, #runs do
				local run = runs[i]
				local runWidth = run.xMax - run.xMin
				local isAerial = run.y > baselineY + self.AerialHeightThreshold
				local isExcluded = mapIndex == 15 and self:IsExcludedZone15Foothold(run.ownerId)
				if isAerial and runWidth >= self.MinFlatRunWidth and not isExcluded and not self:IsRunOccupied(map, run) then
					local margin = math.min(self.EdgeMarginAerial, runWidth * 0.3)
					local xMin = math.max(run.xMin + margin, safeMin)
					local xMax = math.min(run.xMax - margin, safeMax)
					if xMax > xMin then
						local x = xMin + _UtilLogic:RandomDouble() * (xMax - xMin)
						return Vector3(x, run.y, 0)
					end
				end
			end
		end

		-- 화면 안전 범위(±5)로 클램프하고, 폭/양끝 여유 조건을 만족하는 구간만 후보로 남긴다
		local candidates = {}
		local totalWidth = 0
		for i = 1, #runs do
			local run = runs[i]
			local runWidth = run.xMax - run.xMin
			local isExcluded = mapIndex == 15 and self:IsExcludedZone15Foothold(run.ownerId)
			if runWidth >= self.MinFlatRunWidth and not isExcluded then
				local isAerial = run.y > baselineY + self.AerialHeightThreshold
				local margin = math.min(isAerial and self.EdgeMarginAerial or self.EdgeMarginGround, runWidth * 0.3)
				local xMin = math.max(run.xMin + margin, safeMin)
				local xMax = math.min(run.xMax - margin, safeMax)
				if xMax > xMin then
					local width = xMax - xMin
					table.insert(candidates, { y = run.y, xMin = xMin, xMax = xMax, width = width })
					totalWidth = totalWidth + width
				end
			end
		end

		if #candidates == 0 then
			-- 화면 범위 안에 유효한 구간이 없으면(예: 핏폴 구멍 위) 존 중앙 바닥으로 안전 폴백
			return Vector3(offsetX, baselineY, 0)
		end

		local roll = _UtilLogic:RandomDouble() * totalWidth
		local chosen = candidates[1]
		local acc = 0
		for i = 1, #candidates do
			acc = acc + candidates[i].width
			if roll <= acc then
				chosen = candidates[i]
				break
			end
		end

		local x = chosen.xMin + _UtilLogic:RandomDouble() * (chosen.xMax - chosen.xMin)
		return Vector3(x, chosen.y, 0)
	end

	-- run(발판 구간) 범위 안에 이미 살아있는 몬스터가 있는지 확인한다. "비어있는 특수 발판을 우선
	-- 채운다" 로직의 존재 여부 판정에 쓰인다.
	@ExecSpace("ServerOnly")
	---@param run any
	method boolean IsRunOccupied(Entity map, any run)
		local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		for i = 1, #monsters do
			local pos = monsters[i].Entity.TransformComponent.WorldPosition
			if pos.x >= run.xMin - 0.2 and pos.x <= run.xMax + 0.2 and math.abs(pos.y - run.y) <= 0.5 then
				return true
			end
		end
		return false
	end

	-- run의 소유 엔티티(ownerId)가 존15 foothold-848 오브젝트 3개 중 하나인지 확인한다.
	@ExecSpace("ServerOnly")
	method boolean IsExcludedZone15Foothold(string ownerId)
		return ownerId == self.Zone15ExcludedFootholdOwnerId1
			or ownerId == self.Zone15ExcludedFootholdOwnerId2
			or ownerId == self.Zone15ExcludedFootholdOwnerId3
	end

	-- FootholdComponent가 가진 발판 전체를 한 번 훑어서, 이어진 평평한 구간(run)별로 { y, xMin, xMax }를
	-- 만든다. 개별 발판 조각(예: 길이 0.9) 하나만 보면 바닥도 "좁다"고 오판하기 쉬워서, 실제로 연결된
	-- 전체 폭을 기준으로 판단해야 한다.
	@ExecSpace("ServerOnly")
	method table GetFlatRuns(FootholdComponent footholdComp)
		local all = footholdComp:GetFootholdAll()
		local visited = {}
		local runs = {}
		for i = 1, #all do
			local seg = all[i]
			if not visited[seg.Id] and self:IsFlatSegment(seg) then
				local bounds = self:GetFlatRunBounds(footholdComp, seg)
				local xMin, xMax = bounds.xMin, bounds.xMax
				visited[seg.Id] = true

				local prevId = seg.PreviousFootholdId
				while prevId ~= 0 do
					local prev = footholdComp:GetFoothold(prevId)
					if prev == nil or not self:IsFlatSegment(prev) or math.abs(prev.StartPoint.y - seg.StartPoint.y) > self.FlatSlopeTolerance then break end
					visited[prev.Id] = true
					prevId = prev.PreviousFootholdId
				end

				local nextId = seg.NextFootholdId
				while nextId ~= 0 do
					local nxt = footholdComp:GetFoothold(nextId)
					if nxt == nil or not self:IsFlatSegment(nxt) or math.abs(nxt.StartPoint.y - seg.StartPoint.y) > self.FlatSlopeTolerance then break end
					visited[nxt.Id] = true
					nextId = nxt.NextFootholdId
				end

				table.insert(runs, { y = seg.StartPoint.y, xMin = xMin, xMax = xMax, ownerId = seg.OwnerId })
			end
		end
		return runs
	end

	-- hit이 속한 발판이 앞뒤로 같은 높이(수평)인 이웃과 계속 이어지는 만큼을 따라가서, 실제로 연결된
	-- 평평한 구간 전체의 xMin/xMax를 구한다. 개별 발판 조각(예: 길이 0.9) 하나만으로는 "좁다"고 오판하기
	-- 쉬워서(바닥도 여러 조각이 이어붙어 만들어짐), 이어진 전체 폭을 기준으로 좁은지 판단해야 한다.
	-- 반환타입을 "number, number"(다중 반환)로 선언하면 Maker 컴파일러가 [LEA-3015] CannotLoad
	-- ("Sequence contains no elements")를 내며 이 파일 전체 로드에 실패한다(실측 확인 — 파라미터가
	-- 없는 다중 반환 선언(예: 엔진 네이티브 GetBound())은 문제없지만, 파라미터가 있는 사용자 정의
	-- 다중 반환 메서드에서 재현됨). 그래서 xMin/xMax를 테이블 하나에 담아 단일 반환값으로 우회한다.
	@ExecSpace("ServerOnly")
	---@param hit Foothold
	method table GetFlatRunBounds(FootholdComponent footholdComp, any hit)
		local y = hit.StartPoint.y
		local xMin = hit.StartPoint.x
		local xMax = hit.EndPoint.x

		local prevId = hit.PreviousFootholdId
		while prevId ~= 0 do
			local prev = footholdComp:GetFoothold(prevId)
			if prev == nil or not self:IsFlatSegment(prev) or math.abs(prev.StartPoint.y - y) > self.FlatSlopeTolerance then break end
			xMin = prev.StartPoint.x
			prevId = prev.PreviousFootholdId
		end

		local nextId = hit.NextFootholdId
		while nextId ~= 0 do
			local nxt = footholdComp:GetFoothold(nextId)
			if nxt == nil or not self:IsFlatSegment(nxt) or math.abs(nxt.StartPoint.y - y) > self.FlatSlopeTolerance then break end
			xMax = nxt.EndPoint.x
			nextId = nxt.NextFootholdId
		end

		return { xMin = xMin, xMax = xMax }
	end

	-- 발판이 "수평"인지 판정. 엔진 네이티브 Foothold:IsHorizontal()은 오차 없이 엄격하게 판정하는 것으로
	-- 보이는데, 유저가 Maker에서 손으로 그린 발판은 눈에 평평해 보여도 StartPoint/EndPoint의 Y가 아주
	-- 살짝 다를 수 있다 — 그러면 IsHorizontal()이 계속 false를 반환해 그 발판이 스폰 후보에서 통째로
	-- 빠지고(예: 기둥 꼭대기 발판), 결국 아래 바닥에만 스폰되는 것처럼 보인다. FlatSlopeTolerance 이내의
	-- 기울기는 수평으로 간주해 이 문제를 피한다.
	@ExecSpace("ServerOnly")
	---@param seg Foothold
	method boolean IsFlatSegment(any seg)
		return math.abs(seg.EndPoint.y - seg.StartPoint.y) <= self.FlatSlopeTolerance
	end

	-- 이 맵(mapIndex)에 있는 모든 발판을 한 번 훑어서 최저 Y(=바닥 기준선)를 구하고 캐시한다. 이 값보다
	-- AerialHeightThreshold 이상 높은 발판을 "공중 발판"으로 취급해 edgeMargin을 더 크게 적용한다.
	@ExecSpace("ServerOnly")
	method number GetBaselineGroundY(integer mapIndex, FootholdComponent footholdComp)
		if self._baselineGroundYCache == nil then self._baselineGroundYCache = {} end
		if self._baselineGroundYCache[mapIndex] ~= nil then return self._baselineGroundYCache[mapIndex] end

		local all = footholdComp:GetFootholdAll()
		local minY = 0
		for i = 1, #all do
			if all[i].StartPoint.y < minY then minY = all[i].StartPoint.y end
			if all[i].EndPoint.y < minY then minY = all[i].EndPoint.y end
		end
		self._baselineGroundYCache[mapIndex] = minY
		return minY
	end

	-- ── 맵10 보너스 스테이지 ──────────────────────────────────────

	-- MapManager가 맵10 입장마다 호출. 첫 방문은 100%, 이후엔 BonusBossChance 확률로 보너스 보스를
	-- 등장시킨다. 실패하거나 이미 보스가 떠 있으면 평소 웨이브 스폰(맵9 몬스터 풀 재사용)으로 대체한다.
	@ExecSpace("ServerOnly")
	method void TryStartBonusStage()
		if isvalid(self._bonusBoss) then return end

		local chance = self._map10Visited and self.BonusBossChance or 1.0
		self._map10Visited = true

		if _UtilLogic:RandomDouble() >= chance then
			self:ActivateMap(10)
			return
		end

		self:SpawnBonusBoss()
	end

	-- 맵10에 보너스 보스 1마리를 즉시 스폰한다. 평소 웨이브 몬스터와 섞이지 않도록 기존 몬스터를 먼저 정리한다.
	@ExecSpace("ServerOnly")
	method void SpawnBonusBoss()
		-- 그룹C 병합 이후 맵10은 물리적으로 map07.map 안의 Zone10 자식 컨테이너다 — 하드코딩된
		-- "/maps/map10" 경로 대신 ZoneInfo 기반 GetZoneEntity로 조회해야 한다.
		local map = self:GetZoneEntity(10)
		if map == nil then return end

		local existing = map:GetChildComponentsByTypeName("script.MonsterAI", false)
		for i = 1, #existing do
			---@type MonsterAI
			local mob = existing[i]
			mob.Entity:Destroy()
		end

		-- map(GetZoneEntity(10))은 이미 Zone10 자식 컨테이너 자신이 월드 오프셋(spawnX=46.5)을 갖고
		-- 있으므로, 그 밑에 스폰되는 엔티티의 Position/wander 이동량은 전부 "그 컨테이너 기준 로컬"이다.
		-- 여기에 GetZoneOffsetX를 또 더하면 오프셋이 두 번 적용돼(46.5+46.5) 보스가 존 밖 저 멀리
		-- 스폰/배회하다가 카메라 밖으로 사라진다(실측 확인 — "보스가 존 밖으로 나가 화면에서 안 보임").
		-- bands 테이블 자체는 이미 로컬(병합 전 맵10 기준) 좌표이므로 그대로 쓴다.
		local bands = self:GetZonePlatformBands(10)
		local groundY = bands[1].y
		local pos = Vector3(0, groundY, 0)
		local entity = _SpawnService:SpawnByModelId(self.BonusBossModelId, "BonusBoss", pos, map)
		if entity == nil then
			log_error("MonsterSpawner: SpawnBonusBoss failed")
			return
		end

		---@type MonsterAI
		local ai = entity:GetComponent("script.MonsterAI")
		if ai ~= nil then
			ai:InitializeBonusBoss(bands[1].xMin + 0.4, bands[1].xMax - 0.4, groundY, self.BonusBossSpriteRUID)
		end

		self._bonusBoss = entity
		self._bonusBossActive = true
		-- 보스 지속시간이 끝난 뒤 평소 웨이브가 곧바로 이어지도록 활성 맵으로 표시해둔다
		if self._activeMaps == nil then self._activeMaps = {} end
		self._activeMaps[10] = true
		log("MonsterSpawner: bonus boss spawned on map10")

		_TimerService:SetTimerOnce(function()
			if isvalid(self) then self:EndBonusStage() end
		end, self.BonusBossDuration)
	end

	-- 지속시간 만료 시 호출 — 보너스 보스를 제거한다. 이후 평소 SpawnWave 틱이 맵9 몬스터 풀로 재개한다.
	@ExecSpace("ServerOnly")
	method void EndBonusStage()
		if isvalid(self._bonusBoss) then
			---@type MonsterAI
			local ai = self._bonusBoss:GetComponent("script.MonsterAI")
			if ai ~= nil then ai:PlayDespawnJump() else self._bonusBoss:Destroy() end
		end
		self._bonusBoss = nil
		self._bonusBossActive = false
		log("MonsterSpawner: bonus stage ended on map10")
	end

	-- 스폰 위치를 정한다. 맵4~6은 발판 밴드 테이블에서 폭에 비례한 확률로 하나 골라 그 위에 스폰하고,
	-- 맵1~3/맵 전용 풀은 기존처럼 화면 근처(±5) 범위에서 골라 아래로 레이캐스트한다(회귀 방지를 위해 그대로 둠).
	-- speciesIdx: 맵 전용 풀(zoneIndex>=7)에서 RollSpeciesForMap이 미리 뽑아준 값(0=해당 없음). 원거리 종이면
	-- 일반 바닥 대신 유저가 Maker에서 직접 깔아둔 타일 섬 발판(RangedTileMinX~MaxX, 이미 월드 좌표 —
	-- 발판은 항상 맵 루트 기준이라 Zone12 오프셋과 무관) X구간에서 뽑되, Y는 하드코딩하지 않고 GetGroundY로
	-- 그 발판 표면에 직접 레이캐스트한다(경사/계단이 있어도 항상 정확히 표면에 선다 — 이전엔 Y를 고정값으로
	-- 하드코딩해서 유저가 발판 모양을 바꿀 때마다 허공에 뜨는 버그가 반복됐다). 근접 종은 그 X구간을 피해
	-- 좌우 바깥쪽에서만 스폰한다(레이캐스트가 타일 섬 위에 먼저 걸려 근접 종도 섬 위에 착지해버릴 수 있어서).
	-- map 파라미터를 받지 않는다 — 그룹D 병합 이후 맵12는 물리적으로 map11.map 안의 Zone12 자식이라
	-- 발판(FootholdComponent)은 항상 맵 루트(map11)에 있으므로, 레이캐스트 대상은 mapIndex로부터
	-- 직접 다시 조회한다(호출측이 넘기는 "존 엔티티"와 발판 소유 루트가 다를 수 있어서).
	@ExecSpace("ServerOnly")
	method Vector3 GetSpawnPosition(integer mapIndex, boolean isBoss, integer speciesIdx, Entity map)
		-- 비행형 종(맵15 박쥐)은 밴드/레이캐스트 어느 쪽과도 무관하게 항상 화면 안전 범위(±5) X +
		-- FlyingMinY~FlyingMaxY 사이 임의 높이에 스폰한다 — 발판 유무와 상관없이 가장 먼저 처리해야
		-- 한다(맵15는 아래 바닥/공중 발판 밴드도 갖고 있어서, 이 체크가 bands==nil 분기 안에 있으면
		-- 밴드가 있는 맵에서는 아예 실행되지 않아 비행형이 무력화된다).
		if not isBoss and mapIndex >= 7 and speciesIdx > 0 and self:GetMapIsFlyingSpecies(mapIndex, speciesIdx) then
			local flyOffsetX = self:GetZoneOffsetX(mapIndex)
			local fx = (_UtilLogic:RandomDouble() * 10) - 5 + flyOffsetX
			local fy = self.FlyingMinY + _UtilLogic:RandomDouble() * (self.FlyingMaxY - self.FlyingMinY)
			return Vector3(fx, fy, 0)
		end

		-- 존13~15는 하드코딩 밴드 대신 실제 FootholdComponent를 레이캐스트하는 방식을 쓴다(§"존13~15 전용
		-- 스폰 방식" 참고) — 발판을 Maker에서 편집해도 코드가 어긋나지 않는다.
		if mapIndex >= 13 and mapIndex <= 15 then
			return self:GetSpawnPositionFromFootholds(mapIndex, isBoss, map)
		end

		local bands = self:GetZonePlatformBands(mapIndex)
		if bands == nil then
			local rootMap = _EntityService:GetEntityByPath("/maps/" .. _MapManager:GetMapName(mapIndex))
			local offsetX = self:GetZoneOffsetX(mapIndex)

			if not isBoss and mapIndex >= 7 and speciesIdx > 0 and self:GetMapIsRangedSpecies(mapIndex, speciesIdx) then
				local rrx = self.RangedTileMinX + _UtilLogic:RandomDouble() * (self.RangedTileMaxX - self.RangedTileMinX)
				return Vector3(rrx, self:GetGroundY(rootMap, rrx), 0)
			end

			if not isBoss and mapIndex == 12 then
				local rx = self:RollXAvoidingRange(offsetX - 5, offsetX + 5, self.RangedTileMinX, self.RangedTileMaxX)
				return Vector3(rx, self:GetGroundY(rootMap, rx), 0)
			end

			-- 기존 로직 그대로 (맵1~3, 보스, 또는 원거리 종이 없는 맵 전용 풀) — offsetX는 병합 안 된
			-- 맵에서는 항상 0이라 아래 결과에 영향 없음
			local rx = (_UtilLogic:RandomDouble() * 10) - 5
			if isBoss then rx = 0 end
			local worldX = rx + offsetX
			return Vector3(worldX, self:GetGroundY(rootMap, worldX), 0)
		end

		-- bands 테이블은 원본(병합 전) 맵의 로컬 좌표라, 그룹B/C처럼 존이 오프셋을 가지면 여기도
		-- GetZoneOffsetX를 더해야 한다 — 그룹D는 밴드가 있는 존(11/12)이 없어서 이 버그가 지금까지
		-- 한 번도 실전 테스트를 안 받았다(신규 코드 취급, 그룹B에서 처음 검증).
		local offsetX = self:GetZoneOffsetX(mapIndex)

		if isBoss then
			-- 보스는 임팩트를 위해 바닥 밴드 중앙에 고정
			local ground = bands[1]
			return Vector3(offsetX, ground.y, 0)
		end

		-- 발판 폭 그대로 쓰면 화면 가장자리(카메라 가시범위 밖, 대략 ±6.4)에서 스폰돼 몬스터가
		-- 양옆으로 잘려 보인다 — 맵1~3과 동일하게 화면에 안전하게 들어오는 ±5 범위로 각 밴드를 잘라서 쓴다.
		-- 그리고 발판 자체의 가장자리에도 몬스터 스프라이트 폭만큼(edgeMargin) 여유를 둬야 공중 발판
		-- 끝에 반쯤 걸쳐서 스폰되는 걸 막을 수 있다. 고정값 0.4를 그대로 양쪽에서 빼면 존13/15의 좁은
		-- 발판(폭 0.9 이하)은 실사용 폭이 0에 가깝게 눌려서 사실상 안 뽑히는 것과 마찬가지가 된다
		-- (실측 확인 — 300번 중 3번). 밴드 폭의 15%로 상한을 둬서 좁은 발판도 최소한의 스폰 확률을 유지한다.
		local safeMin = offsetX - 5
		local safeMax = offsetX + 5
		local clamped = {}
		for i = 1, #bands do
			local width = bands[i].xMax - bands[i].xMin
			local edgeMargin = math.min(0.4, width * 0.15)
			local xMin = math.max(bands[i].xMin + offsetX + edgeMargin, safeMin)
			local xMax = math.min(bands[i].xMax + offsetX - edgeMargin, safeMax)
			if xMax > xMin then
				table.insert(clamped, { y = bands[i].y, xMin = xMin, xMax = xMax })
			end
		end
		if #clamped == 0 then
			return Vector3(offsetX, bands[1].y, 0)
		end

		local totalWidth = 0
		for i = 1, #clamped do
			totalWidth = totalWidth + (clamped[i].xMax - clamped[i].xMin)
		end
		local roll = _UtilLogic:RandomDouble() * totalWidth
		local chosen = clamped[1]
		local acc = 0
		for i = 1, #clamped do
			acc = acc + (clamped[i].xMax - clamped[i].xMin)
			if roll <= acc then
				chosen = clamped[i]
				break
			end
		end

		local x = chosen.xMin + _UtilLogic:RandomDouble() * (chosen.xMax - chosen.xMin)
		return Vector3(x, chosen.y, 0)
	end

	-- GameManager가 호출: 스폰 멈추기 (게임 종료 시)
	@ExecSpace("ServerOnly")
	method void StopSpawning()
		self._running = false
	end

	-- MapManager.BeginGameplay()가 "게임 시작" 클릭 시점에 호출 — 웨이브 타이머를 최초로 켠다
	@ExecSpace("ServerOnly")
	method void BeginGameplay()
		self._running = true
		log("MonsterSpawner: gameplay started")
	end

	-- GameManager가 호출: 다시하기/이어하기 시 스폰 재개
	@ExecSpace("ServerOnly")
	method void RestartSpawning()
		self._timer = self.SpawnInterval
		self._running = true
		log("MonsterSpawner: spawning restarted")
	end

	-- 이어하기 전용: 타이머를 건드리지 않고 _running만 재개 (기존 스폰 스케줄 유지)
	@ExecSpace("ServerOnly")
	method void ResumeSpawning()
		self._running = true
		log("MonsterSpawner: spawning resumed (timer preserved)")
	end

	-- GameManager.RestartGame()(처음부터 다시하기)에서만 호출 — 이어하기는 같은 웨이브의 엘리트 기록을 유지해야 한다
	@ExecSpace("ServerOnly")
	method void ResetEliteTracking()
		self._lastEliteWave = 0
		self._nextEliteTimer = -1
	end

	-- GameManager가 호출: 다시하기/이어하기 시 남아있는 몬스터 전부 제거 (map1~3 전부)
	@ExecSpace("ServerOnly")
	method void ClearAllMonsters()
		local total = 0
		for idx = _MapManager.MinMapIndex, _MapManager.MaxMapIndex do
			local map = self:GetZoneEntity(idx)
			if map ~= nil then
				local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
				for i = 1, #monsters do
					monsters[i].Entity:Destroy()
				end
				total = total + #monsters
			end
		end
		log("MonsterSpawner: cleared " .. total .. " monster(s)")
	end

	-- 이어하기 전용: 몬스터를 제거하지 않고 스폰 위치로 밀어냄 (map1~3 전부)
	@ExecSpace("ServerOnly")
	method void PushAllMonstersBack()
		local total = 0
		for idx = _MapManager.MinMapIndex, _MapManager.MaxMapIndex do
			local map = self:GetZoneEntity(idx)
			if map ~= nil then
				local monsters = map:GetChildComponentsByTypeName("script.MonsterAI", false)
				for i = 1, #monsters do
					---@type MonsterAI
					local ai = monsters[i].Entity:GetComponent("script.MonsterAI")
					if ai ~= nil then ai:PushBack() end
				end
				total = total + #monsters
			end
		end
		log("MonsterSpawner: pushed back " .. total .. " monster(s)")
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		self._running = false
	end

end
