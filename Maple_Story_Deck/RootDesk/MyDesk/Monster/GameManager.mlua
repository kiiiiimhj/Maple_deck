	@ExecSpace("ServerOnly")
	method number GetMapDieDuration(integer mapIndex, integer idx)
		local pools = {
			[7] = {0.55, 0.45},
			[8] = {0.25, 0.25},
			[9] = {0.55, 0.45, 0.25},
			[11] = {0.45, 0.35, 0.45},  -- 로랑(4프레임)/엄티(3프레임)/클랑(정상 리소스팩 die1 4프레임)
			[12] = {0.95, 0.85, 1.15},  -- 날치(9프레임)/보라조개(8프레임)/불가사리문어(11프레임)
			[13] = {0.45, 0.35},  -- 뿔버섯(4프레임)/좀비버섯(3프레임)
			[14] = {0.35, 0.35},  -- 이블아이(3프레임)/커즈아이(3프레임)
			[15] = {0.35, 0.95, 0.35},  -- 커즈아이(3프레임)/박쥐(9프레임)/이블아이(3프레임)
			[16] = {1.45, 0.55},  -- 내면의 그림자(14프레임)/그림자 보어(5프레임)
			[17] = {0.65, 0.75},  -- 그림자 스텀프(6프레임)/그림자 엑스텀프(7프레임)
			[19] = {0.75},  -- 스톤골렘(7프레임)
			[20] = {0.75, 0.75},  -- 다크 스톤골렘(7프레임)/페어리(7프레임)
			[21] = {0.75, 0.75},  -- 믹스골렘(7프레임)/아이스 믹스골렘(7프레임)
			[22] = {0.75, 0.75},  -- 로얄 페어리(7프레임)/아이스 믹스골렘(7프레임)
			[23] = {0.75, 0.75},  -- 반딧불 슬라임(7프레임)/페어리 슬라임(7프레임)
			[24] = {1.15, 1.15},  -- 워터 엘리먼트(11프레임)/트리 엘리먼트(11프레임)
			[25] = {1.15, 1.25},  -- 미스틱 위습(11프레임)/하급 마법책(12프레임)
			[26] = {1.15, 0.75, 1.15},  -- 워터 엘리먼트(11프레임)/페어리 슬라임(7프레임)/미스틱 위습(11프레임)
			[27] = {1.45, 1.45},  -- 쉐도우 듀어러(14프레임)/자이언트 쉐도우(14프레임)
			[28] = {1.45, 0.45},  -- 쉐도우 블레이드(14프레임)/스티지(4프레임)
			[29] = {0.95},  -- 훈련된 오다군 정찰병(9프레임)
			[30] = {1.45, 0.95},  -- 쉐도우 블레이드(14프레임)/훈련된 오다군 정찰병(9프레임)
			[31] = {0.35},  -- 루팡(3프레임)
			[32] = {1.05},  -- 재규어(10프레임)
			[33] = {1.05, 1.05},  -- 바나나갈매기(10프레임)/재규어(10프레임)
			[34] = {1.05, 0.35},  -- 바나나갈매기(10프레임)/좀비루팡(3프레임)
		}
		local pool = pools[mapIndex]
		if pool == nil then return 0.5 end
		local i = math.max(1, math.min(idx, #pool))
		return pool[i]
	end

	-- 맵 전용 몬스터 풀 attack1 애니메이션 RUID. msw-search로 리소스팩(mob/*.img)을 직접 열어
	-- attack1 클립이 실제로 존재하는 종만 채워 넣었다 — 나머지(및 이 표에 없는 맵)는 빈 문자열로
	-- 두어 MonsterAI가 기존처럼 대체 연출(들이받기/잉크)을 쓰게 한다.
	@ExecSpace("ServerOnly")
	method string GetMapAttackRUID(integer mapIndex, integer idx)
		local pools = {
			[7] = {"", "0ff26f307a2941ff9a581b06d6d25849"},  -- 고스텀프(없음)/엑스텀프
			[11] = {"", "51eff36d03ba45a6b3447c79dbe61e03", ""},  -- 로랑(없음)/엄티/클랑(정상 리소스팩엔 attack1이 없음 — jump만 존재, 없음 처리)
			[15] = {"", "898688a3be7b41e082db00b95e2dbe02", ""},  -- 커즈아이(없음)/박쥐(비행형)/이블아이(없음)
			[16] = {"a707f3a77f75478aa77533669d3a29c9", ""},  -- 내면의 그림자(비행형)/그림자 보어(없음)
			[24] = {"0eee767b08d84a94ac097da3e3df0ae8", "688488731c074e1db58e7f7fb26c7d3e"},  -- 워터 엘리먼트(비행형)/트리 엘리먼트(비행형)
			[25] = {"", "63bdcd080be343a4b2f8f15475f07063"},  -- 미스틱 위습(비행형, 없음)/하급 마법책
			[26] = {"0eee767b08d84a94ac097da3e3df0ae8", "", ""},  -- 워터 엘리먼트(비행형)/페어리 슬라임(없음)/미스틱 위습(비행형, 없음)
			-- 그룹I(존27~30, 닌자 컨셉) 4종은 msw-search로 확인한 결과 전부 attack1 클립을 갖고 있어
			-- 다른 그룹과 달리 처음부터 전 종에 채워 넣는다.
			[27] = {"19482fa6cc8644738b253dc7bc83609a", "f3f051220c1e40ba97c80d76a092dbf6"},  -- 쉐도우 듀어러/자이언트 쉐도우
			[28] = {"5ce18d4cd4cf4318b5e691d5dae012b0", ""},  -- 쉐도우 블레이드(지상형)/스티지(비행형, attack1 없음)
			[29] = {"32bf16d278504159b45a18dfbee7512f"},  -- 훈련된 오다군 정찰병
			[30] = {"5ce18d4cd4cf4318b5e691d5dae012b0", "32bf16d278504159b45a18dfbee7512f"},  -- 쉐도우 블레이드(지상형)/훈련된 오다군 정찰병
			-- 루팡/좀비루팡은 msw-search로 확인한 결과 둘 다 11프레임짜리 attack1(바나나 던지는 포즈)을
			-- 갖고 있어 채워 넣는다 — GetMapAttackDuration에도 실측 길이(1.1초)를 별도로 등록해야 한다
			-- (그렇지 않으면 기존 0.25초 기본값에 잘려 보인다, 자이언트 쉐도우와 동일한 패턴).
			[31] = {"ee35f175eff94389b33a4e7d4f454c33"},  -- 루팡
			[33] = {"", ""},  -- 바나나갈매기(비행형, attack1 없음)/재규어(attack1 없음)
			[34] = {"", "45e0a175e4b2491296f244b893c6ee98"},  -- 바나나갈매기(비행형, 없음)/좀비루팡
		}
		local pool = pools[mapIndex]
		if pool == nil then return "" end
		local i = math.max(1, math.min(idx, #pool))
		return pool[i]
	end

	-- 맵 전용 몬스터 풀 attack1 스프라이트를 원래 포즈로 되돌리기까지 대기하는 시간(초). 기존엔 전 종이
	-- 0.25초로 고정돼 있었는데, 자이언트 쉐도우(존27의 2번째 종)의 attack1 클립은 8프레임이라 die1과
	-- 같은 재생 속도(초당 약 10프레임, die1 14프레임=1.45초로 역산) 기준 실제 재생에 약 0.8초가 필요해서
	-- 0.25초에 중간에 잘려 보였다 — 유저가 "공격모션이 짤리는듯" 피드백. 이 종만 실측 길이로 늘리고,
	-- 나머지(짧은 클립)는 기존 0.25초를 그대로 유지한다. 루팡/좀비루팡(11프레임 attack1)도 같은 이유로 추가.
	@ExecSpace("ServerOnly")
	method number GetMapAttackDuration(integer mapIndex, integer idx)
		if mapIndex == 27 and idx == 2 then return 0.8 end
		if mapIndex == 31 and idx == 1 then return 1.1 end
		if mapIndex == 34 and idx == 2 then return 1.1 end
		return 0.25
	end

	-- 맵 전용 몬스터 풀 중 원거리 공격 종인지 여부 — 맵12의 3번째 종(불가사리 문어 슬라임, 먹물)에 이어
	-- 존31(루팡)/존34의 2번째 종(좀비루팡)도 추가(그룹J, 정글 컨셉 — 둘 다 attack1이 있어 먹물 대체 연출은
	-- 타지 않고 스폰 위치만 MonsterSpawner.GetRangedTileRange의 존별 전용 타일섬으로 바뀐다).
	@ExecSpace("ServerOnly")
	method boolean GetMapIsRanged(integer mapIndex, integer idx)
		if mapIndex == 12 and idx == 3 then return true end
		if mapIndex == 31 and idx == 1 then return true end
		if mapIndex == 34 and idx == 2 then return true end
		return false
	end

	-- 맵 전용 몬스터 풀 중 원거리(칼자국) 공격 종인지 여부 — 존27의 2번째 종(자이언트 쉐도우)만 해당.
	-- 먹물(GetMapIsRanged)과 달리 자체 attack1 애니메이션을 대체하지 않고 화면 슬래시 마크를 그 위에
	-- 얹는다(MonsterAI.OnReachPlayer 참고).
	@ExecSpace("ServerOnly")
	method boolean GetMapIsRangedSlash(integer mapIndex, integer idx)
		return mapIndex == 27 and idx == 2
	end

	-- 맵 전용 몬스터 풀 중 비행형 종인지 여부 — 맵15의 2번째 종(박쥐), 맵16의 1번째 종(내면의 그림자),
	-- 맵20의 2번째 종(페어리), 맵22의 1번째 종(로얄 페어리).
	-- 맵24(워터/트리 엘리먼트 둘 다 비행형), 맵25의 1번째 종(미스틱 위습), 맵26의 1/3번째 종(워터 엘리먼트/미스틱 위습).
	-- 맵28의 2번째 종(스티지) — 유저가 처음엔 "쉐도우 블레이드가 비행형"이라고 했다가 "스티지가 비행형"으로
	-- 정정했다(쉐도우 블레이드 자신은 지상형).
	-- 비행형은 발판 레이캐스트로 바닥에 고정되지 않고 화면 안 임의의 높이(공중)에 스폰된다
	-- (MonsterSpawner.GetSpawnPosition 참고)
	@ExecSpace("ServerOnly")
	method boolean GetMapIsFlying(integer mapIndex, integer idx)
		if mapIndex == 15 and idx == 2 then return true end
		if mapIndex == 16 and idx == 1 then return true end
		if mapIndex == 20 and idx == 2 then return true end
		if mapIndex == 22 and idx == 1 then return true end
		if mapIndex == 24 then return true end
		if mapIndex == 25 and idx == 1 then return true end
		if mapIndex == 26 and (idx == 1 or idx == 3) then return true end
		if mapIndex == 28 and idx == 2 then return true end
		if mapIndex == 33 and idx == 1 then return true end  -- 바나나갈매기
		if mapIndex == 34 and idx == 1 then return true end  -- 바나나갈매기(재사용)
		return false
	end

	-- 맵 전용 몬스터 풀의 시각적 크기 배율(MonsterAI._scaleMultiplier에 곱해짐). 기본은 1.0(원래 크기 그대로).
	-- 존19~22(그룹G) 골렘류(스톤골렘/다크 스톤골렘/믹스골렘/아이스 믹스골렘)만 축소 — 처음 15%(0.85) 축소했다가
	-- 유저 피드백으로 거기서 20% 더 축소(0.85*0.8=0.68)했다. 페어리/로얄 페어리는 축소하지 말라는 명시적
	-- 요청이 있어 제외(존20 2번째 종=페어리, 존22 1번째 종=로얄 페어리 — GetMapIsFlying과 동일한 인덱스).
	-- 그룹J(존31~34, 정글 컨셉) 유저 요청: 루팡/좀비루팡(원거리 2종) 15% 확대, 바나나갈매기(비행형) 15%
	-- 축소, 재규어 10% 축소.
	@ExecSpace("ServerOnly")
	method number GetMapScaleMultiplier(integer mapIndex, integer idx)
		if mapIndex == 20 and idx == 2 then return 1.0 end  -- 페어리
		if mapIndex == 22 and idx == 1 then return 1.0 end  -- 로얄 페어리
		if mapIndex >= 19 and mapIndex <= 22 then return 0.68 end  -- 골렘류
		if mapIndex == 31 and idx == 1 then return 1.15 end  -- 루팡
		if mapIndex == 32 and idx == 1 then return 0.9 end  -- 재규어
		if mapIndex == 33 and idx == 1 then return 0.7225 end  -- 바나나갈매기(비행형, 0.85에서 15% 추가 축소: 0.85*0.85)
		if mapIndex == 33 and idx == 2 then return 0.9 end  -- 재규어(재사용)
		if mapIndex == 34 and idx == 1 then return 0.7225 end  -- 바나나갈매기(비행형, 재사용, 0.85*0.85)
		if mapIndex == 34 and idx == 2 then return 1.15 end  -- 좀비루팡
		return 1.0
	end

	-- 몬스터가 플레이어에게 도달했을 때 MonsterAI가 호출 (엘리트는 dmgMultiplier로 공격력 가산)
	@ExecSpace("ServerOnly")
	method void OnMonsterReached(number dmgMultiplier)
		if self.GameOver then return end
		if self._hitImmune then return end

		self._hitImmune = true
		local dmg = math.floor(self:GetWaveAttack(self.Wave) * dmgMultiplier)
		local armorReduction = _CardManager:GetMagicArmorReduction()
		if armorReduction > 0 then dmg = math.floor(dmg * (1.0 - armorReduction)) end
		self.PlayerHp = self.PlayerHp - dmg
		log("Player hit! HP:" .. self.PlayerHp .. " (Wave " .. self.Wave .. " dmg:" .. dmg .. ")")

		_TimerService:SetTimerOnce(function()
			if isvalid(self) then self._hitImmune = false end
		end, 0.8)

		if self.PlayerHp <= 0 then
			self.PlayerHp = 0
			self:TriggerGameOver()
		end
	end

	@ExecSpace("ServerOnly")
	method void LevelUp()
		self.Level = self.Level + 1
		-- OnBossDefeated()는 그 시점의 누적 경험치가 ExpNeeded 미만이어도 강제로 LevelUp()을 호출한다.
		-- 그냥 빼기만 하면 음수 Exp가 남는데, 경험치 바 갱신(NotifyExpChanged)의 ratio 계산이
		-- math.max(0, ...)로 음수를 0에 고정시켜서, 그 뒤로 몬스터를 잡아 조금씩 채워도 다시 0을
		-- 넘기 전까지는 바가 안 움직이는 것처럼 보이는 버그가 있었다 — 0 밑으로 내려가지 않게 고정한다.
		self.Exp = math.max(0, self.Exp - self.ExpNeeded)
		self.ExpNeeded = math.floor(self.ExpNeeded * self.ExpGrowthRate)
		self.Wave = self.Wave + 1
		self.PlayerMaxHp = self.PlayerMaxHp + 15
		self.PlayerHp = math.min(self.PlayerHp + 15, self.PlayerMaxHp)
		-- 맵4+ 잠금 기준이 보스 처치 대신 레벨10이라, 맵 이동 없이 그 자리에서 레벨업만으로 10을
		-- 찍을 수도 있다 — NotifyBossDefeated(true)를 그대로 재사용해 맵3에 있는 클라이언트의
		-- 자물쇠를 즉시 갱신한다(파라미터 이름과 달리 실제로는 "맵4+ 잠금 해제 알림"으로 동작한다)
		if self.Level == 10 then
			_MapMoveUI:NotifyBossDefeated(true)
		end
		log("Level Up! Lv." .. self.Level .. " | Wave:" .. self.Wave .. " | MaxHP:" .. self.PlayerMaxHp)
		_CardManager:GenerateLevelUpChoices()
		self:NotifyExpChanged(self.Exp, self.ExpNeeded, self.Level, true)
	end

	@ExecSpace("ServerOnly")
	method void TriggerGameOver()
		self.GameOver = true
		_MonsterSpawner:StopSpawning()
		-- 유물 골드 보너스는 킬마다 곱하지 않고, 게임오버 시점에 이번 구간(직전 정산 이후) 동안
		-- 모은 골드 총액에 한 번에 곱해서 지급한다 — 정수 내림 오차가 킬 단위보다 훨씬 작아진다
		local bonusPercent = _RelicInventory:GetGoldBonusPercent()
		local earnedSinceBonus = self.Gold - self._goldBonusCheckpoint
		if bonusPercent > 0 and earnedSinceBonus > 0 then
			local bonusGold = math.floor(earnedSinceBonus * bonusPercent / 100)
			if bonusGold > 0 then
				self:AddGold(bonusGold)
				log("Gold relic bonus applied: +" .. bonusGold .. " (" .. bonusPercent .. "% of " .. earnedSinceBonus .. ")")
			end
		end
		self._goldBonusCheckpoint = self.Gold
		-- 가방 환전은 여기서 하지 않는다 — "이어하기"를 고르면 가방 아이템은 그대로 유지되어야 하므로,
		-- 실제로 "처음부터 다시하기"를 선택했을 때(RestartGame)만 환전+초기화한다
		log("Game Over!")
	end

	-- 클라이언트의 "게임 시작" 버튼 요청 (타이틀 화면)
	@ExecSpace("Server")
	method void RequestStartGame()
		self:StartGame()
	end

	@ExecSpace("ServerOnly")
	method void StartGame()
		-- 타이틀 화면에서 처음 한 번만 실제 웨이브 스폰을 활성화한다. 그 전까지 OnBeginPlay에서
		-- 곧바로 스폰을 켜두면, 유저가 타이틀 화면을 보는 동안에도 몬스터가 쌓이게 된다.
		if self.GameStarted then return end
		self.GameStarted = true
		_MapManager:BeginGameplay()
		log("GameManager: game started")
	end

	-- 클라이언트의 "다시하기" 버튼 요청
	@ExecSpace("Server")
	method void RequestRestart()
		self:RestartGame()
	end

	-- 이번에 "이어하기"를 누르면 얼마가 드는지 — GameOverUI가 표시/가능여부 판정에 쓴다.
	-- 서버/클라 어느 쪽에서 불러도 동일(ContinueCount는 @Sync, 표는 정적)
	method integer GetContinueCost()
		local idx = self.ContinueCount + 1
		if idx > #self._continueCostTable then idx = #self._continueCostTable end
		return self._continueCostTable[idx]
	end

	-- 클라이언트의 "이어하기" 버튼 요청 — 비용(코인)을 지불해야 이어할 수 있다
	@ExecSpace("Server")
	method void RequestContinue()
		local cost = self:GetContinueCost()
		if not self:SpendCoins(cost) then
			log("RequestContinue: not enough coins (cost=" .. cost .. ", have=" .. self.TotalCoins .. ")")
			return
		end
		self.ContinueCount = self.ContinueCount + 1
		self:ContinueGame()
	end

	@ExecSpace("ServerOnly")
	method void RestartGame()
		-- 처음부터 다시 시작: 모든 상태를 초기화
		self.PlayerMaxHp = 100
		self.PlayerHp = 100
		self.Level = 1
		self.Exp = 0
		self.ExpNeeded = 100
		self.Gold = 0
		self._goldBonusCheckpoint = 0
		self.Wave = 1
		self.GameOver = false
		self.ContinueCount = 0
		self._hitImmune = false
		-- 레벨10(또는 보스 처치)으로 열렸던 맵4+ 잠금도 "처음부터"에 포함된다 — 새 런에서는 다시 잠근다.
		-- 위에서 Level을 이미 1로 되돌렸기 때문에 여기서 Level로 조건을 걸면 항상 거짓이 되어 버린다 —
		-- 그냥 무조건 다시 잠그고 알린다(이미 잠겨있었어도 아무 부작용 없는 멱등 호출)
		self.BossDefeated = false
		_MapMoveUI:NotifyBossDefeated(false)
		-- 이전 런에서 맵4+까지 진행했더라도 시작 맵(map02)으로 되돌린다. 이미 시작 맵이면 내부에서 no-op
		_MapManager:SilentMoveToMap(_MapManager.CurrentMapIndex, _MapManager.DesiredStartMapIndex)
		_CardManager:ResetAllCards()
		-- 그림자숲 상점 스킬 슬롯(3~5번)도 새 런 기준으로 다시 뽑는다 — 매진 상태도 같이 초기화된다
		_ShadowShopUI:ForceReroll()
		-- 존21 외계인 이스터에그도 새 런에서는 다시 도전할 수 있게 초기화한다("이어하기"는 건드리지 않음)
		_Zone21AlienEasterEggLogic:ResetForNewRun()
		-- 존27 석상 이스터에그(얄미운 미니무르)도 동일한 정책으로 초기화
		_NinjaStatuePuzzleLogic:ResetForNewRun()
		-- "처음부터 다시하기": 이번 런에 가방에 쌓인 잡템은 골드로 환전한 뒤 가방을 비운다
		_PlayerInventory:ConvertAllToCoins()
		_MonsterSpawner:ClearAllMonsters()
		_MonsterSpawner:ResetEliteTracking()
		_MonsterSpawner:RestartSpawning()
		self:NotifyExpChanged(self.Exp, self.ExpNeeded, self.Level, true)
		log("Game restarted (full reset)")
	end

	@ExecSpace("ServerOnly")
	method void ContinueGame()
		-- 이어하기: 레벨/경험치/골드/웨이브 유지, 체력 회복
		self.PlayerHp = self.PlayerMaxHp
		self.GameOver = false
		-- 버프 카드(7/8) 상태 초기화 → 이어하기 직후 즉시 재발동
		_CardManager:ResetBuffsForContinue()
		-- 기존 몬스터를 제거하지 않고 스폰 위치로 밀어냄 (먼지 이펙트 포함)
		_MonsterSpawner:PushAllMonstersBack()
		-- 타이머 리셋 없이 재개 → 이어하기 직후 추가 스폰 배치 없음
		_MonsterSpawner:ResumeSpawning()
		log("Game continued (Wave " .. self.Wave .. ", Lv." .. self.Level .. ")")
	end

	@ExecSpace("ServerOnly")
	method void HealPlayer(integer amount)
		-- 포션 사용 시 체력 회복 (최대 HP 초과 불가)
		if self.GameOver then return end
		self.PlayerHp = math.min(self.PlayerHp + amount, self.PlayerMaxHp)
		log("Player healed " .. amount .. " -> HP:" .. self.PlayerHp)
	end

	@ExecSpace("ServerOnly")
	method void TryDropHealPotion(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		-- 일반 몬스터 처치 시 가끔 회복 포션을 드롭한다 (빨강/흰색은 배타적 — 합쳐서 15% 확률)
		if self.GameOver then return end

		-- 유물 레벨업 보너스(레벨 합계 1당 +0.5%p)를 두 확률에 동일하게 얹는다
		local bonusChance = _RelicInventory:GetPotionChanceBonusPercent() / 100
		local redChance = self.RedPotionDropChance + bonusChance
		local whiteChance = self.WhitePotionDropChance + bonusChance

		local r = _UtilLogic:RandomDouble()
		local potionType = 0
		if r < redChance then
			potionType = 1
		elseif r < redChance + whiteChance then
			potionType = 2
		end
		if potionType == 0 then return end

		self:ApplyPotionDrop(potionType, worldPos, fallHeight, groundWorldY, dropScale)
	end

	-- zoneIndex(맵)와 speciesIdx(MonsterAI가 스폰 시 뽑은 외형 인덱스 — MonsterAI._speciesIdx)로
	-- "그 몬스터가 실제 메이플스토리에서 잡으면 주는 아이템" 1종을 결정한다. 존16~17(그림자 존)은
	-- 야누스의 검 교환권 전용이라 이 표에 없다(호출측에서 이미 분기 처리됨).
	-- 존1~3은 웨이브 번호 자체가 speciesIdx(웨이브10=리본돼지 보스, 11+는 1~9 중 재사용).
	-- 존4~6은 4종 무작위, 존7+는 맵별 전용 풀(MonsterAI.InitializeStats/GameManager.GetMapStandRUID와 동일한
	-- appearanceZone/인덱스 규칙 — 존10은 존9 풀을 그대로 재사용).
	@ExecSpace("ServerOnly")
	method string GetMonsterLootItemId(integer zoneIndex, integer speciesIdx)
		if zoneIndex >= 7 then
			local appearanceZone = zoneIndex
			if appearanceZone == 10 then appearanceZone = 9 end
			local pools = {
				[7] = {"stump_tear", "stump_tear"},                            -- 고스텀프/엑스텀프
				[8] = {"old_leather", "old_leather"},                          -- 와일드보어/아이언호그
				[9] = {"stump_tear", "old_leather", "old_leather"},            -- 히죽대는 고스텀프/아이언보어/파이어보어
				[11] = {"lorang_claw", "umti_shell", "klang_claw"},            -- 로랑/엄티/클랑
				[12] = {"flying_fish", "clam_shell", "starfish_leg"},          -- 날치/보라조개/불가사리문어 슬라임
				[13] = {"horned_mushroom_cap", "zombie_mushmom_spore"},        -- 뿔버섯/좀비버섯
				[14] = {"evileye_tail", "curseeye_tail"},                      -- 이블아이/커즈아이
				[15] = {"curseeye_tail", "bat_wing", "evileye_tail"},          -- 커즈아이/박쥐(비행)/이블아이
				[19] = {"stone_golem_fragment"},                                              -- 스톤골렘
				[20] = {"dark_stone_golem_fragment", "fairy_antenna"},                        -- 다크 스톤골렘/페어리(비행)
				[21] = {"mix_golem_piece", "ice_mix_golem_piece"},                            -- 믹스골렘/아이스 믹스골렘
				[22] = {"royal_fairy_wing", "ice_mix_golem_piece"},                           -- 로얄 페어리(비행)/아이스 믹스골렘
				[23] = {"firefly_slime_gel", "fairy_slime_gel"},                              -- 반딧불 슬라임/페어리 슬라임
				[24] = {"water_elemental_essence", "tree_elemental_leaf"},                    -- 워터 엘리먼트(비행)/트리 엘리먼트(비행)
				[25] = {"mystic_wisp_dust", "lesser_spellbook_page"},                          -- 미스틱 위습(비행)/하급 마법책
				[26] = {"water_elemental_essence", "fairy_slime_gel", "mystic_wisp_dust"},     -- 워터 엘리먼트(비행)/페어리 슬라임/미스틱 위습(비행)
				[31] = {"lupin_banana"},                                                       -- 루팡
				[32] = {"jaguar_claw"},                                                        -- 재규어
				[33] = {"banana_gull_feather", "jaguar_claw"},                                 -- 바나나갈매기(비행)/재규어
				[34] = {"banana_gull_feather", "zombie_lupin_peel"},                           -- 바나나갈매기(비행)/좀비루팡
				-- 121: 존21 이스터에그 전용 가상 존 번호(실제 맵 인덱스와 겹치지 않는 sentinel) — 뉴그레이 화이트는
				-- 존 몬스터 풀 시스템(InitializeStats)을 거치지 않는 일회성 스폰이라 진짜 존21 풀과 구분해야 한다
				[121] = {"grey_tentacle"},                                                    -- 뉴그레이 화이트(Zone21AlienEasterEggLogic 전용)
			}
			local pool = pools[appearanceZone]
			if pool == nil then return "" end
			local i = math.max(1, math.min(speciesIdx, #pool))
			return pool[i]
		elseif zoneIndex >= 4 then
			local pool = {"fox_tail", "pig_tail", "orange_mushroom_cap", "orange_mushroom_cap"}  -- 음흉한여우/이상한돼지/주황버섯/시니컬한주황버섯
			local i = math.max(1, math.min(speciesIdx, #pool))
			return pool[i]
		else
			local pool = {
				"snail_shell", "blue_snail_shell", "mushroom_spore", "red_snail_shell", "slime_ooze",
				"pig_tail", "jr_boogie_horn", "stump_tear", "octopus_leg", "ribbon",
			}  -- 달팽이/파란달팽이/스포아/빨간달팽이/슬라임/돼지/주니어부기/스텀프/옥토퍼스/리본돼지(보스)
			local i = math.max(1, math.min(speciesIdx, #pool))
			return pool[i]
		end
	end

	@ExecSpace("ServerOnly")
	method void TryDropLootItem(Vector3 worldPos, number fallHeight, number groundWorldY, string itemId, number dropScale)
		-- 존16~17을 제외한 전 구간에서 몬스터 처치 시 확률로, 그 몬스터의 실제 드롭템 1개를 지급한다.
		-- 포션과 동일하게 사망 위치에서 바닥에 떨어지는 연출을 보여준 뒤, 가방에 도착하는 시점에 실제로 지급한다
		if self.GameOver then return end
		if itemId == "" then return end
		if _UtilLogic:RandomDouble() >= self.LootItemDropChance then return end
		local iconRuid = _PlayerInventory:GetItemDef(itemId).icon
		-- 실제 지급(AddItem)은 연출이 끝나야 일어나므로, 순번은 드롭이 확정된 지금 미리 예약해둔다
		-- (그래야 나중에 죽은 몬스터의 아이템이 랜덤 딜레이가 짧아 먼저 도착해도 순서가 안 뒤바뀐다)
		_PlayerInventory:ReserveAcquisitionOrder(itemId)

		self:ScheduleLootDrop(worldPos, iconRuid, fallHeight, groundWorldY, function()
			_PlayerInventory:AddItem(itemId, 1)
		end, dropScale)
	end

	-- 얄미운 미니무르 전용 — "지금까지 구현된 몬스터 아무 잡템이나" 하나를 무작위로 고른다.
	-- GetMonsterLootItemId처럼 존/종 인덱스에 묶인 조회가 아니라, 존재하는 잡템 전체를 한 풀로 모은
	-- 평평한(flat) 목록이라 별도로 관리한다.
	@ExecSpace("ServerOnly")
	method string GetRandomLootItemId()
		local pool = {
			"snail_shell", "blue_snail_shell", "mushroom_spore", "red_snail_shell", "slime_ooze",
			"pig_tail", "jr_boogie_horn", "stump_tear", "octopus_leg", "ribbon",
			"fox_tail", "orange_mushroom_cap",
			"old_leather", "lorang_claw", "umti_shell", "klang_claw",
			"flying_fish", "clam_shell", "starfish_leg",
			"horned_mushroom_cap", "zombie_mushmom_spore",
			"evileye_tail", "curseeye_tail", "bat_wing",
			"stone_golem_fragment", "dark_stone_golem_fragment", "fairy_antenna",
			"mix_golem_piece", "ice_mix_golem_piece", "royal_fairy_wing",
			"firefly_slime_gel", "fairy_slime_gel",
			"water_elemental_essence", "tree_elemental_leaf",
			"mystic_wisp_dust", "lesser_spellbook_page",
			"lupin_banana", "jaguar_claw", "banana_gull_feather", "zombie_lupin_peel",
		}
		return pool[_UtilLogic:RandomIntegerRange(1, #pool)]
	end

	-- 얄미운 미니무르 전용 — TryDropLootItem의 확률 게이트(LootItemDropChance)를 거치지 않고 무조건
	-- 지급한다(호출측인 MonsterAI.RollMiniMooreDrop이 이미 "이번 틱엔 잡템을 준다"는 판단을 끝낸
	-- 뒤에만 부르는 강제 지급형 — ForceDropPotion과 동일한 패턴).
	@ExecSpace("ServerOnly")
	method void ForceDropLootItem(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		if self.GameOver then return end
		local itemId = self:GetRandomLootItemId()
		local iconRuid = _PlayerInventory:GetItemDef(itemId).icon
		_PlayerInventory:ReserveAcquisitionOrder(itemId)
		self:ScheduleLootDrop(worldPos, iconRuid, fallHeight, groundWorldY, function()
			_PlayerInventory:AddItem(itemId, 1)
		end, dropScale)
	end

	-- 잡템/야누스의 검 교환권 공용 — 포션과 동일하게, 드랍 연출이 끝나기 전에 맵을 이동하면
	-- 그 자리에서 바로 주운 것으로 치고 즉시 지급 + 클라이언트에 조기수거를 알린다.
	-- fallHeight: 비행형 몬스터처럼 사망 위치가 공중일 때, 바닥(타일) 높이까지 먼저 빙그르르 돌며
	-- 떨어지는 연출에 걸리는 추가 시간(UI px 기준, 0이면 생략)만큼 arrivalDelay에도 함께 반영한다
	@ExecSpace("ServerOnly")
	method void ScheduleLootDrop(Vector3 worldPos, string iconRuid, number fallHeight, number groundWorldY, any onGrant, number dropScale)
		local dropZone = _MapManager.CurrentMapIndex
		local groundDelay = 0.6 + _UtilLogic:RandomDouble() * 0.6
		local fallDuration = 0
		if fallHeight > 0 then fallDuration = math.min(0.6, 0.15 + fallHeight / 500) end
		local arrivalDelay = fallDuration + self.PotionPopDuration + groundDelay + self.PotionFlyDuration

		local granted = false
		local watchTimerId = 0
		watchTimerId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self) or granted then return end
			if _MapManager.CurrentMapIndex ~= dropZone then
				granted = true
				onGrant()
				_TimerService:ClearTimer(watchTimerId)
				self:RequestLootCollectNow()
			end
		end, 0.15)

		_TimerService:SetTimerOnce(function()
			if isvalid(self) and not granted then
				granted = true
				onGrant()
				_TimerService:ClearTimer(watchTimerId)
			end
		end, arrivalDelay)

		self:PlayLootDropVisual(Vector2(worldPos.x, worldPos.y), iconRuid, groundDelay, fallHeight, groundWorldY, dropScale)
	end

	-- _lootSlots를 지연 생성해서 돌려준다 — OnBeginPlay가 아니라 여기서 만드는 이유는 클라이언트
	-- 바인딩(icon1~4)이 전부 준비된 뒤 아무 때나 안전하게 호출할 수 있게 하기 위해서다
	@ExecSpace("ClientOnly")
	method table GetLootSlots()
		if self._lootSlots == nil then
			self._lootSlots = {
				{ icon = self.lootFlyIcon1, busy = false, landed = false, landUI = Vector2(0, 0), collectRequested = false, flown = false, token = 0, dropScale = 1.0 },
				{ icon = self.lootFlyIcon2, busy = false, landed = false, landUI = Vector2(0, 0), collectRequested = false, flown = false, token = 0, dropScale = 1.0 },
				{ icon = self.lootFlyIcon3, busy = false, landed = false, landUI = Vector2(0, 0), collectRequested = false, flown = false, token = 0, dropScale = 1.0 },
				{ icon = self.lootFlyIcon4, busy = false, landed = false, landUI = Vector2(0, 0), collectRequested = false, flown = false, token = 0, dropScale = 1.0 },
			}
		end
		return self._lootSlots
	end

	@ExecSpace("Multicast")
	method void PlayLootDropVisual(Vector2 worldPos, string iconRuid, number groundDelay, number fallHeight, number groundWorldY, number dropScale)
		-- 사망 위치에 잡템이 떨어진 것처럼 보여준 뒤, 잠시 멈췄다가 가방 아이콘으로 날아간다.
		-- 비행형 몬스터(fallHeight>0)는 먼저 바닥 높이까지 빙그르르 돌며 떨어진 뒤 이어서 홉 연출을 재생한다.
		-- 아이콘 슬롯 4개 중 비어있는 첫 슬롯을 쓴다 — 몰려 죽어서 4개가 전부 busy면 이번 드롭은
		-- 연출 없이 스킵한다(데이터 지급 자체는 서버 타이머로 별도 처리되어 영향 없음)
		if self:IsServer() then return end
		local slots = self:GetLootSlots()
		local slotIndex = 0
		for i = 1, #slots do
			if not slots[i].busy then
				slotIndex = i
				break
			end
		end
		if slotIndex == 0 then return end

		local slot = slots[slotIndex]
		slot.busy = true
		slot.landed = false
		slot.collectRequested = false
		slot.flown = false
		slot.token = slot.token + 1
		slot.dropScale = dropScale
		local myToken = slot.token
		local icon = slot.icon

		-- 어떤 이유로든 정상 경로(가방으로 날아가서 PunchBagIcon)가 끝까지 완주되지 못하면, 아이템이
		-- 화면에 영구히 남아있는 대신 5초 뒤 강제로 정리되도록 안전장치를 걸어둔다
		_TimerService:SetTimerOnce(function()
			self:WatchdogClearLootIcon(slotIndex, myToken)
		end, 5.0)

		local rawUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(worldPos))
		local startUI = Vector2(rawUI.x, rawUI.y + self.DropYOffset)
		icon.ImageRUID = iconRuid
		icon.Color = Color(1, 1, 1, 1)
		icon.Entity:SetEnable(true)
		local tc = icon.Entity.UITransformComponent
		tc.anchoredPosition = startUI
		tc.Scale = Vector3(0.3 * dropScale, 0.3 * dropScale, 1)
		tc.ZRotation = 0

		-- 등장 순간 살짝 통통 튀듯 팝(작게 시작 → 확 커졌다가 → 원래 크기로) 연출
		_TweenLogic:PlayTween(0.3 * dropScale, 1.2 * dropScale, 0.12, EaseType.BackEaseOut, function(scale)
			if isvalid(icon) then icon.Entity.UITransformComponent.Scale = Vector3(scale, scale, 1) end
		end)
		_TimerService:SetTimerOnce(function()
			if isvalid(icon) then icon.Entity.UITransformComponent.Scale = Vector3(dropScale, dropScale, 1) end
		end, 0.12)

		local continueFromGround = function(groundUI)
			self:PlayDropPop(icon, groundUI, function(landUI)
				slot.landed = true
				slot.landUI = landUI
				if slot.collectRequested then
					self:TryFlyLootToBag(slotIndex, landUI)
					return
				end
				_TimerService:SetTimerOnce(function()
					self:TryFlyLootToBag(slotIndex, landUI)
				end, groundDelay)
			end)
		end

		local landYCorrection = self:GetDropLandYCorrection(dropScale)

		if fallHeight > 0 then
			-- 착지 지점(groundUI)에는 DropYOffset을 더하지 않는다 — 여기 더하면 최종적으로 안착하는
			-- 높이가 실제 바닥보다 계속 떠 보인다(유저 실측 확인: 아이템이 바닥에 안 붙고 공중에 떠있음).
			-- 등장 시작점(startUI)에만 오프셋을 남겨서 "몸에서 팡 튀어나오는" 연출은 그대로 유지한다.
			-- 다만 landYCorrection만큼은 착지 지점에도 더한다 — 안 그러면 타일 표면보다 낮게 박힌다(유저 실측 확인)
			local groundUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(Vector2(worldPos.x, groundWorldY)))
			groundUI = Vector2(groundUI.x, groundUI.y + landYCorrection)
			self:PlayFallSpin(icon, startUI, groundUI, fallHeight, continueFromGround)
		else
			continueFromGround(Vector2(rawUI.x, rawUI.y + landYCorrection))
		end
	end

	-- groundUI: 실제로 떨어질 UI 좌표(호출측이 groundWorldY를 _UILogic으로 변환해서 넘긴다).
	-- fallHeight는 이동 거리 계산에는 더 이상 쓰지 않고, 연출 시간/회전량 근사치로만 쓴다 — world
	-- 델타 * 100은 화면 UI px 환산 비율(실측 ~170px/유닛)과 달라서 실제 낙하 거리로 쓰면 발판에
	-- 못 미친 지점에서 멈춰(공중에 뜬 것처럼 보여) 정확한 변환이 필요했다.
	@ExecSpace("ClientOnly")
	method void PlayFallSpin(SpriteGUIRendererComponent icon, Vector2 startUI, Vector2 groundUI, number fallHeight, any onGrounded)
		-- 비행형 몬스터 전용: 사망 위치가 공중이므로, 바닥(타일) 높이까지 빙그르르 돌면서 떨어지는 연출을 먼저 재생한다
		if not isvalid(icon) then return end
		local duration = math.min(0.6, 0.15 + fallHeight / 500)
		-- 회전량을 항상 360의 배수로 맞춰서, 다 돌고 나면 항상 원래(0도) 각도로 자연스럽게 떨어지게 한다.
		-- 배수가 아니면 낙하 도중 임의의 각도에서 멈췄다가 착지 순간 0도로 툭 꺾여 보였다.
		local rawSpinDegrees = 540 + fallHeight
		local spinDegrees = math.floor(rawSpinDegrees / 360 + 0.5) * 360
		if spinDegrees == 0 then spinDegrees = 360 end

		_TweenLogic:PlayTween(0.0, 1.0, duration, EaseType.QuadEaseIn, function(t)
			if not isvalid(icon) then return end
			local pos = Vector2(startUI.x + (groundUI.x - startUI.x) * t, startUI.y + (groundUI.y - startUI.y) * t)
			icon.Entity.UITransformComponent.anchoredPosition = pos
			icon.Entity.UITransformComponent.ZRotation = spinDegrees * t
		end)

		_TimerService:SetTimerOnce(function()
			if not isvalid(icon) then return end
			icon.Entity.UITransformComponent.ZRotation = 0
			if onGrounded ~= nil then onGrounded(groundUI) end
		end, duration)
	end

	-- 서버가 "플레이어가 드랍된 존을 떠났다"고 판단한 시점에 호출 — 현재 비행 중인 잡템 슬롯이 있으면
	-- 이미 착지했으면 바로 가방으로 날아가게 하고, 아직 홉 중이면 착지 콜백이 대기 없이 바로 날아가게 한다
	@ExecSpace("Multicast")
	method void RequestLootCollectNow()
		if self:IsServer() then return end
		local slots = self:GetLootSlots()
		for i = 1, #slots do
			local slot = slots[i]
			if slot.busy then
				slot.collectRequested = true
				if slot.landed then self:TryFlyLootToBag(i, slot.landUI) end
			end
		end
	end

	-- 맵 이동으로 화면(카메라)이 통째로 바뀔 때 호출됨(MapManager.OnSyncProperty) — 드롭 아이콘은
	-- 화면 고정 UI 좌표라 맵이 바뀌어도 스스로는 안 움직인다. 존을 떠났다는 걸 서버가 감지해 조기수거를
	-- 알려주는 경로(RequestLootCollectNow)는 있지만, 그 시점에 아이콘이 아직 낙하/홉 애니메이션 중이면
	-- 그 연출을 끝까지 재생한 뒤에야 날아가서 "화면에 잠깐 남아있는 것처럼" 보일 수 있었다 — 여기서는
	-- 지금 화면에 떠 있는 위치 그대로에서 곧장 가방으로 날아가도록 강제로 건너뛴다
	@ExecSpace("ClientOnly")
	method void ForceFinishLootDrops()
		local slots = self:GetLootSlots()
		for i = 1, #slots do
			local slot = slots[i]
			if slot.busy and not slot.flown and isvalid(slot.icon) then
				slot.flown = true
				local pos = slot.icon.Entity.UITransformComponent.anchoredPosition
				self:FlyLootToBag(i, pos)
			end
		end
	end

	-- FlyLootToBag 진입점을 하나로 모아서, 조기 수거 경로와 정상 groundDelay 타이머 경로가 겹쳐도
	-- 실제로는 딱 한 번만 날아가도록 가드한다 (TryFlyPotionToHpBar와 동일한 목적)
	@ExecSpace("ClientOnly")
	method void TryFlyLootToBag(integer slotIndex, Vector2 landUI)
		local slot = self:GetLootSlots()[slotIndex]
		if slot.flown then return end
		slot.flown = true
		self:FlyLootToBag(slotIndex, landUI)
	end

	@ExecSpace("ClientOnly")
	method void FlyLootToBag(integer slotIndex, Vector2 startUI)
		local slot = self:GetLootSlots()[slotIndex]
		local icon = slot.icon
		if not isvalid(icon) then return end
		local endUI = self.LootFlyTargetUI
		local arcHeight = 150

		_TweenLogic:PlayTween(0.0, 1.0, self.PotionFlyDuration, EaseType.QuadEaseOut, function(t)
			if not isvalid(icon) then return end
			local x = startUI.x + (endUI.x - startUI.x) * t
			local y = startUI.y + (endUI.y - startUI.y) * t + math.sin(t * math.pi) * arcHeight
			icon.Entity.UITransformComponent.anchoredPosition = Vector2(x, y)
			local scale = (1.0 - 0.5 * t) * slot.dropScale
			icon.Entity.UITransformComponent.Scale = Vector3(scale, scale, 1)
			icon.Color = Color(1, 1, 1, 1.0 - 0.6 * t)
		end)

		_TimerService:SetTimerOnce(function()
			if not isvalid(icon) then return end
			icon.Entity:SetEnable(false)
			slot.busy = false
			self:PunchBagIcon()
		end, self.PotionFlyDuration)
	end

	-- 어떤 이유로든(예상 못한 버그, 아이콘 무효화 등) 정상 경로가 끝까지 완주되지 못해 5초가 지나도
	-- 여전히 그 드롭이 busy 상태면, 화면에 아이템이 영구히 남지 않도록 강제로 숨기고 슬롯을 반납한다.
	-- token으로 "그 사이 같은 슬롯이 이미 새 드롭에 재사용됐는지"를 구분해 새 드롭을 잘못 지우지 않는다
	@ExecSpace("ClientOnly")
	method void WatchdogClearLootIcon(integer slotIndex, integer token)
		local slot = self:GetLootSlots()[slotIndex]
		if slot.token ~= token then return end
		if not slot.busy then return end
		if isvalid(slot.icon) then slot.icon.Entity:SetEnable(false) end
		slot.busy = false
		log_warning("Loot drop visual watchdog: force-cleared a stuck icon (slot " .. slotIndex .. ")")
	end

	@ExecSpace("ClientOnly")
	method void PunchBagIcon()
		-- 잡템 도착 시 가방 아이콘을 잠깐 확대-축소시켜 도착감을 준다
		if not isvalid(self.btnInventory) then return end
		_TweenLogic:ScaleTo(self.btnInventory.Entity, Vector2(1.15, 1.15), 0.12, EaseType.BackEaseOut)
		_TimerService:SetTimerOnce(function()
			if isvalid(self.btnInventory) then
				_TweenLogic:ScaleTo(self.btnInventory.Entity, Vector2(1, 1), 0.15, EaseType.QuadEaseOut)
			end
		end, 0.12)
	end

	-- 맵10 보너스 보스 전용: 드롭 여부 확률은 호출측(MonsterAI.OnBonusBossHit)이 이미 굴렸으므로
	-- 여기서는 무조건 드롭한다 (빨강/흰색만 배타적으로 선택)
	@ExecSpace("ServerOnly")
	method void ForceDropPotion(Vector3 worldPos, number dropScale)
		if self.GameOver then return end
		local potionType = (_UtilLogic:RandomDouble() < 0.7) and 1 or 2
		-- 보너스 보스는 비행형이 아니라 사망 위치가 항상 바닥이므로 fallHeight=0 고정(groundWorldY는 미사용)
		self:ApplyPotionDrop(potionType, worldPos, 0, worldPos.y, dropScale)
	end

	-- SkillInventory 포션(스킬 인덱스1) 레벨의 회복량 보너스 — Lv1:+5% / Lv2:+7% / Lv3:+9%,
	-- 카드 자체 PotionLevel과 완전히 별개로 항상 가산된다
	@ExecSpace("ServerOnly")
	method number GetSkillInvPotionHealBonusPercent()
		local lv = 0
		if _SkillInventory.Levels["1"] ~= nil then lv = _SkillInventory.Levels["1"] end
		if lv >= 3 then return 0.09
		elseif lv >= 2 then return 0.07
		elseif lv >= 1 then return 0.05
		end
		return 0
	end

	-- TryDropHealPotion / ForceDropPotion 공용 — 회복량 계산 + 드롭 연출/타이밍 적용
	-- fallHeight: 비행형 몬스터처럼 사망 위치가 공중일 때, 바닥(타일) 높이까지 먼저 빙그르르 돌며
	-- 떨어지는 연출에 걸리는 추가 시간(UI px 기준, 0이면 생략)만큼 arrivalDelay에도 함께 반영한다
	-- (TryDropLootItem/ScheduleLootDrop과 동일한 패턴)
	@ExecSpace("ServerOnly")
	method void ApplyPotionDrop(integer potionType, Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		-- potionType 3 = 파워 엘릭서(보스 확정 드롭) — 비율 회복 대신 완전 회복 + 전체 스킬 쿨타임 초기화
		local healAmount = 0
		if potionType == 3 then
			healAmount = self.PlayerMaxHp
		else
			local basePercent = (potionType == 1) and self.RedPotionHealPercent or self.WhitePotionHealPercent
			-- 유물 레벨업 보너스(레벨 합계 1당 +1%p)를 회복 비율에 더한다.
			-- SkillInventory 포션(스킬 인덱스1) 레벨의 +5%/+7%/+9%도 카드 자체 레벨과 별개로 항상 가산된다.
			local healPercent = basePercent + (_RelicInventory:GetPotionHealBonusPercent() / 100) + self:GetSkillInvPotionHealBonusPercent()
			healAmount = math.floor(self.PlayerMaxHp * healPercent)
		end
		log("HealPotion dropped: type=" .. potionType .. " heal=" .. healAmount)

		local applyEffect = function()
			self:HealPlayer(healAmount)
			if potionType == 3 then _CardManager:ResetAllCooldowns() end
		end

		-- 포션은 "드랍된 존에 있다가 그 존에서 획득"하는 아이템이지만, 존을 떠났다고 그냥 사라지면
		-- 억울하다 — 이동한 순간 그 자리에서 바로 주운 것으로 치고 획득 연출(HP바로 날아가는 것)로
		-- 즉시 넘어가는 게 맞다. 드랍 시점의 존을 기억해뒀다가, 짧은 주기로 존이 바뀌었는지 감시하면서
		-- 바뀌는 즉시 회복을 적용하고 클라이언트에 "지금 바로 수거하라"고 알린다.
		local dropZone = _MapManager.CurrentMapIndex
		local groundDelay = 0.6 + _UtilLogic:RandomDouble() * 0.6
		local fallDuration = 0
		if fallHeight > 0 then fallDuration = math.min(0.6, 0.15 + fallHeight / 500) end
		local arrivalDelay = fallDuration + self.PotionPopDuration + groundDelay + self.PotionFlyDuration

		local healed = false
		local watchTimerId = 0
		watchTimerId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self) or healed then return end
			if _MapManager.CurrentMapIndex ~= dropZone then
				healed = true
				applyEffect()
				_TimerService:ClearTimer(watchTimerId)
				self:RequestPotionCollectNow()
			end
		end, 0.15)

		_TimerService:SetTimerOnce(function()
			if isvalid(self) and not healed then
				healed = true
				applyEffect()
				_TimerService:ClearTimer(watchTimerId)
			end
		end, arrivalDelay)

		self:PlayPotionDropVisual(Vector2(worldPos.x, worldPos.y), potionType, groundDelay, fallHeight, groundWorldY, dropScale)
	end

	@ExecSpace("Multicast")
	method void PlayPotionDropVisual(Vector2 worldPos, integer potionType, number groundDelay, number fallHeight, number groundWorldY, number dropScale)
		-- 사망 위치에 포션이 떨어진 것처럼 보여준 뒤, 잠시 멈췄다가 HP바로 날아간다.
		-- 비행형 몬스터(fallHeight>0)는 먼저 바닥 높이까지 빙그르르 돌며 떨어진 뒤 이어서 홉 연출을 재생한다
		-- (PlayLootDropVisual과 동일한 패턴 — PlayFallSpin은 공용 메서드).
		if self:IsServer() then return end
		-- 이전 드롭 연출이 아직 진행 중이면 스킵 (회복은 서버에서 별도로 처리됨)
		if self._potionFlyActive then return end

		self._potionFlyActive = true
		self._potionLanded = false
		self._potionCollectRequested = false
		self._potionFlown = false
		-- HP바로 날아가는 마지막 단계(FlyPotionToHpBar)는 서버가 별도로 트리거하는 조기수거
		-- (RequestPotionCollectNow)에서도 다시 필요하므로 클로저가 아니라 프로퍼티로 저장해둔다.
		self._potionDropScale = dropScale
		local rawUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(worldPos))
		local startUI = Vector2(rawUI.x, rawUI.y + self.DropYOffset)
		local icon = self.potionFlyIcon
		if potionType == 1 then
			icon.ImageRUID = self.RedPotionRUID
		elseif potionType == 2 then
			icon.ImageRUID = self.WhitePotionRUID
		else
			icon.ImageRUID = self.PowerElixirRUID
		end
		icon.Color = Color(1, 1, 1, 1)
		icon.Entity:SetEnable(true)
		local tc = icon.Entity.UITransformComponent
		tc.anchoredPosition = startUI
		tc.Scale = Vector3(dropScale, dropScale, 1)
		tc.ZRotation = 0

		-- 메이플식 드롭: 좌우 랜덤 방향으로 포물선 홉 → 점점 작아지는 바운스 2회로 바닥에 안착한 뒤,
		-- groundDelay만큼 머물렀다가 HP바로 날아간다. 단, 그 사이 존을 떠나 조기 수거 요청이 이미
		-- 와있었다면(홉 중에 존이 바뀐 경우) 대기 없이 바로 날아간다.
		local continueFromGround = function(groundUI)
			self:PlayDropPop(icon, groundUI, function(landUI)
				self._potionLanded = true
				self._potionLandUI = landUI
				if self._potionCollectRequested then
					self:TryFlyPotionToHpBar(icon, landUI)
					return
				end
				_TimerService:SetTimerOnce(function()
					self:TryFlyPotionToHpBar(icon, landUI)
				end, groundDelay)
			end)
		end

		local landYCorrection = self:GetDropLandYCorrection(dropScale)

		if fallHeight > 0 then
			-- 착지 지점(groundUI)에는 DropYOffset을 더하지 않는다 — 여기 더하면 최종적으로 안착하는
			-- 높이가 실제 바닥보다 계속 떠 보인다(유저 실측 확인: 아이템이 바닥에 안 붙고 공중에 떠있음).
			-- 등장 시작점(startUI)에만 오프셋을 남겨서 "몸에서 팡 튀어나오는" 연출은 그대로 유지한다.
			local groundUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(Vector2(worldPos.x, groundWorldY)))
			groundUI = Vector2(groundUI.x, groundUI.y + landYCorrection)
			self:PlayFallSpin(icon, startUI, groundUI, fallHeight, continueFromGround)
		else
			continueFromGround(Vector2(rawUI.x, rawUI.y + landYCorrection))
		end
	end

	-- 서버가 "플레이어가 드랍된 존을 떠났다"고 판단한 시점에 호출 — 이미 바닥에 착지해 대기 중이면
	-- 그 자리에서 바로 HP바로 날아가게 하고, 아직 홉 애니메이션 중이면 착지 콜백이 groundDelay 대기 없이
	-- 곧바로 날아가도록 플래그만 세워둔다(홉 자체를 끊지는 않는다 — 짧아서 위화감이 없다).
	@ExecSpace("Multicast")
	method void RequestPotionCollectNow()
		if self:IsServer() then return end
		if not self._potionFlyActive then return end
		self._potionCollectRequested = true
		if self._potionLanded then
			self:TryFlyPotionToHpBar(self.potionFlyIcon, self._potionLandUI)
		end
	end

	-- FlyPotionToHpBar 진입점을 하나로 모아서, 조기 수거 경로와 정상 groundDelay 타이머 경로가
	-- 둘 다 착지 이후에 도달할 수 있는 상황에서도 실제로는 딱 한 번만 날아가도록 가드한다.
	@ExecSpace("ClientOnly")
	method void TryFlyPotionToHpBar(SpriteGUIRendererComponent icon, Vector2 landUI)
		if self._potionFlown then return end
		self._potionFlown = true
		self:FlyPotionToHpBar(icon, landUI)
	end

	@ExecSpace("ClientOnly")
	method void PlayDropPop(SpriteGUIRendererComponent icon, Vector2 startUI, any onLanded)
		-- 메이플 아이템 드롭 특유의 "톡 튀어나와 바닥에 안착" 모션: 좌우 랜덤 방향 큰 홉 1회 + 점점 작아지는 제자리 바운스 2회
		if not isvalid(icon) then return end
		local dir = (_UtilLogic:RandomDouble() < 0.5) and -1 or 1
		local landUI = Vector2(startUI.x + dir * (45 + _UtilLogic:RandomDouble() * 45), startUI.y)

		self:PlayHop(icon, startUI, landUI, 70, 0.32, function()
			self:PlayHop(icon, landUI, landUI, 24, 0.16, function()
				self:PlayHop(icon, landUI, landUI, 10, 0.11, function()
					if onLanded ~= nil then onLanded(landUI) end
				end)
			end)
		end)
	end

	@ExecSpace("ClientOnly")
	method void PlayHop(SpriteGUIRendererComponent icon, Vector2 fromUI, Vector2 toUI, number height, number duration, any onDone)
		-- fromUI → toUI 로 포물선(사인 아치)을 그리며 한 번 홉. fromUI==toUI면 제자리 바운스
		_TweenLogic:PlayTween(0.0, 1.0, duration, EaseType.QuadEaseOut, function(t)
			if not isvalid(icon) then return end
			local x = fromUI.x + (toUI.x - fromUI.x) * t
			local y = fromUI.y + (toUI.y - fromUI.y) * t + math.sin(t * math.pi) * height
			icon.Entity.UITransformComponent.anchoredPosition = Vector2(x, y)
		end)
		_TimerService:SetTimerOnce(function()
			if onDone ~= nil then onDone() end
		end, duration)
	end

	@ExecSpace("ClientOnly")
	method void FlyPotionToHpBar(SpriteGUIRendererComponent icon, Vector2 startUI)
		-- 포물선을 그리며 HP바 위치로 날아가는 동안 점점 작아지고 투명해진 뒤 사라지고, HP바를 살짝 펀치 + 반짝임 연출
		if not isvalid(icon) then return end
		local endUI = self.HpBarFlyTargetUI
		local arcHeight = 150

		_TweenLogic:PlayTween(0.0, 1.0, self.PotionFlyDuration, EaseType.QuadEaseOut, function(t)
			if not isvalid(icon) then return end
			local x = startUI.x + (endUI.x - startUI.x) * t
			local y = startUI.y + (endUI.y - startUI.y) * t + math.sin(t * math.pi) * arcHeight
			icon.Entity.UITransformComponent.anchoredPosition = Vector2(x, y)
			local scale = (1.0 - 0.5 * t) * self._potionDropScale
			icon.Entity.UITransformComponent.Scale = Vector3(scale, scale, 1)
			icon.Color = Color(1, 1, 1, 1.0 - 0.6 * t)
		end)

		_TimerService:SetTimerOnce(function()
			if not isvalid(icon) then return end
			icon.Entity:SetEnable(false)
			self._potionFlyActive = false
			self:PunchHpBar()
		end, self.PotionFlyDuration)
	end

	@ExecSpace("ClientOnly")
	method void PunchHpBar()
		-- 포션 도착 시 HP바를 잠깐 확대-축소시키고 반짝이 파티클을 재생해 도착감을 준다
		_TweenLogic:ScaleTo(self.hpBar.Entity, Vector2(1.06, 1.15), 0.12, EaseType.BackEaseOut)
		self:PlayHpSparkle()
		_TimerService:SetTimerOnce(function()
			if isvalid(self.hpBar) then
				_TweenLogic:ScaleTo(self.hpBar.Entity, Vector2(1, 1), 0.15, EaseType.QuadEaseOut)
			end
		end, 0.12)
	end

	@ExecSpace("ClientOnly")
	method void PlayHpSparkle()
		-- 반짝이 파티클을 재생하고, 재생 시간 동안 알파를 1→0으로 서서히 줄여 자연스럽게 사라지게 한다
		if self.hpSparkle == nil then return end
		self.hpSparkle.Color = Color(1, 0.9137254901960784, 0.6588235294117647, 1)
		self.hpSparkle:Play()
		_TweenLogic:PlayTween(1.0, 0.0, 0.5, EaseType.QuadEaseIn, function(a)
			if not isvalid(self.hpSparkle) then return end
			local c = self.hpSparkle.Color
			self.hpSparkle.Color = Color(c.r, c.g, c.b, a)
		end)
		_TimerService:SetTimerOnce(function()
			if isvalid(self.hpSparkle) then self.hpSparkle:Stop() end
		end, 0.5)
	end

	@ExecSpace("ServerOnly")
	method void AddGold(integer amount)
		-- 엘리트 몬스터 드롭 등 카드 강화와 무관한 보상에 사용. 런 내 골드(리셋됨)와 메인화면
		-- 우측 상단 누적 코인(영구 저장, TotalCoins)을 항상 같이 늘린다 — 골드를 지급하는 모든
		-- 지점은 이 메서드를 거쳐야 두 값이 어긋나지 않는다
		self.Gold = self.Gold + amount
		self.TotalCoins = self.TotalCoins + amount
		self._coinDirty = true
		_TitleUI:NotifyCoinsChanged(self.TotalCoins)
		log("Gold +" .. amount .. " -> " .. self.Gold .. " (TotalCoins:" .. self.TotalCoins .. ")")
	end

	@ExecSpace("ServerOnly")
	method boolean SpendCoins(integer amount)
		-- 메인화면 누적 코인(TotalCoins)에서 소비한다 — 유물 강화 등 런과 무관한 영구 진행 요소가 사용.
		-- 코인이 부족하면 false만 반환하고 아무것도 바꾸지 않는다
		if self.TotalCoins < amount then return false end
		self.TotalCoins = self.TotalCoins - amount
		self._coinDirty = true
		_TitleUI:NotifyCoinsChanged(self.TotalCoins)
		log("Coins -" .. amount .. " -> " .. self.TotalCoins)
		return true
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		if self._coinFlushTimerId then _TimerService:ClearTimer(self._coinFlushTimerId) end
		self:FlushCoinsIfDirty()
		self:FlushVoucherIfDirty()
	end

end
