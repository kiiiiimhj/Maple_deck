	-- 맵4~6 전용 몬스터 풀 die1 1회 재생 시간 (프레임 수 × ~100ms + 여유, 기존 웨이브 테이블과 동일한 공식)
	@ExecSpace("ServerOnly")
	method number GetZoneDieDuration(integer idx)
		local durations = {
			0.95,  -- 1: 음흉한 여우      9프레임
			1.05,  -- 2: 이상한 돼지     10프레임
			0.35,  -- 3: 주황버섯         3프레임
			0.45,  -- 4: 시니컬한 주황버섯 4프레임
		}
		local i = math.max(1, math.min(idx, #durations))
		return durations[i]
	end

	-- 맵4~6 몬스터 풀 종 개수 (MonsterAI가 무작위 인덱스를 뽑을 때 사용)
	@ExecSpace("ServerOnly")
	method integer GetZoneMonsterCount()
		return 4
	end

	-- 맵7~9 전용 몬스터 풀 (맵마다 별도 구성) — 7:고스텀프/엑스텀프, 8:와일드보어/아이언호그, 9:히죽대는 고스텀프/아이언보어/파이어보어,
	-- 11(맵6 우측 분기, 해변 존):로랑/엄티/클랑, 12:날치 슬라임/보라조개 슬라임/불가사리 문어 슬라임,
	-- 13(개미굴 입구):뿔버섯/좀비버섯, 14:이블아이/커즈아이, 15:커즈아이/박쥐(비행형)/이블아이,
	-- 16(그림자 존):내면의 그림자(비행형)/그림자 보어, 17:그림자 스텀프/그림자 엑스텀프. 18은 몬스터 없음
	-- (MonsterSpawner.IsNoMonsterZone에서 스폰 자체를 건너뛰므로 여기 값은 안 쓰인다).
	-- 19~22(그룹G):19:스톤골렘, 20:다크 스톤골렘/페어리(비행형), 21:믹스골렘/아이스 믹스골렘,
	-- 22:로얄 페어리(비행형)/아이스 믹스골렘.
	-- 23~26(그룹H, map18):23:반딧불 슬라임/페어리 슬라임, 24:워터 엘리먼트(비행형)/트리 엘리먼트(비행형),
	-- 25:미스틱 위습(비행형)/하급 마법책, 26:워터 엘리먼트(비행형)/페어리 슬라임/미스틱 위습(비행형, 3종).
	-- 27~30(그룹I, map19, 닌자 컨셉):27:쉐도우 듀어러/자이언트 쉐도우, 28:쉐도우 블레이드(지상형)/스티지(비행형),
	-- 29:훈련된 오다군 정찰병, 30:쉐도우 블레이드(지상형 재사용)/훈련된 오다군 정찰병(재사용).
	-- 31~34(그룹J, map20, 정글 컨셉):31:루팡(원거리), 32:길들일 수 있는 재규어,
	-- 33:바나나갈매기(비행형)/재규어(재사용), 34:바나나갈매기(비행형 재사용)/좀비루팡(원거리).
	@ExecSpace("ServerOnly")
	method integer GetMapMonsterCount(integer mapIndex)
		if mapIndex == 7 then return 2
		elseif mapIndex == 8 then return 2
		elseif mapIndex == 9 then return 3
		elseif mapIndex == 11 then return 3
		elseif mapIndex == 12 then return 3
		elseif mapIndex == 13 then return 2
		elseif mapIndex == 14 then return 2
		elseif mapIndex == 15 then return 3
		elseif mapIndex == 16 then return 2
		elseif mapIndex == 17 then return 2
		elseif mapIndex == 19 then return 1
		elseif mapIndex == 20 then return 2
		elseif mapIndex == 21 then return 2
		elseif mapIndex == 22 then return 2
		elseif mapIndex == 23 then return 2
		elseif mapIndex == 24 then return 2
		elseif mapIndex == 25 then return 2
		elseif mapIndex == 26 then return 3
		elseif mapIndex == 27 then return 2
		elseif mapIndex == 28 then return 2
		elseif mapIndex == 29 then return 1
		elseif mapIndex == 30 then return 2
		elseif mapIndex == 31 then return 1
		elseif mapIndex == 32 then return 1
		elseif mapIndex == 33 then return 2
		elseif mapIndex == 34 then return 2
		end
		return 1
	end

