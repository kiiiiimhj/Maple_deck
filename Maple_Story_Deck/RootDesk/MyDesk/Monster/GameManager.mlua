	-- 웨이브별 die1 애니메이션 1회 재생 시간 (프레임 수 × ~100ms + 여유)
	@ExecSpace("ServerOnly")
	method number GetWaveDieDuration(integer wave)
		local durations = {
			0.95,  -- Wave  1: 달팽이      9프레임
			0.35,  -- Wave  2: 파란 달팽이  3프레임
			0.45,  -- Wave  3: 스포아      4프레임
			0.35,  -- Wave  4: 빨간 달팽이  3프레임
			0.45,  -- Wave  5: 슬라임      4프레임
			0.35,  -- Wave  6: 돼지        3프레임
			0.85,  -- Wave  7: 주니어 부기  8프레임
			0.35,  -- Wave  8: 스텀프      3프레임
			0.45,  -- Wave  9: 옥토퍼스    4프레임
			0.35,  -- Wave 10: 리본 돼지   3프레임
		}
		local idx = math.max(1, math.min(wave, #durations))
		return durations[idx]
	end

