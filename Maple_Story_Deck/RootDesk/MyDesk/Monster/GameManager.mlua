@Logic
script GameManager extends Logic

	-- 플레이어 스탯
	@Sync property integer PlayerHp = 100
	@Sync property integer PlayerMaxHp = 100

	-- 경험치 / 레벨
	@Sync property integer Level = 1
	@Sync property number Exp = 0
	@Sync property number ExpNeeded = 100

	-- 골드 (런 전용 — "다시하기" 누르면 0으로 리셋됨)
	@Sync property integer Gold = 0
	-- 골드 유물 보너스를 마지막으로 정산한 시점의 Gold 값 — TriggerGameOver()가 이 값 이후로
	-- "새로 번" 골드에만 보너스를 곱한다 (이어하기로 여러 번 게임오버가 나도 이미 보너스 받은
	-- 골드를 또 보너스 대상에 포함시키는 중복 적용을 막는다)
	property integer _goldBonusCheckpoint = 0

	-- 메인화면 우측 상단에 표시되는 누적 코인 — 런이 끝나도 리셋되지 않고 전역 저장소에 영구 저장됨
	@Sync property integer TotalCoins = 0
	property any _coinStorage = nil
	property boolean _coinDirty = false
	property any _coinFlushTimerId = nil

	-- 그림자 숲 샵(존18 NPC) 전용 재화 — 야누스의 검 교환권. TotalCoins와 동일한 패턴(전역 저장소,
	-- dirty-flag 지연 flush)으로 런이 끝나도 리셋되지 않고 영구 보존된다. 존16~17 몬스터 처치 시
	-- 5% 확률로 드롭(MonsterAI.Die 참고).
	@Sync property integer ShadowVoucher = 0
	property number ShadowVoucherDropChance = 0.05
	property any _voucherStorage = nil
	property boolean _voucherDirty = false

	-- 웨이브
	@Sync property integer Wave = 1

	-- 웨이브10 리본돼지 보스를 잡았는지 여부 — 맵4 이상 이동 가능 여부를 여기로 판정한다
	@Sync property boolean BossDefeated = false

	-- 게임 상태
	@Sync property boolean GameOver = false

	-- 이번 런에서 "이어하기"를 누른 횟수 — 누를 때마다 다음 이어하기 비용이 비싸진다.
	-- "다시하기"(처음부터, RestartGame)로만 0으로 리셋된다
	@Sync property integer ContinueCount = 0
	property any _continueCostTable = { 900, 1500, 2400, 3600 }

	-- 타이틀 화면에서 "게임 시작" 버튼을 눌러야 실제 웨이브/스폰이 시작된다 (그 전까지는 대기)
	@Sync property boolean GameStarted = false

	-- 몬스터 처치당 경험치/골드
	property number ExpPerKill = 20
	property integer GoldPerKill = 5
	property number ExpGrowthRate = 1.3   -- 레벨업마다 필요 경험치 ×1.3

	-- 클라이언트 전용: 화면 흔들림 판정을 위한 이전 HP 기억
	property integer _prevPlayerHp = 100

	-- 피격 무적 (동시 다중 피격 방지)
	property boolean _hitImmune = false

	-- UI 바인딩 (클라이언트 전용)
	property SliderComponent hpBar = "da3cd53f-f7a1-4345-b09b-2f0e7d0b658e"
	property TextComponent hpText = "7d054dd7-e575-4be3-8664-9994e2a4b172"
	property TextComponent playerNameText = "0c08115d-3aa6-4305-b587-c672c7398a4b"
	property SpriteGUIRendererComponent expBarFill = "f611e821-754b-437f-9633-2b26ea571c8d"
	property TextComponent expLevelText = "7e10b488-7eb5-44c2-98b0-87c80f1f38ec"
	property TextComponent expText = "998eb743-a64b-4cf3-af6c-f9dc870c315c"
	property TextComponent goldText = "96a9909e-7c1c-43e4-928f-1e97f0dcc8a3"

	-- 경험치 바가 순간이동하듯 뚝뚝 끊기지 않고 부드럽게 차오르는 데 걸리는 시간
	property number ExpBarFillDuration = 0.4
	-- 클라이언트 전용: NotifyExpChanged가 연달아 호출될 때 이전 트위너의 콜백을 무효화하기 위한 토큰
	property integer _expTweenToken = 0

	-- 일반 몬스터 처치 시 회복 포션 드롭 연출용 아이콘 (월드 사망 위치 → HP바로 포물선 비행)
	property SpriteGUIRendererComponent potionFlyIcon = "831d845f-6b01-459e-9724-3c7e26bf1af0"
	-- 원거리(먹물) 공격 몬스터가 도달했을 때 재생하는 화면 잉크 스플랫 아이콘 (ui/DefaultGroup.ui InkSplat)
	property SpriteGUIRendererComponent inkSplatIcon = "a2391bcc-9ccb-48f4-8aea-a358b123557e"
	property boolean _inkSplatActive = false
	-- 잉크 스플랫 최종 크기(팝 연출이 도달하는 스케일)와 페이드 아웃 소요 시간 — 기존 1.0/0.8초보다
	-- 더 크고 더 빨리 사라지게 해달라는 요청으로 조정
	property number InkSplatMaxScale = 1.3
	property number InkSplatFadeDuration = 0.5

	-- 회복 포션 드롭 확률 (배타적 — 빨강 5%, 흰색 2%, 나머지 93%는 드롭 없음)
	property number RedPotionDropChance = 0.05
	property number WhitePotionDropChance = 0.02

	-- 일반 잡템(가방행) 드롭 확률 — 존16~17(그림자 존)은 야누스의 검 교환권 전용이라 제외한다
	property number LootItemDropChance = 0.35

	-- 잡템 드롭 연출용 아이콘 (포션과 동일한 방식 — 월드 사망 위치 → 가방 아이콘으로 포물선 비행).
	-- 짧은 시간에 여러 마리가 죽어도 겹치지 않도록 4개를 돌려쓴다(2개였을 때 몰려 죽으면 슬롯이
	-- 부족해 드롭이 밀리는 문제가 실측됨)
	property SpriteGUIRendererComponent lootFlyIcon1 = "54e5fc11-ff74-4d52-9b94-562e62bbe4c0"
	property SpriteGUIRendererComponent lootFlyIcon2 = "a1209f8e-2506-4f2b-8d19-45b1e8285b09"
	property SpriteGUIRendererComponent lootFlyIcon3 = "b71cf15a-16d4-4a2d-8643-2473071ac27c"
	property SpriteGUIRendererComponent lootFlyIcon4 = "365a8647-5b4d-4d7b-943c-86d6412215d7"
	-- 클라이언트 전용 슬롯 상태(런타임에 지연 생성) — 각 원소: { icon, busy, landed, landUI, collectRequested, flown, token }
	property any _lootSlots = nil
	-- 가방 아이콘(ui/DefaultGroup.ui BtnInventory, top-right anchor -34,-180 + size 88,88)의 중심을
	-- 화면 중앙 기준 좌표(DropFlyIcon과 동일한 좌표계)로 환산한 값
	property Vector2 LootFlyTargetUI = Vector2(882, 316)
	property ButtonComponent btnInventory = "22519eca-9947-4040-bbd4-45afb7d9f95a"

	-- 아이템 드롭 등장 Y 좌표 보정 (죽은 위치를 화면 좌표로 환산한 값에 더해 살짝 위로 띄운다)
	property number DropYOffset = 60

	-- 회복 포션 RUID (CardManager의 포션 강화 아이콘과 동일한 스프라이트 재사용 — 빨간 포션/하얀 포션)
	property string RedPotionRUID = "234aca1a4ce946119b68e3717991e775"
	property string WhitePotionRUID = "289c7bdcbdc8484ab7bad688b2519ca7"

	-- 포션별 회복량 (최대 HP 비율)
	property number RedPotionHealPercent = 0.08
	property number WhitePotionHealPercent = 0.15

	-- HP바 비행 도착 지점 — ui/DefaultGroup.ui HPBar(anchoredPosition 20,265 + size 200,28)의 중심을
	-- 화면 중앙 기준 좌표(DropFlyIcon과 동일한 좌표계)로 환산한 값
	property Vector2 HpBarFlyTargetUI = Vector2(-840, -261)

	-- 포션이 HP바에 도착했을 때 재생하는 반짝이 파티클
	property UIBasicParticleComponent hpSparkle = "e0306988-7548-462c-aae9-8a3d82664c99"

	-- 드롭 팝 연출(PlayDropPop 내부 3단계 홉 0.32+0.16+0.11)과 HP바 비행(FlyPotionToHpBar) 시간 합 —
	-- 서버가 회복을 "포션이 HP바에 실제로 도착하는 시점"에 맞춰 적용하기 위한 기준값
	property number PotionPopDuration = 0.59
	property number PotionFlyDuration = 0.5

	-- 클라이언트 전용: 포션 드롭 연출이 진행 중이면 true — 공용 potionFlyIcon을 덮어쓰지 않도록 가드
	property boolean _potionFlyActive = false
	-- 드롭 팝(홉) 애니메이션이 끝나 바닥에 착지했는지, 착지 지점이 어디인지 — 존 이탈로 조기 수거를
	-- 요청받았을 때 이미 착지해 있으면 그 자리에서 바로 HP바로 날아가게 하기 위해 기억해둔다
	property boolean _potionLanded = false
	property Vector2 _potionLandUI = Vector2(0, 0)
	-- 아직 홉 애니메이션 중일 때 조기 수거 요청이 왔으면 true로 세워두고, 착지 콜백에서 groundDelay
	-- 대기 없이 바로 날아가도록 한다
	property boolean _potionCollectRequested = false
	-- FlyPotionToHpBar가 이미 시작됐는지 — 조기 수거(RequestPotionCollectNow)와 정상 groundDelay 타이머
	-- 양쪽 경로 모두 착지 후에 이 메서드를 부를 수 있어서, 중복 호출(같은 포션이 두 번 날아가는 것처럼
	-- 보이는 버그)을 막는 가드가 필요하다
	property boolean _potionFlown = false

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self.PlayerHp = self.PlayerMaxHp
		self.Exp = 0
		self.ExpNeeded = 100
		self.Gold = 0
		self.Level = 1
		self.Wave = 1
		self.GameOver = false
		self:NotifyExpChanged(self.Exp, self.ExpNeeded, self.Level, false)

		-- 누적 코인은 런과 무관하게 전역 저장소에서 불러온다 (RelicInventory와 동일한 dirty-flag 패턴)
		self._coinStorage = _DataStorageService:GetGlobalDataStorage("PlayerCoins")
		local errorCode, raw = self._coinStorage:GetAndWait("TotalCoins")
		if errorCode == 0 and raw ~= nil and raw ~= "" then
			local loaded = tonumber(raw)
			if loaded ~= nil then self.TotalCoins = loaded end
		end
		self._coinFlushTimerId = _TimerService:SetTimerRepeat(function()
			self:FlushCoinsIfDirty()
			self:FlushVoucherIfDirty()
		end, 3.0)

		-- 야누스의 검 교환권도 TotalCoins와 동일하게 전역 저장소에서 불러온다
		self._voucherStorage = _DataStorageService:GetGlobalDataStorage("PlayerCoins")
		local voucherErrorCode, voucherRaw = self._voucherStorage:GetAndWait("ShadowVoucher")
		if voucherErrorCode == 0 and voucherRaw ~= nil and voucherRaw ~= "" then
			local loadedVoucher = tonumber(voucherRaw)
			if loadedVoucher ~= nil then self.ShadowVoucher = loadedVoucher end
		end

		log("GameManager started")
	end

	@ExecSpace("Server")
	method void RequestCoinSync()
		-- TitleUI.OnBeginPlay가 호출한다. TotalCoins는 @Sync라 자동 전파되지만, 서버가 스토리지에서
		-- 불러오는(OnBeginPlay, GetAndWait) 시점과 클라이언트가 자기 UI를 초기화하는 시점 사이에는
		-- 순서 보장이 없다 — 클라이언트가 먼저 뜨면 아직 로드 전인 기본값(0)을 그대로 표시해버려서
		-- "코인이 초기화된 것처럼 보이는" 버그가 된다. 클라이언트가 준비된 시점에 직접 요청(pull)하면
		-- 그 시점 서버는 이미 OnBeginPlay를 끝낸 뒤이므로(월드 시작이 클라이언트 접속보다 항상 먼저다)
		-- 항상 정확한 값을 받을 수 있다
		_TitleUI:NotifyCoinsChanged(self.TotalCoins)
	end

	@ExecSpace("ServerOnly")
	method void FlushCoinsIfDirty()
		-- SetAndWait를 쓴다 — Async 콜백을 기다리지 않고 OnEndPlay가 먼저 끝나버리면(에디터/월드 종료 시)
		-- 저장이 씹힐 수 있어서, 드물게 호출되는 이 경로는 블로킹 저장으로 확실히 반영되게 한다
		if not self._coinDirty then return end
		self._coinDirty = false
		self._coinStorage:SetAndWait("TotalCoins", tostring(self.TotalCoins))
	end

	@ExecSpace("ServerOnly")
	method void FlushVoucherIfDirty()
		if not self._voucherDirty then return end
		self._voucherDirty = false
		self._voucherStorage:SetAndWait("ShadowVoucher", tostring(self.ShadowVoucher))
	end

	property string ShadowVoucherIconRUID = "b4ef5ecaa6584954831a86bd844e287e"

	-- 존16~17 몬스터 처치 시 MonsterAI.Die()가 호출 — 확률 판정 후 성공하면 1개 지급.
	-- 일반 잡템과 동일하게 사망 위치에서 바닥에 떨어졌다가 가방으로 날아가는 연출을 보여준 뒤 지급한다
	@ExecSpace("ServerOnly")
	method void TryDropShadowVoucher(Vector3 worldPos, number fallHeight, number groundWorldY)
		if self.GameOver then return end
		if _UtilLogic:RandomDouble() >= self.ShadowVoucherDropChance then return end
		self:ScheduleLootDrop(worldPos, self.ShadowVoucherIconRUID, fallHeight, groundWorldY, function()
			self:AddShadowVoucher(1)
		end)
		log("ShadowVoucher dropped!")
	end

	@ExecSpace("ServerOnly")
	method void AddShadowVoucher(integer amount)
		self.ShadowVoucher = self.ShadowVoucher + amount
		self._voucherDirty = true
		_ShadowShopUI:NotifyVoucherChanged(self.ShadowVoucher)
	end

	@ExecSpace("ServerOnly")
	method boolean SpendShadowVoucher(integer amount)
		-- 그림자 숲 샵 구매 결제. 부족하면 false만 반환하고 아무것도 바꾸지 않는다
		if self.ShadowVoucher < amount then return false end
		self.ShadowVoucher = self.ShadowVoucher - amount
		self._voucherDirty = true
		_ShadowShopUI:NotifyVoucherChanged(self.ShadowVoucher)
		return true
	end

	-- HP/EXP 동기화 → UI 갱신
	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		if name == "PlayerHp" or name == "PlayerMaxHp" then
			self.hpBar.MaxValue = self.PlayerMaxHp
			self.hpBar.Value = self.PlayerHp
			self.hpText.Text = tostring(math.floor(self.PlayerHp / self.PlayerMaxHp * 100)) .. "%"
			if name == "PlayerHp" and self.PlayerHp < self._prevPlayerHp then
				self:ShakeCameraOnHit()
			end
			self._prevPlayerHp = self.PlayerHp
		elseif name == "Gold" then
			self.goldText.Text = ": " .. self.Gold
		end
	end

	@ExecSpace("ClientOnly")
	method void InitPlayerNameUI()
		-- 로비 진입 시 TitleUI가 1회 호출 — 하드코딩된 "Player" 대신 실제 유저 닉네임을 표시한다
		local localPlayer = _UserService.LocalPlayer
		if localPlayer ~= nil and localPlayer.PlayerComponent ~= nil then
			self.playerNameText.Text = localPlayer.PlayerComponent.Nickname
		end
	end

	-- 경험치 바 갱신 연출. @Sync 프로퍼티 갱신과 이 Multicast 호출은 서로 다른 채널이라 순서 보장이
	-- 없어서(다른 곳에서 이미 한번 겪은 문제), self.Exp/ExpNeeded/Level을 클라이언트에서 다시 읽지 않고
	-- 서버가 확정한 값을 파라미터로 직접 넘긴다 — 레벨업 순간엔 Exp가 훅 줄어드는데, 그걸 동기화 타이밍에
	-- 의존해서 감지하려다 보니 "차있던 데서 줄어드는 것처럼" 보이는 버그가 났었다.
	@ExecSpace("Multicast")
	method void NotifyExpChanged(number newExp, number newExpNeeded, integer newLevel, boolean didLevelUp)
		if not self:IsClient() then return end
		local ratio = math.max(0, math.min(1, newExp / newExpNeeded))
		local startRatio = self.expBarFill.FillAmount
		if didLevelUp then startRatio = 0 end
		-- 몬스터가 여러 마리 거의 동시에 죽으면(광역기 등) NotifyExpChanged가 0.4초(ExpBarFillDuration)
		-- 안에 연달아 여러 번 호출되는데, PlayTween은 호출할 때마다 독립된 새 트위너를 만들 뿐 이전
		-- 트위너를 취소하지 않는다 — 그래서 먼저 시작된 트위너와 나중 트위너가 같은 프레임에 동시에
		-- FillAmount를 서로 다른 값으로 덮어써서 바가 순간적으로 뒤로 가는 것처럼 보이는 버그가 있었다.
		-- 토큰으로 "가장 최근에 시작된 트위너"만 실제로 값을 쓰게 하고, 그 전 트위너의 콜백은 조용히 무시한다.
		self._expTweenToken = self._expTweenToken + 1
		local token = self._expTweenToken
		_TweenLogic:PlayTween(startRatio, ratio, self.ExpBarFillDuration, EaseType.QuadEaseOut, function(value)
			if self._expTweenToken ~= token then return end
			if isvalid(self.expBarFill) then self.expBarFill.FillAmount = value end
		end)
		self.expLevelText.Text = "Lv." .. newLevel
		self.expText.Text = math.floor(newExp) .. " / " .. math.floor(newExpNeeded)
	end

	-- 플레이어 피격 시 화면을 살짝 흔든다
	@ExecSpace("ClientOnly")
	method void ShakeCameraOnHit()
		local cam = _CameraService:GetCurrentCameraComponent()
		if cam == nil then return end
		cam:ShakeCamera(0.2, 0.15)
		log("ShakeCameraOnHit triggered")
	end

	-- 원거리(먹물) 공격 몬스터가 플레이어에게 도달했을 때 MonsterAI가 호출 — 몬스터 위치 근처 화면 좌표에
	-- 먹물 스플랫 아이콘을 툭 튀어나오듯 팝시킨 뒤, 잠깐 붙어있다가 알파를 서서히 빼며 사라지게 한다
	@ExecSpace("Multicast")
	method void PlayInkSplat(Vector2 worldPos)
		if self:IsServer() then return end
		if self._inkSplatActive then return end
		self._inkSplatActive = true

		local rawUI = _UILogic:ScreenToUIPosition(_UILogic:WorldToScreenPosition(worldPos))
		local offsetX = (_UtilLogic:RandomDouble() * 2 - 1) * 220
		local offsetY = (_UtilLogic:RandomDouble() * 2 - 1) * 140
		local splatUI = Vector2(rawUI.x + offsetX, rawUI.y + offsetY)

		local icon = self.inkSplatIcon
		icon.Color = Color(1, 1, 1, 1)
		icon.Entity:SetEnable(true)
		local tc = icon.Entity.UITransformComponent
		tc.anchoredPosition = splatUI
		tc.Scale = Vector3(0.3, 0.3, 1)

		-- 팝: 작은 크기에서 순간적으로 튀어나오듯 확대되며 화면에 붙는다 (요청에 따라 최종 크기를
		-- 1.0 → InkSplatMaxScale로 키움)
		_TweenLogic:PlayTween(0.3, self.InkSplatMaxScale, 0.12, EaseType.QuadEaseOut, function(scale)
			if isvalid(icon) then icon.Entity.UITransformComponent.Scale = Vector3(scale, scale, 1) end
		end)

		-- 잠깐 붙어있다가 알파를 서서히 빼며 사라짐 (요청에 따라 페이드 시간을 0.8 → InkSplatFadeDuration로 단축)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self) then return end
			_TweenLogic:PlayTween(1.0, 0.0, self.InkSplatFadeDuration, EaseType.QuadEaseIn, function(alpha)
				if isvalid(icon) then icon.Color = Color(1, 1, 1, alpha) end
			end)
			_TimerService:SetTimerOnce(function()
				if isvalid(icon) then icon.Entity:SetEnable(false) end
				self._inkSplatActive = false
			end, self.InkSplatFadeDuration)
		end, 0.5)
	end

	-- 몬스터 처치 시 MonsterAI가 호출
	@ExecSpace("ServerOnly")
	method void OnMonsterKilled()
		if self.GameOver then return end

		self:AddGold(self:GetGoldPerKill())
		self.Exp = self.Exp + self:GetExpPerKill()
		log("Kill! EXP:" .. self.Exp .. "/" .. self.ExpNeeded .. " Gold:" .. self.Gold)

		if self.Exp >= self.ExpNeeded then
			self:LevelUp()
		else
			self:NotifyExpChanged(self.Exp, self.ExpNeeded, self.Level, false)
		end
	end

	-- 웨이브10 리본돼지 보스가 죽을 때 MonsterAI가 호출 — 맵4 이상 이동 잠금 해제
	@ExecSpace("ServerOnly")
	method void OnBossDefeated()
		if self.BossDefeated then return end
		self.BossDefeated = true
		_MapMoveUI:NotifyBossDefeated(true)
		_MonsterSpawner:ClearCurrentBoss()
		-- 보스 킬 한 번으로 반드시 웨이브를 넘겨야 한다 — 안 그러면 보스를 수십 번 반복해서 잡아야
		-- 웨이브가 넘어가고, 그동안 맵을 옮겨 다니면 "분명히 잡았는데 다른 맵에서 또 나온다"처럼 보인다.
		-- 예전엔 이 시점 Exp와 무관하게 그냥 LevelUp()을 강제 호출했는데, LevelUp()의 뺄셈은 "Exp가 이미
		-- ExpNeeded 이상일 때만 호출된다"는 일반 처치 경로만 가정하고 있어서, Exp가 얼마 안 쌓인 채로
		-- (예: 20%) 강제 호출되면 경험치 바가 갑자기 훅 줄어드는(0%로 리셋되는) 것처럼 보이는 문제가 있었다.
		-- 지금은 그냥 현재 필요경험치만큼을 그대로 더해서(기존에 쌓아둔 Exp는 보존한 채) 문턱을 확실히
		-- 넘기고, 그 뒤로는 일반 레벨업과 동일한 연출(0%부터 다시 차오름)로 자연스럽게 이어지게 한다.
		-- 보스 처치 보상(ExpPerKill/GoldPerKill)도 여기서 함께 지급한다 — 예전엔 MonsterAI.Die()가
		-- OnMonsterKilled()와 OnBossDefeated()를 둘 다 호출해서, 이미 차오르던 경험치 바 트윈을
		-- OnBossDefeated의 강제 0% 리셋이 거의 같은 프레임에 덮어써 "차오르다가 갑자기 줄어드는"
		-- 연출로 보이는 버그가 있었다. 지금은 Die()가 보스일 때 OnMonsterKilled()를 호출하지 않고
		-- OnBossDefeated() 한 번만 처치 보상까지 전부 처리한다.
		self:AddGold(self:GetGoldPerKill())
		self.Exp = self.Exp + self:GetExpPerKill() + self.ExpNeeded
		self:LevelUp()
		log("GameManager: Boss defeated, map4+ unlocked")
	end

	-- 몬스터 처치 시 실제로 지급할 골드 (기본값 그대로) — 유물 골드 보너스는 킬마다 곱하지 않는다.
	-- GoldPerKill이 작아서(기본 5) 킬마다 곱하면 math.floor에 보너스가 통째로 묻혀 버렸다.
	-- 대신 TriggerGameOver()에서 이번 런에 모은 골드 총액에 한 번에 곱해서 지급한다.
	@ExecSpace("ServerOnly")
	method integer GetGoldPerKill()
		return self.GoldPerKill
	end

	-- 몬스터 처치 시 실제로 지급할 경험치 — 유물 레벨업 보너스(레벨 합계 1당 +1%)를 반영한다
	@ExecSpace("ServerOnly")
	method number GetExpPerKill()
		local bonusPercent = _RelicInventory:GetExpBonusPercent()
		return self.ExpPerKill * (1 + bonusPercent / 100)
	end

	-- 웨이브별 몬스터 공격력 반환 (Wave 10 보스, 11부터는 9번째 값 기준으로 계속 성장 — 무한 웨이브)
	@ExecSpace("ServerOnly")
	method integer GetWaveAttack(integer wave)
		-- 달팽이→파란달팽이→스포아→빨간달팽이→슬라임→돼지→주니어부기→스텀프→옥토퍼스→리본돼지(보스)
		-- Card1 쿨타임 0.8s 기준 1회 공격당 대미지 (플레이어 HP=100)
		local attacks = {3, 5, 8, 11, 14, 17, 20, 23, 27, 35}
		if wave <= 10 then return attacks[wave] end
		return math.floor(attacks[9] + 4 * (wave - 9))
	end

	-- 웨이브별 몬스터 체력 반환 (Card1 데미지=100 기준 설계, Wave 10 보스, 11부터는 9번째 값 기준으로 계속 성장)
	@ExecSpace("ServerOnly")
	method integer GetWaveHp(integer wave)
		-- Wave 4(520)부터 도달 시작, Wave 10 보스는 접근 속도가 느려 15초 교전 창 확보
		local hps = {60, 80, 100, 150, 230, 340, 500, 720, 1000, 1800}
		if wave <= 10 then return hps[wave] end
		-- 기존 테이블의 평균 성장률(약 ×1.4)로 계속 확장 — 웨이브10 보스 수치(1800)에서 바로 이어받지 않고
		-- 9번째(1000) 기준으로 이어가야 11부터의 "일반 몬스터"가 보스급 체력으로 갑자기 뛰지 않는다
		return math.floor(hps[9] * (1.4 ^ (wave - 9)))
	end

	-- 웨이브별 몬스터 접근 속도 반환 (Wave 10 보스만 느리게 접근, 11부터는 평시 속도로 복귀)
	@ExecSpace("ServerOnly")
	method number GetWaveApproachSpeed(integer wave)
		-- Wave 10 보스: (1.5-0.3)/0.08 = 15초 교전 창 → 카드 풀업그레이드 시 도달 전 처치 가능
		if wave == 10 then return 0.08 end
		return 0.3
	end

	-- 웨이브별 몬스터 hit1 애니메이션 RUID
	@ExecSpace("ServerOnly")
	method string GetWaveHitRUID(integer wave)
		local ruids = {
			"a3feafdb656943baa3f8897a7042b21f",  -- Wave  1: 달팽이
			"938c814d2142406c8a6480ee2b025ac3",  -- Wave  2: 파란 달팽이
			"1f539560199e40bb8bb2dbfe3a26cb89",  -- Wave  3: 스포아
			"a9c736c7e74544c18740d6eb36b2f103",  -- Wave  4: 빨간 달팽이
			"61c27025a8f14c478f30ede1b49758bc",  -- Wave  5: 슬라임
			"60e42a918a0342478903cc71adba1dc5",  -- Wave  6: 돼지
			"2358e38b0c9b4d9da987387deba59de0",  -- Wave  7: 주니어 부기
