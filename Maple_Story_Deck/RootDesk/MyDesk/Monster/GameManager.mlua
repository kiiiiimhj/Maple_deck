	-- 맵4~6 전용 몬스터 풀 die1 1회 재생 시간 (프레임 수 × ~100ms + 여유, 기존 웨이브 테이블과 동일한 공식)
	@ExecSpace("ServerOnly")
	method number GetZoneDieDuration(integer idx)
		local durations = {
			0.95,  -- 1: 음흉한 여우      9프레임
			1.05,  -- 2: 이상한 돼지     10프레임
