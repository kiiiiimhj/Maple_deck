			"4f8eab1a9fbf4a35b28f986c4fa12f48",  -- Wave  4: 빨간 달팽이
			"dc932872543f4a02bf41e977ab79e5ad",  -- Wave  5: 슬라임
			"8baad61512be4b33b2a0879fec7a266e",  -- Wave  6: 돼지
			"84a2e710c5ea4cb1843b52ad777a2074",  -- Wave  7: 주니어 부기
			"d5de0c972d044d3cad5d0ecb7d8c96e7",  -- Wave  8: 스텀프
			"3e5f23a5c00541c698fe3836b1ea244d",  -- Wave  9: 옥토퍼스
			"efd4d44e0da7496bac4c350def33a108",  -- Wave 10: 리본 돼지 (보스)
