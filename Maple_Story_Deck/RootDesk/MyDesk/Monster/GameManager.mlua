	-- 맵4~6 몬스터 풀 종 개수 (MonsterAI가 무작위 인덱스를 뽑을 때 사용)
	@ExecSpace("ServerOnly")
	method integer GetZoneMonsterCount()
		return 4
	end

	-- 맵7~9 전용 몬스터 풀 (맵마다 별도 구성) — 7:고스텀프/엑스텀프, 8:와일드보어/아이언호그, 9:히죽대는 고스텀프/아이언보어/파이어보어,
	-- 11(맵6 우측 분기, 해변 존):로랑/엄티/클랑, 12:날치 슬라임/보라조개 슬라임/불가사리 문어 슬라임,
	-- 13(개미굴 입구):뿔버섯/좀비버섯, 14:이블아이/커즈아이, 15:커즈아이/박쥐(비행형)/이블아이,
	-- 16(그림자 존):내면의 그림자(비행형)/그림자 보어, 17:그림자 스텀프/그림자 엑스텀프. 18은 몬스터 없음
	-- (MonsterSpawner.IsNoMonsterZone에서 스폰 자체를 건너뛰므로 여기 값은 안 쓰인다).
	@ExecSpace("ServerOnly")
	method integer GetMapMonsterCount(integer mapIndex)
		if mapIndex == 7 then return 2
		elseif mapIndex == 8 then return 2
		elseif mapIndex == 9 then return 3
		elseif mapIndex == 11 then return 3
		elseif mapIndex == 12 then return 3
		elseif mapIndex == 13 then return 2
		elseif mapIndex == 14 then return 2
		elseif mapIndex == 15 then return 3
		elseif mapIndex == 16 then return 2
		elseif mapIndex == 17 then return 2
		end
		return 1
	end

	@ExecSpace("ServerOnly")
	method string GetMapStandRUID(integer mapIndex, integer idx)
		local pools = {
			[7] = {"52fc9a75b6174bfa96af66c49dbb3369", "9d4f9e8f572548f692438ffa817eb52d"},
