@Logic
script LevelRewardUI extends Logic

	-- 계정 레벨업 보상 팝업(ui/LevelRewardGroup.ui) 컨트롤러 + 로비 인벤토리 프로필(별+아이디) 바인딩.
	-- 상태(레벨/받은 칸 수)는 전부 PlayerLevelLogic / LevelRewardLogic이 서버에서 들고 있고 여기는 보여주기만 한다.
	--   · 20칸이 가로 한 줄(Panel/Viewport/Strip/Card1~20) — 다음에 받을 칸이 가운데 크게, 좌우 2칸씩 작고 어둡게
	--     (유저 지정 2026-09-16: "좌우로 최대 2개씩"). 에피소드 생존 보상과 같은 캐러셀이다.
	--   · 받으면 체크 도장 → 줄이 왼쪽으로 밀리며 다음 칸이 오른쪽에서 가운데로 올라온다
	--   · 배너 문구는 레퍼런스의 "보상을 획득했습니다!" 자리에 "레벨 N 보상"이 들어간다(유저 지정)
	--   · 팝업 진입점은 로비 인벤토리 아바타 아래 프로필(별 레벨 뱃지 + 아이디)을 누르는 것
	--     — EquipmentGroup의 NameBackground에 ButtonComponent를 달아 여기서 잡는다

	-- UI 바인딩 (UIBuilder가 UUID를 넣는다)
	property Entity popupGroup = "fbf46eeb-5f6a-4df4-8c03-929bf858cf59"
	property ButtonComponent btnClose = "8da61e2c-f3d2-46c0-9857-3476498431e6"
	property ButtonComponent btnClaim = "8d071f58-1606-4e26-8999-8212784de66e"
	property TextGUIRendererComponent claimText = "8d071f58-1606-4e26-8999-8212784de66e"
	property TextGUIRendererComponent subTitle = "ce0fe6bf-3667-4105-9efa-e43aa68ff080"
	property Entity strip = "0dec58fd-dd45-43ba-9086-3954f19d9b96"
	-- 팝업 안에서 위로 떠오르며 사라지는 안내 문구(받기 버튼 위)
	property TextGUIRendererComponent failToast = "ed974700-c6cf-4836-ba35-9d3127daa9af"
	-- 로비 인벤토리 프로필(EquipmentGroup) — 별 뱃지 안 레벨 숫자 / 아이디 / 클릭 버튼
	property ButtonComponent profileButton = "a5bd2179-28ec-440b-b991-1c9dc6202fc2"
	property TextComponent levelText = "0b5c65a1-551b-477e-ab15-81bc345cb9f2"
	property TextComponent nameText = "ed5449d5-76a2-4bca-8b62-f84eced6e0d4"

	-- 캐러셀 값
	property integer TotalSlots = 20
	property integer VisibleSide = 2
	property number CardSpacing = 152
	property number CardScale = 1.05
	property number SideCardScale = 0.72
	property number SideCardShade = 0.6
	property number SlideDelay = 0.4
	property number SlideDuration = 0.4
	property number IconSize = 76
	property number IconOffsetY = 14
	property number CheckY = 8
	property number CheckStartScale = 1.9
	property number CheckStartOffsetY = 48
	property number CheckDropDuration = 0.3
	property number PulseAmplitude = 0.04
	property number PulseSpeed = 5.0
	property number ClaimPendingTimeout = 2.0
	-- 안내 문구 연출 값(시작 Y / 떠오르는 높이 / 지속시간)
	-- 배너("레벨 N 보상")와 카드 줄 사이 빈 띠에서 시작해 살짝 떠오른다.
	-- 카드는 y -78~-218, 배너 아래끝은 -22라 -62에서 시작해 28만큼만 올려야 둘 다 안 건드린다
	property number FailToastBaseY = -62
	property number FailToastRiseY = 28
	property number FailToastDuration = 2.0
	property integer _failToastToken = 0

	-- 내부 상태
	property boolean _isOpen = false
	property boolean _animating = false
	property boolean _claimPending = false
	-- 수령 번호표 — 타임아웃 타이머가 "자기 수령분"만 되돌리게 하는 용도(연속 수령 시 섞임 방지)
	property integer _claimSeq = 0
	-- 보상 비행(RewardFlyUI): 받는 순간 배지 숫자를 보류해두고, 팝업을 닫을 때 받은 칸들이 한꺼번에 날아간다
	property string _holdKind = ""
	property integer _holdAmount = 0
	property table _pendingFly = {}
	property Vector2 _pendingFlySrc = Vector2(0, 0)
	property boolean _hasFlySrc = false
	property integer _animatingIndex = 0
	property number _focus = 1
	property integer _pulseTimerId = 0
	property number _pulseTime = 0
	property any _closeHandler = nil
	property any _claimHandler = nil
	property any _profileHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		if not isvalid(self.popupGroup) then return end
		self.popupGroup.Enable = false
		self._closeHandler = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, self.OnCloseClicked)
		self._claimHandler = self.btnClaim.Entity:ConnectEvent(ButtonClickEvent, self.OnClaimClicked)
		if isvalid(self.profileButton) then
			self._profileHandler = self.profileButton.Entity:ConnectEvent(ButtonClickEvent, self.OnProfileClicked)
		end
		self:RefreshProfile()
		self:RefreshAll()
		log("LevelRewardUI started")
	end

	@ExecSpace("ClientOnly")
	method Entity GetCard(integer index)
		-- Strip 아래 Card{n} 엔티티
		if not isvalid(self.strip) then return nil end
		return self.strip:GetChildByName("Card" .. tostring(index))
	end

	@ExecSpace("ClientOnly")
	method integer GetTargetFocus()
		-- 가운데에 올 칸 = 다음에 받을 칸(다 받았으면 마지막 칸)
		local f = _LevelRewardLogic:GetClaimedCount() + 1
		if f > self.TotalSlots then f = self.TotalSlots end
		return f
	end

	-- ── 로비 인벤토리 프로필(별 + 아이디) ────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void RefreshProfile()
		-- 별 뱃지 안 숫자를 계정 레벨로, 이름표를 실제 유저 닉네임으로 맞춘다.
		-- UIEquippedGearPanel도 OnBeginPlay에 닉네임을 넣지만, 그 시점엔 LocalPlayer가 아직
		-- 준비되지 않아 하드코딩 문구가 그대로 남는 경우가 있어 여기서 한 번 더 덮어쓴다.
		if isvalid(self.levelText) then
			self.levelText.Text = tostring(_PlayerLevelLogic:GetLevel())
		end
		if isvalid(self.nameText) then
			local localPlayer = _UserService.LocalPlayer
			if localPlayer ~= nil and localPlayer.PlayerComponent ~= nil then
				local nick = localPlayer.PlayerComponent.Nickname
				if nick ~= nil and nick ~= "" then self.nameText.Text = nick end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnLevelSynced()
		-- PlayerLevelLogic의 @Sync가 도착할 때마다 — 별 뱃지 숫자와 팝업 상태를 같이 갱신
		self:RefreshProfile()
		self:RefreshAll()
	end

	@ExecSpace("ClientOnly")
	method void OnProfileClicked()
		self:Open()
	end

	@ExecSpace("ClientOnly")
	method void ShowFailToast(string message)
		-- 받기가 막힌 이유를 팝업 안에서 알려준다 — 위로 떠오르며 서서히 사라짐.
		-- ⚠ 전역 _UIToast(ToastGroup, GroupOrder 3)를 쓰면 이 팝업(GroupOrder 22)의 전체화면 딤
		-- 뒤에 깔려서 안 보인다(유저 리포트 2026-09-16 "토스트가 없다"). 그래서 팝업 자체에 넣었다.
		if not isvalid(self.failToast) then return end
		self._failToastToken = self._failToastToken + 1
		local token = self._failToastToken
		local entity = self.failToast.Entity
		local tr = entity.UITransformComponent
		self.failToast.Text = message
		tr.anchoredPosition = Vector2(0, self.FailToastBaseY)
		self.failToast.FontColor = Color(1, 0.85, 0.85, 1)
		entity.Enable = true
		_TweenLogic:PlayTween(0.0, 1.0, self.FailToastDuration, EaseType.QuadEaseOut, function(t)
			-- 연달아 뜨면 마지막 것만 살린다(이전 트위너 콜백은 조용히 무시)
			if self._failToastToken ~= token then return end
			if not isvalid(self.failToast) then return end
			tr.anchoredPosition = Vector2(0, self.FailToastBaseY + self.FailToastRiseY * t)
			local a = 1.0
			if t > 0.55 then a = (1.0 - t) / 0.45 end
			if a < 0 then a = 0 end
			self.failToast.FontColor = Color(1, 0.85, 0.85, a)
			if t >= 1.0 then entity.Enable = false end
		end)
	end

	-- ── 팝업 열기/닫기 ───────────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void Open()
		self._animating = false
		self._animatingIndex = 0
		self:RefreshAll()
		self.popupGroup.Enable = true
		self._isOpen = true
		self:StartPulse()
		log("LevelRewardUI: opened (level=" .. _PlayerLevelLogic:GetLevel() .. " claimed=" .. _LevelRewardLogic:GetClaimedCount() .. " canClaim=" .. tostring(_LevelRewardLogic:CanClaimNext()) .. ")")
	end

	@ExecSpace("ClientOnly")
	method void Close()
		self:FlyPendingRewards()
		self.popupGroup.Enable = false
		self._isOpen = false
		self:StopPulse()
	end

	@ExecSpace("ClientOnly")
	method void OnCloseClicked()
		self:Close()
	end

	-- ── 그리기 ───────────────────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void RefreshAll()
		-- 20칸 + 배너 문구 + 받기 버튼을 현재 동기화된 상태로 다시 그린다(수령 연출 중인 칸/슬라이드는 건드리지 않는다)
		if not isvalid(self.strip) then return end
		local claimed = _LevelRewardLogic:GetClaimedCount()
		for i = 1, self.TotalSlots do
			if i ~= self._animatingIndex then
				self:ApplyCardState(i, i <= claimed)
			end
		end
		if not self._animating then
			self._focus = self:GetTargetFocus()
			self:LayoutStrip()
		end
		self:RefreshClaimButton()
		self:RefreshSubTitle()
	end

	@ExecSpace("ClientOnly")
	method void ApplyIconLayout(Entity icon)
		-- 모든 보상 아이콘을 칸 중앙(수량 텍스트 위)에 같은 크기로 놓는다.
		-- ⚠ 에피소드 보상에서 골드/다이아에 쓰던 pivot 보정값(-46,-53 / -57,-64)을 그대로 가져왔더니
		-- 아이콘이 칸 왼쪽아래로 삐져나왔다(유저 리포트 2026-09-16). 그 값은 에피소드 카드 크기
		-- (150x200 + IconScale 1.17)에 맞춰 튜닝된 거라 이 카드(140x140)엔 안 맞는다.
		-- 보정 없이 중앙에 두면 보정 안 하던 무기/방어구 아이콘처럼 제자리에 온다.
		-- ⚠ 이 메서드가 .ui의 Icon 좌표를 런타임에 매번 덮어쓴다 — 하이어라키에서 위치를 고쳐도
		-- 안 먹히니, 아이콘 위치는 여기(IconSize / IconOffsetY)에서 조절할 것.
		local tr = icon.UITransformComponent
		tr.anchoredPosition = Vector2(0, self.IconOffsetY)
		tr.RectSize = Vector2(self.IconSize, self.IconSize)
	end

	@ExecSpace("ClientOnly")
	method void ApplyCardState(integer index, boolean claimed)
		-- 한 칸의 아이콘/수량/체크 도장을 상태에 맞게
		local card = self:GetCard(index)
		if not isvalid(card) then return end
		local icon = card:GetChildByName("Icon")
		local amountText = card:GetChildByName("AmountText")
		local check = card:GetChildByName("Check")
		if isvalid(icon) then
			icon.SpriteGUIRendererComponent.ImageRUID = DataRef(_LevelRewardLogic:GetRewardIconRUID(index))
			self:ApplyIconLayout(icon)
			icon.Enable = not claimed
		end
		if isvalid(amountText) then
			if claimed then
				amountText.TextGUIRendererComponent.Text = "완료"
			else
				amountText.TextGUIRendererComponent.Text = _LevelRewardLogic:GetRewardAmountText(index)
			end
		end
		if isvalid(check) then
			check.Enable = claimed
			check.UITransformComponent.Scale = Vector3(1, 1, 1)
			check.UITransformComponent.anchoredPosition = Vector2(0, self.CheckY)
			check.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
		end
	end

	@ExecSpace("ClientOnly")
	method void LayoutStrip()
		-- _focus(실수 — 슬라이드 중엔 사이값) 칸이 가운데 오게 줄을 밀고, 가운데서 멀수록 작고 어둡게.
		-- 에피소드 보상은 좌우 1칸이라 거리를 1에서 잘랐지만, 여기는 유저 지정대로 좌우 2칸(VisibleSide)이다
		if not isvalid(self.strip) then return end
		self.strip.UITransformComponent.anchoredPosition = Vector2(-(self._focus - 1) * self.CardSpacing, 0)
		local pulseTarget = 0
		if not self._animating and _LevelRewardLogic:CanClaimNext() then pulseTarget = self:GetTargetFocus() end
		for i = 1, self.TotalSlots do
			local card = self:GetCard(i)
			if isvalid(card) then
				local d = math.abs(i - self._focus)
				if d > self.VisibleSide then d = self.VisibleSide end
				local ratio = d / self.VisibleSide
				local s = self.CardScale * (1.0 - (1.0 - self.SideCardScale) * ratio)
				if i == pulseTarget then
					s = s * (1.0 + self.PulseAmplitude * math.sin(self._pulseTime * self.PulseSpeed))
				end
				card.UITransformComponent.Scale = Vector3(s, s, 1)
				local shade = 1.0 - (1.0 - self.SideCardShade) * ratio
				card.SpriteGUIRendererComponent.Color = Color(shade, shade, shade, 1)
				local icon = card:GetChildByName("Icon")
				if isvalid(icon) then icon.SpriteGUIRendererComponent.Color = Color(shade, shade, shade, 1) end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshSubTitle()
		-- 배너 문구 — 가운데 칸 기준 "레벨 N 보상"
		if not isvalid(self.subTitle) then return end
		local logic = _LevelRewardLogic
		if logic:IsAllDone() then
			self.subTitle.Text = "모든 보상을 받았어요!"
			return
		end
		self.subTitle.Text = logic:GetSlotLabel(self:GetTargetFocus())
	end

	@ExecSpace("ClientOnly")
	method void RefreshClaimButton()
		-- 받을 수 있으면 밝게, 아니면 어둡게(에피소드 보상과 동일)
		if not isvalid(self.btnClaim) then return end
		local sprite = self.btnClaim.Entity.SpriteGUIRendererComponent
		local logic = _LevelRewardLogic
		if logic:IsAllDone() then
			self.claimText.Text = "모두 받음"
			sprite.Color = Color(0.6, 0.6, 0.6, 1)
			return
		end
		self.claimText.Text = "받기"
		if logic:CanClaimNext() then
			sprite.Color = Color(1, 1, 1, 1)
		else
			sprite.Color = Color(0.6, 0.6, 0.6, 1)
		end
	end

	-- ── 수령 ─────────────────────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void OnClaimClicked()
		if self._animating or self._claimPending then return end
		local logic = _LevelRewardLogic
		if logic:IsAllDone() then return end
		local next = logic:GetClaimedCount() + 1
		if not logic:CanClaimNext() then
			self:ShowFailToast("레벨 " .. logic:GetSlotLevel(next) .. "이 되면 받을 수 있어요")
			return
		end
		-- 서버 지급 Multicast가 배지 숫자를 바로 올리기 전에 보류 — 팝업을 닫고 아이콘이 도착할 때 오른다
		self._holdKind = logic:GetRewardKind(next)
		self._holdAmount = logic:GetRewardAmount(next)
		if self._holdKind == "gold" or self._holdKind == "diamond" then
			_RewardFlyUI:Hold(self._holdKind, self._holdAmount)
		end
		-- 서버가 거절하면(레벨 미달/인벤 가득) OnClaimed가 안 오므로 잠깐 뒤 연타 잠금과 숫자 보류를 푼다.
		-- ⚠ 콜백 안에서 self._holdKind/_holdAmount를 읽으면 안 된다 — 연속 수령하면 그 사이에 다음 칸
		-- 값으로 덮여 있어서 방금 받은 보상의 보류를 잘못 풀어버린다(숫자가 연출보다 먼저 올라감).
		-- 자기 수령분을 클로저로 잡아두고, 번호표가 바뀌었으면(=그 뒤 수령이 진행됨) 아무것도 안 한다
		self._claimPending = true
		self._claimSeq = self._claimSeq + 1
		local seq = self._claimSeq
		local pendingKind = self._holdKind
		local pendingAmount = self._holdAmount
		_TimerService:SetTimerOnce(function()
			if self._claimSeq ~= seq then return end
			if not self._claimPending then return end
			self._claimPending = false
			if pendingKind == "gold" or pendingKind == "diamond" then
				_RewardFlyUI:Release(pendingKind, pendingAmount)
			end
			self._holdKind = ""
			self._holdAmount = 0
		end, self.ClaimPendingTimeout)
		logic:RequestClaim()
	end

	@ExecSpace("ClientOnly")
	method void ReleaseHold()
		-- 보류해둔 배지 숫자를 되돌린다(수령 실패). 번호표를 올려 이 수령의 타임아웃 타이머를 무효화한다
		self._claimPending = false
		self._claimSeq = self._claimSeq + 1
		if self._holdKind == "gold" or self._holdKind == "diamond" then
			_RewardFlyUI:Release(self._holdKind, self._holdAmount)
		end
		self._holdKind = ""
		self._holdAmount = 0
	end

	@ExecSpace("Client")
	method void OnClaimFailed(string reason, string tabName)
		-- 서버가 지급을 거절 — 지금은 장비 칸이 가득 찬 경우뿐이다.
		-- tabName은 어느 탭이 찼는지("무기"/"방어구") — 유저가 뭘 비워야 하는지 바로 알 수 있게 넘겨받는다
		self:ReleaseHold()
		if reason == "inventoryFull" then
			self:ShowFailToast(tabName .. " 칸이 가득 찼어요! 정리한 뒤 다시 받아주세요")
		end
		self:RefreshAll()
		log("LevelRewardUI: claim failed (" .. reason .. ")")
	end

	@ExecSpace("Client")
	method void OnClaimed(integer index)
		-- LevelRewardLogic.RequestClaim이 지급을 끝낸 뒤 호출 — 체크 도장 → 다음 칸으로 슬라이드.
		-- 번호표를 올려서 이 수령의 타임아웃 타이머가 뒤늦게 보류를 풀어버리지 않게 한다
		self._claimPending = false
		self._claimSeq = self._claimSeq + 1
		self._holdKind = ""
		self._holdAmount = 0
		if self._isOpen then
			table.insert(self._pendingFly, index)
			self:PlayClaimAnimation(index)
			-- 방금 받은 칸을 가운데로 맞춘(LayoutStrip) 이 순간의 자리를 비행 출발점으로 잡아둔다.
			-- 닫을 때 다시 구하면 다음 칸이 오른쪽에서 미끄러져 오는 중이라 오른쪽에서 날아가 버린다
			local card = self:GetCard(index)
			if isvalid(card) and not self._hasFlySrc then
				self._pendingFlySrc = _RewardFlyUI:GetLayerPosOf(card, 0, 0)
				self._hasFlySrc = true
			end
		else
			-- 받자마자 팝업을 닫아버린 경우 — 프로필 자리에서 바로 날린다
			self:FlyReward(index, _RewardFlyUI:GetLayerPosOf(self.profileButton.Entity, 0, 0), 0)
		end
	end

	@ExecSpace("ClientOnly")
	method void FlyReward(integer index, Vector2 fromPos, number delay)
		-- 보상 아이콘 비행. 장비는 kind "gear"로 넘겨야 로비 장비 버튼으로 날아간다(RewardFlyUI.GetTargetEntity)
		local logic = _LevelRewardLogic
		local kind = logic:GetRewardKind(index)
		if logic:IsGearSlot(index) then kind = "gear" end
		_RewardFlyUI:Fly(kind, logic:GetRewardAmount(index), logic:GetRewardIconRUID(index), fromPos, delay)
	end

	@ExecSpace("ClientOnly")
	method void FlyPendingRewards()
		-- 팝업을 닫는 순간(끄기 직전 가운데 카드 자리에서) 이번에 받은 칸들을 날린다.
		-- ⚠ 같은 종류는 합쳐서 한 번만 날린다(유저 지정 2026-09-16). 칸마다 따로 날리면 통화 1건당
		-- 아이콘을 8개씩 쓰는데, 연속 수령 후 닫으면 아이콘 풀(RewardFlyUI.PoolSize=24)이 바닥나고
		-- 그때 남은 몫은 연출 없이 즉시 반영돼 숫자가 먼저 튀어오른다. 어차피 같은 보상이라 합쳐도 똑같다
		if #self._pendingFly == 0 then return end
		local src = Vector2(0, 0)
		if self._hasFlySrc then
			src = self._pendingFlySrc
		else
			local card = self:GetCard(self:GetTargetFocus())
			if isvalid(card) then src = _RewardFlyUI:GetLayerPosOf(card, 0, 0) end
		end
		local logic = _LevelRewardLogic
		local order = {}
		local sums = {}
		local ruids = {}
		for _, index in ipairs(self._pendingFly) do
			local kind = logic:GetRewardKind(index)
			if logic:IsGearSlot(index) then kind = "gear" end
			if sums[kind] == nil then
				sums[kind] = 0
				ruids[kind] = logic:GetRewardIconRUID(index)
				table.insert(order, kind)
			end
			sums[kind] = sums[kind] + logic:GetRewardAmount(index)
		end
		local delay = 0
		for _, kind in ipairs(order) do
			_RewardFlyUI:Fly(kind, sums[kind], ruids[kind], src, delay)
			delay = delay + 0.3
		end
		self._pendingFly = {}
		self._hasFlySrc = false
	end

	@ExecSpace("ClientOnly")
	method void PlayClaimAnimation(integer index)
		-- 체크 도장이 위에서 크게 떨어지며 찍힌 뒤 다음 칸으로 슬라이드(에피소드/출석 보상과 동일한 연출)
		local card = self:GetCard(index)
		if not isvalid(card) then return end
		local icon = card:GetChildByName("Icon")
		local amountText = card:GetChildByName("AmountText")
		local check = card:GetChildByName("Check")
		if not isvalid(check) then return end
		self._animating = true
		self._animatingIndex = index
		self._focus = index
		self:LayoutStrip()
		if isvalid(icon) then icon.Enable = false end
		if isvalid(amountText) then amountText.TextGUIRendererComponent.Text = "완료" end
		self:RefreshClaimButton()

		local tr = check.UITransformComponent
		local sprite = check.SpriteGUIRendererComponent
		tr.Scale = Vector3(self.CheckStartScale, self.CheckStartScale, 1)
		tr.anchoredPosition = Vector2(0, self.CheckY + self.CheckStartOffsetY)
		sprite.Color = Color(1, 1, 1, 0)
		check.Enable = true
		_TweenLogic:PlayTween(0.0, 1.0, self.CheckDropDuration, EaseType.QuadEaseIn, function(t)
			if not isvalid(check) then return end
			local s = self.CheckStartScale + (1.0 - self.CheckStartScale) * t
			tr.Scale = Vector3(s, s, 1)
			tr.anchoredPosition = Vector2(0, self.CheckY + self.CheckStartOffsetY * (1.0 - t))
			local a = t * 1.6
			if a > 1 then a = 1 end
			sprite.Color = Color(1, 1, 1, a)
		end)
		_TimerService:SetTimerOnce(function()
			self._animatingIndex = 0
			self:SlideTo(index + 1)
		end, self.CheckDropDuration + self.SlideDelay)
		log("LevelRewardUI: claim animation slot " .. index)
	end

	@ExecSpace("ClientOnly")
	method void SlideTo(integer target)
		-- 다음 칸이 오른쪽에서 가운데로 — 마지막 칸을 받았으면 제자리
		if target > self.TotalSlots then
			self._animating = false
			self:RefreshAll()
			return
		end
		local from = self._focus
		_TweenLogic:PlayTween(0.0, 1.0, self.SlideDuration, EaseType.QuadEaseInOut, function(t)
			self._focus = from + (target - from) * t
			self:LayoutStrip()
			self:RefreshSubTitle()
			if t >= 1.0 then
				self._animating = false
				self:RefreshAll()
			end
		end)
	end

	@ExecSpace("ClientOnly")
	method void StartPulse()
		-- 받을 수 있는 가운데 칸을 살짝 두근거리게 한다
		self:StopPulse()
		self._pulseTime = 0
		self._pulseTimerId = _TimerService:SetTimerRepeat(function()
			self._pulseTime = self._pulseTime + 1 / 30
			if not self._animating then self:LayoutStrip() end
		end, 1 / 30)
	end

	@ExecSpace("ClientOnly")
	method void StopPulse()
		if self._pulseTimerId ~= 0 then
			_TimerService:ClearTimer(self._pulseTimerId)
			self._pulseTimerId = 0
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		self:StopPulse()
		if self._closeHandler then self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self._closeHandler) end
		if self._claimHandler then self.btnClaim.Entity:DisconnectEvent(ButtonClickEvent, self._claimHandler) end
		if self._profileHandler then self.profileButton.Entity:DisconnectEvent(ButtonClickEvent, self._profileHandler) end
	end

end
