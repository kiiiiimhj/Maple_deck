@Logic
script PlayerLevelLogic extends Logic

	-- 플레이어(계정) 레벨 — 런 안에서만 쓰는 GameManager.Level(카드 선택용)과는 완전히 별개다.
	-- 한 번 오르면 내려가지 않고 다시하기/판 종료와 무관하게 영구 보존된다.
	--   · 경험치는 몬스터 처치(GameManager.OnMonsterKilled / OnBossDefeated)와 방치 보상
	--     (IdleRewardLogic.GrantExp) 두 곳에서만 들어온다.
	--   · 킬당 경험치는 방치 보상 비율(ExpPerHour 600 : GoldPerHour 100 = 6배)을 킬당 골드(1)에
	--     그대로 곱한 값 — 그래서 "방치 24시간 = 한두 판"이라는 이미 확정된 골드 밸런스가 경험치에도
	--     똑같이 걸린다. 에피소드 배율도 골드 확률표(에피2 평균 1.3 / 에피3 평균 1.7)를 따라간다.
	--     EP1 6 / EP2 8 / EP3 10, 엘리트 ×5, 보스 ×20 (골드 배율과 동일).
	--   · ⚠ GameManager.GetExpPerKill의 "2분 이후 절반"은 여기 적용하지 않는다 — 그건 스폰 2배와
	--     짝지은 판 안 페이싱 장치라서, 계정 경험치는 킬당 고정이어야 총 유입량이 킬 수에 정비례한다.
	--   · 레벨 필요 경험치 = ExpPerLevelStep(1500) × 현재 레벨. 만렙 100 누적 7,425,000 —
	--     하루 수입 5만(5판 + 방치 1회, EP1 기준) 기준 약 148일.
	-- 저장: 유저별 UserDataStorage 키 "PlayerLevel" JSON {lv, xp}.
	-- 킬마다 저장하면 DataStorage 과금이 터지므로 dirty 플래그 + 3초 주기 flush(레벨업 순간만 즉시 저장).

	@Sync property integer Level = 1
	@Sync property integer Exp = 0
	@Sync property integer ExpNeeded = 1500
	@Sync property boolean Loaded = false

	property integer MaxLevel = 100
	property integer ExpPerLevelStep = 1500
	-- 에피소드별 킬당 계정 경험치(EP1/EP2/EP3)
	property any EpisodeExpPerKill = { 6, 8, 10 }
	property integer EliteExpMultiplier = 5
	property integer BossExpMultiplier = 20
	property number FlushInterval = 3.0
	property string StorageKey = "PlayerLevel"

	property string _profileCode = ""
	property boolean _dirty = false
	property integer _flushTimerId = 0

	-- ── 공용 계산(서버/클라 공용 — ExecSpace 없음) ──────────────────────────────
	method integer GetExpNeededForLevel(integer level)
		-- 그 레벨에서 다음 레벨로 가는 데 필요한 경험치. 만렙이면 0(더 안 오름)
		if level >= self.MaxLevel then return 0 end
		return self.ExpPerLevelStep * level
	end

	-- ── 접근자(다른 Logic에서 property 직접 읽기 금지 — 이걸로 읽는다) ────────────
	method integer GetLevel()
		-- 현재 계정 레벨
		return self.Level
	end

	method integer GetExp()
		-- 현재 레벨에서 쌓인 경험치
		return self.Exp
	end

	method integer GetExpNeeded()
		-- 다음 레벨까지 필요한 경험치(만렙이면 0)
		return self.ExpNeeded
	end

	method integer GetMaxLevel()
		-- 만렙
		return self.MaxLevel
	end

	method boolean IsMaxLevel()
		-- 만렙 도달 여부
		return self.Level >= self.MaxLevel
	end

	method boolean IsLoaded()
		-- 저장소에서 불러오기가 끝났는지
		return self.Loaded
	end

	method integer GetKillExp(boolean isElite)
		-- 일반/엘리트 몬스터 1마리 처치당 계정 경험치(지금 고른 에피소드 기준)
		local ep = _GameManager:GetSelectedEpisode()
		local base = self.EpisodeExpPerKill[ep]
		if base == nil then base = self.EpisodeExpPerKill[1] end
		if isElite then return base * self.EliteExpMultiplier end
		return base
	end

	method integer GetBossExp()
		-- 보스 1마리 처치당 계정 경험치
		local ep = _GameManager:GetSelectedEpisode()
		local base = self.EpisodeExpPerKill[ep]
		if base == nil then base = self.EpisodeExpPerKill[1] end
		return base * self.BossExpMultiplier
	end

	-- ── 서버: 로드/저장 ──────────────────────────────────────────────────────
	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserEnterEvent(UserEnterEvent event)
		local user = _UserService:GetUserEntityByUserId(event.UserId)
		if user == nil then return end
		self:LoadFor(user)
	end

	@ExecSpace("ServerOnly")
	method void LoadFor(Entity user)
		-- 입장 시 1회만 읽는다. 처음 보는 유저(NotFound)는 Lv1 / 0경험치에서 시작 — 빈 값을 미리 써두지 않는다
		self._profileCode = user.PlayerComponent.ProfileCode
		local ds = _DataStorageService:GetUserDataStorage(self._profileCode)
		local code, raw = ds:GetAndWait(self.StorageKey)
		if code == 0 and raw ~= nil and raw ~= "" then
			local t = _HttpService:JSONDecode(raw)
			if t ~= nil then
				local lv = math.floor(tonumber(t["lv"]) or 1)
				if lv < 1 then lv = 1 end
				if lv > self.MaxLevel then lv = self.MaxLevel end
				self.Level = lv
				self.Exp = math.floor(tonumber(t["xp"]) or 0)
				if self.Exp < 0 then self.Exp = 0 end
			end
		elseif code ~= 0 and code ~= 1000002 then
			log_warning("PlayerLevelLogic: load failed code=" .. tostring(code))
		end
		self.ExpNeeded = self:GetExpNeededForLevel(self.Level)
		if self:IsMaxLevel() then self.Exp = 0 end
		self.Loaded = true

		-- 킬마다 저장하지 않고 이 타이머가 모아서 쓴다(누적 코인 flush와 같은 패턴)
		if self._flushTimerId == 0 then
			self._flushTimerId = _TimerService:SetTimerRepeat(function()
				self:FlushIfDirty()
			end, self.FlushInterval)
		end
		log("PlayerLevelLogic: loaded Lv." .. self.Level .. " exp=" .. self.Exp .. "/" .. self.ExpNeeded)
	end

	@ExecSpace("ServerOnly")
	method void Save()
		-- 실제 쓰기. 레벨이 오른 순간엔 즉시, 그 외엔 FlushIfDirty가 3초마다 모아서 부른다
		if self._profileCode == "" then return end
		self._dirty = false
		local ds = _DataStorageService:GetUserDataStorage(self._profileCode)
		local t = {}
		t["lv"] = self.Level
		t["xp"] = self.Exp
		ds:SetAsync(self.StorageKey, _HttpService:JSONEncode(t), function(code, key)
			if code ~= 0 then log_warning("PlayerLevelLogic: save failed code=" .. tostring(code)) end
		end)
	end

	@ExecSpace("ServerOnly")
	method void FlushIfDirty()
		-- 경험치만 오른 경우(레벨 변화 없음)를 3초마다 한 번씩 모아서 저장
		if not self._dirty then return end
		self:Save()
	end

	-- ── 서버: 경험치 지급 ────────────────────────────────────────────────────
	@ExecSpace("ServerOnly")
	method void AddExp(integer amount)
		-- 계정 경험치 지급 입구 — 몬스터 처치/방치 보상이 전부 여기로 모인다
		if not self.Loaded then return end
		if amount <= 0 then return end
		if self:IsMaxLevel() then return end

		self.Exp = self.Exp + amount
		local gained = 0
		while (not self:IsMaxLevel()) and self.ExpNeeded > 0 and self.Exp >= self.ExpNeeded do
			self.Exp = self.Exp - self.ExpNeeded
			self.Level = self.Level + 1
			self.ExpNeeded = self:GetExpNeededForLevel(self.Level)
			gained = gained + 1
		end
		if self:IsMaxLevel() then
			self.Exp = 0
			self.ExpNeeded = 0
		end

		if gained > 0 then
			self:Save()
			log("PlayerLevelLogic: LEVEL UP +" .. gained .. " -> Lv." .. self.Level .. " exp=" .. self.Exp .. "/" .. self.ExpNeeded)
		else
			self._dirty = true
		end
	end

	@ExecSpace("ServerOnly")
	method void AddKillExp(boolean isElite)
		-- 일반/엘리트 처치 1회 — GameManager.OnMonsterKilled이 부른다
		self:AddExp(self:GetKillExp(isElite))
	end

	@ExecSpace("ServerOnly")
	method void AddBossExp()
		-- 보스 처치 1회 — GameManager.OnBossDefeated가 부른다
		self:AddExp(self:GetBossExp())
	end

	-- 테스트 전용(서버 스크립트에서 직접 호출) — 레벨을 강제로 맞춘다
	@ExecSpace("ServerOnly")
	method void DebugSetLevel(integer level)
		if level < 1 then level = 1 end
		if level > self.MaxLevel then level = self.MaxLevel end
		self.Level = level
		self.Exp = 0
		self.ExpNeeded = self:GetExpNeededForLevel(self.Level)
		self:Save()
		log("PlayerLevelLogic: debug level = " .. self.Level)
	end

	-- ── 클라: 동기화되면 UI 갱신 ──────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		if name == "Level" or name == "Exp" or name == "ExpNeeded" or name == "Loaded" then
			if name == "Level" then log("PlayerLevelLogic: client level synced -> " .. tostring(value)) end
			_LevelRewardUI:OnLevelSynced()
		end
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		if self._flushTimerId ~= 0 then
			_TimerService:ClearTimer(self._flushTimerId)
			self._flushTimerId = 0
		end
		self:FlushIfDirty()
	end

end
