{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .github/hooks/skill-read-guard/skill-read-guard.cjs",
        "timeout": 5
      },
      {
        "command": "node .github/hooks/structured-file-guard/structured-file-guard.cjs",
        "timeout": 5
      },
      {
        "command": "node .github/hooks/structured-file-guard/structured-file-guard.cjs",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "node .github/hooks/mlua-lsp/mlua-diagnose-post-tool-use.cjs",
        "timeout": 120
      },
      {
        "command": "node .github/hooks/skill-log/skill-log.cjs",
        "timeout": 5
      },
      {
        "command": "node .github/hooks/mcp-log/mcp-log.cjs",
        "timeout": 5
      }
    ],
    "sessionStart": [
      {
        "command": "node .github/hooks/mlua-lsp/mlua-session-start.cjs",
        "timeout": 120
      },
      {
        "command": "node .github/hooks/update-check/update-check.cjs",
        "timeout": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "command": "node .github/hooks/core-version-check/core-version-check.cjs",
        "timeout": 5
      },
      {
        "command": "node .github/hooks/skill-router-reminder/skill-router-reminder.cjs",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "node .github/hooks/mlua-lsp/mlua-session-end.cjs",
        "timeout": 20
      }
    ]
  }
}
