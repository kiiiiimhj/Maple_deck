+		colors.SelectedColor = color
+		button.Colors = colors
+		button.Entity.SpriteGUIRendererComponent.Color = color
+	end
+
+	@ExecSpace("ClientOnly")
+	method any GetFilterText(Entity entity)
+		-- 기존 필터는 두 종류의 텍스트 컴포넌트를 섞어서 사용하므로 실제 컴포넌트를 반환한다.
+		local text = entity.TextComponent
+		if text == nil then text = entity.TextGUIRendererComponent end
+		return text
+	end
+
+	@ExecSpace("ClientOnly")
+	method void RefreshFilterSelection()
+		-- 등급/캐릭터/강화 가능 조건의 표시를 같은 선택 상태에서 함께 갱신한다.
+		local grades = {self.btnGradeAll, self.btnGradeNormal, self.btnGradeMagic, self.btnGradeRare}
+		for i, option in ipairs(grades) do self:SetFilterOptionSelected(option, self._gradeFilter == i - 1) end
+		local chars = {self.btnCharAll, self.btnCharArcana, self.btnCharSylph, self.btnCharReion, self.btnCharShade, self.btnCharRin}
+		for i, option in ipairs(chars) do self:SetFilterOptionSelected(option, self._characterFilter == i - 2) end
+		self:SetFilterOptionSelected(self.btnUpgAll, not self._upgradableOnly)
+		self:SetFilterOptionSelected(self.btnUpgOnly, self._upgradableOnly)
+		self:SetFilterMainSelected(self.gradeFilterBtn, self._gradeFilter ~= 0)
+		self:SetFilterMainSelected(self.characterFilterBtn, self._characterFilter ~= -1)
+		self:SetFilterMainSelected(self.upgradeFilterBtn, self._upgradableOnly)
+		local gradeText = _LocalizationService:GetText("UI_TITLEGROUP_019")
+		if self._gradeFilter ~= 0 then gradeText = _LocalizationService:GetText(self:GetFilterText(grades[self._gradeFilter + 1].Entity).Text) .. " ▼" end
+		self:GetFilterText(self.gradeFilterBtn.Entity).Text = gradeText
+		local charText = _LocalizationService:GetText("UI_TITLEGROUP_018")
+		if self._characterFilter ~= -1 then charText = _LocalizationService:GetText(self:GetFilterText(chars[self._characterFilter + 2].Entity).Text) .. " ▼" end
+		self:GetFilterText(self.characterFilterBtn.Entity).Text = charText
+	end
+
 end
