		}
		self._leaves = {}
		if isvalid(self.burst) then
			for i = 0, 23 do
				local leaf = self.burst:GetChildByName("Leaf_" .. tostring(i))
				if isvalid(leaf) then table.insert(self._leaves, leaf) end
			end
		end
		self:Stop()
		log("GameEntryFxUI started (enabled=" .. tostring(self.PresentationEnabled) .. ")")
	end

	@ExecSpace("ClientOnly")
	method boolean Play(integer characterIndex)
		return self:PlayWithCompletion(characterIndex, nil)
	end

	@ExecSpace("ClientOnly")
	method boolean PlayWithCompletion(integer characterIndex, any onFinished)
		self:Stop()
		if not self.PresentationEnabled or not isvalid(self.effectRoot) or not isvalid(self.silhouette) or not isvalid(self.echo) or not isvalid(self.burst) then return false end
		local characters = _WorldCharacterSelectUI._characters
		local data = nil
		if characters ~= nil then data = characters[characterIndex + 1] end
		if data == nil or data.iconRuid == "" then return false end
		local sprite = _ResourceService:LoadSpriteAndWait(data.iconRuid)
		if sprite == nil or sprite.Height <= 0 then return false end
		self._aspect = math.max(0.35, math.min(1.7, sprite.Width / sprite.Height))
		self.silhouette.SpriteGUIRendererComponent.ImageRUID = DataRef(data.iconRuid)
		self.echo.SpriteGUIRendererComponent.ImageRUID = DataRef(data.iconRuid)
		self._onFinished = onFinished
		self._characterIndex = characterIndex
		self._elapsed = 0
		self._running = false
		self._impactLogged = false
		self._playCount = self._playCount + 1
		self.effectRoot.Enable = true
		self:RenderFrame(0)
		log("GameEntryFxUI create char=" .. tostring(characterIndex) .. " ruid=" .. data.iconRuid)
		-- 첫 UI 준비가 끝난 뒤부터 재생 시간을 센다. 준비 중 종료되어 첫 모양이 사라지는 일을 막는다.
		self._elapsed = 0
		self._running = true
		return true
	end

	@ExecSpace("ClientOnly")
	method void RenderFrame(number elapsed)
		if not isvalid(self.effectRoot) or not isvalid(self.silhouette) or not isvalid(self.echo) or not isvalid(self.burst) then return end
		local t = math.max(0, elapsed)
		local view = self.effectRoot.UITransformComponent.RectSize
		local h = math.max(360, view.y)
		local u = math.max(0, math.min(1, (t - 0.07) / math.max(0.05, self.ImpactSeconds - 0.07)))
		local zoom = u * u * u
		local height = h * (0.22 + 2.70 * zoom)
		local pos = Vector2(0, -22 + height * 0.20)
		local appear = math.min(1, t / 0.07)
		local burstAt = self.ImpactSeconds - 0.22
		local impact = math.max(0, math.min(1, (t - burstAt) / math.max(0.05, self.Duration - burstAt)))
		-- 화면으로 들어오는 동안 함께 투명해진다. 최대 크기에 닿을 때 본체는 이미 0이다.
		local fade = (1 - u) ^ 1.15
		-- 얕은 금빛 윤곽 + 어두운 본체. 투명 배경을 유지하여 원본 정면/얼굴 디테일은 드러나지 않는다.
		self.silhouette.Enable = fade > 0
		self.silhouette.UITransformComponent.RectSize = Vector2(height * self._aspect, height)
		self.silhouette.UITransformComponent.anchoredPosition = pos
		self.silhouette.CanvasGroupComponent.GroupAlpha = 0.86 * appear * fade
		self.echo.Enable = fade > 0
		self.echo.UITransformComponent.RectSize = Vector2(height * self._aspect * 1.035, height * 1.035)
		self.echo.UITransformComponent.anchoredPosition = pos + Vector2(0, -8 - 12 * u)
		self.echo.CanvasGroupComponent.GroupAlpha = 0.13 * appear * (1 - u) ^ 1.8
		local flash = self.effectRoot:GetChildByName("Flash")
		local shade = self.effectRoot:GetChildByName("Shade")
		local flashAlpha = 0
		if t >= self.ImpactSeconds then flashAlpha = 0.055 * math.max(0, 1 - (t - self.ImpactSeconds) / 0.11) end
		flash.CanvasGroupComponent.GroupAlpha = flashAlpha
		shade.CanvasGroupComponent.GroupAlpha = 0.06 * appear * fade
		self.burst.Enable = t >= burstAt and impact < 1
		self.burst.CanvasGroupComponent.GroupAlpha = 1
		-- 시작부터 큰 단풍 모양으로 나타난다. 0.17초 보여준 후 조각들이 폭죽처럼 흩어진다.
		local explodeAt = burstAt + 0.17
		local visible = math.max(0, math.min(1, (t - burstAt) / 0.045))
		local pop = math.max(0, math.min(1, (t - explodeAt) / math.max(0.05, self.Duration - explodeAt)))
		local core = self.burst:GetChildByName("MapleCore")
		core.UITransformComponent.RectSize = Vector2(h * 0.66, h * 0.66)
		core.UITransformComponent.anchoredPosition = Vector2(0, h * 0.025)
		core.UITransformComponent.UIRotation = Vector3(0, 0, 135)
		core.CanvasGroupComponent.GroupAlpha = visible * (1 - math.min(1, pop / 0.20))
		for i, leaf in ipairs(self._leaves) do
			local life = math.max(0, math.min(1, (t - explodeAt) / math.max(0.05, self.Duration - explodeAt)))
			local travel = 1 - (1 - life) ^ 3
			local fadeOut = math.max(0, math.min(1, (life - 0.65) / 0.35))
			local alpha = visible * (1 - fadeOut * fadeOut * (3 - 2 * fadeOut))
			local origin = self._leafOrigins[i]
			local velocity = self._leafVelocities[i]
			local baseSize = 0.025
			if i % 9 == 0 then baseSize = 0.038 end
			local size = h * baseSize * (1 - 0.25 * fadeOut)
			leaf.UITransformComponent.RectSize = Vector2(size, size)
			leaf.UITransformComponent.anchoredPosition = Vector2(origin.x * h * 0.60 + velocity.x * h * travel, origin.y * h * 0.60 + velocity.y * h * travel + h * 0.025 - h * 0.10 * life * life)
			leaf.UITransformComponent.UIRotation = Vector3(0, 0, (i - 1) * 37 + life * (70 + (i % 3) * 35))
			leaf.CanvasGroupComponent.GroupAlpha = alpha
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		if not self._running then return end
		if not self.PresentationEnabled or not isvalid(self.effectRoot) then self:Finish(); return end
		self._elapsed = self._elapsed + delta
		if self._elapsed >= self.Duration then
			self:Finish()
			return
		end
		self:RenderFrame(self._elapsed)
		if self._elapsed >= self.ImpactSeconds and not self._impactLogged then
			self._impactLogged = true
			log("GameEntryFxUI impact char=" .. tostring(self._characterIndex))
		end
	end

	@ExecSpace("ClientOnly")
	method void Finish()
		local done = self._onFinished
		self:Stop()
		log("GameEntryFxUI finish char=" .. tostring(self._characterIndex))
		if done ~= nil then done() end
	end

	@ExecSpace("ClientOnly")
	method void Stop()
		self._onFinished = nil
		self._running = false
		self._elapsed = 0
		if isvalid(self.effectRoot) then self.effectRoot.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		self:Stop()
	end
end
