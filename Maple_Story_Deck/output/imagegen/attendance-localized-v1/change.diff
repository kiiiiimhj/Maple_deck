+		if string.sub(locale, 1, 2) == "ko" then locale = "ko"
+		elseif string.sub(locale, 1, 2) == "ja" then locale = "ja"
+		elseif string.sub(locale, 1, 2) == "zh" then locale = "zh-tw"
+		else locale = "en" end
+		if self._displayLocaleId == locale then return end
+		if not isvalid(self.popupGroup) then return end
+		local panel = self.popupGroup:GetChildByName("Panel")
+		if not isvalid(panel) then return end
+		local board = panel:GetChildByName("Board")
+		if not isvalid(board) then return end
+		self._displayLocaleId = locale
+		self._localeTranslator = _LocalizationService:GetTranslatorForLocale(locale)
+		local original = locale == "ko"
+		board.SpriteGUIRendererComponent.ImageRUID = original and "33a152a2f3da4b4e9628c3ca422a709a" or "cc225de4579649029c046d8440f13414"
+		local title = board:GetChildByName("LocaleTitle")
+		if isvalid(title) then
+			title.Enable = not original
+			title.TextGUIRendererComponent.Text = self:GetLocaleText("UI_ATTENDANCE_TITLE", "Attendance\nRewards")
+		end
+		local originals = {"ce1270afb20d4555a1d7c2bee67210bc", "d353d57ade7a459b86d621348da26c1d", "6a06b8847366415d8b2a4178b26f7cef", "33a68145b4fc4de99acc22d32d3c8e3b", "74739d69081a4df0b87d2563fc6c887e", "bd55899300d34ac296e28728c1bcbbfd", "ecbde8d0defc4725840ea26b32270ad4"}
+		for day = 1, 7 do
+			local slot = self:GetSlot(day)
+			if isvalid(slot) then
+				local blank = day == 7 and "8b66df2b272d4ebb83c4da455541050a" or "ceb8bce4384b441795afed987a68cafc"
+				slot.SpriteGUIRendererComponent.ImageRUID = original and originals[day] or blank
+				local label = slot:GetChildByName("DayLabel")
+				if isvalid(label) then
+					label.Enable = not original
+					label.TextGUIRendererComponent.Text = self._localeTranslator:GetTextFormat("FMT_ATTENDANCEUI_DAY", day)
+				end
+			end
+		end
+		log("AttendanceUI locale=" .. locale .. " textFreeArtwork=" .. tostring(not original))
+	end
+
+	@ExecSpace("ClientOnly")
+	method string GetLocaleText(string key, string fallback)
+		local text = nil
+		if self._localeTranslator ~= nil then text = self._localeTranslator:GetText(key)
+		else text = _LocalizationService:GetText(key) end
+		if text == nil or text == "" or text == key then return fallback end
+		return text
+	end
