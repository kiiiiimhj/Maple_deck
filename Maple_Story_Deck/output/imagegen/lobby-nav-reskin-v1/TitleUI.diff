--- TitleUI-before.mlua
+++ TitleUI-after.mlua
@@ -188,7 +188,22 @@
 	end
 
 	@ExecSpace("ClientOnly")
+	method void UpdateNavSelection(string tabName)
+		-- Keep the reflection separate from the original animated icons.
+		local glow = _EntityService:GetEntityByPath("/ui/TitleGroup/TabBar/SelectedGlow")
+		if not isvalid(glow) then return end
+		local positions = {shop = -768, skill = -384, battle = 0, relic = 384, rank = 768}
+		local x = positions[tabName]
+		glow.Enable = (x ~= nil)
+		if x ~= nil then
+			glow.UITransformComponent.anchoredPosition = Vector2(x, 20)
+		end
+		log("TitleUI: nav skin selected " .. tabName)
+	end
+
+	@ExecSpace("ClientOnly")
 	method void ShowPanelOnly(string tabName)
+		self:UpdateNavSelection(tabName)
 		-- 5개 패널 중 선택된 탭 하나만 보여주고 나머지는 숨긴다 (아이콘 연출은 건드리지 않는다)
 		self.battlePanel.Enable = (tabName == "battle")
 		self.shopPanel.Enable = (tabName == "shop")
