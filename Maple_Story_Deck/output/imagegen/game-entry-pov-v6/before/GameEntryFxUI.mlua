@Logic
script GameEntryFxUI extends Logic

	-- 선택 캐릭터가 투명해지며 화면에 들어온 뒤 빛 단풍과 잔광까지 끝나야 전투가 시작된다.
	property boolean PresentationEnabled = true
	property Entity effectRoot = "8782e100-799f-4606-8b6f-9900f7b7cbe7"
	property Entity silhouette = "bdd58432-cfee-444c-850d-dc850d757514"
	property Entity echo = "aa706048-1e0b-4612-82f4-54354c9a7881"
	property Entity burst = "b0c3ae2f-49d5-4233-94fd-b211840367e6"
	property number Duration = 1.36
	property number ImpactSeconds = 0.56
	property boolean _running = false
	property number _elapsed = 0
	property number _aspect = 0.8
	property integer _characterIndex = -1
	property integer _playCount = 0
	property boolean _impactLogged = false
	property boolean _bodyVisible = false
	property table _leaves = {}
	property table _leafViews = {}
	property table _leafOrigins = {}
	property table _leafVelocities = {}
	property table _render = {}
	property number _height = 1080
	property any _onFinished = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self._leafOrigins = {
			Vector2(-0.01256, 0.48492),
			Vector2(0.04271, -0.50000),
			Vector2(0.37940, 0.01256),
			Vector2(-0.42462, -0.17839),
			Vector2(-0.08794, 0.07286),
			Vector2(-0.39447, 0.32915),
			Vector2(0.41457, 0.35427),
			Vector2(0.23367, -0.25879),
			Vector2(-0.15327, -0.19347),
			Vector2(0.17839, 0.33920),
			Vector2(0.06281, -0.10302),
			Vector2(-0.16834, 0.32412),
			Vector2(0.40955, -0.18342),
			Vector2(0.28894, 0.18342),
			Vector2(-0.24874, -0.02764),
			Vector2(0.05779, -0.30402),
			Vector2(0.00754, 0.28392),
			Vector2(0.26382, -0.10804),
			Vector2(-0.20352, 0.17839),
			Vector2(-0.28894, -0.19347),
			Vector2(0.13819, -0.40452),
			Vector2(-0.29397, 0.26382),
			Vector2(0.09296, 0.42965),
			Vector2(-0.03769, -0.16332)
		}
		self._leafVelocities = {
			Vector2(-0.20001, 0.49442),
			Vector2(0.43503, -0.51720),
			Vector2(0.31348, 0.15749),
			Vector2(-0.66985, -0.16590),
			Vector2(-0.51341, 0.29961),
			Vector2(-0.50627, 0.28612),
			Vector2(0.72337, 0.25087),
			Vector2(0.44587, -0.25905),
			Vector2(-0.13535, -0.54764),
			Vector2(0.03438, 0.36233),
			Vector2(0.28108, -0.53752),
			Vector2(-0.41914, 0.29051),
			Vector2(0.64902, -0.03561),
			Vector2(0.28564, 0.31981),
			Vector2(-0.59153, 0.07000),
			Vector2(-0.17999, -0.37423),
			Vector2(0.23005, 0.30700),
			Vector2(0.37792, -0.10685),
			Vector2(-0.40974, 0.39981),
			Vector2(-0.51451, -0.39650),
			Vector2(0.09414, -0.59011),
			Vector2(-0.36318, 0.40466),
			Vector2(-0.05564, 0.42978),
			Vector2(-0.11245, -0.32581)
		}
		self._leaves = {}
		self._leafViews = {}
		self._render = {}
		if isvalid(self.effectRoot) and isvalid(self.burst) then
			local core = self.burst:GetChildByName("MapleCore")
			local particles = self.burst:GetChildByName("Particles")
			local shade = self.effectRoot:GetChildByName("Shade")
			local flash = self.effectRoot:GetChildByName("Flash")
			if isvalid(core) and isvalid(particles) and isvalid(shade) and isvalid(flash) then
				self._render = {
					mainTransform = self.silhouette.UITransformComponent,
					mainAlpha = self.silhouette.CanvasGroupComponent,
					echoTransform = self.echo.UITransformComponent,
					echoAlpha = self.echo.CanvasGroupComponent,
					coreTransform = core.UITransformComponent,
					coreAlpha = core.CanvasGroupComponent,
					particlesAlpha = particles.CanvasGroupComponent,
					shadeAlpha = shade.CanvasGroupComponent,
					flashAlpha = flash.CanvasGroupComponent
				}
				for i = 0, 23 do
					local leaf = particles:GetChildByName("Leaf_" .. tostring(i))
					if isvalid(leaf) then
						table.insert(self._leaves, leaf)
						table.insert(self._leafViews, { transform = leaf.UITransformComponent, alpha = leaf.CanvasGroupComponent })
					end
				end
			end
		end
		self:Stop()
		-- 먼저 로드해 입장 순간에 새 텍스처를 읽느라 멈추지 않도록 한다.
		_ResourceService:LoadSpriteAndWait("67f080a4c1f14551915d8da7410c4081")
		log("GameEntryFxUI started (light maple v5, enabled=" .. tostring(self.PresentationEnabled) .. ")")
	end

	@ExecSpace("ClientOnly")
	method boolean Play(integer characterIndex)
		return self:PlayWithCompletion(characterIndex, nil)
	end

	@ExecSpace("ClientOnly")
	method boolean PlayWithCompletion(integer characterIndex, any onFinished)
		self:Stop()
		if not self.PresentationEnabled or not isvalid(self.effectRoot) or self._render.coreAlpha == nil then return false end
		local characters = _WorldCharacterSelectUI._characters
		local data = nil
		if characters ~= nil then data = characters[characterIndex + 1] end
		if data == nil or data.iconRuid == "" then return false end
		local sprite = _ResourceService:LoadSpriteAndWait(data.iconRuid)
		if sprite == nil or sprite.Height <= 0 then return false end
		self._aspect = math.max(0.35, math.min(1.7, sprite.Width / sprite.Height))
		self.silhouette.SpriteGUIRendererComponent.ImageRUID = DataRef(data.iconRuid)
		self.echo.SpriteGUIRendererComponent.ImageRUID = DataRef(data.iconRuid)
		self._onFinished = onFinished
		self._characterIndex = characterIndex
		self._elapsed = 0
		self._impactLogged = false
		self._playCount = self._playCount + 1
		self._height = math.max(360, self.effectRoot.UITransformComponent.RectSize.y)
		local h = self._height
		local r = self._render
		-- RectSize, 회전, 개별 알파는 준비할 때 한 번만 설정한다. 재생 중 레이아웃 재계산을 줄인다.
		r.mainTransform.RectSize = Vector2(h * self._aspect, h)
		r.echoTransform.RectSize = Vector2(h * self._aspect * 1.035, h * 1.035)
		r.coreTransform.RectSize = Vector2(h * 0.66, h * 0.66)
		r.coreTransform.anchoredPosition = Vector2(0, h * 0.025)
		r.coreTransform.UIRotation = Vector3(0, 0, 0)
		r.flashAlpha.GroupAlpha = 0
		for i, leaf in ipairs(self._leafViews) do
			local size = h * 0.010
			if i % 3 == 0 then size = h * 0.032 elseif i % 3 == 1 then size = h * 0.018 end
			leaf.transform.RectSize = Vector2(size, size)
			leaf.transform.UIRotation = Vector3(0, 0, (i - 1) * 37)
			leaf.transform.UIScale = Vector3(1, 1, 1)
			leaf.alpha.GroupAlpha = 0.75
		end
		self.silhouette.Enable = true
		self.echo.Enable = true
		self.burst.Enable = true
		self.burst.CanvasGroupComponent.GroupAlpha = 1
		self._bodyVisible = true
		self:RenderFrame(0)
		self.effectRoot.Enable = true
		log("GameEntryFxUI create char=" .. tostring(characterIndex) .. " ruid=" .. data.iconRuid)
		-- UI 준비와 텍스처 로딩이 끝난 뒤 재생을 시작한다.
		self._elapsed = 0
		self._running = true
		return true
	end

	@ExecSpace("ClientOnly")
	method void RenderFrame(number elapsed)
		local r = self._render
		if r.coreAlpha == nil then return end
		local t = math.max(0, elapsed)
		local h = self._height
		local u = math.max(0, math.min(1, (t - 0.07) / math.max(0.05, self.ImpactSeconds - 0.07)))
		if u < 1 then
			if not self._bodyVisible then
				self.silhouette.Enable = true
				self.echo.Enable = true
				self._bodyVisible = true
			end
			local scale = 0.22 + 2.70 * u * u * u
			local height = h * scale
			local appear = math.min(1, t / 0.07)
			local fade = (1 - u) ^ 1.15
			r.mainTransform.UIScale = Vector3(scale, scale, 1)
			r.mainTransform.anchoredPosition = Vector2(0, -22 + height * 0.20)
			r.mainAlpha.GroupAlpha = 0.86 * appear * fade
			r.echoTransform.UIScale = Vector3(scale, scale, 1)
			r.echoTransform.anchoredPosition = Vector2(0, -30 + height * 0.20 - 12 * u)
			r.echoAlpha.GroupAlpha = 0.13 * appear * (1 - u) ^ 1.8
			r.shadeAlpha.GroupAlpha = 0.06 * appear * fade
		elseif self._bodyVisible then
			r.mainAlpha.GroupAlpha = 0
			r.echoAlpha.GroupAlpha = 0
			r.shadeAlpha.GroupAlpha = 0
			self.silhouette.Enable = false
			self.echo.Enable = false
			self._bodyVisible = false
		end
		local reveal = math.max(0, math.min(1, (t - (self.ImpactSeconds - 0.22)) / 0.14))
		local visible = reveal * reveal * (3 - 2 * reveal)
		local life = math.max(0, math.min(1, (t - self.ImpactSeconds) / math.max(0.05, self.Duration - self.ImpactSeconds)))
		local dissolve = life * life * (3 - 2 * life)
		-- 단풍 자체가 짧게 반짝인다. 이후 투명도를 0까지 연속으로 낮춰 잔광이 잘리지 않게 한다.
		local pulseTime = (t - (self.ImpactSeconds - 0.03)) / 0.055
		local pulse = math.exp(-pulseTime * pulseTime)
		local coreScale = 0.95 + 0.14 * life + 0.025 * pulse
		r.coreTransform.UIScale = Vector3(coreScale, coreScale, 1)
		r.coreAlpha.GroupAlpha = visible * (0.43 + 0.23 * pulse) * (1 - dissolve)
		local emit = math.max(0, math.min(1, (t - self.ImpactSeconds) / 0.055))
		r.particlesAlpha.GroupAlpha = 0.82 * emit * emit * (3 - 2 * emit) * (1 - life) ^ 1.4
		if life > 0 and life < 1 then
			local travel = 1 - (1 - life) * (1 - life)
			local gravity = h * 0.075 * life * life
			for i, leaf in ipairs(self._leafViews) do
				local origin = self._leafOrigins[i]
				local velocity = self._leafVelocities[i]
				leaf.transform.anchoredPosition = Vector2(origin.x * h * 0.60 + velocity.x * h * 0.65 * travel, origin.y * h * 0.60 + velocity.y * h * 0.65 * travel + h * 0.025 - gravity)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		if not self._running then return end
		if not self.PresentationEnabled or not isvalid(self.effectRoot) then self:Finish(); return end
		self._elapsed = self._elapsed + delta
		if self._elapsed >= self.Duration then
			self:RenderFrame(self.Duration)
			self:Finish()
			return
		end
		self:RenderFrame(self._elapsed)
		if self._elapsed >= self.ImpactSeconds and not self._impactLogged then
			self._impactLogged = true
			log("GameEntryFxUI impact char=" .. tostring(self._characterIndex))
		end
	end

	@ExecSpace("ClientOnly")
	method void Finish()
		local done = self._onFinished
		self:Stop()
		log("GameEntryFxUI finish char=" .. tostring(self._characterIndex))
		if done ~= nil then done() end
	end

	@ExecSpace("ClientOnly")
	method void Stop()
		self._onFinished = nil
		self._running = false
		self._elapsed = 0
		if isvalid(self.effectRoot) then self.effectRoot.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		self:Stop()
	end
end
