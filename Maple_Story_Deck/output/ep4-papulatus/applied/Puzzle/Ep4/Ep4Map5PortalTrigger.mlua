@Component
script Ep4Map5PortalTrigger extends Component
	property any _touchHandler = nil

	method void OnBeginPlay()
		-- 빛 퍼즐이 개방한 포탈의 터치만 보스방 입장 요청으로 연결한다.
		if self:IsClient() then self._touchHandler=self.Entity:ConnectEvent(TouchEvent,self.OnTouched) end
	end

	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		-- 전투 중 활성 포탈에 대한 터치만 허용한다.
		if not _GameManager.GameStarted or _GameManager.GameOver or _GameManager:IsGamePaused() then return end
		if _TitleUI.titleGroup.Enable or _CardManager:IsMonsterUnderTouch(event.TouchPoint) then return end
		self:RequestEnter()
	end

	@ExecSpace("Server")
	method void RequestEnter()
		-- 서버에서 퍼즐 완료, 실제 포탈, 현재 맵과 요청자를 재검사한다.
		_Ep4PapulatusLogic:OnPortalTouched(self.Entity,senderUserId)
	end

	method void OnEndPlay()
		-- 터치 이벤트 연결을 정리한다.
		if self:IsClient() and self._touchHandler~=nil then self.Entity:DisconnectEvent(TouchEvent,self._touchHandler) self._touchHandler=nil end
	end
end
