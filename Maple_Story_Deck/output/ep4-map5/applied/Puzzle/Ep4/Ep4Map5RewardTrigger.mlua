@Component
script Ep4Map5RewardTrigger extends Component
	property any _touchHandler = nil
	method void OnBeginPlay()
		if self:IsClient() and self._touchHandler==nil then self._touchHandler=self.Entity:ConnectEvent(TouchEvent,self.OnTouched) end
	end
	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		if not _GameManager.GameStarted or _GameManager.GameOver or _GameManager:IsGamePaused() then return end
		if _TitleUI.titleGroup.Enable or _CardManager:IsMonsterUnderTouch(event.TouchPoint) then return end
		self:RequestTouch(_Ep4Map5EasterEggLogic.RunRevision)
	end
	@ExecSpace("Server")
	method void RequestTouch(integer revision)
		_Ep4Map5EasterEggLogic:OnRewardTouched(self.Entity,revision,senderUserId)
	end
	method void OnEndPlay()
		if self:IsClient() and self._touchHandler~=nil then self.Entity:DisconnectEvent(TouchEvent,self._touchHandler) self._touchHandler=nil end
	end
end
