@Logic
script PetLogic extends Logic

	-- One native species. Registered cash product ID/price are supplied by the creator.
	property string PetEggProductId = ""
	property integer PetEggPrice = 0
	property string PetNameKey = "PET_NAME_5002617"
	property string StorageKey = "Pets.v1.5002617"
	property integer StoneItemId = 520001
	property string StoneIcon = "4c1a2655150c4b189dbd68e00dec93bf"
	property integer EnergyTickMilliseconds = 30000
	property integer MinimumRunSeconds = 120
	property integer ScorePerStone = 500
	property integer MaxRunStones = 6
	property table RankCosts = {10, 30, 60}
	property table RankDamage = {3, 5, 8, 12}
	property table Motions = {
		angry="9c3e363aba58415c897c070af04a5565", chat="22cf6770344b47f5927e72e05d08ee20",
		cry="20c09185ea004aa4843a243baa8de1dd", dung="3e209a3eb5e148e6823fc68c0ce1ee1e",
		eat="06b3d404f2f1492999456a76d97303f0", hungry="b99f41390c144c3797c2468050bd7a3b",
		icon="85f54bc06d7442a59151f11dd7ffd8e5", love="fdf3f8a07d9c4dc0abecd9cf721d13cd",
		move="b0e82d7569d64d20bd9e28ae08f8ba0f", rest="3caba02c991244deb6f6d366f3b27a3f",
		sit="f4379bd3baee43e4871d0c8df9a019ef", sleep="1df8735ad1b44e39a76399cacbc4a51c",
		stand="7080e8b5b625496d8c753df1239824a4", stand1="9f524b17d8bf43f9b8ca32b57aa7b4b9",
		what="eca6925ea9ef4e26aa1d5685f32c1640"
	}
	property table States = {}
	property any ClientPet = nil
	property boolean ClientReady = false
	property boolean ClientTest = false
	property integer ClientRevision = 0
	property string RunUserId = ""
	property integer RunPaidStones = 0
	property integer RunToken = 0
	@Sync
	property number RunDamageMultiplier = 1
	@Sync
	property integer RunStoneTotal = 0
	@Sync
	property integer RunStoneNew = 0

	method integer GetMaxLevel(integer rank)
		-- Rank extends the cap without discarding the current level.
		return (math.max(0, math.min(3, rank)) + 1) * 10
	end

	method integer GetXPNeeded(integer level)
		-- A steady care curve; spending stones never purchases care XP.
		return 40 + level * 12
	end

	method number GetDamagePercent(integer level, integer rank)
		-- The supplied species has only damage as its innate combat stat.
		local r = math.max(0, math.min(3, rank))
		return self.RankDamage[r + 1] + math.max(0, level - r * 10 - 1) * 0.15
	end

	method number GetRunDamageMult()
		-- Snapshot at actual run start, so lobby care cannot alter an ongoing battle.
		return self.RunDamageMultiplier
	end

	@ExecSpace("ClientOnly")
	method number GetLobbyDamageMult()
		-- Inventory stats reflect the currently equipped pet.
		local pet = self.ClientPet
		if pet == nil or not pet.Owned or not pet.Equipped then return 1 end
		return 1 + self:GetDamagePercent(pet.Level, pet.Rank) / 100
	end

	method integer CalculateRunStones(integer score, number seconds)
		-- Diminishing score conversion plus active survival time; six per run maximum.
		if score < self.ScorePerStone or seconds < self.MinimumRunSeconds then return 0 end
		local survival = 1
		if seconds >= 600 then survival = 1.5
		elseif seconds >= 300 then survival = 1.2 end
		return math.min(self.MaxRunStones, math.floor(math.sqrt(score / self.ScorePerStone) * survival))
	end

	@ExecSpace("ServerOnly")
	method void CollectLoadKeys(table loadKeys)
		-- Join the existing player batch rather than issuing a separate login read.
		table.insert(loadKeys, self.StorageKey)
	end

	@ExecSpace("ServerOnly")
	method boolean LoadFor(Entity player, table loadedData)
		-- A failed or future-version load stays closed to purchases, care and saving.
		local pet = PetProgress()
		local item = loadedData[self.StorageKey]
		if item ~= nil and item.Value ~= nil and item.Value ~= "" then
			local ok, data = pcall(function() return _HttpService:JSONDecode(item.Value) end)
			if not ok or type(data) ~= "table" or not pet:Deserialize(data) then
				log_error("PetLogic: invalid saved pet data; load aborted")
				return false
			end
		end
		local now = _DateTimeLogic:GetTimeElapsedWithoutOffset()
		if pet.EnergyAt == 0 then pet.EnergyAt = now end
		if pet.NeedsAt == 0 then pet.NeedsAt = now end
		local id = player.PlayerComponent.UserId
		self.States[id] = {pet=pet, dirty=false, generation=0, test=false, lastRequest=-100}
		self:Recover(self.States[id], now)
		self:PushState(id, "", "")
		return true
	end

	@ExecSpace("ServerOnly")
	method void SaveFor(Entity player, table saveData, table generations)
		-- Stamp this particular save; unconfirmed writes never clear dirty state.
		local record = self.States[player.PlayerComponent.UserId]
		if record == nil or not record.dirty or record.test then return end
		saveData[self.StorageKey] = _HttpService:JSONEncode(record.pet:Serialize())
		generations[self.StorageKey] = record.generation
	end

	@ExecSpace("ServerOnly")
	method void ConfirmSaveFor(Entity player, table succeeded, table generations)
		-- Ignore partial failures and changes that raced the asynchronous save.
		if not isvalid(player) then return end
		local record = self.States[player.PlayerComponent.UserId]
		if record == nil or record.test or generations[self.StorageKey] ~= record.generation then return end
		for _, key in ipairs(succeeded or {}) do
			if key == self.StorageKey then record.dirty = false return end
		end
	end

	@ExecSpace("ServerOnly")
	method void MarkDirty(table record)
		-- All persisted mutations advance their generation before a batch save.
		record.dirty = true
		record.generation = record.generation + 1
	end

	@ExecSpace("ServerOnly")
	method void Recover(table record, integer now)
		-- Calculate elapsed recovery only on access, preserving partial tick time.
		local pet = record.pet
		if not pet.Owned then return end
		local steps = math.floor(math.max(0, now - pet.EnergyAt) / self.EnergyTickMilliseconds)
		local needSteps = math.floor(math.max(0, now - pet.NeedsAt) / 1800000)
		if steps > 0 then
			local before = pet.Energy
			pet.Energy = math.min(1000, pet.Energy + steps)
			pet.EnergyAt = pet.EnergyAt + steps * self.EnergyTickMilliseconds
			if pet.Energy ~= before then self:MarkDirty(record) end
		end
		if needSteps > 0 then
			pet.Fullness = math.max(0, pet.Fullness - needSteps * 3)
			pet.Cleanliness = math.max(0, pet.Cleanliness - needSteps * 2)
			pet.Mood = math.max(0, pet.Mood - needSteps * 2)
			pet.NeedsAt = pet.NeedsAt + needSteps * 1800000
			self:MarkDirty(record)
		end
	end

	@ExecSpace("ServerOnly")
	method void PushState(string userId, string motion, string message)
		-- Target the account that owns the pet, including replies to care requests.
		local record = self.States[userId]
		if record == nil then return end
		if _GameManager.GameStarted and not _GameManager.GameOver then
			self:PushState(userId, "", "PET_BATTLE_LOCKED") return
		end
		self:ReceiveState(_HttpService:JSONEncode(record.pet:Serialize()), record.test, motion, message, userId)
	end

	@ExecSpace("Client")
	method void ReceiveState(string json, boolean test, string motion, string message)
		-- The client holds only its own display snapshot; it never grants rewards.
		local pet = PetProgress()
		if not pet:Deserialize(_HttpService:JSONDecode(json)) then return end
		self.ClientPet = pet
		self.ClientReady = true
		self.ClientTest = test
		self.ClientRevision = self.ClientRevision + 1
		_PetUI:OnPetChanged(motion)
		if message ~= "" then _UIToast:ShowMessage(message) end
	end

	@ExecSpace("Server")
	method void RequestState()
		-- senderUserId is supplied by the engine, never accepted from the client.
		local record = self.States[senderUserId]
		if record == nil then return end
		local now = _DateTimeLogic:GetTimeElapsedWithoutOffset()
		if now - (record.lastRefresh or 0) < 1000 then return end
		record.lastRefresh = now
		self:Recover(record, now)
		self:PushState(senderUserId, "", "")
	end

	@ExecSpace("Server")
	method void RequestAction(string action)
		-- Validate ownership, lobby, energy, cooldown and rank on the server.
		local userId = senderUserId
		local record = self.States[userId]
		if record == nil then return end
		if action == "test" then
			if not Environment:IsMakerPlay() or record.pet.Owned then return end
			local preview = PetProgress()
			preview:Deserialize(record.pet:Serialize())
			preview.Owned = true preview.Equipped = true preview.Stones = 100
			preview.EnergyAt = _DateTimeLogic:GetTimeElapsedWithoutOffset()
			preview.NeedsAt = preview.EnergyAt
			self.States[userId] = {pet=preview, dirty=false, generation=0, test=true, lastRequest=-100}
			self:PushState(userId, "love", "PET_TEST_NOTICE")
			return
		end
		local pet = record.pet
		if not pet.Owned then self:PushState(userId, "what", "PET_NO_PET") return end
		if _GameManager.GameStarted and not _GameManager.GameOver then
			self:PushState(userId, "", "PET_BATTLE_LOCKED") return
		end
		local now = _DateTimeLogic:GetTimeElapsedWithoutOffset()
		if now - record.lastRequest < 2800 then return end
		record.lastRequest = now
		self:Recover(record, now)
		if action == "equip" then
			pet.Equipped = not pet.Equipped
			self:MarkDirty(record) self:PushState(userId, "love", "") return
		end
		if action == "rank" then
			local cost = self.RankCosts[pet.Rank + 1]
			if cost == nil or pet.Level < self:GetMaxLevel(pet.Rank) then
				self:PushState(userId, "what", "PET_RANK_LEVEL") return
			end
			if pet.Stones < cost then self:PushState(userId, "what", "PET_STONES_SHORT") return end
			pet.Stones = pet.Stones - cost pet.Rank = pet.Rank + 1
			self:MarkDirty(record) self:PushState(userId, "love", "PET_RANK_DONE") return
		end
		if action == "sleep" then
			if now < pet.SleepUntil then self:PushState(userId, "sleep", "PET_SLEEP_WAIT") return end
			if pet.Energy >= 1000 then self:PushState(userId, "stand", "PET_ENERGY_FULL") return end
			pet.Energy = math.min(1000, pet.Energy + 100)
			pet.SleepUntil = now + 3600000
			self:MarkDirty(record) self:PushState(userId, "sleep", "PET_REST_DONE") return
		end
		local choices = {feed={80,16,"eat"}, wash={120,24,"chat"}, walk={160,32,"move"}}
		local choice = choices[action]
		if choice == nil then return end
		if pet.Energy < choice[1] then self:PushState(userId, "hungry", "PET_ENERGY_SHORT") return end
		pet.Energy = pet.Energy - choice[1]
		pet.EnergyAt = now
		if action == "feed" then pet.Fullness = math.min(100, pet.Fullness + 35)
		elseif action == "wash" then pet.Cleanliness = math.min(100, pet.Cleanliness + 40)
		else pet.Mood = math.min(100, pet.Mood + 30) end
		pet.XP = pet.XP + choice[2]
		local levelBefore = pet.Level
		while pet.Level < self:GetMaxLevel(pet.Rank) and pet.XP >= self:GetXPNeeded(pet.Level) do
			pet.XP = pet.XP - self:GetXPNeeded(pet.Level) pet.Level = pet.Level + 1
		end
		if pet.Level >= self:GetMaxLevel(pet.Rank) then pet.XP = 0 end
		self:MarkDirty(record)
		local message = ""
		if pet.Level > levelBefore then message = "PET_LEVEL_DONE" end
		self:PushState(userId, choice[3], message)
	end

	@ExecSpace("ServerOnly")
	method boolean GrantPurchasedPet(string userId)
		-- Only the existing shop purchase callback may invoke this durable grant.
		local player = _UserService:GetUserEntityByUserId(userId)
		local record = self.States[userId]
		if not isvalid(player) or record == nil or record.test or not player.PlayerDBManager.IsLoadSuccess then return false end
		local pet = record.pet
		if not pet.Owned then
			pet.Owned = true pet.Equipped = true
			pet.EnergyAt = _DateTimeLogic:GetTimeElapsedWithoutOffset() pet.NeedsAt = pet.EnergyAt
			self:MarkDirty(record)
		end
		if record.dirty and not player.PlayerDBManager:SavePetPurchaseAndWait() then return false end
		self:PushState(userId, "love", "PET_HATCH_DONE")
		return true
	end

	@ExecSpace("ServerOnly")
	method void InitForRun(string userId)
		-- Continue preserves this snapshot; a genuine restart clears the reward watermark.
		self.RunToken = self.RunToken + 1
		self.RunUserId = userId self.RunPaidStones = 0 self.RunStoneTotal = 0 self.RunStoneNew = 0
		self.RunDamageMultiplier = 1
		local record = self.States[userId]
		if record ~= nil and record.pet.Owned and record.pet.Equipped then
			self.RunDamageMultiplier = 1 + self:GetDamagePercent(record.pet.Level, record.pet.Rank) / 100
		end
	end

	@ExecSpace("ServerOnly")
	method void SettleRun(integer score, number seconds)
		-- Pay only the increase over this run's highest credited total, even after continue.
		local record = self.States[self.RunUserId]
		if record == nil then return end
		local total = self:CalculateRunStones(score, seconds)
		local delta = math.max(0, total - self.RunPaidStones)
		self.RunStoneTotal = math.max(total, self.RunPaidStones)
		self.RunStoneNew = delta
		if delta <= 0 then return end
		self.RunPaidStones = self.RunPaidStones + delta
		record.pet.Stones = record.pet.Stones + delta
		self:MarkDirty(record) self:PushState(self.RunUserId, "", "")
		local player = _UserService:GetUserEntityByUserId(self.RunUserId)
		if isvalid(player) then player.PlayerDBManager:SaveToDB(false) end
	end

	@ExecSpace("ServerOnly")
	method void SettleGameOver()
		-- Reconcile late loot once without letting an old timer pay into a new run.
		self:SettleRun(_GameManager:CalcRunScore(), _GameManager.RunElapsedSec)
		local token = self.RunToken
		_TimerService:SetTimerOnce(function()
			if token == self.RunToken and _GameManager.GameOver then
				self:SettleRun(_GameManager:CalcRunScore(), _GameManager.RunElapsedSec)
			end
		end, 1)
	end

	@ExecSpace("ClientOnly")
	method ItemStruct GetStoneInventoryItem()
		-- Read-only currency slot: account stones share the pet save and cannot be sold or discarded.
		if not self.ClientReady or self.ClientPet.Stones <= 0 then return nil end
		local item = ItemStruct()
		item.GUID = "pet-evolution-stone" item.ItemId = self.StoneItemId item.Count = self.ClientPet.Stones
		return item
	end

end
