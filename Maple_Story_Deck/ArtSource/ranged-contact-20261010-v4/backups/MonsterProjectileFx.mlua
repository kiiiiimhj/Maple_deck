            ["022330aea10449ac970a86ee17db8709"]={0.0344827586207,0.0689655172414,0.103448275862,0.137931034483,0.172413793103,0.206896551724,0.241379310345,0.275862068966,0.310344827586,0.344827586207,0.379310344828,0.413793103448,0.448275862069,0.48275862069,0.51724137931,0.551724137931,0.586206896552,0.620689655172,0.655172413793,0.689655172414,0.724137931034,0.758620689655,0.793103448276,0.827586206897,0.862068965517,0.896551724138,0.931034482759,0.965517241379,1},
