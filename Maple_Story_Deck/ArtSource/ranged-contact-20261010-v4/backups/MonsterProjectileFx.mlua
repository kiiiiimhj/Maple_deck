    method any GetProfile(string stand)
        return self:GetProfiles()[stand]
    end

    -- Boss attack cycles retain their own hit art and emission frame; summon-only slots stay on their original path.
    method any GetAttackProfile(string stand, string attack)
        local profile=self:GetProfile(stand)
        if profile==nil or profile.variants==nil then return profile end
        local variant=profile.variants[attack]
        if variant==nil then return profile end
        local selected={}
        for key,value in pairs(profile) do selected[key]=value end
        for key,value in pairs(variant) do selected[key]=value end
        return selected
    end

