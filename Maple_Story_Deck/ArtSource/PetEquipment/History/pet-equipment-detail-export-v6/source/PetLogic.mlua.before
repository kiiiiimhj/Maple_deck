	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self:PreloadPetGearArtwork()
		self:PreloadNativePetGearArtwork()
		self:PreloadPetSkillArtwork()
		self:PreloadFoxArtwork()
		self:PreloadTurtleArtwork()
		self:PreloadOduckArtwork()
		self.TtungttangReady=false
		local list={} local seen={}
		for _,frames in pairs(self.TtungttangFrames) do
			for _,ruid in ipairs(frames) do if not seen[ruid] then seen[ruid]=true table.insert(list,ruid) end end
		end
		_ResourceService:PreloadAsync(list,function(results)
			self.TtungttangReady=true
			for _,result in pairs(results) do if result~=PreloadResultStatus.Success then self.TtungttangReady=false end end
			log("[VRF] PET-CATALOG Ttungttang frames ready="..tostring(self.TtungttangReady).." count="..#list)
			if _PetHouseUI.PetMode then _PetHouseUI:Refresh() end
		end)
	end

	-- House and inventory use the same frame clock; open eyes return before every idle loop.
	method integer GetCustomFrameIndex(string pose, number elapsed)
		local frames=self.TtungttangFrames[pose] or self.TtungttangFrames.stand
		if frames==nil or #frames==0 then return 1 end
		local t=math.max(0,elapsed)
		if pose=="inject" then
			if t<1.2 then return math.min(#frames,1+math.min(4,math.floor(t/0.24))) end
			if t<2.5 then return math.min(#frames,6+math.min(3,math.floor((t-1.2)/0.325))) end
			return math.min(#frames,10+math.min(2,math.floor((t-2.5)/0.25)))
		end
		if pose=="chat" then return math.min(#frames,math.floor(t/0.15)+1) end
		local delay=0.09
		if pose=="move" or pose=="eat" then delay=1/14
		elseif pose=="sleep" then delay=0.2
		elseif pose=="what" or pose=="cry" or pose=="rest" or pose=="hungry" or pose=="angry" then delay=0.24
		elseif pose=="sniff" then delay=0.18 end
		return math.floor(t/delay)%#frames+1
	end

	method table GetPetDefinition(string petId)
		if petId=="5002617" then return {id=petId,nameKey=self.PetNameKey,stand=self.Motions.stand,motions=self.Motions,pixelScale=6.3888888889,productId=self.PetEggProductId,price=self.PetEggPrice,bonusKey="PET_HOUSE_DAMAGE_FORMAT"} end
		if petId=="5000498" then return {id=petId,nameKey="PET_NAME_DUCKY",stand=self.FoxMotions.stand,motions=self.FoxMotions,pixelScale=4.2,inventoryPixelScale=3.8,productId=self.FoxEggProductId,price=self.FoxEggPrice,bonusKey="PET_HOUSE_COOLDOWN_FORMAT",nativeWalk=true} end
		if petId=="landturtle" then return {id=petId,nameKey="PET_NAME_BUGI",stand=self.TurtleMotions.stand,motions=self.TurtleMotions,pixelScale=6,inventoryPixelScale=5.2,productId=self.TurtleEggProductId,price=self.TurtleEggPrice,bonusKey="PET_HOUSE_HP_FORMAT",nativeWalk=true} end
		if petId=="oduck" then return {id=petId,nameKey="PET_NAME_ODUCK",stand=self.OduckMotions.stand,motions=self.OduckMotions,pixelScale=4.0,inventoryPixelScale=4.5,productId=self.OduckEggProductId,price=self.OduckEggPrice,bonusKey="PET_HOUSE_ATTACK_FORMAT",nativeWalk=true} end
		if petId~="ttungttang" then return nil end
		local frames=self.TtungttangFrames
		local function first(key) local list=frames[key] return list~=nil and list[1] or "" end
		local motions={stand=first("stand"),stand1=first("stand"),move=first("move"),eat=first("eat"),chat=first("chat"),sleep=first("sleep"),inject=first("inject"),love=first("love"),gift=first("love"),what=first("what"),cry=first("cry"),hungry=first("rest"),angry=first("cry"),rest=first("rest"),dung=first("sniff")}
		return {id=petId,nameKey="PET_NAME_TTUNGTTANG",stand=motions.stand,motions=motions,frames=frames,pixelScale=3.19444444445,inventoryPixelScale=2.94444444445,canvas=128,footOffset=54,productId=self.TtungttangEggProductId,price=self.TtungttangEggPrice,bonusKey="PET_HOUSE_CRIT_FORMAT"}
	end

	-- Keep each texture pixel on a complete screen pixel; preserve the paw ground plane.
	@ExecSpace("ClientOnly")
	method void AlignCustomPortrait(Entity portrait, table entry, number desiredScale)
		if entry.frames==nil or not isvalid(portrait) then return end
		local t=portrait.UITransformComponent
		local image=portrait.SpriteGUIRendererComponent
		image.Type=ImageType.Simple image.Outline=false image.DropShadow=false
		image.LocalScale=Vector2(1,1) image.LocalPosition=Vector2(0,0)
		t.UIScale=Vector3(1,1,1)
		local size=entry.canvas*self:GetCustomPixelScale(portrait,desiredScale)
		if math.abs(t.RectSize.x-size)>0.001 then t.RectSize=Vector2(size,size) end
		local corner=_UILogic:WorldToScreenPosition(_UILogic:LocalUIToWorldPosition(Vector2(-size/2,-size/2),t))
		local parent=portrait.Parent.UITransformComponent
		local from=_UILogic:ScreenToLocalUIPosition(corner,parent)
		local to=_UILogic:ScreenToLocalUIPosition(Vector2(math.floor(corner.x+0.5),math.floor(corner.y+0.5)),parent)
		local v=t.anchoredPosition
		t.anchoredPosition=Vector2(v.x+to.x-from.x,v.y+to.y-from.y)
	end

	@ExecSpace("ClientOnly")
	method number GetCustomPixelScale(Entity portrait, number desiredScale)
		local t=portrait.UITransformComponent
		local a=_UILogic:ScreenToLocalUIPosition(Vector2(0,0),t)
		local b=_UILogic:ScreenToLocalUIPosition(Vector2(100,0),t)
		local ratio=100/math.max(0.001,math.abs(b.x-a.x))
		local pixel=math.max(1,math.floor(desiredScale*ratio+0.5))
		return pixel/ratio
	end

	@ExecSpace("ClientOnly")
	method table GetEquippedClientEntry()
		for _,entry in ipairs(self:GetPetCatalog()) do
			if entry.progress~=nil and entry.progress.Owned and entry.progress.Equipped then return entry end
		end
		for _,entry in ipairs(self:GetPetCatalog()) do if entry.progress~=nil and entry.progress.Owned then return entry end end
		return self:GetPetCatalog()[1]
	end

	-- Type ids match accessories: attack, critical chance, critical damage, HP, cooldown.
	method table GetPetStatLines(string petId, any pet)
		local level=pet~=nil and pet.Owned and pet.Level or 1
		local rank=pet~=nil and pet.Owned and pet.Rank or 0
		local kind=petId=="ttungttang" and 2 or (petId=="5000498" and 5 or (petId=="landturtle" and 4 or 1))
		local result={{kind=kind,level=1,unlocked=true,percent=self:GetBonusPercent(petId,level,rank)}}
		for _,at in ipairs(self.StatUnlockLevels) do
			local selected=pet~=nil and pet["Stat"..at] or 0
			local unlocked=level>=at and selected>=1 and selected<=5
			local value=unlocked and (self.StatBasePercent[selected]+(level-at)*self.StatGrowthPercent[selected]) or 0
			table.insert(result,{kind=unlocked and selected or 0,level=at,unlocked=unlocked,percent=value})
		end
		return result
	end

	method table GetPetStats(string petId, any pet)
		local out={atkPct=0,critRate=0,critDmg=0,hpPct=0,cooldown=0}
		local fields={"atkPct","critRate","critDmg","hpPct","cooldown"}
		for _,line in ipairs(self:GetPetStatLines(petId,pet)) do
			if line.unlocked then
				local key=fields[line.kind] local v=line.percent/100
				if line.kind==1 or line.kind==4 then out[key]=(1+out[key])*(1+v)-1
				else out[key]=out[key]+v end
			end
		end

		if self:GetPetGearDefinitionForPet(petId,"Cap")~=nil and pet~=nil and pet.Owned then
			local mask=pet.GearEquippedMask or 0
			if self:HasPetGearBit(mask,1) then out.critDmg=out.critDmg+0.10 end
			if self:HasPetGearBit(mask,2) then out.atkPct=(1+out.atkPct)*1.05-1 end
			if self:HasPetGearBit(mask,4) then out.critRate=out.critRate+0.05 end
		end
		out.cooldown=math.min(0.9,out.cooldown)
		return out
	end

	@ExecSpace("ClientOnly")
	method number GetLobbyStatBonus(integer kind)
		local entry=self:GetEquippedClientEntry() local pet=entry.progress
		if pet==nil or not pet.Owned or not pet.Equipped then return 0 end
		local fields={"atkPct","critRate","critDmg","hpPct","cooldown"}
		return self:GetPetStats(entry.id,pet)[fields[kind]] or 0
	end

	method number GetRunCritDamageBonus()
		return self.RunCritDamageBonus
	end

	method number GetRunMaxHpMult()
		return self.RunMaxHpMultiplier
	end

	method number GetRunCooldownReduction()
		return self.RunCooldownReduction
	end

	@ExecSpace("ServerOnly")
	method void UnlockPetStats(table record, string petId)
		local pet=record.pets[petId]
		if pet==nil or not pet.Owned then return end
		local changed=false
		for _,at in ipairs(self.StatUnlockLevels) do
			local key="Stat"..at
			if pet.Level>=at and pet[key]==0 then
				-- Only the type is rolled, once on the server; values follow fixed growth tables.
				pet[key]=_UtilLogic:RandomIntegerRange(1,5) changed=true
				log("[VRF] PET-STATS unlocked pet="..petId.." level="..at.." kind="..pet[key])
			end
		end
		if changed then self:MarkDirty(record) end
	end

	method number GetBonusPercent(string petId, integer level, integer rank)
		if petId=="oduck" then
			local r=math.max(0,math.min(3,rank))
			return self.OduckRankAttack[r+1]+math.max(0,level-r*10-1)*0.05
		end
		if petId=="landturtle" then
			local r=math.max(0,math.min(3,rank))
			return self.TurtleRankHp[r+1]+math.max(0,level-r*10-1)*0.2
		end
		if petId=="5000498" then
			local r=math.max(0,math.min(3,rank))
			return self.FoxRankCooldown[r+1]+math.max(0,level-r*10-1)*0.05
		end
		return self:GetDamagePercent(level,rank)
	end

	method number GetRunCritChanceBonus()
		return self.RunCritChanceBonus
	end

	@ExecSpace("ClientOnly")
	method number GetLobbyCritChanceBonus()
		return self:GetLobbyStatBonus(2)
	end

	method string GetPurchasedPetId(string productId)
		if productId==nil or productId=="" then return "" end
		for _,id in ipairs({"5002617","ttungttang","5000498","landturtle","oduck"}) do
			local entry=self:GetPetDefinition(id)
			if entry.productId~="" and entry.productId==productId then return id end
		end
		return ""
	end

	method string GetPetMessageKey(string petId, string key)
		if (petId~="ttungttang" and petId~="5000498" and petId~="landturtle" and petId~="oduck") or key==nil or key=="" then return key end
		local split=string.find(key,"|",1,true)
		local base=split~=nil and string.sub(key,1,split-1) or key
		local personalized={PET_PREVIEW=true,PET_COMING_SOON=true,PET_NO_PET=true,PET_TEST_NOTICE=true,PET_RANK_DONE=true,PET_LEVEL_DONE=true,PET_HATCH_DONE=true,PET_WALK_SEARCHING=true,PET_WALK_LOOT_SCROLL=true,PET_WALK_LOOT_DIAMOND=true,PET_WALK_LOOT_SKILL=true,PET_WALK_LOOT_RELIC=true,PET_WALK_TEST_FIND=true}
		if not personalized[base] then return key end
		return base..(petId=="oduck" and "_ODUCK" or (petId=="landturtle" and "_BUGI" or (petId=="5000498" and "_DUCKY" or "_TTUNGTTANG")))..(split~=nil and string.sub(key,split) or "")
	end

	@ExecSpace("ClientOnly")
	method table GetPetCatalog()
		local entries={}
		for _,id in ipairs({"5002617","ttungttang","5000498","landturtle","oduck"}) do
			local entry=self:GetPetDefinition(id)
			entry.progress=id=="5002617" and self.ClientPet or self.ClientPets[id]
			entry.ready=self.ClientReady and (id~="5000498" or self.FoxReady) and (id~="landturtle" or self.TurtleReady) and (id~="oduck" or self.OduckReady)
			table.insert(entries,entry)
		end
		return entries
	end

	method table GetCareConfig(string action)
		-- UI and server share every gain, cost and duration.
		if action == "feed" then return {affinity=8,energy=80,xp=16,need="Fullness",gain=35,fatigue=10,motion="eat",duration=3.8,label="PET_FULLNESS",full="PET_FULLNESS_FULL"} end
		if action == "wash" then return {affinity=10,energy=120,xp=24,need="Cleanliness",gain=40,fatigue=20,motion="chat",duration=4.5,label="PET_CLEANLINESS",full="PET_CLEANLINESS_FULL"} end
		if action == "walk" then return {affinity=12,energy=160,xp=32,need="Mood",gain=30,fatigue=25,motion="move",duration=self.WalkDuration,label="PET_MOOD",full="PET_MOOD_FULL"} end
		if action == "inject" then return {affinity=10,energy=100,xp=16,need="Health",gain=40,fatigue=15,motion="inject",duration=5.5,label="PET_HEALTH",full="PET_HEALTH_FULL"} end
		return nil
	end

	method string GetCareBlockReason(any pet, string action)
		-- Maximum needs cannot be farmed for XP or treasure, even through a direct RPC.
		local fatigue = pet.Fatigue or 0
		if action == "sleep" then return fatigue<=0 and "PET_NOT_TIRED" or "" end
		local heartTier=self:GetHeartTier(action)
		if heartTier>0 then return self:GetHeartBlockReason(pet,heartTier) end
		local choice = self:GetCareConfig(action)
		if choice == nil then return "" end
		if fatigue >= 100 then return "PET_TOO_TIRED" end
		if (pet[choice.need] or (action=="inject" and 100 or 0)) >= 100 then return choice.full end
		return ""
	end

	method number GetCareDuration(string action)
		if action == "sleep" then return self.SleepDuration end
		if self:GetHeartTier(action)>0 then return 2.8 end
		local choice = self:GetCareConfig(action)
		return choice ~= nil and choice.duration or 2.8
	end

	method integer GetMaxLevel(integer rank)
		-- Rank extends the cap without discarding the current level.
		return (math.max(0, math.min(3, rank)) + 1) * 10
	end

	method integer GetXPNeeded(integer level)
		-- A steady care curve; spending stones never purchases care XP.
		-- 2.5x of the old 40+12L (user 2026-10-13) so each level cap fills about when its rank-up stones (50/120/200) are ready.
		return 100 + level * 30
	end

	method number GetDamagePercent(integer level, integer rank)
		-- The supplied species has only damage as its innate combat stat.
		local r = math.max(0, math.min(3, rank))
		return self.RankDamage[r + 1] + math.max(0, level - r * 10 - 1) * 0.15
	end

	method number GetRunDamageMult()
		-- Snapshot at actual run start, so lobby care cannot alter an ongoing battle.
		return self.RunDamageMultiplier*(self.PetDuckBuffActive and (1+self.PetDuckDamageIncrease) or 1)
	end

	@ExecSpace("ClientOnly")
	method number GetLobbyDamageMult()
		return 1+self:GetLobbyStatBonus(1)
	end

	@ExecSpace("ServerOnly")
	method void CollectLoadKeys(table loadKeys)
		-- Join the existing player batch rather than issuing a separate login read.
		table.insert(loadKeys, self.StorageKey)
	end

	method table ReadAccount(table data)
		-- The old storage key is retained; v1 Guri data migrates without resetting progress.
		local guri=PetProgress() local dog=PetProgress() local fox=PetProgress() local turtle=PetProgress() local duck=PetProgress()
		local pets={ ["5002617"]=guri,ttungttang=dog,["5000498"]=fox,landturtle=turtle,oduck=duck }
		local migrated=false
		if data~=nil then
			if data.version==2 or data.version==3 or data.version==4 or data.version==5 or data.version==6 or data.version==7 then
				if type(data.pets)~="table" then return nil end
				for _,key in ipairs({"stones","heartDayKey","heartClaimedMask"}) do
					local value=data[key]
					if type(value)~="number" or value~=value or value==math.huge or value==-math.huge or value~=math.floor(value) then return nil end
				end
				if data.stones<0 or data.stones>1000000000 or data.heartDayKey<0 or data.heartDayKey>99991231 or data.heartClaimedMask<0 or data.heartClaimedMask>7 or type(data.equippedId)~="string" then return nil end
				for id,profile in pairs(data.pets) do
					if pets[id]==nil or type(profile)~="table" then return nil end
					-- V2 always writes complete profiles. Reject truncated saves instead of resetting progress.
					for key,default in pairs(pets[id]:Serialize()) do
						local value=profile[key]
						local optional=key=="Stat3" or key=="Stat6" or key=="Stat9" or (data.version<6 and (key=="GearOwnedMask" or key=="GearEquippedMask"))
						if not (optional and value==nil) and type(value)~=type(default) then return nil end
						if type(value)=="number" and (value~=value or value==math.huge or value==-math.huge or value~=math.floor(value)) then return nil end
					end
					if not pets[id]:Deserialize(profile) then return nil end
					if data.version<7 and id~="ttungttang" and (pets[id].GearOwnedMask~=0 or pets[id].GearEquippedMask~=0) then return nil end
				end
				if data.pets["5002617"]==nil or data.pets.ttungttang==nil or (data.version>=3 and data.pets["5000498"]==nil) or (data.version>=4 and data.pets.landturtle==nil) or (data.version>=5 and data.pets.oduck==nil) then return nil end
				if data.version<7 then migrated=true end
				local wallet=PetProgress()
				if not wallet:Deserialize({version=1,Stones=data.stones,HeartDayKey=data.heartDayKey,HeartClaimedMask=data.heartClaimedMask}) then return nil end
				guri.Stones=wallet.Stones guri.HeartDayKey=wallet.HeartDayKey guri.HeartClaimedMask=wallet.HeartClaimedMask
				local equipped=data.equippedId or ""
				if equipped~="" and (pets[equipped]==nil or not pets[equipped].Owned) then return nil end
				for id,pet in pairs(pets) do pet.Equipped=id==equipped and pet.Owned end
			elseif (data.version==nil or data.version==1) and guri:Deserialize(data) then migrated=true
			else return nil end
		end
		return {pet=guri,pets=pets,dirty=migrated,generation=migrated and 1 or 0,test=false,lastRequest=-100,responsePetId=""}
	end

	method void SyncShared(table record)
		for _,pet in pairs(record.pets or {}) do
			pet.Stones=record.pet.Stones pet.HeartDayKey=record.pet.HeartDayKey pet.HeartClaimedMask=record.pet.HeartClaimedMask
		end
	end

	method table SerializeAccount(table record)
		self:SyncShared(record)
		local pets={} local equipped=""
		for id,pet in pairs(record.pets) do
			pets[id]=pet:Serialize()
			if pet.Owned and pet.Equipped then equipped=id end
		end
		return {version=7,pets=pets,equippedId=equipped,stones=record.pet.Stones,heartDayKey=record.pet.HeartDayKey,heartClaimedMask=record.pet.HeartClaimedMask,focusId=record.responsePetId or ""}
	end

	@ExecSpace("ServerOnly")
	method boolean LoadFor(Entity player, table loadedData)
		local item=loadedData[self.StorageKey] local data=nil
		if item~=nil and item.Value~=nil and item.Value~="" then
			local ok,value=pcall(function() return _HttpService:JSONDecode(item.Value) end)
			if not ok or type(value)~="table" then log_error("PetLogic: invalid saved account; load aborted") return false end
			data=value
		end
		local record=self:ReadAccount(data)
		if record==nil then log_error("PetLogic: invalid or future pet account; load aborted") return false end
		local now=_DateTimeLogic:GetTimeElapsedWithoutOffset()
		for _,pet in pairs(record.pets) do
			if pet.EnergyAt==0 then pet.EnergyAt=now end
			if pet.NeedsAt==0 then pet.NeedsAt=now end
		end
		local id=player.PlayerComponent.UserId self.States[id]=record
		self:Recover(record,now) self:PushState(id,"","")
		return true
	end

	@ExecSpace("ServerOnly")
	method void SaveFor(Entity player, table saveData, table generations)
		-- Stamp this particular save; unconfirmed writes never clear dirty state.
		local record = self.States[player.PlayerComponent.UserId]
		if record == nil or not record.dirty or record.test then return end
		saveData[self.StorageKey] = _HttpService:JSONEncode(self:SerializeAccount(record))
		generations[self.StorageKey] = record.generation
	end

	@ExecSpace("ServerOnly")
	method void ConfirmSaveFor(Entity player, table succeeded, table generations)
		-- Ignore partial failures and changes that raced the asynchronous save.
		if not isvalid(player) then return end
		local record = self.States[player.PlayerComponent.UserId]
		if record == nil or record.test or generations[self.StorageKey] ~= record.generation then return end
		for _, key in ipairs(succeeded or {}) do
			if key == self.StorageKey then record.dirty = false return end
		end
	end

	@ExecSpace("ServerOnly")
	method void MarkDirty(table record)
		-- All persisted mutations advance their generation before a batch save.
		record.dirty = true
		record.generation = record.generation + 1
	end

	@ExecSpace("ServerOnly")
	method void Recover(table record, integer now)
		self:RefreshHeartDay(record)
		for id,pet in pairs(record.pets) do self:RecoverPet(record,pet,now) self:UnlockPetStats(record,id) end
		self:SyncShared(record)
	end

	@ExecSpace("ServerOnly")
	method void RecoverPet(table record, any pet, integer now)
		-- Calculate elapsed recovery only on access. Fatigue never decreases here or on login.
		if not pet.Owned then return end
		local steps = math.floor(math.max(0, now - pet.EnergyAt) / self.EnergyTickMilliseconds)
		local needSteps = math.floor(math.max(0, now - pet.NeedsAt) / 1800000)
		if steps > 0 then
			local before = pet.Energy
			pet.Energy = math.min(1000, pet.Energy + steps)
			pet.EnergyAt = pet.EnergyAt + steps * self.EnergyTickMilliseconds
			if pet.Energy ~= before then self:MarkDirty(record) end
		end
		if needSteps > 0 then
			-- Count neglected intervals analytically, including offline time, without a per-tick loop.
			local firstHungry = math.floor(math.max(0,pet.Fullness-30)/3)+1
			local firstDirty = math.floor(math.max(0,pet.Cleanliness-30)/2)+1
			local badSteps = math.max(0,needSteps-math.min(firstHungry,firstDirty)+1)
			pet.Affinity = math.max(0,(pet.Affinity or 0)-badSteps*5)
			pet.Health = math.max(0,(pet.Health or 100)-badSteps*4)
			pet.Fullness = math.max(0, pet.Fullness - needSteps * 3)
			pet.Cleanliness = math.max(0, pet.Cleanliness - needSteps * 2)
			pet.Mood = math.max(0, pet.Mood - needSteps * 2)
			pet.NeedsAt = pet.NeedsAt + needSteps * 1800000
			self:MarkDirty(record)
		end
	end

	@ExecSpace("ServerOnly")
	method void PushState(string userId, string motion, string message)
		local record=self.States[userId]
		if record==nil then return end
		self:ReceiveState(_HttpService:JSONEncode(self:SerializeAccount(record)),record.test,motion,self:GetPetMessageKey(record.responsePetId or "",message),userId)
	end

	@ExecSpace("Client")
	method void ReceiveState(string json, boolean test, string motion, string message)
		local ok,data=pcall(function() return _HttpService:JSONDecode(json) end)
		if not ok or type(data)~="table" then return end
		local record=self:ReadAccount(data)
		if record==nil then return end
		self:SyncShared(record)
		self.ClientPet=record.pet self.ClientPets=record.pets
		self.ClientMotionPetId=data.focusId or "5002617"
		self.ClientReady=true self.ClientTest=test self.ClientRevision=self.ClientRevision+1
		_PetUI:OnPetChanged(motion)
		if message~="" then _UIToast:ShowMessage(message) end
	end

	@ExecSpace("Server")
	method void RequestState()
		-- senderUserId is supplied by the engine, never accepted from the client.
		local record = self.States[senderUserId]
		if record == nil then return end
		local now = _DateTimeLogic:GetTimeElapsedWithoutOffset()
		if now - (record.lastRefresh or 0) < 1000 then return end
		record.lastRefresh = now
		self:Recover(record, now)
		self:PushState(senderUserId, "", "")
	end

	@ExecSpace("Server")
	method void RequestAction(string action)
		self:ApplyAction(senderUserId,"5002617",action)
	end

	@ExecSpace("Server")
	method void RequestPetAction(string petId, string action)
		self:ApplyAction(senderUserId,petId,action)
	end

	@ExecSpace("ServerOnly")
	method void ApplyAction(string userId, string petId, string action)
		-- Validate ownership, lobby, energy, cooldown and rank on the server.
		if self:GetPetDefinition(petId)==nil then return end
		local record = self.States[userId]
		if record == nil then return end
		local pet=record.pets[petId]
		if pet==nil then return end
		if self:GetCareConfig(action)==nil and self:GetHeartTier(action)==0 and action~="sleep" and action~="equip" and action~="rank" and action~="test" then return end
		local now=_DateTimeLogic:GetTimeElapsedWithoutOffset()
		if now<(record.busyUntil or 0) or record.claimingHeart or now-record.lastRequest<2800 then return end
		record.responsePetId=petId
		if _GameManager.GameStarted and not _GameManager.GameOver then self:PushState(userId,"","PET_BATTLE_LOCKED") return end
		if action=="test" then
			if not Environment:IsMakerPlay() or pet.Owned then return end
			local preview=self:ReadAccount(self:SerializeAccount(record))
			preview.test=true preview.dirty=false preview.generation=0 preview.responsePetId=petId preview.lastRequest=now preview.busyUntil=now+2800
			local hatch=preview.pets[petId]
			hatch.Owned=true hatch.Equipped=true hatch.Fullness=50 hatch.Cleanliness=50 hatch.Mood=50 hatch.Fatigue=0 hatch.Health=60 hatch.Affinity=0
			hatch.EnergyAt=now hatch.NeedsAt=now
			-- 임시 부화는 메이커 전용 미리보기다. 새 플레이에서도 전용 장비를 바로 시험할 수 있게 같이 지급한다.
			if self:GetPetGearDefinitionForPet(petId,"Cap")~=nil then
				hatch.GearOwnedMask=7 hatch.GearEquippedMask=7
			end
			preview.pet.Stones=100 preview.pet.HeartDayKey=0 preview.pet.HeartClaimedMask=0
			for id,other in pairs(preview.pets) do if id~=petId then other.Equipped=false end end
			self.States[userId]=preview self:PushState(userId,"love","PET_TEST_NOTICE")
			log("[VRF] PET-CATALOG temporary hatch="..petId)
			return
		end
		if not pet.Owned then self:PushState(userId,"what","PET_NO_PET") return end
		record.lastRequest=now
		self:Recover(record, now)
		local heartTier=self:GetHeartTier(action)
		if heartTier>0 then self:ClaimHeartReward(userId,record,now,heartTier,pet) return end
		if action == "equip" then
			pet.Equipped = not pet.Equipped
			if pet.Equipped then for id,other in pairs(record.pets) do if id~=petId then other.Equipped=false end end end
			self:MarkDirty(record) self:PushState(userId, "love", "") return
		end
		if action == "rank" then
			local cost = self.RankCosts[pet.Rank + 1]
			if cost == nil or pet.Level < self:GetMaxLevel(pet.Rank) then
				self:PushState(userId, "what", "PET_RANK_LEVEL") return
			end
			if record.pet.Stones < cost then self:PushState(userId, "what", "PET_STONES_SHORT") return end
			record.pet.Stones = record.pet.Stones - cost pet.Rank = pet.Rank + 1
			self:MarkDirty(record) self:PushState(userId, "love", "PET_RANK_DONE") return
		end
		local blocked = self:GetCareBlockReason(pet,action)
		if blocked ~= "" then self:PushState(userId,"what",blocked) return end
		if action == "sleep" then
			-- Energy still recharges with time; only actual sleep removes fatigue.
			record.busyUntil = now + self.SleepDuration*1000
			pet.Fatigue = math.max(0,pet.Fatigue-self.SleepFatigueRecovery)
			pet.Energy = math.min(1000,pet.Energy+self.SleepEnergyRecovery)
			pet.SleepUntil = 0
			self:AddCareAffinity(pet,6)
			self:MarkDirty(record) self:PushState(userId,"sleep","PET_REST_DONE") return
		end
		local choice = self:GetCareConfig(action)
		if choice == nil then return end
		if pet.Energy < choice.energy then self:PushState(userId,"hungry","PET_ENERGY_SHORT") return end
		if action == "walk" and not record.test then
			local player = _UserService:GetUserEntityByUserId(userId)
			if not isvalid(player) or not player.PlayerDBManager.IsLoadSuccess or not _AttendanceLogic:IsRequestOwner(userId) or _GameManager._diamondStorage == nil then
				self:PushState(userId,"what","PET_LOADING") return
			end
		end
		record.busyUntil = now + choice.duration*1000
		pet.Energy = pet.Energy - choice.energy
		pet.EnergyAt = now
		pet[choice.need] = math.min(100,pet[choice.need]+choice.gain)
		pet.Fatigue = math.min(100,(pet.Fatigue or 0)+choice.fatigue)
		if action == "walk" then
			pet.Fullness = math.max(0,pet.Fullness-15)
			pet.Cleanliness = math.max(0,pet.Cleanliness-20)
		end
		self:AddCareAffinity(pet,choice.affinity or 0)
		pet.XP = pet.XP + choice.xp
		local levelBefore = pet.Level
		while pet.Level < self:GetMaxLevel(pet.Rank) and pet.XP >= self:GetXPNeeded(pet.Level) do
			pet.XP = pet.XP - self:GetXPNeeded(pet.Level) pet.Level = pet.Level + 1
		end
		if pet.Level >= self:GetMaxLevel(pet.Rank) then pet.XP = 0 end
		self:UnlockPetStats(record,petId)
		self:MarkDirty(record)
		local message = ""
		if pet.Level > levelBefore then message = "PET_LEVEL_DONE" end
		if action == "walk" then self:BeginWalk(userId,record,now) end
		self:PushState(userId, choice.motion, message)
		if action == "walk" and not record.test then _GameManager:PersistRewardNow(userId) end
	end



	method void AddCareAffinity(any pet, integer amount)
		-- Recovery must address hunger/dirt first; poor care cannot farm affection rewards.
		if pet.Fullness>=30 and pet.Cleanliness>=30 and (pet.Health or 100)>=30 then
			pet.Affinity=math.min(100,(pet.Affinity or 0)+amount)
		end
	end

	method integer GetHeartTier(string action)
		if action=="heart1" then return 1 end
		if action=="heart2" then return 2 end
		if action=="heart3" then return 3 end
		return 0
	end

	method boolean IsHeartClaimed(any pet, integer tier)
		if tier<1 or tier>3 then return false end
		return math.floor((pet.HeartClaimedMask or 0)/(2^(tier-1)))%2==1
	end

	method string GetHeartBlockReason(any pet, integer tier)
		if tier<1 or tier>3 then return "PET_HEART_NOT_READY" end
		if self:IsHeartClaimed(pet,tier) then return "PET_HEART_ALREADY_CLAIMED" end
		return (pet.Affinity or 0)<self.HeartThresholds[tier] and "PET_HEART_NOT_READY" or ""
	end

	@ExecSpace("ServerOnly")
	method void RefreshHeartDay(table record)
		-- Match attendance's KST calendar. Affection persists; only daily claims reset.
		if record.claimingHeart then return end
		local today=_AttendanceLogic:GetTodayKey()
		if (record.pet.HeartDayKey or 0)~=today then
			record.pet.HeartDayKey=today record.pet.HeartClaimedMask=0
			self:MarkDirty(record)
		end
	end

	@ExecSpace("ServerOnly")
	method void ClaimHeartReward(string userId, table record, integer now, integer tier, any pet)
		local blocked=self:GetHeartBlockReason(pet,tier)
		if blocked~="" then self:PushState(userId,"what",blocked) return end
		local player=nil
		if not record.test then
			player=_UserService:GetUserEntityByUserId(userId)
			if not isvalid(player) or not player.PlayerDBManager.IsLoadSuccess or not _AttendanceLogic:IsRequestOwner(userId) or _GameManager._diamondStorage==nil then
				self:PushState(userId,"what","PET_LOADING") return
			end
		end
		-- Lock all three rewards before a yielding grant. Failed delivery never marks a claim.
		if record.claimingHeart then return end
		record.claimingHeart=true record.busyUntil=now+2800
		if tier==2 and not record.test then
			local param=ItemCreateParamStruct() param:Set(self.HeartScrollItemId,5,0) param.IsIgnoreInvenCapacity=false
			local code=_ItemFactoryLogic:TryAddItem(userId,param,ItemCreateResultStruct())
			if code~=_ErrorCodeEnum.Success then
				record.claimingHeart=false self:PushState(userId,"what","UI_MONTHLY_ATTENDANCE_INVENTORY_FULL") return
			end
		elseif tier==3 and not record.test then _GameManager:AddDiamond(100)
		elseif tier==1 then record.pet.Stones=record.pet.Stones+3 end
		record.pet.HeartClaimedMask=(record.pet.HeartClaimedMask or 0)+2^(tier-1)
		self:MarkDirty(record)
		self:PushState(userId,"gift",record.test and "PET_HEART_TEST" or ("PET_HEART_REWARD_"..tostring(tier)))
		if not record.test then _GameManager:PersistRewardNow(userId) end
		record.claimingHeart=false
		log("[VRF] PET-HEART daily claim="..tostring(tier).." day="..tostring(pet.HeartDayKey).." mask="..tostring(pet.HeartClaimedMask).." preview="..tostring(record.test))
	end

	@ExecSpace("ServerOnly")
	method table RollWalkLoot()
		-- One roll per server-approved walk; 70/20/10 are conditional on finding treasure.
		local roll = _UtilLogic:RandomIntegerRange(1,100)
		if roll <= 70 then
		 local id = 510000 + _UtilLogic:RandomIntegerRange(1,5)
		 local data = _ItemDataLogic:GetData(id)
		 return {kind="scroll",itemId=id,amount=1,icon=data.RUID,message="PET_WALK_LOOT_SCROLL"}
		elseif roll <= 90 then
		 local amount = _UtilLogic:RandomIntegerRange(5,10)
		 return {kind="diamond",amount=amount,icon="81462aeb825b4660991cef05651271cf",message="PET_WALK_LOOT_DIAMOND|"..amount}
		end
		local skill = _UtilLogic:RandomIntegerRange(0,1)==1
		return {kind="ticket",skill=skill,amount=1,icon=skill and "38f5f4b9b8a342bf931b71298d60bb84" or "3fccc38bffbd45b68cd1fc049809de54",message=skill and "PET_WALK_LOOT_SKILL" or "PET_WALK_LOOT_RELIC"}
	end

	@ExecSpace("ServerOnly")
	method void BeginWalk(string userId, table record, integer now)
		-- Reserve the entire walk before any yielding grant/save; closing the UI cannot reroll it.
		record.busyUntil = now + self.WalkDuration*1000
		record.walkToken = (record.walkToken or 0)+1
		record.walkRoute = (record.walkRoute or 0)%3+1
		local found = _UtilLogic:RandomDouble()<self.WalkFindChance
		local icon = "" local message = ""
		if found then
		 local reward = self:RollWalkLoot()
		 icon = reward.icon message = reward.message
		 -- Preview pets show the encounter without altering the real account wallet.
		 if record.test then message="PET_WALK_TEST_FIND"
		 elseif reward.kind=="scroll" then
		  local param = ItemCreateParamStruct() param:Set(reward.itemId,1,0)
		  param.IsIgnoreInvenCapacity = false
		  local code = _ItemFactoryLogic:TryAddItem(userId,param,ItemCreateResultStruct())
		  if code~=_ErrorCodeEnum.Success then icon="" message="UI_MONTHLY_ATTENDANCE_INVENTORY_FULL" end
		 elseif reward.kind=="diamond" then _GameManager:AddDiamond(reward.amount)
		 else _AttendanceLogic:AddFreePulls(1,reward.skill) end
		 log("[VRF] PET-WALK reward kind="..reward.kind.." amount="..reward.amount.." preview="..tostring(record.test))
		end
		-- Grant before announcing the animation so closing/disconnecting never discards earned loot.
		self:ReceiveWalkPlan(record.walkToken,record.walkRoute,found,icon,self:GetPetMessageKey(record.responsePetId or "",message),userId)
		log("[VRF] PET-WALK approved route="..record.walkRoute.." found="..tostring(found))
	end

	@ExecSpace("Client")
	method void ReceiveWalkPlan(integer token, integer route, boolean found, string icon, string message)
		_PetHouseUI:SetWalkPlan(token,route,found,icon,message)
	end

	@ExecSpace("ServerOnly")
	method boolean GrantPurchasedPet(string userId)
		return self:GrantPurchasedSpecies(userId,"5002617")
	end

	@ExecSpace("ServerOnly")
	method boolean GrantPurchasedSpecies(string userId, string petId)
		local player=_UserService:GetUserEntityByUserId(userId) local record=self.States[userId]
		if self:GetPetDefinition(petId)==nil or not isvalid(player) or record==nil or record.test or not player.PlayerDBManager.IsLoadSuccess then return false end
		local pet=record.pets[petId] if pet==nil then return false end
		if not pet.Owned then
			pet.Owned=true pet.Equipped=true
			for id,other in pairs(record.pets) do if id~=petId then other.Equipped=false end end
			pet.EnergyAt=_DateTimeLogic:GetTimeElapsedWithoutOffset() pet.NeedsAt=pet.EnergyAt
			self:MarkDirty(record)
		end
		if record.dirty and not player.PlayerDBManager:SavePetPurchaseAndWait() then return false end
		record.responsePetId=petId self:PushState(userId,"love","PET_HATCH_DONE")
		return true
	end

	@ExecSpace("ServerOnly")
	method void InitForRun(string userId)
		self:ResetOduckBuff()
		self.RunPetId="" self._T.petSkillCast=nil self._T.petSkillCooldown=self.PetSkillInterval
		-- Snapshot all four equipped pet rows at actual run start. Continue keeps them.
		self.RunPetGearMask=0
		self.RunToken=self.RunToken+1 self.RunUserId=userId self.RunPaidEnergy=0		self.RunDamageMultiplier=1 self.RunCritChanceBonus=0 self.RunCritDamageBonus=0 self.RunMaxHpMultiplier=1 self.RunCooldownReduction=0
		local record=self.States[userId] if record==nil then return end
		for id,pet in pairs(record.pets) do
			if pet.Owned and pet.Equipped then
				self.RunPetId=id
				self:UnlockPetStats(record,id)
				local stats=self:GetPetStats(id,pet)
				self.RunPetGearMask=pet.GearEquippedMask or 0
				self.RunDamageMultiplier=1+stats.atkPct self.RunCritChanceBonus=stats.critRate
				self.RunCritDamageBonus=stats.critDmg self.RunMaxHpMultiplier=1+stats.hpPct self.RunCooldownReduction=stats.cooldown
			end
		end
		log("[VRF] PET-STATS run damage="..self.RunDamageMultiplier.." crit="..self.RunCritChanceBonus.." critDamage="..self.RunCritDamageBonus.." hp="..self.RunMaxHpMultiplier.." cooldown="..self.RunCooldownReduction)
	end

	@ExecSpace("ServerOnly")
	method void SettleRun(integer score, number seconds)
		-- Pay run energy (increase only, even after continue) and save stones dropped since the last save.
		-- Stones no longer come from the score (user 2026-10-13): monsters drop them instead (TryDropStone).
		local record = self.States[self.RunUserId]
		if record == nil then return end
		local energyGain = self:SettleRunEnergy(record, score)
		if self.RunUnsavedStones <= 0 and energyGain <= 0 then return end
		self.RunUnsavedStones = 0
		self:MarkDirty(record) self:PushState(self.RunUserId, "", "")
		local player = _UserService:GetUserEntityByUserId(self.RunUserId)
		if isvalid(player) then player.PlayerDBManager:SaveToDB(false) end
	end

	@ExecSpace("ServerOnly")
	method integer SettleRunEnergy(table record, integer score)
		-- Score -> energy for the pet that joined this run (ScorePerEnergy points = 1). Continue pays only the increase.
		local earned = math.floor(math.max(0, score) / self.ScorePerEnergy)
		local delta = earned - self.RunPaidEnergy
		if delta <= 0 or self.RunPetId == "" then return 0 end
		local pet = record.pets[self.RunPetId]
		if pet == nil or not pet.Owned then return 0 end
		-- Bank elapsed recovery first so the 1000 cap does not swallow pending regen.
		self:RecoverPet(record, pet, _DateTimeLogic:GetTimeElapsedWithoutOffset())
		self.RunPaidEnergy = earned
		local before = pet.Energy
		pet.Energy = math.min(1000, pet.Energy + delta)
		log("[VRF] PET-ENERGY run pet="..self.RunPetId.." score="..score.." +"..delta.." energy "..before.."->"..pet.Energy)
		-- Show the actual gain (after the cap) in the game-over loot list.
		_RunLootLogic:AddEnergy(pet.Energy - before)
		return pet.Energy - before
	end

	@ExecSpace("ServerOnly")
	method void TryDropStone(Vector3 worldPos, number fallHeight, number groundWorldY, number dropScale)
		-- Every monster kill on every map rolls StoneDropChance; the stone flies to the bag, then joins the account wallet.
		if _GameManager.GameOver or self.RunUserId == "" then return end
		if _UtilLogic:RandomDouble() >= self.StoneDropChance then return end
		local userId = self.RunUserId
		_GameManager:ScheduleLootDrop(worldPos, self.StoneIcon, fallHeight, groundWorldY, function()
			local record = self.States[userId]
			if record == nil then return end
			record.pet.Stones = record.pet.Stones + 1
			self.RunUnsavedStones = self.RunUnsavedStones + 1
			self:MarkDirty(record) self:PushState(userId, "", "")
			_RunLootLogic:AddPetStone(self.StoneIcon)
			log("[VRF] PET-STONE drop +1 total="..record.pet.Stones)
		end, dropScale)
	end

	@ExecSpace("ServerOnly")
	method void SettleGameOver()
		-- Reconcile late loot once without letting an old timer pay into a new run.
		self:SettleRun(_GameManager:CalcRunScore(), _GameManager.RunElapsedSec)
		local token = self.RunToken
		_TimerService:SetTimerOnce(function()
			if token == self.RunToken and _GameManager.GameOver then
				self:SettleRun(_GameManager:CalcRunScore(), _GameManager.RunElapsedSec)
			end
		end, 1)
	end

	@ExecSpace("ClientOnly")
	method ItemStruct GetStoneInventoryItem()
		-- Read-only currency slot: account stones share the pet save and cannot be sold or discarded.
		if not self.ClientReady or self.ClientPet.Stones <= 0 then return nil end
		local item = ItemStruct()
		item.GUID = "pet-evolution-stone" item.ItemId = self.StoneItemId item.Count = self.ClientPet.Stones
		return item
	end


	-- Combat-only timer: no wall-clock timers, so card choices and modal pauses freeze the skill.
	method void OnUpdate(number delta)
		if self:IsClient() then self:WarmPetCharmRenderPool(delta);self:WarmNativePetGearWorldPool(delta);self:UpdatePetSkillVisual(delta) return end
		self:UpdateOduckBuff(delta)
		if not _GameManager.GameStarted or _GameManager.GameOver then self._T.petSkillCast=nil return end
		if self.RunPetId=="" then return end
		local cast=self._T.petSkillCast
		if cast~=nil and cast.zone~=_MapManager.CurrentMapIndex then self._T.petSkillCast=nil cast=nil end
		if _GameManager:IsGamePaused() or _GameManager.SafeAreaFrozen or _MapManager.AwayOnSideMap then return end
		if cast~=nil then self:TickPetSkillCast(math.max(0,delta)) end
		self._T.petSkillCooldown=math.max(0,(self._T.petSkillCooldown or self.PetSkillInterval)-math.max(0,delta))
		if self._T.petSkillCooldown<=0 and self._T.petSkillCast==nil then self:TryCastPetSkill() end
	end

	@ExecSpace("ServerOnly")
	method boolean TryCastPetSkill()
		if self.RunPetId=="" or not _GameManager.GameStarted or _GameManager.GameOver or _GameManager:IsGamePaused() or _GameManager.SafeAreaFrozen or _MapManager.AwayOnSideMap then return false end
		if self._T.petSkillCast~=nil then return false end
		local map=_CardManager:GetCurrentMap() if not isvalid(map) then return false end
		local mobs=_CardManager:GetMonstersInCurrentZone(map) local targets={}
		for _,m in ipairs(mobs) do
			if isvalid(m) and isvalid(m.Entity) and not m._dead and not m._neverAttacks and not m._transformLocked and not m._openingSummonLock then
				if self.RunPetId~="5002617" or (not m._isFlying and not m._isBonusBoss) then table.insert(targets,m) end
			end
		end
		if #targets==0 and self.RunPetId~="oduck" then return false end
		local route={}
		if self.RunPetId=="5002617" then
			table.sort(targets,function(a,b) return a._currentScale>b._currentScale end)
			local first=targets[1].Entity.TransformComponent.WorldPosition
			table.insert(route,{x=_MonsterSpawner:GetZoneOffsetX(_MapManager.CurrentMapIndex),y=first.y+0.4,z=first.z-0.1})
			for i=1,math.min(6,#targets) do local p=targets[i].Entity.TransformComponent.WorldPosition table.insert(route,{x=p.x,y=p.y+0.4,z=p.z-0.1}) end
		end
		local centerX=_MonsterSpawner:GetZoneOffsetX(_MapManager.CurrentMapIndex)
		local root=_EntityService:GetEntityByPath("/maps/".._MapManager:GetMapName(_MapManager.CurrentMapIndex))
		local anchor=Vector3(centerX,_MonsterSpawner:GetBottomGroundY(root,centerX),0.3)
		self.PetSkillCastSerial=self.PetSkillCastSerial+1
		self._T.petSkillCooldown=self.PetSkillInterval
		self._T.petSkillCast={id=self.RunPetId,serial=self.PetSkillCastSerial,zone=_MapManager.CurrentMapIndex,age=0,roared=false,scan=0,anchor=anchor,hit={},route=route}
		if self.RunPetId=="oduck" then
			self.PetDuckBuffRemaining=self.PetDuckBuffDuration self.PetDuckBuffActive=true
			self:NotifyOduckBuff(self.PetDuckBuffDuration,self.RunUserId)
			log("[VRF] PET-ODUCK dance buff +20% duration="..self.PetDuckBuffDuration)
		end
		local routeJSON=#route>0 and _HttpService:JSONEncode(route) or "[]"
		self:StartPetSkillVisual(self.RunPetId,_MapManager.CurrentMapIndex,self.RunToken,routeJSON,anchor,self.PetSkillCastSerial,self.RunPetGearMask,self.RunUserId)
		log("[VRF] PET-SKILL cast pet="..self.RunPetId.." zone=".._MapManager.CurrentMapIndex.." interval="..self.PetSkillInterval)
		return true
	end

	method Vector3 SamplePetRollRoute(table route, number elapsed)
		if route==nil or #route==0 then return Vector3.zero end
		if #route==1 then local p=route[1] return Vector3(p.x,p.y,p.z) end
		local v=math.min(1,math.max(0,elapsed/self.PetRollDuration))*(#route-1)
		local index=math.min(#route-1,math.floor(v)+1) local f=math.min(1,v-(index-1))
		local a=route[index] local b=route[index+1]
		return Vector3(a.x+(b.x-a.x)*f,a.y+(b.y-a.y)*f,a.z+(b.z-a.z)*f)
	end

	method number GetPetRollGroundOffset(number rotation)
		-- Opaque sprite bounds at each angle keep the rolling body on the ground.
		local values=self.PetRollGroundOffsets local angle=(rotation%360)/360*#values
		local base=math.floor(angle) local f=angle-base
		return values[base+1]*(1-f)+values[(base+1)%#values+1]*f
	end

	@ExecSpace("ClientOnly")
	method Vector3 GetPetCharmBodyPosition(table visual, integer index, number width, number jump)
		local p=visual.center local pixel=math.max(0.000001,visual.pixel)
		local origin=_UILogic:ScreenToWorldPosition(Vector2(0,0))
		local y=p.y+width*self.PetCharmJumpFeet[index]+jump
		-- Preserve the requested size. Snap the head's immutable source-pixel
		-- reference to the screen, so its ink cannot shimmer with fractional motion.
		local left=p.x-width*0.5
		local x=origin.x+math.floor((left-origin.x)/pixel+0.5)*pixel+width*0.5
		local headTop=y+width*0.5-self.PetCharmJumpNods[index]*width/128
		local snapped=origin.y+math.floor((headTop-origin.y)/pixel+0.5)*pixel
		return Vector3(x,y+snapped-headTop,p.z)
	end

	method integer GetPetCharmJumpFrameIndex(number elapsed)
		local phase=math.max(0,elapsed)%self.PetCharmJumpPeriod local index=1
		for i=2,#self.PetCharmJumpFrameTimes do
			if phase<self.PetCharmJumpFrameTimes[i] then break end
			index=i
		end
		return index
	end

	method number GetPetCharmJumpHeight(number elapsed)
		local phase=math.max(0,elapsed)%self.PetCharmJumpPeriod
		if phase<=self.PetCharmLaunchTime or phase>=0.64 then return 0 end
		local u=(phase-self.PetCharmLaunchTime)/(0.64-self.PetCharmLaunchTime)
		return 4*0.34*u*(1-u)
	end

	@ExecSpace("ServerOnly")
	method void TickPetSkillCast(number delta)
		local cast=self._T.petSkillCast if cast==nil then return end
		if cast.zone~=_MapManager.CurrentMapIndex then self._T.petSkillCast=nil return end
		cast.age=cast.age+delta
		local map=_CardManager:GetCurrentMap() if not isvalid(map) then self._T.petSkillCast=nil return end
		local mobs=_CardManager:GetMonstersInCurrentZone(map)
		if cast.id=="ttungttang" then
			cast.scan=cast.scan-delta
			if cast.age>=self.PetCharmLaunchTime and cast.age<self.PetCharmPresence and cast.scan<=0 then
				cast.scan=0.08 local count=0
				-- Each enemy is acquired once; later spawns are included until the pet leaves.
				for _,m in ipairs(mobs) do
					if isvalid(m) and isvalid(m.Entity) and not m._dead and not cast.hit[m] and m:ApplyCharm(self.PetCharmDuration,cast.anchor) then
						cast.hit[m]=true count=count+1
					end
				end
				if count>0 then log("[VRF] PET-SKILL charm attracted="..count.." age="..cast.age.." x="..cast.anchor.x.." normal="..self.PetCharmDuration.." bossElite="..self.PetCharmDuration*0.5) end
				cast.roared=true
			end
			-- Keep the pet visible until the last affected living enemy loses charm.
			if cast.roared then
				local active=0
				for m,_ in pairs(cast.hit) do
					if isvalid(m) and isvalid(m.Entity) and not m._dead and m.CharmActive and m.CharmZone==cast.zone then active=active+1 end
				end
				if active==0 then
					self:EndPetSkillVisual(cast.id,cast.zone,self.RunToken,cast.serial,self.RunUserId)
					self._T.petSkillCast=nil
					log("[VRF] PET-SKILL all charms ended age="..cast.age.." serial="..cast.serial)
				end
			end
		elseif cast.id=="5000498" then
			if cast.age>=self.PetCharmWindup and not cast.roared then
				cast.roared=true local count=0
				for _,m in ipairs(mobs) do
					if isvalid(m) and isvalid(m.Entity) and not m._dead and not m._neverAttacks and not m._transformLocked and not m._openingSummonLock then
						m:ApplyStun(self.PetFoxStunDuration,true) cast.hit[m]=true count=count+1
					end
				end
				log("[VRF] PET-FOX roar stunned="..count.." duration="..self.PetFoxStunDuration)
			end
			if cast.age>=self.PetFoxRoarDuration then self._T.petSkillCast=nil end
		elseif cast.id=="oduck" then
			if cast.age>=self.PetDuckDanceDuration then
				self:EndPetSkillVisual(cast.id,cast.zone,self.RunToken,cast.serial,self.RunUserId)
				self._T.petSkillCast=nil
			end
		elseif cast.id=="landturtle" then
			if cast.age>=self.PetTurtleDropTime and not cast.roared then
				cast.roared=true cast.absorbed=0
				log("[VRF] PET-TURTLE landed shield="..self.PetTurtleShieldDuration.." zone="..cast.zone)
			end
			if cast.age>=self.PetTurtleDropTime+self.PetTurtleShieldDuration then
				self:EndPetSkillVisual(cast.id,cast.zone,self.RunToken,cast.serial,self.RunUserId)
				self._T.petSkillCast=nil
				log("[VRF] PET-TURTLE shield ended age="..cast.age.." absorbed="..(cast.absorbed or 0))
			end
		else
			local p=self:SamplePetRollRoute(cast.route,cast.age)
			for _,m in ipairs(mobs) do
				if isvalid(m) and isvalid(m.Entity) and not m._dead and not m._isFlying and not m._isBonusBoss and not cast.hit[m] then
					local mp=m.Entity.TransformComponent.WorldPosition local dx=mp.x-p.x local dy=mp.y+0.4-p.y
					if dx*dx+dy*dy<=1.21 then
						cast.hit[m]=true local scale=_CardManager.Card122KnockbackScale
						if m._isBoss or m._isElite then scale=m._currentScale-(m._currentScale-scale)*0.5 end
						m:ApplyKnockback(scale)
						log("[VRF] PET-SKILL roll contact entity="..m.Entity.Name.." scale="..scale)
					end
				end
			end
			if cast.age>=self.PetRollDuration then self._T.petSkillCast=nil log("[VRF] PET-SKILL roll finished duration="..self.PetRollDuration) end
		end
	end

	@ExecSpace("ClientOnly")
	method table GetPetSkillInfo(string petId)
		local locale=string.lower(_LocalizationService.CurrentLocaleId or "ko") local language=string.sub(locale,1,2)
		local texts={
			ko={"데굴데굴","매혹","포효","60초마다 자동 발동","4초 동안 몬스터 사이를 굴러가며\n넉백시킵니다.","2초 동안 몬스터를 유인합니다.\n매혹: 일반 3초, 보스·엘리트 1.5초.\n모든 매혹이 풀리면 퇴장합니다.","여우 모양의 포효를 내뿜어\n화면의 몬스터를 2초간 기절시킵니다."},
			en={"Roll Over","Charm","Roar","Auto-cast every 60s","Roll between enemies for 4s,\nknocking them back.","Lure enemies for 2s. Charm lasts 3s\n(1.5s for bosses/elites). Leaves when\nall affected enemies are free.","Unleash a fox-shaped roar to stun\nenemies on screen for 2s."},
			ja={"ころころ","魅了","咆哮","60秒ごとに自動発動","4秒間、敵の間を転がって\nノックバックさせます。","2秒間、敵を引き寄せます。魅了は\n通常3秒、ボス・エリート1.5秒。\nすべての魅了解除で退場します。","キツネ形の咆哮を放ち、画面内の\n敵を2秒間気絶させます。"},
			zh={"滚滚滚","魅惑","咆哮","每60秒自动施放","在敌人之间滚动并击退敌人，\n持续4秒。","引诱敌人2秒。魅惑持续3秒，\n首领和精英持续1.5秒。\n全部解除魅惑后离场。","释放狐狸形状的咆哮，\n使画面内的敌人眩晕2秒。"}
		}
		if petId=="oduck" then
			local t={ko={"댄스 타임","춤을 추며 30초 동안\n대미지가 20% 증가합니다."},en={"Dance Time","Dance to increase damage by 20%\nfor 30 seconds."},ja={"ダンスタイム","ダンスで30秒間、\nダメージが20%増加します。"},zh={"舞蹈时间","跳舞使伤害增加20%，\n持续30秒。"}}
			local v=t[language] or t.en
			return {name=v[1],interval=(texts[language] or texts.en)[4],description=v[2],icon=self.PetDuckIconRUID}
		end
		if petId=="landturtle" then
			local shellTexts={
				ko={"껍질 방패","중앙에 껍질이 떨어져 3초 동안\n몬스터 공격을 대신 받아줍니다."},
				en={"Shell Shield","A shell lands in the center and takes\nenemy attacks for you for 3s."},
				ja={"甲羅の盾","中央に甲羅が落ち、3秒間\n敵の攻撃を代わりに受けます。"},
				zh={"龟壳护盾","龟壳落在中央，替你承受\n怪物攻击，持续3秒。"}}
			local t=shellTexts[language] or shellTexts.en
			return {name=t[1],interval=(texts[language] or texts.en)[4],description=t[2],icon=self.PetTurtleShellRUID}
		end
		local t=texts[language] or texts.en local kind=petId=="ttungttang" and 2 or (petId=="5000498" and 3 or 1)
		local icons={self.PetRollIconRUID,self.PetCharmIconRUID,self.PetFoxIconRUID}
		return {name=t[kind],interval=t[4],description=t[4+kind],icon=icons[kind]}
	end

	@ExecSpace("ClientOnly")
	method void ClearPetCharmRenderPool()
		local pool=self._T.petCharmRenderPool
		if pool~=nil then
			for _,list in ipairs({pool.bodies,pool.waves,pool.hearts,pool.gear or {}}) do
				for _,actor in ipairs(list) do if isvalid(actor) then actor:Destroy() end end
			end
		end
		self._T.petCharmRenderPool=nil
	end

	@ExecSpace("ClientOnly")
	method boolean PlacePetCharmSprite(Entity fx, Vector3 pos, number width, number rotation, number alpha)
		if not isvalid(fx) then return false end
		local metrics=_CardManager:GetSpriteMetrics(fx.SpriteRendererComponent.SpriteRUID)
		if metrics.w<=0 or metrics.h<=0 then fx.Enable=false;fx.SpriteRendererComponent.Color=Color(1,1,1,0);return false end
		_MonsterProjectileFx:PlaceVisual(fx,metrics,pos,width/metrics.w,rotation)
		fx.SpriteRendererComponent.Color=Color(1,1,1,math.max(0,math.min(1,alpha)))
		-- Keep the renderer alive even in its transparent pose; never reactivate on a swap.
		fx.Enable=true
		return true
	end

	@ExecSpace("ClientOnly")
	method void WarmPetCharmRenderPool(number delta)
		local player=_UserService.LocalPlayer
		local map=isvalid(player) and player.CurrentMap or nil
		if not isvalid(map) or not self.PetCharmJumpReady or not self.PetGearReady then return end
		local pool=self._T.petCharmRenderPool
		if pool~=nil and (pool.map~=map or not isvalid(pool.map)) then self:ClearPetCharmRenderPool();pool=nil end
		if pool==nil then
			pool={map=map,bodies={},waves={},hearts={},gear={},gearByRUID={},warmFrames=0,warmElapsed=0,creating=true,warming=true,ready=false}
			self._T.petCharmRenderPool=pool
			for _,ruid in ipairs(self.PetCharmJumpRUIDs) do table.insert(pool.bodies,self:SpawnPetSkillSprite(ruid,map,132)) end
			for i=1,6 do table.insert(pool.waves,self:SpawnPetSkillSprite(self.PetCharmWaveRUID,map,130)) end
			for i=1,16 do table.insert(pool.hearts,self:SpawnPetSkillSprite(self.PetCharmHeartRUID,map,131)) end
			for _,base in ipairs(self.PetCharmJumpRUIDs) do
				local layers=self.PetGearOverlays[base]
				for order,slot in ipairs({"coat","neck","hat"}) do
					local ruid=layers[slot]
					if pool.gearByRUID[ruid]==nil then local actor=self:SpawnPetSkillSprite(ruid,map,132+order);pool.gearByRUID[ruid]=actor;table.insert(pool.gear,actor) end
				end
			end
			-- Spawning can yield. No other update may warm or publish a half-built pool.
			pool.creating=false pool.warming=false
		end
		if self._T.petCharmRenderPool~=pool or not isvalid(map) or player.CurrentMap~=map then
			for _,list in ipairs({pool.bodies,pool.waves,pool.hearts,pool.gear}) do for _,actor in ipairs(list) do if isvalid(actor) then actor:Destroy() end end end
			return
		end
		if pool.creating then return end
		if not pool.ready then
			if pool.warming then return end
			pool.warming=true
			local pixelPoint=_UILogic:ScreenToWorldPosition(Vector2(_UILogic.ScreenWidth*0.5,0))
			local unitPoint=_UILogic:ScreenToWorldPosition(Vector2(_UILogic.ScreenWidth*0.5+1,0))
			local pixel=math.max(0.000001,math.abs(unitPoint.x-pixelPoint.x))
			local p=_UILogic:ScreenToWorldPosition(Vector2(_UILogic.ScreenWidth*0.5,math.min(28,_UILogic.ScreenHeight*0.035)))
			local expectedGear={} local gearCount=0
			for _,base in ipairs(self.PetCharmJumpRUIDs) do for _,ruid in pairs(self.PetGearOverlays[base] or {}) do if not expectedGear[ruid] then expectedGear[ruid]=true;gearCount=gearCount+1 end end end
			local loaded=#pool.bodies==#self.PetCharmJumpRUIDs and #pool.waves==6 and #pool.hearts==16 and #pool.gear==gearCount
			for _,list in ipairs({pool.bodies,pool.waves,pool.hearts,pool.gear or {}}) do
				for _,actor in ipairs(list) do
					if not isvalid(actor) then loaded=false else
						actor.SpriteRendererComponent.PlayRate=0
						-- A nonzero colour quantum makes this an actual tiny render, behind the top HUD.
						if not self:PlacePetCharmSprite(actor,Vector3(p.x,p.y,0),4*pixel,0,1/255) then loaded=false end
					end
				end
			end
			pool.warmFrames=loaded and pool.warmFrames+1 or 0
			pool.warmElapsed=loaded and (pool.warmElapsed or 0)+math.min(0.05,math.max(0,delta or 0)) or 0
			pool.warming=false
			if pool.warmFrames>=8 and pool.warmElapsed>=0.12 then
				for _,list in ipairs({pool.bodies,pool.waves,pool.hearts,pool.gear or {}}) do for _,actor in ipairs(list) do actor.SpriteRendererComponent.Color=Color(1,1,1,0) end end
				pool.ready=true
				log("[VRF] TTUNG-JUMP render pool ready frames="..pool.warmFrames.." poses="..#pool.bodies)
			end
		end
		local pending=self._T.pendingPetCharmVisual
		if pool.ready and pending~=nil then
			self._T.pendingPetCharmVisual=nil
			self:StartPetSkillVisual(pending.petId,pending.zone,pending.run,pending.route,pending.anchor,pending.serial,pending.gearMask)
		end
	end

	@ExecSpace("ClientOnly")
	method void PreloadPetSkillArtwork()
		self._T.petSkillArtReady=false self.PetCharmJumpReady=false
		local assets={self.PetCharmRoarRUID,self.PetCharmWaveRUID,self.PetCharmHeartRUID,self.PetRollRUID,self.PetRollDustRUID,self.PetRollIconRUID,self.PetCharmIconRUID,self.PetFoxIconRUID,self.PetFoxWaveRUID,self.PetTurtleShellRUID,self.PetTurtleHitRUID}
		for _,ruid in ipairs(self.PetCharmJumpRUIDs) do table.insert(assets,ruid) end
		_ResourceService:PreloadAsync(assets,function(results)
			if not isvalid(self) then return end
			local ready=true for _,r in pairs(results) do if r~=PreloadResultStatus.Success then ready=false end end
			-- The image preload alone leaves the first geometry query yielding during a cast.
			-- Warm dimensions/pivots now, while every effect is still absent from the map.
			if ready then
				for _,ruid in ipairs(assets) do
					local metrics=_CardManager:GetSpriteMetrics(ruid)
					if metrics.w<=0 or metrics.h<=0 then ready=false end
				end
			end
			self.PetCharmJumpReady=ready
			self._T.petSkillArtReady=ready log("[VRF] PET-SKILL artwork and geometry ready="..tostring(ready))
			log("[VRF] TTUNG-JUMP complete puppy poses loaded="..tostring(ready))
		end)
	end

	@ExecSpace("ClientOnly")
	method Entity SpawnPetSkillSprite(string ruid, Entity map, integer order)
		if not isvalid(map) or ruid=="" then return nil end
		local fx=_SpawnService:SpawnByModelId("persistenteffect","PetSkill",Vector3.zero,map)
		if not isvalid(fx) or fx.SpriteRendererComponent==nil then return nil end
		-- A cold resource query may yield; never expose the prefab's origin/scale/opacity.
		fx.Enable=false
		local r=fx.SpriteRendererComponent r.Color=Color(1,1,1,0)
		r.SpriteRUID=ruid r.SortingLayer="UI" r.OrderInLayer=order
		return fx
	end

	@ExecSpace("ClientOnly")
	method void PlacePetSkillSprite(Entity fx, Vector3 pos, number width, number rotation, number alpha)
		if not isvalid(fx) then return end
		local metrics=_CardManager:GetSpriteMetrics(fx.SpriteRendererComponent.SpriteRUID)
		if metrics.w<=0 or metrics.h<=0 then
			fx.Enable=false fx.SpriteRendererComponent.Color=Color(1,1,1,0) return
		end
		local scale=width/metrics.w
		_MonsterProjectileFx:PlaceVisual(fx,metrics,pos,scale,rotation)
		local opacity=math.max(0,math.min(1,alpha))
		fx.SpriteRendererComponent.Color=Color(1,1,1,opacity)
		-- Reveal last, after transform and alpha are both ready; hide inactive burst slots.
		fx.Enable=opacity>0
	end

	@ExecSpace("Client")
	method void StartPetSkillVisual(string petId, integer zone, integer run, string routeJSON, Vector3 anchor, integer serial, integer gearMask)
		if zone~=_MapManager.CurrentMapIndex or run~=self.RunToken or not _GameManager.GameStarted or _GameManager.GameOver then return end
		if self.NativePetGearOverlays[petId]~=nil then
			local pool=self._T.nativePetGearWorld
			if pool==nil or not pool.ready or pool.map~=_UserService.LocalPlayer.CurrentMap then self._T.pendingNativePetGearVisual={petId=petId,zone=zone,run=run,route=routeJSON,anchor=anchor,serial=serial,gearMask=gearMask};return end
		end
		if petId=="ttungttang" then
			local pool=self._T.petCharmRenderPool
			if not self.PetCharmJumpReady or pool==nil or not pool.ready or pool.map~=_UserService.LocalPlayer.CurrentMap then
				self._T.pendingPetCharmVisual={petId=petId,zone=zone,run=run,route=routeJSON,anchor=anchor,serial=serial,gearMask=gearMask}
				return
			end
		end
		self:ClearPetSkillVisual()
		local player=_UserService.LocalPlayer
		local map=isvalid(player) and player.CurrentMap or nil if not isvalid(map) then return end
		local point=_UILogic:ScreenToWorldPosition(Vector2(_UILogic.ScreenWidth*0.5,_UILogic.ScreenHeight*0.50))
		local center=Vector3(point.x,point.y,0)
		local unit=_UILogic:ScreenToWorldPosition(Vector2(_UILogic.ScreenWidth*0.5+1,_UILogic.ScreenHeight*0.50))
		local pixel=math.abs(unit.x-center.x)
		if petId=="ttungttang" or petId=="5000498" or petId=="landturtle" or petId=="oduck" then center=anchor end
		local bodyRUID=petId=="ttungttang" and (self.PetCharmJumpReady and self.PetCharmJumpRUIDs[1] or self.PetCharmRoarRUID) or self.PetRollRUID
		if petId=="5000498" then local frames=self:GetPetFoxRoarFrames() bodyRUID=#frames>0 and frames[1].ruid or self.FoxMotions.stand end
		if petId=="landturtle" then bodyRUID=self.PetTurtleShellRUID end
		if petId=="oduck" then bodyRUID=self.OduckMotions.dance end
		local pool=petId=="ttungttang" and self._T.petCharmRenderPool or nil
		local fx=pool~=nil and pool.bodies[1] or self:SpawnPetSkillSprite(bodyRUID,map,132)
		local route={}
		if petId=="5002617" then
			local ok,points=pcall(function() return _HttpService:JSONDecode(routeJSON) end)
			if not ok or type(points)~="table" or #points<2 then if isvalid(fx) then fx:Destroy() end return end
			route=points
		end
		self._T.petSkillVisual={id=petId,serial=serial,zone=zone,run=run,map=map,age=0,center=center,pixel=pixel,body=fx,waves={},hearts={},dusts={},dustTimer=0,ending=false,endAge=0,route=route}
		local visual=self._T.petSkillVisual;visual.gearMask=math.max(0,math.min(7,gearMask))
		if self.NativePetGearOverlays[petId]~=nil then
			visual.nativeClip=fx.SpriteRendererComponent.SpriteRUID;visual.nativeFrameStart=0;fx.SpriteRendererComponent.Enable=false
		end
		if petId=="ttungttang" then
			local v=self._T.petSkillVisual
			v.charmPool=true v.charmBodies=pool.bodies v.charmFrame=1
			v.waves=pool.waves v.hearts=pool.hearts v.charmGear=pool.gear v.gearByRUID=pool.gearByRUID v.gearMask=math.max(0,math.min(7,gearMask))
			-- Integral source-pixel scale and a snapped origin keep every ink pixel stable.
			v.charmWidth=128*pixel*math.max(1,math.floor(self.PetCharmWidth/(128*pixel)+0.5))
		end
		if petId=="5000498" then
			for i=1,3 do table.insert(self._T.petSkillVisual.waves,self:SpawnPetSkillSprite(self.PetFoxWaveRUID,map,130)) end
		end
		if petId=="landturtle" then
			local frames=self:GetPetTurtleHitFrames()
			if #frames>0 then self._T.petSkillVisual.hitFx=self:SpawnPetSkillSprite(frames[1].ruid,map,136) end
		end
		if petId=="oduck" then
			fx.SpriteRendererComponent.PlayRate=1
			self._T.petSkillVisual.mirror=self:SpawnPetSkillSprite(self.PetDuckMirrorRUID,map,134)
		end
		self:UpdatePetSkillVisual(0)
		log("[VRF] PET-SKILL visual pet="..petId.." zone="..zone)
	end

	@ExecSpace("Client")
	method void EndPetSkillVisual(string petId, integer zone, integer run, integer serial)
		local nativePending=self._T.pendingNativePetGearVisual
		if nativePending~=nil and nativePending.petId==petId and nativePending.zone==zone and nativePending.run==run and nativePending.serial==serial then self._T.pendingNativePetGearVisual=nil end
		local pending=self._T.pendingPetCharmVisual
		if pending~=nil and pending.petId==petId and pending.zone==zone and pending.run==run and pending.serial==serial then
			self._T.pendingPetCharmVisual=nil
			log("[VRF] TTUNG-COLD cancelled pending serial="..serial)
		end
		local v=self._T.petSkillVisual
		if v==nil or v.id~=petId or v.zone~=zone or v.run~=run or v.serial~=serial or v.ending then return end
		v.ending=true v.endAge=0
		log("[VRF] PET-SKILL visual ending serial="..serial)
	end

	@ExecSpace("ClientOnly")
	method void UpdatePetSkillVisual(number delta)
		local v=self._T.petSkillVisual if v==nil then return end
		if v.run~=self.RunToken or v.zone~=_MapManager.CurrentMapIndex or not _GameManager.GameStarted or _GameManager.GameOver or _MapManager.AwayOnSideMap or not isvalid(v.map) then self:ClearPetSkillVisual() return end
		local paused=_GameManager:IsGamePaused() or _GameManager.SafeAreaFrozen
		for _,dust in ipairs(v.dusts) do if isvalid(dust.fx) then dust.fx.SpriteRendererComponent.PlayRate=paused and 0 or 1 end end
		if v.id=="oduck" then
			for _,e in ipairs({v.body,v.mirror}) do if isvalid(e) then e.SpriteRendererComponent.PlayRate=paused and 0 or 1 end end
		end
		if paused then return end
		v.age=v.age+math.max(0,delta) local t=v.age
		if v.ending then v.endAge=v.endAge+math.max(0,delta) end
		if v.id=="ttungttang" then
			local fade=v.ending and math.max(0,1-v.endAge/0.18) or 1
			local jump=self:GetPetCharmJumpHeight(t)
			local p=v.center local width=v.charmWidth or self.PetCharmWidth
			local index=self:GetPetCharmJumpFrameIndex(t)
			local foot=0.46875
			if v.charmBodies~=nil then
				local nextBody=v.charmBodies[index]
				if isvalid(nextBody) then
					local previous=v.body v.body=nextBody v.charmFrame=index foot=self.PetCharmJumpFeet[index]
					-- Reuse render-warmed actors. Only opacity changes: no activation
					-- or texture reassignment can restart the renderer at a pose boundary.
					self:PlacePetCharmSprite(nextBody,self:GetPetCharmBodyPosition(v,index,width,jump),width,0,fade)
					if previous~=nextBody and isvalid(previous) then previous.SpriteRendererComponent.Color=Color(1,1,1,0) end
				end
			else self:PlacePetCharmSprite(v.body,Vector3(p.x,p.y+width*foot+jump,p.z),width,0,fade) end
			self:RenderPetSkillGear(v,index,width,jump,fade)
			local launchIndex=self:GetPetCharmJumpFrameIndex(self.PetCharmLaunchTime)
			local mouthY=p.y+width*self.PetCharmJumpMouth[launchIndex]
			-- Two alternating burst slots let each heart wave live past the next jump.
			for i,wave in ipairs(v.waves) do
				local slot=math.floor((i-1)/3) local index=(i-1)%3
				local elapsed=t-self.PetCharmLaunchTime-slot*self.PetCharmJumpPeriod-index*0.08
				local a=elapsed>=0 and elapsed%(self.PetCharmJumpPeriod*2) or -1 local q=math.min(1,math.max(0,a/1.18))
				local envelope=a>=0 and math.min(1,a/0.08)*math.min(1,math.max(0,(1.18-a)/0.68)) or 0
				self:PlacePetCharmSprite(wave,Vector3(p.x,mouthY,p.z-0.1),1.0+7.4*q,0,envelope*0.55*fade)
			end
			for i,heart in ipairs(v.hearts) do
				local slot=math.floor((i-1)/8) local index=(i-1)%8
				local elapsed=t-self.PetCharmLaunchTime-slot*self.PetCharmJumpPeriod local a=elapsed>=0 and elapsed%(self.PetCharmJumpPeriod*2) or -1
				local q=math.min(1,math.max(0,a/1.12)) local angle=0.12+index*(math.pi-0.24)/7
				local radius=q*4.5
				local hp=Vector3(p.x+math.cos(angle)*radius,mouthY+math.sin(angle)*radius*0.55+math.sin(q*math.pi)*0.18,p.z-0.15)
				local envelope=a>=0 and math.min(1,a/0.08)*math.min(1,math.max(0,(1.12-a)/0.60)) or 0
				self:PlacePetCharmSprite(heart,hp,v.pixel*(28+index%3*6),0,envelope*0.90*fade)
			end
			if v.ending and v.endAge>=0.18 then self:ClearPetSkillVisual() end
		elseif v.id=="oduck" then
			self:UpdateOduckVisual(v,t)
		elseif v.id=="landturtle" then
			self:UpdatePetTurtleVisual(v,t)
		elseif v.id=="5000498" then
			self:UpdatePetFoxVisual(v,t)
		else
			local p=self:SamplePetRollRoute(v.route,t)
			local alpha=math.min(1,t/0.12)*math.min(1,math.max(0,(self.PetRollDuration-t)/0.22))
			local rotation=-t*720
			local y=p.y-0.4+self:GetPetRollGroundOffset(rotation)+math.abs(math.sin(t*14))*0.03
			self:PlacePetSkillSprite(v.body,Vector3(p.x,y,p.z),1.35,rotation,alpha)
			self:UpdatePetRollDust(v,math.max(0,delta),p,t<self.PetRollDuration)
			if t>=self.PetRollDuration then
				if isvalid(v.body) then v.body:Destroy() end v.body=nil
				if #v.dusts==0 then self:ClearPetSkillVisual() end
			end
		end
		if self._T.petSkillVisual==v and self.NativePetGearOverlays[v.id]~=nil then self:UpdateNativePetSkillGear(v) end
	end

	@ExecSpace("ClientOnly")
	method table GetPetRollDustFrames()
		local cached=self._T.petRollDustFrames if cached~=nil then return cached end
		local frames={}
		local clip=_ResourceService:LoadAnimationClipAndWait(self.PetRollDustRUID)
		if clip~=nil and clip.Frames~=nil then
			for i=1,clip.Frames.Count do
				local sprite=clip.Frames[i].FrameSprite
				if sprite~=nil and sprite.Width>0 and sprite.PixelPerUnit>0 then
					table.insert(frames,{ruid=sprite.RUID,ratio=sprite.Height/sprite.Width})
				end
			end
		end
		self._T.petRollDustFrames=frames
		return frames
	end

	@ExecSpace("ClientOnly")
	method void UpdatePetRollDust(table visual, number delta, Vector3 rollPos, boolean emit)
		local v=visual
		local frames=self:GetPetRollDustFrames()
		v.dustTimer=v.dustTimer-delta
		if emit and v.dustTimer<=0 then
			v.dustTimer=0.10
			local previous=self:SamplePetRollRoute(v.route,math.max(0,v.age-0.06))
			local direction=rollPos.x>=previous.x and 1 or -1
			local fx=self:SpawnPetSkillSprite(#frames>0 and frames[1].ruid or self.PetRollDustRUID,v.map,128)
			if isvalid(fx) then
				table.insert(v.dusts,{fx=fx,age=0,x=rollPos.x-direction*0.66,y=rollPos.y-0.4,z=rollPos.z+0.05,direction=direction})
			end
		end
		for i=#v.dusts,1,-1 do
			local puff=v.dusts[i] puff.age=puff.age+delta
			if puff.age>=0.55 or not isvalid(puff.fx) then
				if isvalid(puff.fx) then puff.fx:Destroy() end
				table.remove(v.dusts,i)
			else
				local q=puff.age/0.55 local width=0.36+q*0.34
				local frame=#frames>0 and frames[math.min(#frames,math.floor(puff.age/0.14)+1)] or nil
				if frame~=nil and puff.fx.SpriteRendererComponent.SpriteRUID~=frame.ruid then puff.fx.SpriteRendererComponent.SpriteRUID=frame.ruid end
				local ratio=frame~=nil and frame.ratio or 1
				local pos=Vector3(puff.x-puff.direction*q*0.10,puff.y+width*ratio*0.5+0.03+q*0.10,puff.z)
				local alpha=math.min(1,puff.age/0.06)*(1-q)*(1-q)*0.32
				self:PlacePetSkillSprite(puff.fx,pos,width,0,alpha)
				puff.fx.SpriteRendererComponent.Color=Color(0.91,0.86,0.77,alpha)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearPetSkillVisual()
		self._T.pendingPetCharmVisual=nil self._T.pendingNativePetGearVisual=nil
		local v=self._T.petSkillVisual if v==nil then return end
		if v.charmPool then
			for _,list in ipairs({v.charmBodies,v.waves,v.hearts,v.charmGear or {}}) do
				for _,actor in ipairs(list) do if isvalid(actor) then actor.SpriteRendererComponent.Color=Color(1,1,1,0) end end
			end
			self._T.petSkillVisual=nil return
		end
		if v.nativeGearHandle~=nil and isvalid(v.body) then v.body:DisconnectEvent(SpriteAnimPlayerChangeFrameEvent,v.nativeGearHandle) end
		if self.NativePetGearOverlays[v.id]~=nil then local pool=self._T.nativePetGearWorld;if pool~=nil then for _,e in pairs(pool.actors) do if isvalid(e) then e.SpriteRendererComponent.Color=Color(1,1,1,0) end end end end
		if isvalid(v.body) then v.body:Destroy() end
		if isvalid(v.hitFx) then v.hitFx:Destroy() end
		if isvalid(v.mirror) then v.mirror:Destroy() end
		for _,dust in ipairs(v.dusts) do if isvalid(dust.fx) then dust.fx:Destroy() end end
		for _,list in ipairs({v.waves,v.hearts}) do for _,e in ipairs(list) do if isvalid(e) then e:Destroy() end end end
		self._T.petSkillVisual=nil
	end

	method void OnEndPlay()
		if self:IsClient() then self:ClearPetSkillVisual();self:ClearPetCharmRenderPool();self:ClearPetGearUI();self:ClearNativePetGearWorldPool() else self:ResetOduckBuff() end
		self._T.petSkillCast=nil
	end


	@ExecSpace("Server")
	method void CheatRequestNextPetSkill()
		-- Temporary run selection only; never changes ownership, saved equipment or growth.
		if not Environment:IsMakerPlay() or not _CardManager.DebugMode then return end
		if not _GameManager.GameStarted or _GameManager.GameOver or _MapManager.AwayOnSideMap or _GameManager.SafeAreaFrozen or _GameManager:IsGamePaused() then return end
		self.RunUserId=senderUserId
		local ids={"5002617","ttungttang","5000498","landturtle","oduck"} local nextIndex=1
		for i,id in ipairs(ids) do if id==self.RunPetId then nextIndex=i%#ids+1 break end end
		self:ResetOduckBuff()
		self.RunPetId=ids[nextIndex]
		local record=self.States[self.RunUserId]
		self.RunPetGearMask=record~=nil and (record.pets[self.RunPetId].GearEquippedMask or 0) or 0
		self._T.petSkillCast=nil self._T.petSkillCooldown=3
		self:ShowPetSkillCheat(self.RunPetId,self.RunUserId)
		log("[VRF] PET-SKILL U preview pet="..self.RunPetId.." delay=3")
	end

	@ExecSpace("Client")
	method void ShowPetSkillCheat(string petId)
		self:ClearPetSkillVisual()
		local def=self:GetPetDefinition(petId) if def==nil then return end
		local skill=self:GetPetSkillInfo(petId)
		_UIToast:ShowMessage("[U] ".._LocalizationService:GetText(def.nameKey).." · "..skill.name.." — 3s")
	end

	@ExecSpace("ClientOnly")
	method void PreloadFoxArtwork()
		self.FoxReady=false local list={} local seen={}
		for _,ruid in pairs(self.FoxMotions) do if not seen[ruid] then seen[ruid]=true table.insert(list,ruid) end end
		_ResourceService:PreloadAsync(list,function(results)
			if not isvalid(self) then return end
			local ready=true for _,status in pairs(results) do if status~=PreloadResultStatus.Success then ready=false end end
			self.FoxReady=ready log("[VRF] PET-FOX original motions ready="..tostring(ready).." count="..#list)
			if _PetHouseUI.PetMode then _PetHouseUI:Refresh() end
		end)
	end

	@ExecSpace("ClientOnly")
	method table GetPetFoxRoarFrames()
		if self._T.foxRoarFrames~=nil then return self._T.foxRoarFrames end
		local frames={} local clip=_ResourceService:LoadAnimationClipAndWait(self.FoxMotions.angry)
		if clip~=nil and clip.Frames~=nil then
			for i=1,clip.Frames.Count do local sprite=clip.Frames[i].FrameSprite
				if sprite~=nil then table.insert(frames,{ruid=sprite.RUID}) end
			end
		end
		self._T.foxRoarFrames=frames return frames
	end

	@ExecSpace("ClientOnly")
	method void UpdatePetFoxVisual(table v, number t)
		local frames=self:GetPetFoxRoarFrames()
		local index=t<0.17 and 1 or (t<self.PetCharmWindup and 2 or (t<1.05 and 3 or 4))
		if #frames>0 then
			local ruid=frames[math.min(#frames,index)].ruid
			if v.body.SpriteRendererComponent.SpriteRUID~=ruid then v.body.SpriteRendererComponent.SpriteRUID=ruid end
		end
		local base=_CardManager:GetSpriteMetrics(self.FoxMotions.stand)
		local metrics=_CardManager:GetSpriteMetrics(v.body.SpriteRendererComponent.SpriteRUID)
		local scale=1.5/math.max(0.01,base.h)
		local fade=math.min(1,t/0.12)*math.min(1,math.max(0,(self.PetFoxRoarDuration-t)/0.3))
		local p=v.center
		self:PlacePetSkillSprite(v.body,Vector3(p.x,p.y+metrics.h*scale*0.5,p.z),metrics.w*scale,0,fade)
		if t>=self.PetCharmWindup and not v.soundPlayed then
			v.soundPlayed=true _SoundOptionLogic:PlaySfx("5f1f2c80933242ff9657ffc98b7f91cc",0.6)
		end
		for i,wave in ipairs(v.waves) do
			local age=t-self.PetCharmWindup-(i-1)*0.16 local q=math.min(1,math.max(0,age/1.3))
			local alpha=age>=0 and math.min(1,age/0.08)*math.min(1,math.max(0,(1.3-age)/0.75))*0.62*fade or 0
			self:PlacePetSkillSprite(wave,Vector3(p.x,p.y+0.98,p.z-0.1),0.9+8.5*q,0,alpha)
		end
		if t>=self.PetFoxRoarDuration then self:ClearPetSkillVisual() end
	end


	@ExecSpace("ClientOnly")
	method void PreloadTurtleArtwork()
		self.TurtleReady=false local list={} local seen={}
		for _,ruid in pairs(self.TurtleMotions) do if not seen[ruid] then seen[ruid]=true table.insert(list,ruid) end end
		_ResourceService:PreloadAsync(list,function(results)
			if not isvalid(self) then return end
			local ready=true for _,status in pairs(results) do if status~=PreloadResultStatus.Success then ready=false end end
			local dustFrames=self:GetPetRollDustFrames()
			if #dustFrames==0 then ready=false end
			for _,f in ipairs(dustFrames) do _CardManager:GetSpriteMetrics(f.ruid) end
			local hitFrames=self:GetPetTurtleHitFrames()
			if #hitFrames==0 then ready=false end
			self.TurtleReady=ready log("[VRF] PET-TURTLE original motions ready="..tostring(ready).." count="..#list)
			if _PetHouseUI.PetMode then _PetHouseUI:Refresh() end
		end)
	end

	@ExecSpace("ServerOnly")
	method boolean AbsorbPetTurtleHit()
		local c=self._T.petSkillCast
		if c==nil or c.id~="landturtle" or c.zone~=_MapManager.CurrentMapIndex or _MapManager.AwayOnSideMap or not _GameManager.GameStarted or _GameManager.GameOver then return false end
		if c.age<self.PetTurtleDropTime or c.age>=self.PetTurtleDropTime+self.PetTurtleShieldDuration then return false end
		-- Paused attacks are blocked without accumulating flash or hit events.
		if _GameManager:IsGamePaused() or _GameManager.SafeAreaFrozen then return true end
		c.absorbed=(c.absorbed or 0)+1
		self:PlayPetTurtleHit(c.zone,self.RunToken,c.serial,self.RunUserId)
		if c.absorbed==1 then log("[VRF] PET-TURTLE intercepted monster attack serial="..c.serial) end
		return true
	end

	@ExecSpace("Client")
	method void PlayPetTurtleHit(integer zone, integer run, integer serial)
		local v=self._T.petSkillVisual
		if v==nil or v.id~="landturtle" or v.zone~=zone or v.run~=run or v.serial~=serial or v.ending then return end
		if _GameManager:IsGamePaused() or _GameManager.SafeAreaFrozen then return end
		v.hitAt=v.age
		-- Coalesce bursts in a crowd: one actor and at most one recoil restart per 0.07s.
		if v.recoilAt==nil or v.age-v.recoilAt>=0.07 then
			v.recoilAt=v.age v.recoilDirection=(v.recoilDirection or -1)*-1
		end
		if v.sparkAt==nil or v.age-v.sparkAt>=0.04 then v.sparkAt=v.age end
	end

	@ExecSpace("ClientOnly")
	method Vector3 GetPetTurtleTarget(integer zone)
		local v=self._T.petSkillVisual
		if v==nil or v.id~="landturtle" or v.zone~=zone or v.run~=self.RunToken or v.ending or not isvalid(v.body) or not _GameManager.GameStarted or _GameManager.GameOver or _MapManager.AwayOnSideMap then return nil end
		if v.age<self.PetTurtleDropTime or v.age>=self.PetTurtleDropTime+self.PetTurtleShieldDuration then return nil end
		return Vector3(v.center.x,v.center.y+self.PetTurtleWidth*(16/30)*0.65,v.center.z)
	end

	@ExecSpace("ClientOnly")
	method void UpdatePetTurtleVisual(table v, number t)
		local p=v.center local width=self.PetTurtleWidth local ratio=16/30
		local q=math.min(1,t/self.PetTurtleDropTime)
		local offset=5*(1-q*q)
		local landedAge=math.max(0,t-self.PetTurtleDropTime)
		local squash=t>=self.PetTurtleDropTime and math.sin(math.min(1,landedAge/0.16)*math.pi)*0.08 or 0
		local fade=math.min(1,t/0.06)*(v.ending and math.max(0,1-v.endAge/0.18) or 1)
		local hitAge=v.recoilAt~=nil and math.max(0,t-v.recoilAt) or self.PetTurtleRecoilDuration
		local recoil=math.max(0,1-hitAge/self.PetTurtleRecoilDuration)
		local shake=(v.recoilDirection or 1)*0.055*math.cos(hitAge*55)*recoil*recoil
		squash=squash+0.025*math.sin(math.min(1,hitAge/self.PetTurtleRecoilDuration)*math.pi)*recoil
		self:PlacePetSkillSprite(v.body,Vector3(p.x+shake,p.y+width*ratio*0.5+offset,p.z),width,0,fade)
		local transform=v.body.TransformComponent local scale=transform.Scale.x
		transform.Scale=Vector3(scale*(1+squash),scale*(1-squash),1)
		local flash=v.hitAt~=nil and math.max(0,1-(t-v.hitAt)/0.16) or 0
		v.body.SpriteRendererComponent.Color=Color(1,1-flash*0.16,1-flash*0.35,fade)
		if t>=self.PetTurtleDropTime and not v.landed then
			v.landed=true
			local camera=_CameraService:GetCurrentCameraComponent()
			if camera~=nil then camera:ShakeCamera(0.18,0.18) end
			_SoundOptionLogic:PlaySfx("b4b928d77bc3460b90c43f66e796dde9",0.5)
			local frames=self:GetPetRollDustFrames()
			for i=1,(#frames>0 and 8 or 0) do
				local direction=i%2==0 and 1 or -1
				local fx=self:SpawnPetSkillSprite(frames[1].ruid,v.map,131)
				if isvalid(fx) then table.insert(v.dusts,{fx=fx,age=0,direction=direction,x=p.x+direction*0.8,y=p.y,spread=0.65+math.floor((i-1)/2)*0.3}) end
			end
			log("[VRF] PET-TURTLE impact shake=0.18 dust="..#v.dusts)
		end
		self:UpdatePetTurtleHitMarker(v,t,fade)
		self:UpdatePetTurtleDust(v)
		if v.ending and v.endAge>=0.18 then self:ClearPetSkillVisual() end
	end

	@ExecSpace("ClientOnly")
	method void UpdatePetTurtleDust(table v)
		local age=math.max(0,v.age-self.PetTurtleDropTime) local frames=self:GetPetRollDustFrames()
		for i=#v.dusts,1,-1 do
			local dust=v.dusts[i]
			if age>=0.60 or not isvalid(dust.fx) then
				if isvalid(dust.fx) then dust.fx:Destroy() end table.remove(v.dusts,i)
			else
				local q=age/0.60 local frame=frames[math.min(#frames,math.floor(age/0.15)+1)]
				dust.fx.SpriteRendererComponent.SpriteRUID=frame.ruid
				local width=0.50+q*0.60
				local pos=Vector3(dust.x+dust.direction*dust.spread*(1-(1-q)^2),dust.y+width*frame.ratio*0.5+math.sin(q*math.pi)*0.14,v.center.z-0.05)
				local alpha=math.min(1,age/0.04)*(1-q)^2*0.46
				self:PlacePetSkillSprite(dust.fx,pos,width,0,alpha)
				dust.fx.SpriteRendererComponent.Color=Color(0.94,0.86,0.71,alpha)
			end
		end
	end


	@ExecSpace("ClientOnly")
	method table GetPetTurtleHitFrames()
		if self._T.turtleHitFrames~=nil then return self._T.turtleHitFrames end
		local frames={} local clip=_ResourceService:LoadAnimationClipAndWait(self.PetTurtleHitRUID)
		if clip~=nil and clip.Frames~=nil then
			for i=1,clip.Frames.Count do
				local sprite=clip.Frames[i].FrameSprite
				if sprite~=nil then
					local metrics=_CardManager:GetSpriteMetrics(sprite.RUID)
					if metrics.w>0 and metrics.h>0 then table.insert(frames,{ruid=sprite.RUID,w=metrics.w}) end
				end
			end
		end
		self._T.turtleHitFrames=frames
		log("[VRF] PET-TURTLE block hit frames="..#frames)
		return frames
	end

	@ExecSpace("ClientOnly")
	method void UpdatePetTurtleHitMarker(table v, number t, number fade)
		local fx=v.hitFx if not isvalid(fx) then return end
		local age=v.sparkAt~=nil and math.max(0,t-v.sparkAt) or self.PetTurtleHitDuration
		if age>=self.PetTurtleHitDuration then fx.Enable=false fx.SpriteRendererComponent.Color=Color(1,1,1,0) return end
		local frames=self:GetPetTurtleHitFrames() if #frames==0 then return end
		local index=math.min(#frames,1+math.floor(age/self.PetTurtleHitDuration*#frames))
		local frame=frames[index]
		if fx.SpriteRendererComponent.SpriteRUID~=frame.ruid then fx.SpriteRendererComponent.SpriteRUID=frame.ruid end
		fx.SpriteRendererComponent.PlayRate=0
		local scale=0.82/math.max(0.01,frames[1].w)
		local pos=Vector3(v.center.x,v.center.y+self.PetTurtleWidth*(16/30)*0.65,v.center.z-0.1)
		local alpha=math.max(0,1-(age/self.PetTurtleHitDuration)^2)*fade
		self:PlacePetSkillSprite(fx,pos,frame.w*scale,0,alpha)
	end

	@ExecSpace("ClientOnly")
	method void PreloadOduckArtwork()
		self.OduckReady=false local assets={} local seen={}
		for _,ruid in pairs(self.OduckMotions) do if not seen[ruid] then seen[ruid]=true table.insert(assets,ruid) end end
		table.insert(assets,self.PetDuckMirrorRUID)
		table.insert(assets,self.PetDuckIconRUID)
		_ResourceService:PreloadAsync(assets,function(results)
			if not isvalid(self) then return end
			local ready=true for _,status in pairs(results) do if status~=PreloadResultStatus.Success then ready=false end end
			if ready then
				for _,ruid in ipairs({self.OduckMotions.stand,self.OduckMotions.dance,self.PetDuckMirrorRUID}) do
					local metrics=_CardManager:GetSpriteMetrics(ruid)
					if metrics.w<=0 or metrics.h<=0 then ready=false end
				end
			end
			self.OduckReady=ready log("[VRF] PET-ODUCK original motions and mirror ready="..tostring(ready))
			if _PetHouseUI.PetMode then _PetHouseUI:Refresh() end
		end)
	end

	@ExecSpace("Client")
	method void NotifyOduckBuff(number duration)
		if duration>0 then _CardManager:ShowOduckBuffIcon(duration)
		else _CardManager:HideOduckBuffIcon() end
	end

	@ExecSpace("ServerOnly")
	method void ResetOduckBuff()
		local active=self.PetDuckBuffActive
		self.PetDuckBuffRemaining=0 self.PetDuckBuffActive=false
		if active then
			if self.RunUserId~="" then self:NotifyOduckBuff(0,self.RunUserId) end
			log("[VRF] PET-ODUCK damage buff ended")
		end
	end

	@ExecSpace("ServerOnly")
	method void UpdateOduckBuff(number delta)
		if not self.PetDuckBuffActive then return end
		if not _GameManager.GameStarted or _GameManager.GameOver or self.RunPetId~="oduck" then self:ResetOduckBuff() return end
		if _GameManager:IsGamePaused() or _GameManager.SafeAreaFrozen then return end
		self.PetDuckBuffRemaining=math.max(0,self.PetDuckBuffRemaining-math.max(0,delta))
		if self.PetDuckBuffRemaining<=0 then self:ResetOduckBuff() end
	end

	@ExecSpace("ClientOnly")
	method void UpdateOduckVisual(table v, number elapsed)
		if not isvalid(v.body) then self:ClearPetSkillVisual() return end
		local base=_CardManager:GetSpriteMetrics(self.OduckMotions.stand)
		local metrics=_CardManager:GetSpriteMetrics(self.OduckMotions.dance)
		if base.h<=0 or metrics.h<=0 then return end
		local scale=self.PetDuckHeight/base.h
		local fade=math.min(1,elapsed/0.18)*math.min(1,math.max(0,(self.PetDuckDanceDuration-elapsed)/0.30))
		local p=v.center
		-- Leave the native clip's frame offsets and pivots intact; no per-frame scale pulses.
		local center=Vector3(p.x+(0.5-metrics.px)*metrics.w*scale,p.y+(0.5-metrics.py)*metrics.h*scale,p.z)
		self:PlacePetSkillSprite(v.body,center,metrics.w*scale,0,fade)
		local mirrorY=p.y+self.PetDuckHeight+0.80+math.sin(elapsed*3)*0.025
		self:PlacePetSkillSprite(v.mirror,Vector3(p.x,mirrorY,p.z-0.05),self.PetDuckMirrorWidth,0,fade*0.90)
		if not v.soundPlayed then v.soundPlayed=true _SoundOptionLogic:PlaySfx("f46c0ff22aa84fd4b0e762ed7abbe1ed",0.45) end
		if elapsed>=self.PetDuckDanceDuration then self:ClearPetSkillVisual() end
	end

	method boolean HasPetGearBit(integer mask, integer bit)
		return math.floor(mask/bit)%2==1
	end

	method table GetPetGearDefinition(string slot)
		local defs={
			Cap={id="ttung-cap",bit=1,slot="Cap",key="PET_GEAR_TTUNG_HAT",statKey="PET_GEAR_CRIT_DAMAGE",icon="c01afff596084f60b66e2763b0bb92aa"},
			Coat={id="ttung-coat",bit=2,slot="Coat",key="PET_GEAR_TTUNG_COAT",statKey="PET_GEAR_ATTACK",icon="63976bbd67e84ac4a8fd31ae94d2bbe4"},
			Necklace={id="ttung-neck",bit=4,slot="Necklace",key="PET_GEAR_TTUNG_NECK",statKey="PET_GEAR_CRIT_CHANCE",icon="ed42c7d372964cd0819b250f1564d459"}
		}
		return defs[slot]
	end

	-- The only grant entry point is server-only; purchase/reward code supplies the validated mask.
	@ExecSpace("ServerOnly")
	method boolean GrantPetGear(string userId, integer mask)
		return self:GrantDedicatedPetGear(userId,"ttungttang",mask)
	end

	@ExecSpace("Server")
	method void RequestPetGear(string slot, string petId)
		local def=self:GetPetGearDefinitionForPet(petId,slot) local record=self.States[senderUserId]
		if def==nil or record==nil then return end
		record.responsePetId=petId
		if _GameManager.GameStarted and not _GameManager.GameOver then self:PushState(senderUserId,"","PET_BATTLE_LOCKED") return end
		local pet=record.pets[petId] local now=_DateTimeLogic:GetTimeElapsedWithoutOffset()
		if now<(record.busyUntil or 0) or now-(record.lastGearRequest or -1000)<250 then return end
		if not pet.Owned or not self:HasPetGearBit(pet.GearOwnedMask,def.bit) then self:PushState(senderUserId,"","PET_GEAR_NOT_OWNED") return end
		record.lastGearRequest=now
		local equipped=self:HasPetGearBit(pet.GearEquippedMask,def.bit)
		pet.GearEquippedMask=pet.GearEquippedMask+(equipped and -def.bit or def.bit)
		self:MarkDirty(record) self:PushState(senderUserId,"",equipped and "PET_GEAR_REMOVED" or "PET_GEAR_WORN")
		if not record.test then _GameManager:PersistRewardNow(senderUserId) end
		log("[VRF] PET-GEAR slot="..slot.." equippedMask="..pet.GearEquippedMask)
	end

	@ExecSpace("Server")
	method void RequestTestPetGear(string petId)
		if not Environment:IsMakerPlay() or (_GameManager.GameStarted and not _GameManager.GameOver) then return end
		local record=self.States[senderUserId] if record==nil or record.pets[petId]==nil or not record.pets[petId].Owned or self:GetPetGearDefinitionForPet(petId,"Cap")==nil then return end
		if _DateTimeLogic:GetTimeElapsedWithoutOffset()<(record.busyUntil or 0) then return end
		local preview=self:ReadAccount(self:SerializeAccount(record)) if preview==nil then return end
		preview.test=true preview.dirty=false preview.generation=0 preview.responsePetId=petId
		preview.pets[petId].GearOwnedMask=7 preview.pets[petId].GearEquippedMask=7
		self.States[senderUserId]=preview self:PushState(senderUserId,"","PET_GEAR_TEST_NOTICE")
	end

	@ExecSpace("ClientOnly")
	method void PreloadPetGearArtwork()
		self.PetGearReady=false local list={} local seen={}
		for _,layers in pairs(self.PetGearOverlays) do for _,ruid in pairs(layers) do if not seen[ruid] then seen[ruid]=true table.insert(list,ruid) end end end
		for _,slot in ipairs({"Cap","Coat","Necklace"}) do table.insert(list,self:GetPetGearDefinition(slot).icon) end
		_ResourceService:PreloadAsync(list,function(results)
			if not isvalid(self) then return end
			local ready=true for _,r in pairs(results) do if r~=PreloadResultStatus.Success then ready=false end end
			if ready then for _,ruid in ipairs(list) do local metrics=_CardManager:GetSpriteMetrics(ruid) if metrics.w<=0 or metrics.h<=0 then ready=false end end end
			self.PetGearReady=ready log("[VRF] PET-GEAR preloaded="..tostring(ready).." textures="..#list)
		end)
	end

	@ExecSpace("ClientOnly")
	method void RenderPetGearUI(Entity portrait, table entry, string baseRUID)
		if not isvalid(portrait) then return end
		if entry.id~="ttungttang" then
			local old=(self._T.petGearUI or {})[portrait.Id];if old~=nil then for _,e in ipairs(old.actors) do if isvalid(e) then e.SpriteGUIRendererComponent.Color=Color(1,1,1,0) end end end
			self:RenderNativePetGearUI(portrait,entry);return
		end
		self:HideNativePetGearUI(portrait)
		self._T.petGearUI=self._T.petGearUI or {} local pool=self._T.petGearUI[portrait.Id]
		local mask=entry.id=="ttungttang" and entry.progress~=nil and entry.progress.Owned and (entry.progress.GearEquippedMask or 0) or 0
		if not self.PetGearReady then return end
		if pool==nil and mask>0 then
			pool={portrait=portrait,actors={},byRUID={},warmFrames=0,ready=false} self._T.petGearUI[portrait.Id]=pool
			for _,slot in ipairs({"coat","neck","hat"}) do
				for _,layers in pairs(self.PetGearOverlays) do local ruid=layers[slot]
					if pool.byRUID[ruid]==nil then
						local e=_SpawnService:SpawnByEntity(portrait,"PetWear_"..slot,Vector3.zero,portrait,false)
						local t=e.UITransformComponent;t.AnchorsMin=Vector2(0.5,0.5);t.AnchorsMax=Vector2(0.5,0.5);t.Pivot=Vector2(0.5,0.5);t.anchoredPosition=Vector2.zero;t.UIScale=Vector3(1,1,1);t.UIRotation=Vector3.zero
						local r=e.SpriteGUIRendererComponent;r.Color=Color(1,1,1,0);r.ImageRUID=DataRef(ruid);r.Type=ImageType.Simple;r.PreserveSprite=PreserveSpriteType.None;r.LocalScale=Vector2(1,1);r.LocalPosition=Vector2.zero;r.RaycastTarget=false;r.Outline=false;r.DropShadow=false;r.FlipX=false;r.FlipY=false;r.PlayRate=0
						pool.byRUID[ruid]=e;table.insert(pool.actors,e)
					end
				end
			end
		end
		if pool==nil then return end
		local selected={} local layers=self.PetGearOverlays[baseRUID]
		if layers~=nil and mask>0 then
			for slot,bit in pairs({hat=1,coat=2,neck=4}) do if self:HasPetGearBit(mask,bit) then selected[layers[slot]]=true end end
		end
		for ruid,e in pairs(pool.byRUID) do if isvalid(e) then
			e.UITransformComponent.RectSize=portrait.UITransformComponent.RectSize
			local a=pool.ready and (selected[ruid] and portrait.SpriteGUIRendererComponent.Color.a or 0) or 0.000001
			-- Sprite flips do not propagate to child UI renderers. Mirror the full gear canvas with the pet.
			e.SpriteGUIRendererComponent.FlipX=portrait.SpriteGUIRendererComponent.FlipX
			e.SpriteGUIRendererComponent.FlipY=portrait.SpriteGUIRendererComponent.FlipY
			e.SpriteGUIRendererComponent.Color=Color(1,1,1,a);e.Enable=true
		end end
		pool.warmFrames=pool.warmFrames+1 if pool.warmFrames>=4 then pool.ready=true end
	end

	@ExecSpace("ClientOnly")
	method void ClearPetGearUI()
		self:ClearNativePetGearUI()
		for _,pool in pairs(self._T.petGearUI or {}) do for _,actor in ipairs(pool.actors) do if isvalid(actor) then actor:Destroy() end end end
		self._T.petGearUI={}
	end

	@ExecSpace("ClientOnly")
	method void RenderPetSkillGear(table visual, integer index, number width, number jump, number alpha)
		local layers=self.PetGearOverlays[self.PetCharmJumpRUIDs[index]] local selected={}
		for slot,bit in pairs({hat=1,coat=2,neck=4}) do if self:HasPetGearBit(visual.gearMask or 0,bit) then selected[layers[slot]]=true end end
		local pos=self:GetPetCharmBodyPosition(visual,index,width,jump)
		for ruid,actor in pairs(visual.gearByRUID or {}) do self:PlacePetCharmSprite(actor,pos,width,0,selected[ruid] and alpha or 0) end
	end

	method table GetPetGearDefinitionForPet(string petId, string slot)
		if petId=="ttungttang" then return self:GetPetGearDefinition(slot) end
		local defs=self.NativePetGearDefinitions[petId]
		return defs~=nil and defs[slot] or nil
	end

	@ExecSpace("ServerOnly")
	method boolean GrantDedicatedPetGear(string userId, string petId, integer mask)
		local record=self.States[userId]
		if self:GetPetGearDefinitionForPet(petId,"Cap")==nil or record==nil or mask<1 or mask>7 then return false end
		local pet=record.pets[petId] if pet==nil or not pet.Owned then return false end
		local before=pet.GearOwnedMask
		for _,bit in ipairs({1,2,4}) do if self:HasPetGearBit(mask,bit) and not self:HasPetGearBit(pet.GearOwnedMask,bit) then pet.GearOwnedMask=pet.GearOwnedMask+bit end end
		if pet.GearOwnedMask~=before then self:MarkDirty(record) end
		record.responsePetId=petId self:PushState(userId,"","") return true
	end

	@ExecSpace("ClientOnly")
	method void PreloadNativePetGearArtwork()
		self.NativePetGearReady=false local assets={} local seen={}
		for _,poses in pairs(self.NativePetGearOverlays) do for _,layers in pairs(poses) do for _,layer in pairs(layers) do if not seen[layer.ruid] then seen[layer.ruid]=true;table.insert(assets,layer.ruid) end end end end
		for _,defs in pairs(self.NativePetGearDefinitions) do for _,def in pairs(defs) do if not seen[def.icon] then seen[def.icon]=true;table.insert(assets,def.icon) end end end
		for _,poses in pairs(self.NativePetGearOverlays) do for base,_ in pairs(poses) do if not seen[base] then seen[base]=true;table.insert(assets,base) end end end
		_ResourceService:PreloadAsync(assets,function(results)
			if not isvalid(self) then return end
			local ready=true for _,status in pairs(results) do if status~=PreloadResultStatus.Success then ready=false end end
			if ready then for _,ruid in ipairs(assets) do local m=_CardManager:GetSpriteMetrics(ruid);if m.w<=0 or m.h<=0 then ready=false end end end
			self.NativePetGearReady=ready log("[VRF] PET-GEAR-ALL artwork ready="..tostring(ready).." textures="..#assets)
		end)
	end

	-- Body and removable equipment share one frame decision and prebound static renderers.
	-- The native animation remains a motion identifier, not a separately advancing visible body.
	@ExecSpace("ClientOnly")
	method string GetNativePetFrame(string clip, number elapsed)
		local frames=self.NativePetGearClips[clip]
		if frames==nil or #frames==0 then return clip end
		local delays=self.NativePetFrameDelays[clip] local total=0
		for i=1,#frames do total=total+(delays~=nil and delays[i] or 0.1) end
		local time=math.max(0,elapsed)%math.max(0.001,total)
		for i=1,#frames do
			time=time-(delays~=nil and delays[i] or 0.1)
			if time<0 then return frames[i] end
		end
		return frames[#frames]
	end

	@ExecSpace("ClientOnly")
	method void HideNativePetGearUI(Entity portrait)
		if not isvalid(portrait) then return end
		portrait.SpriteGUIRendererComponent.Enable=true
		local pool=(self._T.nativePetGearUI or {})[portrait.Id]
		if pool~=nil then for _,e in pairs(pool.actors) do if isvalid(e) then e.SpriteGUIRendererComponent.Color=Color(1,1,1,0) end end end
	end

	@ExecSpace("ClientOnly")
	method void RenderNativePetGearUI(Entity portrait, table entry)
		if not isvalid(portrait) or not self.NativePetGearReady then return end
		local poses=self.NativePetGearOverlays[entry.id] if poses==nil then self:HideNativePetGearUI(portrait);return end
		local mask=entry.progress~=nil and entry.progress.Owned and (entry.progress.GearEquippedMask or 0) or 0
		self._T.nativePetGearUI=self._T.nativePetGearUI or {} local pool=self._T.nativePetGearUI[portrait.Id]
		if pool~=nil and pool.petId~=entry.id then
			for _,e in pairs(pool.actors) do if isvalid(e) then e:Destroy() end end
			self._T.nativePetGearUI[portrait.Id]=nil pool=nil
		end
		if pool==nil then
			pool={portrait=portrait,petId=entry.id,actors={},baseActors={},creating=true,ready=false,warmFrames=0,warmStart=_UtilLogic.ElapsedSeconds,clip="",startedAt=_UtilLogic.ElapsedSeconds};self._T.nativePetGearUI[portrait.Id]=pool
			local textureList={} local seen={} local baseSet={}
			for base,_ in pairs(poses) do table.insert(textureList,base);seen[base]=true;baseSet[base]=true end
			for _,slot in ipairs({"coat","neck","hat"}) do for _,layers in pairs(poses) do local layer=layers[slot]
				if layer~=nil and not seen[layer.ruid] then seen[layer.ruid]=true;table.insert(textureList,layer.ruid) end
			end end
			for _,ruid in ipairs(textureList) do
				local template=_PetUI.PetGearSlots:GetChildByName("Cap"):GetChildByName("Icon")
				local e=_SpawnService:SpawnByEntity(template,"NativePetFrame",Vector3.zero,portrait,false)
				e.Enable=false local t=e.UITransformComponent;t.AnchorsMin=Vector2(.5,.5);t.AnchorsMax=Vector2(.5,.5);t.Pivot=Vector2(.5,.5);t.anchoredPosition=Vector2.zero;t.UIScale=Vector3(1,1,1);t.UIRotation=Vector3.zero;t.RectSize=Vector2(4,4)
				local r=e.SpriteGUIRendererComponent;r.ImageRUID=DataRef(ruid);r.Color=Color(1,1,1,1/255);r.Type=ImageType.Simple;r.PreserveSprite=PreserveSpriteType.None;r.LocalScale=Vector2(1,1);r.LocalPosition=Vector2.zero;r.RaycastTarget=false;r.Outline=false;r.DropShadow=false;r.PlayRate=0
				pool.actors[ruid]=e;if baseSet[ruid] then pool.baseActors[ruid]=e end;e.Enable=true
			end
			pool.creating=false
		end
		if pool.creating then return end
		local image=portrait.SpriteGUIRendererComponent local clip=tostring(image.ImageRUID.DataId) local now=_UtilLogic.ElapsedSeconds
		if pool.clip~=clip then pool.clip=clip;pool.startedAt=now;pool.age=0;pool.lastTick=now end
		pool.age=(pool.age or 0)+math.max(0,now-(pool.lastTick or now))*math.max(0,image.PlayRate);pool.lastTick=now
		local base=self:GetNativePetFrame(clip,pool.age)
		local m=self.NativePetGearSpriteMetrics[base] local layers=poses[base]
		if m==nil or layers==nil then self:HideNativePetGearUI(portrait);return end
		-- Disable only the original renderer; its child frame renderers remain active.
		-- This prevents an independently rendered body from getting ahead of the clothes.
		image.Enable=false
		if not pool.ready then
			if pool.lastWarm~=now then pool.lastWarm=now;pool.warmFrames=pool.warmFrames+1 end
			if pool.warmFrames<8 or now-pool.warmStart<.12 then return end
			for _,e in pairs(pool.actors) do e.SpriteGUIRendererComponent.Color=Color(1,1,1,0) end
			pool.ready=true
		end
		local native=image.PreserveSprite==PreserveSpriteType.NativeSize
		local sx=native and self:GetCustomPixelScale(portrait,image.LocalScale.x) or portrait.UITransformComponent.RectSize.x/m.w
		local sy=native and self:GetCustomPixelScale(portrait,image.LocalScale.y) or portrait.UITransformComponent.RectSize.y/m.h
		local px=native and m.px*m.w or m.w*.5 local py=native and (1-m.py)*m.h or m.h*.5
		local origin=image.LocalPosition
		local screen=_UILogic:WorldToScreenPosition(_UILogic:LocalUIToWorldPosition(origin,portrait.UITransformComponent))
		origin=_UILogic:ScreenToLocalUIPosition(Vector2(math.floor(screen.x+.5),math.floor(screen.y+.5)),portrait.UITransformComponent)
		local selected={}
		local descriptors={}
		if not(layers.coat~=nil and layers.coat.replacesBody==true and self:HasPetGearBit(mask,2))then table.insert(descriptors,{ruid=base,x=0,y=0,w=m.w,h=m.h})end
		for _,slot in ipairs({"coat","neck","hat"}) do local bit=slot=="hat" and 1 or(slot=="coat" and 2 or 4)
			if layers[slot]~=nil and self:HasPetGearBit(mask,bit) then table.insert(descriptors,layers[slot]) end
		end
		for _,d in ipairs(descriptors) do local e=pool.actors[d.ruid]
			local x=(d.x+d.w*.5-px)*sx local y=(py-d.y-d.h*.5)*sy
			local t=e.UITransformComponent;t.RectSize=Vector2(d.w*sx,d.h*sy);t.anchoredPosition=Vector2(origin.x+(image.FlipX and -x or x),origin.y+(image.FlipY and -y or y))
			local r=e.SpriteGUIRendererComponent;r.FlipX=image.FlipX;r.FlipY=image.FlipY;r.Color=image.Color;selected[d.ruid]=true
		end
		for ruid,_ in pairs(pool.selected or {}) do if not selected[ruid] then pool.actors[ruid].SpriteGUIRendererComponent.Color=Color(1,1,1,0) end end
		pool.selected=selected;pool.base=base;pool.mask=mask;pool.pixelScale=sx;pool.origin=origin;pool.entry=entry
	end

	@ExecSpace("ClientOnly")
	method void ClearNativePetGearUI()
		for _,pool in pairs(self._T.nativePetGearUI or {}) do
			if isvalid(pool.portrait) then pool.portrait.SpriteGUIRendererComponent.Enable=true end
			for _,e in pairs(pool.actors) do if isvalid(e) then e:Destroy() end end
		end
		self._T.nativePetGearUI={}
	end

	@ExecSpace("ClientOnly")
	method void ClearNativePetGearWorldPool()
		local pool=self._T.nativePetGearWorld
		if pool~=nil then for _,e in pairs(pool.actors) do if isvalid(e) then e:Destroy() end end end
		self._T.nativePetGearWorld=nil
	end

	@ExecSpace("ClientOnly")
	method void WarmNativePetGearWorldPool(number delta)
		if not self.NativePetGearReady then return end
		local player=_UserService.LocalPlayer;local map=isvalid(player) and player.CurrentMap or nil;if not isvalid(map) then return end
		local pool=self._T.nativePetGearWorld
		if pool~=nil and (pool.map~=map or not isvalid(pool.map)) then self:ClearNativePetGearWorldPool();pool=nil end
		if pool==nil then
			pool={map=map,actors={},expected={},creating=true,warming=true,ready=false,frames=0,elapsed=0};self._T.nativePetGearWorld=pool
			for _,poses in pairs(self.NativePetGearOverlays) do
				for base,_ in pairs(poses) do if not pool.expected[base] then pool.expected[base]=true;pool.actors[base]=self:SpawnPetSkillSprite(base,map,132) end end
				for _,slot in ipairs({"coat","neck","hat"}) do for _,layers in pairs(poses) do local d=layers[slot]
					if d~=nil and not pool.expected[d.ruid] then pool.expected[d.ruid]=true;pool.actors[d.ruid]=self:SpawnPetSkillSprite(d.ruid,map,135) end
				end end
			end
			pool.creating=false;pool.warming=false
		end
		if pool.creating or pool.warming then return end
		if not pool.ready then
			local p=_UILogic:ScreenToWorldPosition(Vector2(_UILogic.ScreenWidth*.5,20));local u=_UILogic:ScreenToWorldPosition(Vector2(_UILogic.ScreenWidth*.5+1,20));local pixel=math.abs(u.x-p.x);local loaded=true
			for _,e in pairs(pool.actors) do if not self:PlacePetCharmSprite(e,Vector3(p.x,p.y,0),4*pixel,0,1/255) then loaded=false end end
			pool.frames=loaded and pool.frames+1 or 0;pool.elapsed=loaded and pool.elapsed+math.min(.05,math.max(0,delta)) or 0
			if pool.frames>=8 and pool.elapsed>=.12 then for _,e in pairs(pool.actors) do e.SpriteRendererComponent.Color=Color(1,1,1,0) end;pool.ready=true end
		end
		local pending=self._T.pendingNativePetGearVisual
		if pool.ready and pending~=nil then self._T.pendingNativePetGearVisual=nil;self:StartPetSkillVisual(pending.petId,pending.zone,pending.run,pending.route,pending.anchor,pending.serial,pending.gearMask) end
	end

	@ExecSpace("ClientOnly")
	method void UpdateNativePetSkillGear(table v)
		local pool=self._T.nativePetGearWorld
		if pool==nil or not pool.ready or pool.map~=v.map then return end
		if not isvalid(v.body) then
			for _,e in pairs(pool.actors) do if isvalid(e) then e.SpriteRendererComponent.Color=Color(1,1,1,0) end end
			return
		end
		local poses=self.NativePetGearOverlays[v.id] if poses==nil then return end
		local r=v.body.SpriteRendererComponent local clip=r.SpriteRUID
		if v.nativeClip~=clip then v.nativeClip=clip;v.nativeFrameStart=v.age end
		local base=self:GetNativePetFrame(clip,v.age-(v.nativeFrameStart or 0));local m=self.NativePetGearSpriteMetrics[base];local layers=poses[base]
		if m==nil or layers==nil then return end
		r.Enable=false
		local transform=v.body.TransformComponent;local pos=transform.WorldPosition;local scale=transform.Scale;local rotation=transform.ZRotation;local theta=rotation*math.pi/180;local cosine=math.cos(theta);local sine=math.sin(theta)
		local descriptors={}
		if not(layers.coat~=nil and layers.coat.replacesBody==true and self:HasPetGearBit(v.gearMask or 0,2))then table.insert(descriptors,{ruid=base,x=0,y=0,w=m.w,h=m.h,body=true})end
		for _,slot in ipairs({"coat","neck","hat"}) do local bit=slot=="hat" and 1 or(slot=="coat" and 2 or 4)
			if layers[slot]~=nil and self:HasPetGearBit(v.gearMask or 0,bit) then table.insert(descriptors,layers[slot]) end
		end
		local selected={}
		for order,d in ipairs(descriptors) do local e=pool.actors[d.ruid]
			if isvalid(e) then
				local x=(d.x+d.w*.5-m.px*m.w)/m.ppu*scale.x*(r.FlipX and -1 or 1);local y=((1-m.py)*m.h-d.y-d.h*.5)/m.ppu*scale.y*(r.FlipY and -1 or 1)
				-- Original native sprites keep their own pivot. Only centered gear textures need the offset.
				if d.body then x=0;y=0 end
				e.TransformComponent.Scale=scale;e.TransformComponent.ZRotation=rotation;e.TransformComponent.WorldPosition=Vector3(pos.x+x*cosine-y*sine,pos.y+x*sine+y*cosine,pos.z)
				local er=e.SpriteRendererComponent;er.Color=r.Color;er.FlipX=r.FlipX;er.FlipY=r.FlipY;er.OrderInLayer=r.OrderInLayer+order-1;e.Enable=true;selected[d.ruid]=true
			end
		end
		for ruid,_ in pairs(pool.selected or {}) do if not selected[ruid] then pool.actors[ruid].SpriteRendererComponent.Color=Color(1,1,1,0) end end
		pool.selected=selected;v.nativeGearBase=base
	end

end
