	property string EnabledButtonRUID = "4384a214dae64683a7c0f92392c3ad87"
	property string DisabledButtonRUID = "929c7f14f3ef4d77a644f41c5f9a2bfd"
	property string UnequipButtonRUID = "f6b09cf25a7d457380be0174bd253286"
	property string EnabledArrowRUID = "280fd26304f7442fb742555a7a674fc9"
	property string DisabledArrowRUID = "0c25f4ba834745aba5ec24fe38d0bc1e"
	property string EnabledClaimRUID = "2cb4da8ece624bdda222d0d92dc48ad0"
	property string DisabledClaimRUID = "f3caa6aad0d2427eb44d0542c59e3f35"
	property integer SelectedPetIndex = 1
	property boolean GrowthWasVisible = false
	property number GrowthRevealStart = 0

	@ExecSpace("ClientOnly")
	method void BindClick(Entity entity, any callback)
		-- Every global UI subscription is paired with cleanup on editor reload.
		if not isvalid(entity) then return end
		local handle = entity:ConnectEvent(ButtonClickEvent, callback)
		table.insert(self.Handlers, {entity=entity, handle=handle})
	end

	@ExecSpace("ClientOnly")
	method void BuyEgg()
		if self.PetTutorialOpen then return end
		local entry=self:GetDisplayedPet() local pet=entry.progress
		if not entry.ready or (pet~=nil and pet.Owned) then return end
		if entry.productId=="" or entry.price<=0 then _UIToast:ShowMessage("PET_SHOP_PENDING") return end
		_WorldShopService:PromptPurchase(entry.productId)
	end

	@ExecSpace("ClientOnly")
	method void SetText(string name, string text)
		-- Dynamic copy always belongs to the panel's own text child.
		self.PetPanel:GetChildByName(name).TextGUIRendererComponent.Text = text
	end


	@ExecSpace("ClientOnly")
	method table ComputePetStats()
		local entry=self:GetDisplayedPet()
		return _PetLogic:GetPetStats(entry.id,entry.progress)
	end

	@ExecSpace("ClientOnly")
	method void FillStatPopup()
		if not isvalid(self.StatPopup) then return end
		local entry=self:GetDisplayedPet()
		local lines=_PetLogic:GetPetStatLines(entry.id,entry.progress)
		local keys={"MLUA_UIEQUIPPEDGEARPANEL_014","MLUA_UIEQUIPPEDGEARPANEL_016","MLUA_UIEQUIPPEDGEARPANEL_017","MLUA_UIEQUIPPEDGEARPANEL_013","MLUA_UIEQUIPPEDGEARPANEL_018"}
		local window=self.StatPopup:GetChildByName("Window")
		for i,line in ipairs(lines) do
			local row=window:GetChildByName("Row"..(i-1)) local name=row:GetChildByName("Name") local value=row:GetChildByName("Value")
			row:GetChildByName("Lock").Enable=not line.unlocked
			name.TextGUIRendererComponent.Text=line.unlocked and _LocalizationService:GetText(keys[line.kind]) or ("Lv. "..line.level)
			name.TextGUIRendererComponent.FontColor=line.unlocked and Color(0.86,0.9,0.96,1) or Color(0.55,0.58,0.64,1)
			name.UITransformComponent.anchoredPosition=Vector2(line.unlocked and -68 or -44,0)
			name.UITransformComponent.RectSize=Vector2(line.unlocked and 220 or 200,34)
			local text=string.format("%.2f",line.percent) text=string.gsub(text,"0+$","") text=string.gsub(text,"%.$","")
			value.TextGUIRendererComponent.Text=line.unlocked and ("+"..text.."%") or ""
		end
		local skill=_PetLogic:GetPetSkillInfo(entry.id)
		local row=window:GetChildByName("Row4")
		row:GetChildByName("Name").TextGUIRendererComponent.Text=skill.name
		row:GetChildByName("Value").TextGUIRendererComponent.Text=skill.interval
		window:GetChildByName("SkillDescription").TextGUIRendererComponent.Text=skill.description
		row:GetChildByName("Icon").SpriteGUIRendererComponent.ImageRUID=DataRef(skill.icon)
	end

	@ExecSpace("ClientOnly")
	method void OpenStatPopup()
		if self.PetTutorialOpen then return end
		if not self.PetMode or not isvalid(self.StatPopup) then return end
		self:CancelStoneTooltip() self:FillStatPopup() self.StatPopup.Enable=true
		_UILogic:SetSiblingIndex(self.StatPopup.UITransformComponent,100005)
		local entry=self:GetDisplayedPet() local stats=self:ComputePetStats()
		log("[VRF] PET-STATS opened id="..entry.id.." damage="..stats.atkPct.." crit="..stats.critRate)
	end

	@ExecSpace("ClientOnly")
	method void CloseStatPopup()
		if isvalid(self.StatPopup) then self.StatPopup.Enable=false end
	end

	@ExecSpace("ClientOnly")
	method void SetButton(string name, boolean enabled, string key)
		-- Unavailable actions use the same gray treatment as the game's reward buttons.
		local button = self.PetPanel:GetChildByName(name)
		button.ButtonComponent.Enable = enabled
		local ruid=enabled and self.EnabledButtonRUID or self.DisabledButtonRUID
		if name=="equip" and enabled and key=="PET_HOUSE_REST_TOGETHER" then ruid=self.UnequipButtonRUID end
		button.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid)
		button.SpriteGUIRendererComponent.Color = Color(1,1,1,1)
		if key ~= "" then button:GetChildByName("Label").TextGUIRendererComponent.Text = _LocalizationService:GetText(_PetLogic:GetPetMessageKey(self:GetDisplayedPet().id,key)) end
	end

	@ExecSpace("ClientOnly")
	method table GetDisplayedPet()
		local entries=_PetLogic:GetPetCatalog()
		self.SelectedPetIndex=math.max(1,math.min(#entries,self.SelectedPetIndex))
		return entries[self.SelectedPetIndex]
	end

	@ExecSpace("ClientOnly")
	method number GetPortraitY()
		-- Custom sprites and native clips share the same ground plane.
		local entry=self:GetDisplayedPet()
		local scale=entry.frames~=nil and _PetLogic:GetCustomPixelScale(self.PetDisplay:GetChildByName("Portrait"),entry.pixelScale) or 0
		return -150+(entry.footOffset or 0)*scale
	end

	@ExecSpace("ClientOnly")
	method void RefreshNavigation(boolean busy)
		local count=#_PetLogic:GetPetCatalog()
		for _,spec in ipairs({{"PrevPet",-1},{"NextPet",1}}) do
			local button=self.PetPanel:GetChildByName(spec[1])
			local target=self.SelectedPetIndex+spec[2]
			local enabled=not busy and target>=1 and target<=count
			button.ButtonComponent.Enable=enabled
			button.SpriteGUIRendererComponent.ImageRUID=DataRef(enabled and self.EnabledArrowRUID or self.DisabledArrowRUID)
		end
	end

	@ExecSpace("ClientOnly")
	method void MovePet(integer direction)
		if self.PetTutorialOpen then return end
		if not self.PetMode or (direction~=-1 and direction~=1) then return end
		if _UtilLogic.ElapsedSeconds<math.max(self.MotionUntil,self.WaitingUntil) then return end
		local entries=_PetLogic:GetPetCatalog()
		local nextIndex=self.SelectedPetIndex+direction
		if nextIndex<1 or nextIndex>#entries then return end
		self.SelectedPetIndex=nextIndex self.IdleRUID="" self.CustomFrameKey=""
		self.GaugeValues={} self.GaugeTargets={} self.ShownAffinity=0 self.GrowthWasVisible=false self.GrowthFraction=-1
		self:Refresh()
		log("[VRF] PET-HOUSE selection="..entries[nextIndex].id)
	end

	@ExecSpace("ClientOnly")
	method void SetGrowthAvailable(boolean available)
		local button=self.PetPanel:GetChildByName("rank")
		button.Enable=available
		if available and not self.GrowthWasVisible then
			self.GrowthRevealStart=_UtilLogic.ElapsedSeconds
			log("[VRF] PET-HOUSE growth button revealed")
		end
		self.GrowthWasVisible=available
		self:AnimateGrowth()
	end

	@ExecSpace("ClientOnly")
	method void AnimateGrowth()
		local button=self.PetPanel:GetChildByName("rank")
		if not button.Enable then button.UITransformComponent.UIScale=Vector3(1,1,1) return end
		local elapsed=math.max(0,_UtilLogic.ElapsedSeconds-self.GrowthRevealStart)
		local scale=1
		if elapsed<0.45 then
			local p=elapsed/0.45-1
			local bounce=1+2.70158*p*p*p+1.70158*p*p
			scale=0.86+0.14*bounce
		else scale=1+math.sin((elapsed-0.45)*4)*0.018 end
		button.UITransformComponent.UIScale=Vector3(scale,scale,1)
	end

	@ExecSpace("ClientOnly")
	method void Refresh()
		-- Paint the last server snapshot; loading never enables a purchase or care action.
		local ready = _PetLogic.ClientReady
		local entry=self:GetDisplayedPet()
		local pet=entry.progress or PetProgress()
		ready=entry.ready and pet~=nil
		local owned=ready and pet.Owned
		local name=_LocalizationService:GetText(entry.nameKey)
		self.PetDisplay:GetChildByName("Name").TextGUIRendererComponent.Text = _LocalizationService:GetTextFormat("PET_HOUSE_NAME_FORMAT",owned and pet.Level or 1,name)
		self.PetDisplay:GetChildByName("State").TextGUIRendererComponent.Text = _LocalizationService:GetText(owned and "PET_OWNED" or "PET_PREVIEW")
		local portrait = self.PetDisplay:GetChildByName("Portrait").SpriteGUIRendererComponent
		portrait.Color = Color(1,1,1,owned and 1 or 0.55)
		self.PetPanel:GetChildByName("test").Enable = Environment:IsMakerPlay() and ready and not owned and (entry.frames==nil or _PetLogic.TtungttangReady)
		self.PetPanel:GetChildByName("buy").Enable = not owned
		self.PetPanel:GetChildByName("equip").Enable = owned
		self.PetPanel:GetChildByName("rank").Enable = owned
		self.PetPanel:GetChildByName("StoneCaption").Enable=false
		if isvalid(self.StoneTouchArea) then self.StoneTouchArea.Enable=owned end
		for _, child in ipairs({"StoneIcon", "StoneCount"}) do
			self.PetPanel:GetChildByName(child).Enable = owned
		end
		local maxLevel = owned and _PetLogic:GetMaxLevel(pet.Rank) or 10
		local level = owned and pet.Level or 1
		local xp = owned and pet.XP or 0
		local need = _PetLogic:GetXPNeeded(level)
		local bonus = _PetLogic:GetBonusPercent(entry.id,level,owned and pet.Rank or 0)
		self:SetText("Level", _LocalizationService:GetTextFormat("PET_LEVEL_FORMAT", level, maxLevel))
		self:SetText("Bonus", _LocalizationService:GetTextFormat(entry.bonusKey,string.format("%.2f",bonus)))
		if isvalid(self.StatPopup) and self.StatPopup.Enable then self:FillStatPopup() end
		self:SetText("XP", _LocalizationService:GetTextFormat("PET_XP_FORMAT", xp, need))
		self:RefreshGrowthProgress(xp,need,owned and level>=maxLevel)
		self:SetText("Energy", tostring(ready and pet.Energy or 0) .. " / 1000")
		self:SetText("FullValue", tostring(owned and pet.Fullness or 0) .. "%")
		self:SetText("CleanValue", tostring(owned and pet.Cleanliness or 0) .. "%")
		self:SetText("MoodValue", tostring(owned and pet.Mood or 0) .. "%")
		self:SetText("StoneCount", tostring(ready and pet.Stones or 0))
		local fill = self.PetPanel:GetChildByName("EnergyBar"):GetChildByName("Fill")
		fill.Enable = ready and pet.Energy > 0
		fill.UITransformComponent.RectSize = Vector2(500 * (ready and pet.Energy or 0) / 1000, 12)
		local busy = _UtilLogic.ElapsedSeconds < math.max(self.MotionUntil, self.WaitingUntil)
		local canGrow = owned and not busy
		for _,action in ipairs({"feed","wash","walk","inject"}) do
			local choice = _PetLogic:GetCareConfig(action)
			local block = owned and _PetLogic:GetCareBlockReason(pet,action) or "PET_NO_PET"
			local loaded = (entry.frames==nil or _PetLogic.TtungttangReady) and (action ~= "feed" or entry.nativeWalk or (entry.frames~=nil and _PetLogic.TtungttangReady) or self.FeedingReady) and (action ~= "walk" or self.WalkReady) and ((action ~= "wash" and action ~= "inject") or self.CareBackdropReady) and (entry.id~="5000498" or action~="feed" or self.DuckyBowlReady) and (entry.id~="oduck" or action~="feed" or self.OduckPoolReady)
			local keys = {feed="PET_FEED",wash="PET_WASH",walk="PET_WALK",inject="PET_INJECT"}
			self:SetButton(action,canGrow and loaded and block=="" and pet.Energy>=choice.energy,keys[action])
			local button = self.PetPanel:GetChildByName(action)
			-- Energy cost sits on the name line, e.g. "먹이(-100)".
			local label = button:GetChildByName("Label").TextGUIRendererComponent
			label.Text = label.Text .. "(-" .. tostring(choice.energy) .. ")"
			button:GetChildByName("Cost").Enable = false
			button:GetChildByName("Effect").TextGUIRendererComponent.Text = block ~= "" and _LocalizationService:GetText(_PetLogic:GetPetMessageKey(entry.id,block)) or _LocalizationService:GetTextFormat("PET_CARE_EFFECT",_LocalizationService:GetText(choice.label),choice.gain,choice.fatigue)
		end
		local sleepBlock = owned and _PetLogic:GetCareBlockReason(pet,"sleep") or "PET_NO_PET"
		self:SetButton("sleep",canGrow and self.SleepCushionReady and (entry.frames==nil or _PetLogic.TtungttangReady) and sleepBlock=="","PET_SLEEP")
		local sleepLabel = self.PetPanel:GetChildByName("sleep"):GetChildByName("Label").TextGUIRendererComponent
		sleepLabel.Text = sleepLabel.Text .. "(+" .. tostring(_PetLogic.SleepEnergyRecovery) .. ")"
		self.PetPanel:GetChildByName("sleep"):GetChildByName("Cost").Enable = false
		self.PetPanel:GetChildByName("sleep"):GetChildByName("Effect").TextGUIRendererComponent.Text = sleepBlock ~= "" and _LocalizationService:GetText(sleepBlock) or _LocalizationService:GetTextFormat("PET_SLEEP_EFFECT",_PetLogic.SleepFatigueRecovery)
		self:RefreshNeeds(owned,pet)
		self:RefreshAffinity(owned,pet,busy)
		self:SetButton("equip", owned and not busy, pet.Equipped and "PET_HOUSE_REST_TOGETHER" or "PET_HOUSE_JOIN")
		self:RefreshNavigation(busy)
		local cost = _PetLogic.RankCosts[pet.Rank + 1]
		local growthReady=owned and not busy and level>=maxLevel and cost~=nil and pet.Stones>=cost
		self:SetButton("rank",growthReady,"PET_HOUSE_GROW")
		self.PetPanel:GetChildByName("rank"):GetChildByName("Count").TextGUIRendererComponent.Text="x"..tostring(cost or 0)
		self:SetGrowthAvailable(growthReady)
		if owned and level>=maxLevel then
			self:SetText("XP",_LocalizationService:GetText(cost==nil and "PET_MAX_RANK" or (growthReady and "PET_HOUSE_GROW_READY" or "PET_HOUSE_GROW_WAIT")))
		end
		local buy = self.PetPanel:GetChildByName("buy")
		self:SetButton("buy", ready and entry.productId ~= "" and entry.price > 0, entry.productId == "" and "PET_COMING_SOON" or "PET_BUY_EGG")
		if entry.productId ~= "" and entry.price > 0 then
			buy:GetChildByName("Label").TextGUIRendererComponent.Text = _LocalizationService:GetTextFormat("PET_BUY_PRICE",entry.price)
		end
		local stateKey = ready and "PET_PREVIEW" or "PET_LOADING"
		if owned then stateKey = _PetLogic.ClientTest and "PET_TEST_MODE" or (pet.Equipped and "PET_EQUIPPED" or "PET_OWNED") end
		self:SetText("Status", _LocalizationService:GetText(_PetLogic:GetPetMessageKey(entry.id,stateKey)))
		self.PetDisplay:GetChildByName("State").TextGUIRendererComponent.Text = _LocalizationService:GetText(_PetLogic:GetPetMessageKey(entry.id,stateKey))
		if self.Motion == "walk" then self:SetWalking(true,_UtilLogic.ElapsedSeconds-self.MotionStart) end
		self:SetActionScenery(self.Motion,_UtilLogic.ElapsedSeconds-self.MotionStart)
		self.ShownRevision = _PetLogic.ClientRevision
		if self.MotionUntil == 0 then self:PlayIdle() end
	end

	@ExecSpace("ClientOnly")
	method void RefreshNeeds(boolean owned, any pet)
		local meters = self.PetDisplay:GetChildByName("CareMeters")
		meters.Enable = owned
		if not owned then self.GaugeValues={} self.GaugeTargets={} return end
		for _,spec in ipairs({{"Fullness","PET_FULLNESS"},{"Cleanliness","PET_CLEANLINESS"},{"Mood","PET_MOOD"},{"Fatigue","PET_FATIGUE"},{"Health","PET_HEALTH"}}) do
			local name=spec[1] local value=math.max(0,math.min(100,pet[name] or 0))
			self.GaugeTargets[name]=value
			if self.GaugeValues[name] == nil then self.GaugeValues[name]=value end
			local gauge=meters:GetChildByName(name)
			gauge:GetChildByName("Label").TextGUIRendererComponent.Text = _LocalizationService:GetTextFormat("PET_NEED_VALUE",_LocalizationService:GetText(spec[2]),value)
		end
		self:AnimateNeeds(0)
	end

	@ExecSpace("ClientOnly")
	method void AnimateNeeds(number delta)
		local meters = self.PetDisplay:GetChildByName("CareMeters")
		if not meters.Enable then return end
		for _,name in ipairs({"Fullness","Cleanliness","Mood","Fatigue","Health"}) do
			local value = self.GaugeValues[name] or 0 local target = self.GaugeTargets[name] or 0
			value = value + (target-value)*math.min(1,delta*10)
			if math.abs(target-value)<0.05 then value=target end
			self.GaugeValues[name]=value
			local fill=meters:GetChildByName(name):GetChildByName("Track"):GetChildByName("Fill")
			fill.Enable=value>0
			fill.UITransformComponent.RectSize=Vector2(190*value/100,8)
			if name=="Fatigue" then fill.SpriteGUIRendererComponent.Color = target>=80 and Color(1,0.37,0.28,1) or Color(0.79,0.57,0.87,1) end
		end
	end


	@ExecSpace("ClientOnly")
	method void RefreshAffinity(boolean owned, any pet, boolean busy)
		local dial=self.PetDisplay:GetChildByName("AffinityDial")
		dial.Enable=owned
		if not owned then self.ShownAffinity=0 return end
		local value=pet.Affinity or 0
		dial:GetChildByName("Caption").TextGUIRendererComponent.Text=_LocalizationService:GetText("PET_AFFINITY")
		dial:GetChildByName("Value").TextGUIRendererComponent.Text=tostring(value).." / 100"
		dial:GetChildByName("Hint").TextGUIRendererComponent.Text=_LocalizationService:GetText("PET_HEART_DAILY_HINT")
		for tier=1,3 do
			local reward=dial:GetChildByName("Reward"..tostring(tier))
			local claimed=_PetLogic:IsHeartClaimed(pet,tier)
			local unlocked=value>=_PetLogic.HeartThresholds[tier]
			local claim=reward:GetChildByName("Claim")
			reward:GetChildByName("Icon").Enable=not unlocked and not claimed
			reward:GetChildByName("Count").Enable=not unlocked and not claimed
			claim.Enable=unlocked or claimed
			claim.ButtonComponent.Enable=unlocked and not claimed and not busy
			claim.SpriteGUIRendererComponent.ImageRUID=DataRef((busy or claimed) and self.DisabledClaimRUID or self.EnabledClaimRUID)
			claim.SpriteGUIRendererComponent.Color=Color(1,1,1,1)
			claim:GetChildByName("Label").TextGUIRendererComponent.Text=_LocalizationService:GetText(claimed and "PET_HEART_COMPLETE" or "PET_HEART_CLAIM")
			reward:GetChildByName("Threshold").TextGUIRendererComponent.Text=tostring(_PetLogic.HeartThresholds[tier])
		end
		self:AnimateAffinity(0)
	end

	@ExecSpace("ClientOnly")
	method void AnimateAffinity(number delta)
		local dial=self.PetDisplay:GetChildByName("AffinityDial")
		if not dial.Enable then return end
		local pet=self:GetDisplayedPet().progress
		local target=math.max(0,math.min(100,pet~=nil and pet.Affinity or 0))
		self.ShownAffinity=self.ShownAffinity+(target-self.ShownAffinity)*math.min(1,delta*6)
		if math.abs(target-self.ShownAffinity)<0.05 then self.ShownAffinity=target end
		local fill=dial:GetChildByName("Fill")
		fill.Enable=self.ShownAffinity>0
		fill.UITransformComponent.RectSize=Vector2(21,268.3333333333*self.ShownAffinity/100)
		local pulse=target>=100 and (1+math.sin(_UtilLogic.ElapsedSeconds*4)*0.015) or 1
		dial:GetChildByName("Frame").UITransformComponent.UIScale=Vector3(pulse,pulse,1)
	end

	@ExecSpace("ClientOnly")
	method void SetInjection(boolean active, number elapsed)
		local fx=self.PetDisplay:GetChildByName("Injection") fx.Enable=active
		if not active then self.InjectionPhase=-1 return end
		local portrait=self.PetDisplay:GetChildByName("Portrait")
		local phase=elapsed<1.2 and 0 or (elapsed<2.5 and 1 or 2)
		if phase~=self.InjectionPhase then
			self.InjectionPhase=phase
			if self:GetDisplayedPet().frames==nil then self:PlayPortrait(self:GetDisplayedPet().motions[phase==0 and "what" or (phase==1 and "cry" or "love")]) end
		end
		local approach=math.min(1,elapsed/1.2) approach=approach*approach*(3-2*approach)
		local retreat=math.max(0,math.min(1,(elapsed-2.2)/0.7))
		local syringe=fx:GetChildByName("Syringe")
		syringe.UITransformComponent.anchoredPosition=Vector2(250-105*approach+85*retreat,-32)
		syringe.UITransformComponent.UIRotation=Vector3(0,0,90+math.sin(elapsed*5)*2)
		syringe.SpriteGUIRendererComponent.Color=Color(1,1,1,math.min(1,elapsed/0.25)*(1-retreat))
		local recoil=math.max(0,math.min(1,(elapsed-1.2)/0.28))
		local flinch=phase==1 and math.sin(recoil*math.pi)*0.75 or 0
		-- Custom pixel pets carry one recoil in their frames; never jitter the whole texture.
		if self:GetDisplayedPet().frames~=nil then flinch=0 end
		portrait.UITransformComponent.anchoredPosition=Vector2(flinch*3,self:GetPortraitY()-math.abs(flinch)*2)
		for i=1,6 do
			local particle=fx:GetChildByName("Recovery"..i)
			local age=elapsed-2.4-i*0.11
			particle.Enable=age>=0 and age<2.2
			if particle.Enable then
				particle.UITransformComponent.anchoredPosition=Vector2(math.sin(i*13)*80,-65+age*75)
				particle.TextGUIRendererComponent.FontColor=Color(0.54,1,0.69,math.sin(age/2.2*math.pi)*0.85)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void PlayIdle()
		-- Needs affect expression, never take away the pet's earned combat bonus.
		local pose = "stand"
		local entry=self:GetDisplayedPet()
		local pet=entry.progress
		if pet ~= nil and pet.Owned then
			if (pet.Fatigue or 0) >= 80 then pose = "rest"
			elseif pet.Fullness < 30 then pose = "hungry"
			elseif pet.Mood < 30 then pose = "cry"
			elseif pet.Cleanliness < 30 then pose = "angry" end
		end
		self.CustomIdlePose=pose
		local ruid = entry.motions[pose] or entry.stand
		if self.IdleRUID == ruid then return end
		self.IdleRUID = ruid self.IdleAnimationStart=_UtilLogic.ElapsedSeconds
		local image = self.PetDisplay:GetChildByName("Portrait").SpriteGUIRendererComponent
		image.FlipX = false
		self.PetDisplay:GetChildByName("Portrait").UITransformComponent.anchoredPosition = Vector2(0,self:GetPortraitY())
		self:PlayPortrait(ruid)
	end


	@ExecSpace("ClientOnly")
	method void InitializeArtwork()
		-- Keep the original pet clips; retire every generated overlay, including cached UI children.
		local icon = self.PetButton:GetChildByName("Icon")
		icon.UITransformComponent.RectSize = Vector2(134,134)
		icon.UITransformComponent.anchoredPosition = Vector2(0,0)
		icon.SpriteGUIRendererComponent.ImageRUID = DataRef("5a92fc6b08a74049b46186bab0b049db")
		icon.SpriteGUIRendererComponent.PreserveSprite = PreserveSpriteType.None
		icon.SpriteGUIRendererComponent.LocalScale = Vector2(1,1)
		icon.SpriteGUIRendererComponent.LocalPosition = Vector2(0,0)
		local food = self.PetDisplay:GetChildByName("Food")
		food.Enable = false
		local bowl = food:GetChildByName("Bowl")
		if isvalid(bowl) then bowl.Enable = false end
		for i = 1, 16 do
			local pose = food:GetChildByName("Pose" .. i)
			if isvalid(pose) then pose.Enable = false end
			local bite = food:GetChildByName("Bite" .. i)
			if isvalid(bite) then bite.Enable = false end
		end
		self:InitializeSleepCushion()
		log("[VRF] PET-HOUSE original pixel clips only; generated feeding overlays disabled")
	end


	@ExecSpace("ClientOnly")
	method Entity WalkLayer(Entity parent, string name, string ruid, number width, number height, number x, number y)
		-- Scenery shares a clipped UI viewport; it never touches the actual combat map.
		local layer = _SpawnService:SpawnByEntity(self.PetDisplay:GetChildByName("Portrait"), name, Vector3(0,0,0), parent, false)
		local transform = layer.UITransformComponent
		transform.Pivot = Vector2(0.5,0.5)
		transform.AnchorsMin = Vector2(0.5,0.5) transform.AnchorsMax = Vector2(0.5,0.5)
		transform.UIScale = Vector3(1,1,1) transform.UIRotation = Vector3(0,0,0)
		transform.RectSize = Vector2(width,height) transform.anchoredPosition = Vector2(x,y)
		local image = layer.SpriteGUIRendererComponent
		image.PreserveSprite = PreserveSpriteType.None image.LocalScale = Vector2(1,1) image.LocalPosition = Vector2(0,0)
		image.Color = Color(1,1,1,1) image.FlipX = false image.FlipY = false
		image.RaycastTarget = false image.DropShadow = false image.Type = ImageType.Simple
		image.ImageRUID = DataRef(ruid) layer.Enable = true
		self.WalkLayers[name] = layer
		return layer
	end

	@ExecSpace("ClientOnly")
	method Entity WalkText(Entity parent, string name, string text, number size, number width, number height, number x, number y)
		local label = _SpawnService:SpawnByEntity(self.PetDisplay:GetChildByName("State"), name, Vector3(0,0,0), parent, false)
		label.UITransformComponent.RectSize = Vector2(width,height)
		label.UITransformComponent.anchoredPosition = Vector2(x,y)
		label.UITransformComponent.UIScale = Vector3(1,1,1)
		local font = label.TextGUIRendererComponent
		font.Text = text font.BestFit = false font.SizeFit = false font.FontSize = size
		font.Font = "Default" font.FontColor = Color(1,1,1,1) font.OutlineColor = Color(0.22,0.12,0.04,1) font.OutlineWidth = 0.08
		label.SpriteGUIRendererComponent.Enable=false
		label.Enable = true
		return label
	end

	@ExecSpace("ClientOnly")
	method void InitializeSleepCushion()
		if isvalid(self.SleepCushion) then return end
		local portrait=self.PetDisplay:GetChildByName("Portrait")
		local index=_UILogic:GetSiblingIndex(portrait.UITransformComponent)
		local bed=self:WalkLayer(self.PetDisplay,"SleepCushion",self.SleepCushionRUID,408.888888889,408.888888889,0,-82)
		_UILogic:SetSiblingIndex(bed.UITransformComponent,index)
		self.SleepCushion=bed bed.Enable=false self.SleepCushionReady=false
		_ResourceService:PreloadAsync({self.SleepCushionRUID},function(results)
			self.SleepCushionReady=true
			for _,status in pairs(results) do if status~=PreloadResultStatus.Success then self.SleepCushionReady=false end end
			log("[VRF] PET-SLEEP cushion ready="..tostring(self.SleepCushionReady))
			if self.PetMode then self:Refresh() end
		end)
	end

	@ExecSpace("ClientOnly")
	method void SetSleepCushion(boolean active, number elapsed)
		if not isvalid(self.SleepCushion) then return end
		self.SleepCushion.Enable=active and self.SleepCushionReady
		if not self.SleepCushion.Enable then return end
		local duration=_PetLogic.SleepDuration
		local fade=math.max(0,math.min(1,elapsed/0.24,(duration-elapsed)/0.28))
		fade=fade*fade*(3-2*fade)
		self.SleepCushion.SpriteGUIRendererComponent.Color=Color(1,1,1,fade)
		local scale=0.96+fade*0.04
		self.SleepCushion.UITransformComponent.UIScale=Vector3(scale,scale,1)
		self.PetDisplay:GetChildByName("Portrait").UITransformComponent.anchoredPosition=Vector2(0,self:GetPortraitY()+24*fade)
	end

	@ExecSpace("ClientOnly")
	method void InitializeActionScenery()
		-- This opening is measured inside the room image; the header, gold rim and footer stay visible.
		if isvalid(self.ActivityScene) then return end
		local scene=self:WalkLayer(self.PetPanel,"ActivityScene",self.BathroomRUID,1580,540,0,8)
		scene.SpriteGUIRendererComponent.Enable=false
		local mask=scene:AddComponent(MaskComponent)
		mask.Shape=MaskShape.Rect mask.Softness=Vector2Int(0,0)
		local group=scene:AddComponent(CanvasGroupComponent)
		group.BlocksRaycasts=false group.Interactable=false group.GroupAlpha=0
		self.ActivityScene=scene
		_UILogic:SetSiblingIndex(scene.UITransformComponent,0)
		self.CareBackdrop=self:WalkLayer(scene,"CareBackdrop",self.BathroomRUID,1580,540,0,0)
		self.ShownBackdropRUID=self.BathroomRUID
		self.CareBackdrop.Enable=false scene.Enable=false
		local jet=self.PetDisplay:GetChildByName("Water"):GetChildByName("Jet")
		jet.UITransformComponent.RectSize=Vector2(100,240)
		jet.UITransformComponent.anchoredPosition=Vector2(0,-35)
		self.CareBackdropReady=false
		_ResourceService:PreloadAsync({self.BathroomRUID,self.ClinicRUID},function(results)
			self.CareBackdropReady=true
			for _,result in pairs(results) do if result~=PreloadResultStatus.Success then self.CareBackdropReady=false end end
			log("[VRF] PET-SCENERY bathroom/clinic ready="..tostring(self.CareBackdropReady))
			if self.PetMode then self:Refresh() end
		end)
	end

	@ExecSpace("ClientOnly")
	method void SetActionScenery(string action, number elapsed)
		if not isvalid(self.ActivityScene) then return end
		local care=(action=="wash" or action=="inject") and self.CareBackdropReady
		local walking=action=="walk" and self.WalkReady
		self.ActivityScene.Enable=care or walking
		self.CareBackdrop.Enable=care
		local current=(care or walking) and action or ""
		if self.SceneAction~=current then
			self.SceneAction=current
			log("[VRF] PET-SCENERY action="..(current~="" and current or "room"))
		end
		if not care and not walking then self.ActivityScene.CanvasGroupComponent.GroupAlpha=0 return end
		if care then
			local ruid=action=="wash" and self.BathroomRUID or self.ClinicRUID
			if self.ShownBackdropRUID~=ruid then
				self.ShownBackdropRUID=ruid
				self.CareBackdrop.SpriteGUIRendererComponent.ImageRUID=DataRef(ruid)
			end
		end
		local duration=_PetLogic:GetCareDuration(action)
		local fade=math.max(0,math.min(1,elapsed/0.18,(duration-elapsed)/0.18))
		self.ActivityScene.CanvasGroupComponent.GroupAlpha=fade*fade*(3-2*fade)
	end


	@ExecSpace("ClientOnly")
	method void InitializeWalkArtwork()
		-- Three complete side-view landscapes replace the mismatched floor/house collage.
		if isvalid(self.WalkScene) then return end
		local assets={}
		for _,ruid in ipairs(self.WalkBackdropRUIDs) do table.insert(assets,ruid) end
		for _,ruid in ipairs(self.CompanionFrameRUIDs) do table.insert(assets,ruid) end
		table.insert(assets,self.HappyFaceRUID)
		table.insert(assets,"cbb2e71011a543ef862053f86bcfc847")
		local scene=self:WalkLayer(self.ActivityScene,"WalkScene",self.WalkBackdropRUIDs[1],1580,540,0,0)
		scene.SpriteGUIRendererComponent.Enable=false
		self.WalkScene=scene
		_UILogic:SetSiblingIndex(scene.UITransformComponent,1)
		self:WalkLayer(scene,"Road",self.WalkBackdropRUIDs[1],1580,540,0,0)
		local nextRoad=self:WalkLayer(scene,"RoadNext",self.WalkBackdropRUIDs[1],1580,540,1580,0)
		nextRoad.SpriteGUIRendererComponent.FlipX=true
		-- Full-body sprite is naturally cropped by the room viewport: legs through upper torso.
		self:WalkLayer(scene,"Companion",self.CompanionFrameRUIDs[1],726,1194.6,250,340.3)
		self:WalkLayer(scene,"Bush","cbb2e71011a543ef862053f86bcfc847",225,36,475,-153)
		for i=1,7 do
		 local dust=self:WalkText(scene,"Dirt"..i,"●",14,24,24,0,0)
		 dust.TextGUIRendererComponent.FontColor=Color(0.58,0.36,0.14,1)
		 self.WalkLayers["Dirt"..i]=dust dust.Enable=false
		end
		local notice=self:WalkText(self.PetDisplay,"WalkNotice","●",98,110,110,200,-20)
		self:WalkText(notice,"Tail","◀",26,36,32,-44,-4)
		local mark=self:WalkText(notice,"Mark","!",52,50,65,0,4)
		mark.TextGUIRendererComponent.FontColor=Color(1,0.3,0.1,1)
		self.WalkNotice=notice notice.Enable=false
		notice.UITransformComponent.UIScale=Vector3(0.7,0.7,1)
		self.WalkReward=self:WalkLayer(self.PetDisplay,"WalkReward","52df3f22bb014921a232021a48a1279b",72,72,0,0)
		self.WalkReward.Enable=false
		-- Only the face is replaced; all original walking bodies, colors and scale stay native.
		local scale=self.PortraitPixelScale
		local face=self:WalkLayer(self.PetDisplay:GetChildByName("Portrait"),"WalkSmile",self.HappyFaceRUID,21*scale,10*scale,3.5*scale,-1*scale)
		face.SpriteGUIRendererComponent.Enable=false
		local mask=face:AddComponent(MaskComponent)
		mask.Shape=MaskShape.Rect mask.Softness=Vector2Int(0,0)
		local smile=self:WalkLayer(face,"Mouth",self.HappyFaceRUID,36*scale,36*scale,-3.5*scale,1*scale)
		smile.SpriteGUIRendererComponent.FlipX=true
		self.WalkSmile=face face.Enable=false
		for _,ruid in ipairs(self.WalkFrameRUIDs) do table.insert(assets,ruid) end
		scene.Enable=false self.WalkReady=false self.WalkShownRoute=0
		_ResourceService:PreloadAsync(assets,function(results)
		 self.WalkReady=true
		 for _,result in pairs(results) do if result~=PreloadResultStatus.Success then self.WalkReady=false end end
		 log("[VRF] PET-WALK-V2 landscapes/companion/face ready="..tostring(self.WalkReady))
		 if self.PetMode then self:Refresh() end
		end)
	end

	@ExecSpace("ClientOnly")
	method void SetWalkPlan(integer token, integer route, boolean found, string icon, string message)
		-- Only a server reply supplies a discovery; duplicate plans cannot reveal loot twice.
		if token <= self.WalkPlanToken then return end
		self.WalkPlanToken = token
		self.WalkPlan = {route=math.max(1,math.min(3,route)),found=found,icon=icon,message=message,revealed=false}
		if not self.PetMode then self:ShowWalkLoot() end
		log("[VRF] PET-WALK plan route="..route.." found="..tostring(found))
	end

	@ExecSpace("ClientOnly")
	method void ShowWalkLoot()
		local plan = self.WalkPlan
		if plan == nil or not plan.found or plan.revealed then return end
		plan.revealed = true
		if plan.message ~= "" then _UIToast:ShowMessage(plan.message) end
		log("[VRF] PET-WALK discovery revealed")
	end


	@ExecSpace("ClientOnly")
	method number WalkTravel(number elapsed, boolean found)
		-- Integrate eased walking speed: scenery pauses from surprise through the happy find.
		local t = math.max(0,math.min(12,elapsed))
		local speed = 125 local ramp = 0.4
		local function forward(seconds)
		 if seconds<=0 then return 0 end
		 if seconds<ramp then
		  local u=seconds/ramp
		  return speed*ramp*(u*u*u-u*u*u*u/2)
		 end
		 return speed*(seconds-ramp/2)
		end
		local distance = forward(t)
		if found and t>=3.2 then
		 local u=math.min(1,(t-3.2)/ramp)
		 distance=forward(3.2)+speed*ramp*(u-u*u*u+u*u*u*u/2)
		 if t>7.6 then distance=distance+forward(t-7.6) end
		end
		if t>11.6 then
		 local u=(t-11.6)/ramp
		 distance=distance-speed*ramp*(u*u*u-u*u*u*u/2)
		end
		return distance
	end

	@ExecSpace("ClientOnly")
	method void ScrollWalkLayer(string name, boolean active, number distance, number speedRatio, number width, number y)
		-- The reflected neighbor joins the same edge; two copies cover the entire twelve-second walk.
		local layer=self.WalkLayers[name] local nextLayer=self.WalkLayers[name.."Next"]
		layer.Enable=active nextLayer.Enable=active
		layer.UITransformComponent.anchoredPosition=Vector2(-distance*speedRatio,y)
		nextLayer.UITransformComponent.anchoredPosition=Vector2(width-distance*speedRatio,y)
	end

	@ExecSpace("ClientOnly")
	method void SetWalking(boolean active, number elapsed)
		if not isvalid(self.WalkScene) then return end
		self.WalkScene.Enable=active
		self.WalkNotice.Enable=false self.WalkReward.Enable=false
		if not active then
		 self.WalkPhase=-1 self.WalkFrame=0 self.CompanionFrame=0
		 if isvalid(self.WalkSmile) then self.WalkSmile.Enable=false end
		 for i=1,7 do self.WalkLayers["Dirt"..i].Enable=false end
		 return
		end
		local plan=self.WalkPlan or {route=1,found=false}
		local route=plan.route local found=plan.found
		local t=math.max(0,math.min(12,elapsed))
		local distance=self:WalkTravel(t,found)
		if self.WalkShownRoute~=route then
		 self.WalkShownRoute=route
		 self.WalkLayers.Road.SpriteGUIRendererComponent.ImageRUID=DataRef(self.WalkBackdropRUIDs[route])
		 self.WalkLayers.RoadNext.SpriteGUIRendererComponent.ImageRUID=DataRef(self.WalkBackdropRUIDs[route])
		end
		self:ScrollWalkLayer("Road",true,distance,1,1580,0)
		local noticing=found and t>=3.6 and t<4.2
		local digging=found and t>=4.2 and t<6.8
		local celebrating=found and t>=6.8 and t<7.6
		local jump=0
		for _,start in ipairs(found and {0.75,2.3,6.95,8.2,10.1} or {0.75,2.3,8.2,10.1}) do
		 local p=(t-start)/0.65
		 if p>0 and p<1 then jump=math.max(jump,4*self:GetWalkJumpHeight()*p*(1-p)) end
		end
		local phase=noticing and 1 or (digging and 2 or ((celebrating or jump>0) and 3 or 0))
		local portrait=self.PetDisplay:GetChildByName("Portrait")
		if phase~=self.WalkPhase then
		 self.WalkPhase=phase
		 log("[VRF] PET-WALK-SCROLL phase="..phase.." distance="..distance)
		end
		local entry=self:GetDisplayedPet()
		local scale=entry.frames~=nil and _PetLogic:GetCustomPixelScale(portrait,entry.pixelScale) or self.PortraitPixelScale
		local canvas=entry.canvas or 36
		local frame=math.floor((digging and (t-4.2)*1.55 or t)/0.15)%4+1
		if noticing or celebrating or jump>0 then frame=1 end
		if entry.frames~=nil then
			local pose=noticing and "what" or (digging and "sniff" or (celebrating and "love" or "move"))
			self:RenderCustomPose(pose,t)
			self.WalkSmile.Enable=false
		elseif entry.nativeWalk then
			local pose=noticing and "what" or (digging and "dung" or (celebrating and "love" or "move"))
			local key=entry.id..":"..pose
			if self.CustomFrameKey~=key then self.CustomFrameKey=key self:PlayPortrait(entry.motions[pose]) end
			self.WalkSmile.Enable=false
		elseif frame~=self.WalkFrame then
			self.WalkFrame=frame portrait.SpriteGUIRendererComponent.ImageRUID=DataRef(self.WalkFrameRUIDs[frame])
		end
		if not entry.nativeWalk then
			portrait.SpriteGUIRendererComponent.PreserveSprite=PreserveSpriteType.None
			portrait.SpriteGUIRendererComponent.LocalScale=Vector2(1,1)
			portrait.SpriteGUIRendererComponent.LocalPosition=Vector2(0,0)
			if portrait.UITransformComponent.RectSize.x~=canvas*scale then portrait.UITransformComponent.RectSize=Vector2(canvas*scale,canvas*scale) end
			if entry.id=="5002617" then
				self.WalkSmile.Enable=true
				self.WalkSmile.UITransformComponent.anchoredPosition=Vector2(3.5*scale,(-1+(frame%2==0 and 1 or 0))*scale)
			end
		end
		local walking=not noticing and not digging and not celebrating
		local bob=walking and entry.id=="5002617" and math.sin(t*math.pi*5)^2*2 or 0
		local companionFrame=walking and math.floor(t/0.12)%#self.CompanionFrameRUIDs+1 or 2
		local companion=self.WalkLayers.Companion
		if companionFrame~=self.CompanionFrame then
		 self.CompanionFrame=companionFrame
		 companion.SpriteGUIRendererComponent.ImageRUID=DataRef(self.CompanionFrameRUIDs[companionFrame])
		end
		-- Pause both companions throughout discovery; no walking-in-place while Guri digs.
		companion.UITransformComponent.anchoredPosition=Vector2(250,340.3+(walking and bob*0.5 or 0))
		local nod=digging and entry.id=="5002617" and math.sin((t-4.2)*math.pi*4)^2*5 or 0
		-- Guri always faces right and stays at the centre; only scenery travels to the left.
		portrait.SpriteGUIRendererComponent.FlipX=true
		portrait.UITransformComponent.anchoredPosition=Vector2(0,(entry.nativeWalk and self:GetPortraitY() or (-150+(entry.footOffset or 18)*scale))+jump+bob-nod)
		portrait.UITransformComponent.UIRotation=Vector3(0,0,digging and entry.id=="5002617" and math.sin((t-4.2)*math.pi*4)*3 or 0)
		local bush=self.WalkLayers.Bush
		bush.Enable=found
		bush.UITransformComponent.anchoredPosition=Vector2(475-distance+(digging and math.sin(t*32)*3 or 0),-153)
		for i=1,7 do
		 local dust=self.WalkLayers["Dirt"..i]
		 dust.Enable=digging and t>4.8
		 if dust.Enable then
		  local p=((t-4.8)*1.7+i/7)%1
		  dust.UITransformComponent.anchoredPosition=Vector2(45+(i%2==0 and 1 or -1)*p*(28+i*5),-151+math.sin(p*math.pi)*(18+i*3))
		  dust.TextGUIRendererComponent.FontColor=route==3 and Color(0.92,0.97,1,1-p) or Color(0.58,0.36,0.14,1-p)
		 end
		end
		self.WalkNotice.Enable=noticing or (digging and t<4.85)
		self.WalkNotice.UITransformComponent.anchoredPosition=Vector2(200,-20+math.sin(t*8)*3)
		if found and t>=6.8 then self:ShowWalkLoot() end
		if found and plan.icon~="" and t>=6.8 and t<8.65 then
		 local p=(t-6.8)/1.85
		 self.WalkReward.Enable=true
		 self.WalkReward.SpriteGUIRendererComponent.ImageRUID=DataRef(plan.icon)
		 self.WalkReward.SpriteGUIRendererComponent.Color=Color(1,1,1,math.min(1,p/0.12,(1-p)/0.22))
		 self.WalkReward.UITransformComponent.anchoredPosition=Vector2(55,-70+145*math.sin(p*math.pi/2))
		end
		local key=route==1 and "PET_WALK_HENESYS" or (route==2 and "PET_WALK_FOREST" or "PET_WALK_SNOW")
		if noticing or digging then key="PET_WALK_SEARCHING" end
		self.PetDisplay:GetChildByName("State").TextGUIRendererComponent.Text=_LocalizationService:GetText(_PetLogic:GetPetMessageKey(entry.id,key))
	end


	@ExecSpace("ClientOnly")
	method void InitializeGrowthDisplay()
		if isvalid(self.GrowthTrack) then return end
		local sourceBar=self.PetPanel:GetChildByName("EnergyBar")
		local sourceFill=sourceBar:GetChildByName("Fill")
		local track=_SpawnService:SpawnByEntity(sourceBar,"GrowthTrack",Vector3(0,0,0),self.PetPanel,false)
		track.UITransformComponent.RectSize=Vector2(320,32)
		track.UITransformComponent.anchoredPosition=Vector2(0,-190)
		track.SpriteGUIRendererComponent.Color=Color(0.09,0.06,0.03,0.85)
		track.SpriteGUIRendererComponent.RaycastTarget=false
		local fill=_SpawnService:SpawnByEntity(sourceFill,"Fill",Vector3(0,0,0),track,false)
		fill.UITransformComponent.AnchorsMin=Vector2(0,0.5) fill.UITransformComponent.AnchorsMax=Vector2(0,0.5)
		fill.UITransformComponent.Pivot=Vector2(0,0.5)
		fill.UITransformComponent.anchoredPosition=Vector2(7,0)
		fill.UITransformComponent.RectSize=Vector2(0,18)
		fill.SpriteGUIRendererComponent.Color=Color(0.46,0.82,0.16,1)
		fill.SpriteGUIRendererComponent.RaycastTarget=false fill.Enable=false
		self.GrowthTrack=track self.GrowthFill=fill
		local label=self.PetPanel:GetChildByName("XP")
		label.UITransformComponent.RectSize=Vector2(308,30)
		label.SpriteGUIRendererComponent.Enable=false
		label.TextGUIRendererComponent.FontSize=20
		_UILogic:SetSiblingIndex(track.UITransformComponent,100000)
		_UILogic:SetSiblingIndex(label.UITransformComponent,100001)
		self.PetPanel:GetChildByName("StoneCaption").Enable=false
		local touch=self:WalkLayer(self.PetPanel,"StoneTouchArea","2860136c06ab075439721c027de365af",238,62,635,354)
		touch.SpriteGUIRendererComponent.Color=Color(1,1,1,0)
		touch.SpriteGUIRendererComponent.RaycastTarget=true
		touch:AddComponent(UITouchReceiveComponent)
		self.StoneTouchArea=touch
		local tooltip=_SpawnService:SpawnByEntity(self.PetPanel:GetChildByName("StoneCaption"),"StoneTooltip",Vector3(0,0,0),self.PetPanel,false)
		tooltip.UITransformComponent.RectSize=Vector2(350,58)
		tooltip.UITransformComponent.anchoredPosition=Vector2(600,282)
		tooltip.SpriteGUIRendererComponent.Color=Color(0,0,0,0.85)
		tooltip.SpriteGUIRendererComponent.RaycastTarget=false
		tooltip.TextGUIRendererComponent.FontSize=21
		tooltip.Enable=false self.StoneTooltip=tooltip
		_UILogic:SetSiblingIndex(tooltip.UITransformComponent,100002)
		local function bind(kind,callback)
		 local handle=touch:ConnectEvent(kind,callback)
		 table.insert(self.StoneTouchBindings,{entity=touch,kind=kind,handle=handle})
		end
		bind(UITouchDownEvent,function(event)
		 if not self.PetMode or (event.TouchId<0 and event.TouchId~=-1) then return end
		 self.StoneTouchId=event.TouchId self.StoneTouchPoint=event.TouchPoint
		 self.StoneHoldStart=_UtilLogic.ElapsedSeconds
		end)
		bind(UITouchUpEvent,function(event) if event.TouchId==self.StoneTouchId then self:CancelStoneTooltip() end end)
		bind(UITouchExitEvent,function(event) if event.TouchId==self.StoneTouchId then self:CancelStoneTooltip() end end)
		bind(UITouchDragEvent,function(event)
		 if event.TouchId~=self.StoneTouchId then return end
		 local dx=event.TouchPoint.x-self.StoneTouchPoint.x local dy=event.TouchPoint.y-self.StoneTouchPoint.y
		 if dx*dx+dy*dy>196 then self:CancelStoneTooltip() end
		end)
	end

	@ExecSpace("ClientOnly")
	method void RefreshGrowthProgress(number xp, number need, boolean capped)
		self.GrowthTarget=capped and 1 or math.max(0,math.min(1,xp/math.max(1,need)))
		if self.GrowthFraction<0 then self.GrowthFraction=self.GrowthTarget end
		self:AnimateGrowthProgress(0)
	end

	@ExecSpace("ClientOnly")
	method void AnimateGrowthProgress(number delta)
		if not isvalid(self.GrowthTrack) or not isvalid(self.GrowthFill) then return end
		self.GrowthFraction=self.GrowthFraction+(self.GrowthTarget-self.GrowthFraction)*math.min(1,delta*8)
		if math.abs(self.GrowthFraction-self.GrowthTarget)<0.001 then self.GrowthFraction=self.GrowthTarget end
		local fill=self.GrowthFill
		fill.Enable=self.GrowthFraction>0
		fill.UITransformComponent.RectSize=Vector2(306*self.GrowthFraction,18)
	end

	@ExecSpace("ClientOnly")
	method void CancelStoneTooltip()
		self.StoneTouchId=-999 self.StoneHoldStart=0
		if isvalid(self.StoneTooltip) then self.StoneTooltip.Enable=false end
	end

	@ExecSpace("ClientOnly")
	method void UpdateStoneTooltip()
		if self.StoneTouchId==-999 or not isvalid(self.StoneTooltip) then return end
		if not self.PetMode or self.PetTutorialOpen or not self.StoneTouchArea.Enable then self:CancelStoneTooltip() return end
		if _UtilLogic.ElapsedSeconds-self.StoneHoldStart>=0.4 and not self.StoneTooltip.Enable then
		 self.StoneTooltip.TextGUIRendererComponent.Text=_LocalizationService:GetText("PET_STONE_TOOLTIP")
		 self.StoneTooltip.Enable=true
		 log("[VRF] PET-HOUSE growth-stone tooltip opened by hold")
		end
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
	 self:InitializeArtwork()
	 self:InitializeDuckyFoodBowl()
	 self:InitializeOduckFeedingPool()
	 self:InitializeActionScenery()
	 self:InitializeWalkArtwork()
	 self:InitializeGrowthDisplay()
	 self:InitializePetTutorial()
	 _ResourceService:PreloadAsync({self.EnabledButtonRUID,self.DisabledButtonRUID,self.UnequipButtonRUID,self.EnabledArrowRUID,self.DisabledArrowRUID,self.EnabledClaimRUID,self.DisabledClaimRUID,"b239798f5a8d4129ae1c086e7069f7fc"},function(results)
	  local ready=true
	  for _,result in pairs(results) do if result~=PreloadResultStatus.Success then ready=false end end
	  log("[VRF] PET-HOUSE control artwork preload ready="..tostring(ready))
	  if self.PetMode then self:Refresh() end
	 end)
	 self.FeedingReady = false
	 _ResourceService:PreloadAsync(self.FeedingRUIDs, function(results)
	  self.FeedingReady = true
	  for _, result in pairs(results) do
	   if result ~= PreloadResultStatus.Success then self.FeedingReady = false end
	  end
	  log("[VRF] PET-HOUSE feeding preload ready=" .. tostring(self.FeedingReady))
	  if self.PetMode then self:Refresh() end
	 end)
	 self:BindClick(self.PetButton, function() self:Open() end)
	 self:BindClick(self.CloseButton, function() self:Close() end)
	 self:BindClick(self.StatButton,function() self:OpenStatPopup() end)
	 self:BindClick(self.StatPopup:GetChildByName("Dim"),function() self:CloseStatPopup() end)
	 self:BindClick(self.StatPopup:GetChildByName("Window"):GetChildByName("BtnClose"),function() self:CloseStatPopup() end)
	 log("[VRF] PET-STATS four slots ready")
	 for _, action in ipairs({"feed", "wash", "walk", "sleep", "inject", "equip", "rank", "test"}) do
	  local name = action
	  self:BindClick(self.PetPanel:GetChildByName(name), function() self:RequestCare(name) end)
	 end
	 for tier=1,3 do
	  local action="heart"..tostring(tier)
	  self:BindClick(self.PetDisplay:GetChildByName("AffinityDial"):GetChildByName("Reward"..tostring(tier)):GetChildByName("Claim"),function() self:RequestCare(action) end)
	 end
	 self:BindClick(self.PetPanel:GetChildByName("buy"), function() self:BuyEgg() end)
	 self:BindClick(self.PetPanel:GetChildByName("PrevPet"),function() self:MovePet(-1) end)
	 self:BindClick(self.PetPanel:GetChildByName("NextPet"),function() self:MovePet(1) end)
	 self.PetPanel:GetChildByName("AbilityCaption").TextGUIRendererComponent.Text=_LocalizationService:GetText("PET_HOUSE_ABILITY")
	 local labels = {EnergyCaption="PET_ENERGY", NeedsFull="PET_FULLNESS", NeedsClean="PET_CLEANLINESS", NeedsMood="PET_MOOD", StoneCaption="PET_STONES", test="PET_TEST_HATCH"}
	 for name, key in pairs(labels) do
	  local entity = self.PetPanel:GetChildByName(name)
	  if entity.TextGUIRendererComponent ~= nil then entity.TextGUIRendererComponent.Text = _LocalizationService:GetText(key)
	  else entity:GetChildByName("Label").TextGUIRendererComponent.Text = _LocalizationService:GetText(key) end
	 end
	 self.PetPanel.Parent:GetChildByName("Title"):GetChildByName("Label").TextGUIRendererComponent.Text = _LocalizationService:GetText("PET_HOUSE")
	 self.PetButton:GetChildByName("Label").TextGUIRendererComponent.Text = _LocalizationService:GetText("PET_TAB")
	 self:Close()
	end

	@ExecSpace("ClientOnly")
	method void Open()
	 if not isvalid(self.TitleGroup) or not self.TitleGroup.Enable or not self.TitleGroup:GetChildByName("BattlePanel").Enable then return end
	 if _GameManager.GameStarted and not _GameManager.GameOver then return end
	 self.PetMode = true self.Overlay.Enable = true
	 self.NextRefresh = _UtilLogic.ElapsedSeconds + 15
	 self.IdleRUID = "" self.GrowthWasVisible=false self:Refresh() _PetLogic:RequestState()
	 log("[VRF] PET-HOUSE opened from lobby")
	end

	@ExecSpace("ClientOnly")
	method void Close()
	 self:ClosePetTutorial()
	 self:CloseStatPopup()
	 if self.Motion == "walk" then self:ShowWalkLoot() end
	 self:SetWalking(false,0)
	 self:SetActionScenery("",0)
	 self.PetDisplay:GetChildByName("Portrait").UITransformComponent.UIRotation = Vector3(0,0,0)
	 self:CancelStoneTooltip()
	 self.PetMode = false self.Overlay.Enable = false
	 self.MotionUntil = 0 self.WaitingUntil = 0 self.PendingAction = "" self.Motion = "" self.IdleRUID = "" self.CustomFrameKey=""
	 self.GrowthWasVisible=false self.PetPanel:GetChildByName("rank").UITransformComponent.UIScale=Vector3(1,1,1)
	 self.PetDisplay:GetChildByName("Portrait").UITransformComponent.anchoredPosition = Vector2(0,self:GetPortraitY())
	 self:SetWater(false, 0) self:SetFeedingMotion(false, 0) self:SetInjection(false,0) self:SetSleepCushion(false,0)
	end

	@ExecSpace("ClientOnly")
	method void RequestCare(string action)
		if self.PetTutorialOpen then return end
		if not self.PetMode or _UtilLogic.ElapsedSeconds<math.max(self.MotionUntil,self.WaitingUntil) then return end
		local entry=self:GetDisplayedPet() local pet=entry.progress
		if not entry.ready or pet==nil then return end
		if entry.frames~=nil and not _PetLogic.TtungttangReady then return end
		if action=="sleep" and not self.SleepCushionReady then return end
		if action=="feed" and entry.id=="5002617" and not self.FeedingReady then return end
		if action=="feed" and entry.id=="5000498" and not self.DuckyBowlReady then return end
		if action=="feed" and entry.id=="oduck" and not self.OduckPoolReady then return end
		if action=="walk" and not self.WalkReady then return end
		if (action=="wash" or action=="inject") and not self.CareBackdropReady then return end
		if action=="rank" and not self.PetPanel:GetChildByName("rank").ButtonComponent.Enable then return end
		if action=="test" then
			if not Environment:IsMakerPlay() or pet.Owned then return end
		elseif not pet.Owned then return end
		local blocked=_PetLogic:GetCareBlockReason(pet,action)
		if blocked~="" then _UIToast:ShowMessage(_PetLogic:GetPetMessageKey(entry.id,blocked)) return end
		self.PendingAction=action self.WaitingUntil=_UtilLogic.ElapsedSeconds+4
		self:Refresh() _PetLogic:RequestPetAction(entry.id,action)
	end

	@ExecSpace("ClientOnly")
	method void OnPetChanged(string motion)
		if not self.PetMode then return end
		local entry=self:GetDisplayedPet()
		if motion~="" and _PetLogic.ClientMotionPetId~="" and _PetLogic.ClientMotionPetId~=entry.id then self:Refresh() return end
		local expected={feed="eat",wash="chat",walk="move",sleep="sleep",equip="love",rank="love",test="love",inject="inject",heart1="gift",heart2="gift",heart3="gift"}
		local action=self.PendingAction
		if motion~="" then
			self.PendingAction="" self.WaitingUntil=0
			if expected[action]==motion and entry.motions[motion]~=nil then
				self.Motion=action self.MotionStart=_UtilLogic.ElapsedSeconds
				self.MotionUntil=self.MotionStart+_PetLogic:GetCareDuration(action) self.IdleRUID="" self.CustomFrameKey=""
				if entry.frames~=nil then self:RenderCustomAction(action,0)
				elseif action=="feed" and entry.id=="5002617" then self.FeedingFrame=0 self:PlayPortrait(self.FeedingRUIDs[1])
				else self:PlayPortrait(entry.motions[motion]) end
				self:SetInjection(action=="inject",0) self:SetFeedingMotion(action=="feed",0)
				self:SetWalking(action=="walk",0) self:SetActionScenery(action,0)
				log("[VRF] PET-HOUSE care "..action.." species="..entry.id)
			end
		end
		self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method void PlayPortrait(string ruid)
		local entry=self:GetDisplayedPet()
		local portrait=self.PetDisplay:GetChildByName("Portrait") local image=portrait.SpriteGUIRendererComponent
		if entry.frames~=nil then
			image.PreserveSprite=PreserveSpriteType.None image.LocalScale=Vector2(1,1) image.LocalPosition=Vector2(0,0)
			local scale=_PetLogic:GetCustomPixelScale(portrait,entry.pixelScale)
			portrait.UITransformComponent.RectSize=Vector2(entry.canvas*scale,entry.canvas*scale)
		else local scale=entry.pixelScale or self.PortraitPixelScale image.PreserveSprite=PreserveSpriteType.NativeSize image.LocalScale=Vector2(scale,scale) end
		image.PlayRate=1 image.AnimClipPlayType=SpriteAnimClipPlayType.Loop image.ImageRUID=DataRef(ruid)
		image.Enable=entry.frames~=nil or not _PetLogic.NativePetGearReady
		self.CustomImageRUID=entry.frames~=nil and ruid or ""
	end

	@ExecSpace("ClientOnly")
	method void RenderCustomPose(string pose, number elapsed)
		local entry=self:GetDisplayedPet()
		if entry.frames==nil then return end
		local frames=entry.frames[pose] or entry.frames.stand
		if frames==nil or #frames==0 then return end
		local frame=_PetLogic:GetCustomFrameIndex(pose,elapsed)
		local key=entry.id..":"..pose..":"..tostring(frame)
		if self.CustomFrameKey==key then return end
		self.CustomFrameKey=key
		local ruid=frames[frame]
		-- A held rig pose keeps its current texture; redundant frame slots do not reload it.
		if self.CustomImageRUID~=ruid then
			self.CustomImageRUID=ruid self.PetDisplay:GetChildByName("Portrait").SpriteGUIRendererComponent.ImageRUID=DataRef(ruid)
		end
	end

	@ExecSpace("ClientOnly")
	method void RenderCustomAction(string action, number elapsed)
		local entry=self:GetDisplayedPet()
		if entry.frames==nil or action=="walk" then return end

		local poses={feed="eat",wash="chat",sleep="sleep",inject="inject"}
		local pose=poses[action] or "love"
		self:RenderCustomPose(pose,elapsed)
		if pose=="love" then
			local hop=math.sin(math.min(1,elapsed/0.65)*math.pi)*12
			self.PetDisplay:GetChildByName("Portrait").UITransformComponent.anchoredPosition=Vector2(0,self:GetPortraitY()+hop)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetFeedingMotion(boolean active, number elapsed)
		-- Play original eating sprites directly: the source animation clip fails to load in Maker.
		local portrait = self.PetDisplay:GetChildByName("Portrait")
		self.PetDisplay:GetChildByName("Food").Enable = false
		self:SetDuckyFoodBowl(active,elapsed)
		self:SetOduckFeedingPool(active,elapsed)
		if not active then self.FeedingFrame = 0 return end
		if self:GetDisplayedPet().id~="5002617" then return end
		local frame = math.floor(math.max(0, elapsed) / 0.15) % #self.FeedingRUIDs + 1
		if self.FeedingFrame ~= frame then
			self.FeedingFrame = frame
			portrait.SpriteGUIRendererComponent.ImageRUID = DataRef(self.FeedingRUIDs[frame])
		end
		local progress = math.max(0, math.min(3.8, elapsed))
		local envelope = math.min(1, progress / 0.24, (3.8 - progress) / 0.3)
		envelope = envelope * envelope * (3 - 2 * envelope)
		local nod = math.sin(progress * math.pi * 2.5)
		portrait.UITransformComponent.anchoredPosition = Vector2(0, -150 - 3.5 * envelope * nod * nod)
	end

	@ExecSpace("ClientOnly")
	method void SetWater(boolean active, number elapsed)
	 local water = self.PetDisplay:GetChildByName("Water")
	 water.Enable = active
	 if not active then return end
	 local fade = math.min(1, elapsed / 0.3, math.max(0, (4.5 - elapsed) / 0.5))
	 local jet = water:GetChildByName("Jet")
	 jet.SpriteGUIRendererComponent.Color = Color(1,1,1,0.52 * fade)
	 jet.UITransformComponent.UIScale = Vector3(1 + math.sin(elapsed * 18) * 0.035, 1, 1)
	 local splash = water:GetChildByName("Splash")
	 splash.SpriteGUIRendererComponent.Color = Color(1,1,1,0.8 * fade)
	 splash.UITransformComponent.UIScale = Vector3(1 + math.sin(elapsed * 15) * 0.08, 1 + math.cos(elapsed * 12) * 0.06, 1)
	 for i = 1, 12 do
	  local drop = water:GetChildByName("Drop" .. i)
	  local phase = (elapsed * 1.7 + i / 12) % 1
	  local x = math.sin(i * 17) * 62
	  drop.UITransformComponent.anchoredPosition = Vector2(x, 85 - phase * 230)
	  drop.SpriteGUIRendererComponent.Color = Color(0.7,0.95,1,fade * (0.45 + math.sin(phase * math.pi) * 0.5))
	 end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
	 self:TickPetTutorial(delta)
	 if not self.PetMode then return end
	 self:AnimateNeeds(delta)
	 self:AnimateAffinity(delta)
	 self:AnimateGrowth()
	 self:AnimateGrowthProgress(delta)
	 self:UpdateStoneTooltip()
	 if not self.TitleGroup.Enable or not self.TitleGroup:GetChildByName("BattlePanel").Enable or (_GameManager.GameStarted and not _GameManager.GameOver) then self:Close() return end
	 local now = _UtilLogic.ElapsedSeconds
	 if now >= self.NextRefresh then self.NextRefresh = now + 15 _PetLogic:RequestState() end
	 if self.WaitingUntil > 0 and now >= self.WaitingUntil then self.WaitingUntil = 0 self.PendingAction = "" self:Refresh() end
	 if self.MotionUntil > 0 then
	  local elapsed = now - self.MotionStart
	  self:SetActionScenery(self.Motion,elapsed)
	  local portrait = self.PetDisplay:GetChildByName("Portrait")
	  if self.Motion == "walk" then self:SetWalking(true,elapsed)
	  else portrait.UITransformComponent.anchoredPosition = Vector2(0,self:GetPortraitY()) end
	  self:SetWater(self.Motion == "wash", elapsed)
	  self:SetInjection(self.Motion == "inject",elapsed)
	  self:SetFeedingMotion(self.Motion == "feed", elapsed)
	  self:SetSleepCushion(self.Motion == "sleep",elapsed)
	  self:RenderCustomAction(self.Motion,elapsed)
	  if now >= self.MotionUntil then
	   self:SetWalking(false,0) portrait.UITransformComponent.UIRotation = Vector3(0,0,0)
	   self.MotionUntil = 0 self.Motion = "" self:SetActionScenery("",0) self:SetInjection(false,0) self:SetWater(false, 0) self:SetFeedingMotion(false, 0) self:SetSleepCushion(false,0) self:PlayIdle() self:Refresh()
	  end
	 end
	 if self.ShownRevision ~= _PetLogic.ClientRevision then self:Refresh() end
	 if self.MotionUntil==0 then self:RenderCustomPose(self.CustomIdlePose,now-self.IdleAnimationStart) local entry=self:GetDisplayedPet() if entry.frames~=nil then self.PetDisplay:GetChildByName("Portrait").UITransformComponent.anchoredPosition=Vector2(0,self:GetPortraitY()) end end
	 local entry=self:GetDisplayedPet()
	 _PetLogic:AlignCustomPortrait(self.PetDisplay:GetChildByName("Portrait"),entry,entry.pixelScale)
	 _PetLogic:RenderPetGearUI(self.PetDisplay:GetChildByName("Portrait"),entry,self.CustomImageRUID)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
	 self:Close()
	 for _, binding in ipairs(self.Handlers) do
	  if isvalid(binding.entity) then binding.entity:DisconnectEvent(ButtonClickEvent, binding.handle) end
	 end
	 self.Handlers = {}
	 for _,binding in ipairs(self.StoneTouchBindings) do
	  if isvalid(binding.entity) then binding.entity:DisconnectEvent(binding.kind,binding.handle) end
	 end
	 self.StoneTouchBindings={}
	 for _,entity in ipairs({self.GrowthTrack,self.StoneTouchArea,self.StoneTooltip}) do if isvalid(entity) then entity:Destroy() end end
	 self.GrowthTrack=nil self.GrowthFill=nil self.StoneTouchArea=nil self.StoneTooltip=nil self.GrowthFraction=-1
	 if isvalid(self.SleepCushion) then self.SleepCushion:Destroy() end
	 self.SleepCushion=nil self.SleepCushionReady=false
	 if isvalid(self.DuckyFoodBowl) then self.DuckyFoodBowl:Destroy() end
	 self.DuckyFoodBowl=nil self.DuckyBowlReady=false
	 if isvalid(self.OduckPoolBack) then self.OduckPoolBack:Destroy() end
	 if isvalid(self.OduckPoolFront) then self.OduckPoolFront:Destroy() end
	 self.OduckPoolBack=nil self.OduckPoolFront=nil self.OduckPoolReady=false
	 if isvalid(self.ActivityScene) then self.ActivityScene:Destroy() end
	 if isvalid(self.WalkNotice) then self.WalkNotice:Destroy() end
	 if isvalid(self.WalkReward) then self.WalkReward:Destroy() end
	 if isvalid(self.WalkSmile) then self.WalkSmile:Destroy() end
	 self.WalkScene = nil self.WalkNotice = nil self.WalkReward = nil self.WalkSmile = nil self.WalkLayers = {}
	 self.ActivityScene=nil self.CareBackdrop=nil self.CareBackdropReady=false self.ShownBackdropRUID="" self.SceneAction=""
	end


	@ExecSpace("ClientOnly")
	method void InitializeOduckFeedingPool()
		if isvalid(self.OduckPoolBack) and isvalid(self.OduckPoolFront) then return end
		local portrait=self.PetDisplay:GetChildByName("Portrait")
		local back=self:WalkLayer(self.PetDisplay,"OduckPoolBack",self.OduckPoolRUID,384,384,0,0)
		local front=self:WalkLayer(self.PetDisplay,"OduckPoolFront",self.OduckPoolRUID,384,384,0,0)
		back.Enable=false front.Enable=false
		self.OduckPoolBack=back self.OduckPoolFront=front self.OduckPoolReady=false
		_UILogic:SetSiblingIndex(back.UITransformComponent,_UILogic:GetSiblingIndex(portrait.UITransformComponent))
		_UILogic:SetSiblingIndex(front.UITransformComponent,_UILogic:GetSiblingIndex(portrait.UITransformComponent)+1)
		-- Reuse the exact pool texture for the near wall: crop its lower portion, never stretch it.
		local image=front.SpriteGUIRendererComponent
		image.Type=ImageType.Filled image.FillMethod=FillMethodType.Vertical image.FillOrigin=0 image.FillAmount=0.26
		_ResourceService:PreloadAsync({self.OduckPoolRUID},function(results)
			if not isvalid(self) or not isvalid(back) or not isvalid(front) then return end
			local ready=true for _,result in pairs(results) do if result~=PreloadResultStatus.Success then ready=false end end
			self.OduckPoolReady=ready
			log("[VRF] PET-ODUCK round feeding pool ready="..tostring(ready))
			if self.PetMode then self:Refresh() end
		end)
	end

	@ExecSpace("ClientOnly")
	method void SetOduckFeedingPool(boolean active, number elapsed)
		local back=self.OduckPoolBack local front=self.OduckPoolFront
		if not isvalid(back) or not isvalid(front) then return end
		local show=active and self.PetMode and self.OduckPoolReady and self:GetDisplayedPet().id=="oduck"
		back.Enable=show front.Enable=show
		if not show then return end
		local size=128*_PetLogic:GetCustomPixelScale(back,3)
		back.UITransformComponent.RectSize=Vector2(size,size)
		back.UITransformComponent.anchoredPosition=Vector2(0,self:GetPortraitY()+size*0.28-55)
		_PetLogic:AlignCustomPortrait(back,{frames={},canvas=128},3)
		front.UITransformComponent.RectSize=back.UITransformComponent.RectSize
		front.UITransformComponent.anchoredPosition=back.UITransformComponent.anchoredPosition
		local duration=_PetLogic:GetCareDuration("feed")
		local fade=math.max(0,math.min(1,elapsed/0.18,(duration-elapsed)/0.22))
		fade=fade*fade*(3-2*fade)
		back.SpriteGUIRendererComponent.Color=Color(1,1,1,fade)
		front.SpriteGUIRendererComponent.Color=Color(1,1,1,fade)
	end

	@ExecSpace("ClientOnly")
	method void InitializeDuckyFoodBowl()
		if isvalid(self.DuckyFoodBowl) then return end
		local portrait=self.PetDisplay:GetChildByName("Portrait")
		local bowl=self:WalkLayer(self.PetDisplay,"DuckyFoodBowl",self.DuckyBowlRUID,256,256,0,0)
		bowl.Enable=false self.DuckyFoodBowl=bowl self.DuckyBowlReady=false
		_UILogic:SetSiblingIndex(bowl.UITransformComponent,_UILogic:GetSiblingIndex(portrait.UITransformComponent)+1)
		_ResourceService:PreloadAsync({self.DuckyBowlRUID},function(results)
			if not isvalid(self) then return end
			local ready=true for _,result in pairs(results) do if result~=PreloadResultStatus.Success then ready=false end end
			self.DuckyBowlReady=ready
			log("[VRF] DUCKY-BOWL pixel bowl ready="..tostring(ready))
			if self.PetMode then self:Refresh() end
		end)
	end

	@ExecSpace("ClientOnly")
	method void SetDuckyFoodBowl(boolean active, number elapsed)
		local bowl=self.DuckyFoodBowl if not isvalid(bowl) then return end
		bowl.Enable=active and self.DuckyBowlReady and self:GetDisplayedPet().id=="5000498"
		if not bowl.Enable then return end
		local scale=_PetLogic:GetCustomPixelScale(bowl,2)
		local size=128*scale
		bowl.UITransformComponent.RectSize=Vector2(size,size)
		-- Original 128px art: bowl bounds (25,96)-(64,118); keep the base on the paw plane.
		bowl.UITransformComponent.anchoredPosition=Vector2(-38+(64-44.5)*scale,self:GetPortraitY()+(118-64)*scale)
		_PetLogic:AlignCustomPortrait(bowl,{frames={},canvas=128},2)
		local duration=_PetLogic:GetCareDuration("feed")
		local fade=math.max(0,math.min(1,elapsed/0.14,(duration-elapsed)/0.22))
		fade=fade*fade*(3-2*fade)
		bowl.SpriteGUIRendererComponent.Color=Color(1,1,1,fade)
	end

	@ExecSpace("ClientOnly")
	method string GetPetTutorialText(string key)
		-- Keep CSV rows portable; accept either literal or decoded line breaks.
		return (string.gsub(_LocalizationService:GetText(key), "\\n", "\n"))
	end

	@ExecSpace("ClientOnly")
	method void InitializePetTutorial()
		self.TutorialRoot.Enable=false self.PetTutorialOpen=false self.PetTutorialReady=false
		self:BindClick(self.TutorialHelp,function() self:OpenPetTutorial() end)
		self:BindClick(self.TutorialRoot:GetChildByName("Dim"),function() self:ClosePetTutorial() end)
		local resources={} for _,ruid in ipairs(self.PetTutorialImages) do table.insert(resources,ruid) end
		table.insert(resources,"52df3f22bb014921a232021a48a1279b")
		table.insert(resources,"78d254b94ee54616ab1d6038e131ec8a")
		table.insert(resources,"6643f10005754442948e6e60629b9359")
		_ResourceService:PreloadAsync(resources,function(results)
			if not isvalid(self.TutorialRoot) then return end
			local ready=true for _,result in pairs(results) do if result~=PreloadResultStatus.Success then ready=false end end
			self.PetTutorialReady=ready
			log("[VRF] PET-TUTORIAL artwork ready="..tostring(ready))
		end)
		log("[VRF] PET-TUTORIAL help button and four stages initialized")
	end

	@ExecSpace("ClientOnly")
	method any GetPetTutorialSequence(integer index)
		if index<1 or index>7 then return nil end
		if index%2==1 then return self.TutorialContent:GetChildByName("Step"..tostring(math.floor(index/2)+1)) end
		return self.TutorialContent:GetChildByName("Arrow"..tostring(math.floor(index/2)))
	end

	@ExecSpace("ClientOnly")
	method void FitPetTutorial()
		local canvas=self.TutorialRoot.Parent.UITransformComponent.RectSize
		if canvas.x<=0 or canvas.y<=0 then return end
		local w=canvas.x local h=canvas.y local cx=0 local cy=0
		local sw=_UILogic.ScreenWidth local sh=_UILogic.ScreenHeight
		if sw>0 and sh>0 then
			local p0=_UILogic:ScreenToLocalUIPosition(Vector2(0,0),self.TutorialRoot.UITransformComponent)
			local p1=_UILogic:ScreenToLocalUIPosition(Vector2(sw,sh),self.TutorialRoot.UITransformComponent)
			if p0~=nil and p1~=nil then
				local mw=math.abs(p1.x-p0.x) local mh=math.abs(p1.y-p0.y)
				-- Clamp measurements during parent transitions instead of amplifying them.
				if mw>canvas.x*0.5 and mw<canvas.x*2 and mh>canvas.y*0.5 and mh<canvas.y*2 then
					w=math.min(w,mw) h=math.min(h,mh)
					cx=(p0.x+p1.x)*0.5 cy=(p0.y+p1.y)*0.5
				end
			end
		end
		local scale=math.max(0.2,math.min(1,(w-80)/1520,(h-80)/1040))
		self.PetTutorialScale=scale self.PetTutorialCanvasSize=Vector2(canvas.x,canvas.y)
		self.TutorialContent.UITransformComponent.UIScale=Vector3(scale,scale,1)
		self.TutorialContent.UITransformComponent.anchoredPosition=Vector2(cx,cy)
		log(string.format("[VRF] PET-TUTORIAL fit %.0fx%.0f scale=%.3f",w,h,scale))
	end

	@ExecSpace("ClientOnly")
	method void OpenPetTutorial()
		if not self.PetMode or self.PetTutorialOpen or not isvalid(self.TutorialRoot) then return end
		self:CloseStatPopup() self:CancelStoneTooltip()
		self.PetTutorialOpen=true self.PetTutorialTime=0 self.PetTutorialRevealed=0 self.PetTutorialAges={}
		self.TutorialContent:GetChildByName("Title").TextGUIRendererComponent.Text=self:GetPetTutorialText("PET_GUIDE_TITLE")
		self.TutorialContent:GetChildByName("Hint").TextGUIRendererComponent.Text=self:GetPetTutorialText("PET_GUIDE_CLOSE")
		for i=1,4 do self.TutorialContent:GetChildByName("Step"..i):GetChildByName("Label").TextGUIRendererComponent.Text=self:GetPetTutorialText("PET_GUIDE_STEP"..i) end
		for i=1,7 do
			local e=self:GetPetTutorialSequence(i) e.Enable=false
			e.CanvasGroupComponent.GroupAlpha=0 e.UITransformComponent.UIScale=Vector3(0.85,0.85,1)
		end
		self.TutorialRoot.Enable=true
		_UILogic:SetSiblingIndex(self.TutorialRoot.UITransformComponent,100005)
		self:FitPetTutorial() self:RevealPetTutorialNext()
		log("[VRF] PET-TUTORIAL opened from pet-house help")
	end

	@ExecSpace("ClientOnly")
	method void RevealPetTutorialNext()
		if self.PetTutorialRevealed>=7 then return end
		self.PetTutorialRevealed=self.PetTutorialRevealed+1
		local index=self.PetTutorialRevealed local e=self:GetPetTutorialSequence(index)
		e.Enable=true self.PetTutorialAges[index]=0
		log("[VRF] PET-TUTORIAL reveal="..index)
	end

	@ExecSpace("ClientOnly")
	method void TickPetTutorial(number delta)
		if not self.PetTutorialOpen then return end
		if not self.PetMode then self:ClosePetTutorial() return end
		local canvas=self.TutorialRoot.Parent.UITransformComponent.RectSize
		if canvas.x~=self.PetTutorialCanvasSize.x or canvas.y~=self.PetTutorialCanvasSize.y then self:FitPetTutorial() end
		self.PetTutorialTime=self.PetTutorialTime+delta
		-- Same order and interval as RaidTutorialUI; a low-FPS frame catches up cleanly.
		while self.PetTutorialRevealed<7 and self.PetTutorialTime>=self.PetTutorialRevealed*0.55 do self:RevealPetTutorialNext() end
		for i=1,self.PetTutorialRevealed do
			local age=(self.PetTutorialAges[i] or 0)+delta self.PetTutorialAges[i]=age
			local p=math.min(1,age/0.18) local eased=1-(1-p)*(1-p)
			local e=self:GetPetTutorialSequence(i) local scale=0.85+0.15*eased
			e.UITransformComponent.UIScale=Vector3(scale,scale,1)
			e.CanvasGroupComponent.GroupAlpha=math.min(1,age/0.12)
		end
	end

	@ExecSpace("ClientOnly")
	method void ClosePetTutorial()
		local wasOpen=self.PetTutorialOpen
		self.PetTutorialOpen=false self.PetTutorialTime=0 self.PetTutorialRevealed=0 self.PetTutorialAges={}
		if isvalid(self.TutorialRoot) then self.TutorialRoot.Enable=false end
		if wasOpen then log("[VRF] PET-TUTORIAL closed; pet-house remains open") end
	end


	@ExecSpace("ClientOnly")
	method number GetWalkJumpHeight()
		-- Measure the whole walking pet and worn headpiece against the needs panel.
		-- Keep a smooth hop; reduce its amplitude rather than flattening its peak.
		local entry=self:GetDisplayedPet()
		if entry.id=="ttungttang" then return 42 end
		local ids=entry.nativeWalk and _PetLogic.NativePetGearClips[entry.motions.move] or self.WalkFrameRUIDs
		if ids==nil then return 42 end
		local meter=self.PetDisplay:GetChildByName("CareMeters").UITransformComponent
		local ceiling=meter.anchoredPosition.y-meter.RectSize.y*meter.Pivot.y-6
		local native=entry.nativeWalk
		local scale=native and entry.pixelScale or self.PortraitPixelScale
		local rest=native and self:GetPortraitY() or (-150+(entry.footOffset or 18)*scale)
		local maxTop=-100000
		local mask=entry.progress~=nil and entry.progress.GearEquippedMask or 0
		for _,ruid in ipairs(ids) do
			local m=_PetLogic.NativePetGearSpriteMetrics[ruid]
			if m~=nil then
				local top=0;local layers=_PetLogic.NativePetGearOverlays[entry.id][ruid]
				if _PetLogic:HasPetGearBit(mask,1) and layers~=nil and layers.hat~=nil then top=math.min(top,layers.hat.y) end
				local py=native and (1-m.py)*m.h or m.h*0.5
				local sy=native and scale or (entry.canvas or 36)*scale/m.h
				maxTop=math.max(maxTop,rest+(py-top)*sy)
			end
		end
		return math.max(0,math.min(42,ceiling-maxTop))
	end

end
