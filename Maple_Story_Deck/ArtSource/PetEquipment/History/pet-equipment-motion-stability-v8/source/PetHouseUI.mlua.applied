@Logic
script PetHouseUI extends Logic
	property Entity TutorialHelp = "dbca0ee3-1780-4ebc-a82b-2194319f4a73"
	property Entity TutorialRoot = "bf3d9ae0-9c34-4c9e-97d1-81612dfa7fcf"
	property Entity TutorialContent = "44554687-fafb-4c55-884c-69116e2d2f37"
	property boolean PetTutorialOpen = false
	property boolean PetTutorialReady = false
	property integer PetTutorialRevealed = 0
	property number PetTutorialTime = 0
	property number PetTutorialScale = 1
	property Vector2 PetTutorialCanvasSize = Vector2(0,0)
	property table PetTutorialAges = {}
	property table PetTutorialImages = {"760790003c9c430e8f27cf2f6ff55dcf","522678ea39cc4eaabe7666d23eb2039a","4c323d29462e489a8475e7e4c9139b02","84de1092778c4d92a25382f0dd38b192"}
	property Entity Overlay = "3589b646-4850-48c1-8f9e-bbecf83b9821"
	property Entity PetPanel = "952ecae3-adfd-4f23-a672-9b86a41a3727"
	property Entity PetDisplay = "f2612fb7-46eb-4daa-92ab-4d004558d159"
	property Entity PetButton = "6e2b4852-6a87-43e8-8f46-1398ee7425eb"
	property Entity CloseButton = "3bf346e8-283c-4111-b7d3-e6a84948138c"
	property Entity TitleGroup = "4109795c-8f3d-41f1-9403-fefcec8fbb3e"
	property Entity StatButton = "b49381df-cffe-4503-afe7-a4a9ceb5cf64"
	property Entity StatPopup = "e3273bf1-5dd7-4efd-b1d5-14cf3a4365e2"
	property boolean PetMode = false
	property table Handlers = {}

	property table WalkBackdropRUIDs = {"49c8cf45024b41de806ffddb87ae53a1","21ca41f187bc4129ba54cf589f05e109","65b4512cee6d4f829000e537d1b57531"}
	property integer WalkShownRoute = 0
	property table CompanionFrameRUIDs = {"8de470817b6d4b96a8d6be79085355b2","1279e7f63ec043ee822128144f38d929","a016ba21141048f497be144bd723dc7f","5d4f7eb85cdc474b85bed3636c66858e","24e43859e5c143b7ba59941fba58b861","19a8883197f34aa3a7e4207cbab8bc8c"}
	property integer CompanionFrame = 0
	property string HappyFaceRUID = "486b77cf328849218d50c6f47d073ba4"
	property any GrowthTrack = nil
	property any GrowthFill = nil
	property number GrowthFraction = -1
	property number GrowthTarget = 0
	property any StoneTouchArea = nil
	property any StoneTooltip = nil
	property table StoneTouchBindings = {}
	property integer StoneTouchId = -999
	property number StoneHoldStart = 0
	property Vector2 StoneTouchPoint = Vector2(0,0)
	property any WalkScene = nil
	property any ActivityScene = nil
	property any CareBackdrop = nil
	property boolean CareBackdropReady = false
	property string BathroomRUID = "43d7a20cad63436ea62e68c684d1fe01"
	property string ClinicRUID = "6a7a256a06fa40ae8f22c21987c4a5b4"
	property string ShownBackdropRUID = ""
	property string SceneAction = ""
	property table WalkLayers = {}
	property any WalkSmile = nil
	property integer WalkFrame = 0
	property table WalkFrameRUIDs = {"78dc1ea7912b4ebfa8c012270add2f2c","3ed892481c6c49dab6850fc559009fe7","e715bfb4737c4a21b260713e43cdbba8","766a28fa03db48688ecbcf55d5265843"}
	property any WalkNotice = nil
	property any WalkReward = nil
	property any WalkPlan = nil
	property integer WalkPhase = -1
	property boolean WalkReady = false
	property integer WalkPlanToken = 0
	property table FeedingRUIDs = {"fb961eaed68149c8ab6835ba0888c762","cf7a9eeab77d473f96f48b36912f5c8d"}
	property boolean FeedingReady = false
	property integer FeedingFrame = 0
	property number NextRefresh = 0
	property number MotionUntil = 0
	property number MotionStart = 0
	property string Motion = ""
	property string IdleRUID = ""
	property string CustomFrameKey = ""
	property string CustomImageRUID = ""
	property string CustomIdlePose = "stand"
	property number IdleAnimationStart = 0
	property any OduckPoolBack = nil
	property any OduckPoolFront = nil
	property boolean OduckPoolReady = false
	property string OduckPoolRUID = "dba02e54ed704cdcaf9a8e25bc9c0f1c"
	property any DuckyFoodBowl = nil
	property boolean DuckyBowlReady = false
	property string DuckyBowlRUID = "5dbbe59d2e5b4a288dca7c01c40db2e6"
	property any SleepCushion = nil
	property boolean SleepCushionReady = false
	property string SleepCushionRUID = "172e6e36f588466693f4a7da94fe7ea4"
	property number PortraitPixelScale = 6.3888888889
	property table GaugeValues = {}
	property table GaugeTargets = {}
	property number ShownAffinity = 0
	property integer InjectionPhase = -1
	property integer ShownRevision = -1
	property string PendingAction = ""
