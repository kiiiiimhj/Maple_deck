	@ExecSpace("ClientOnly")
	method void InitializePetGearPurchaseUI()
		if self._T.petGearPurchase~=nil then return end
		local sourcePanel=self.SellConfirm:GetChildByName("Panel")
		local dimTemplate=self.SellConfirm:GetChildByName("Dim")
		local backgroundTemplate=sourcePanel:GetChildByName("Bg")
		local textTemplate=sourcePanel:GetChildByName("SubMessage")
		local yesTemplate=sourcePanel:GetChildByName("BtnYes")
		local noTemplate=sourcePanel:GetChildByName("BtnNo")
		local iconTemplate=_PetUI.PetGearSlots:GetChildByName("Cap"):GetChildByName("Icon")
		local layout=self:GetPetGearPurchaseLayout()
		local q={handlers={},layout=layout}
		q.root=_SpawnService:SpawnByEntity(self.SellConfirm,"PetGearPurchase",Vector3.zero,_PetHouseUI.Overlay.Parent,false)
		local rt=q.root.UITransformComponent
		rt.AnchorsMin=Vector2(0,0);rt.AnchorsMax=Vector2(1,1);rt.OffsetMin=Vector2.zero;rt.OffsetMax=Vector2.zero;rt.anchoredPosition=Vector2.zero;rt.UIScale=Vector3(1,1,1)
		q.dim=_SpawnService:SpawnByEntity(dimTemplate,"Dim",Vector3.zero,q.root,false)
		local dt=q.dim.UITransformComponent
		dt.AnchorsMin=Vector2(0,0);dt.AnchorsMax=Vector2(1,1);dt.OffsetMin=Vector2.zero;dt.OffsetMax=Vector2.zero;dt.anchoredPosition=Vector2.zero;dt.UIScale=Vector3(1,1,1)
		q.dim.SpriteGUIRendererComponent.Color=Color(0,0,0,.72);q.dim.SpriteGUIRendererComponent.RaycastTarget=true;q.dim.Enable=true
		q.panel=_SpawnService:SpawnByEntity(sourcePanel,"Panel",Vector3.zero,q.root,false)
		self:PlacePetGearPurchaseElement(q.panel,0,0,layout.panel[1],layout.panel[2])
		-- PET_GEAR_PURCHASE_ART_V3: reuse the exact inventory skin and leaf buttons.
		local art={background="d944cf83af2549e9be8741a81f9d11db",titlePanel="6868227a81f74195a3076a1a96e2533f",imageFrame="d5467d179ba74cf8ac29a8d571279f6c",bonusPanel="d64558d3613a4e9bbe94fb4223e9d88d",infoPanel="d64558d3613a4e9bbe94fb4223e9d88d",pricePanel="d64558d3613a4e9bbe94fb4223e9d88d"}
		for _,key in ipairs({"background","titlePanel","imageFrame","bonusPanel","infoPanel","pricePanel"})do
			local e=_SpawnService:SpawnByEntity(backgroundTemplate,key,Vector3.zero,q.panel,false)
			local rect=layout.groups[key];self:PlacePetGearPurchaseElement(e,rect[1],rect[2],rect[3],rect[4])
			local r=e.SpriteGUIRendererComponent;r.ImageRUID=DataRef(art[key]);r.Enable=true
			r.Type=(key=="background" or key=="titlePanel" or key=="imageFrame")and ImageType.Simple or ImageType.Sliced
			r.PreserveSprite=PreserveSpriteType.None;r.RaycastTarget=key=="background"
			q[key]=e
		end
		local parentKeys={title="titlePanel",statsLabel="bonusPanel",stat="bonusPanel",slotText="infoPanel",itemName="infoPanel",petText="infoPanel",description="infoPanel",price="pricePanel",status="pricePanel"}
		for _,key in ipairs({"title","statsLabel","stat","slotText","itemName","petText","description","price","status"})do
			local rect=layout.content[key]
			local centered=key=="title" or key=="statsLabel" or key=="stat" or key=="status"
			q[key]=self:CreatePetGearPurchaseText(textTemplate,q[parentKeys[key]],key,rect[1],rect[2],rect[3],rect[4],layout.fonts[key],centered)
		end
		q.title.TextGUIRendererComponent.FontColor=Color(1,.96,.86,1)
		q.title.TextGUIRendererComponent.OutlineColor=Color(.12,.055,.015,1);q.title.TextGUIRendererComponent.OutlineWidth=.16
		q.statsLabel.TextGUIRendererComponent.FontColor=Color(1,.91,.68,1)
		q.stat.TextGUIRendererComponent.FontColor=Color(1,.85,.30,1)
		q.slotText.TextGUIRendererComponent.FontColor=Color(1,.83,.44,1)
		q.itemName.TextGUIRendererComponent.BestFit=true;q.itemName.TextGUIRendererComponent.MinSize=24;q.itemName.TextGUIRendererComponent.MaxSize=layout.fonts.itemName
		q.petText.TextGUIRendererComponent.FontColor=Color(1,.84,.43,1)
		q.description.TextGUIRendererComponent.FontColor=Color(1,.92,.79,1)
		q.price.TextGUIRendererComponent.FontColor=Color(1,.88,.39,1)
		q.status.TextGUIRendererComponent.FontColor=Color(1,.73,.57,1)
		q.icon=_SpawnService:SpawnByEntity(iconTemplate,"ItemIcon",Vector3.zero,q.imageFrame,false)
		local rect=layout.content.icon;self:PlacePetGearPurchaseElement(q.icon,rect[1],rect[2],rect[3],rect[4])
		q.icon.SpriteGUIRendererComponent.Type=ImageType.Simple;q.icon.SpriteGUIRendererComponent.PreserveSprite=PreserveSpriteType.AspectOnly
		q.currency=_SpawnService:SpawnByEntity(iconTemplate,"Diamond",Vector3.zero,q.pricePanel,false)
		rect=layout.content.currency;self:PlacePetGearPurchaseElement(q.currency,rect[1],rect[2],rect[3],rect[4])
		q.currency.SpriteGUIRendererComponent.Type=ImageType.Simple;q.currency.SpriteGUIRendererComponent.PreserveSprite=PreserveSpriteType.None
		q.currency.SpriteGUIRendererComponent.ImageRUID=DataRef(_GameManager.DiamondIconRUID)
		-- Keep the removed labels empty for the existing lifecycle contract.
		for _,key in ipairs({"wallet","priceLabel"})do
			q[key]=self:CreatePetGearPurchaseText(textTemplate,q.panel,key,0,0,1,1,18,true);q[key].Enable=false;q[key].TextGUIRendererComponent.Text=""
		end
		for _,key in ipairs({"rule","divider"})do
			q[key]=_SpawnService:SpawnByEntity(dimTemplate,key,Vector3.zero,q.panel,false)
			self:PlacePetGearPurchaseElement(q[key],0,0,1,1);q[key].Enable=false;q[key].SpriteGUIRendererComponent.Enable=false
		end
		q.buyArt="93fd99637232481b8565d2135945bd7e";q.buyDisabledArt=q.buyArt
		q.buy=_SpawnService:SpawnByEntity(yesTemplate,"Buy",Vector3.zero,q.panel,false)
		q.cancel=_SpawnService:SpawnByEntity(noTemplate,"Cancel",Vector3.zero,q.panel,false)
		for _,key in ipairs({"buy","cancel"})do
			local e=q[key];rect=layout.groups[key];self:PlacePetGearPurchaseElement(e,rect[1],rect[2],rect[3],rect[4])
			local r=e.SpriteGUIRendererComponent;r.ImageRUID=DataRef(key=="buy" and q.buyArt or "38bdbbefdf294295b5cedb147737f1d0")
			r.Type=ImageType.Sliced;r.PreserveSprite=PreserveSpriteType.None;r.RaycastTarget=true
			local b=e.ButtonComponent;local colors=b.Colors:Clone()
			colors.NormalColor=Color(1,1,1,1);colors.HighlightedColor=Color(1,1,1,1);colors.PressedColor=Color(.80,.80,.80,1)
			colors.DisabledColor=Color(.48,.48,.48,1);colors.SelectedColor=Color(1,1,1,1);colors.ColorMultiplier=1;colors.FadeDuration=.08
			b.Colors=colors;b.Transition=TransitionType.ColorTint;b.Selectable=false;b.KeyCode=KeyboardKey.None
			local t=e.TextGUIRendererComponent;t.FontSize=layout.fonts[key];t.BestFit=false;t.SizeFit=false
			t.Padding=RectOffset(0,0,0,0);t.HorizontalAlignment=TextHorizontalAlignmentOption.Center;t.VerticalAlignment=TextVerticalAlignmentOption.Middle
			t.FontColor=Color(1,.96,.85,1);t.OutlineColor=Color(.18,.07,.015,1);t.OutlineWidth=.15;t.Underlay=false;t.FaceSoftness=0;t.ColorGradient=false
		end
		table.insert(q.handlers,{entity=q.buy,handle=q.buy:ConnectEvent(ButtonClickEvent,function()self:OnPetGearPurchaseYes()end)})
		table.insert(q.handlers,{entity=q.cancel,handle=q.cancel:ConnectEvent(ButtonClickEvent,function()self:ClosePetGearPurchaseUI()end)})
		self._T.petGearPurchase=q;q.root.Enable=false
	end

	@ExecSpace("ClientOnly")
	method void RefreshPetGearPurchaseUI()
		local q=self._T.petGearPurchase;local pending=self._pendingPetGear
		if q==nil or pending==nil or not q.root.Enable then return end
		local def=_PetLogic:GetPetGearVariants(pending.petId,pending.slot)[pending.variant]
		if def==nil then self:ClosePetGearPurchaseUI() return end
		local labels=self:GetPetGearPurchaseLabels();local petDef=_PetLogic:GetPetDefinition(pending.petId)
		local petName=_LocalizationService:GetText(petDef.nameKey)
		local balance=_TitleUI:GetLastCurrency("diamond");local cost=_PetLogic:GetPetGearPrice()
		local progress=nil
		for _,entry in ipairs(_PetLogic:GetPetCatalog()) do if entry.id==pending.petId then progress=entry.progress break end end
		local ownedMask=progress~=nil and (pending.variant>1 and (progress.GearVariantOwnedMask or 0) or (progress.GearOwnedMask or 0)) or 0
		local owned=_PetLogic:HasPetGearBit(ownedMask,_PetLogic:GetPetGearOwnershipBit(def.bit,pending.variant))
		local canUse=progress~=nil and progress.Owned and not (_GameManager.GameStarted and not _GameManager.GameOver) and not _PetLogic.ClientTest
		local wardrobe=q.origin=="wardrobe"
		local wearing=owned and _PetLogic:HasPetGearBit(progress.GearEquippedMask or 0,def.bit)and _PetLogic:GetPetGearDesignIndex(progress.GearDesigns or 0,def.bit)==pending.variant
		local canEquip=wardrobe and owned and canUse and not wearing
		local allowed=canUse and not owned
		q.action=wardrobe and owned and "equip"or"buy"
		q.canBuy=canEquip or(allowed and balance>=cost);q.balance=balance;q.cost=cost;q.revision=_PetLogic.ClientRevision;q.locale=_LocalizationService.CurrentLocaleId
		q.title.TextGUIRendererComponent.Text=wardrobe and owned and labels.equipTitle or labels.title
		q.icon.SpriteGUIRendererComponent.ImageRUID=DataRef(def.previewIcon or def.icon);q.icon.SpriteGUIRendererComponent.Color=Color(1,1,1,1)
		local iconSize=self:GetPetGearPurchaseIconRect(def.previewIcon or def.icon)
		q.icon.UITransformComponent.RectSize=Vector2(iconSize,iconSize);q.icon.UITransformComponent.anchoredPosition=Vector2.zero
		q.icon.SpriteGUIRendererComponent.PreserveSprite=PreserveSpriteType.AspectOnly
		q.itemName.TextGUIRendererComponent.Text=def.name or _LocalizationService:GetText(def.key)
		q.slotText.TextGUIRendererComponent.Text=labels.slots[pending.slot] or pending.slot
		q.petText.TextGUIRendererComponent.Text=string.format(labels.exclusive,petName)
		q.description.TextGUIRendererComponent.Text=labels.description
		q.statsLabel.TextGUIRendererComponent.Text=labels.stats;q.stat.TextGUIRendererComponent.Text=_LocalizationService:GetText(_PetLogic:GetPetGearStatKey(def.bit,pending.variant))
		q.priceLabel.Enable=false;q.priceLabel.TextGUIRendererComponent.Text="";q.currency.Enable=not(wardrobe and owned);q.price.TextGUIRendererComponent.Text=wardrobe and owned and labels.have or self:FormatGold(cost)
		q.wallet.Enable=false;q.wallet.TextGUIRendererComponent.Text=""
		q.wallet.TextGUIRendererComponent.FontColor=balance<cost and Color(1,.65,.54,1) or Color(.88,.84,.72,1)
		q.status.TextGUIRendererComponent.Text=wardrobe and owned and(wearing and labels.wearing or labels.readyEquip)or(owned and labels.owned or(not allowed and labels.unavailable or(balance<cost and string.format(labels.short,self:FormatGold(cost-balance))or"")))
		q.status.TextGUIRendererComponent.FontColor=Color(1,.73,.57,1)
		q.buy.ButtonComponent.Enable=q.canBuy
		q.buy.SpriteGUIRendererComponent.ImageRUID=DataRef(q.canBuy and q.buyArt or q.buyDisabledArt)
		q.buy.TextGUIRendererComponent.Text=wardrobe and owned and(wearing and labels.wearingButton or labels.equip)or labels.buy;q.cancel.TextGUIRendererComponent.Text=labels.cancel
		local size=q.root.UITransformComponent.RectSize;local fit=math.min(1,math.max(.3,(size.x-60)/q.layout.panel[1]),math.max(.3,(size.y-60)/q.layout.panel[2]))
		if wardrobe then fit=math.min(fit,.66);q.panel.UITransformComponent.anchoredPosition=Vector2(440,-20);q.dim.SpriteGUIRendererComponent.Color=Color(0,0,0,.22)
		else q.panel.UITransformComponent.anchoredPosition=Vector2.zero;q.dim.SpriteGUIRendererComponent.Color=Color(0,0,0,.72)end
		q.panel.UITransformComponent.UIScale=Vector3(fit,fit,1)
	end

	@ExecSpace("ClientOnly")
	method void ClosePetGearPurchaseUI()
		self._pendingPetGear=nil
		local q=self._T.petGearPurchase;if q==nil then return end
		local wardrobe=q.origin=="wardrobe"
		q.root.Enable=false;q.canBuy=false;q.origin=nil;q.action=nil
		if wardrobe then _PetHouseUI:ClearWardrobePreview()end
		if q.previousCloseEnabled~=nil and self.ButtonClose~=nil then self.ButtonClose.Enable=q.previousCloseEnabled end
		q.previousCloseEnabled=nil
	end

	@ExecSpace("ClientOnly")
	method void OnPetGearPurchaseYes()
		local q=self._T.petGearPurchase
		if q==nil or not q.root.Enable or self._pendingPetGear==nil then return end
		self:RefreshPetGearPurchaseUI();if not q.canBuy then return end
		local pending=self._pendingPetGear;local action=q.action
		self:ClosePetGearPurchaseUI()
		-- Consume the pending identity before the RPC so repeated clicks cannot submit it again.
		if action=="equip"then _PetLogic:RequestPetGearVariant(pending.slot,pending.petId,pending.variant)else _PetLogic:RequestBuyPetGear(pending.slot,pending.petId,pending.variant)end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		local q=self._T.petGearPurchase
		if q==nil or not q.root.Enable then return end
		if q.origin=="wardrobe"then
			if not _PetHouseUI.PetMode or not _PetHouseUI:IsWardrobeOpen()or self._pendingPetGear==nil or _PetHouseUI:GetDisplayedPet().id~=self._pendingPetGear.petId then self:ClosePetGearPurchaseUI()return end
		elseif not self.Entity.Enable or not _PetUI.PetMode then self:ClosePetGearPurchaseUI()return end
		q.refreshWait=(q.refreshWait or 0)+delta
		if q.refreshWait<.15 then return end
		q.refreshWait=0;self:RefreshPetGearPurchaseUI()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		local q=self._T.petGearPurchase;if q==nil then return end
		for _,h in ipairs(q.handlers) do if isvalid(h.entity) then h.entity:DisconnectEvent(ButtonClickEvent,h.handle) end end
		if isvalid(q.root) then q.root:Destroy() end
		self._T.petGearPurchase=nil;self._pendingPetGear=nil
	end

	@ExecSpace("ClientOnly")
	method number GetPetGearPurchaseIconRect(string ruid)
		local sizes={["050533cd16d641c286a7c8e43cd1e2aa"]=160,["da972d7833ee493aba027db0c9ceca20"]=160,["0086749d13eb40508b26c9136f0ec292"]=160,["47be0b08ec83407d942f201e2f94301d"]=160,["9f1d9ded40614000827e8f592c356e19"]=160,["fe18528855d84012b4fbc8a99e80fd82"]=160,["61162212b8284289848d7e7270b9728c"]=160,["7d248464182a4c3d99cbc674eae71bb0"]=160,["65f248122f77446ebd99e54573ec465e"]=160,["426f74a10eaa45e281dcd9a9375d2238"]=160,["677d129d307845a3a3bef5d9468e2d74"]=160,["fccaa633cbad4551ba36164633c55e43"]=160,["40e71e3afcd541df8649e6e63a3d6fc5"]=160,["cbc83eaf56034b2b89aa7fed1caa3fb3"]=160,["4937511f36bd49e7869c4d98962856e8"]=160,["33c5f30335fd41f0bc95d034dff4db37"]=160,["097ece552e674eb18d8111652f207360"]=160,["2db115bec535424697a0df3d94d796ce"]=160,["6b4e75c84d7f44f59935d0580d20cde1"]=160,["410c0b580cf444f1acf5ece6498ed55b"]=160,["8f0368eadbf449bda3a1bab80f451f25"]=160,["89d62cd7ee0f4511be0b9071cbcbcc86"]=160,["ad34ea6b545d4d3c95a5493e3ee71d90"]=160,["11a91903c4704d809c274a846ecbf50f"]=160,["183d262da11a47358a6991105d164958"]=160,["330029e66979437c95a6375981dc2373"]=160,["b50b03ca9e0644359a44df003f21a808"]=160,["7828afb209664fadb622a60852a673fa"]=160,["2922acf67b45414388c93dc068423a01"]=160,["05d3d0b49c304ff389fecbca52c65a51"]=160}
		return sizes[ruid]or 80
	end

	@ExecSpace("ClientOnly")
	method void OpenWardrobeGearConfirm(string petId, string slot, integer variant)
		local def=_PetLogic:GetPetGearVariants(petId,slot)[variant]
		if def==nil or not _PetHouseUI:IsWardrobeOpen()or _PetHouseUI:GetDisplayedPet().id~=petId then return end
		self:InitializePetGearPurchaseUI();self._T.petGearPurchase.origin="wardrobe"
		self:OpenPetGearConfirm(petId,slot,variant,def.name or _LocalizationService:GetText(def.key),_PetLogic:GetPetGearPrice())
	end

end