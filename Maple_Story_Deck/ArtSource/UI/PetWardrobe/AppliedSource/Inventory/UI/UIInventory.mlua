	@ExecSpace("ClientOnly")
	method void PlacePetGearPurchaseElement(Entity entity, number x, number y, number width, number height)
		local t=entity.UITransformComponent
		t.AnchorsMin=Vector2(.5,.5);t.AnchorsMax=Vector2(.5,.5);t.Pivot=Vector2(.5,.5)
		t.anchoredPosition=Vector2(x,y);t.RectSize=Vector2(width,height);t.UIScale=Vector3(1,1,1);t.UIRotation=Vector3.zero
		local r=entity.SpriteGUIRendererComponent
		if r~=nil then r.LocalScale=Vector2(1,1);r.LocalPosition=Vector2.zero;r.Color=Color(1,1,1,1);r.RaycastTarget=false end
		entity.Enable=true
	end

	@ExecSpace("ClientOnly")
	method Entity CreatePetGearPurchaseText(Entity template, Entity parent, string name, number x, number y, number width, number height, number fontSize, boolean centered)
		local e=_SpawnService:SpawnByEntity(template,name,Vector3.zero,parent,false)
		self:PlacePetGearPurchaseElement(e,x,y,width,height)
		if e.SpriteGUIRendererComponent~=nil then e.SpriteGUIRendererComponent.Enable=false end
		local r=e.TextGUIRendererComponent
		r.FontSize=fontSize;r.BestFit=false;r.SizeFit=false;r.FontColor=Color(1,.94,.79,1)
		r.HorizontalAlignment=centered and TextHorizontalAlignmentOption.Center or TextHorizontalAlignmentOption.Left
		r.VerticalAlignment=TextVerticalAlignmentOption.Middle;r.Padding=RectOffset(0,0,0,0)
		r.OutlineWidth=0;r.Underlay=false;r.FaceSoftness=0;r.ColorGradient=false;r.IsRichText=false
		return e
	end

